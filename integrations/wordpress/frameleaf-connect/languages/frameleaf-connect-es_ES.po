msgid ""
msgstr "Project-Id-Version: Frameleaf Connect 0.1.0\nLanguage: es_ES\nMIME-Version: 1.0\nContent-Type: text/plain; charset=UTF-8\nContent-Transfer-Encoding: 8bit\n"

msgid "Add each Library your editors may connect to. Allow private networking only for a Library you administer."
msgstr "Añade cada instancia Library a la que pueden conectarse tus editores. Permite la red privada solo para una instancia que administres."

msgid "All selected albums"
msgstr "Todos los álbumes seleccionados"

msgid "Allow this Library on a private network"
msgstr "Permitir esta instancia Library en una red privada"

msgid "Allowed Libraries"
msgstr "Instancias Library permitidas"

msgid "Client ID (leave empty for automatic registration)"
msgstr "ID de cliente (déjalo vacío para el registro automático)"

msgid "Connect Frameleaf"
msgstr "Conectar Frameleaf"

msgid "Connect your own Frameleaf account and choose the albums WordPress may read."
msgstr "Conecta tu propia cuenta de Frameleaf y elige los álbumes que WordPress puede leer."

msgid "Connected"
msgstr "Conectado"

msgid "Disconnect"
msgstr "Desconectar"

msgid "Disconnected"
msgstr "Desconectado"

msgid "Enter a valid HTTPS Library origin without a path."
msgstr "Introduce un origen HTTPS de Library válido sin ruta."

msgid "Frameleaf"
msgstr "Frameleaf"

msgid "Frameleaf could not complete the request. Check your connection or reconnect."
msgstr "Frameleaf no pudo completar la solicitud. Comprueba la conexión o vuelve a conectarte."

msgid "Frameleaf image"
msgstr "Imagen de Frameleaf"

msgid "I revoked WordPress access in Frameleaf."
msgstr "He revocado el acceso de WordPress en Frameleaf."

msgid "I understand that imported images become WordPress attachments."
msgstr "Entiendo que las imágenes importadas se convierten en archivos adjuntos de WordPress."

msgid "Import image"
msgstr "Importar imagen"

msgid "Imported images are copied into WordPress. They remain here after disconnecting or revoking Frameleaf access."
msgstr "Las imágenes importadas se copian en WordPress. Permanecen allí después de desconectar o revocar el acceso a Frameleaf."

msgid "Library"
msgstr "Library"

msgid "Library HTTPS origin"
msgstr "Origen HTTPS de Library"

msgid "Loading…"
msgstr "Cargando…"

msgid "Next"
msgstr "Siguiente"

msgid "No images are available in your selected albums."
msgstr "No hay imágenes disponibles en los álbumes seleccionados."

msgid "Previous"
msgstr "Anterior"

msgid "Reconnect required. Disconnect first; if revocation fails, retry. After a WordPress key change, revoke access in Frameleaf and confirm revocation here before resetting this connection."
msgstr "Debes volver a conectarte. Desconecta primero; si la revocación falla, inténtalo de nuevo. Tras cambiar una clave de WordPress, revoca el acceso en Frameleaf y confírmalo aquí antes de restablecer esta conexión."

msgid "Register this exact callback in Frameleaf Connect when automatic registration is disabled:"
msgstr "Registra esta dirección de retorno exacta en Frameleaf Connect cuando el registro automático esté desactivado:"

msgid "Remove Library"
msgstr "Eliminar instancia Library"

msgid "Reset after a WordPress key change"
msgstr "Restablecer tras cambiar una clave de WordPress"

msgid "Save Library"
msgstr "Guardar instancia Library"

msgid "Search images"
msgstr "Buscar imágenes"

msgid "Frameleaf Connect"
msgstr "Frameleaf Connect"

msgid "Import authorized Frameleaf images into the WordPress Media Library."
msgstr "Importa imágenes autorizadas de Frameleaf a la biblioteca de medios de WordPress."

msgid "Frameleaf requires PHP cURL with HTTPS support and a direct network route to the Library. HTTP proxies are not used for Library requests."
msgstr "Frameleaf requiere PHP cURL compatible con HTTPS y una ruta de red directa a Library. Las solicitudes a Library no utilizan proxies HTTP."
