msgid ""
msgstr "Project-Id-Version: Frameleaf Connect 0.1.0\nLanguage: sv_SE\nMIME-Version: 1.0\nContent-Type: text/plain; charset=UTF-8\nContent-Transfer-Encoding: 8bit\n"

msgid "Add each Library your editors may connect to. Allow private networking only for a Library you administer."
msgstr "Lägg till varje Library som dina redaktörer får ansluta till. Tillåt privata nätverk endast för en Library som du administrerar."

msgid "All selected albums"
msgstr "Alla valda album"

msgid "Allow this Library on a private network"
msgstr "Tillåt denna Library i ett privat nätverk"

msgid "Allowed Libraries"
msgstr "Tillåtna Library-instanser"

msgid "Client ID (leave empty for automatic registration)"
msgstr "Klient-ID (lämna tomt för automatisk registrering)"

msgid "Connect Frameleaf"
msgstr "Anslut Frameleaf"

msgid "Connect your own Frameleaf account and choose the albums WordPress may read."
msgstr "Anslut ditt eget Frameleaf-konto och välj de album som WordPress får läsa."

msgid "Connected"
msgstr "Ansluten"

msgid "Disconnect"
msgstr "Koppla från"

msgid "Disconnected"
msgstr "Frånkopplad"

msgid "Enter a valid HTTPS Library origin without a path."
msgstr "Ange ett giltigt HTTPS-ursprung för Library utan sökväg."

msgid "Frameleaf"
msgstr "Frameleaf"

msgid "Frameleaf could not complete the request. Check your connection or reconnect."
msgstr "Frameleaf kunde inte slutföra begäran. Kontrollera anslutningen eller anslut igen."

msgid "Frameleaf image"
msgstr "Frameleaf-bild"

msgid "I revoked WordPress access in Frameleaf."
msgstr "Jag har återkallat åtkomsten för WordPress i Frameleaf."

msgid "I understand that imported images become WordPress attachments."
msgstr "Jag förstår att importerade bilder blir WordPress-bilagor."

msgid "Import image"
msgstr "Importera bild"

msgid "Imported images are copied into WordPress. They remain here after disconnecting or revoking Frameleaf access."
msgstr "Importerade bilder kopieras till WordPress. De finns kvar här efter frånkoppling eller återkallad åtkomst till Frameleaf."

msgid "Library"
msgstr "Library"

msgid "Library HTTPS origin"
msgstr "HTTPS-ursprung för Library"

msgid "Loading…"
msgstr "Läser in…"

msgid "Next"
msgstr "Nästa"

msgid "No images are available in your selected albums."
msgstr "Det finns inga tillgängliga bilder i dina valda album."

msgid "Previous"
msgstr "Föregående"

msgid "Reconnect required. Disconnect first; if revocation fails, retry. After a WordPress key change, revoke access in Frameleaf and confirm revocation here before resetting this connection."
msgstr "Du behöver ansluta igen. Koppla från först; försök igen om återkallningen misslyckas. Efter en ändring av WordPress-nycklar ska du återkalla åtkomsten i Frameleaf och bekräfta det här innan du återställer anslutningen."

msgid "Register this exact callback in Frameleaf Connect when automatic registration is disabled:"
msgstr "Registrera exakt denna återanropsadress i Frameleaf Connect när automatisk registrering är avstängd:"

msgid "Remove Library"
msgstr "Ta bort Library"

msgid "Reset after a WordPress key change"
msgstr "Återställ efter ändring av WordPress-nycklar"

msgid "Save Library"
msgstr "Spara Library"

msgid "Search images"
msgstr "Sök bilder"

msgid "Frameleaf Connect"
msgstr "Frameleaf Connect"

msgid "Import authorized Frameleaf images into the WordPress Media Library."
msgstr "Importera tillåtna Frameleaf-bilder till WordPress mediebibliotek."

msgid "Frameleaf requires PHP cURL with HTTPS support and a direct network route to the Library. HTTP proxies are not used for Library requests."
msgstr "Frameleaf kräver PHP cURL med HTTPS-stöd och en direkt nätverksväg till Library. Begäranden till Library använder inte HTTP-proxyservrar."
