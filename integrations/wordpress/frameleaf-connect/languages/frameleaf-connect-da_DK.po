msgid ""
msgstr "Project-Id-Version: Frameleaf Connect 0.1.0\nLanguage: da_DK\nMIME-Version: 1.0\nContent-Type: text/plain; charset=UTF-8\nContent-Transfer-Encoding: 8bit\n"

msgid "Add each Library your editors may connect to. Allow private networking only for a Library you administer."
msgstr "Tilføj hver Library, som dine redaktører må oprette forbindelse til. Tillad kun private netværk for en Library, du administrerer."

msgid "All selected albums"
msgstr "Alle valgte album"

msgid "Allow this Library on a private network"
msgstr "Tillad denne Library på et privat netværk"

msgid "Allowed Libraries"
msgstr "Tilladte Library-instanser"

msgid "Client ID (leave empty for automatic registration)"
msgstr "Klient-ID (lad feltet være tomt for automatisk registrering)"

msgid "Connect Frameleaf"
msgstr "Forbind Frameleaf"

msgid "Connect your own Frameleaf account and choose the albums WordPress may read."
msgstr "Forbind din egen Frameleaf-konto, og vælg de album, WordPress må læse."

msgid "Connected"
msgstr "Forbundet"

msgid "Disconnect"
msgstr "Afbryd forbindelsen"

msgid "Disconnected"
msgstr "Ikke forbundet"

msgid "Enter a valid HTTPS Library origin without a path."
msgstr "Angiv en gyldig HTTPS-oprindelse for Library uden sti."

msgid "Frameleaf"
msgstr "Frameleaf"

msgid "Frameleaf could not complete the request. Check your connection or reconnect."
msgstr "Frameleaf kunne ikke fuldføre anmodningen. Kontrollér forbindelsen, eller opret forbindelse igen."

msgid "Frameleaf image"
msgstr "Frameleaf-billede"

msgid "I revoked WordPress access in Frameleaf."
msgstr "Jeg har tilbagekaldt adgangen for WordPress i Frameleaf."

msgid "I understand that imported images become WordPress attachments."
msgstr "Jeg forstår, at importerede billeder bliver vedhæftninger i WordPress."

msgid "Import image"
msgstr "Importér billede"

msgid "Imported images are copied into WordPress. They remain here after disconnecting or revoking Frameleaf access."
msgstr "Importerede billeder kopieres til WordPress. De bliver her, når forbindelsen afbrydes, eller adgangen til Frameleaf tilbagekaldes."

msgid "Library"
msgstr "Library"

msgid "Library HTTPS origin"
msgstr "HTTPS-oprindelse for Library"

msgid "Loading…"
msgstr "Indlæser…"

msgid "Next"
msgstr "Næste"

msgid "No images are available in your selected albums."
msgstr "Der er ingen tilgængelige billeder i dine valgte album."

msgid "Previous"
msgstr "Forrige"

msgid "Reconnect required. Disconnect first; if revocation fails, retry. After a WordPress key change, revoke access in Frameleaf and confirm revocation here before resetting this connection."
msgstr "Du skal oprette forbindelse igen. Afbryd først forbindelsen; prøv igen, hvis tilbagekaldelsen mislykkes. Efter ændring af WordPress-nøgler skal du tilbagekalde adgangen i Frameleaf og bekræfte det her, før du nulstiller forbindelsen."

msgid "Register this exact callback in Frameleaf Connect when automatic registration is disabled:"
msgstr "Registrér præcis denne returadresse i Frameleaf Connect, når automatisk registrering er deaktiveret:"

msgid "Remove Library"
msgstr "Fjern Library"

msgid "Reset after a WordPress key change"
msgstr "Nulstil efter ændring af WordPress-nøgler"

msgid "Save Library"
msgstr "Gem Library"

msgid "Search images"
msgstr "Søg efter billeder"

msgid "Frameleaf Connect"
msgstr "Frameleaf Connect"

msgid "Import authorized Frameleaf images into the WordPress Media Library."
msgstr "Importér godkendte Frameleaf-billeder til WordPress-mediebiblioteket."

msgid "Frameleaf requires PHP cURL with HTTPS support and a direct network route to the Library. HTTP proxies are not used for Library requests."
msgstr "Frameleaf kræver PHP cURL med HTTPS-understøttelse og en direkte netværksvej til Library. Anmodninger til Library bruger ikke HTTP-proxyer."
