msgid ""
msgstr "Project-Id-Version: Frameleaf Connect 0.1.0\nLanguage: it_IT\nMIME-Version: 1.0\nContent-Type: text/plain; charset=UTF-8\nContent-Transfer-Encoding: 8bit\n"

msgid "Add each Library your editors may connect to. Allow private networking only for a Library you administer."
msgstr "Aggiungi ogni istanza Library a cui possono collegarsi i tuoi redattori. Consenti la rete privata solo per un’istanza che amministri."

msgid "All selected albums"
msgstr "Tutti gli album selezionati"

msgid "Allow this Library on a private network"
msgstr "Consenti questa istanza Library su una rete privata"

msgid "Allowed Libraries"
msgstr "Istanze Library consentite"

msgid "Client ID (leave empty for automatic registration)"
msgstr "ID client (lascia vuoto per la registrazione automatica)"

msgid "Connect Frameleaf"
msgstr "Connetti Frameleaf"

msgid "Connect your own Frameleaf account and choose the albums WordPress may read."
msgstr "Collega il tuo account Frameleaf e scegli gli album che WordPress può leggere."

msgid "Connected"
msgstr "Connesso"

msgid "Disconnect"
msgstr "Disconnetti"

msgid "Disconnected"
msgstr "Disconnesso"

msgid "Enter a valid HTTPS Library origin without a path."
msgstr "Inserisci un’origine HTTPS Library valida senza percorso."

msgid "Frameleaf"
msgstr "Frameleaf"

msgid "Frameleaf could not complete the request. Check your connection or reconnect."
msgstr "Frameleaf non ha potuto completare la richiesta. Verifica la connessione o riconnettiti."

msgid "Frameleaf image"
msgstr "Immagine Frameleaf"

msgid "I revoked WordPress access in Frameleaf."
msgstr "Ho revocato l’accesso di WordPress in Frameleaf."

msgid "I understand that imported images become WordPress attachments."
msgstr "Comprendo che le immagini importate diventano allegati WordPress."

msgid "Import image"
msgstr "Importa immagine"

msgid "Imported images are copied into WordPress. They remain here after disconnecting or revoking Frameleaf access."
msgstr "Le immagini importate vengono copiate in WordPress. Rimangono qui dopo la disconnessione o la revoca dell’accesso a Frameleaf."

msgid "Library"
msgstr "Library"

msgid "Library HTTPS origin"
msgstr "Origine HTTPS Library"

msgid "Loading…"
msgstr "Caricamento…"

msgid "Next"
msgstr "Avanti"

msgid "No images are available in your selected albums."
msgstr "Non sono disponibili immagini negli album selezionati."

msgid "Previous"
msgstr "Indietro"

msgid "Reconnect required. Disconnect first; if revocation fails, retry. After a WordPress key change, revoke access in Frameleaf and confirm revocation here before resetting this connection."
msgstr "È necessario riconnettersi. Disconnettiti prima; se la revoca fallisce, riprova. Dopo una modifica delle chiavi WordPress, revoca l’accesso in Frameleaf e confermalo qui prima di reimpostare questa connessione."

msgid "Register this exact callback in Frameleaf Connect when automatic registration is disabled:"
msgstr "Registra questo esatto indirizzo di ritorno in Frameleaf Connect quando la registrazione automatica è disattivata:"

msgid "Remove Library"
msgstr "Rimuovi istanza Library"

msgid "Reset after a WordPress key change"
msgstr "Reimposta dopo una modifica delle chiavi WordPress"

msgid "Save Library"
msgstr "Salva istanza Library"

msgid "Search images"
msgstr "Cerca immagini"

msgid "Frameleaf Connect"
msgstr "Frameleaf Connect"

msgid "Import authorized Frameleaf images into the WordPress Media Library."
msgstr "Importa le immagini Frameleaf autorizzate nella libreria multimediale di WordPress."

msgid "Frameleaf requires PHP cURL with HTTPS support and a direct network route to the Library. HTTP proxies are not used for Library requests."
msgstr "Frameleaf richiede PHP cURL con supporto HTTPS e un percorso di rete diretto alla Library. Le richieste alla Library non usano proxy HTTP."
