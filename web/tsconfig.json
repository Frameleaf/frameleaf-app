{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "module": "es2022",
    "moduleResolution": "bundler",
    "noImplicitOverride": true,
    "paths": {
      "$i18n": ["../i18n"],
      "$i18n/*": ["../i18n/*"],
      "$lib": ["./src/lib"],
      "$lib/*": ["./src/lib/*"],
      "$licenses": ["../licenses"],
      "$licenses/*": ["../licenses/*"],
      "$studioNotices": ["../studio/notices"],
      "$studioNotices/*": ["../studio/notices/*"],
      "$tests": ["./tests"],
      "$tests/*": ["./tests/*"],
      "@test-data": ["./src/test-data"],
      "@test-data/*": ["./src/test-data/*"],
      "chromecast-caf-sender": ["./node_modules/@types/chromecast-caf-sender/index.d.ts"]
    },
    "resolveJsonModule": true,
    "rootDir": ".",
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "target": "es2022",
    "types": ["vitest/globals", "$app/types"]
  },
  "exclude": ["vite.config.ts", "src/service-worker"],
  "extends": "$app/tsconfig",
  "include": ["src", "tests"]
}
