{
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    },
    "default_popup": "popup.html",
    "default_title": "Save to Frameleaf"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "_execute_action": {
      "description": "Open Save to Frameleaf",
      "suggested_key": {
        "default": "Alt+Shift+F"
      }
    },
    "screenshot": {
      "description": "Take a screenshot",
      "suggested_key": {
        "default": "Alt+Shift+S"
      }
    },
    "save-page-link": {
      "description": "Save this page as a link",
      "suggested_key": {
        "default": "Alt+Shift+L"
      }
    }
  },
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' blob: data:; connect-src https: http: blob: data:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
  },
  "description": "Collect images and inspiration in your own Frameleaf library.",
  "icons": {
    "128": "icons/icon128.png",
    "16": "icons/icon16.png",
    "48": "icons/icon48.png"
  },
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "name": "Save to Frameleaf",
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "optional_permissions": ["cookies", "webRequest"],
  "options_ui": {
    "open_in_tab": true,
    "page": "options.html"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "alarms",
    "contextMenus",
    "identity"
  ],
  "version": "1.2.0"
}
