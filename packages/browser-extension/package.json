{
  "name": "@frameleaf/browser-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "scripts": {
    "test": "vitest --config vite.config.ts",
    "check": "tsc6 --noEmit && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "build": "vite build && vite build --config vite.content.config.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@frameleaf/sdk": "workspace:*",
    "srcset": "4.0.0",
    "svelte": "5.57.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/chrome": "0.3.5",
    "@types/node": "^26.6.5",
    "fake-indexeddb": "6.2.4",
    "happy-dom": "^21.0.1",
    "svelte-check": "^4.7.6",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
