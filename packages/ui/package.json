{
  "name": "@frameleaf/ui",
  "version": "0.86.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Frameleaf/frameleaf-app.git",
    "directory": "packages/ui"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    },
    "./byte-units": {
      "types": "./dist/utilities/byte-units.d.ts",
      "default": "./dist/utilities/byte-units.js"
    },
    "./theme/default.css": "./dist/theme/default.css",
    "./persisted": {
      "types": "./dist/state/persisted.d.ts",
      "default": "./dist/state/persisted.js"
    }
  },
  "peerDependencies": {
    "@sveltejs/kit": "^3.0.1",
    "svelte": "^5.57.2"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "@mdi/js": "^7.4.47",
    "bits-ui": "^2.19.5",
    "fuse.js": "^7.5.0",
    "luxon": "^3.7.2",
    "simple-icons": "^16.35.0",
    "svelte-highlight": "^7.23.1",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3"
  },
  "private": true,
  "devDependencies": {
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
