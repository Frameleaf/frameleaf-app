{
  "name": "@frameleaf/cli",
  "version": "1.1.10",
  "description": "Command Line Interface (CLI) for Frameleaf",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Frameleaf/frameleaf-app.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "exports": "./dist/index.js",
  "bin": {
    "frameleaf": "./bin/frameleaf",
    "immich": "./bin/immich"
  },
  "license": "GNU Affero General Public License version 3",
  "keywords": [
    "immich",
    "cli"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@frameleaf/sdk": "workspace:*",
    "@types/byte-size": "^8.1.2",
    "@types/cli-progress": "^3.11.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/lodash-es": "^4.17.12",
    "@types/micromatch": "^4.0.10",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.4",
    "byte-size": "^9.0.1",
    "cli-progress": "^3.12.0",
    "commander": "^15.0.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-unicorn": "^78.0.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-organize-imports": "^4.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "vitest-fetch-mock": "^0.4.5",
    "yaml": "^2.9.1"
  },
  "scripts": {
    "build": "vite build",
    "build:dev": "vite build --sourcemap true",
    "lint": "eslint \"src/**/*.ts\" --max-warnings 0",
    "lint:fix": "pnpm run lint --fix",
    "prepack": "pnpm run build",
    "test": "vitest",
    "test:cov": "vitest --coverage",
    "format": "prettier --cache --check .",
    "format:fix": "prettier --cache --write --list-different .",
    "check": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "chokidar": "^5.0.0",
    "fast-glob": "^3.3.3",
    "fastq": "^1.20.3",
    "lodash-es": "^4.18.1",
    "micromatch": "^4.0.8",
    "semver": "^7.8.5"
  }
}
