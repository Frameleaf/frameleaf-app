diff --git a/src/features/preview/utils/preview-display-canvas.test.ts b/src/features/preview/utils/preview-display-canvas.test.ts
new file mode 100644
--- /dev/null
+++ b/src/features/preview/utils/preview-display-canvas.test.ts
@@ -0,0 +1,34 @@
+import { describe, expect, it, vi } from 'vite-plus/test'
+import { drawSourceToPreviewDisplayCanvas } from './preview-display-canvas'
+
+describe('preview display edge-copy cleanup', () => {
+  it('restores the caller smoothing state and rethrows an edge-copy failure', () => {
+    const failure = new Error('edge-copy failure')
+    const state = { imageSmoothingEnabled: true, imageSmoothingQuality: 'high' }
+    const saved: (typeof state)[] = []
+    const drawImage = vi
+      .fn()
+      .mockImplementationOnce(() => {})
+      .mockImplementation(() => {
+        throw failure
+      })
+    const ctx = Object.assign(state, {
+      clearRect: vi.fn(),
+      drawImage,
+      save: vi.fn(() => saved.push({ ...state })),
+      restore: vi.fn(() => Object.assign(state, saved.pop())),
+    })
+    const display = { width: 3, height: 3 } as HTMLCanvasElement
+    const source = { width: 1, height: 1 } as OffscreenCanvas
+
+    expect(() =>
+      drawSourceToPreviewDisplayCanvas(ctx as unknown as CanvasRenderingContext2D, display, source),
+    ).toThrow(failure)
+    expect(drawImage).toHaveBeenCalledTimes(2)
+    expect(ctx.save).toHaveBeenCalledTimes(1)
+    expect(ctx.restore).toHaveBeenCalledTimes(1)
+    expect(saved).toHaveLength(0)
+    expect(state.imageSmoothingEnabled).toBe(true)
+    expect(state.imageSmoothingQuality).toBe('high')
+  })
+})
