@@ -0,0 +1,164 @@
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vite-plus/test'
+import { blobUrlManager } from '@/infrastructure/browser/blob-url-manager'
+import { ensureFontsLoaded, loadFont } from './font-loader'
+import {
+  getProjectFonts,
+  isProjectFontFamily,
+  loadProjectFontFamily,
+  MAX_PROJECT_FONT_FACES,
+  normalizeProjectFonts,
+  projectFontWeightDescriptor,
+  projectFontWeightRanges,
+  setProjectFonts,
+} from './project-fonts'
+
+const REGULAR = '6f0d2a4e-1c3b-4d5e-8f60-718293a4b5c6'
+const BLACK = '6f0d2a4e-1c3b-4d5e-8f60-718293a4b5c7'
+const ITALIC = '6f0d2a4e-1c3b-4d5e-8f60-718293a4b5c8'
+
+const face = (importId: string, weight: number, style = 'normal', family = 'Brand Sans') => ({
+  importId,
+  family,
+  weight,
+  style,
+})
+
+describe('project fonts (FL-1562)', () => {
+  it('keeps only well-formed faces, once each, and at most the limit', () => {
+    expect(
+      normalizeProjectFonts([
+        face(REGULAR.toUpperCase(), 400),
+        face(BLACK, 400),
+        face(BLACK, 950),
+        face(BLACK, 450.5),
+        face(BLACK, 700, 'oblique'),
+        face('not-a-uuid', 700),
+        face(BLACK, 700, 'normal', 'https://fonts.example/brand'),
+        face(BLACK, 700, 'normal', 'Quote"d'),
+        face(BLACK, 700, 'normal', ' Padded'),
+        null,
+        face(BLACK, 900),
+      ]),
+    ).toEqual([face(REGULAR, 400), face(BLACK, 900)])
+    expect(normalizeProjectFonts({ importId: REGULAR })).toEqual([])
+    const many = Array.from({ length: MAX_PROJECT_FONT_FACES + 4 }, (_, index) =>
+      face(REGULAR, 400, 'normal', `Family ${index}`),
+    )
+    expect(normalizeProjectFonts(many)).toHaveLength(MAX_PROJECT_FONT_FACES)
+  })
+
+  it('gives every weight to the nearest listed weight, the lighter of two equally near', () => {
+    expect([...projectFontWeightRanges([700, 400])]).toEqual([
+      [400, [1, 550]],
+      [700, [551, 1000]],
+    ])
+    expect([...projectFontWeightRanges([300, 800, 900])]).toEqual([
+      [300, [1, 550]],
+      [800, [551, 850]],
+      [900, [851, 1000]],
+    ])
+    expect([...projectFontWeightRanges([400])]).toEqual([[400, [1, 1000]]])
+    // Italic faces are ranged among the italic faces only.
+    const faces = normalizeProjectFonts([
+      face(REGULAR, 400),
+      face(BLACK, 900),
+      face(ITALIC, 300, 'italic'),
+    ])
+    expect(faces.map((item) => projectFontWeightDescriptor(item, faces))).toEqual([
+      '1 650',
+      '651 1000',
+      '1 1000',
+    ])
+  })
+
+  describe('loading', () => {
+    const added: Array<{ family: string; descriptors: FontFaceDescriptors }> = []
+    const fonts = {
+      add: vi.fn(),
+      delete: vi.fn(),
+      load: vi.fn().mockResolvedValue([]),
+      ready: Promise.resolve(),
+    }
+
+    beforeEach(() => {
+      added.length = 0
+      fonts.add.mockClear()
+      fonts.delete.mockClear()
+      Object.defineProperty(document, 'fonts', { value: fonts, configurable: true })
+      vi.stubGlobal(
+        'FontFace',
+        class {
+          constructor(family: string, _source: ArrayBuffer, descriptors: FontFaceDescriptors) {
+            added.push({ family, descriptors })
+          }
+          load() {
+            return Promise.resolve(this)
+          }
+        },
+      )
+      vi.stubGlobal(
+        'fetch',
+        vi.fn(async (url: string) => ({
+          ok: !url.endsWith('/gone'),
+          status: url.endsWith('/gone') ? 404 : 200,
+          arrayBuffer: async () => new ArrayBuffer(8),
+        })),
+      )
+      blobUrlManager.registerUrl(REGULAR, `/api/studio/projects/p/imports/${REGULAR}/file`)
+      blobUrlManager.registerUrl(BLACK, `/api/studio/projects/p/imports/${BLACK}/file`)
+    })
+
+    afterEach(() => {
+      setProjectFonts(undefined)
+      blobUrlManager.releaseAll()
+      vi.unstubAllGlobals()
+    })
+
+    it('reads each face from its import and registers it with its weight range', async () => {
+      setProjectFonts([face(REGULAR, 400), face(BLACK, 900)])
+      expect(isProjectFontFamily('Brand Sans')).toBe(true)
+      expect(isProjectFontFamily('Inter')).toBe(false)
+      expect(await loadProjectFontFamily('Brand Sans')).toBe(true)
+      expect(fetch).toHaveBeenCalledWith(`/api/studio/projects/p/imports/${REGULAR}/file`)
+      expect(added).toEqual([
+        { family: 'Brand Sans', descriptors: { weight: '1 650', style: 'normal' } },
+        { family: 'Brand Sans', descriptors: { weight: '651 1000', style: 'normal' } },
+      ])
+      expect(fonts.add).toHaveBeenCalledTimes(2)
+      // Loaded once: a second load registers nothing more.
+      expect(await loadProjectFontFamily('Brand Sans')).toBe(true)
+      expect(fonts.add).toHaveBeenCalledTimes(2)
+    })
+
+    it('draws in the fallback while a file is not registered, and retries on the next load', async () => {
+      setProjectFonts([face(ITALIC, 400, 'italic')])
+      expect(await loadProjectFontFamily('Brand Sans')).toBe(false)
+      expect(fonts.add).not.toHaveBeenCalled()
+      blobUrlManager.registerUrl(ITALIC, '/files/gone')
+      expect(await loadProjectFontFamily('Brand Sans')).toBe(false)
+      blobUrlManager.release(ITALIC)
+      blobUrlManager.registerUrl(ITALIC, `/api/studio/projects/p/imports/${ITALIC}/file`)
+      expect(await loadProjectFontFamily('Brand Sans')).toBe(true)
+    })
+
+    it('removes faces the project no longer lists, or whose range changed', async () => {
+      setProjectFonts([face(REGULAR, 400)])
+      await loadProjectFontFamily('Brand Sans')
+      setProjectFonts([face(REGULAR, 400), face(BLACK, 900)])
+      expect(fonts.delete).toHaveBeenCalledTimes(1)
+      expect(getProjectFonts()).toHaveLength(2)
+      setProjectFonts([])
+      expect(isProjectFontFamily('Brand Sans')).toBe(false)
+    })
+
+    it('never asks the resource admission or the network catalogue for a project family', async () => {
+      setProjectFonts([face(REGULAR, 400, 'normal', 'Not In Any Catalogue')])
+      expect(loadFont('Not In Any Catalogue')).toBe('"Not In Any Catalogue", sans-serif')
+      await expect(ensureFontsLoaded(['Not In Any Catalogue'], [400, 700])).resolves.toBeUndefined()
+      expect(document.querySelector('link[data-font="Not In Any Catalogue"]')).toBeNull()
+      expect(fonts.load).toHaveBeenCalledWith('400 16px "Not In Any Catalogue"', 'BESbswy')
+      // A family that is neither listed nor admitted is still refused, as before.
+      expect(() => loadFont('Not In Any Catalogue Either')).toThrow(/FRAMELEAF_RESOURCE_BLOCKED/)
+    })
+  })
+})
diff --git a/src/shared/typography/project-fonts.ts b/src/shared/typography/project-fonts.ts
new file mode 100644
--- /dev/null
+++ b/src/shared/typography/project-fonts.ts
@@ -0,0 +1,205 @@
+/**
+ * Frameleaf (FL-1562): fonts kept with the project.
+ *
+ * A project lists the font files a person imported in `metadata.fonts` (graph protocol 14.3.6):
+ * each face names a project import by `importId`, the family titles use for it, and its weight
+ * and style. A family listed there is the project's own: it is never looked up in the font
+ * catalogue or fetched from the network, and the resource admission rows for catalogue fonts do
+ * not apply to it. Its bytes are the import's, read through the URL the host registered for the
+ * import id, exactly as media is read.
+ *
+ * Every face is registered with a weight range, so a title asking for any weight draws the
+ * family's nearest listed weight (the lighter of two equally near), the rule the render spec (X4)
+ * and the render worker use, rather than the browser's own matching order.
+ */
+import { blobUrlManager } from '@/infrastructure/browser/blob-url-manager'
+import { createLogger } from '@/shared/logging/logger'
+
+const logger = createLogger('ProjectFonts')
+
+/** How many faces a project may list; the server and the render worker read no more. */
+export const MAX_PROJECT_FONT_FACES = 32
+
+export interface ProjectFontFace {
+  /** The project import that holds the font file. */
+  importId: string
+  /** The family titles name; it need not be the family the file gives itself. */
+  family: string
+  /** 100 to 900. */
+  weight: number
+  style: 'normal' | 'italic'
+}
+
+const UUID = /^[\da-f]{8}-[\da-f]{4}-[\da-f]{4}-[\da-f]{4}-[\da-f]{12}$/i
+const LOCATOR = /^(?:[a-z][\d+.a-z-]*:|\/|\\\\|[a-z]:\\)|(?:^|[/\\])\.\.(?:[/\\]|$)/i
+
+/** A family name a CSS font string can carry and a graph may hold: never a locator. */
+export function isProjectFontFamilyName(value: unknown): value is string {
+  return (
+    typeof value === 'string' &&
+    value.length > 0 &&
+    value.length <= 128 &&
+    value.trim() === value &&
+    // eslint-disable-next-line no-control-regex
+    !/[\u0000-\u001F\u007F"\\]/.test(value) &&
+    !LOCATOR.test(value)
+  )
+}
+
+/**
+ * The well-formed faces of a `metadata.fonts` value, in order: a malformed entry, a repeat of a
+ * family, weight and style, and everything past {@link MAX_PROJECT_FONT_FACES} are left out, as
+ * the server's resolver leaves them out.
+ */
+export function normalizeProjectFonts(value: unknown): ProjectFontFace[] {
+  if (!Array.isArray(value)) return []
+  const faces: ProjectFontFace[] = []
+  const seen = new Set<string>()
+  for (const entry of value.slice(0, MAX_PROJECT_FONT_FACES)) {
+    if (!entry || typeof entry !== 'object') continue
+    const { importId, family, weight, style } = entry as Record<string, unknown>
+    if (
+      typeof importId !== 'string' ||
+      !UUID.test(importId) ||
+      !isProjectFontFamilyName(family) ||
+      typeof weight !== 'number' ||
+      !Number.isInteger(weight) ||
+      weight < 100 ||
+      weight > 900 ||
+      (style !== 'normal' && style !== 'italic')
+    ) {
+      continue
+    }
+    const identity = `${family}|${weight}|${style}`
+    if (seen.has(identity)) continue
+    seen.add(identity)
+    faces.push({ importId: importId.toLowerCase(), family, weight, style })
+  }
+  return faces
+}
+
+/**
+ * The weight range each listed weight answers for, over CSS's 1 to 1000: every weight goes to the
+ * nearest listed one, and a weight exactly between two goes to the lighter.
+ */
+export function projectFontWeightRanges(weights: readonly number[]): Map<number, [number, number]> {
+  const sorted = [...new Set(weights)].sort((a, b) => a - b)
+  const ranges = new Map<number, [number, number]>()
+  sorted.forEach((weight, index) => {
+    const low = index === 0 ? 1 : Math.floor((sorted[index - 1]! + weight) / 2) + 1
+    const high = index === sorted.length - 1 ? 1000 : Math.floor((weight + sorted[index + 1]!) / 2)
+    ranges.set(weight, [low, high])
+  })
+  return ranges
+}
+
+/** The weight descriptor of one face among its family's faces of the same style. */
+export function projectFontWeightDescriptor(
+  face: ProjectFontFace,
+  faces: readonly ProjectFontFace[],
+): string {
+  const range = projectFontWeightRanges(
+    faces
+      .filter((other) => other.family === face.family && other.style === face.style)
+      .map((other) => other.weight),
+  ).get(face.weight)!
+  return `${range[0]} ${range[1]}`
+}
+
+type Registered = { key: string; face: FontFace }
+
+let listed: ProjectFontFace[] = []
+let families = new Map<string, ProjectFontFace[]>()
+/** Faces added to the document, by face identity and weight range. */
+const registered = new Map<string, Registered>()
+const loading = new Map<string, Promise<boolean>>()
+
+const faceKey = (face: ProjectFontFace, descriptor: string) =>
+  `${face.importId}|${face.family}|${face.style}|${descriptor}`
+
+/**
+ * Make the project's list the one titles draw from. Faces no longer listed (or whose weight range
+ * changed because the family gained or lost a face) are removed from the document.
+ */
+export function setProjectFonts(value: unknown): void {
+  const next = normalizeProjectFonts(value)
+  if (JSON.stringify(next) === JSON.stringify(listed)) return
+  listed = next
+  families = new Map()
+  for (const face of next) families.set(face.family, [...(families.get(face.family) ?? []), face])
+  const keep = new Set(next.map((face) => faceKey(face, projectFontWeightDescriptor(face, next))))
+  for (const [key, entry] of registered) {
+    if (keep.has(key)) continue
+    registered.delete(key)
+    if (typeof document !== 'undefined' && document.fonts) document.fonts.delete(entry.face)
+  }
+}
+
+export function getProjectFonts(): readonly ProjectFontFace[] {
+  return listed
+}
+
+export function isProjectFontFamily(family: string): boolean {
+  return families.has(family)
+}
+
+async function loadFace(face: ProjectFontFace, descriptor: string): Promise<boolean> {
+  const key = faceKey(face, descriptor)
+  if (registered.has(key)) return true
+  const url = blobUrlManager.get(face.importId)
+  if (!url) {
+    // Not yet registered by the host, or no longer kept: the title draws in the fallback face,
+    // and the next draw tries again.
+    logger.warn(`The font file of "${face.family}" (${face.weight} ${face.style}) is not available`)
+    return false
+  }
+  try {
+    const response = await fetch(url)
+    if (!response.ok) throw new Error(`HTTP ${response.status}`)
+    const loaded = await new FontFace(face.family, await response.arrayBuffer(), {
+      weight: descriptor,
+      style: face.style,
+    }).load()
+    // The list may have changed while the file was read.
+    const current = listed.find(
+      (other) =>
+        other.importId === face.importId &&
+        other.family === face.family &&
+        other.style === face.style &&
+        projectFontWeightDescriptor(other, listed) === descriptor,
+    )
+    if (!current || registered.has(key)) return Boolean(current)
+    document.fonts.add(loaded)
+    registered.set(key, { key, face: loaded })
+    return true
+  } catch (error) {
+    logger.warn(`The font file of "${face.family}" could not be read:`, error)
+    return false
+  }
+}
+
+/**
+ * Load every face of a project family. Resolves true when all of them are in the document; a face
+ * that could not be read leaves the family drawing in its other faces or the fallback.
+ */
+export function loadProjectFontFamily(family: string): Promise<boolean> {
+  const faces = families.get(family)
+  if (
+    !faces ||
+    typeof document === 'undefined' ||
+    !document.fonts ||
+    typeof FontFace === 'undefined'
+  ) {
+    return Promise.resolve(false)
+  }
+  const snapshot = listed
+  const pending = loading.get(family)
+  if (pending) return pending
+  const promise = Promise.all(
+    faces.map((face) => loadFace(face, projectFontWeightDescriptor(face, snapshot))),
+  )
+    .then((results) => results.every(Boolean))
+    .finally(() => loading.delete(family))
+  loading.set(family, promise)
+  return promise
+}
