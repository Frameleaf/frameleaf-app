+
+export function rasterMime(bytes: Uint8Array): string {
+  const ascii = (start: number, length: number) =>
+    String.fromCharCode(...bytes.subarray(start, start + length))
+  if ([137, 80, 78, 71, 13, 10, 26, 10].every((value, index) => bytes[index] === value))
+    return 'image/png'
+  if (bytes[0] === 255 && bytes[1] === 216 && bytes[2] === 255) return 'image/jpeg'
+  if (['GIF87a', 'GIF89a'].includes(ascii(0, 6))) return 'image/gif'
+  if (ascii(0, 4) === 'RIFF' && ascii(8, 4) === 'WEBP') return 'image/webp'
+  return fail()
+}
+
+export function archiveFontMime(bytes: Uint8Array): string {
+  const magic = String.fromCharCode(...bytes.subarray(0, 4))
+  if (magic === 'wOF2') return 'font/woff2'
+  if (magic === 'wOFF') return 'font/woff'
+  if (magic === 'OTTO') return 'font/otf'
+  if (magic === '\u0000\u0001\u0000\u0000') return 'font/ttf'
+  return fail()
+}
+
+/** Validate an original archive against its inventory, or a closed renderer document. */
+export function assertClosedLottieAnimation(
+  document: Record<string, unknown>,
+  files?: Record<string, Uint8Array>,
+): void {
+  if (document.assets !== undefined && !Array.isArray(document.assets)) return fail()
+  for (const raw of Array.isArray(document.assets) ? document.assets : []) {
+    const asset = record(raw)
+    if (asset.p === undefined) continue
+    if (typeof asset.p !== 'string') return fail()
+    if (!asset.p.startsWith('data:') && files) {
+      if (asset.u !== undefined && typeof asset.u !== 'string') return fail()
+      const entry = `${typeof asset.u === 'string' ? asset.u : ''}${asset.p}`
+      if (!/^(?:images|i)\/[A-Za-z0-9_.-]+$/.test(entry) || !Object.hasOwn(files, entry)) return fail()
+      rasterMime(files[entry]!)
