+          ? provider.preload('item', '/old', 32, 64, '{"layers":[]}', 'old')
+          : provider.rebuild('item', '/old', 32, 64, '{"layers":[]}', 'old')
+        const refusal = expect(old).rejects.toThrow()
+        notifyScopedMedia()
+        native.defer = false
+        await provider.preload('item', '/new', 32, 64, '{"layers":[]}', 'new')
