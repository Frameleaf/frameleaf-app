+// @vitest-environment node
+import { afterEach, describe, expect, it, vi } from 'vite-plus/test'
+import { notifyScopedMedia, subscribeScopedMedia } from '@/features/media-library/utils/scoped-media-resolution'
+import { LottieExportProvider } from './lottie-frame-provider'
+
+const native = vi.hoisted(() => ({ defer: false, instances: [] as Array<{ destroy: ReturnType<typeof vi.fn>; load?: () => void }> }))
+vi.mock('@lottiefiles/dotlottie-web', () => ({ DotLottie: class {
+  static setWasmUrl() {}
+  isLoaded = !native.defer
+  totalFrames = 1
+  destroy = vi.fn()
+  constructor() { native.instances.push(this) }
+  addEventListener(name: string, callback: () => void) { if (name === 'load') this.load = callback }
+  load?: () => void
+  setFrame() {}
+  setThemeData() { return true }
+} }))
+vi.mock('@lottiefiles/dotlottie-web/dotlottie-player.wasm?url', () => ({ default: '/unrun-owned.wasm' }))
+afterEach(() => { native.defer = false; native.instances.length = 0; vi.unstubAllGlobals() })
+const canvas = () => vi.stubGlobal('OffscreenCanvas', class { constructor(public width: number, public height: number) {} })
+describe('provider source epoch ownership', () => {
+  it('retires an existing ready provider before a same-signature reuse or render', async () => {
+    canvas(); const provider = new LottieExportProvider()
+    try {
+      await provider.preload('item', '/source', 32, 64, '{"layers":[]}', 'same')
+      expect(provider.get('item')).toBeDefined()
+      notifyScopedMedia()
+      expect(provider.get('item')).toBeUndefined()
+      expect(provider.getSignature('item')).toBeUndefined()
+      expect(provider.renderFrame('item', 0)).toBeNull()
+      expect(native.instances[0]!.destroy).toHaveBeenCalledTimes(1)
+      await provider.preload('item', '/reauthorized', 32, 64, '{"layers":[]}', 'same')
+      expect(native.instances).toHaveLength(2)
+    } finally { provider.destroy() }
+  })
+  it('completes all owner cleanup when the first pending native destructor throws', async () => {
+    canvas()
+    const provider = new LottieExportProvider(), laterProvider = new LottieExportProvider()
+    const readAbort = new AbortController(), cacheInvalidated = vi.fn()
+    const stopRead = subscribeScopedMedia(() => readAbort.abort())
+    const stopCache = subscribeScopedMedia(cacheInvalidated)
+    try {
+      native.defer = true
+      const first = provider.preload('first', '/first', 32, 64, '{"layers":[]}', 'old')
+      const second = provider.rebuild('second', '/second', 32, 64, '{"layers":[]}', 'old')
+      const settled = Promise.allSettled([first, second])
+      native.defer = false
+      await provider.preload('ready', '/ready', 32, 64, '{"layers":[]}', 'old')
+      await laterProvider.preload('later', '/later', 32, 64, '{"layers":[]}', 'old')
+      native.instances[0]!.destroy.mockImplementation(() => { throw new Error('OWNED_DESTROY_FAILED') })
+      expect(() => notifyScopedMedia()).not.toThrow()
+      expect((await settled).map((result) => result.status)).toEqual(['rejected', 'rejected'])
+      for (const instance of native.instances) expect(instance.destroy).toHaveBeenCalledTimes(1)
+      expect(readAbort.signal.aborted).toBe(true)
+      expect(cacheInvalidated).toHaveBeenCalledTimes(1)
+      for (const key of ['first', 'second', 'ready']) {
+        expect(provider.get(key)).toBeUndefined()
+        expect(provider.getSignature(key)).toBeUndefined()
+        expect(provider.renderFrame(key, 0)).toBeNull()
+      }
+      expect(laterProvider.get('later')).toBeUndefined()
+      native.instances[0]!.load?.(); native.instances[1]!.load?.()
+      expect(provider.get('first')).toBeUndefined()
+      expect(provider.get('second')).toBeUndefined()
+      await provider.preload('first', '/new-owner', 32, 64, '{"layers":[]}', 'new')
+      expect(provider.getSignature('first')).toBe('new')
+    } finally {
+      stopRead(); stopCache()
+      expect(() => provider.destroy()).not.toThrow()
+      expect(() => laterProvider.destroy()).not.toThrow()
+    }
+  })
+  it('denies cached data when a grant expires before any epoch notification', async () => {
+    canvas(); const provider = new LottieExportProvider(); let live = true
+    try {
