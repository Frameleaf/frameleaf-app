diff --git a/src/features/media-library/utils/scoped-media-resolution.ts b/src/features/media-library/utils/scoped-media-resolution.ts
new file mode 100644
--- /dev/null
+++ b/src/features/media-library/utils/scoped-media-resolution.ts
@@ -0,0 +1,41 @@
+/** An installed host scope is authoritative even when it refuses a source. */
+export type ScopedMediaResolution = { handled: false } | { handled: true; url: string }
+export interface ScopedMediaResolver {
+  peek(mediaId: string, vector?: boolean): ScopedMediaResolution
+  resolve(mediaId: string, vector?: boolean): Promise<ScopedMediaResolution>
+}
+
+let current: ScopedMediaResolver | undefined
+let epoch = 0
+const listeners = new Set<() => void>()
+export const scopedMediaEpoch = (): number => epoch
+export const subscribeScopedMedia = (listener: () => void): (() => void) => {
+  listeners.add(listener)
+  return () => listeners.delete(listener)
+}
+export function notifyScopedMedia(): void {
+  epoch++
+  for (const listener of listeners) listener()
+}
+export function installScopedMediaResolver(resolver: ScopedMediaResolver): () => void {
+  current = resolver
+  notifyScopedMedia()
+  return () => {
+    if (current !== resolver) return
+    current = undefined
+    notifyScopedMedia()
+  }
+}
+export function peekScopedMedia(mediaId: string, vector?: boolean): ScopedMediaResolution {
+  return current?.peek(mediaId, vector) ?? { handled: false }
+}
+export async function resolveScopedMedia(
+  mediaId: string,
+  vector?: boolean,
+): Promise<ScopedMediaResolution> {
+  const owner = current
+  if (!owner) return { handled: false }
+  const result = await owner.resolve(mediaId, vector)
+  if (current !== owner) return { handled: true, url: '' }
+  return result
+}
