+    }
+    if (asset.u) return fail()
+    const match = /^data:(image\/(?:png|jpeg|gif|webp));base64,([A-Za-z0-9+/]*={0,2})$/.exec(
+      asset.p,
+    )
+    if (!match) return fail()
+    const binary = atob(match[2]!)
+    if (
+      btoa(binary) !== match[2] ||
+      rasterMime(Uint8Array.from(binary, (c) => c.charCodeAt(0))) !== match[1]
+    )
+      return fail()
+  }
+  if (document.fonts !== undefined) {
+    const fonts = record(document.fonts)
+    if (fonts.list !== undefined && !Array.isArray(fonts.list)) return fail()
+    for (const raw of Array.isArray(fonts.list) ? fonts.list : []) {
+      const font = record(raw)
+      if (typeof font.fPath === 'string' && !font.fPath.startsWith('data:') && files) {
+        if (!/^f\/[A-Za-z0-9_.-]+$/.test(font.fPath) || !Object.hasOwn(files, font.fPath)) return fail()
+        archiveFontMime(files[font.fPath]!)
+        continue
+      }
+      // Embedded glyph-only documents retain their existing pinned renderer behavior.
+      if (
+        font.fPath !== undefined &&
+        (typeof font.fPath !== 'string' ||
+          !/^data:font\/(?:woff2?|otf|ttf);base64,[A-Za-z0-9+/]+={0,2}$/.test(font.fPath))
+      )
+        return fail()
+    }
+  }
+  for (const raw of Object.values(
+    document.slots && typeof document.slots === 'object' ? document.slots : {},
+  )) {
+    const slot = record(raw)
+    if (
+      slot.p &&
+      typeof slot.p === 'object' &&
+      typeof (slot.p as Record<string, unknown>).p === 'string'
+    )
+      return fail()
+  }
+}
