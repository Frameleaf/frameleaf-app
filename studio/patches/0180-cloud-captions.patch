diff --git a/src/shared/state/cloud-caption-host.ts b/src/shared/state/cloud-caption-host.ts
new file mode 100644
index 0000000..5e87941
--- /dev/null
+++ b/src/shared/state/cloud-caption-host.ts
@@ -0,0 +1,21 @@
+/**
+ * Frameleaf (FL-1304): captions on Frameleaf Cloud.
+ *
+ * The price, the confirmation and the job all belong to the host. The adapter registers this when the
+ * editor mounts inside Frameleaf; without it (plain Freecut, headless export) the dialog offers this
+ * device only.
+ */
+export interface CloudCaptionHost {
+  /** Ask the host to price captions for one timeline clip. `language` is empty for auto-detect. */
+  start(request: { clipId: string; language: string }): void
+}
+
+let host: CloudCaptionHost | null = null
+
+export function registerCloudCaptionHost(next: CloudCaptionHost | null): void {
+  host = next
+}
+
+export function getCloudCaptionHost(): CloudCaptionHost | null {
+  return host
+}
