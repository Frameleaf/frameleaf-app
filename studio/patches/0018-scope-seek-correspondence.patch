+import { act, cleanup, render, screen } from '@testing-library/react'
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vite-plus/test'
+import { usePlaybackStore } from '@/shared/state/playback'
+import { usePreviewBridgeStore } from '@/shared/state/preview-bridge'
+import { ColorScopesView } from './color-scopes-view'
+
+const { createRenderer } = vi.hoisted(() => ({ createRenderer: vi.fn() }))
+vi.mock('@/infrastructure/gpu-scopes', () => ({ ScopeRenderer: { create: createRenderer } }))
+
+function deferred<T>() {
+  let resolve!: (value: T) => void
+  const promise = new Promise<T>((done) => { resolve = done })
+  return { promise, resolve }
+}
+
+describe('scope capture seek correspondence', () => {
+  let callbacks: Map<number, FrameRequestCallback>
+  let callbackId: number
+
+  beforeEach(() => {
+    callbacks = new Map()
+    callbackId = 0
+    vi.stubGlobal('requestAnimationFrame', (callback: FrameRequestCallback) => {
+      callbacks.set(++callbackId, callback)
+      return callbackId
+    })
+    vi.stubGlobal('cancelAnimationFrame', (id: number) => callbacks.delete(id))
+    usePlaybackStore.setState({
+      currentFrame: 12, currentFrameEpoch: 0, previewFrame: null,
+      previewFrameEpoch: 0, frameUpdateEpoch: 0, isPlaying: false,
+    })
+    usePreviewBridgeStore.setState({
+      displayedFrame: null, captureFrame: null,
+      captureFrameImageData: null, captureCanvasSource: null,
+    })
+  })
+
+  afterEach(() => {
+    cleanup()
+    vi.restoreAllMocks()
+    vi.unstubAllGlobals()
+  })
+
+  async function tick(time: number) {
+    await act(async () => {
+      const pending = [...callbacks.values()]
+      callbacks.clear()
+      for (const callback of pending) callback(time)
+    })
+  }
+
+  it.each([
+    ['gpu-canvas', false], ['gpu-image', false], ['cpu', false],
+    ['gpu-canvas', true], ['gpu-image', true],
+  ] as const)(
+    'keeps %s captures current when playing=%s without starving playback',
+    async (path, playing) => {
+      usePlaybackStore.setState({ isPlaying: playing })
+      const oldCapture = deferred<HTMLCanvasElement | ImageData>()
+      const newCapture = deferred<HTMLCanvasElement | ImageData>()
+      const oldFrame = path === 'gpu-canvas' ? document.createElement('canvas') : new ImageData(2, 2)
+      const newFrame = path === 'gpu-canvas' ? document.createElement('canvas') : new ImageData(2, 2)
+      const capture = vi.fn().mockReturnValueOnce(oldCapture.promise).mockReturnValue(newCapture.promise)
+      const renderer = {
+        setMatrix: vi.fn(), setRange: vi.fn(), configureCanvas: vi.fn().mockReturnValue({}),
+        uploadFromCanvas: vi.fn(), uploadFrame: vi.fn(), renderWaveforms: vi.fn(),
+        renderVectorscope: vi.fn(), renderHistogram: vi.fn(), destroy: vi.fn(),
+      }
+      const context = {
+        createImageData: (width: number, height: number) => new ImageData(width, height),
+        putImageData: vi.fn(), fillRect: vi.fn(), save: vi.fn(), restore: vi.fn(),
+        beginPath: vi.fn(), moveTo: vi.fn(), lineTo: vi.fn(), stroke: vi.fn(),
+        fillText: vi.fn(), arc: vi.fn(),
+      }
+      vi.spyOn(HTMLCanvasElement.prototype, 'getContext').mockImplementation(() => context as unknown as CanvasRenderingContext2D)
+      createRenderer.mockResolvedValue(path === 'cpu' ? null : renderer)
+      usePreviewBridgeStore.setState(path === 'gpu-canvas'
+        ? { captureCanvasSource: capture }
+        : { captureFrameImageData: capture })
+
+      await act(async () => { render(<ColorScopesView open />) })
+      expect(screen.getByText('Scopes · sRGB / Rec.709 full-range preview')).toBeInTheDocument()
+      await tick(100)
+      expect(capture).toHaveBeenCalledTimes(1)
+      expect(capture).toHaveBeenLastCalledWith(expect.objectContaining({ preferRenderedFrame: true }))
+
+      if (playing) {
+        await act(async () => {
+          usePlaybackStore.getState().setCurrentFrame(13)
+          oldCapture.resolve(oldFrame)
+        })
+        expect(path === 'gpu-canvas' ? renderer.uploadFromCanvas : renderer.uploadFrame)
+          .toHaveBeenCalledExactlyOnceWith(oldFrame)
+        expect(renderer.renderWaveforms).toHaveBeenCalledOnce()
+        return
+      }
+
+      await act(async () => {
+        usePlaybackStore.getState().setCurrentFrame(24)
+        usePlaybackStore.getState().setCurrentFrame(12)
+        oldCapture.resolve(oldFrame)
+      })
+      expect(renderer.uploadFromCanvas).not.toHaveBeenCalled()
+      expect(renderer.uploadFrame).not.toHaveBeenCalled()
+      expect(renderer.renderWaveforms).not.toHaveBeenCalled()
+      expect(context.putImageData).not.toHaveBeenCalled()
+
+      await tick(200)
+      expect(capture).toHaveBeenCalledTimes(2)
+      await act(async () => { newCapture.resolve(newFrame) })
+      if (path === 'cpu') {
+        expect(context.putImageData).toHaveBeenCalled()
+      } else {
+        expect(path === 'gpu-canvas' ? renderer.uploadFromCanvas : renderer.uploadFrame).toHaveBeenCalledExactlyOnceWith(newFrame)
+        expect(renderer.renderWaveforms).toHaveBeenCalledOnce()
+      }
+    },
+  )
+})
