+/** Missing embedded sound is valid only when the source still contains a video track. */
+async function getActiveAudioSegments(
+  composition: CompositionInputProps,
+  fps: number,
+  signal?: AbortSignal,
+): Promise<AudioSegment[]> {
+  const segments = extractAudioSegments(composition, fps).filter(segment => !segment.muted)
+  const tracklessVideos = new Map<string, boolean>()
+  for (const segment of segments) {
+    if (signal?.aborted) throw new DOMException('Audio processing cancelled', 'AbortError')
+    if (segment.type !== 'video' || segment.audioCodec || tracklessVideos.has(segment.src)) continue
+    const mb = await import('mediabunny')
+    const input = new mb.Input({ formats: mb.ALL_FORMATS, source: createMediabunnyInputSource(mb, segment.src) })
+    try {
+      const audio = await input.getPrimaryAudioTrack()
+      tracklessVideos.set(segment.src, !audio && !!(await input.getPrimaryVideoTrack()))
+    } finally {
+      input.dispose()
+    }
+  }
+  return segments.filter(segment => segment.type !== 'video' || segment.audioCodec || !tracklessVideos.get(segment.src))
+}
+
