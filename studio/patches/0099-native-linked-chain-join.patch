+/** Complete pre-mutation plan for a longer source-contiguous native chain. */
+function planLinkedChainJoin(
+  items: TimelineItem[],
+  itemIds: string[],
+  linked: boolean,
+): readonly (readonly string[])[] | null {
+  const ids = new Set(itemIds)
+  const primary = items.filter((item) => ids.has(item.id)).toSorted((a, b) => a.from - b.from)
+  if (primary.length !== ids.size || !canJoinMultipleItems(primary)) return null
+  if (
+    primary.some(
+      (item) =>
+        !Number.isFinite(item.from) ||
+        !Number.isFinite(item.durationInFrames) ||
+        item.durationInFrames <= 0 ||
+        !Number.isFinite(item.sourceStart) ||
+        !Number.isFinite(item.sourceEnd) ||
+        item.sourceEnd! <= item.sourceStart! ||
+        !Number.isFinite(item.speed ?? 1) ||
+        (item.speed ?? 1) <= 0,
+    )
+  )
+    return null
+  const groups = [primary]
+  const linkedGroups = linked ? primary.map((item) => getLinkedItems(items, item.id)) : []
+  if (
+    linked &&
+    primary.some((item, index) => item.linkedGroupId || linkedGroups[index]!.length > 1)
+  ) {
+    const companions: TimelineItem[] = []
+    for (const [index, item] of primary.entries()) {
+      const members = linkedGroups[index]!
+      if (members.length !== 2) return null
+      const companion = members.find((candidate) => candidate.id !== item.id)
+      if (
+        !companion ||
+        companion.trackId === item.trackId ||
+        (companion.compositionId ?? companion.mediaId) !== (item.compositionId ?? item.mediaId) ||
+        companion.sourceFps !== item.sourceFps ||
+        companion.sourceDuration !== item.sourceDuration
+      )
+        return null
+      const visual = (candidate: TimelineItem) =>
+        candidate.type === 'video' || candidate.type === 'composition'
+      if (
+        !(
+          (visual(item) && companion.type === 'audio') ||
+          (item.type === 'audio' && visual(companion))
+        )
+      )
+        return null
+      companions.push(companion)
+    }
+    if (!canJoinMultipleItems(companions)) return null
+    for (let index = 0; index < primary.length - 1; index++) {
+      const pair = getSynchronizedLinkedCounterpartPairForEdit(
+        items,
+        primary[index]!.id,
+        primary[index + 1]!.id,
+        true,
+      )
+      if (
+        !pair ||
+        pair.leftCounterpart.id !== companions[index]!.id ||
+        pair.rightCounterpart.id !== companions[index + 1]!.id
+      )
+        return null
+    }
+    groups.push(companions)
+  }
+  const tracks = useItemsStore.getState().tracks
+  const keyframes = useKeyframesStore.getState().keyframes
+  const rangeFields = new Set([
+    'id',
+    'from',
+    'durationInFrames',
+    'sourceStart',
+    'sourceEnd',
+    'trimStart',
+    'trimEnd',
+    'linkedGroupId',
+  ])
+  for (const group of groups) {
+    const first = group[0]!
+    const track = tracks.find((candidate) => candidate.id === first.trackId)
+    if (
+      !track ||
+      track.locked ||
+      (track.kind && track.kind !== (first.type === 'audio' ? 'audio' : 'video')) ||
+      !group.every((item) => item.type === first.type)
+    )
+      return null
+    const signature = (item: TimelineItem) =>
+      JSON.stringify(
+        Object.fromEntries(
+          Object.entries(item)
+            .filter(([key]) => !rangeFields.has(key))
+            .sort(([a], [b]) => a.localeCompare(b)),
+        ),
+      )
+    const expected = signature(first)
+    for (const item of group) {
+      // The existing join primitive retains the first item's authored state. A longer join
+      // cannot silently erase another part's animation or change repeated item-relative fades.
+      if (
+        item.isReversed ||
+        (item.speed ?? 1) <= 0 ||
+        item.effects?.length ||
+        item.motionModifiers?.length ||
+        item.motionLayers?.length ||
+        item.audioDucking ||
+        (item.fadeIn ?? 0) > 0 ||
+        (item.fadeOut ?? 0) > 0 ||
+        (item.audioFadeIn ?? 0) > 0 ||
+        (item.audioFadeOut ?? 0) > 0 ||
+        keyframes.some((entry) => entry.itemId === item.id) ||
+        signature(item) !== expected
+      )
+        return null
+    }
+  }
+  return Object.freeze(groups.map((group) => Object.freeze(group.map((item) => item.id))))
+}
