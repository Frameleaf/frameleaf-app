+})
+const seed = (locked: boolean) => {
+  const video = makeTimelineVideoItem({
+    id: 'v',
+    linkedGroupId: 'pair',
+    sourceEnd: 60,
+    sourceDuration: 120,
+  })
+  const audio = makeTimelineAudioItem({
