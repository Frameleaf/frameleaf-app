+  act(() =>
+    result.result.current.handleStretchStart(
+      { button: 0, clientX: 0, stopPropagation() {}, preventDefault() {} } as never,
+      'end',
+    ),
+  )
+  act(() => window.dispatchEvent(new MouseEvent('mousemove', { clientX: 30 })))
+  act(() => window.dispatchEvent(new MouseEvent('mouseup', { clientX: 30 })))
+}
+it('CONTROL unlocked linked rate stretch commits one real history entry and undo/redo both source ranges', () => {
+  const video = seed(false)
+  const hook = renderHook(() => useRateStretch(video, 600, false))
+  gesture(hook)
+  const after = JSON.stringify(useItemsStore.getState().items)
+  expect(useItemsStore.getState().itemById.v?.durationInFrames).toBe(90)
+  expect(useItemsStore.getState().itemById.a?.durationInFrames).toBe(90)
+  expect(useTimelineCommandStore.getState().undoStack).toHaveLength(1)
+  act(() => useTimelineCommandStore.getState().undo())
+  expect(useItemsStore.getState().itemById.v?.durationInFrames).toBe(60)
+  expect(useItemsStore.getState().itemById.a?.durationInFrames).toBe(60)
+  act(() => useTimelineCommandStore.getState().redo())
+  expect(JSON.stringify(useItemsStore.getState().items)).toBe(after)
+  hook.unmount()
+})
