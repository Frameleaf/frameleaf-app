+import type { ReactNode } from 'react'
+import { fireEvent, render, screen, waitFor } from '@testing-library/react'
+import { beforeEach, describe, expect, it, vi } from 'vite-plus/test'
+import { getGpuEffect, getGpuEffectDefaultParams } from '@/infrastructure/gpu-effects'
+import { evaluateHueCurve, parseHuePoints } from '@/infrastructure/gpu-effects/effects/grade'
+import type { GpuEffect, ItemEffect } from '@/types/effects'
+
+vi.mock('react-i18next', () => ({
+  useTranslation: () => ({
+    t: (key: string, values?: Record<string, unknown>) =>
+      typeof values?.defaultValue === 'string'
+        ? values.defaultValue
+        : values
+          ? `${key} ${JSON.stringify(values)}`
+          : key,
+  }),
+}))
+vi.mock('@/shared/ui/property-controls', () => ({
+  PropertyRow: ({ label, children }: { label: string; children: ReactNode }) => (
+    <label>
+      <span>{label}</span>
+      {children}
+    </label>
+  ),
+  SliderInput: ({ value, onChange }: { value: number; onChange: (value: number) => void }) => (
+    <input type="range" value={value} onChange={(event) => onChange(Number(event.target.value))} />
+  ),
+}))
+vi.mock('@/shared/ui/property-controls/number-input', () => ({
+  NumberInput: ({ value, onChange }: { value: number; onChange: (value: number) => void }) => (
+    <input type="number" value={value} onChange={(event) => onChange(Number(event.target.value))} />
+  ),
+}))
+vi.mock('./effect-panel-header-actions', () => ({
+  EffectPanelHeaderRow: ({ label, isDefault }: { label: string; isDefault: boolean }) => (
+    <h4 data-default={isDefault}>{label}</h4>
+  ),
+}))
+
+const { GpuHueCurvesPanel, GpuRgbGridPanel } = await import('./gpu-grade-panels')
+
+const handlers = {
+  onParamChange: vi.fn(),
+  onParamLiveChange: vi.fn(),
+  onParamsBatchChange: vi.fn(),
+  onReset: vi.fn(),
+  onToggle: vi.fn(),
+  onRemove: vi.fn(),
+  onMove: vi.fn(),
+  canMoveUp: false,
+  canMoveDown: false,
+}
+function panelProps(type: string, params: Record<string, number | string> = {}) {
+  const gpuEffect = {
+    type: 'gpu-effect',
+    gpuEffectType: type,
+    params: { ...getGpuEffectDefaultParams(type), ...params },
+  } as GpuEffect
+  const effect = { id: 'fx', enabled: true, effect: gpuEffect } as ItemEffect
+  return { effect, gpuEffect, definition: getGpuEffect(type)!, ...handlers }
+}
+const cell = (key: string) =>
+  document.querySelector(`[data-grade-param="${key}"] input`) as HTMLInputElement
+
+describe('grade panels (FL-1559)', () => {
+  beforeEach(() =>
+    Object.values(handlers).forEach((fn) => typeof fn === 'function' && fn.mockClear()),
+  )
+
+  it('edits ASC CDL per channel, within the effect range', () => {
+    render(<GpuRgbGridPanel {...panelProps('gpu-cdl', { slopeR: 1.04 })} />)
+    expect(cell('slopeR').value).toBe('1.04')
+    expect(screen.getByRole('group', { name: 'engineControls.grade.row.power B' })).toBeTruthy()
+
+    fireEvent.change(cell('offsetB'), { target: { value: '-0.01' } })
+    expect(handlers.onParamChange).toHaveBeenLastCalledWith('fx', 'offsetB', -0.01)
+    fireEvent.change(cell('powerG'), { target: { value: '9' } })
+    expect(handlers.onParamChange).toHaveBeenLastCalledWith('fx', 'powerG', 4)
+    expect(screen.queryByRole('note')).toBeNull()
+  })
+
+  it('loads a .cdl file as one change and says when a file has none', async () => {
+    render(<GpuRgbGridPanel {...panelProps('gpu-cdl')} />)
+    const input = screen.getByLabelText('engineControls.grade.loadCdl', { selector: 'input' })
+    const cdl =
+      '<SOPNode><Slope>1.2 1 0.9</Slope><Offset>0 0 0</Offset><Power>1 1 1</Power></SOPNode><SatNode><Saturation>0.5</Saturation></SatNode>'
+    fireEvent.change(input, { target: { files: [new File([cdl], 'shot.cdl')] } })
+    await waitFor(() => expect(handlers.onParamsBatchChange).toHaveBeenCalledTimes(1))
+    expect(handlers.onParamsBatchChange.mock.calls[0]).toEqual([
+      'fx',
+      expect.objectContaining({ slopeR: 1.2, slopeB: 0.9, saturation: 0.5 }),
+    ])
+
+    fireEvent.change(input, { target: { files: [new File(['nothing'], 'notes.cc')] } })
+    expect((await screen.findByRole('alert')).textContent).toBe('engineControls.grade.loadFailed')
+    expect(handlers.onParamsBatchChange).toHaveBeenCalledTimes(1)
+  })
+
+  it('edits lift, gamma and gain per channel and names the HDR refusal', () => {
+    render(<GpuRgbGridPanel {...panelProps('gpu-lift-gamma-gain')} hdrProject />)
+    expect(screen.getByRole('note').textContent).toBe('engineControls.grade.hdr')
+    expect(cell('gammaG').value).toBe('1')
+    fireEvent.change(cell('liftR'), { target: { value: '0.05' } })
+    expect(handlers.onParamChange).toHaveBeenLastCalledWith('fx', 'liftR', 0.05)
+    expect(
+      screen.queryByLabelText('engineControls.grade.loadCdl', { selector: 'input' }),
+    ).toBeNull()
+  })
+
+  it('adds, nudges and removes hue curve points as the JSON the effect reads', () => {
+    const { rerender } = render(<GpuHueCurvesPanel {...panelProps('gpu-hue-curves')} />)
+    fireEvent.click(screen.getByRole('radio', { name: 'engineControls.grade.hue.sat' }))
+
+    // jsdom has no layout: the click lands on hue 0, at the top of the range.
+    fireEvent.pointerDown(document.querySelector('[data-hue-surface]')!, { clientX: 0, clientY: 0 })
+    const [, param, json] = handlers.onParamChange.mock.calls.at(-1)!
+    expect(param).toBe('hueSatPoints')
+    const points = parseHuePoints(json, 0, 2)
+    expect(points).toHaveLength(1)
+    expect(evaluateHueCurve(points, 0.4, 1)).toBe(points[0]![1])
+
+    rerender(
+      <GpuHueCurvesPanel {...panelProps('gpu-hue-curves', { hueSatPoints: '[[0.25,1.5]]' })} />,
+    )
+    fireEvent.click(screen.getByRole('radio', { name: 'engineControls.grade.hue.sat' }))
+    const point = screen.getByRole('slider', {
+      name: 'engineControls.grade.hue.point {"degrees":90}',
+    })
+    fireEvent.keyDown(point, { key: 'ArrowDown' })
+    expect(handlers.onParamChange).toHaveBeenLastCalledWith('fx', 'hueSatPoints', '[[0.25,1.46]]')
+    fireEvent.keyDown(point, { key: 'Delete' })
+    expect(handlers.onParamChange).toHaveBeenLastCalledWith('fx', 'hueSatPoints', '')
+  })
+})
diff --git a/src/features/effects/components/panels/gpu-grade-panels.tsx b/src/features/effects/components/panels/gpu-grade-panels.tsx
