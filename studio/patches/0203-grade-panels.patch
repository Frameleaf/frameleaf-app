+import { renderHook } from '@testing-library/react'
+import { beforeEach, describe, expect, it, vi } from 'vite-plus/test'
+
+const state = vi.hoisted(() => ({
+  project: { currentProject: { metadata: {} as { colorManagement?: { workingRange?: string } } } },
+  media: { mediaById: {} as Record<string, { colorTransfer?: string }> },
+  items: { items: [] as { mediaId?: string }[] },
+}))
+vi.mock('@/features/editor/deps/projects', () => ({
+  useProjectStore: (select: (s: unknown) => unknown) => select(state.project),
+}))
+vi.mock('@/features/editor/deps/media-library', () => ({
+  useMediaLibraryStore: (select: (s: unknown) => unknown) => select(state.media),
+}))
+vi.mock('@/features/editor/deps/timeline-store', () => ({
+  useItemsStore: (select: (s: unknown) => unknown) => select(state.items),
+}))
+
+const { useProjectIsHdr } = await import('./use-project-is-hdr')
+
+describe('useProjectIsHdr (FL-1559)', () => {
+  beforeEach(() => {
+    state.project.currentProject.metadata = {}
+    state.media.mediaById = { sdr: {}, hlg: { colorTransfer: 'hlg' } }
+    state.items.items = [{ mediaId: 'sdr' }, {}]
+  })
+
+  it('is SDR for SDR sources and no stored range', () => {
+    expect(renderHook(() => useProjectIsHdr()).result.current).toBe(false)
+  })
+
+  it('is HDR with a stored HDR range or any placed HDR clip', () => {
+    state.project.currentProject.metadata = { colorManagement: { workingRange: 'hdr' } }
+    expect(renderHook(() => useProjectIsHdr()).result.current).toBe(true)
+
+    state.project.currentProject.metadata = {}
+    state.items.items = [{ mediaId: 'sdr' }, { mediaId: 'hlg' }]
+    expect(renderHook(() => useProjectIsHdr()).result.current).toBe(true)
+  })
+})
