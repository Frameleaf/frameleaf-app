@@ -0,0 +1,28 @@
+import { useCallback } from 'react'
+import { useItemsStore } from '@/features/editor/deps/timeline-store'
+import { useMediaLibraryStore } from '@/features/editor/deps/media-library'
+import { useProjectStore } from '@/features/editor/deps/projects'
+import { workingRangeOfSources } from '@/shared/graphics/color/managed-color'
+
+/**
+ * Frameleaf (FL-1559): whether the open project works in HDR, by the automatic rule: a stored HDR
+ * working range, or any placed clip whose media is PQ, HLG or host-reported HDR.
+ */
+export function useProjectIsHdr(): boolean {
+  const stored = useProjectStore(
+    (s) => s.currentProject?.metadata.colorManagement?.workingRange === 'hdr',
+  )
+  const mediaById = useMediaLibraryStore((s) => s.mediaById)
+  const hdrSource = useItemsStore(
+    useCallback(
+      (s: { items: readonly { mediaId?: string }[] }) =>
+        workingRangeOfSources(
+          s.items.map((item) =>
+            item.mediaId ? mediaById[item.mediaId]?.colorTransfer : undefined,
+          ),
+        ) === 'hdr',
+      [mediaById],
+    ),
+  )
+  return stored || hdrSource
+}
