@@ -0,0 +1,420 @@
+/**
+ * Frameleaf (FL-1559): panels for the three grades other editors carry. ASC CDL and Lift Gamma
+ * Gain are a grid of red, green and blue values; Hue Curves edits the points of its three curves.
+ * Each is a view of the effect's own params. HDR projects refuse these effects (render spec C4),
+ * so the panel says so instead of leaving the refusal to the render.
+ */
+import { memo, useRef, useState, type KeyboardEvent, type PointerEvent } from 'react'
+import { useTranslation } from 'react-i18next'
+import { FileUp } from 'lucide-react'
+import { Button } from '@/components/ui/button'
+import { cn } from '@/shared/ui/cn'
+import { PropertyRow, SliderInput } from '@/shared/ui/property-controls'
+import { NumberInput } from '@/shared/ui/property-controls/number-input'
+import { evaluateHueCurve, parseHuePoints } from '@/infrastructure/gpu-effects/effects/grade'
+import { getEffectDefinitionName, getEffectParamLabel } from '@/features/effects/utils/effect-i18n'
+import { parseCdlFile } from '@/features/effects/utils/cdl-file'
+import { EffectPanelHeaderRow } from './effect-panel-header-actions'
+import type { GpuPanelBaseProps, GpuParamUpdates } from './panel-props'
+
+export interface GpuGradePanelProps extends GpuPanelBaseProps {
+  onParamsBatchChange: (effectId: string, updates: GpuParamUpdates) => void
+  /** The project works in HDR, where these effects are refused. */
+  hdrProject?: boolean
+}
+
+const CHANNELS = ['R', 'G', 'B'] as const
+const GRIDS = {
+  'gpu-cdl': ['slope', 'offset', 'power'],
+  'gpu-lift-gamma-gain': ['lift', 'gamma', 'gain'],
+} as const
+
+function useGradePanel({ effect, gpuEffect, definition }: GpuGradePanelProps) {
+  const number = (key: string) => {
+    const value = gpuEffect.params[key]
+    return typeof value === 'number' ? value : (definition.params[key]?.default as number)
+  }
+  const isDefault = Object.entries(definition.params).every(
+    ([key, param]) => (gpuEffect.params[key] ?? param.default) === param.default,
+  )
+  return { number, isDefault, disabled: !effect.enabled }
+}
+
+function HdrNotice({ hdrProject }: { hdrProject?: boolean }) {
+  const { t } = useTranslation()
+  return hdrProject ? (
+    <p role="note" className="px-2 py-1 text-[11px] leading-snug text-destructive">
+      {t('engineControls.grade.hdr')}
+    </p>
+  ) : null
+}
+
+/** ASC CDL and Lift Gamma Gain: one row per stage, one number per channel. */
+export const GpuRgbGridPanel = memo(function GpuRgbGridPanel(props: GpuGradePanelProps) {
+  const { effect, definition, onParamChange, onParamLiveChange, onParamsBatchChange } = props
+  const { t } = useTranslation()
+  const [collapsed, setCollapsed] = useState(false)
+  const [loadError, setLoadError] = useState(false)
+  const fileInput = useRef<HTMLInputElement | null>(null)
+  const { number, isDefault, disabled } = useGradePanel(props)
+  const isCdl = definition.id === 'gpu-cdl'
+  const rows = GRIDS[isCdl ? 'gpu-cdl' : 'gpu-lift-gamma-gain']
+  const clamp = (key: string, value: number) => {
+    const param = definition.params[key]
+    return Math.min(param?.max ?? value, Math.max(param?.min ?? value, value))
+  }
+
+  const loadCdl = async (file: File | undefined) => {
+    if (!file) return
+    const values = parseCdlFile(await file.text())
+    setLoadError(!values)
+    if (!values) return
+    onParamsBatchChange(
+      effect.id,
+      Object.fromEntries(Object.entries(values).map(([key, value]) => [key, clamp(key, value)])),
+    )
+  }
+
+  return (
+    <div className="space-y-0">
+      <EffectPanelHeaderRow
+        label={getEffectDefinitionName(definition)}
+        effectId={effect.id}
+        enabled={effect.enabled}
+        isDefault={isDefault}
+        onReset={props.onReset}
+        onToggle={props.onToggle}
+        onRemove={props.onRemove}
+        onMove={props.onMove}
+        canMoveUp={props.canMoveUp}
+        canMoveDown={props.canMoveDown}
+        collapsed={collapsed}
+        onToggleCollapsed={() => setCollapsed((value) => !value)}
+      />
+      {collapsed ? null : (
+        <div className={cn('space-y-1.5 py-1.5', disabled && 'opacity-50')}>
+          <HdrNotice hdrProject={props.hdrProject} />
+          <p className="px-2 text-[11px] leading-snug text-muted-foreground">
+            {t(isCdl ? 'engineControls.grade.cdlNote' : 'engineControls.grade.fineAdjust')}
+          </p>
+          <div
+            role="group"
+            aria-label={getEffectDefinitionName(definition)}
+            className="grid grid-cols-[3rem_repeat(3,minmax(0,1fr))] items-center gap-1.5 px-2"
+          >
+            <span />
+            {CHANNELS.map((channel) => (
+              <span
+                key={channel}
+                className={cn(
+                  'text-center text-[11px] font-medium',
+                  channel === 'R' && 'text-red-500',
+                  channel === 'G' && 'text-green-500',
+                  channel === 'B' && 'text-blue-500',
+                )}
+              >
+                {channel}
+              </span>
+            ))}
+            {rows.map((row) => (
+              <div key={row} className="contents">
+                <span className="text-xs text-muted-foreground">
+                  {t(`engineControls.grade.row.${row}`)}
+                </span>
+                {CHANNELS.map((channel) => {
+                  const key = `${row}${channel}`
+                  const param = definition.params[key]
+                  return (
+                    <div
+                      key={key}
+                      role="group"
+                      aria-label={`${t(`engineControls.grade.row.${row}`)} ${channel}`}
+                      data-grade-param={key}
+                    >
+                      <NumberInput
+                        value={number(key)}
+                        onChange={(value) => onParamChange(effect.id, key, clamp(key, value))}
+                        onLiveChange={(value) =>
+                          onParamLiveChange(effect.id, key, clamp(key, value))
+                        }
+                        min={param?.min}
+                        max={param?.max}
+                        step={param?.step ?? 0.01}
+                        disabled={disabled}
+                        // No unit: the cell is narrow, and a signed value needs its width.
+                        unitWidth={0}
+                        className="min-w-0"
+                      />
+                    </div>
+                  )
+                })}
+              </div>
+            ))}
+          </div>
+          {isCdl ? (
+            <>
+              <PropertyRow label={getEffectParamLabel(t, definition, 'saturation')}>
+                <SliderInput
+                  value={number('saturation')}
+                  onChange={(value) => onParamChange(effect.id, 'saturation', value)}
+                  onLiveChange={(value) => onParamLiveChange(effect.id, 'saturation', value)}
+                  min={definition.params.saturation?.min ?? 0}
+                  max={definition.params.saturation?.max ?? 4}
+                  step={0.01}
+                  disabled={disabled}
+                  className="min-w-0 flex-1"
+                />
+              </PropertyRow>
+              <div className="px-2">
+                <Button
+                  variant="outline"
+                  size="sm"
+                  className="h-6 w-full justify-start gap-1.5 text-xs"
+                  disabled={disabled}
+                  onClick={() => fileInput.current?.click()}
+                >
+                  <FileUp className="h-3 w-3 shrink-0" />
+                  {t('engineControls.grade.loadCdl')}
+                </Button>
+                <input
+                  ref={fileInput}
+                  type="file"
+                  accept=".cdl,.cc,.ccc,.xml"
+                  className="hidden"
+                  aria-label={t('engineControls.grade.loadCdl')}
+                  onChange={(event) => {
+                    const file = event.target.files?.[0]
+                    event.target.value = ''
+                    void loadCdl(file)
+                  }}
+                />
+                {loadError ? (
+                  <p role="alert" className="pt-1 text-[11px] text-destructive">
+                    {t('engineControls.grade.loadFailed')}
+                  </p>
+                ) : null}
+              </div>
+            </>
+          ) : null}
+        </div>
+      )}
+    </div>
+  )
+})
+
+/** The three hue curves: the param each writes, its value range and its neutral value. */
+export const HUE_CURVE_KINDS = [
+  { id: 'hue', param: 'hueHuePoints', min: -0.5, max: 0.5, neutral: 0 },
+  { id: 'sat', param: 'hueSatPoints', min: 0, max: 2, neutral: 1 },
+  { id: 'luma', param: 'hueLumaPoints', min: 0, max: 2, neutral: 1 },
+] as const
+/** As many points as a curve keeps (`parseHuePoints`). */
+const MAX_HUE_POINTS = 16
+const HUE_WIDTH = 268
+const HUE_HEIGHT = 120
+const HUE_PAD = 12
+const round = (value: number) => Math.round(value * 1000) / 1000
+const serialize = (points: readonly (readonly [number, number])[]) =>
+  points.length > 0 ? JSON.stringify(points.map(([hue, value]) => [round(hue), round(value)])) : ''
+
+export const GpuHueCurvesPanel = memo(function GpuHueCurvesPanel(props: GpuGradePanelProps) {
+  const { effect, gpuEffect, definition, onParamChange, onParamLiveChange } = props
+  const { t } = useTranslation()
+  const [collapsed, setCollapsed] = useState(false)
+  const [kindId, setKindId] = useState<(typeof HUE_CURVE_KINDS)[number]['id']>('hue')
+  const dragging = useRef<{ index: number; points: [number, number][] } | null>(null)
+  const { number, isDefault, disabled } = useGradePanel(props)
+  const kind = HUE_CURVE_KINDS.find((entry) => entry.id === kindId)!
+  const points = parseHuePoints(gpuEffect.params[kind.param], kind.min, kind.max)
+  const kindLabel = t(`engineControls.grade.hue.${kind.id}`)
+
+  const x = (hue: number) => hue * HUE_WIDTH
+  const y = (value: number) =>
+    HUE_HEIGHT - HUE_PAD - ((value - kind.min) / (kind.max - kind.min)) * (HUE_HEIGHT - 2 * HUE_PAD)
+  const at = (event: PointerEvent<SVGElement>): [number, number] => {
+    const box =
+      event.currentTarget.ownerSVGElement?.getBoundingClientRect() ??
+      event.currentTarget.getBoundingClientRect()
+    const hue = Math.min(0.999, Math.max(0, (event.clientX - box.left) / (box.width || 1)))
+    const unit =
+      1 -
+      ((event.clientY - box.top) / (box.height || 1)) * (HUE_HEIGHT / (HUE_HEIGHT - 2 * HUE_PAD)) +
+      HUE_PAD / (HUE_HEIGHT - 2 * HUE_PAD)
+    return [hue, Math.min(kind.max, Math.max(kind.min, kind.min + unit * (kind.max - kind.min)))]
+  }
+  const commit = (next: readonly (readonly [number, number])[]) =>
+    onParamChange(effect.id, kind.param, serialize(next))
+
+  const path = Array.from({ length: 65 }, (_, index) => {
+    const hue = index / 64
+    return `${index ? 'L' : 'M'}${x(hue).toFixed(1)} ${y(evaluateHueCurve(points, hue, kind.neutral)).toFixed(1)}`
+  }).join(' ')
+
+  const onPointKey = (event: KeyboardEvent<SVGCircleElement>, index: number) => {
+    const step = (kind.max - kind.min) / 50
+    const delta = event.key === 'ArrowUp' ? step : event.key === 'ArrowDown' ? -step : 0
+    if (delta !== 0) {
+      event.preventDefault()
+      commit(
+        points.map((point, i) =>
+          i === index
+            ? [point[0], Math.min(kind.max, Math.max(kind.min, point[1] + delta))]
+            : point,
+        ),
+      )
+    } else if (event.key === 'Delete' || event.key === 'Backspace') {
+      event.preventDefault()
+      commit(points.filter((_, i) => i !== index))
+    }
+  }
+
+  return (
+    <div className="space-y-0">
+      <EffectPanelHeaderRow
+        label={getEffectDefinitionName(definition)}
+        effectId={effect.id}
+        enabled={effect.enabled}
+        isDefault={isDefault}
+        onReset={props.onReset}
+        onToggle={props.onToggle}
+        onRemove={props.onRemove}
+        onMove={props.onMove}
+        canMoveUp={props.canMoveUp}
+        canMoveDown={props.canMoveDown}
+        collapsed={collapsed}
+        onToggleCollapsed={() => setCollapsed((value) => !value)}
+      />
+      {collapsed ? null : (
+        <div className={cn('space-y-1.5 py-1.5', disabled && 'opacity-50')}>
+          <HdrNotice hdrProject={props.hdrProject} />
+          <div
+            role="radiogroup"
+            aria-label={getEffectDefinitionName(definition)}
+            className="mx-2 flex items-center gap-0.5 rounded-md bg-secondary p-0.5"
+          >
+            {HUE_CURVE_KINDS.map((entry) => (
+              <button
+                key={entry.id}
+                type="button"
+                role="radio"
+                aria-checked={kindId === entry.id}
+                onClick={() => setKindId(entry.id)}
+                className={cn(
+                  'inline-flex h-7 flex-1 items-center justify-center rounded px-2 text-xs transition-colors',
+                  kindId === entry.id
+                    ? 'bg-background text-foreground shadow-sm'
+                    : 'text-muted-foreground hover:text-foreground',
+                )}
+              >
+                {t(`engineControls.grade.hue.${entry.id}`)}
+              </button>
+            ))}
+          </div>
+          <div className="px-2">
+            <svg
+              viewBox={`0 0 ${HUE_WIDTH} ${HUE_HEIGHT}`}
+              role="group"
+              aria-label={t('engineControls.grade.hue.curve', { kind: kindLabel })}
+              className="w-full touch-none rounded-md bg-muted/30"
+            >
+              <defs>
+                <linearGradient id={`hue-band-${effect.id}`} x1="0" x2="1">
+                  {[0, 60, 120, 180, 240, 300, 360].map((hue) => (
+                    <stop key={hue} offset={hue / 360} stopColor={`hsl(${hue} 70% 52%)`} />
+                  ))}
+                </linearGradient>
+              </defs>
+              <rect
+                data-hue-surface
+                x={0}
+                y={0}
+                width={HUE_WIDTH}
+                height={HUE_HEIGHT}
+                fill="transparent"
+                onPointerDown={(event) => {
+                  if (disabled || points.length >= MAX_HUE_POINTS) return
+                  commit([...points, at(event)].sort((a, b) => a[0] - b[0]))
+                }}
+              />
+              <rect
+                x={0}
+                y={HUE_HEIGHT - 8}
+                width={HUE_WIDTH}
+                height={8}
+                fill={`url(#hue-band-${effect.id})`}
+                pointerEvents="none"
+              />
+              <line
+                x1={0}
+                x2={HUE_WIDTH}
+                y1={y(kind.neutral)}
+                y2={y(kind.neutral)}
+                className="stroke-border"
+                pointerEvents="none"
+              />
+              <path
+                d={path}
+                fill="none"
+                strokeWidth={1.5}
+                className="stroke-primary"
+                pointerEvents="none"
+              />
+              {points.map(([hue, value], index) => (
+                <circle
+                  key={index}
+                  cx={x(hue)}
+                  cy={y(value)}
+                  r={5}
+                  tabIndex={disabled ? -1 : 0}
+                  role="slider"
+                  aria-label={t('engineControls.grade.hue.point', {
+                    degrees: Math.round(hue * 360),
+                  })}
+                  aria-valuemin={kind.min}
+                  aria-valuemax={kind.max}
+                  aria-valuenow={round(value)}
+                  className="cursor-grab fill-background stroke-primary"
+                  strokeWidth={1.5}
+                  onKeyDown={(event) => onPointKey(event, index)}
+                  onDoubleClick={() => commit(points.filter((_, i) => i !== index))}
+                  onPointerDown={(event) => {
+                    if (disabled) return
+                    event.currentTarget.setPointerCapture?.(event.pointerId)
+                    dragging.current = { index, points: points.map((point) => [...point]) }
+                  }}
+                  onPointerMove={(event) => {
+                    const drag = dragging.current
+                    if (!drag) return
+                    // The hue stays put: a point is dragged up or down.
+                    drag.points[drag.index] = [drag.points[drag.index]![0], at(event)[1]]
+                    onParamLiveChange(effect.id, kind.param, serialize(drag.points))
+                  }}
+                  onPointerUp={() => {
+                    const drag = dragging.current
+                    dragging.current = null
+                    if (drag) commit(drag.points)
+                  }}
+                />
+              ))}
+            </svg>
+            <p className="pt-1 text-[11px] leading-snug text-muted-foreground">
+              {t('engineControls.grade.hue.hint')}
+            </p>
+          </div>
+          <PropertyRow label={getEffectParamLabel(t, definition, 'mix')}>
+            <SliderInput
+              value={number('mix')}
+              onChange={(value) => onParamChange(effect.id, 'mix', value)}
+              onLiveChange={(value) => onParamLiveChange(effect.id, 'mix', value)}
+              min={0}
+              max={1}
+              step={0.01}
+              disabled={disabled}
+              className="min-w-0 flex-1"
+            />
+          </PropertyRow>
+        </div>
+      )}
+    </div>
+  )
+})
