+// @vitest-environment node
+
+import { describe, expect, it } from 'vite-plus/test'
+import { parseCdlFile } from './cdl-file'
+
+describe('ASC CDL files (FL-1559)', () => {
+  it('reads slope, offset, power and saturation from a colour correction', () => {
+    expect(
+      parseCdlFile(`<?xml version="1.0"?>
+<ColorDecisionList xmlns="urn:ASC:CDL:v1.01"><ColorDecision><ColorCorrection id="shot_010">
+  <SOPNode><Slope>1.04 1 0.96</Slope><Offset>0.01 0 -1e-2</Offset><Power>.98 1 1.03</Power></SOPNode>
+  <SatNode><Saturation>0.92</Saturation></SatNode>
+</ColorCorrection></ColorDecision></ColorDecisionList>`),
+    ).toEqual({
+      slopeR: 1.04,
+      slopeG: 1,
+      slopeB: 0.96,
+      offsetR: 0.01,
+      offsetG: 0,
+      offsetB: -0.01,
+      powerR: 0.98,
+      powerG: 1,
+      powerB: 1.03,
+      saturation: 0.92,
+    })
+  })
+
+  it('takes saturation as 1 when the file has none, and refuses a file without a full SOP', () => {
+    expect(
+      parseCdlFile(
+        '<ColorCorrection><SOPNode><Slope>1 1 1</Slope><Offset>0 0 0</Offset><Power>1 1 1</Power></SOPNode></ColorCorrection>',
+      )?.saturation,
+    ).toBe(1)
+    expect(
+      parseCdlFile(
+        '<SOPNode><Slope>1 1</Slope><Offset>0 0 0</Offset><Power>1 1 1</Power></SOPNode>',
+      ),
+    ).toBeNull()
+    expect(parseCdlFile('LUT_3D_SIZE 2')).toBeNull()
+  })
+})
diff --git a/src/features/effects/utils/cdl-file.ts b/src/features/effects/utils/cdl-file.ts
new file mode 100644
index 0000000..1d8147a
--- /dev/null
+++ b/src/features/effects/utils/cdl-file.ts
@@ -0,0 +1,46 @@
+/**
+ * Frameleaf (FL-1559): read an ASC CDL from a `.cdl`, `.cc` or `.ccc` file: the first SOP node's
+ * slope, offset and power (three numbers each) and the first saturation, as `gpu-cdl` params.
+ */
+export type CdlParams = Record<
+  `${'slope' | 'offset' | 'power'}${'R' | 'G' | 'B'}` | 'saturation',
+  number
+>
+
+const NUMBER = String.raw`[-+]?(?:\d+\.?\d*|\.\d+)(?:[eE][-+]?\d+)?`
+const triple = (text: string, tag: string): [number, number, number] | null => {
+  const match = new RegExp(
+    String.raw`<${tag}\b[^>]*>\s*(${NUMBER})\s+(${NUMBER})\s+(${NUMBER})\s*</${tag}>`,
+    'i',
+  ).exec(text)
+  if (!match) return null
+  const values = match.slice(1, 4).map(Number) as [number, number, number]
+  return values.every(Number.isFinite) ? values : null
+}
+
+/** The CDL values of the file, or null when it holds no complete SOP node. */
+export function parseCdlFile(text: string): CdlParams | null {
+  const slope = triple(text, 'Slope')
+  const offset = triple(text, 'Offset')
+  const power = triple(text, 'Power')
+  if (!slope || !offset || !power) return null
+  const saturation = new RegExp(
+    String.raw`<Saturation\b[^>]*>\s*(${NUMBER})\s*</Saturation>`,
+    'i',
+  ).exec(text)
+  const [slopeR, slopeG, slopeB] = slope
+  const [offsetR, offsetG, offsetB] = offset
+  const [powerR, powerG, powerB] = power
+  return {
+    slopeR,
+    slopeG,
+    slopeB,
+    offsetR,
+    offsetG,
+    offsetB,
+    powerR,
+    powerG,
+    powerB,
+    saturation: saturation ? Number(saturation[1]) : 1,
+  }
+}
