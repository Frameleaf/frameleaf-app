+// @vitest-environment node
+import { afterEach, describe, expect, it, vi } from 'vite-plus/test'
+const native = vi.hoisted(() => ({
+  loaded: true,
+  setter: true,
+  theme: true,
+  instances: [] as any[],
+}))
+vi.mock('@lottiefiles/dotlottie-web', () => ({
+  DotLottie: class {
+    static setWasmUrl() {}
+    isLoaded = native.loaded
+    listeners = new Map<string, () => void>()
+    totalFrames = 48
+    duration = 2
+    destroy = vi.fn()
+    setFrame = vi.fn()
+    slots = new Map<string, unknown>()
+    getSlot = vi.fn((id: string) => this.slots.get(id))
+    setThemeData = vi.fn(() => native.theme)
+    getSlotType = vi.fn((id: string) =>
+      id === 'scalar' ? 'scalar' : id === 'vector' ? 'vector' : undefined,
+    )
+    setScalarSlot = vi.fn((id: string, value: unknown) => {
+      this.slots.set(id, { a: 0, k: value })
+      return native.setter
+    })
+    setVectorSlot = vi.fn((id: string, value: unknown) => {
+      this.slots.set(id, { a: 0, k: value })
+      return native.setter
+    })
+    constructor() {
+      native.instances.push(this)
+    }
+    addEventListener(event: string, listener: () => void) {
+      this.listeners.set(event, listener)
+    }
+  },
+}))
+import { LottieRenderer, LottieExportProvider } from './lottie-frame-provider'
+afterEach(() => {
+  native.loaded = true
+  native.setter = true
+  native.theme = true
+  native.instances = []
+  vi.useRealTimers()
+})
+const canvas = { width: 64, height: 32 } as OffscreenCanvas
+const config = { canvas, data: '{"layers":[]}', strict: true }
+describe('strict native provider admission (controlled native API, no pixel qualification)', () => {
+  it('applies every finite known slot before rendering, retaining transparent deterministic configuration', async () => {
+    const renderer = new LottieRenderer({ ...config, slots: { scalar: 2, vector: [1, -1] } })
+    await renderer.ready
+    renderer.renderFrame(12)
+    expect(native.instances[0].setScalarSlot).toHaveBeenCalledWith('scalar', 2)
+    expect(native.instances[0].setVectorSlot).toHaveBeenCalledWith('vector', [1, -1])
+    expect(native.instances[0].setFrame).toHaveBeenCalledWith(12)
+    renderer.destroy()
+    expect(native.instances[0].destroy).toHaveBeenCalledTimes(1)
+  })
+  it('refuses missing slots, nonfinite values, failed setters and failed themes', async () => {
+    for (const slots of [{ missing: 1 }, { scalar: NaN }, { vector: [1, Infinity] }]) {
+      const renderer = new LottieRenderer({ ...config, slots: slots as any })
+      await expect(renderer.ready).rejects.toThrow()
+      renderer.destroy()
+    }
+    native.setter = false
+    const failed = new LottieRenderer({ ...config, slots: { scalar: 1 } })
+    await expect(failed.ready).rejects.toThrow()
+    failed.destroy()
+    native.theme = false
+    const themed = new LottieRenderer({ ...config, themeData: '{"rules":[]}' })
+    await expect(themed.ready).rejects.toThrow()
+    themed.destroy()
+  })
+  it('refuses seek-before-load, abort and destroyed-provider use without sampling', async () => {
+    native.loaded = false
+    const abort = new AbortController()
+    const renderer = new LottieRenderer({ ...config, signal: abort.signal })
+    const rejection = expect(renderer.ready).rejects.toThrow()
+    expect(() => renderer.renderFrame(1)).toThrow()
+    abort.abort()
+    await rejection
+    expect(() => renderer.renderFrame(1)).toThrow()
+    renderer.destroy()
+    expect(native.instances[0].destroy).toHaveBeenCalledTimes(1)
+    expect(native.instances[0].setFrame).not.toHaveBeenCalled()
+  })
+})
+
+it('strict canvas allocation rejects omitted/noninteger/excessive dimensions before construction', async () => {
+  const allocated: number[][] = []
+  vi.stubGlobal(
+    'OffscreenCanvas',
+    class {
+      width: number
+      height: number
+      constructor(width: number, height: number) {
+        this.width = width
+        this.height = height
+        allocated.push([width, height])
+      }
+    },
+  )
+  try {
+    for (const [width, height] of [
+      [undefined, 32],
+      [64, undefined],
+      [0, 32],
+      [1.5, 32],
+      [1e12, 32],
+      [8001, 8000],
+    ]) {
+      const provider = new LottieExportProvider(true)
+      await expect(
+        provider.preload('item', 'unused', width as number, height as number, '{"layers":[]}'),
+      ).rejects.toThrow('LOTTIE_CANVAS_DIMENSIONS_REFUSED')
+      provider.destroy()
+    }
+    expect(allocated).toEqual([])
+  } finally {
+    vi.unstubAllGlobals()
+  }
+})
+
+it('failed strict rebuild destroys only the replacement, preserves the readiness error and permits retry', async () => {
+  vi.stubGlobal(
+    'OffscreenCanvas',
+    class {
+      constructor(
+        public width: number,
+        public height: number,
+      ) {}
+    },
+  )
+  const readyGetter = Object.getOwnPropertyDescriptor(LottieRenderer.prototype, 'ready')!.get!
+  let replacementReady: Promise<void> | undefined
+  const readySpy = vi
+    .spyOn(LottieRenderer.prototype, 'ready', 'get')
+    .mockImplementation(function (this: LottieRenderer) {
+      const ready = readyGetter.call(this) as Promise<void>
+      replacementReady = ready
+      return ready
+    })
+  try {
+    for (const failure of ['load', 'theme', 'slot']) {
+      native.loaded = true
+      native.theme = true
+      native.setter = true
+      const provider = new LottieExportProvider(true)
+      await provider.preload('item', 'unused', 64, 32, '{"layers":[]}', 'installed')
+      const installed = provider.get('item')!
+      const installedNative = native.instances.at(-1)
+      native.loaded = failure !== 'load'
+      native.theme = failure !== 'theme'
+      native.setter = failure !== 'slot'
+      const rejected = provider
+        .rebuild('item', 'unused', 64, 32, '{"layers":[]}', 'replacement', '{"rules":[]}', {
+          scalar: 1,
+        })
+        .catch((error) => error)
+      const replacement = native.instances.at(-1)
+      const readinessError = replacementReady!.catch((error) => error)
+      if (failure === 'load') replacement.listeners.get('loadError')!()
+      const originalError = await readinessError
+      expect(await rejected).toBe(originalError)
+      expect(originalError.message).toBe('LOTTIE_LOAD_OR_EDIT_FAILED')
+      expect(replacement.destroy).toHaveBeenCalledTimes(1)
+      expect(provider.get('item')).toBe(installed)
+      expect(provider.getSignature('item')).toBe('installed')
+      expect(installedNative.destroy).not.toHaveBeenCalled()
+      native.loaded = true
+      native.theme = true
+      native.setter = true
+      await provider.rebuild('item', 'unused', 64, 32, '{"layers":[]}', 'replacement')
+      expect(provider.get('item')).not.toBe(installed)
+      expect(provider.getSignature('item')).toBe('replacement')
+      expect(installedNative.destroy).toHaveBeenCalledTimes(1)
+      provider.destroy()
+    }
+  } finally {
+    readySpy.mockRestore()
+    vi.unstubAllGlobals()
+  }
+})
