+export function requireLottieDimensions(
+  width: unknown,
+  height: unknown,
+): { width: number; height: number } {
+  if (
+    typeof width !== 'number' ||
+    typeof height !== 'number' ||
+    !Number.isSafeInteger(width) ||
+    !Number.isSafeInteger(height) ||
+    width <= 0 ||
+    height <= 0 ||
+    width * height > 64_000_000
+  ) {
+    throw new Error('LOTTIE_CANVAS_DIMENSIONS_REFUSED')
+  }
+  return { width, height }
