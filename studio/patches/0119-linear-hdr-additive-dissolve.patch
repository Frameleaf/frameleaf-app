@@ -0,0 +1,54 @@
+/**
+ * FL-97: additive dissolve in linear display-referred BT.709 (1 = reference white).
+ * The pinned 0.22 flash is a dimensionless light gain, not an encoded offset.
+ * Inputs are premultiplied before filtering; output is straight rgba16float.
+ * All other transition operators remain unqualified and refused.
+ */
+export function isLinearHdrTransition(id: string): boolean {
+  return id === 'additiveDissolve'
+}
+
+export const LINEAR_TRANSITION_INPUT_WGSL = /* wgsl */ `
+override inputAlreadyPremultiplied: bool = false;
+@group(0) @binding(0) var source: texture_2d<f32>;
+@fragment
+fn premultiplyFragment(input: VertexOutput) -> @location(0) vec4f {
+  let color = textureLoad(source, vec2i(input.position.xy), 0);
+  let coverage = clamp(color.a, 0.0, 1.0);
+  // Sanitize each texel before bilinear filtering, including premultiplied inputs.
+  if (coverage <= 0.0) { return vec4f(0.0); }
+  if (inputAlreadyPremultiplied) { return vec4f(color.rgb, coverage); }
+  return vec4f(color.rgb * coverage, coverage);
+}`
+
+export const LINEAR_ADDITIVE_WGSL = /* wgsl */ `
+struct AdditiveDissolveParams {
+  progress: f32,
+  width: f32,
+  height: f32,
+  _pad: f32,
+};
+@group(0) @binding(0) var texSampler: sampler;
+@group(0) @binding(1) var leftTex: texture_2d<f32>;
+@group(0) @binding(2) var rightTex: texture_2d<f32>;
+@group(0) @binding(3) var<uniform> params: AdditiveDissolveParams;
+
+fn linearTransitionStraight(color: vec4f) -> vec4f {
+  let coverage = quantizeToF16(color.a);
+  if (coverage <= 0.0) { return vec4f(0.0); }
+  return vec4f(color.rgb / color.a, coverage);
+}
+
+@fragment
+fn linearAdditiveFragment(input: VertexOutput) -> @location(0) vec4f {
+  let left = textureSampleLevel(leftTex, texSampler, input.uv, 0.0);
+  let right = textureSampleLevel(rightTex, texSampler, input.uv, 0.0);
+  if (params.progress <= 0.0) { return linearTransitionStraight(left); }
+  if (params.progress >= 1.0) { return linearTransitionStraight(right); }
+  let p = params.progress;
+  // Preserve Freecut's authored envelope/coefficient, applied to linear light.
+  let flash = sin(p * PI) * 0.22;
+  let rgb = left.rgb * (1.0 - p) + right.rgb * p + (left.rgb + right.rgb) * flash;
+  let coverage = mix(left.a, right.a, p);
+  return linearTransitionStraight(vec4f(rgb, coverage));
+}`
