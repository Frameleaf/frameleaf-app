+import { persistGeneratedMediaAsset } from './media-asset-helpers'
+
+const storage = vi.hoisted(() => ({
+  associateMediaWithProject: vi.fn(),
+  createMedia: vi.fn(),
+  deleteMedia: vi.fn(),
+  deleteThumbnailsByMediaId: vi.fn(),
+  saveThumbnail: vi.fn(),
+  writeMediaSource: vi.fn(),
+}))
+vi.mock('@/features/media-library/deps/storage', () => storage)
+vi.mock('@/features/media-library/services/opfs-service', () => ({
+  opfsService: { saveFile: vi.fn(), deleteFile: vi.fn() },
+}))
+
+const makeMedia = (): MediaMetadata => ({
+  id: 'generated',
+  storageType: 'workspace',
+  fileName: 'out.mp4',
+  fileSize: 5,
+  mimeType: 'video/mp4',
+  duration: 1,
+  width: 1280,
+  height: 720,
+  fps: 30000 / 1001,
+  codec: 'avc',
+  bitrate: 1,
+  tags: [],
+  createdAt: 1,
+  updatedAt: 1,
+})
+
+describe('generated completion persistence boundary', () => {
+  beforeEach(() => {
+    vi.resetAllMocks()
+  })
+  const setup = () => {
+    const calls: string[] = []
+    for (const name of ['writeMediaSource', 'saveThumbnail', 'createMedia', 'associateMediaWithProject'] as const) {
+      storage[name].mockImplementation(async () => {
+        calls.push(name)
+      })
+    }
+    const root = asHandle(createRoot())
+    let current = true
+    const completion = {
+      hold: vi.fn(async () => {
+        calls.push('hold')
+      }),
+      complete: vi.fn(async () => {
+        calls.push('complete')
+      }),
+      cancel: vi.fn(),
+    }
+    const options = {
+      file: new File(['bytes'], 'out.mp4', { type: 'video/mp4' }),
+      projectId: 'project',
+      mediaMetadata: makeMedia(),
+      thumbnailBlob: new Blob(['thumb']),
+      thumbnailWidth: 320,
+      thumbnailHeight: 180,
+      admission: { root, isCurrent: () => current },
+      completion,
+    }
+    return {
+      calls,
+      completion,
+      options,
+      retire: () => {
+        current = false
+      },
+    }
+  }
+  it('calls completion only after all owned writes and project association on captured root', async () => {
+    const state = setup()
+    const media = await persistGeneratedMediaAsset(state.options)
+    expect(state.calls).toEqual([
+      'hold',
+      'writeMediaSource',
+      'saveThumbnail',
+      'createMedia',
+      'associateMediaWithProject',
+      'complete',
+    ])
+    expect(state.completion.complete).toHaveBeenCalledWith(state.options.file, media)
+    expect(storage.writeMediaSource.mock.calls[0]?.[3]).toMatchObject({
+      originRoot: state.options.admission.root,
+      rejectExisting: true,
+    })
+    expect(storage.associateMediaWithProject).toHaveBeenCalledWith(
+      'project',
+      media.id,
+      state.options.admission.root,
+      state.options.admission.isCurrent,
+    )
+  })
+  it.each(['hold', 'writeMediaSource', 'saveThumbnail', 'createMedia', 'associateMediaWithProject'] as const)(
+    'never calls completion when %s fails',
+    async (stage: 'hold' | 'writeMediaSource' | 'saveThumbnail' | 'createMedia' | 'associateMediaWithProject') => {
+      const state = setup()
+      const failing = stage === 'hold' ? state.completion.hold : storage[stage]
+      failing.mockRejectedValueOnce(new Error(stage))
+      await expect(persistGeneratedMediaAsset(state.options)).rejects.toThrow(stage)
+      expect(state.completion.complete).not.toHaveBeenCalled()
+      expect(state.completion.cancel).toHaveBeenCalledWith('generated')
+      // Preserve existing scoped conservative rollback; never delete uncertain namespaces.
+      expect(storage.deleteMedia).not.toHaveBeenCalled()
+    },
+  )
+  it('refuses completion when cancellation or retirement wins after association', async () => {
+    const state = setup()
+    storage.associateMediaWithProject.mockImplementationOnce(async () => {
+      state.retire()
+    })
+    await expect(persistGeneratedMediaAsset(state.options)).rejects.toThrow('completion_retired')
+    expect(state.completion.complete).not.toHaveBeenCalled()
+    expect(state.completion.cancel).toHaveBeenCalledWith('generated')
+  })
+  it('keeps the ordinary generated caller free of completion hooks', async () => {
+    const state = setup()
+    const { completion: _completion, admission: _admission, ...ordinary } = state.options
+    await persistGeneratedMediaAsset(ordinary)
+    expect(state.completion.hold).not.toHaveBeenCalled()
+    expect(state.completion.complete).not.toHaveBeenCalled()
+  })
+})
