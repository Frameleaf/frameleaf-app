diff --git a/src/infrastructure/storage/workspace-fs/media-source-retention.test.ts b/src/infrastructure/storage/workspace-fs/media-source-retention.test.ts
new file mode 100644
--- /dev/null
+++ b/src/infrastructure/storage/workspace-fs/media-source-retention.test.ts
@@ -0,0 +1,17 @@
+// @vitest-environment node
+import { afterEach, expect, it } from 'vite-plus/test'
+import { asHandle, createRoot } from './__tests__/in-memory-handle'
+import { writeBlob } from './fs-primitives'
+import { setWorkspaceRoot } from './root'
+import { hasMediaSource, readMediaSource, writeMediaSource } from './media-source'
+
+afterEach(() => { setWorkspaceRoot(null) })
+it('never adopts the suppression marker as source bytes', async () => {
+  const root = asHandle(createRoot())
+  setWorkspaceRoot(root)
+  const id = 'b7c1d2e3-0000-4000-8000-000000000001'
+  await writeBlob(root, ['media', id, 'retention.json'], new Blob(['{malformed']))
+  expect(await hasMediaSource(id)).toBe(false)
+  await writeMediaSource(id, new Blob(['actual-output']), 'out.mp4', { strict: true, originRoot: root, rejectExisting: true })
+  expect(await (await readMediaSource(id))?.text()).toBe('actual-output')
+})
