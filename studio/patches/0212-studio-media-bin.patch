+import { fireEvent, render, screen } from '@testing-library/react'
+import { beforeEach, describe, expect, it } from 'vite-plus/test'
+import { useMediaLibraryStore } from '../stores/media-library-store'
+import { MediaLibrary } from './media-library'
+
+describe('media bin (FL-1822)', () => {
+  beforeEach(() => {
+    useMediaLibraryStore.setState({ currentProjectId: null })
+  })
+
+  it('cannot add anything before a project is open', () => {
+    render(<MediaLibrary />)
+
+    expect(screen.getByRole('button', { name: 'Add files' })).toBeDisabled()
+    expect(screen.getByRole('button', { name: 'More ways to add' })).toBeDisabled()
+  })
+
+  it('puts the source switch on its own row with a quiet Add files and a menu of other ways', async () => {
+    useMediaLibraryStore.setState({ currentProjectId: 'project-1' })
+    render(<MediaLibrary />)
+
+    const source = screen.getByRole('group', { name: 'Where your media comes from' })
+    expect(source).toHaveTextContent('Project')
+    expect(source).toHaveTextContent('Scenes')
+    expect(screen.getByRole('button', { name: 'Project' })).toHaveAttribute('aria-pressed', 'true')
+    expect(screen.getByRole('textbox', { name: 'Search media' })).toBeInTheDocument()
+    expect(screen.getByRole('button', { name: 'Add files' })).toBeEnabled()
+    expect(screen.getByRole('button', { name: 'Type: All types' })).toBeInTheDocument()
+    expect(screen.getByRole('button', { name: 'Sort: Date' })).toBeInTheDocument()
+    expect(screen.getByRole('button', { name: 'Show as a grid' })).toHaveAttribute('aria-pressed', 'true')
+
+    fireEvent.pointerDown(screen.getByRole('button', { name: 'More ways to add' }), { button: 0, ctrlKey: false })
+    expect(await screen.findByRole('menuitem', { name: 'Add subtitles (SRT or VTT)' })).toBeInTheDocument()
+    expect(screen.getByRole('menuitem', { name: 'Add from a web address' })).toBeInTheDocument()
+    expect(screen.queryByText('Link original files')).not.toBeInTheDocument()
+  })
+})
