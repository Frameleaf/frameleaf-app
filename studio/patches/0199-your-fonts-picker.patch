+import { act, fireEvent, render, screen, waitFor } from '@testing-library/react'
+import { afterEach, describe, expect, it, vi } from 'vite-plus/test'
+
+vi.mock('react-i18next', () => ({
+  useTranslation: () => ({
+    t: (key: string, values?: Record<string, unknown>) =>
+      values ? `${key} ${JSON.stringify(values)}` : key,
+  }),
+}))
+vi.mock('@/shared/typography/fonts', () => ({
+  FONT_CATALOG: [
+    { value: 'Inter', label: 'Inter', family: 'Inter', weights: [400, 700] },
+    { value: 'Lora', label: 'Lora', family: 'Lora', weights: [400] },
+  ],
+  ensureFontsLoaded: vi.fn(async () => undefined),
+  getGoogleFontsCatalog: async () => [
+    { value: 'Inter', label: 'Inter', family: 'Inter', weights: [400, 700] },
+    { value: 'Lora', label: 'Lora', family: 'Lora', weights: [400] },
+  ],
+}))
+
+const {
+  installProjectFontKeeper,
+  setProjectFontWriter,
+  setProjectFonts,
+  getProjectFonts,
+  PROJECT_FONT_LIMIT,
+} = await import('@/shared/typography/project-fonts')
+const { FontPicker } = await import('./font-picker')
+
+const LIGHT = '6f0d2a4e-1c3b-4d5e-8f60-718293a4b5c6'
+const BOLD = '6f0d2a4e-1c3b-4d5e-8f60-718293a4b5c7'
+const ADDED = '6f0d2a4e-1c3b-4d5e-8f60-718293a4b5c8'
+const face = (importId: string, weight: number, family = 'Brandon Grotesque') => ({
+  importId,
+  family,
+  weight,
+  style: 'normal' as const,
+})
+
+let uninstall: (() => void) | undefined
+afterEach(() => {
+  uninstall?.()
+  uninstall = undefined
+  setProjectFontWriter(undefined)
+  setProjectFonts([])
+})
+
+async function open(onValueChange = vi.fn()) {
+  render(<FontPicker value="Inter" onValueChange={onValueChange} />)
+  await act(async () => {
+    fireEvent.click(screen.getByRole('button', { expanded: false }))
+  })
+  return onValueChange
+}
+
+describe('font picker: fonts kept with the project (FL-1562)', () => {
+  it('lists the project families first with their weight count, then the catalogue', async () => {
+    setProjectFonts([face(LIGHT, 300), face(BOLD, 700), face(ADDED, 400, 'Inter')])
+    const onValueChange = await open()
+
+    expect(screen.getByText('engineControls.fonts.yourFonts')).toBeTruthy()
+    expect(screen.getByText('engineControls.fonts.weightCount {"number":2}')).toBeTruthy()
+    expect(screen.getByText('engineControls.fonts.frameleafFonts')).toBeTruthy()
+    // A kept family named like a catalogue font is listed once, among the project's.
+    expect(screen.getAllByRole('option').map((option) => option.textContent)).toEqual([
+      'Brandon GrotesqueengineControls.fonts.weightCount {"number":2}',
+      'InterengineControls.fonts.weightCount {"number":1}',
+      'Lora',
+    ])
+    // No host keeps files here, so no font can be added.
+    expect(screen.queryByText('engineControls.fonts.addFont')).toBeNull()
+
+    fireEvent.click(screen.getByRole('option', { name: /Brandon Grotesque/ }))
+    expect(onValueChange).toHaveBeenCalledWith('Brandon Grotesque')
+  })
+
+  it('keeps an added file with the project, lists its face and selects the family', async () => {
+    const keep = vi.fn(async () => face(ADDED, 700))
+    const written: unknown[] = []
+    uninstall = installProjectFontKeeper({ keep })
+    setProjectFontWriter(async (faces) => {
+      written.push(faces)
+      setProjectFonts(faces)
+    })
+    setProjectFonts([face(LIGHT, 300), face(BOLD, 700)])
+    const onValueChange = await open()
+
+    const file = new File(['font'], 'Brandon-Bold.otf')
+    await act(async () => {
+      fireEvent.change(screen.getByLabelText('engineControls.fonts.addFont'), {
+        target: { files: [file] },
+      })
+    })
+
+    await waitFor(() => expect(onValueChange).toHaveBeenCalledWith('Brandon Grotesque'))
+    expect(keep).toHaveBeenCalledWith(file)
+    // The same family, weight and style is replaced by the new file, not listed twice.
+    expect(written).toEqual([[face(LIGHT, 300), face(ADDED, 700)]])
+    expect(getProjectFonts()).toEqual([face(LIGHT, 300), face(ADDED, 700)])
+  })
+
+  it('replaces a face in a full project, refuses a file over 32 MB first, and offers Add font only where it can keep', async () => {
+    const full = Array.from({ length: 32 }, (_, index) =>
+      face(index === 0 ? LIGHT : BOLD, 400, `Family ${index}`),
+    )
+    const keep = vi.fn(async () => face(ADDED, 400, 'Family 0'))
+    const writer = vi.fn(async (faces: unknown[]) => setProjectFonts(faces))
+    let available = true
+    uninstall = installProjectFontKeeper({ keep, available: () => available })
+    setProjectFontWriter(writer)
+    setProjectFonts(full)
+    await open()
+
+    await act(async () => {
+      fireEvent.change(screen.getByLabelText('engineControls.fonts.addFont'), {
+        target: { files: [new File(['font'], 'Family-0.ttf')] },
+      })
+    })
+    await waitFor(() => expect(writer).toHaveBeenCalledTimes(1))
+    expect(getProjectFonts()).toHaveLength(32)
+    expect(getProjectFonts().at(-1)).toEqual(face(ADDED, 400, 'Family 0'))
+
+    const huge = new File(['x'], 'huge.otf')
+    Object.defineProperty(huge, 'size', { value: 32 * 1024 * 1024 + 1 })
+    fireEvent.click(screen.getByRole('button', { expanded: false }))
+    await act(async () => {
+      fireEvent.change(screen.getByLabelText('engineControls.fonts.addFont'), {
+        target: { files: [huge] },
+      })
+    })
+    expect((await screen.findByRole('alert')).textContent).toBe('engineControls.fonts.tooLarge')
+    expect(keep).toHaveBeenCalledTimes(1)
+
+    available = false
+    fireEvent.click(screen.getByRole('button', { expanded: true }))
+    fireEvent.click(screen.getByRole('button', { expanded: false }))
+    expect(screen.queryByText('engineControls.fonts.addFont')).toBeNull()
+  })
+
+  it('says so when the file is refused or the project is full, and changes nothing', async () => {
+    // The first file is refused by the server; the second is read as a new family.
+    const keep = vi
+      .fn<() => Promise<ReturnType<typeof face>>>()
+      .mockRejectedValueOnce(new Error('refused'))
+      .mockResolvedValue(face(ADDED, 400, 'New family'))
+    const writer = vi.fn(async () => undefined)
+    uninstall = installProjectFontKeeper({ keep })
+    setProjectFontWriter(writer)
+    const onValueChange = await open()
+
+    await act(async () => {
+      fireEvent.change(screen.getByLabelText('engineControls.fonts.addFont'), {
+        target: { files: [new File(['x'], 'notes.ttf')] },
+      })
+    })
+    expect((await screen.findByRole('alert')).textContent).toBe('engineControls.fonts.addFailed')
+
+    setProjectFonts(Array.from({ length: 32 }, (_, index) => face(LIGHT, 400, `Family ${index}`)))
+    await act(async () => {
+      fireEvent.change(screen.getByLabelText('engineControls.fonts.addFont'), {
+        target: { files: [new File(['x'], 'more.ttf')] },
+      })
+    })
+    await waitFor(() =>
+      expect(screen.getByRole('alert').textContent).toBe('engineControls.fonts.full'),
+    )
+    // Only the server can say whether the file replaces a listed face, so it is read first.
+    expect(keep).toHaveBeenCalledTimes(2)
+    expect(writer).not.toHaveBeenCalled()
+    expect(onValueChange).not.toHaveBeenCalled()
+    expect(PROJECT_FONT_LIMIT).toBe('project_font_limit')
+  })
+})
