diff --git a/src/shared/utils/audio-channel-map.ts b/src/shared/utils/audio-channel-map.ts
new file mode 100644
--- /dev/null
+++ b/src/shared/utils/audio-channel-map.ts
@@ -0,0 +1,97 @@
+import type { AudioChannelMap, TimelineItem } from '@/types/timeline'
+
+/**
+ * Frameleaf (FL-1561): which decoded source planes feed a clip's left and right outputs.
+ * Each side is the plain sum of its listed planes times 1 / (number listed). A plane the
+ * source does not have contributes silence; an empty side is silent. Absent means the
+ * source planes play as they are.
+ */
+const AUDIO_CHANNEL_MAP_MAX_INDEX = 31
+
+function isValidSide(side: unknown): side is number[] {
+  return (
+    Array.isArray(side) &&
+    side.length <= AUDIO_CHANNEL_MAP_MAX_INDEX + 1 &&
+    side.every(
+      (index) => Number.isInteger(index) && index >= 0 && index <= AUDIO_CHANNEL_MAP_MAX_INDEX,
+    ) &&
+    new Set(side).size === side.length
+  )
+}
+
+export function isValidAudioChannelMap(map: unknown): map is AudioChannelMap {
+  if (!map || typeof map !== 'object' || Array.isArray(map)) return false
+  const { left, right } = map as Partial<AudioChannelMap>
+  return isValidSide(left) && isValidSide(right) && left.length + right.length > 0
+}
+
+/** The clip's map, or undefined to play the source planes unchanged. Throws on a malformed map. */
+export function getAudioChannelMap(
+  item: Pick<TimelineItem, 'audioChannelMap'> | undefined,
+): AudioChannelMap | undefined {
+  const map = item?.audioChannelMap
+  if (map === undefined) return undefined
+  if (!isValidAudioChannelMap(map)) throw new Error('Invalid audio channel map')
+  return map
+}
+
+export function areAudioChannelMapsEqual(
+  left: AudioChannelMap | undefined,
+  right: AudioChannelMap | undefined,
+): boolean {
+  if (left === right) return true
+  if (!left || !right) return false
+  return (
+    left.left.length === right.left.length &&
+    left.right.length === right.right.length &&
+    left.left.every((index, i) => right.left[i] === index) &&
+    left.right.every((index, i) => right.right[i] === index)
+  )
+}
+
+/** Planes a clip contributes to the mix: two when mapped, else what the source decoded to. */
+export function getAudioChannelMapPlaneCount(
+  map: AudioChannelMap | undefined,
+  sourcePlanes: number,
+): number {
+  return map ? 2 : sourcePlanes
+}
+
+function mapSide(samples: readonly Float32Array[], side: readonly number[], length: number) {
+  const output = new Float32Array(length)
+  const present = side.filter((index) => index < samples.length)
+  if (present.length === 0) return output
+  const gain = 1 / side.length
+  for (let i = 0; i < length; i++) {
+    let sum = 0
+    for (const index of present) sum += samples[index]![i]!
+    output[i] = gain === 1 ? sum : sum * gain
+  }
+  return output
+}
+
+/** Export: left and right planes from the decoded source planes, by the documented rule. */
+export function applyAudioChannelMap(
+  samples: readonly Float32Array[],
+  map: AudioChannelMap,
+): Float32Array[] {
+  if (!isValidAudioChannelMap(map)) throw new Error('Invalid audio channel map')
+  const length = samples[0]?.length ?? 0
+  return [mapSide(samples, map.left, length), mapSide(samples, map.right, length)]
+}
+
+/** The clip's map, found on a root item or inside a compound clip's composition. */
+export function resolveItemAudioChannelMap(
+  items: readonly TimelineItem[],
+  compositions: readonly { items: TimelineItem[] }[],
+  itemId: string,
+): AudioChannelMap | undefined {
+  // ponytail: scan on store changes, like resolveTrackAudioPanStages.
+  const item =
+    items.find((candidate) => candidate.id === itemId) ??
+    compositions
+      .flatMap((composition) => composition.items)
+      .find((candidate) => candidate.id === itemId)
+  // Unvalidated: the preview graph refuses (silences) a malformed map, as export refuses it.
+  return item?.audioChannelMap
+}
