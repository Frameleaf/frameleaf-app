diff --git a/src/features/timeline/stores/audio-channel-map-persistence.test.ts b/src/features/timeline/stores/audio-channel-map-persistence.test.ts
new file mode 100644
--- /dev/null
+++ b/src/features/timeline/stores/audio-channel-map-persistence.test.ts
@@ -0,0 +1,100 @@
+import { afterEach, beforeEach, describe, expect, it } from 'vite-plus/test'
+import type { Project } from '@/types/project'
+import {
+  makeTimelineAudioItem,
+  makeTimelineTrack,
+  resetTimelineCompositionTestState,
+} from '@/features/timeline/test-helpers'
+import { validateProject } from '@/features/project-bundle/schemas/project-schema'
+import { splitItem } from './actions/edit/split-actions'
+import { joinItems } from './actions/edit/join-actions'
+import { useItemsStore } from './items-store'
+import { buildTimelineFromStores, hydrateTimelineStoresFromProject } from './timeline-persistence'
+
+// FL-1561: a clip's channel map is an ordinary item field: saved, reopened, and kept by the
+// halves of a split and by a join.
+const centre = { left: [2], right: [2] }
+const track = makeTimelineTrack({ id: 'a1', name: 'A1', kind: 'audio', order: 0 })
+
+function project(timeline: Project['timeline']): Project {
+  return {
+    id: 'channel-map',
+    name: 'Channel map',
+    description: '',
+    createdAt: 1,
+    updatedAt: 1,
+    duration: 2,
+    metadata: { width: 1920, height: 1080, fps: 30 },
+    timeline,
+  }
+}
+
+describe('FL-1561 channel map persistence', () => {
+  beforeEach(() => resetTimelineCompositionTestState())
+  afterEach(() => resetTimelineCompositionTestState())
+
+  it('survives split, join, save and reopen', async () => {
+    useItemsStore.getState().setTracks([track])
+    useItemsStore.getState().setItems([
+      makeTimelineAudioItem({
+        id: 'surround',
+        src: '',
+        trackId: track.id,
+        from: 0,
+        durationInFrames: 60,
+        sourceStart: 0,
+        sourceEnd: 60,
+        sourceFps: 30,
+        audioChannelMap: centre,
+      }),
+    ])
+
+    const halves = splitItem('surround', 30)
+    expect(halves).not.toBeNull()
+    expect(useItemsStore.getState().items.map((item) => item.audioChannelMap)).toEqual([
+      centre,
+      centre,
+    ])
+
+    const saved = structuredClone(buildTimelineFromStores())
+    expect(saved.items.map((item) => item.audioChannelMap)).toEqual([centre, centre])
+
+    resetTimelineCompositionTestState()
+    await hydrateTimelineStoresFromProject(project(saved))
+    expect(useItemsStore.getState().items.map((item) => item.audioChannelMap)).toEqual([
+      centre,
+      centre,
+    ])
+
+    joinItems(useItemsStore.getState().items.map((item) => item.id))
+    expect(useItemsStore.getState().items).toHaveLength(1)
+    expect(useItemsStore.getState().items[0]!.audioChannelMap).toEqual(centre)
+  })
+
+  it('the project schema admits a valid map and refuses a malformed one', () => {
+    const withMap = (audioChannelMap: unknown) =>
+      validateProject(
+        project({
+          tracks: [track],
+          items: [
+            makeTimelineAudioItem({
+              id: 'clip',
+              src: '',
+              trackId: track.id,
+              audioChannelMap: audioChannelMap as typeof centre,
+            }),
+          ],
+        } as unknown as Project['timeline']),
+      ).success
+    expect(withMap(centre)).toBe(true)
+    expect(withMap({ left: [0, 1], right: [] })).toBe(true)
+    for (const bad of [
+      { left: [], right: [] },
+      { left: [0, 0], right: [1] },
+      { left: [32], right: [1] },
+      { left: [0.5], right: [1] },
+      { left: [0] },
+    ])
+      expect(withMap(bad), JSON.stringify(bad)).toBe(false)
+  })
+})
