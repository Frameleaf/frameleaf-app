+    expect(mapped.right).toBeCloseTo(neutral.left / 2, 6)
+    const panned = estimateAudioMeterLevel({
+      sources: [{ ...source, channelMap: { left: [0], right: [0] }, panStages: [1] }],
+      waveformsByMediaId,
+    })
+    expect(panned.left).toBeCloseTo(0, 6)
+    expect(panned.right).toBeCloseTo(neutral.left * 2, 6)
+  })
