diff --git a/src/features/export/utils/canvas-audio-channel-map.test.ts b/src/features/export/utils/canvas-audio-channel-map.test.ts
new file mode 100644
--- /dev/null
+++ b/src/features/export/utils/canvas-audio-channel-map.test.ts
@@ -0,0 +1,235 @@
+import { beforeEach, describe, expect, it, vi } from 'vite-plus/test'
+import type { CompositionInputProps } from '@/types/export'
+import type { AudioChannelMap, AudioItem, TimelineTrack } from '@/types/timeline'
+
+// FL-1561: the real mixers at the decoded-PCM boundary, as in the FL-103 channel test. Only
+// demux/decode is replaced: plane c holds one 0.25 impulse at sample 32 + 17c, so every
+// output sample says which planes fed it and with what gain.
+const { decodedFixtures } = vi.hoisted(() => ({ decodedFixtures: new Map<string, number>() }))
+
+vi.mock('mediabunny', () => {
+  class UrlSource {
+    constructor(public readonly url: string) {}
+  }
+  class Input {
+    constructor(private readonly params: { source: UrlSource }) {}
+    async getPrimaryAudioTrack() {
+      const channels = decodedFixtures.get(this.params.source.url)
+      if (channels === undefined) throw new Error('Unknown impulse source')
+      return { src: this.params.source.url, getNumberOfChannels: async () => channels }
+    }
+    async computeDuration() {
+      return 1
+    }
+    dispose() {}
+  }
+  class AudioSampleSink {
+    constructor(private readonly track: { src: string }) {}
+    async *samples(startTime = 0, endTime = 1) {
+      const channels = decodedFixtures.get(this.track.src)!
+      const sampleRate = 48_000
+      const startSample = Math.round(startTime * sampleRate)
+      const numberOfFrames = Math.round(endTime * sampleRate) - startSample
+      if (numberOfFrames <= 0) throw new Error('Empty decoded range')
+      yield {
+        timestamp: startSample / sampleRate,
+        numberOfFrames,
+        numberOfChannels: channels,
+        sampleRate,
+        copyTo(destination: Float32Array, options: { planeIndex: number; format: string }) {
+          if (options.format !== 'f32-planar') throw new Error('Expected planar PCM decode')
+          destination.fill(0)
+          const pulse = 32 + options.planeIndex * 17 - startSample
+          if (pulse >= 0 && pulse < destination.length) destination[pulse] = 0.25
+        },
+        close() {},
+      }
+    }
+  }
+  return { ALL_FORMATS: [], Input, UrlSource, AudioSampleSink }
+})
+
+import {
+  clearAudioDecodeCache,
+  getAudioOutputChannelCount,
+  getAudioPacketPassthroughPlan,
+  processAudio,
+  processAudioWindows,
+} from './canvas-audio'
+
+const pulseAt = (plane: number) => 32 + plane * 17
+
+function composition(
+  clips: { channels: number; map?: AudioChannelMap; pan?: number }[],
+  name: string,
+): CompositionInputProps {
+  const tracks = clips.map(({ channels, map, pan }, order): TimelineTrack => {
+    const id = `${name}-${order}`
+    const src = `blob:fl1561-${id}`
+    decodedFixtures.set(src, channels)
+    const item = {
+      id,
+      type: 'audio',
+      trackId: id,
+      src,
+      label: id,
+      from: 0,
+      durationInFrames: 1,
+      sourceStart: 0,
+      sourceEnd: 1,
+      sourceDuration: 30,
+      sourceFps: 30,
+      ...(map ? { audioChannelMap: map } : {}),
+    } as AudioItem
+    return {
+      id,
+      name: id,
+      kind: 'audio',
+      order,
+      height: 80,
+      locked: false,
+      visible: true,
+      muted: false,
+      solo: false,
+      volume: 0,
+      items: [item],
+      ...(pan !== undefined ? { pan } : {}),
+    }
+  })
+  return {
+    fps: 30,
+    durationInFrames: 1,
+    width: 1920,
+    height: 1080,
+    tracks,
+    masterBusDb: 0,
+    masterBusMuted: false,
+    transitions: [],
+    keyframes: [],
+  }
+}
+
+async function mix(input: CompositionInputProps, windowed: boolean) {
+  const before = structuredClone(input)
+  const mixed = windowed
+    ? (await processAudioWindows(input).next()).value
+    : await processAudio(input)
+  expect(input).toEqual(before)
+  expect(mixed).toBeTruthy()
+  return mixed as { samples: Float32Array[]; channels: number }
+}
+
+/** The documented rule, written out independently: side = sum(listed planes present) / listed. */
+function expectedSide(side: number[], sourceChannels: number, plane: number): number {
+  return side.includes(plane) && plane < sourceChannels ? 0.25 / side.length : 0
+}
+
+const cases: { name: string; channels: number; map: AudioChannelMap }[] = [
+  { name: 'stereo as is', channels: 2, map: { left: [0], right: [1] } },
+  { name: 'mono from left', channels: 2, map: { left: [0], right: [0] } },
+  { name: 'mono from right', channels: 2, map: { left: [1], right: [1] } },
+  { name: 'mono mix', channels: 2, map: { left: [0, 1], right: [0, 1] } },
+  { name: 'mono source to both sides', channels: 1, map: { left: [0], right: [0] } },
+  { name: 'mono source, missing plane silent', channels: 1, map: { left: [0], right: [0, 1] } },
+  { name: '5.1 front L/R', channels: 6, map: { left: [0], right: [1] } },
+  { name: '5.1 centre to both', channels: 6, map: { left: [2], right: [2] } },
+  { name: '5.1 LFE to both', channels: 6, map: { left: [3], right: [3] } },
+  { name: '5.1 surround L/R', channels: 6, map: { left: [4], right: [5] } },
+  { name: '5.1 front with centre', channels: 6, map: { left: [0, 2, 4], right: [1, 2, 5] } },
+]
+
+describe('FL-1561 channel mapping through both PCM mixers', () => {
+  beforeEach(() => {
+    clearAudioDecodeCache()
+    decodedFixtures.clear()
+  })
+
+  for (const windowed of [false, true]) {
+    const mixer = windowed ? 'windowed' : 'full'
+
+    for (const { name, channels, map } of cases) {
+      it(`${mixer} mix: ${name}`, async () => {
+        const mixed = await mix(composition([{ channels, map }], `${mixer}-${name}`), windowed)
+        expect(mixed.channels).toBe(2)
+        expect(mixed.samples).toHaveLength(2)
+        for (let plane = 0; plane < 6; plane++) {
+          expect(mixed.samples[0]![pulseAt(plane)], `left from plane ${plane}`).toBeCloseTo(
+            expectedSide(map.left, channels, plane),
+            7,
+          )
+          expect(mixed.samples[1]![pulseAt(plane)], `right from plane ${plane}`).toBeCloseTo(
+            expectedSide(map.right, channels, plane),
+            7,
+          )
+        }
+      })
+    }
+
+    it(`${mixer} mix: a mapped 5.1 clip mixes with an unmapped stereo clip`, async () => {
+      const mixed = await mix(
+        composition(
+          [{ channels: 6, map: { left: [2], right: [2] } }, { channels: 2 }],
+          `${mixer}-mixed`,
+        ),
+        windowed,
+      )
+      expect(mixed.channels).toBe(2)
+      // Stereo clip: plane 0 at 32 on the left, plane 1 at 49 on the right. 5.1 centre: 66 on both.
+      expect([...[32, 49, 66].map((sample) => mixed.samples[0]![sample])]).toEqual([0.25, 0, 0.25])
+      expect([...[32, 49, 66].map((sample) => mixed.samples[1]![sample])]).toEqual([0, 0.25, 0.25])
+    })
+
+    it(`${mixer} mix: an unmapped 5.1 clip still refuses to mix with stereo`, async () => {
+      const input = composition(
+        [{ channels: 6 }, { channels: 2, map: { left: [0], right: [1] } }],
+        `${mixer}-refused`,
+      )
+      const result = windowed ? processAudioWindows(input).next() : processAudio(input)
+      await expect(result).rejects.toThrow(
+        'Mixed audio channel counts require an explicit layout mapping',
+      )
+    })
+
+    it(`${mixer} mix: track pan applies after the map, so 5.1 can be panned`, async () => {
+      const mixed = await mix(
+        composition([{ channels: 6, map: { left: [2], right: [2] }, pan: 0.5 }], `${mixer}-pan`),
+        windowed,
+      )
+      // Stereo pan law at 0.5: angle pi/4; left = l cos, right = r + l sin.
+      expect(mixed.samples[0]![pulseAt(2)]).toBeCloseTo(0.25 * Math.SQRT1_2, 7)
+      expect(mixed.samples[1]![pulseAt(2)]).toBeCloseTo(0.25 + 0.25 * Math.SQRT1_2, 7)
+    })
+
+    it(`${mixer} mix: a malformed map refuses the export`, async () => {
+      const input = composition(
+        [{ channels: 2, map: { left: [0, 0], right: [1] } }],
+        `${mixer}-bad`,
+      )
+      const result = windowed ? processAudioWindows(input).next() : processAudio(input)
+      await expect(result).rejects.toThrow('Invalid audio channel map')
+    })
+  }
+
+  it('an unmapped clip is unchanged: 5.1 keeps six planes', async () => {
+    const mixed = await mix(composition([{ channels: 6 }], 'unmapped'), false)
+    expect(mixed.channels).toBe(6)
+    for (let plane = 0; plane < 6; plane++) expect(mixed.samples[plane]![pulseAt(plane)]).toBe(0.25)
+  })
+
+  it('reports two output channels for a mapped 5.1 clip', async () => {
+    expect(await getAudioOutputChannelCount(composition([{ channels: 6 }], 'count-6'))).toBe(6)
+    expect(
+      await getAudioOutputChannelCount(
+        composition([{ channels: 6, map: { left: [0], right: [1] } }], 'count-2'),
+      ),
+    ).toBe(2)
+  })
+
+  it('a mapped clip is never packet-copied', () => {
+    const input = composition([{ channels: 2 }], 'copy')
+    input.durationInFrames = 1
+    expect(getAudioPacketPassthroughPlan(input)).not.toBeNull()
+    ;(input.tracks![0]!.items[0] as AudioItem).audioChannelMap = { left: [0], right: [1] }
+    expect(getAudioPacketPassthroughPlan(input)).toBeNull()
+  })
+})
