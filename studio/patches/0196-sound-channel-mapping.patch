+  Float32Array.of(value, -value),
+)
+const stereo = [Float32Array.of(0.5, -0.5), Float32Array.of(0.25, 0)]
+const mono = [Float32Array.of(0.75, -0.25)]
+
+const sides = (planes: Float32Array[]) => planes.map((plane) => [...plane])
+
+describe('FL-1561 audio channel map maths', () => {
+  it.each([
+    [
+      'stereo',
+      stereo,
+      { left: [0], right: [1] },
+      [
+        [0.5, -0.5],
+        [0.25, 0],
+      ],
+    ],
+    [
+      'mono from left',
+      stereo,
+      { left: [0], right: [0] },
+      [
+        [0.5, -0.5],
+        [0.5, -0.5],
+      ],
+    ],
+    [
+      'mono from right',
+      stereo,
+      { left: [1], right: [1] },
+      [
+        [0.25, 0],
+        [0.25, 0],
+      ],
+    ],
+    [
+      'mono mix (L+R)/2',
+      stereo,
+      { left: [0, 1], right: [0, 1] },
+      [
+        [0.375, -0.25],
+        [0.375, -0.25],
+      ],
+    ],
+    [
+      'dual mono (each side its own plane)',
+      stereo,
+      { left: [0], right: [1] },
+      [
+        [0.5, -0.5],
+        [0.25, 0],
+      ],
+    ],
+    [
+      '5.1 front L/R',
+      surround,
+      { left: [0], right: [1] },
+      [
+        [0.5, -0.5],
+        [0.25, -0.25],
+      ],
+    ],
+    [
+      '5.1 centre to both',
+      surround,
+      { left: [2], right: [2] },
+      [
+        [0.125, -0.125],
+        [0.125, -0.125],
+      ],
+    ],
+    [
+      '5.1 LFE to both',
+      surround,
+      { left: [3], right: [3] },
+      [
+        [0.0625, -0.0625],
+        [0.0625, -0.0625],
+      ],
+    ],
+    [
+      '5.1 surround L/R',
+      surround,
+      { left: [4], right: [5] },
+      [
+        [0.03125, -0.03125],
+        [0.015625, -0.015625],
+      ],
+    ],
+    // (0.5 + 0.125) / 2 and (0.25 + 0.125) / 2
+    [
+      '5.1 front plus centre',
+      surround,
+      { left: [0, 2], right: [1, 2] },
+      [
+        [0.3125, -0.3125],
+        [0.1875, -0.1875],
+      ],
+    ],
+    [
+      'left only, right silent',
+      stereo,
+      { left: [0], right: [] },
+      [
+        [0.5, -0.5],
+        [0, 0],
+      ],
+    ],
+  ])('%s', (_name, source, map, expected) => {
+    const before = sides(source)
+    expect(sides(applyAudioChannelMap(source, map))).toEqual(expected)
+    expect(sides(source)).toEqual(before)
+  })
+
+  it('counts a plane the source lacks as silence but keeps its share of the gain', () => {
+    // Mono source asked for planes 0 and 1: (0.75 + nothing) / 2.
+    expect(sides(applyAudioChannelMap(mono, { left: [0], right: [0, 1] }))).toEqual([
+      [0.75, -0.25],
+      [0.375, -0.125],
+    ])
+    expect(sides(applyAudioChannelMap(stereo, { left: [2], right: [5] }))).toEqual([
+      [0, 0],
+      [0, 0],
+    ])
+  })
+
+  it('divides three planes by three', () => {
+    const [left] = applyAudioChannelMap(surround, { left: [0, 1, 2], right: [0] })
+    expect(left![0]).toBeCloseTo((0.5 + 0.25 + 0.125) / 3, 7)
