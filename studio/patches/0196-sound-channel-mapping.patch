+    ).toThrow('Invalid audio channel map')
+    expect(getAudioChannelMap({})).toBeUndefined()
+  })
+
+  it('a mapped clip contributes two planes; an unmapped one its decoded count', () => {
+    expect(getAudioChannelMapPlaneCount({ left: [2], right: [2] }, 6)).toBe(2)
+    expect(getAudioChannelMapPlaneCount(undefined, 6)).toBe(6)
+  })
+
+  it('compares maps by order and content', () => {
+    expect(areAudioChannelMapsEqual(undefined, undefined)).toBe(true)
+    expect(areAudioChannelMapsEqual({ left: [0], right: [1] }, { left: [0], right: [1] })).toBe(
+      true,
+    )
+    expect(areAudioChannelMapsEqual({ left: [0], right: [1] }, undefined)).toBe(false)
+    expect(
+      areAudioChannelMapsEqual({ left: [0, 1], right: [1] }, { left: [1, 0], right: [1] }),
+    ).toBe(false)
+  })
