+      null,
+      [],
+      { left: [0] },
+      { left: [], right: [] },
+      { left: [0, 0], right: [1] },
+      { left: [-1], right: [1] },
+      { left: [32], right: [1] },
+      { left: [0.5], right: [1] },
+      { left: ['0'], right: [1] },
+    ])
+      expect(isValidAudioChannelMap(bad), JSON.stringify(bad)).toBe(false)
+    expect(() => applyAudioChannelMap(stereo, { left: [0, 0], right: [1] })).toThrow(
+      'Invalid audio channel map',
+    )
+    expect(() =>
+      getAudioChannelMap({ audioChannelMap: { left: [], right: [] } } as Pick<
+        TimelineItem,
+        'audioChannelMap'
