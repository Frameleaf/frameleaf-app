index 0000000..54ff447
--- /dev/null
+++ b/src/features/media-library/library-panel-registry.ts
@@ -0,0 +1,49 @@
+/**
+ * Frameleaf: a host-provided Library view in the media bin (FL-636).
+ *
+ * The bin's Media / Scenes toggle gains a third view when the host registers one. The panel itself
+ * (search, filters and result tiles) belongs to the host's adapter, which can reach the person's
+ * whole library; the bin only gives it room and a toggle. With nothing registered the bin is
+ * unchanged.
+ */
+import { useSyncExternalStore, type ComponentType } from 'react'
+
+export interface LibraryPanelRegistration {
+  /** The toggle's label, already translated by the host. */
+  label: string
+  /** Fills the bin's content area while the Library view is shown. */
+  Panel: ComponentType<{ className?: string }>
+}
+
+let current: LibraryPanelRegistration | null = null
+const listeners = new Set<() => void>()
+
+const publish = () => {
+  for (const listener of listeners) listener()
+}
+
+/** Offer the Library view; the returned function withdraws this registration only. */
+export function registerLibraryPanel(registration: LibraryPanelRegistration): () => void {
+  current = registration
+  publish()
+  return () => {
+    if (current !== registration) return
+    current = null
+    publish()
+  }
+}
+
+export function getLibraryPanel(): LibraryPanelRegistration | null {
+  return current
+}
+
+const subscribe = (listener: () => void) => {
+  listeners.add(listener)
+  return () => {
+    listeners.delete(listener)
+  }
+}
+
+export function useLibraryPanel(): LibraryPanelRegistration | null {
+  return useSyncExternalStore(subscribe, getLibraryPanel, getLibraryPanel)
+}
