diff --git a/src/features/editor/components/timeline-layout-storage.ts b/src/features/editor/components/timeline-layout-storage.ts
new file mode 100644
--- /dev/null
+++ b/src/features/editor/components/timeline-layout-storage.ts
@@ -0,0 +1,73 @@
+import type { EditorLayout } from '@/config/editor-layout';
+
+// v3 keyed layouts by sorted panel constraints; v4 uses stable panel identities.
+// Keep the old preference intact and translate only the matching editor preset.
+export function timelineLayoutStorage(layout: EditorLayout) {
+  const legacyKey = [
+    {
+      defaultSize: 100 - layout.timelineDefaultSize,
+      maxSize: 100 - layout.timelineMinSize,
+      minSize: 100 - layout.timelineMaxSize,
+    },
+    {
+      defaultSize: layout.timelineDefaultSize,
+      maxSize: layout.timelineMaxSize,
+      minSize: layout.timelineMinSize,
+    },
+  ]
+    .map((constraints) => JSON.stringify(constraints))
+    .sort()
+    .join(',');
+  return {
+    getItem(key: string): string | null {
+      try {
+        const current = window.localStorage.getItem(key);
+        if (current !== null) {
+          const saved: unknown = JSON.parse(current);
+          if (typeof saved === 'object' && saved !== null) {
+            const sizes = Object.values(saved);
+            if (
+              'editor-preview' in saved &&
+              'editor-timeline' in saved &&
+              sizes.length === 2 &&
+              sizes.every(
+                (size) =>
+                  typeof size === 'number' && Number.isFinite(size) && size >= 0 && size <= 100,
+              ) &&
+              Math.abs(sizes[0] + sizes[1] - 100) <= 0.01
+            )
+              return current;
+          }
+        }
+        if (key !== 'react-resizable-panels:editor:timeline-layout:editor-preview:editor-timeline')
+          return null;
+        const legacy = window.localStorage.getItem('react-resizable-panels:editor:timeline-layout');
+        if (legacy === null) return null;
+        const value: unknown = JSON.parse(legacy);
+        if (typeof value !== 'object' || value === null || !(legacyKey in value)) return null;
+        const entry: unknown = (value as Record<string, unknown>)[legacyKey];
+        if (typeof entry !== 'object' || entry === null || !('layout' in entry)) return null;
+        const sizes: unknown = entry.layout;
+        if (
+          !Array.isArray(sizes) ||
+          sizes.length !== 2 ||
+          !sizes.every(
+            (size) => typeof size === 'number' && Number.isFinite(size) && size >= 0 && size <= 100,
+          ) ||
+          Math.abs(sizes[0] + sizes[1] - 100) > 0.01
+        )
+          return null;
+        return JSON.stringify({ 'editor-preview': sizes[0], 'editor-timeline': sizes[1] });
+      } catch {
+        return null;
+      }
+    },
+    setItem(key: string, value: string): void {
+      try {
+        window.localStorage.setItem(key, value);
+      } catch {
+        /* Preferences remain optional when storage is unavailable. */
+      }
+    },
+  };
+}
diff --git a/src/features/editor/components/timeline-layout-storage.test.ts b/src/features/editor/components/timeline-layout-storage.test.ts
new file mode 100644
--- /dev/null
+++ b/src/features/editor/components/timeline-layout-storage.test.ts
@@ -0,0 +1,42 @@
+import { beforeEach, describe, expect, it } from 'vite-plus/test';
+import { getEditorLayout } from '@/config/editor-layout';
+import { timelineLayoutStorage } from './timeline-layout-storage';
+
+const modernKey = 'react-resizable-panels:editor:timeline-layout:editor-preview:editor-timeline';
+const legacyKey = 'react-resizable-panels:editor:timeline-layout';
+const constraints =
+  '{"defaultSize":28,"maxSize":80,"minSize":14},{"defaultSize":72,"maxSize":86,"minSize":20}';
+
+describe('timeline layout preference migration', () => {
+  beforeEach(() => window.localStorage.clear());
+  it('restores the matching v3 percentage layout without deleting old preferences', () => {
+    const old = JSON.stringify({ [constraints]: { expandToSizes: {}, layout: [61, 39] } });
+    window.localStorage.setItem(legacyKey, old);
+    const storage = timelineLayoutStorage(getEditorLayout('compact'));
+    expect(JSON.parse(storage.getItem(modernKey)!)).toEqual({
+      'editor-preview': 61,
+      'editor-timeline': 39,
+    });
+    expect(window.localStorage.getItem(legacyKey)).toBe(old);
+    storage.setItem(modernKey, JSON.stringify({ 'editor-preview': 58, 'editor-timeline': 42 }));
+    expect(JSON.parse(storage.getItem(modernKey)!)).toEqual({
+      'editor-preview': 58,
+      'editor-timeline': 42,
+    });
+  });
+  it.each(['invalid', '{}', '{"editor-preview":60,"editor-timeline":60}'])(
+    'ignores a malformed current preference: %s',
+    (value) => {
+      window.localStorage.setItem(modernKey, value);
+      expect(timelineLayoutStorage(getEditorLayout('compact')).getItem(modernKey)).toBeNull();
+    },
+  );
+  it.each([
+    'invalid',
+    JSON.stringify({ other: { layout: [60, 40] } }),
+    JSON.stringify({ [constraints]: { layout: [60, 60] } }),
+  ])('ignores malformed or different preset preferences: %s', (value) => {
+    window.localStorage.setItem(legacyKey, value);
+    expect(timelineLayoutStorage(getEditorLayout('compact')).getItem(modernKey)).toBeNull();
+  });
+});
