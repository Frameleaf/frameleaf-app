diff --git a/src/features/editor/components/properties-sidebar/transition-panel/sound-controls.tsx b/src/features/editor/components/properties-sidebar/transition-panel/sound-controls.tsx
new file mode 100644
index 0000000..1033b4c
--- /dev/null
+++ b/src/features/editor/components/properties-sidebar/transition-panel/sound-controls.tsx
@@ -0,0 +1,120 @@
+/**
+ * Frameleaf (FL-1555): the sound curve of a transition and a picture of where the transition sits
+ * around the cut. Both are views of fields the transition already stores (`audioCurve`, `alignment`).
+ */
+import { useTranslation } from 'react-i18next'
+import { cn } from '@/shared/ui/cn'
+import {
+  AUDIO_CROSSFADE_CURVES,
+  getAudioCrossfadeGain,
+  normalizeAudioCrossfadeCurve,
+  type AudioCrossfadeCurve,
+} from '@/shared/utils/audio-fade-curve'
+
+const CURVE_KEYS = {
+  'constant-power': 'power',
+  'constant-gain': 'gain',
+  exponential: 'exponential',
+} as const satisfies Record<AudioCrossfadeCurve, string>
+
+const GRAPH_WIDTH = 268
+const GRAPH_HEIGHT = 44
+const GRAPH_STEPS = 24
+
+/** The gain of the clip before (`out`) or after (`in`) through the transition, as an SVG path. */
+export function soundCurvePath(curve: AudioCrossfadeCurve, direction: 'in' | 'out'): string {
+  return Array.from({ length: GRAPH_STEPS + 1 }, (_, index) => {
+    const progress = index / GRAPH_STEPS
+    const gain = getAudioCrossfadeGain(progress, direction, curve)
+    const x = (progress * GRAPH_WIDTH).toFixed(1)
+    const y = (GRAPH_HEIGHT - 4 - gain * (GRAPH_HEIGHT - 8)).toFixed(1)
+    return `${index ? 'L' : 'M'}${x} ${y}`
+  }).join(' ')
+}
+
+export function TransitionSoundControls({
+  curve: storedCurve,
+  onChange,
+}: {
+  curve: AudioCrossfadeCurve | undefined
+  onChange: (curve: AudioCrossfadeCurve) => void
+}) {
+  const { t } = useTranslation()
+  const curve = normalizeAudioCrossfadeCurve(storedCurve)
+  const label = t('engineControls.transition.sound')
+  return (
+    <div className="space-y-1.5 px-2 pt-2">
+      <span className="text-xs text-muted-foreground">{label}</span>
+      <div
+        role="radiogroup"
+        aria-label={label}
+        className="flex items-center gap-0.5 rounded-md bg-secondary p-0.5"
+      >
+        {AUDIO_CROSSFADE_CURVES.map((option) => (
+          <button
+            key={option}
+            type="button"
+            role="radio"
+            aria-checked={curve === option}
+            onClick={() => onChange(option)}
+            className={cn(
+              'inline-flex h-7 flex-1 items-center justify-center rounded px-2 text-xs transition-colors',
+              curve === option
+                ? 'bg-background text-foreground shadow-sm'
+                : 'text-muted-foreground hover:text-foreground',
+            )}
+          >
+            {t(`engineControls.transition.curve.${CURVE_KEYS[option]}`)}
+          </button>
+        ))}
+      </div>
+      <svg
+        viewBox={`0 0 ${GRAPH_WIDTH} ${GRAPH_HEIGHT}`}
+        role="img"
+        aria-label={t('engineControls.transition.curveGraph')}
+        className="w-full rounded-md bg-muted/30"
+        fill="none"
+        strokeWidth={1.5}
+      >
+        <path d={soundCurvePath(curve, 'out')} className="stroke-muted-foreground" />
+        <path d={soundCurvePath(curve, 'in')} className="stroke-primary" />
+      </svg>
+      <p className="text-[11px] leading-snug text-muted-foreground">
+        {t(`engineControls.transition.curveNote.${CURVE_KEYS[curve]}`)}
+      </p>
+    </div>
+  )
+}
+
+/**
+ * Where a transition sits around the cut: alignment 0 starts at the cut, 0.5 is centred on it and
+ * 1 ends at it. The transition is drawn at a fixed width; the picture shows placement, not length.
+ */
+export function TransitionAlignmentDiagram({
+  alignment,
+  note,
+}: {
+  alignment: number
+  note: string
+}) {
+  const cut = GRAPH_WIDTH / 2
+  const width = 72
+  const from = cut - Math.min(1, Math.max(0, alignment)) * width
+  return (
+    <div className="space-y-1.5 px-2 pt-1">
+      <svg
+        viewBox={`0 0 ${GRAPH_WIDTH} 40`}
+        role="img"
+        aria-label={note}
+        className="w-full"
+        data-transition-from={from}
+      >
+        <rect x={0} y={12} width={cut - 1} height={18} rx={4} className="fill-muted" />
+        <rect x={cut + 1} y={12} width={cut - 1} height={18} rx={4} className="fill-muted" />
+        <rect x={from} y={6} width={width} height={30} rx={5} className="fill-primary/40" />
+        <line x1={cut} x2={cut} y1={2} y2={38} className="stroke-foreground" strokeWidth={1.5} />
+      </svg>
+      <p className="text-[11px] leading-snug text-muted-foreground">{note}</p>
+    </div>
+  )
+}
