+import type { TimelineItem, TimelineTrack } from '@/types/timeline'
+import { getLinkedItemIds, getUniqueLinkedItemAnchorIds } from '../../utils/linked-items'
+import { useItemsStore } from '../items-store'
+import { applySplitBookkeeping, type SplitResultEntry } from './split-bookkeeping'
+
+/** Validate the whole original group, including fully covered members, before any cut/removal. */
+export function canPartitionSourceEdit(
+  items: TimelineItem[],
+  tracks: TimelineTrack[],
+  targets: ReadonlySet<string>,
+  start: number,
+  end?: number,
+): boolean {
+  const affected = items.filter(
+    (item) =>
+      targets.has(item.trackId) &&
+      (end === undefined
+        ? item.from + item.durationInFrames > start
+        : item.from < end && item.from + item.durationInFrames > start),
+  )
+  return affected.every((anchor) =>
+    getLinkedItemIds(items, anchor.id).every((id) => {
+      const item = items.find((candidate) => candidate.id === id)!
+      return (
+        targets.has(item.trackId) &&
+        tracks.some((track) => track.id === item.trackId && !track.locked) &&
+        item.from === anchor.from &&
+        item.durationInFrames === anchor.durationInFrames
+      )
+    }),
+  )
+}
+
+/** Call only after validating both boundaries. Each original group gets its own bookkeeping. */
+export function partitionSourceEditAt(targets: ReadonlySet<string>, frame: number): string[] {
+  const store = useItemsStore.getState()
+  const crossing = store.items.filter(
+    (item) =>
+      targets.has(item.trackId) && item.from < frame && item.from + item.durationInFrames > frame,
+  )
+  const anchors = getUniqueLinkedItemAnchorIds(
+    store.items,
+    crossing.map((item) => item.id),
+  )
+  const affected: string[] = []
+  for (const anchor of anchors) {
+    const current = useItemsStore.getState().items
+    const results: SplitResultEntry[] = []
+    for (const id of getLinkedItemIds(current, anchor)) {
+      const original = current.find((item) => item.id === id)!
+      const result = store._splitItem(id, frame)
+      if (!result) throw new Error('Validated source edit could not be partitioned')
+      results.push({ originalId: id, originalLinkedGroupId: original.linkedGroupId, result })
+      affected.push(result.leftItem.id, result.rightItem.id)
+    }
+    applySplitBookkeeping(results)
+  }
+  return affected
+}
