 import { z } from 'zod'
 import { TEXT_STYLE_PRESET_IDS } from '@/shared/typography/text-style-preset-ids'
+import { cadenceFromFps } from '@/shared/utils/audio-clock-cadence'
 import { SNAPSHOT_VERSION } from '../types/snapshot'
 
+// Frameleaf (FL-1560): a project or sequence rate is a whole number or one of the broadcast x/1001
+// rates, 47.952 (48000/1001) included, as the graph protocol reads `fps` (3.2).
+const hasExactCadence = (fps: number): boolean => {
+  try {
+    cadenceFromFps(fps)
+    return true
+  } catch {
+    return false
+  }
+}
+const frameRateSchema = z
+  .number()
+  .min(1)
+  .max(240)
+  .refine(hasExactCadence, { message: 'The frame rate has no exact reading' })
+const exactRationalSchema = z.object({
+  num: z.number().int().min(0).max(Number.MAX_SAFE_INTEGER),
+  den: z.number().int().min(1).max(Number.MAX_SAFE_INTEGER),
+})
+// Frameleaf (FL-1560): the start timecode, graph protocol 3.6. Fields beyond these are kept.
+const projectTimecodeSchema = z
+  .object({
+    start: exactRationalSchema,
+    dropFrame: z.boolean(),
+  })
+  .passthrough()
+
