diff --git a/src/features/project-bundle/schemas/project-schema-timecode.test.ts b/src/features/project-bundle/schemas/project-schema-timecode.test.ts
new file mode 100644
index 0000000..09fb714
--- /dev/null
+++ b/src/features/project-bundle/schemas/project-schema-timecode.test.ts
@@ -0,0 +1,59 @@
+// @vitest-environment node
+
+import { describe, expect, it } from 'vite-plus/test'
+import { generateFixture } from '../services/test-fixtures'
+import { validateSnapshotData } from '../services/json-import-service'
+import { validateProject } from './project-schema'
+
+/** Frameleaf (FL-1560): the start timecode and exact rates survive bundle and snapshot validation. */
+describe('project metadata timecode (FL-1560)', () => {
+  const project = (metadata: Record<string, unknown>) => {
+    const { project } = generateFixture('single-image')
+    return { ...structuredClone(project), metadata: { ...project.metadata, ...metadata } }
+  }
+  const timecode = { start: { num: 8_999_991, den: 2500 }, dropFrame: true }
+
+  it('keeps the start timecode, the exact rate, managed colour and fields it does not know', () => {
+    const input = project({
+      fps: 30_000 / 1001,
+      frameRate: { num: 30_000, den: 1001 },
+      timecode: { ...timecode, future: 'kept' },
+      colorManagement: { workingRange: 'hdr' },
+      somethingNew: 1,
+    })
+    const result = validateProject(input)
+    expect(result.success).toBe(true)
+    expect(result.data?.metadata).toEqual(input.metadata)
+  })
+
+  it('accepts every whole and broadcast x/1001 rate, 47.952 included', () => {
+    for (const fps of [24, 25, 48, 23.976, 29.97, 47.952, 48_000 / 1001, 59.94, 119.88]) {
+      expect(validateProject(project({ fps })).success, String(fps)).toBe(true)
+    }
+    for (const fps of [27.3, 0, 241, 29.969]) {
+      expect(validateProject(project({ fps })).success, String(fps)).toBe(false)
+    }
+  })
+
+  it('refuses a malformed start timecode', () => {
+    for (const bad of [
+      { start: { num: -1, den: 1 }, dropFrame: false },
+      { start: { num: 1, den: 0 }, dropFrame: false },
+      { start: { num: 0.5, den: 1 }, dropFrame: false },
+      { start: { num: 0, den: 1 }, dropFrame: 'yes' },
+      { start: { num: 0, den: 1 } },
+      '01:00:00:00',
+    ]) {
+      expect(validateProject(project({ timecode: bad })).success, JSON.stringify(bad)).toBe(false)
+    }
+  })
+
+  it('accepts a 47.952 snapshot with a start timecode for import', async () => {
+    const { snapshot } = generateFixture('single-image')
+    const input = structuredClone(snapshot)
+    input.project.metadata = { ...input.project.metadata, fps: 48_000 / 1001, timecode }
+    const result = await validateSnapshotData(input)
+    expect(result.errors).toEqual([])
+    expect(result.valid).toBe(true)
+  })
+})
