+// Frameleaf (FL-1560): the metadata object is open (graph protocol 2.2): the exact rate, managed
+// colour, the start timecode and fields this schema does not know survive validation.
+const projectResolutionSchema = z
+  .object({
+    width: z.number().int().min(320).max(7680),
+    height: z.number().int().min(240).max(4320),
+    fps: frameRateSchema,
+    frameRate: exactRationalSchema
+      .extend({ num: z.number().int().min(1).max(Number.MAX_SAFE_INTEGER) })
+      .optional(),
+    backgroundColor: z
+      .string()
+      .regex(/^#[0-9A-Fa-f]{6}$/)
+      .optional(),
+    timecode: projectTimecodeSchema.optional(),
