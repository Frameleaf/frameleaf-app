+import { FULLSCREEN_QUAD_WGSL } from '@/infrastructure/gpu-shared/fullscreen-quad'
+import { MANAGED_COLOR_WGSL } from '@/infrastructure/gpu-color/managed-color-wgsl'
+
+export interface HdrRasterInput {
+  width: number
+  height: number
+  transfer: 'pq' | 'hlg'
+  rgb: Uint16Array
+}
+
+export function validateHdrRaster(
+  input: HdrRasterInput | undefined,
+): asserts input is HdrRasterInput {
+  if (
+    !input ||
+    !Number.isSafeInteger(input.width) ||
+    !Number.isSafeInteger(input.height) ||
+    input.width <= 0 ||
+    input.height <= 0 ||
+    input.width * input.height > 16_777_216 ||
+    !['pq', 'hlg'].includes(input.transfer) ||
+    !(input.rgb instanceof Uint16Array) ||
+    input.rgb.length !== input.width * input.height * 3
+  )
+    throw new Error('Invalid HDR raster input')
+}
+
+/** Per-renderer owned textures; integer source codes never pass through a canvas. */
+export class HdrRasterSources {
+  private disposed = false
+  private readonly textures = new Map<string, { texture: GPUTexture; referenceWhite: number }>()
+  private readonly inputs: Readonly<Record<string, HdrRasterInput>>
+  constructor(
+    inputs: Readonly<Record<string, HdrRasterInput>>,
+    private readonly getDevice: () => GPUDevice | null | undefined,
+  ) {
+    let pixels = 0
+    this.inputs = Object.fromEntries(
+      Object.entries(inputs).map(([id, input]) => {
+        validateHdrRaster(input)
+        pixels += input.width * input.height
+        if (!id || pixels > 16_777_216) throw new Error('HDR raster resource limit')
+        return [id, { ...input, rgb: input.rgb.slice() }]
+      }),
+    )
+  }
+
+  has(mediaId: string | undefined): boolean {
+    return !!mediaId && Object.hasOwn(this.inputs, mediaId)
+  }
+
+  frameTexture(mediaId: string, referenceWhite: number) {
+    if (this.disposed) throw new Error('HDR raster disposed')
+    const input = this.inputs[mediaId]
+    validateHdrRaster(input)
+    const device = this.getDevice()
+    if (!device) throw new Error('HDR raster requires WebGPU')
+    if (
+      input.width > device.limits.maxTextureDimension2D ||
+      input.height > device.limits.maxTextureDimension2D
+    ) {
+      throw new Error('HDR raster exceeds device texture limits')
+    }
+    if (!(referenceWhite > 0 && Number.isFinite(referenceWhite)))
+      throw new Error('Invalid reference white')
+    const cached = this.textures.get(mediaId)
+    if (cached && cached.referenceWhite !== referenceWhite) {
+      cached.texture.destroy()
+      this.textures.delete(mediaId)
+    }
+    let output = cached?.referenceWhite === referenceWhite ? cached.texture : undefined
+    if (!output) {
+      let source: GPUTexture | undefined
+      let uniform: GPUBuffer | undefined
+      let candidate: GPUTexture | undefined
+      try {
+        source = device.createTexture({
+          size: [input.width, input.height],
+          format: 'rgba16uint',
+          usage: GPUTextureUsage.TEXTURE_BINDING | GPUTextureUsage.COPY_DST,
+        })
+        const stride = Math.ceil((input.width * 8) / 256) * 256
+        const pixels = new Uint16Array((stride / 2) * input.height)
+        for (let y = 0; y < input.height; y++)
+          for (let x = 0; x < input.width; x++) {
+            const at = (y * stride) / 2 + x * 4
+            pixels.set(
+              input.rgb.subarray((y * input.width + x) * 3, (y * input.width + x) * 3 + 3),
+              at,
+            )
+            pixels[at + 3] = 65535
+          }
+        device.queue.writeTexture({ texture: source }, pixels, { bytesPerRow: stride }, [
+          input.width,
+          input.height,
+        ])
+        pixels.fill(0)
+        const module = device.createShaderModule({
+          code: `${FULLSCREEN_QUAD_WGSL}\n${MANAGED_COLOR_WGSL}\n
+          @group(0) @binding(0) var source: texture_2d<u32>;
+          @group(0) @binding(1) var<uniform> params: vec4f;
+          @fragment fn fragmentMain(v: VertexOutput) -> @location(0) vec4f {
+            let size = textureDimensions(source);
+            let p = min(vec2u(v.uv * vec2f(size)), size - vec2u(1));
+            let signal = vec3f(textureLoad(source, vec2i(p), 0).rgb) / 65535.0;
+            return vec4f(fl_signal_to_working(signal, params.x, params.y), 1.0);
+          }`,
+        })
+        const pipeline = device.createRenderPipeline({
+          layout: 'auto',
+          vertex: { module, entryPoint: 'vertexMain' },
+          fragment: { module, entryPoint: 'fragmentMain', targets: [{ format: 'rgba16float' }] },
+          primitive: { topology: 'triangle-list' },
+        })
+        uniform = device.createBuffer({
+          size: 16,
+          usage: GPUBufferUsage.UNIFORM | GPUBufferUsage.COPY_DST,
+        })
+        device.queue.writeBuffer(
+          uniform,
+          0,
+          new Float32Array([input.transfer === 'pq' ? 0 : 1, referenceWhite, 0, 0]),
+        )
+        candidate = device.createTexture({
+          size: [input.width, input.height],
+          format: 'rgba16float',
+          usage: GPUTextureUsage.TEXTURE_BINDING | GPUTextureUsage.RENDER_ATTACHMENT,
+        })
+        const encoder = device.createCommandEncoder()
+        const pass = encoder.beginRenderPass({
+          colorAttachments: [
+            {
+              view: candidate.createView(),
+              loadOp: 'clear',
+              storeOp: 'store',
+              clearValue: [0, 0, 0, 0],
+            },
+          ],
+        })
+        pass.setPipeline(pipeline)
+        pass.setBindGroup(
+          0,
+          device.createBindGroup({
+            layout: pipeline.getBindGroupLayout(0),
+            entries: [
+              { binding: 0, resource: source.createView() },
+              { binding: 1, resource: { buffer: uniform } },
+            ],
+          }),
+        )
+        pass.draw(6)
+        pass.end()
+        device.queue.submit([encoder.finish()])
+        output = candidate
+        this.textures.set(mediaId, { texture: output, referenceWhite })
+      } catch (error) {
+        candidate?.destroy()
+        throw error
+      } finally {
+        source?.destroy()
+        uniform?.destroy()
+      }
+    }
+    return { texture: output, width: input.width, height: input.height }
+  }
+
+  dispose(): void {
+    this.disposed = true
+    for (const { texture } of this.textures.values()) texture.destroy()
+    this.textures.clear()
+    for (const input of Object.values(this.inputs)) input.rgb.fill(0)
+  }
+}
