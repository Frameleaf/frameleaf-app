+import { fireEvent, render, screen } from '@testing-library/react'
+import { beforeEach, describe, expect, it, vi } from 'vite-plus/test'
+import { useEditorStore } from '@/shared/state/editor'
+
+vi.mock('@/features/editor/deps/media-library', async (importOriginal) => ({
+  ...(await importOriginal<typeof import('@/features/editor/deps/media-library')>()),
+  MediaLibrary: () => <div data-testid="media-library" />,
+}))
+vi.mock('./transitions-panel', () => ({ TransitionsPanel: () => <div data-testid="transitions" /> }))
+
+const { MediaSidebar } = await import('./media-sidebar')
+
+describe('Add panel (FL-1822)', () => {
+  beforeEach(() => {
+    useEditorStore.setState({ activeTab: 'media', leftSidebarOpen: true })
+  })
+
+  it('keeps the rail to Media, Add, Transcript and AI', () => {
+    render(<MediaSidebar />)
+    for (const name of ['Media', 'Add', 'Transcript', 'AI']) {
+      expect(screen.getByRole('button', { name })).toBeInTheDocument()
+    }
+    expect(screen.queryByRole('button', { name: 'Shapes' })).not.toBeInTheDocument()
+  })
+
+  it('opens Add on titles and switches category with the chips', () => {
+    render(<MediaSidebar />)
+    fireEvent.click(screen.getByRole('button', { name: 'Add' }))
+
+    expect(screen.getByRole('button', { name: 'Add' })).toHaveAttribute('aria-pressed', 'true')
+    const chips = screen.getByRole('tablist', { name: 'What to add' })
+    expect([...chips.querySelectorAll('[role="tab"]')].map((tab) => tab.textContent)).toEqual([
+      'Titles',
+      'Shapes',
+      'Effects',
+      'Transitions',
+      'Animations',
+    ])
+    expect(screen.getByRole('tab', { name: 'Titles' })).toHaveAttribute('aria-selected', 'true')
+    expect(screen.getByText('Drag a title onto the timeline, or click to add it at the playhead.')).toBeInTheDocument()
+
+    fireEvent.click(screen.getByRole('tab', { name: 'Transitions' }))
+    expect(useEditorStore.getState().activeTab).toBe('transitions')
+    expect(screen.getByRole('tab', { name: 'Transitions' })).toHaveAttribute('aria-selected', 'true')
+    expect(screen.getByRole('button', { name: 'Add' })).toHaveAttribute('aria-pressed', 'true')
+  })
+})
