diff --git a/src/shared/utils/loudness-worker.ts b/src/shared/utils/loudness-worker.ts
new file mode 100644
--- /dev/null
+++ b/src/shared/utils/loudness-worker.ts
@@ -0,0 +1,28 @@
+/// <reference lib="webworker" />
+
+import { measureLoudness, type LoudnessMeasurement } from './loudness'
+
+interface LoudnessRequest {
+  id: string
+  sampleRate: number
+  channels: ArrayBuffer[]
+}
+
+interface LoudnessResponse {
+  id: string
+  error?: string
+  measurement?: LoudnessMeasurement
+}
+
+self.addEventListener('message', (event: MessageEvent<LoudnessRequest>) => {
+  const { id, sampleRate, channels } = event.data
+  let response: LoudnessResponse
+  try {
+    response = { id, measurement: measureLoudness({ sampleRate, channels: channels.map((c) => new Float32Array(c)) }) }
+  } catch (error) {
+    response = { id, error: error instanceof Error ? error.message : String(error) }
+  }
+  self.postMessage(response)
+})
+
+export {}
diff --git a/src/shared/utils/loudness.test.ts b/src/shared/utils/loudness.test.ts
new file mode 100644
--- /dev/null
+++ b/src/shared/utils/loudness.test.ts
@@ -0,0 +1,63 @@
+import { describe, expect, it } from 'vite-plus/test'
+import { channelWeights, measureLoudness } from './loudness'
+
+function sine(frequency: number, amplitudeDbfs: number, seconds: number, sampleRate = 48000, phase = 0) {
+  const amplitude = 10 ** (amplitudeDbfs / 20)
+  const samples = new Float32Array(Math.round(seconds * sampleRate))
+  for (let i = 0; i < samples.length; i += 1) {
+    samples[i] = amplitude * Math.sin((2 * Math.PI * frequency * i) / sampleRate + phase)
+  }
+  return samples
+}
+
+describe('channelWeights', () => {
+  it('follows the Web Audio speaker layouts, with no LFE', () => {
+    expect(channelWeights(1)).toEqual([1])
+    expect(channelWeights(2)).toEqual([1, 1])
+    expect(channelWeights(4)).toEqual([1, 1, 1.41, 1.41])
+    expect(channelWeights(5)).toEqual([1, 1, 1, 1.41, 1.41])
+    expect(channelWeights(6)).toEqual([1, 1, 1, 0, 1.41, 1.41])
+  })
+})
+
+describe('measureLoudness', () => {
+  // EBU Tech 3341 case 1: stereo 1 kHz sine at -23 dBFS reads -23.0 LUFS (±0.1 LU).
+  it.each([44100, 48000, 96000])('reads the EBU 3341 reference at %s Hz', (sampleRate) => {
+    const channel = sine(1000, -23, 20, sampleRate)
+    const result = measureLoudness({ sampleRate, channels: [channel, channel] })
+    expect(Math.abs(result.integratedLufs! + 23)).toBeLessThanOrEqual(0.1)
+  })
+
+  it('tracks gain changes dB for dB', () => {
+    const quiet = sine(1000, -33, 10)
+    const loud = sine(1000, -13, 10)
+    const quietLufs = measureLoudness({ sampleRate: 48000, channels: [quiet, quiet] }).integratedLufs!
+    const loudLufs = measureLoudness({ sampleRate: 48000, channels: [loud, loud] }).integratedLufs!
+    expect(loudLufs - quietLufs).toBeCloseTo(20, 2)
+  })
+
+  // EBU Tech 3341 case 3-style gating: silence and very quiet passages do not pull the reading down.
+  it('gates silence out of the integrated value', () => {
+    const tone = sine(1000, -23, 10)
+    const withSilence = new Float32Array(tone.length * 2)
+    withSilence.set(tone)
+    const result = measureLoudness({ sampleRate: 48000, channels: [withSilence, withSilence] })
+    // Blocks straddling the edge count at reduced power; EBU 3341 allows ±0.1 LU.
+    expect(Math.abs(result.integratedLufs! + 23)).toBeLessThanOrEqual(0.1)
+  })
+
+  it('reports silence and too-short input as unmeasurable', () => {
+    expect(measureLoudness({ sampleRate: 48000, channels: [new Float32Array(48000)] }))
+      .toMatchObject({ integratedLufs: null, truePeakDbtp: null })
+    expect(measureLoudness({ sampleRate: 48000, channels: [sine(1000, -20, 0.2)] }).integratedLufs).toBeNull()
+  })
+
+  // A quarter-rate sine sampled 45 degrees off its peaks has sample peaks of -3 dB but a true peak of 0 dBTP.
+  it('finds inter-sample peaks', () => {
+    const channel = sine(12000, 0, 1, 48000, Math.PI / 4)
+    const samplePeak = channel.reduce((peak, sample) => Math.max(peak, Math.abs(sample)), 0)
+    expect(20 * Math.log10(samplePeak)).toBeCloseTo(-3, 1)
+    const result = measureLoudness({ sampleRate: 48000, channels: [channel] })
+    expect(Math.abs(result.truePeakDbtp!)).toBeLessThanOrEqual(0.5)
+  })
+})
