@@ -0,0 +1,111 @@
+import { useEffect, useState } from 'react'
+import { useTranslation } from 'react-i18next'
+import { Gauge } from 'lucide-react'
+import { measureLoudnessInWorker, type LoudnessMeasurement } from '@/shared/utils/loudness'
+
+/** Studio loudness defaults (FL-598): not a promise to meet any platform's rules. */
+const TARGET_LUFS = -16
+const CEILING_DBTP = -1
+/** Reported tolerance for the integrated level and the true-peak reading. */
+const TARGET_TOLERANCE_LU = 1
+const PEAK_TOLERANCE_DB = 0.2
+/** Files decoded at this rate (Float32) plus the worker's copy must fit this budget. */
+const DECODE_RATE = 48000
+const MAX_DECODED_BYTES = 512 * 1024 * 1024
+/** The longest file, in seconds, whose decoded PCM and worker copy fit the budget. */
+const maxSecondsFor = (channels: number) => MAX_DECODED_BYTES / (2 * 4 * DECODE_RATE * Math.max(1, channels))
+
+type Report =
+  | { state: 'measuring' }
+  | { state: 'unknown' }
+  | { state: 'too-long'; minutes: number }
+  | { state: 'silent' }
+  | { state: 'measured'; measurement: LoudnessMeasurement }
+
+async function probe(blob: Blob): Promise<{ seconds: number; channels: number }> {
+  const { Input, BlobSource, ALL_FORMATS } = await import('mediabunny')
+  const input = new Input({ source: new BlobSource(blob), formats: ALL_FORMATS })
+  try {
+    const track = await input.getPrimaryAudioTrack()
+    return { seconds: await input.computeDuration(), channels: track?.numberOfChannels ?? 2 }
+  } finally {
+    input.dispose()
+  }
+}
+
+async function decodeDeliverable(blob: Blob): Promise<AudioBuffer> {
+  const context = new OfflineAudioContext(1, 1, DECODE_RATE)
+  return context.decodeAudioData(await blob.arrayBuffer())
+}
+
+/**
+ * Measures the exported file itself, decoded, so codec overshoot shows up.
+ * A failed measurement reads "unknown", never passing; the report only warns.
+ */
+export function ExportLoudnessReport({ blob }: { blob: Blob | null | undefined }) {
+  const { t } = useTranslation()
+  // The parent keys this report by the exported blob, so each export starts at "measuring".
+  const [measured, setReport] = useState<Report>({ state: 'measuring' })
+  const measurable = !!blob && typeof OfflineAudioContext !== 'undefined'
+  const report: Report = measurable ? measured : { state: 'unknown' }
+
+  useEffect(() => {
+    if (!blob || typeof OfflineAudioContext === 'undefined') return
+    const controller = new AbortController()
+    void (async () => {
+      try {
+        // Checked before decoding, from the container: a file whose decoded PCM and worker copy
+        // would not fit the memory budget is never decoded.
+        const { seconds, channels: channelCount } = await probe(blob)
+        if (seconds > maxSecondsFor(channelCount)) {
+          if (!controller.signal.aborted) setReport({ state: 'too-long', minutes: Math.floor(maxSecondsFor(channelCount) / 60) })
+          return
+        }
+        const buffer = await decodeDeliverable(blob)
+        const channels = Array.from({ length: buffer.numberOfChannels }, (_, c) => buffer.getChannelData(c))
+        const measurement = await measureLoudnessInWorker({ sampleRate: buffer.sampleRate, channels }, controller.signal)
+        if (controller.signal.aborted) return
+        setReport(measurement.integratedLufs === null ? { state: 'silent' } : { state: 'measured', measurement })
+      } catch {
+        if (!controller.signal.aborted) setReport({ state: 'unknown' })
+      }
+    })()
+    return () => controller.abort()
+  }, [blob])
+
+  let body: string
+  let tone = 'text-muted-foreground'
+  if (report.state === 'measuring') {
+    body = t('export.loudness.measuring')
+  } else if (report.state === 'unknown') {
+    body = t('export.loudness.unknown')
+  } else if (report.state === 'too-long') {
+    body = t('export.loudness.tooLong', { minutes: report.minutes })
+  } else if (report.state === 'silent') {
+    body = t('export.loudness.silent')
+  } else {
+    const { integratedLufs, truePeakDbtp } = report.measurement
+    const lufs = integratedLufs!
+    const levelOk = Math.abs(lufs - TARGET_LUFS) <= TARGET_TOLERANCE_LU
+    const peakOk = truePeakDbtp === null || truePeakDbtp <= CEILING_DBTP + PEAK_TOLERANCE_DB
+    tone = levelOk && peakOk ? 'text-green-400' : 'text-amber-400'
+    body = [
+      t('export.loudness.measured', {
+        lufs: lufs.toFixed(1),
+        peak: truePeakDbtp === null ? '—' : truePeakDbtp.toFixed(1),
+        target: TARGET_LUFS,
+        ceiling: CEILING_DBTP,
+      }),
+      levelOk ? null : t(lufs < TARGET_LUFS ? 'export.loudness.tooQuiet' : 'export.loudness.tooLoud'),
+      peakOk ? null : t('export.loudness.overPeak'),
+      levelOk && peakOk ? t('export.loudness.pass') : null,
+    ].filter(Boolean).join(' ')
+  }
+
+  return (
+    <div className="flex items-start gap-2 text-sm" role="status" aria-live="polite">
+      <Gauge className="mt-0.5 h-4 w-4 flex-shrink-0 text-muted-foreground" />
+      <span className={tone}>{body}</span>
+    </div>
+  )
+}
