+/** A finite number read from draft text, clamped to [min, max]; the fallback while the text is not a number. */
+export function parseClamped(text: string, min: number, max: number, fallback: number): number {
+  const value = Number.parseFloat(text)
+  return Number.isFinite(value) ? Math.min(max, Math.max(min, value)) : fallback
+}
