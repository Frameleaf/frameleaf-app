+// @vitest-environment node
+
+import { beforeEach, describe, expect, it } from 'vite-plus/test'
+import type { AudioItem, TimelineTrack, VideoItem } from '@/types/timeline'
+import { useItemsStore } from '../../items-store'
+import { useTimelineCommandStore } from '../../timeline-command-store'
+import { useTimelineSettingsStore } from '../../timeline-settings-store'
+import {
+  loudnessBinding,
+  resolveAudibleItems,
+  suggestLoudnessMatch,
+  type ClipLoudnessResult,
+} from '../../../utils/loudness-match'
+import { LOUDNESS_ALGORITHM } from '@/shared/utils/loudness'
+import { applyLoudnessMatch } from './loudness-match-actions'
+
+const track = (id: string, locked = false) => ({
+  id, name: id, order: 0, height: 80, locked, syncLock: true, visible: true, muted: false,
+  solo: false, volume: 0, items: [], kind: 'audio',
+}) as TimelineTrack
+
+const audio = (overrides: Partial<AudioItem> = {}): AudioItem => ({
+  id: 'a1', type: 'audio', trackId: 't1', from: 0, durationInFrames: 300, label: 'Interview',
+  src: 'blob:a', mediaId: 'm1', sourceStart: 0, sourceEnd: 300, sourceFps: 30, volume: 0, ...overrides,
+} as AudioItem)
+
+function measured(item: AudioItem | VideoItem, lufs: number | null, peak: number | null = -6): ClipLoudnessResult {
+  return {
+    itemId: item.id, label: item.label, binding: loudnessBinding(item),
+    measurement: { algorithm: LOUDNESS_ALGORITHM, integratedLufs: lufs, truePeakDbtp: peak, durationSeconds: 10, channelCount: 2 },
+  }
+}
+
+describe('loudness match', () => {
+  beforeEach(() => {
+    useTimelineCommandStore.getState().clearHistory()
+    useTimelineSettingsStore.setState({ fps: 30, isDirty: false })
+    useItemsStore.getState().setTracks([track('t1'), track('t2', true)])
+  })
+
+  it('suggests the gain that reaches the target from the clip as it plays now', () => {
+    const item = audio({ volume: -3 })
+    const suggestion = suggestLoudnessMatch(item, measured(item, -20), -16, -1)!
+    // Plays at -23 LUFS; +7 dB reaches -16.
+    expect(suggestion).toMatchObject({ currentLufs: -23, gainDb: 7, newVolumeDb: 4, predictedTruePeakDbtp: -2, overCeiling: false })
+  })
+
+  it('caps automatic boost at +12 dB and flags it', () => {
+    const item = audio()
+    expect(suggestLoudnessMatch(item, measured(item, -40), -16, -1)).toMatchObject({ gainDb: 12, limitedBy: 'boost-cap' })
+  })
+
+  it('stays within the clip volume range', () => {
+    const item = audio({ volume: 8 })
+    expect(suggestLoudnessMatch(item, measured(item, -30), -16, -1)).toMatchObject({ newVolumeDb: 12, gainDb: 4, limitedBy: 'volume-range' })
+  })
+
+  it('warns when the change would push the true peak over the ceiling', () => {
+    const item = audio()
+    expect(suggestLoudnessMatch(item, measured(item, -26, -4), -16, -1)).toMatchObject({ predictedTruePeakDbtp: 6, overCeiling: true })
+  })
+
+  it('applies in one undo step and never applies the same result twice', () => {
+    const quiet = audio()
+    const loud = audio({ id: 'a2', from: 300 })
+    useItemsStore.getState().setItems([quiet, loud])
+    const results = [measured(quiet, -22), measured(loud, -10)]
+
+    expect(applyLoudnessMatch(results, -16, -1)).toEqual({ applied: ['a1', 'a2'], stale: [], locked: [] })
+    expect(useItemsStore.getState().itemById['a1']!.volume).toBe(6)
+    expect(useItemsStore.getState().itemById['a2']!.volume).toBe(-6)
+
+    // The same results describe the clips before the change, so they are now stale.
+    expect(applyLoudnessMatch(results, -16, -1)).toEqual({ applied: [], stale: ['a1', 'a2'], locked: [] })
+    expect(useItemsStore.getState().itemById['a1']!.volume).toBe(6)
+
+    useTimelineCommandStore.getState().undo()
+    expect(useItemsStore.getState().items.map((item) => item.volume)).toEqual([0, 0])
+  })
+
+  it('skips clips changed since analysis, unmeasurable clips and locked tracks', () => {
+    const trimmed = audio()
+    const silent = audio({ id: 'a2' })
+    const locked = audio({ id: 'a3', trackId: 't2' })
+    // Measured while linked to a video, now unlinked: a different clip may be heard.
+    useItemsStore.getState().setItems([trimmed])
+    expect(applyLoudnessMatch([measured({ ...trimmed, linkedGroupId: 'g1' } as AudioItem, -20)], -16, -1).stale).toEqual(['a1'])
+    useItemsStore.getState().setItems([{ ...trimmed, sourceEnd: 200 } as AudioItem, silent, locked])
+    const outcome = applyLoudnessMatch([measured(trimmed, -20), measured(silent, null, null), measured(locked, -20)], -16, -1)
+    expect(outcome).toEqual({ applied: [], stale: ['a1'], locked: ['a3'] })
+    expect(useTimelineCommandStore.getState().canUndo).toBe(false)
+  })
+
+  it('measures the linked audio of a selected video, or the video itself when it has none', () => {
+    const video = { ...audio({ id: 'v1', linkedGroupId: 'g' }), type: 'video' } as unknown as VideoItem
+    const linkedAudio = audio({ id: 'a1', linkedGroupId: 'g' })
+    const lone = { ...audio({ id: 'v2' }), type: 'video' } as unknown as VideoItem
+    const silentVideo = { ...audio({ id: 'v3' }), type: 'video', embeddedAudioMuted: true } as unknown as VideoItem
+    const items = [video, linkedAudio, lone, silentVideo]
+    expect(resolveAudibleItems(items, ['v1', 'a1', 'v2', 'v3']).map((item) => item.id)).toEqual(['a1', 'v2'])
+  })
+})
