+import type { AudioItem, VideoItem } from '@/types/timeline'
+import { useItemsStore } from '../../items-store'
+import { useTimelineSettingsStore } from '../../timeline-settings-store'
+import { execute } from '../shared'
+import { hasLockedEditParticipants } from '../linked-edit'
+import {
+  suggestLoudnessMatch,
+  type ClipLoudnessResult,
+} from '../../../utils/loudness-match'
+
+export interface LoudnessMatchOutcome {
+  applied: string[]
+  /** Clips that changed since analysis, or were removed; their results are discarded. */
+  stale: string[]
+  locked: string[]
+}
+
+/**
+ * Apply approved loudness matches as one undoable edit. Each result must still
+ * describe the clip as it is now; a stale result (the clip changed, or this
+ * result was already applied) is skipped, so a match is never applied twice.
+ */
+export function applyLoudnessMatch(
+  results: readonly ClipLoudnessResult[],
+  targetLufs: number,
+  ceilingDbtp: number,
+): LoudnessMatchOutcome {
+  const outcome: LoudnessMatchOutcome = { applied: [], stale: [], locked: [] }
+  const items = useItemsStore.getState().items
+  const updates: Array<{ id: string; volume: number }> = []
+  for (const result of results) {
+    const item = items.find((candidate) => candidate.id === result.itemId)
+    if (!item || (item.type !== 'audio' && item.type !== 'video')) {
+      outcome.stale.push(result.itemId)
+      continue
+    }
+    const suggestion = suggestLoudnessMatch(item as AudioItem | VideoItem, result, targetLufs, ceilingDbtp)
+    if (!suggestion) {
+      if (result.measurement?.integratedLufs != null) outcome.stale.push(result.itemId)
+      continue
+    }
+    if (hasLockedEditParticipants([item])) {
+      outcome.locked.push(item.id)
+      continue
+    }
+    if (suggestion.gainDb !== 0) updates.push({ id: item.id, volume: suggestion.newVolumeDb })
+  }
+  if (updates.length === 0) return outcome
+
+  execute(
+    'APPLY_LOUDNESS_MATCH',
+    () => {
+      const store = useItemsStore.getState()
+      for (const update of updates) store._updateItem(update.id, { volume: update.volume })
+      useTimelineSettingsStore.getState().markDirty()
+    },
+    { targetLufs, ceilingDbtp, updates },
+  )
+  outcome.applied = updates.map((update) => update.id)
+  return outcome
+}
diff --git a/src/features/timeline/utils/loudness-match.ts b/src/features/timeline/utils/loudness-match.ts
new file mode 100644
--- /dev/null
+++ b/src/features/timeline/utils/loudness-match.ts
@@ -0,0 +1,168 @@
+import type { AudioItem, TimelineItem, VideoItem } from '@/types/timeline'
+import { getOrDecodeAudioSliceForPlayback } from '@/features/timeline/deps/composition-runtime'
+import { resolveMediaUrl } from '@/features/timeline/deps/media-library-resolver'
+import { measureLoudnessInWorker, type LoudnessMeasurement } from '@/shared/utils/loudness'
+import { getItemSourceSpanSeconds } from './media-item-frames'
+import { useTimelineSettingsStore } from '../stores/timeline-settings-store'
+import { getLinkedItems } from './linked-items'
+
+/**
+ * Dialogue loudness matching (FL-598). A clip is measured on its source range,
+ * and its suggested match is a change to the clip's static volume: gain
+ * envelopes, fades and ducking stay relative to it. Each result is bound to
+ * the clip's audible state, so a result goes stale once the clip changes and
+ * can never be applied twice.
+ */
+
+export const DEFAULT_TARGET_LUFS = -16
+export const DEFAULT_CEILING_DBTP = -1
+/** Largest automatic boost; larger needs are flagged for manual review. */
+const MAX_MATCH_BOOST_DB = 12
+const MIN_VOLUME_DB = -60
+const MAX_VOLUME_DB = 12
+
+export type ClipLoudnessUnavailable = 'muted' | 'no-source' | 'silent-or-short' | 'decode-failed'
+
+export interface ClipLoudnessResult {
+  itemId: string
+  label: string
+  /** The clip's audible state when measured; any change makes the result stale. */
+  binding: string
+  measurement: LoudnessMeasurement | null
+  unavailable?: ClipLoudnessUnavailable
+}
+
+export interface LoudnessMatchSuggestion {
+  itemId: string
+  /** Measured loudness of the clip as it plays now (source plus current volume). */
+  currentLufs: number
+  gainDb: number
+  newVolumeDb: number
+  /** Why the suggestion stops short of the target. */
+  limitedBy?: 'boost-cap' | 'volume-range'
+  /** Predicted true peak after the change; above the ceiling the mix will be soft-clipped. */
+  predictedTruePeakDbtp: number | null
+  overCeiling: boolean
+}
+
+type AudibleItem = AudioItem | VideoItem
+
+/** The item whose sound a selected clip plays: a video's linked audio when it has one. */
+export function resolveAudibleItems(items: readonly TimelineItem[], selectedIds: readonly string[]): AudibleItem[] {
+  const resolved = new Map<string, AudibleItem>()
+  for (const id of selectedIds) {
+    const item = items.find((candidate) => candidate.id === id)
+    if (!item) continue
+    if (item.type === 'audio') {
+      resolved.set(item.id, item)
+    } else if (item.type === 'video') {
+      const linkedAudio = getLinkedItems(items as TimelineItem[], item.id).find(
+        (linked): linked is AudioItem => linked.type === 'audio',
+      )
+      if (linkedAudio) resolved.set(linkedAudio.id, linkedAudio)
+      else if (item.embeddedAudioMuted !== true) resolved.set(item.id, item)
+    }
+  }
+  return [...resolved.values()]
+}
+
+/** `fps` is the rate the source span was measured at; apply checks against the current rate. */
+export function loudnessBinding(item: AudibleItem, fps = useTimelineSettingsStore.getState().fps): string {
+  return JSON.stringify([
+    fps,
+    item.mediaId, item.sourceStart ?? 0, item.sourceEnd ?? null, item.sourceFps ?? null,
+    item.speed ?? 1, item.volume ?? 0, item.muted === true, item.durationInFrames,
+    // Unlinking or unmuting embedded sound changes which clip is heard.
+    item.linkedGroupId ?? null, item.type === 'video' && item.embeddedAudioMuted === true,
+  ])
+}
+
+export function suggestLoudnessMatch(
+  item: AudibleItem,
+  result: ClipLoudnessResult,
+  targetLufs: number,
+  ceilingDbtp: number,
+): LoudnessMatchSuggestion | null {
+  const sourceLufs = result.measurement?.integratedLufs
+  if (sourceLufs == null || result.binding !== loudnessBinding(item)) return null
+  const volume = item.volume ?? 0
+  const currentLufs = sourceLufs + volume
+  let gainDb = targetLufs - currentLufs
+  let limitedBy: LoudnessMatchSuggestion['limitedBy']
+  if (gainDb > MAX_MATCH_BOOST_DB) {
+    gainDb = MAX_MATCH_BOOST_DB
+    limitedBy = 'boost-cap'
+  }
+  const newVolumeDb = Math.min(MAX_VOLUME_DB, Math.max(MIN_VOLUME_DB, volume + gainDb))
+  if (newVolumeDb !== volume + gainDb) {
+    gainDb = newVolumeDb - volume
+    limitedBy = 'volume-range'
+  }
+  const roundedVolume = Math.round(newVolumeDb * 10) / 10
+  const predictedTruePeakDbtp = result.measurement?.truePeakDbtp == null
+    ? null
+    : result.measurement.truePeakDbtp + roundedVolume
+  return {
+    itemId: item.id,
+    currentLufs,
+    gainDb: roundedVolume - volume,
+    newVolumeDb: roundedVolume,
+    limitedBy,
+    predictedTruePeakDbtp,
+    overCeiling: predictedTruePeakDbtp !== null && predictedTruePeakDbtp > ceilingDbtp,
+  }
+}
+
+function abortError(): DOMException {
+  return new DOMException('Loudness analysis cancelled', 'AbortError')
+}
+
+/** Settle as soon as `signal` aborts; the operation itself runs on (neither call accepts a signal). */
+function untilAborted<T>(work: Promise<T>, signal?: AbortSignal): Promise<T> {
+  if (!signal) return work
+  if (signal.aborted) return Promise.reject(abortError())
+  return new Promise<T>((resolve, reject) => {
+    const onAbort = () => reject(abortError())
+    signal.addEventListener('abort', onAbort, { once: true })
+    work.then(resolve, reject).finally(() => signal.removeEventListener('abort', onAbort))
+  })
+}
+
+/** Measure each clip's audible source range. Cancelling rejects with an AbortError and applies nothing. */
+export async function analyzeClipLoudness(
+  items: readonly AudibleItem[],
+  timelineFps: number,
+  signal?: AbortSignal,
+): Promise<ClipLoudnessResult[]> {
+  const results: ClipLoudnessResult[] = []
+  for (const item of items) {
+    if (signal?.aborted) throw abortError()
+    const base = { itemId: item.id, label: item.label, binding: loudnessBinding(item, timelineFps), measurement: null }
+    if (item.muted === true) { results.push({ ...base, unavailable: 'muted' }); continue }
+    const span = getItemSourceSpanSeconds(item, timelineFps)
+    const url = item.mediaId ? await untilAborted(resolveMediaUrl(item.mediaId), signal) : null
+    if (!span || !url || !item.mediaId) { results.push({ ...base, unavailable: 'no-source' }); continue }
+    try {
+      const slice = await untilAborted(getOrDecodeAudioSliceForPlayback(item.mediaId, url, {
+        targetTimeSeconds: span.start,
+        minReadySeconds: Math.max(1, span.end - span.start),
+        preRollSeconds: 0,
+        waitTimeoutMs: 0,
+      }), signal)
+      if (signal?.aborted) throw abortError()
+      const { buffer, startTime } = slice
+      const start = Math.max(0, Math.round((span.start - startTime) * buffer.sampleRate))
+      const end = Math.min(buffer.length, Math.round((span.end - startTime) * buffer.sampleRate))
+      const channels = Array.from({ length: buffer.numberOfChannels }, (_, c) =>
+        buffer.getChannelData(c).subarray(start, Math.max(start, end)))
+      const measurement = await measureLoudnessInWorker({ sampleRate: buffer.sampleRate, channels }, signal)
+      results.push(measurement.integratedLufs === null
+        ? { ...base, measurement, unavailable: 'silent-or-short' }
+        : { ...base, measurement })
+    } catch (error) {
+      if (error instanceof DOMException && error.name === 'AbortError') throw error
+      results.push({ ...base, unavailable: 'decode-failed' })
+    }
+  }
+  return results
+}
