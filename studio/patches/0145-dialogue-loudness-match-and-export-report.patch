+import { describe, expect, it } from 'vite-plus/test'
+import { parseClamped } from './parse-clamped'
+
+describe('loudness inputs', () => {
+  it('keep the last valid value while the draft is not a number, and clamp to the range', () => {
+    expect(parseClamped('-', -36, -6, -16)).toBe(-16)
+    expect(parseClamped('', -36, -6, -16)).toBe(-16)
+    expect(parseClamped('-23', -36, -6, -16)).toBe(-23)
+    expect(parseClamped('-3', -36, -6, -16)).toBe(-6)
+    expect(parseClamped('-50', -36, -6, -16)).toBe(-36)
+    expect(parseClamped('2', -12, 0, -1)).toBe(0)
+  })
+})
