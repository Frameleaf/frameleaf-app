+import { useEffect, useRef, useState } from 'react'
+import { useTranslation } from 'react-i18next'
+import { Gauge } from 'lucide-react'
+import { toast } from 'sonner'
+import { Button } from '@/components/ui/button'
+import { Input } from '@/components/ui/input'
+import type { TimelineItem } from '@/types/timeline'
+import {
+  analyzeClipLoudness,
+  applyLoudnessMatch,
+  DEFAULT_CEILING_DBTP,
+  DEFAULT_TARGET_LUFS,
+  resolveAudibleItems,
+  suggestLoudnessMatch,
+  useTimelineStore,
+  type ClipLoudnessResult,
+} from '@/features/editor/deps/timeline-store'
+import { parseClamped } from '@/shared/utils/parse-clamped'
+import { PropertyRow, PropertySection } from '../components'
+
+const format = (value: number | null | undefined, unit: string) =>
+  value == null ? '—' : `${value.toFixed(1)} ${unit}`
+
+/**
+ * Match dialogue loudness (FL-598): measure the selected clips (BS.1770),
+ * review each suggested volume change, and apply them in one undo step.
+ */
+export function LoudnessMatchSection({ items }: { items: TimelineItem[] }) {
+  const { t } = useTranslation()
+  const timelineItems = useTimelineStore((s) => s.items)
+  const fps = useTimelineStore((s) => s.fps)
+  // Draft text stays editable (an intermediate "-" is kept); matching uses parsed, clamped values.
+  const [targetText, setTargetText] = useState(String(DEFAULT_TARGET_LUFS))
+  const [ceilingText, setCeilingText] = useState(String(DEFAULT_CEILING_DBTP))
+  const target = parseClamped(targetText, -36, -6, DEFAULT_TARGET_LUFS)
+  const ceiling = parseClamped(ceilingText, -12, 0, DEFAULT_CEILING_DBTP)
+  const [results, setResults] = useState<ClipLoudnessResult[] | null>(null)
+  const [busy, setBusy] = useState(false)
+  const abortRef = useRef<AbortController | null>(null)
+
+  // The parent keys this section by selection, so a new selection starts fresh; leaving cancels analysis.
+  useEffect(() => () => abortRef.current?.abort(), [])
+
+  const audible = resolveAudibleItems(timelineItems, items.map((item) => item.id))
+  if (audible.length === 0) return null
+
+  const analyze = async () => {
+    abortRef.current?.abort()
+    const controller = new AbortController()
+    abortRef.current = controller
+    setBusy(true)
+    setResults(null)
+    try {
+      const measured = await analyzeClipLoudness(audible, fps, controller.signal)
+      // A superseded or cancelled run never writes its results.
+      if (abortRef.current === controller && !controller.signal.aborted) setResults(measured)
+    } catch (error) {
+      if (!(error instanceof DOMException && error.name === 'AbortError')) {
+        toast.error(t('editor.audioSection.loudness.failed'))
+      }
+    } finally {
+      if (abortRef.current === controller) setBusy(false)
+    }
+  }
+
+  const apply = () => {
+    if (!results) return
+    const outcome = applyLoudnessMatch(results, target, ceiling)
+    if (outcome.applied.length > 0) toast.success(t('editor.audioSection.loudness.applied', { count: outcome.applied.length }))
+    if (outcome.stale.length > 0) toast.warning(t('editor.audioSection.loudness.stale', { count: outcome.stale.length }))
+    if (outcome.locked.length > 0) toast.warning(t('editor.audioSection.loudness.locked', { count: outcome.locked.length }))
+    setResults(null)
+  }
+
+  const rows = (results ?? []).map((result) => {
+    const item = timelineItems.find((candidate) => candidate.id === result.itemId)
+    const suggestion = item && (item.type === 'audio' || item.type === 'video')
+      ? suggestLoudnessMatch(item, result, target, ceiling)
+      : null
+    return { result, suggestion }
+  })
+  const applicable = rows.some((row) => row.suggestion && row.suggestion.gainDb !== 0)
+
+  return (
+    <PropertySection title={t('editor.audioSection.loudness.title')} icon={Gauge} defaultOpen={false}>
+      <PropertyRow label={t('editor.audioSection.loudness.target')}>
+        <div className="flex items-center gap-1 w-full">
+          <Input type="text" inputMode="decimal" className="h-7 min-w-0 flex-1 px-2 text-xs"
+            aria-label={t('editor.audioSection.loudness.target')} value={targetText}
+            onChange={(event) => setTargetText(event.target.value)}
+            onBlur={() => setTargetText(String(target))} />
+          <span className="text-xs text-muted-foreground">LUFS</span>
+        </div>
+      </PropertyRow>
+      <PropertyRow label={t('editor.audioSection.loudness.ceiling')}>
+        <div className="flex items-center gap-1 w-full">
+          <Input type="text" inputMode="decimal" className="h-7 min-w-0 flex-1 px-2 text-xs"
+            aria-label={t('editor.audioSection.loudness.ceiling')} value={ceilingText}
+            onChange={(event) => setCeilingText(event.target.value)}
+            onBlur={() => setCeilingText(String(ceiling))} />
+          <span className="text-xs text-muted-foreground">dBTP</span>
+        </div>
+      </PropertyRow>
+
+      <div className="space-y-1 px-1 py-2 text-xs" aria-live="polite">
+        {busy && <p>{t('editor.audioSection.loudness.analyzing')}</p>}
+        {rows.map(({ result, suggestion }) => (
+          <div key={result.itemId} className="rounded border border-border px-2 py-1">
+            <p className="truncate font-medium">{result.label}</p>
+            {result.unavailable ? (
+              <p className="text-muted-foreground">{t(`editor.audioSection.loudness.unavailable.${result.unavailable}`)}</p>
+            ) : suggestion ? (
+              <>
+                <p>
+                  {t('editor.audioSection.loudness.measured', {
+                    lufs: format(suggestion.currentLufs, 'LUFS'),
+                    peak: format(result.measurement?.truePeakDbtp, 'dBTP'),
+                  })}
+                </p>
+                <p>{t('editor.audioSection.loudness.change', { gain: `${suggestion.gainDb >= 0 ? '+' : ''}${suggestion.gainDb.toFixed(1)} dB` })}</p>
+                {suggestion.limitedBy && (
+                  <p className="text-amber-500">{t(`editor.audioSection.loudness.limited.${suggestion.limitedBy}`)}</p>
+                )}
+                {suggestion.overCeiling && (
+                  <p className="text-amber-500">{t('editor.audioSection.loudness.overCeiling', { peak: format(suggestion.predictedTruePeakDbtp, 'dBTP') })}</p>
+                )}
+              </>
+            ) : (
+              <p className="text-muted-foreground">{t('editor.audioSection.loudness.changed')}</p>
+            )}
+          </div>
+        ))}
+        <p className="text-muted-foreground">{t('editor.audioSection.loudness.note')}</p>
+      </div>
+
+      <div className="flex items-center gap-2 px-1 pb-2">
+        {busy ? (
+          <Button variant="ghost" size="sm" className="h-7 flex-1 text-xs" onClick={() => abortRef.current?.abort()}>
+            {t('editor.audioSection.loudness.cancel')}
+          </Button>
+        ) : (
+          <Button variant="ghost" size="sm" className="h-7 flex-1 text-xs" onClick={() => void analyze()}>
+            {t('editor.audioSection.loudness.analyze')}
+          </Button>
+        )}
+        <Button size="sm" className="h-7 flex-1 text-xs" disabled={busy || !applicable} onClick={apply}>
+          {t('editor.audioSection.loudness.apply')}
+        </Button>
+      </div>
+    </PropertySection>
+  )
+}
