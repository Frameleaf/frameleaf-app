+/**
+ * Loudness measurement (FL-598): ITU-R BS.1770-4 integrated loudness with
+ * EBU R128 gating, and true peak by 4x oversampling. One implementation is
+ * shared by clip analysis and export verification.
+ */
+
+export const LOUDNESS_ALGORITHM = 'bs1770-4/r128-gating/tp-4x-v1'
+
+export interface LoudnessInput {
+  sampleRate: number
+  /** One array per channel, in the Web Audio speaker order (see channelWeights). */
+  channels: readonly Float32Array[]
+}
+
+export interface LoudnessMeasurement {
+  algorithm: typeof LOUDNESS_ALGORITHM
+  /** Integrated loudness in LUFS, or null when nothing survives gating. */
+  integratedLufs: number | null
+  /** True peak in dBTP, or null for digital silence. */
+  truePeakDbtp: number | null
+  durationSeconds: number
+  channelCount: number
+}
+
+interface Biquad { b0: number; b1: number; b2: number; a1: number; a2: number }
+
+// K-weighting stages for any sample rate (the BS.1770 Annex 1 filters' analogue prototypes).
+function kWeighting(sampleRate: number): [Biquad, Biquad] {
+  const shelfK = Math.tan((Math.PI * 1681.974450955533) / sampleRate)
+  const shelfQ = 0.7071752369554196
+  const vh = 10 ** (3.999843853973347 / 20)
+  const vb = vh ** 0.4996667741545416
+  const shelfA0 = 1 + shelfK / shelfQ + shelfK * shelfK
+  const passK = Math.tan((Math.PI * 38.13547087602444) / sampleRate)
+  const passQ = 0.5003270373238773
+  const passA0 = 1 + passK / passQ + passK * passK
+  return [
+    {
+      b0: (vh + (vb * shelfK) / shelfQ + shelfK * shelfK) / shelfA0,
+      b1: (2 * (shelfK * shelfK - vh)) / shelfA0,
+      b2: (vh - (vb * shelfK) / shelfQ + shelfK * shelfK) / shelfA0,
+      a1: (2 * (shelfK * shelfK - 1)) / shelfA0,
+      a2: (1 - shelfK / shelfQ + shelfK * shelfK) / shelfA0,
+    },
+    {
+      b0: 1, b1: -2, b2: 1,
+      a1: (2 * (passK * passK - 1)) / passA0,
+      a2: (1 - passK / passQ + passK * passK) / passA0,
+    },
+  ]
+}
+
+/**
+ * K-weight one channel and add weight × the energy of each `step`-sample segment into `energy`.
+ * Streams sample by sample, so memory is one value per 100 ms, not per sample.
+ */
+function addSegmentEnergy(samples: Float32Array, stages: readonly Biquad[], step: number, weight: number, energy: Float64Array): void {
+  const state = stages.map(() => ({ x1: 0, x2: 0, y1: 0, y2: 0 }))
+  for (let segment = 0; segment < energy.length; segment += 1) {
+    let sum = 0
+    for (let i = segment * step, end = i + step; i < end; i += 1) {
+      let value = samples[i]!
+      for (let s = 0; s < stages.length; s += 1) {
+        const { b0, b1, b2, a1, a2 } = stages[s]!
+        const z = state[s]!
+        const y = b0 * value + b1 * z.x1 + b2 * z.x2 - a1 * z.y1 - a2 * z.y2
+        z.x2 = z.x1; z.x1 = value; z.y2 = z.y1; z.y1 = y
+        value = y
+      }
+      sum += value * value
+    }
+    energy[segment]! += weight * sum
+  }
+}
+
+const toLufs = (power: number) => -0.691 + 10 * Math.log10(power)
+const mean = (values: number[]) => values.reduce((sum, value) => sum + value, 0) / values.length
+
+/**
+ * BS.1770 channel weights for the Web Audio layouts: quad is L R SL SR, 5.0 is L R C SL SR,
+ * 5.1 and wider are L R C LFE SL SR …; the LFE is excluded and surrounds weigh 1.41.
+ */
+export function channelWeights(count: number): number[] {
+  return Array.from({ length: count }, (_, index) => {
+    if (count === 4) return index >= 2 ? 1.41 : 1
+    if (count === 5) return index >= 3 ? 1.41 : 1
+    if (count >= 6) return index === 3 ? 0 : index >= 4 ? 1.41 : 1
+    return 1
+  })
+}
+
+function integratedLoudness(input: LoudnessInput): number | null {
+  const { sampleRate, channels } = input
+  // 400 ms blocks at a 100 ms step (75% overlap) are four consecutive 100 ms segments.
+  const step = Math.round(0.1 * sampleRate)
+  const blockSize = 4 * step
+  const length = channels[0]?.length ?? 0
+  if (length < blockSize) return null
+
+  const stages = kWeighting(sampleRate)
+  const weights = channelWeights(channels.length)
+  const energy = new Float64Array(Math.floor(length / step))
+  channels.forEach((channel, c) => {
+    if (weights[c]! > 0) addSegmentEnergy(channel, stages, step, weights[c]!, energy)
+  })
+  const blocks: number[] = []
+  for (let k = 0; k + 4 <= energy.length; k += 1) {
+    blocks.push((energy[k]! + energy[k + 1]! + energy[k + 2]! + energy[k + 3]!) / blockSize)
+  }
+
+  const absolute = blocks.filter((power) => power > 0 && toLufs(power) > -70)
+  if (absolute.length === 0) return null
+  const relativeGate = toLufs(mean(absolute)) - 10
+  const gated = absolute.filter((power) => toLufs(power) > relativeGate)
+  return gated.length === 0 ? null : toLufs(mean(gated))
+}
+
+// 4x polyphase interpolator: 12-tap Blackman-windowed sinc per phase.
+const OVERSAMPLE = 4
+const TAPS = 12
+const CENTER = TAPS / 2 - 1
+const PHASES: Float64Array[] = Array.from({ length: OVERSAMPLE }, (_, phase) => {
+  const taps = new Float64Array(TAPS)
+  for (let t = 0; t < TAPS; t += 1) {
+    const x = t - CENTER - phase / OVERSAMPLE
+    const sinc = x === 0 ? 1 : Math.sin(Math.PI * x) / (Math.PI * x)
+    const n = (t + 1 - phase / OVERSAMPLE) / (TAPS + 1)
+    taps[t] = sinc * (0.42 - 0.5 * Math.cos(2 * Math.PI * n) + 0.08 * Math.cos(4 * Math.PI * n))
+  }
+  const sum = taps.reduce((total, tap) => total + tap, 0)
+  return taps.map((tap) => tap / sum)
+})
+
+function truePeak(channels: readonly Float32Array[]): number {
+  let peak = 0
+  for (const channel of channels) {
+    for (let i = 0; i < channel.length; i += 1) {
+      peak = Math.max(peak, Math.abs(channel[i]!))
+      for (let phase = 1; phase < OVERSAMPLE; phase += 1) {
+        const taps = PHASES[phase]!
+        let value = 0
+        for (let t = 0; t < TAPS; t += 1) {
+          const index = i + t - CENTER
+          if (index >= 0 && index < channel.length) value += channel[index]! * taps[t]!
+        }
+        peak = Math.max(peak, Math.abs(value))
+      }
+    }
+  }
+  return peak
+}
+
+export function measureLoudness(input: LoudnessInput): LoudnessMeasurement {
+  const length = input.channels[0]?.length ?? 0
+  const peak = truePeak(input.channels)
+  return {
+    algorithm: LOUDNESS_ALGORITHM,
+    integratedLufs: integratedLoudness(input),
+    truePeakDbtp: peak > 0 ? 20 * Math.log10(peak) : null,
+    durationSeconds: input.sampleRate > 0 ? length / input.sampleRate : 0,
+    channelCount: input.channels.length,
+  }
+}
+
+function abortError(): DOMException {
+  return new DOMException('Loudness measurement cancelled', 'AbortError')
+}
+
+/** Measure off the main thread where workers exist; cancelling rejects with an AbortError. */
+export function measureLoudnessInWorker(input: LoudnessInput, signal?: AbortSignal): Promise<LoudnessMeasurement> {
+  if (signal?.aborted) return Promise.reject(abortError())
+  if (typeof Worker === 'undefined') return Promise.resolve(measureLoudness(input))
+  return new Promise((resolve, reject) => {
+    const worker = new Worker(new URL('./loudness-worker.ts', import.meta.url), { type: 'module' })
+    const id = crypto.randomUUID()
+    const finish = (callback: () => void) => {
+      signal?.removeEventListener('abort', onAbort)
+      worker.terminate()
+      callback()
+    }
+    const onAbort = () => finish(() => reject(abortError()))
+    worker.addEventListener('message', (event: MessageEvent<{ id: string; error?: string; measurement?: LoudnessMeasurement }>) => {
+      if (event.data.id !== id) return
+      finish(() => (event.data.measurement ? resolve(event.data.measurement) : reject(new Error(event.data.error))))
+    })
+    worker.addEventListener('error', (event) => finish(() => reject(new Error(event.message))))
+    signal?.addEventListener('abort', onAbort, { once: true })
+    const buffers = input.channels.map((channel) => channel.slice().buffer)
+    worker.postMessage({ id, sampleRate: input.sampleRate, channels: buffers }, buffers)
+  })
+}
