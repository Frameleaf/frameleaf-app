+    act(() => report(40))
+    expect(screen.getByRole('progressbar').getAttribute('aria-valuenow')).toBe('40')
+    await act(async () => finish(motion))
+    expect(actions.applyStabilisation).toHaveBeenCalledWith(item.id, motion, 'gentle')
+    expect(toast.success).toHaveBeenCalledWith('editor.stabilise.applied {"name":"Walk"}')
+    expect(screen.queryByRole('progressbar')).toBeNull()
