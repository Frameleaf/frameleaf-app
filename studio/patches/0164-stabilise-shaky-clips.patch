+/**
+ * Stabilise (FL-638): where a clip's camera movement is measured.
+ *
+ * The measurement is a job on the host's server, so this module only names the contract. On its
+ * own the engine has no such server and answers that Stabilise is unavailable; a host build
+ * substitutes this module with one that runs the job and follows it.
+ */
+import type { StabilisationMotion } from '@/types/stabilisation'
+
+export class StabiliseUnavailableError extends Error {
+  constructor() {
+    super('Stabilise is not available here')
+    this.name = 'StabiliseUnavailableError'
+  }
+}
+
+export interface StabiliseAnalysis {
+  /** Measure the clip's camera movement. `onProgress` gets 0-100. Rejects with the reason to show. */
+  analyse(
+    itemId: string,
+    signal: AbortSignal,
+    onProgress: (progress: number) => void,
+  ): Promise<StabilisationMotion>
+}
+
+export const stabiliseAvailable = false
+
+export const stabiliseAnalysis: StabiliseAnalysis = {
+  analyse: () => Promise.reject(new StabiliseUnavailableError()),
+}
