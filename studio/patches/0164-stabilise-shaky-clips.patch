+import { useEffect, useMemo, useState, useSyncExternalStore } from 'react'
+import { useTranslation } from 'react-i18next'
+import { CheckCircle2, Video } from 'lucide-react'
+import { toast } from 'sonner'
+import { Button } from '@/components/ui/button'
+import type { VideoItem } from '@/types/timeline'
+import type { StabilisationLevel, StabilisationMotion } from '@/types/stabilisation'
+import {
+  applyStabilisation,
+  removeStabilisation,
+  setStabilisationLevel,
+} from '@/features/editor/deps/timeline-store'
+import { useMediaLibraryStore } from '@/features/editor/deps/media-library'
+import { workingRangeOfSources } from '@/shared/graphics/color/managed-color'
+import {
+  STABILISATION_LEVEL_IDS,
+  correctionPath,
+  stabilisationCrop,
+} from '@/shared/utils/stabilisation'
+import {
+  stabiliseAnalysis,
+  stabiliseAvailable,
+  StabiliseUnavailableError,
+} from '@/features/editor/components/properties-sidebar/clip-panel/stabilise-service'
+
+/**
+ * Analyses in flight, by clip. They outlive the panel, so selecting another clip and coming back
+ * shows the same job, and a finished analysis is still applied to its clip.
+ */
+type Running = { progress: number; level: StabilisationLevel; controller: AbortController }
+const running = new Map<string, Running>()
+const listeners = new Set<() => void>()
+let version = 0
+const changed = () => {
+  version += 1
+  for (const listener of listeners) listener()
+}
+const subscribe = (listener: () => void) => {
+  listeners.add(listener)
+  return () => listeners.delete(listener)
+}
+const snapshot = () => version
+
+/** Start measuring a clip's camera movement; when it finishes, the clip is stabilised at `level`. */
+function startStabiliseAnalysis(
+  item: Pick<VideoItem, 'id' | 'label'>,
+  level: StabilisationLevel,
+  messages: { applied: string; failed: (reason: string) => string },
+): void {
+  if (running.has(item.id)) return
+  const controller = new AbortController()
+  const job: Running = { progress: 0, level, controller }
+  running.set(item.id, job)
+  changed()
+  stabiliseAnalysis
+    .analyse(item.id, controller.signal, (progress) => {
+      job.progress = Math.max(0, Math.min(100, progress))
+      changed()
+    })
+    .then((motion: StabilisationMotion) => {
+      if (controller.signal.aborted) return
+      const outcome = applyStabilisation(item.id, motion, job.level)
+      if (outcome.ok) toast.success(messages.applied)
+      else toast.warning(messages.failed(outcome.reason))
+    })
+    .catch((error: unknown) => {
+      if (controller.signal.aborted) return
+      const reason =
+        error instanceof StabiliseUnavailableError
+          ? 'unavailable'
+          : ((error as Error)?.message ?? '')
+      toast.error(messages.failed(reason))
+    })
+    .finally(() => {
+      if (running.get(item.id) === job) running.delete(item.id)
+      changed()
+    })
+}
+
+/** Before and after: the clip's picture moved along the measured path, and along the smoothed one. */
+function ShakePreview({
+  item,
+  steady,
+  level,
+}: {
+  item: VideoItem
+  steady: boolean
+  level: StabilisationLevel
+}) {
+  const { t } = useTranslation()
+  const motion = item.stabilisation?.motion
+  const crop = stabilisationCrop(level)
+  const [sample, setSample] = useState(0)
+  const count = motion?.count ?? 0
+  useEffect(() => {
+    if (count < 2) return undefined
+    if (typeof matchMedia === 'function' && matchMedia('(prefers-reduced-motion: reduce)').matches)
+      return undefined
+    const rate = Math.min(30, motion?.rate ?? 30)
+    const timer = setInterval(() => setSample((value) => (value + 1) % count), 1000 / rate)
+    return () => clearInterval(timer)
+  }, [count, motion?.rate])
+  const transform = useMemo(() => {
+    if (!motion) return steady ? `scale(${1 + crop / 100})` : undefined
+    const path = correctionPath(motion, level)
+    if (!path) return undefined
+    const index = Math.min(sample, path.x.length - 1)
+    // The analysis is relative to the first frame: the original shows the measured shake (the
+    // correction undone), the stabilised view shows the smoothed path at the level's crop.
+    const original = { x: -path.x[index]!, y: -path.y[index]!, a: -path.a[index]! }
+    if (!steady)
+      return `translate(${original.x * 100}%, ${original.y * 100}%) rotate(${original.a}rad)`
+    return `scale(${1 + crop / 100})`
+  }, [crop, level, motion, sample, steady])
+  return (
+    <figure className="m-0 flex min-w-0 flex-col gap-1">
+      <div className="relative aspect-video overflow-hidden rounded-md bg-black">
+        {item.thumbnailUrl ? (
+          <img
+            src={item.thumbnailUrl}
+            alt=""
+            className="h-full w-full object-cover"
+            style={{ transform, transformOrigin: '50% 50%' }}
+          />
+        ) : (
+          <div className="h-full w-full bg-muted/30" style={{ transform }} />
+        )}
+      </div>
+      <figcaption className="text-[11px] text-muted-foreground">
+        {steady ? t('editor.stabilise.stabilisedCrop', { crop }) : t('editor.stabilise.original')}
+      </figcaption>
+    </figure>
+  )
+}
+
+/**
+ * Stabilise (FL-638), on the Motion tab for one video clip. The camera movement is measured once, as a
+ * server job in Activity; choosing another smoothness afterwards applies at once with no new analysis.
+ * Stabilising crops in a little to hide the moving edges; the original video never changes.
+ */
+export function StabiliseSection({ item }: { item: VideoItem }) {
+  const { t } = useTranslation()
+  useSyncExternalStore(subscribe, snapshot, snapshot)
+  const job = running.get(item.id)
+  const done = item.stabilisation
+  const [chosen, setChosen] = useState<StabilisationLevel>(done?.level ?? 'smooth')
+  const level = done?.level ?? chosen
+  const colorTransfer = useMediaLibraryStore((state) =>
+    item.mediaId ? state.mediaById[item.mediaId]?.colorTransfer : undefined,
+  )
+  const hdr = workingRangeOfSources([colorTransfer]) === 'hdr'
+
+  if (!stabiliseAvailable && !done) return null
+
+  const levelLabel = (id: StabilisationLevel) => t(`editor.stabilise.level.${id}`)
+  const choose = (id: StabilisationLevel) => {
+    setChosen(id)
+    if (job) job.level = id
+    // Already stabilised: the measured path is reused, so the new smoothness applies at once.
+    if (done && done.level !== id) setStabilisationLevel(item.id, id)
+  }
+  const start = () =>
+    startStabiliseAnalysis(item, level, {
+      applied: t('editor.stabilise.applied', { name: item.label }),
+      failed: (reason) =>
+        reason === 'unavailable' || reason === ''
+          ? t('editor.stabilise.failed')
+          : t('editor.stabilise.failedReason', { reason }),
+    })
+
+  return (
+    <section
+      className="space-y-3 rounded-md border border-border p-3"
+      aria-label={t('editor.stabilise.title')}
+    >
+      <h4 className="flex items-center gap-1.5 text-xs font-medium">
+        <Video className="h-3.5 w-3.5" aria-hidden />
+        {t('editor.stabilise.title')}
+      </h4>
+      <div className="grid grid-cols-2 gap-3">
+        <ShakePreview item={item} steady={false} level={level} />
+        <ShakePreview item={item} steady level={level} />
+      </div>
+      <div role="radiogroup" aria-label={t('editor.stabilise.smoothness')} className="space-y-1">
+        <p className="text-[11px] text-muted-foreground">{t('editor.stabilise.smoothness')}</p>
+        <div className="grid grid-cols-3 gap-1 rounded-md bg-muted/40 p-0.5">
+          {STABILISATION_LEVEL_IDS.map((id) => (
+            <button
+              key={id}
+              type="button"
+              role="radio"
+              aria-checked={level === id}
+              disabled={hdr}
+              className={`h-7 rounded px-1 text-xs ${level === id ? 'bg-background font-medium shadow-sm' : 'text-muted-foreground'}`}
+              onClick={() => choose(id)}
+            >
+              {levelLabel(id)}
+            </button>
+          ))}
+        </div>
+      </div>
+      <p className="text-[11px] text-muted-foreground">
+        {t(`editor.stabilise.note.${level}`)} {t('editor.stabilise.cropNote')}
+      </p>
+      {hdr && !done && <p className="text-[11px] text-amber-500">{t('editor.stabilise.hdr')}</p>}
+      {job && (
+        <div className="space-y-1" aria-live="polite">
+          <p className="text-xs">{t('editor.stabilise.analysing')}</p>
+          <div
+            className="h-1.5 overflow-hidden rounded bg-muted"
+            role="progressbar"
+            aria-label={t('editor.stabilise.analysing')}
+            aria-valuemin={0}
+            aria-valuemax={100}
+            aria-valuenow={Math.round(job.progress)}
+          >
+            <div className="h-full bg-primary" style={{ width: `${job.progress}%` }} />
+          </div>
+        </div>
+      )}
+      <div className="flex flex-wrap items-center gap-2">
+        {done ? (
+          <>
+            <span className="flex items-center gap-1 text-xs" data-testid="stabilise-done">
+              <CheckCircle2 className="h-3.5 w-3.5 text-primary" aria-hidden />
+              {t('editor.stabilise.done', {
+                level: levelLabel(done.level),
+                crop: stabilisationCrop(done.level),
+              })}
+            </span>
+            <Button
+              variant="ghost"
+              size="sm"
+              className="h-7 text-xs"
+              onClick={() => removeStabilisation(item.id)}
+            >
+              {t('editor.stabilise.turnOff')}
+            </Button>
+          </>
+        ) : (
+          <Button
+            size="sm"
+            className="h-7 flex-1 text-xs"
+            disabled={!!job || hdr || !stabiliseAvailable}
+            onClick={start}
+          >
+            {t('editor.stabilise.start')}
+          </Button>
+        )}
+      </div>
+      <p className="text-[11px] text-muted-foreground">{t('editor.stabilise.whereItRuns')}</p>
+    </section>
+  )
+}
