diff --git a/src/shared/utils/stabilisation.test.ts b/src/shared/utils/stabilisation.test.ts
new file mode 100644
--- /dev/null
+++ b/src/shared/utils/stabilisation.test.ts
@@ -0,0 +1,192 @@
+// @vitest-environment node
+
+import { describe, expect, it } from 'vite-plus/test'
+import {
+  IDENTITY_CORRECTION,
+  STABILISATION_LEVELS,
+  coversFrame,
+  correctionPath,
+  fitCorrectionToCrop,
+  hasStabilisation,
+  readStabilisationMotion,
+  smoothPath,
+  stabilisationAt,
+  stabilisationCssTransform,
+  type StabilisationMotion,
+} from './stabilisation'
+
+const encode = (values: number[]): string => {
+  const bytes = new Uint8Array(values.length * 4)
+  const view = new DataView(bytes.buffer)
+  values.forEach((value, index) => view.setFloat32(index * 4, value, true))
+  let binary = ''
+  for (const byte of bytes) binary += String.fromCharCode(byte)
+  return btoa(binary)
+}
+
+const motionOf = (
+  x: number[],
+  y = x.map(() => 0),
+  a = x.map(() => 0),
+  rate = 30,
+  start = 0,
+): StabilisationMotion => ({
+  version: 1,
+  method: 'block-similarity-v1',
+  rate,
+  start,
+  count: x.length,
+  width: 160,
+  height: 90,
+  x: encode(x),
+  y: encode(y),
+  a: encode(a),
+  found: 1,
+})
+
+/** A deterministic shaky path: a slow pan plus a fast wobble, in fractions of the frame. */
+const shaky = (count: number) =>
+  Array.from(
+    { length: count },
+    (_, i) => 0.0005 * i + 0.01 * Math.sin(i * 1.7) + 0.006 * Math.sin(i * 0.9 + 1),
+  )
+
+const roughness = (values: ArrayLike<number>) => {
+  let total = 0
+  for (let i = 2; i < values.length; i += 1)
+    total += Math.abs(values[i]! - 2 * values[i - 1]! + values[i - 2]!)
+  return total / (values.length - 2)
+}
+
+describe('stabilisation path smoothing', () => {
+  it('keeps a straight pan straight, ends included', () => {
+    const pan = Array.from({ length: 200 }, (_, i) => 0.002 * i)
+    const smooth = smoothPath(pan, 10)
+    // A renormalised Gaussian of a line bends only within three sigma of the ends, never past them.
+    for (const i of [30, 100, 169]) expect(smooth[i]).toBeCloseTo(pan[i]!, 9)
+    expect(smooth[0]).toBeGreaterThanOrEqual(0)
+    expect(smooth[199]).toBeLessThanOrEqual(pan[199]!)
+  })
+
+  it('removes the wobble: each stronger level leaves a smoother path', () => {
+    const path = shaky(300)
+    const gentle = smoothPath(path, STABILISATION_LEVELS.gentle.sigmaSeconds * 30)
+    const smooth = smoothPath(path, STABILISATION_LEVELS.smooth.sigmaSeconds * 30)
+    expect(roughness(gentle)).toBeLessThan(roughness(path) / 5)
+    expect(roughness(smooth)).toBeLessThan(roughness(gentle))
+  })
+
+  it('holds a locked-off path at its mean', () => {
+    const smooth = smoothPath([0, 0.02, -0.02, 0.04], Number.POSITIVE_INFINITY)
+    expect([...smooth].every((value) => Math.abs(value - 0.01) < 1e-9)).toBe(true)
+  })
+
+  it('leaves a path alone at zero sigma and handles an empty one', () => {
+    expect([...smoothPath([1, 2, 3], 0)]).toEqual([1, 2, 3])
+    expect(smoothPath([], 5).length).toBe(0)
+  })
+
+  it('corrects toward the smooth path: measured plus correction equals smoothed', () => {
+    const x = shaky(120)
+    const motion = motionOf(x)
+    const correction = correctionPath(motion, 'smooth')!
+    const expected = smoothPath(new Float32Array(x), 30)
+    for (const i of [0, 17, 60, 119]) {
+      expect(Math.fround(x[i]!) + correction.x[i]!).toBeCloseTo(expected[i]!, 9)
+    }
+  })
+})
+
+describe('stabilisation crop maths', () => {
+  const aspect = 16 / 9
+
+  it('covers the frame with no correction, and with a shift inside the crop margin', () => {
+    expect(coversFrame(IDENTITY_CORRECTION, aspect)).toBe(true)
+    // Scaled 7%: 3.5% of the frame spare on each side.
+    expect(coversFrame({ tx: 0.034, ty: -0.034, rotation: 0, scale: 1.07 }, aspect)).toBe(true)
+    expect(coversFrame({ tx: 0.036, ty: 0, rotation: 0, scale: 1.07 }, aspect)).toBe(false)
+  })
+
+  it('counts the corners a turn uncovers', () => {
+    // At 4% a small turn fits, a larger one shows a corner.
+    expect(coversFrame({ tx: 0, ty: 0, rotation: 0.01, scale: 1.04 }, aspect)).toBe(true)
+    expect(coversFrame({ tx: 0, ty: 0, rotation: 0.05, scale: 1.04 }, aspect)).toBe(false)
+  })
+
+  it('reduces an oversized correction just enough to keep the frame covered', () => {
+    const fitted = fitCorrectionToCrop({ tx: 0.1, ty: 0, rotation: 0, scale: 1.07 }, aspect)
+    expect(fitted.tx).toBeCloseTo(0.035, 4)
+    expect(coversFrame(fitted, aspect)).toBe(true)
+    const turned = fitCorrectionToCrop({ tx: 0.02, ty: 0.02, rotation: 0.04, scale: 1.04 }, aspect)
+    expect(coversFrame(turned, aspect)).toBe(true)
+    expect(turned.rotation / 0.04).toBeCloseTo(turned.tx / 0.02, 9)
+    expect(turned.scale).toBe(1.04)
+  })
+
+  it('keeps a correction that already fits unchanged', () => {
+    const correction = { tx: 0.01, ty: 0.01, rotation: 0.001, scale: 1.12 }
+    expect(fitCorrectionToCrop(correction, aspect)).toBe(correction)
+  })
+})
+
+describe('stabilisationAt', () => {
+  it('scales by the level crop and interpolates between samples', () => {
+    const motion = motionOf([0, 0.02, 0, 0.02, 0], undefined, undefined, 10, 1)
+    const at = stabilisationAt({ level: 'locked', motion }, 1.15, 16 / 9)
+    expect(at.scale).toBeCloseTo(1.12, 9)
+    // Locked: mean 0.008; at sample 1.5 the measured path is 0.01, so the correction is -0.002.
+    expect(at.tx).toBeCloseTo(-0.002, 6)
+  })
+
+  it('holds the end corrections outside the analysed range', () => {
+    const motion = motionOf([0, 0.02, 0], undefined, undefined, 10, 1)
+    expect(stabilisationAt({ level: 'locked', motion }, 0, 16 / 9).tx).toBeCloseTo(
+      stabilisationAt({ level: 'locked', motion }, 1, 16 / 9).tx,
+      9,
+    )
+    expect(stabilisationAt({ level: 'locked', motion }, 99, 16 / 9).tx).toBeCloseTo(
+      stabilisationAt({ level: 'locked', motion }, 1.2, 16 / 9).tx,
+      9,
+    )
+  })
+
+  it('changing the level reuses the analysis and changes only the correction', () => {
+    const motion = motionOf(shaky(200))
+    const gentle = stabilisationAt({ level: 'gentle', motion }, 3, 16 / 9)
+    const smooth = stabilisationAt({ level: 'smooth', motion }, 3, 16 / 9)
+    expect(gentle.scale).toBeCloseTo(1.04, 9)
+    expect(smooth.scale).toBeCloseTo(1.07, 9)
+    expect(gentle.tx).not.toBeCloseTo(smooth.tx, 6)
+  })
+
+  it('draws nothing for a missing, unknown or malformed stabilisation', () => {
+    expect(stabilisationAt(undefined, 1, 1)).toBe(IDENTITY_CORRECTION)
+    expect(stabilisationAt({ level: 'wobbly' as never, motion: motionOf([0, 1]) }, 1, 1)).toBe(
+      IDENTITY_CORRECTION,
+    )
+    expect(
+      stabilisationAt({ level: 'smooth', motion: { ...motionOf([0, 1]), count: 3 } }, 1, 1),
+    ).toBe(IDENTITY_CORRECTION)
+    expect(readStabilisationMotion({ ...motionOf([0]), x: '!!!' })).toBeNull()
+    expect(readStabilisationMotion({ ...motionOf([0]), version: 2 })).toBeNull()
+    expect(readStabilisationMotion({ ...motionOf([Number.NaN]) })).toBeNull()
+  })
+
+  it('knows which items it draws', () => {
+    const motion = motionOf([0, 0.01])
+    expect(hasStabilisation({ type: 'video', stabilisation: { level: 'smooth', motion } })).toBe(
+      true,
+    )
+    expect(hasStabilisation({ type: 'image', stabilisation: { level: 'smooth', motion } })).toBe(
+      false,
+    )
+    expect(hasStabilisation({ type: 'video' })).toBe(false)
+  })
+
+  it('writes the same correction as a CSS transform about the box centre', () => {
+    expect(stabilisationCssTransform(IDENTITY_CORRECTION)).toBeUndefined()
+    expect(stabilisationCssTransform({ tx: 0.01, ty: -0.02, rotation: 0.003, scale: 1.07 })).toBe(
+      'translate(1%, -2%) rotate(0.003rad) scale(1.07)',
+    )
+  })
+})
diff --git a/src/shared/utils/stabilisation.ts b/src/shared/utils/stabilisation.ts
new file mode 100644
--- /dev/null
+++ b/src/shared/utils/stabilisation.ts
@@ -0,0 +1,364 @@
+/**
+ * Stabilise (FL-638): turning a clip's measured camera path into the correction drawn on each frame.
+ *
+ * The server measures the camera path once (`stabilisation.motion`: the cumulative shift, as fractions
+ * of the frame, and turn, in radians, of the picture at a fixed sample rate through the clip's source).
+ * Each level smooths that path; the correction at a source time is the smoothed path minus the
+ * measured one, so the picture follows the smooth path instead of the shaky one. The picture is then
+ * scaled up by the level's crop so the moving edges stay outside the frame; where a correction would
+ * still uncover an edge, it is reduced just enough that the frame stays covered. There is no edge
+ * fill. Preview and export both draw through `stabilisationAt`, so they show the same correction.
+ */
+
+import type {
+  StabilisationLevel,
+  StabilisationMotion,
+  VideoStabilisation,
+} from '@/types/stabilisation'
+
+export type { StabilisationLevel, StabilisationMotion, VideoStabilisation }
+
+export interface StabilisationLevelSpec {
+  /** Percent the picture is cropped in (scaled up) to hide the moving edges. */
+  crop: number
+  /** Gaussian smoothing of the camera path, in seconds; Infinity holds it still. */
+  sigmaSeconds: number
+}
+
+export const STABILISATION_LEVELS: Readonly<Record<StabilisationLevel, StabilisationLevelSpec>> = {
+  gentle: { crop: 4, sigmaSeconds: 0.33 },
+  smooth: { crop: 7, sigmaSeconds: 1 },
+  locked: { crop: 12, sigmaSeconds: Number.POSITIVE_INFINITY },
+}
+
+export const STABILISATION_LEVEL_IDS: readonly StabilisationLevel[] = ['gentle', 'smooth', 'locked']
+
+export function isStabilisationLevel(value: unknown): value is StabilisationLevel {
+  return value === 'gentle' || value === 'smooth' || value === 'locked'
+}
+
+export function stabilisationCrop(level: StabilisationLevel): number {
+  return STABILISATION_LEVELS[level].crop
+}
+
+/** The correction for one frame: shift as fractions of the media rectangle, turn in radians, scale. */
+export interface StabilisationCorrection {
+  tx: number
+  ty: number
+  rotation: number
+  scale: number
+}
+
+export const IDENTITY_CORRECTION: StabilisationCorrection = Object.freeze({
+  tx: 0,
+  ty: 0,
+  rotation: 0,
+  scale: 1,
+})
+
+const MAX_SAMPLES = 30 * 60 * 10 + 30 * 8
+
+function decodeFloat32(base64: string): Float32Array {
+  const binary = atob(base64)
+  const bytes = new Uint8Array(binary.length)
+  for (let index = 0; index < binary.length; index += 1) bytes[index] = binary.charCodeAt(index)
+  const view = new DataView(bytes.buffer)
+  const values = new Float32Array(Math.floor(bytes.length / 4))
+  for (let index = 0; index < values.length; index += 1)
+    values[index] = view.getFloat32(index * 4, true)
+  return values
+}
+
+/** A motion record this engine can draw: well-formed, finite and of a sane size; null otherwise. */
+export function readStabilisationMotion(
+  motion: unknown,
+): { x: Float32Array; y: Float32Array; a: Float32Array } | null {
+  if (!motion || typeof motion !== 'object') return null
+  const value = motion as Partial<StabilisationMotion>
+  if (value.version !== 1) return null
+  if (!(typeof value.rate === 'number' && value.rate > 0 && value.rate <= 240)) return null
+  if (!(typeof value.start === 'number' && Number.isFinite(value.start) && value.start >= 0))
+    return null
+  if (!(Number.isSafeInteger(value.count) && value.count! >= 1 && value.count! <= MAX_SAMPLES))
+    return null
+  if (typeof value.x !== 'string' || typeof value.y !== 'string' || typeof value.a !== 'string')
+    return null
+  try {
+    const x = decodeFloat32(value.x)
+    const y = decodeFloat32(value.y)
+    const a = decodeFloat32(value.a)
+    if (x.length !== value.count || y.length !== value.count || a.length !== value.count)
+      return null
+    for (const path of [x, y, a]) {
+      for (const sample of path) if (!Number.isFinite(sample)) return null
+    }
+    return { x, y, a }
+  } catch {
+    return null
+  }
+}
+
+/**
+ * Gaussian smoothing of a sampled path. The kernel is cut at three sigma and renormalised at the ends,
+ * so the smoothed path starts and ends on the measured one's local average rather than pulling to zero.
+ * An infinite sigma holds the path at its mean (a locked-off camera).
+ */
+export function smoothPath(values: ArrayLike<number>, sigmaSamples: number): Float64Array {
+  const count = values.length
+  const out = new Float64Array(count)
+  if (count === 0) return out
+  if (!Number.isFinite(sigmaSamples)) {
+    let sum = 0
+    for (let index = 0; index < count; index += 1) sum += values[index]!
+    out.fill(sum / count)
+    return out
+  }
+  if (sigmaSamples <= 0) {
+    for (let index = 0; index < count; index += 1) out[index] = values[index]!
+    return out
+  }
+  const radius = Math.max(1, Math.ceil(3 * sigmaSamples))
+  const kernel = new Float64Array(2 * radius + 1)
+  for (let offset = -radius; offset <= radius; offset += 1) {
+    kernel[offset + radius] = Math.exp(-(offset * offset) / (2 * sigmaSamples * sigmaSamples))
+  }
+  for (let index = 0; index < count; index += 1) {
+    let sum = 0
+    let weight = 0
+    const from = Math.max(0, index - radius)
+    const to = Math.min(count - 1, index + radius)
+    for (let sample = from; sample <= to; sample += 1) {
+      const w = kernel[sample - index + radius]!
+      sum += w * values[sample]!
+      weight += w
+    }
+    out[index] = sum / weight
+  }
+  return out
+}
+
+/**
+ * Whether the picture, scaled by `scale`, turned by `rotation` and moved by (`tx`, `ty`) about its
+ * centre, still covers its own frame. Shifts are fractions of the frame; the frame is `aspect` wide
+ * and 1 high. A frame corner c is covered when R(-rotation)(c - t) / scale lies inside the frame.
+ */
+export function coversFrame(correction: StabilisationCorrection, aspect: number): boolean {
+  const halfWidth = aspect / 2
+  const halfHeight = 0.5
+  const cos = Math.cos(-correction.rotation)
+  const sin = Math.sin(-correction.rotation)
+  const tx = correction.tx * aspect
+  const ty = correction.ty
+  const epsilon = 1e-9
+  for (const [cx, cy] of [
+    [-halfWidth, -halfHeight],
+    [halfWidth, -halfHeight],
+    [halfWidth, halfHeight],
+    [-halfWidth, halfHeight],
+  ] as const) {
+    const px = cx - tx
+    const py = cy - ty
+    const qx = (cos * px - sin * py) / correction.scale
+    const qy = (sin * px + cos * py) / correction.scale
+    if (Math.abs(qx) > halfWidth + epsilon || Math.abs(qy) > halfHeight + epsilon) return false
+  }
+  return true
+}
+
+/**
+ * Reduce a correction's shift and turn by the least factor that keeps the frame covered at its scale.
+ * The covered set is convex in the shift for a fixed turn and shrinks as the turn grows, so halving
+ * the interval finds the largest such factor.
+ */
+export function fitCorrectionToCrop(
+  correction: StabilisationCorrection,
+  aspect: number,
+): StabilisationCorrection {
+  if (coversFrame(correction, aspect)) return correction
+  const scaled = (factor: number): StabilisationCorrection => ({
+    tx: correction.tx * factor,
+    ty: correction.ty * factor,
+    rotation: correction.rotation * factor,
+    scale: correction.scale,
+  })
+  let low = 0
+  let high = 1
+  for (let step = 0; step < 24; step += 1) {
+    const middle = (low + high) / 2
+    if (coversFrame(scaled(middle), aspect)) low = middle
+    else high = middle
+  }
+  return scaled(low)
+}
+
+interface CorrectionPath {
+  x: Float64Array
+  y: Float64Array
+  a: Float64Array
+}
+
+type DecodedMotion = {
+  x: Float32Array
+  y: Float32Array
+  a: Float32Array
+  levels: Map<StabilisationLevel, CorrectionPath>
+} | null
+
+const decodedByMotion = new WeakMap<object, DecodedMotion>()
+/** Undo snapshots and project reloads copy items; the path text identifies the same analysis. */
+const decodedByPath = new Map<string, DecodedMotion>()
+const PATH_CACHE_LIMIT = 16
+
+function decoded(motion: StabilisationMotion): DecodedMotion {
+  const byObject = decodedByMotion.get(motion)
+  if (byObject !== undefined) return byObject
+  const key = `${motion.rate}|${motion.start}|${motion.count}|${motion.x}|${motion.y}|${motion.a}`
+  let value = decodedByPath.get(key)
+  if (value === undefined) {
+    const read = readStabilisationMotion(motion)
+    value = read ? { ...read, levels: new Map() } : null
+    if (decodedByPath.size >= PATH_CACHE_LIMIT)
+      decodedByPath.delete(decodedByPath.keys().next().value!)
+    decodedByPath.set(key, value)
+  }
+  decodedByMotion.set(motion, value)
+  return value
+}
+
+/** The per-sample correction (smoothed minus measured path) of one level. */
+export function correctionPath(
+  motion: StabilisationMotion,
+  level: StabilisationLevel,
+): CorrectionPath | null {
+  const path = decoded(motion)
+  if (!path) return null
+  const cached = path.levels.get(level)
+  if (cached) return cached
+  const sigma = STABILISATION_LEVELS[level].sigmaSeconds * motion.rate
+  const correction = (measured: Float32Array) => {
+    const smooth = smoothPath(measured, sigma)
+    for (let index = 0; index < smooth.length; index += 1) smooth[index]! -= measured[index]!
+    return smooth
+  }
+  const result = { x: correction(path.x), y: correction(path.y), a: correction(path.a) }
+  path.levels.set(level, result)
+  return result
+}
+
+/**
+ * The correction drawn at a source time, for a picture of `aspect` (width / height): the level's
+ * correction interpolated between samples (held at the ends of the analysed range), scaled up by the
+ * level's crop and reduced if needed so the frame stays covered. Identity when there is nothing to draw.
+ */
+export function stabilisationAt(
+  stabilisation: VideoStabilisation | undefined,
+  sourceSeconds: number,
+  aspect: number,
+): StabilisationCorrection {
+  if (
+    !stabilisation ||
+    !isStabilisationLevel(stabilisation.level) ||
+    !Number.isFinite(sourceSeconds)
+  ) {
+    return IDENTITY_CORRECTION
+  }
+  const path = correctionPath(stabilisation.motion, stabilisation.level)
+  if (!path) return IDENTITY_CORRECTION
+  const position = Math.min(
+    path.x.length - 1,
+    Math.max(0, (sourceSeconds - stabilisation.motion.start) * stabilisation.motion.rate),
+  )
+  const index = Math.floor(position)
+  const next = Math.min(path.x.length - 1, index + 1)
+  const fraction = position - index
+  const at = (values: Float64Array) => values[index]! + (values[next]! - values[index]!) * fraction
+  const safeAspect = Number.isFinite(aspect) && aspect > 0 ? aspect : 16 / 9
+  return fitCorrectionToCrop(
+    {
+      tx: at(path.x),
+      ty: at(path.y),
+      rotation: at(path.a),
+      scale: 1 + STABILISATION_LEVELS[stabilisation.level].crop / 100,
+    },
+    safeAspect,
+  )
+}
+
+/** Whether an item carries a stabilisation this engine draws. */
+export function hasStabilisation(item: { type: string; stabilisation?: unknown }): boolean {
+  if (item.type !== 'video' || !item.stabilisation || typeof item.stabilisation !== 'object')
+    return false
+  const value = item.stabilisation as Partial<VideoStabilisation>
+  return isStabilisationLevel(value.level) && !!value.motion && decoded(value.motion) !== null
+}
+
+/** The CSS transform for a correction on a box whose own centre is the transform origin. */
+export function stabilisationCssTransform(correction: StabilisationCorrection): string | undefined {
+  if (correction === IDENTITY_CORRECTION) return undefined
+  return `translate(${correction.tx * 100}%, ${correction.ty * 100}%) rotate(${correction.rotation}rad) scale(${correction.scale})`
+}
+
+/**
+ * Apply a correction to a 2D context, about the centre of `rect` (the media's drawn rectangle), after
+ * clipping to `clip`. Matches `stabilisationCssTransform` on a box of `rect`'s size.
+ */
+export function applyStabilisationToContext(
+  ctx: Pick<
+    CanvasRenderingContext2D,
+    'beginPath' | 'rect' | 'clip' | 'translate' | 'rotate' | 'scale'
+  >,
+  correction: StabilisationCorrection,
+  rect: { x: number; y: number; width: number; height: number },
+  clip: { x: number; y: number; width: number; height: number },
+): void {
+  ctx.beginPath()
+  ctx.rect(clip.x, clip.y, clip.width, clip.height)
+  ctx.clip()
+  const centreX = rect.x + rect.width / 2
+  const centreY = rect.y + rect.height / 2
+  ctx.translate(centreX + correction.tx * rect.width, centreY + correction.ty * rect.height)
+  ctx.rotate(correction.rotation)
+  ctx.scale(correction.scale, correction.scale)
+  ctx.translate(-centreX, -centreY)
+}
+
+/** The rectangle two rectangles share (empty when they do not meet). */
+export function intersectRect(
+  a: { x: number; y: number; width: number; height: number },
+  b: { x: number; y: number; width: number; height: number },
+): { x: number; y: number; width: number; height: number } {
+  const x = Math.max(a.x, b.x)
+  const y = Math.max(a.y, b.y)
+  const right = Math.min(a.x + a.width, b.x + b.width)
+  const bottom = Math.min(a.y + a.height, b.y + b.height)
+  return { x, y, width: Math.max(0, right - x), height: Math.max(0, bottom - y) }
+}
+
+/**
+ * The source second a clip shows at a frame counted from its start, for the live (DOM) preview.
+ * Export and the canvas preview use the render span's exact resolver, which also follows speed ramp
+ * spans; this is the same arithmetic for a clip played at one speed, forwards or reversed.
+ */
+export function stabilisationSourceSeconds(
+  item: {
+    sourceStart?: number
+    trimStart?: number
+    sourceEnd?: number
+    sourceFps?: number
+    speed?: number
+    isReversed?: boolean
+    durationInFrames: number
+  },
+  localFrame: number,
+  fps: number,
+): number {
+  const sourceFps = item.sourceFps ?? fps
+  const speed = item.speed ?? 1
+  const sourceStart = item.sourceStart ?? item.trimStart ?? 0
+  if (item.isReversed) {
+    const sourceEnd =
+      item.sourceEnd ?? sourceStart + (item.durationInFrames * speed * sourceFps) / fps
+    return Math.max(0, (sourceEnd - localFrame * speed * (sourceFps / fps) - 1) / sourceFps)
+  }
+  return Math.max(0, sourceStart / sourceFps + (localFrame / fps) * speed)
+}
