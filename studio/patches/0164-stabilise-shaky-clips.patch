+    fireEvent.click(screen.getByRole('radio', { name: 'editor.stabilise.level.locked' }))
+    expect(actions.setStabilisationLevel).toHaveBeenCalledWith(item.id, 'locked')
+    expect(analyse).not.toHaveBeenCalled()
+    fireEvent.click(screen.getByRole('button', { name: 'editor.stabilise.turnOff' }))
+    expect(actions.removeStabilisation).toHaveBeenCalledWith(item.id)
+    expect(screen.queryByRole('button', { name: 'editor.stabilise.start' })).toBeNull()
+  })
+
+  it('says why when the analysis fails, and nothing is applied', async () => {
+    analyse.mockRejectedValue(new Error('The clip has no picture to stabilise'))
+    render(<StabiliseSection item={clip()} />)
