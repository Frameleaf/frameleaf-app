+    expect(actions.applyStabilisation).not.toHaveBeenCalled()
+    expect(toast.error).toHaveBeenCalledWith(
+      'editor.stabilise.failedReason {"reason":"The clip has no picture to stabilise"}',
+    )
+  })
+})
