+    expect(tx! / 100).toBeCloseTo(correction.tx, 12)
+    expect(ty! / 100).toBeCloseTo(correction.ty, 12)
+    expect(rotation).toBeCloseTo(correction.rotation, 12)
+    expect(scale).toBeCloseTo(correction.scale, 12)
+  })
+
+  it('clips a smaller clip to its own box and moves it about its own centre', async () => {
+    const small = { ...transform, x: 200, y: -100, width: 640, height: 360 }
+    await renderItem(
+      new RecordingContext() as never,
+      clip({ stabilisation: { level: 'locked', motion }, transform: small }),
+      small,
+      20,
+      rctx('export'),
+    )
+    const [draw] = drawn
+    expect(draw!.clip).toEqual([1160 - 320, 440 - 180, 640, 360])
+    const [cx] = apply(draw!.matrix, 1160, 440)
+    const correction = stabilisationAt({ level: 'locked', motion }, 25 / 30 + 1e-4 / 30, 16 / 9)
+    expect(cx).toBeCloseTo(1160 + correction.tx * 640, 6)
+  })
+})
