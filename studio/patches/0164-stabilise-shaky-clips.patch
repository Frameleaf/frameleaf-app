+import type { VideoItem } from '@/types/timeline'
+import type { StabilisationLevel, StabilisationMotion } from '@/types/stabilisation'
+import { useItemsStore } from '../../items-store'
+import { useTimelineSettingsStore } from '../../timeline-settings-store'
+import { execute } from '../shared'
+import { hasLockedEditParticipants } from '../linked-edit'
+import { isStabilisationLevel, readStabilisationMotion } from '@/shared/utils/stabilisation'
+
+export type StabiliseRefusal =
+  | 'not-found'
+  | 'not-video'
+  | 'locked'
+  | 'invalid-motion'
+  | 'invalid-level'
+  | 'not-stabilised'
+
+export type StabiliseOutcome = { ok: true } | { ok: false; reason: StabiliseRefusal }
+
+function videoItem(itemId: string): VideoItem | StabiliseRefusal {
+  const item = useItemsStore.getState().itemById[itemId]
+  if (!item) return 'not-found'
+  if (item.type !== 'video') return 'not-video'
+  if (hasLockedEditParticipants([item])) return 'locked'
+  return item
+}
+
+/** Stabilise a video clip with a measured camera path at a smoothness, in one undo step. */
+export function applyStabilisation(
+  itemId: string,
+  motion: StabilisationMotion,
+  level: StabilisationLevel,
+): StabiliseOutcome {
+  const item = videoItem(itemId)
+  if (typeof item === 'string') return { ok: false, reason: item }
+  if (!isStabilisationLevel(level)) return { ok: false, reason: 'invalid-level' }
+  if (!readStabilisationMotion(motion)) return { ok: false, reason: 'invalid-motion' }
+  execute(
+    'APPLY_STABILISATION',
+    () => {
+      useItemsStore
+        .getState()
+        ._updateItem(itemId, { stabilisation: { level, motion } } as Partial<VideoItem>)
+      useTimelineSettingsStore.getState().markDirty()
+    },
+    { itemId, level },
+  )
+  return { ok: true }
+}
+
+/** Change a stabilised clip's smoothness, in one undo step. The measured path is reused as it is. */
+export function setStabilisationLevel(itemId: string, level: StabilisationLevel): StabiliseOutcome {
+  const item = videoItem(itemId)
+  if (typeof item === 'string') return { ok: false, reason: item }
+  if (!isStabilisationLevel(level)) return { ok: false, reason: 'invalid-level' }
+  const current = item.stabilisation
+  if (!current) return { ok: false, reason: 'not-stabilised' }
+  if (current.level === level) return { ok: true }
+  execute(
+    'SET_STABILISATION_LEVEL',
+    () => {
+      useItemsStore
+        .getState()
+        ._updateItem(itemId, { stabilisation: { ...current, level } } as Partial<VideoItem>)
+      useTimelineSettingsStore.getState().markDirty()
+    },
+    { itemId, level },
+  )
+  return { ok: true }
+}
+
+/** Turn stabilisation off, in one undo step. The source was never changed, so nothing else changes. */
+export function removeStabilisation(itemId: string): StabiliseOutcome {
+  const item = videoItem(itemId)
+  if (typeof item === 'string') return { ok: false, reason: item }
+  if (!item.stabilisation) return { ok: true }
+  execute(
+    'REMOVE_STABILISATION',
+    () => {
+      useItemsStore
+        .getState()
+        ._updateItem(itemId, { stabilisation: undefined } as Partial<VideoItem>)
+      useTimelineSettingsStore.getState().markDirty()
+    },
+    { itemId },
+  )
+  return { ok: true }
+}
