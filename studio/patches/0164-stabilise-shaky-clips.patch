+  }) as VideoItem
+
+const rctx = (renderMode: 'preview' | 'export') =>
+  ({
+    fps: 30,
+    renderMode,
+    canvasSettings: { width: 1920, height: 1080, fps: 30 },
+    keyframesMap: new Map(),
+    videoExtractors: new Map(),
+    videoElements: new Map(),
+    useMediabunny: new Set(),
+    mediabunnyDisabledItems: new Set(),
+    mediabunnyFailureCountByItem: new Map(),
+    scrubbingCache: null,
+  }) as unknown as ItemRenderContext
+
+/** Where a point of the media lands under a context matrix. */
+const apply = (m: number[], x: number, y: number): [number, number] => [
+  m[0]! * x + m[2]! * y + m[4]!,
+  m[1]! * x + m[3]! * y + m[5]!,
+]
+
+describe('renderItem with Stabilise', () => {
+  beforeEach(() => {
+    drawn.length = 0
+  })
+
+  it('draws an unstabilised clip untouched', async () => {
+    await renderItem(new RecordingContext() as never, clip(), transform, 20, rctx('export'))
+    expect(drawn).toEqual([{ matrix: [1, 0, 0, 1, 0, 0], clip: null }])
+  })
+
+  it('draws a stabilised clip through the correction at its source time, clipped to the media, in export and preview', async () => {
+    for (const mode of ['export', 'preview'] as const) {
+      drawn.length = 0
+      const ctx = new RecordingContext()
+      // Timeline frame 20 is 10 frames into the clip: source frame 25, source second 25/30.
+      await renderItem(
+        ctx as never,
+        clip({ stabilisation: { level: 'smooth', motion } }),
+        transform,
+        20,
+        rctx(mode),
+      )
+      const [draw] = drawn
+      expect(draw!.clip).toEqual([0, 0, 1920, 1080])
+      const correction = stabilisationAt({ level: 'smooth', motion }, 25 / 30 + 1e-4 / 30, 16 / 9)
+      expect(correction.scale).toBeCloseTo(1.07, 9)
+      // The media centre moves by the correction's shift; a corner turns and scales about it.
+      const [cx, cy] = apply(draw!.matrix, 960, 540)
+      expect(cx).toBeCloseTo(960 + correction.tx * 1920, 6)
