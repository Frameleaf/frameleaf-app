+  method: 'block-similarity-v1',
+  rate: 30,
+  start: 0,
+  count: 60,
+  width: 160,
+  height: 90,
+  x: encode(shake),
+  y: encode(shake.map((value) => -value / 2)),
+  a: encode(shake.map((value) => value / 10)),
+  found: 1,
+}
+
+const transform: ItemTransform = {
+  x: 0,
+  y: 0,
+  width: 1920,
+  height: 1080,
+  rotation: 0,
+  opacity: 1,
+  cornerRadius: 0,
+}
+
+const clip = (extra: Partial<VideoItem> = {}) =>
+  ({
+    id: 'clip-1',
+    type: 'video',
+    src: 'file.mp4',
+    mediaId: 'media-1',
+    from: 10,
+    durationInFrames: 40,
