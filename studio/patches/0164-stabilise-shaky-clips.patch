+const actions = vi.hoisted(() => ({
+  applyStabilisation: vi.fn(() => ({ ok: true })),
+  removeStabilisation: vi.fn(() => ({ ok: true })),
+  setStabilisationLevel: vi.fn(() => ({ ok: true })),
+}))
+const toast = vi.hoisted(() => ({ success: vi.fn(), warning: vi.fn(), error: vi.fn() }))
+
+vi.mock('react-i18next', () => ({
+  useTranslation: () => ({
+    t: (key: string, values?: Record<string, unknown>) =>
+      values ? `${key} ${JSON.stringify(values)}` : key,
+  }),
+}))
+vi.mock('sonner', () => ({ toast }))
+vi.mock('./stabilise-service', () => ({
+  stabiliseAvailable: true,
+  stabiliseAnalysis: { analyse },
+  StabiliseUnavailableError: class extends Error {},
+}))
+vi.mock('@/features/editor/deps/timeline-store', () => actions)
+vi.mock('@/features/editor/deps/media-library', () => ({
+  useMediaLibraryStore: (select: (state: unknown) => unknown) => select({ mediaById: {} }),
+}))
+
+const { StabiliseSection } = await import('./stabilise-section')
+
+const motion: StabilisationMotion = {
+  version: 1,
+  method: 'block-similarity-v1',
+  rate: 30,
+  start: 0,
+  count: 2,
+  width: 160,
+  height: 90,
+  x: 'AAAAAArXIzw=',
+  y: 'AAAAAAAAAAA=',
+  a: 'AAAAAAAAAAA=',
+  found: 1,
+}
+
+const clip = (extra: Partial<VideoItem> = {}): VideoItem =>
+  ({
+    id: `clip-${Math.random()}`,
+    type: 'video',
+    trackId: 't1',
+    from: 0,
+    durationInFrames: 90,
+    label: 'Walk',
+    src: 'blob:v',
+    mediaId: 'm1',
+    ...extra,
+  }) as VideoItem
+
+describe('StabiliseSection', () => {
+  beforeEach(() => {
+    analyse.mockReset()
+    for (const action of Object.values(actions)) action.mockClear()
+    for (const action of Object.values(toast)) action.mockClear()
+  })
+
+  it('shows the before and after preview, the three smoothness levels and Stabilise clip', () => {
+    render(<StabiliseSection item={clip()} />)
+    expect(screen.getByRole('region', { name: 'editor.stabilise.title' })).toBeTruthy()
+    expect(screen.getByText('editor.stabilise.original')).toBeTruthy()
+    expect(screen.getByText('editor.stabilise.stabilisedCrop {"crop":7}')).toBeTruthy()
+    const levels = screen.getAllByRole('radio')
+    expect(levels.map((level) => level.textContent)).toEqual([
+      'editor.stabilise.level.gentle',
+      'editor.stabilise.level.smooth',
+      'editor.stabilise.level.locked',
+    ])
+    expect(
+      screen
+        .getByRole('radio', { name: 'editor.stabilise.level.smooth' })
+        .getAttribute('aria-checked'),
+    ).toBe('true')
+    expect(screen.getByText(/editor\.stabilise\.note\.smooth/)).toBeTruthy()
+    expect(screen.getByRole('button', { name: 'editor.stabilise.start' })).toBeTruthy()
+    expect(screen.getByText('editor.stabilise.whereItRuns')).toBeTruthy()
+  })
+
+  it('analyses once with progress, then stabilises the clip at the chosen level', async () => {
+    let finish!: (value: StabilisationMotion) => void
+    let report!: (progress: number) => void
+    analyse.mockImplementation(
+      (_id: string, _signal: AbortSignal, onProgress: (progress: number) => void) => {
+        report = onProgress
+        return new Promise((resolve) => {
+          finish = resolve
