+// @vitest-environment node
+
+import { describe, expect, it, vi, beforeEach } from 'vite-plus/test'
+import type { VideoItem } from '@/types/timeline'
+import type { StabilisationMotion } from '@/types/stabilisation'
+import { stabilisationAt, stabilisationCssTransform } from '@/shared/utils/stabilisation'
+import type { ItemRenderContext, ItemTransform } from './types'
+
+const drawn: Array<{ matrix: number[]; clip: number[] | null }> = []
+
+vi.mock('./video', () => ({
+  renderVideoItem: vi.fn(async (ctx: RecordingContext) => {
+    drawn.push({ matrix: [...ctx.matrix], clip: ctx.clipRect ? [...ctx.clipRect] : null })
+    return true
+  }),
+}))
+
+const { renderItem } = await import('./render-item')
+
+/** A 2D context that keeps its current transform (a, b, c, d, e, f) and last clip rectangle. */
+class RecordingContext {
+  matrix = [1, 0, 0, 1, 0, 0]
+  clipRect: number[] | null = null
+  private pendingRect: number[] | null = null
+  private stack: Array<{ matrix: number[]; clipRect: number[] | null }> = []
+  globalAlpha = 1
+  globalCompositeOperation = 'source-over'
+  save() {
+    this.stack.push({ matrix: [...this.matrix], clipRect: this.clipRect })
+  }
+  restore() {
+    const state = this.stack.pop()
+    if (state) Object.assign(this, state)
+  }
+  private multiply(a: number, b: number, c: number, d: number, e: number, f: number) {
+    const [m0, m1, m2, m3, m4, m5] = this.matrix as [number, number, number, number, number, number]
+    this.matrix = [
+      m0 * a + m2 * b,
+      m1 * a + m3 * b,
+      m0 * c + m2 * d,
+      m1 * c + m3 * d,
+      m0 * e + m2 * f + m4,
+      m1 * e + m3 * f + m5,
+    ]
+  }
+  translate(x: number, y: number) {
+    this.multiply(1, 0, 0, 1, x, y)
+  }
+  rotate(angle: number) {
+    this.multiply(Math.cos(angle), Math.sin(angle), -Math.sin(angle), Math.cos(angle), 0, 0)
+  }
+  scale(x: number, y: number) {
+    this.multiply(x, 0, 0, y, 0, 0)
+  }
+  beginPath() {
+    this.pendingRect = null
+  }
+  rect(x: number, y: number, width: number, height: number) {
+    this.pendingRect = [x, y, width, height]
+  }
+  roundRect() {}
+  clip() {
+    this.clipRect = this.pendingRect
+  }
+}
+
+const encode = (values: number[]) => {
+  const bytes = new Uint8Array(values.length * 4)
+  const view = new DataView(bytes.buffer)
+  values.forEach((value, index) => view.setFloat32(index * 4, value, true))
+  return btoa(String.fromCharCode(...bytes))
+}
