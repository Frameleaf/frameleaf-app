+import { render } from '@testing-library/react'
+import { describe, expect, it } from 'vite-plus/test'
+import { ContainedMediaLayout } from './contained-media-layout'
+
+describe('ContainedMediaLayout with Stabilise', () => {
+  it('leaves unstabilised media as before', () => {
+    const { container } = render(
+      <ContainedMediaLayout
+        sourceWidth={1920}
+        sourceHeight={1080}
+        containerWidth={1920}
+        containerHeight={1080}
+      >
+        <span />
+      </ContainedMediaLayout>,
+    )
+    const outer = container.firstElementChild as HTMLElement
+    expect(outer.style.clipPath).toBe('')
+    expect((outer.firstElementChild as HTMLElement).style.transform).toBe('')
+  })
+
+  it('moves the media about its centre and clips it to where it showed', () => {
+    const { container } = render(
+      <ContainedMediaLayout
+        sourceWidth={1920}
+        sourceHeight={1080}
+        containerWidth={1920}
+        containerHeight={1440}
+        stabilisation={{ tx: 0.01, ty: -0.02, rotation: 0.003, scale: 1.07 }}
+      >
+        <span />
+      </ContainedMediaLayout>,
+    )
+    const outer = container.firstElementChild as HTMLElement
+    // Letterboxed 16:9 in a 4:3 box: the media shows from 180 to 1260 of 1440.
+    expect(outer.style.clipPath).toBe('inset(12.5% 0% 12.5% 0%)')
+    const media = outer.firstElementChild as HTMLElement
+    expect(media.style.transform).toBe('translate(1%, -2%) rotate(0.003rad) scale(1.07)')
+    expect(media.style.transformOrigin).toBe('50% 50%')
+  })
+})
