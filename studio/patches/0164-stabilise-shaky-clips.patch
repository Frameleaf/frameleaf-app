+    fireEvent.click(screen.getByRole('button', { name: 'editor.stabilise.start' }))
+    expect(analyse).toHaveBeenCalledTimes(1)
+    expect(screen.getByRole('progressbar', { name: 'editor.stabilise.analysing' })).toBeTruthy()
+    expect(
+      screen.getByRole('button', { name: 'editor.stabilise.start' }).hasAttribute('disabled'),
