+import { useMemo, useState } from 'react'
+import { useTranslation } from 'react-i18next'
+import { Gauge, Plus, Trash2 } from 'lucide-react'
+import { toast } from 'sonner'
+import { Button } from '@/components/ui/button'
+import { Input } from '@/components/ui/input'
+import {
+  applySpeedRamp,
+  previewSpeedRamp,
+  useTimelineStore,
+  MAX_RAMP_SPEED,
+  MIN_RAMP_SPEED,
+  type SpeedRampEasing,
+  type SpeedRampPoint,
+} from '@/features/editor/deps/timeline-store'
+import { useEditorStore } from '@/shared/state/editor'
+import { PropertySection, PropertyRow } from '../components'
+
+const DEFAULT_POINTS: SpeedRampPoint[] = [
+  { position: 0, speed: 1 },
+  { position: 0.5, speed: 0.5 },
+  { position: 1, speed: 1 },
+]
+
+function formatDuration(frames: number, fps: number): string {
+  return `${frames}f (${(frames / fps).toFixed(2)}s)`
+}
+
+/**
+ * Speed ramp editor (FL-597). Points are positions in the clip's source and
+ * speeds; Apply writes the integrated curve as matching constant-speed
+ * segments of the clip and its linked audio in one undoable edit.
+ */
+export function SpeedRampSection({ itemId }: { itemId: string }) {
+  const { t } = useTranslation()
+  const fps = useTimelineStore((s) => s.fps)
+  // Re-evaluate when anything the preview reads changes: clips, tracks (locks), transitions, keyframes, linking.
+  const items = useTimelineStore((s) => s.items)
+  const tracks = useTimelineStore((s) => s.tracks)
+  const transitions = useTimelineStore((s) => s.transitions)
+  const keyframes = useTimelineStore((s) => s.keyframes)
+  const linkedSelection = useEditorStore((s) => s.linkedSelectionEnabled)
+  const [points, setPoints] = useState<SpeedRampPoint[]>(DEFAULT_POINTS)
+  const [easing, setEasing] = useState<SpeedRampEasing>('ease')
+  const [muteLinkedAudio, setMuteLinkedAudio] = useState(false)
+
+  const preview = useMemo(
+    () => previewSpeedRamp(itemId, { points, easing }),
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+    [itemId, points, easing, items, tracks, transitions, keyframes, linkedSelection, fps],
+  )
+
+  const updatePoint = (index: number, change: Partial<SpeedRampPoint>) => {
+    setPoints((current) => current.map((point, i) => (i === index ? { ...point, ...change } : point)))
+  }
+
+  const addPoint = () => {
+    setPoints((current) => {
+      const sorted = [...current].sort((a, b) => a.position - b.position)
+      // Insert in the widest gap so the new point never duplicates a position.
+      let gapIndex = 0
+      for (let i = 1; i < sorted.length - 1; i += 1) {
+        if (sorted[i + 1]!.position - sorted[i]!.position > sorted[gapIndex + 1]!.position - sorted[gapIndex]!.position) {
+          gapIndex = i
+        }
+      }
+      const left = sorted[gapIndex]!
+      const right = sorted[gapIndex + 1]!
+      const position = Math.round(((left.position + right.position) / 2) * 1000) / 1000
+      return [...sorted, { position, speed: (left.speed + right.speed) / 2 }].sort((a, b) => a.position - b.position)
+    })
+  }
+
+  const apply = () => {
+    const refusal = applySpeedRamp(itemId, { points, easing, muteLinkedAudio })
+    if (refusal) {
+      toast.warning(t(`editor.videoSection.speedRamp.refusal.${refusal}`))
+    } else {
+      toast.success(t('editor.videoSection.speedRamp.applied'))
+    }
+  }
+
+  return (
+    <PropertySection title={t('editor.videoSection.speedRamp.title')} icon={Gauge} defaultOpen={false}>
+      {points.map((point, index) => (
+        <PropertyRow key={index} label={t('editor.videoSection.speedRamp.point', { n: index + 1 })}>
+          <div className="flex items-center gap-1 w-full">
+            <Input
+              type="number"
+              aria-label={t('editor.videoSection.speedRamp.position', { n: index + 1 })}
+              className="h-7 min-w-0 flex-1 px-2 text-xs"
+              min={0}
+              max={100}
+              step={1}
+              value={Math.round(point.position * 1000) / 10}
+              onChange={(event) => updatePoint(index, { position: Number(event.target.value) / 100 })}
+            />
+            <span className="text-xs text-muted-foreground">%</span>
+            <Input
+              type="number"
+              aria-label={t('editor.videoSection.speedRamp.speed', { n: index + 1 })}
+              className="h-7 min-w-0 flex-1 px-2 text-xs"
+              min={MIN_RAMP_SPEED}
+              max={MAX_RAMP_SPEED}
+              step={0.05}
+              value={point.speed}
+              onChange={(event) => updatePoint(index, { speed: Number(event.target.value) })}
+            />
+            <span className="text-xs text-muted-foreground">x</span>
+            <Button
+              variant="ghost"
+              size="icon"
+              className="h-7 w-7 flex-shrink-0"
+              disabled={points.length <= 2}
+              onClick={() => setPoints((current) => current.filter((_, i) => i !== index))}
+              title={t('editor.videoSection.speedRamp.removePoint', { n: index + 1 })}
+              aria-label={t('editor.videoSection.speedRamp.removePoint', { n: index + 1 })}
+            >
+              <Trash2 className="w-3.5 h-3.5" />
+            </Button>
+          </div>
+        </PropertyRow>
+      ))}
+
+      <PropertyRow label={t('editor.videoSection.speedRamp.easing')}>
+        <div className="flex items-center gap-1 w-full" role="radiogroup" aria-label={t('editor.videoSection.speedRamp.easing')}>
+          {(['linear', 'ease'] as const).map((value) => (
+            <Button
+              key={value}
+              role="radio"
+              aria-checked={easing === value}
+              variant={easing === value ? 'secondary' : 'ghost'}
+              size="sm"
+              className="h-7 flex-1 text-xs"
+              onClick={() => setEasing(value)}
+            >
+              {t(`editor.videoSection.speedRamp.${value}`)}
+            </Button>
+          ))}
+        </div>
+      </PropertyRow>
+
+      <PropertyRow label={t('editor.videoSection.speedRamp.muteAudio')}>
+        <input
+          type="checkbox"
+          aria-label={t('editor.videoSection.speedRamp.muteAudio')}
+          checked={muteLinkedAudio}
+          onChange={(event) => setMuteLinkedAudio(event.target.checked)}
+        />
+      </PropertyRow>
+
+      <div className="space-y-2 px-1 py-2 text-xs" aria-live="polite">
+        {preview.ok ? (
+          <>
+            <p>
+              {t('editor.videoSection.speedRamp.duration', {
+                from: formatDuration(preview.oldDurationInFrames, fps),
+                to: formatDuration(preview.plan.durationInFrames, fps),
+              })}
+            </p>
+            {preview.captionCount > 0 && (
+              <p>{t('editor.videoSection.speedRamp.captions', { count: preview.captionCount })}</p>
+            )}
+          </>
+        ) : (
+          <p className="text-destructive">{t(`editor.videoSection.speedRamp.refusal.${preview.reason}`)}</p>
+        )}
+        <p className="text-muted-foreground">{t('editor.videoSection.speedRamp.sampling')}</p>
+      </div>
+
+      <div className="flex items-center gap-2 px-1 pb-2">
+        <Button variant="ghost" size="sm" className="h-7 text-xs" onClick={addPoint}>
+          <Plus className="w-3.5 h-3.5 mr-1" />
+          {t('editor.videoSection.speedRamp.addPoint')}
+        </Button>
+        <Button size="sm" className="h-7 flex-1 text-xs" disabled={!preview.ok} onClick={apply}>
+          {t('editor.videoSection.speedRamp.apply')}
+        </Button>
+      </div>
+    </PropertySection>
+  )
+}
