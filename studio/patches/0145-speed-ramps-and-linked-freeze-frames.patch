+import { describe, expect, it } from 'vite-plus/test'
+import { planSpeedRamp, SpeedRampError, toSourceSegments, type SpeedRampPoint } from './speed-ramp'
+import { timelineToSourceFrames } from './source-calculations'
+
+const constant = (speed: number): SpeedRampPoint[] => [
+  { position: 0, speed },
+  { position: 1, speed },
+]
+
+/** Source frame the engine shows at a timeline offset inside the ramped segments. */
+function shownSourceFrame(
+  segments: ReturnType<typeof toSourceSegments>[number],
+  offset: number,
+  fps: number,
+  sourceFps: number,
+): number {
+  const segment = segments.find((s) => offset >= s.offset && offset < s.offset + s.durationInFrames)!
+  return segment.sourceStart + timelineToSourceFrames(offset - segment.offset, segment.speed, fps, sourceFps)
+}
+
+describe('planSpeedRamp', () => {
+  it.each([0.25, 1, 4])('reproduces constant %sx timing', (speed) => {
+    const plan = planSpeedRamp({ sourceSeconds: 4, fps: 30, points: constant(speed), easing: 'linear' })
+    expect(plan.durationInFrames).toBe(Math.round((4 / speed) * 30))
+    const [segments] = toSourceSegments(plan, [{ sourceStart: 0, sourceEnd: 120, sourceFps: 30 }], 30)
+    for (let frame = 0; frame < plan.durationInFrames; frame += 1) {
+      expect(Math.abs(shownSourceFrame(segments!, frame, 30, 30) - frame * speed)).toBeLessThanOrEqual(1)
+    }
+  })
+
+  it('places a linear ramp at the integrated source positions without drift', () => {
+    // Speed 1 -> 2 linearly over source position p in [0, 1] of 10 s: v(s) = 1 + s / 10.
+    // Timeline time t(s) = 10 ln(1 + s / 10), so s(t) = 10 (e^(t / 10) - 1).
+    const fps = 30
+    const plan = planSpeedRamp({
+      sourceSeconds: 10,
+      fps,
+      points: [{ position: 0, speed: 1 }, { position: 1, speed: 2 }],
+      easing: 'linear',
+    })
+    expect(plan.durationInFrames).toBe(Math.round(10 * Math.log(2) * fps))
+    const [segments] = toSourceSegments(plan, [{ sourceStart: 0, sourceEnd: 300, sourceFps: fps }], fps)
+    const scale = plan.durationInFrames / fps / (10 * Math.log(2))
+    for (let frame = 0; frame < plan.durationInFrames; frame += 1) {
+      const expected = 10 * (Math.exp(frame / fps / scale / 10) - 1) * fps
+      // Within one output frame of source at the fastest speed (2 source frames).
+      expect(Math.abs(shownSourceFrame(segments!, frame, fps, fps) - expected)).toBeLessThanOrEqual(2)
+    }
+    // The last segment ends exactly on the source end.
+    expect(segments!.at(-1)!.sourceEnd).toBe(300)
+  })
+
+  it.each([24000 / 1001, 30000 / 1001])('keeps segments contiguous and monotonic at %s fps', (fps) => {
+    const plan = planSpeedRamp({
+      sourceSeconds: 7.3,
+      fps,
+      points: [{ position: 0, speed: 4 }, { position: 0.4, speed: 0.25 }, { position: 1, speed: 1.5 }],
+      easing: 'ease',
+    })
+    const [video, audio] = toSourceSegments(plan, [
+      { sourceStart: 12, sourceEnd: 12 + Math.round(7.3 * 25), sourceFps: 25 },
+      { sourceStart: 18, sourceEnd: 18 + Math.round(7.3 * 37.5), sourceFps: 37.5 },
+    ], fps)
+    for (const segments of [video!, audio!]) {
+      expect(segments[0]!.offset).toBe(0)
+      expect(segments.reduce((sum, s) => sum + s.durationInFrames, 0)).toBe(plan.durationInFrames)
+      for (const [index, segment] of segments.entries()) {
+        expect(segment.sourceEnd).toBeGreaterThan(segment.sourceStart)
+        if (index > 0) {
+          expect(segment.sourceStart).toBe(segments[index - 1]!.sourceEnd)
+          expect(segment.offset).toBe(segments[index - 1]!.offset + segments[index - 1]!.durationInFrames)
+        }
+      }
+    }
+    // Linked participants share every cut.
+    expect(video!.map((s) => s.offset)).toEqual(audio!.map((s) => s.offset))
+  })
+
+  it('maps source positions to timeline offsets and back', () => {
+    const plan = planSpeedRamp({
+      sourceSeconds: 5,
+      fps: 25,
+      points: [{ position: 0, speed: 0.5 }, { position: 1, speed: 3 }],
+      easing: 'ease',
+    })
+    for (const seconds of [0, 0.7, 2.5, 4.9, 5]) {
+      expect(plan.sourceSecondsAt(plan.offsetAt(seconds))).toBeCloseTo(seconds, 3)
+    }
+  })
+
+  it.each([
+    [[{ position: 0, speed: 1 }], 'too-few-points'],
+    [[{ position: 0, speed: 1 }, { position: 0, speed: 2 }], 'invalid-point'],
+    [[{ position: 0, speed: 1 }, { position: 1.2, speed: 2 }], 'invalid-point'],
+    [[{ position: 0, speed: 0 }, { position: 1, speed: 2 }], 'speed-out-of-range'],
+    [[{ position: 0, speed: 1 }, { position: 1, speed: 5 }], 'speed-out-of-range'],
+    [[{ position: 0, speed: Number.NaN }, { position: 1, speed: 1 }], 'speed-out-of-range'],
+  ])('refuses %j', (points, reason) => {
+    expect(() => planSpeedRamp({ sourceSeconds: 1, fps: 30, points, easing: 'linear' }))
+      .toThrowError(new SpeedRampError(reason as SpeedRampError['reason']))
+  })
+})
diff --git a/src/features/timeline/utils/speed-ramp.ts b/src/features/timeline/utils/speed-ramp.ts
new file mode 100644
--- /dev/null
+++ b/src/features/timeline/utils/speed-ramp.ts
@@ -0,0 +1,216 @@
+/**
+ * Speed ramps (FL-597).
+ *
+ * A ramp is a speed curve over a clip's source range. It is applied by
+ * integrating the curve and writing the result as ordinary constant-speed
+ * segments, so preview, export, audio stretching, thumbnails and the native
+ * graph read it without a new timing model. Each segment boundary is placed
+ * from the exact integral, so rounding never accumulates across segments.
+ */
+
+export const MIN_RAMP_SPEED = 0.25
+export const MAX_RAMP_SPEED = 4
+/** Output frames per constant-speed segment. */
+const RAMP_SEGMENT_FRAMES = 6
+
+export type SpeedRampEasing = 'linear' | 'ease'
+
+export interface SpeedRampPoint {
+  /** Position in the clip's source range, 0 (first source frame) to 1 (last). */
+  position: number
+  speed: number
+}
+
+export interface SpeedRampSegment {
+  /** Timeline frames from the start of the ramped clip. */
+  offset: number
+  durationInFrames: number
+  /** Source seconds from the clip's source start. */
+  sourceStartSeconds: number
+  sourceEndSeconds: number
+}
+
+export interface SpeedRampPlan {
+  durationInFrames: number
+  segments: SpeedRampSegment[]
+  /** Source seconds (from source start) shown at a timeline offset in frames. */
+  sourceSecondsAt: (offsetFrames: number) => number
+  /** Timeline offset in frames at which a source position (seconds) is shown. */
+  offsetAt: (sourceSeconds: number) => number
+}
+
+export type SpeedRampCurveRefusal =
+  | 'too-few-points'
+  | 'invalid-point'
+  | 'speed-out-of-range'
+  | 'empty-source'
+
+export class SpeedRampError extends Error {
+  constructor(readonly reason: SpeedRampCurveRefusal) {
+    super(`Speed ramp refused: ${reason}`)
+  }
+}
+
+const TABLE_STEPS = 4096
+
+function validateSpeedRampPoints(points: readonly SpeedRampPoint[]): SpeedRampPoint[] {
+  if (points.length < 2) throw new SpeedRampError('too-few-points')
+  const sorted = [...points].sort((a, b) => a.position - b.position)
+  for (const [index, point] of sorted.entries()) {
+    if (!Number.isFinite(point.position) || point.position < 0 || point.position > 1) {
+      throw new SpeedRampError('invalid-point')
+    }
+    if (index > 0 && point.position === sorted[index - 1]!.position) {
+      throw new SpeedRampError('invalid-point')
+    }
+    if (!Number.isFinite(point.speed) || point.speed < MIN_RAMP_SPEED || point.speed > MAX_RAMP_SPEED) {
+      throw new SpeedRampError('speed-out-of-range')
+    }
+  }
+  return sorted
+}
+
+function speedAt(points: readonly SpeedRampPoint[], easing: SpeedRampEasing, position: number): number {
+  const first = points[0]!
+  const last = points[points.length - 1]!
+  if (position <= first.position) return first.speed
+  if (position >= last.position) return last.speed
+  let index = 1
+  while (points[index]!.position < position) index += 1
+  const left = points[index - 1]!
+  const right = points[index]!
+  const linear = (position - left.position) / (right.position - left.position)
+  const t = easing === 'ease' ? linear * linear * (3 - 2 * linear) : linear
+  return left.speed + (right.speed - left.speed) * t
+}
+
+/**
+ * Plan a ramp over `sourceSeconds` of source for a project at `fps`.
+ * Timeline time is the integral of 1/speed over source time.
+ */
+export function planSpeedRamp(params: {
+  sourceSeconds: number
+  fps: number
+  points: readonly SpeedRampPoint[]
+  easing: SpeedRampEasing
+  segmentFrames?: number
+}): SpeedRampPlan {
+  const { sourceSeconds, fps, easing } = params
+  if (!(sourceSeconds > 0) || !Number.isFinite(sourceSeconds) || !(fps > 0)) {
+    throw new SpeedRampError('empty-source')
+  }
+  const points = validateSpeedRampPoints(params.points)
+  const segmentFrames = Math.max(1, Math.round(params.segmentFrames ?? RAMP_SEGMENT_FRAMES))
+
+  // timeAt[i]: timeline seconds at source position i / TABLE_STEPS (trapezoid on 1/speed).
+  const timeAt = new Float64Array(TABLE_STEPS + 1)
+  const step = sourceSeconds / TABLE_STEPS
+  let previousInverse = 1 / speedAt(points, easing, 0)
+  for (let i = 1; i <= TABLE_STEPS; i += 1) {
+    const inverse = 1 / speedAt(points, easing, i / TABLE_STEPS)
+    timeAt[i] = timeAt[i - 1]! + ((previousInverse + inverse) / 2) * step
+    previousInverse = inverse
+  }
+  const naturalSeconds = timeAt[TABLE_STEPS]!
+  const durationInFrames = Math.max(1, Math.round(naturalSeconds * fps))
+  // Stretch the curve by < half a frame so the last frame lands on the source end.
+  const scale = durationInFrames / fps / naturalSeconds
+
+  const offsetAt = (source: number): number => {
+    const clamped = Math.min(sourceSeconds, Math.max(0, source))
+    const exact = clamped / step
+    const index = Math.min(TABLE_STEPS - 1, Math.floor(exact))
+    const fraction = exact - index
+    const seconds = timeAt[index]! + (timeAt[index + 1]! - timeAt[index]!) * fraction
+    return seconds * scale * fps
+  }
+
+  const sourceSecondsAt = (offsetFrames: number): number => {
+    const target = Math.min(naturalSeconds, Math.max(0, offsetFrames / fps / scale))
+    let low = 0
+    let high = TABLE_STEPS
+    while (high - low > 1) {
+      const middle = (low + high) >> 1
+      if (timeAt[middle]! <= target) low = middle
+      else high = middle
+    }
+    const span = timeAt[high]! - timeAt[low]!
+    const fraction = span > 0 ? (target - timeAt[low]!) / span : 0
+    return (low + fraction) * step
+  }
+
+  const segments: SpeedRampSegment[] = []
+  for (let offset = 0; offset < durationInFrames; offset += segmentFrames) {
+    const end = Math.min(durationInFrames, offset + segmentFrames)
+    segments.push({
+      offset,
+      durationInFrames: end - offset,
+      sourceStartSeconds: sourceSecondsAt(offset),
+      sourceEndSeconds: end === durationInFrames ? sourceSeconds : sourceSecondsAt(end),
+    })
+  }
+  return { durationInFrames, segments, sourceSecondsAt, offsetAt }
+}
+
+export interface SpeedRampSourceSegment {
+  offset: number
+  durationInFrames: number
+  sourceStart: number
+  sourceEnd: number
+  speed: number
+}
+
+export interface SpeedRampSource {
+  sourceStart: number
+  /** The item's own source end; the last segment ends exactly here. */
+  sourceEnd: number
+  sourceFps: number
+}
+
+/**
+ * Express plan segments in each participant's integer source frames, with
+ * shared timeline cuts so linked video and audio stay aligned. Boundaries are
+ * rounded independently from the exact integral; a cut is dropped when it
+ * would leave any participant a segment without a source frame. Speed is
+ * chosen so each segment ends exactly on its rounded source boundary.
+ */
+export function toSourceSegments(
+  plan: SpeedRampPlan,
+  sources: readonly SpeedRampSource[],
+  fps: number,
+): SpeedRampSourceSegment[][] {
+  const boundary = (source: SpeedRampSource, seconds: number) =>
+    source.sourceStart + Math.round(seconds * source.sourceFps)
+  const cuts = [0]
+  let previous = sources.map((source) => source.sourceStart)
+  for (const segment of plan.segments.slice(1)) {
+    const next = sources.map((source) => boundary(source, segment.sourceStartSeconds))
+    // Keep the cut only if both sides hold at least one source frame for everyone.
+    if (next.every((value, index) => value > previous[index]! && value < sources[index]!.sourceEnd)) {
+      cuts.push(segment.offset)
+      previous = next
+    }
+  }
+  cuts.push(plan.durationInFrames)
+
+  return sources.map((source) => {
+    const segments: SpeedRampSourceSegment[] = []
+    for (let index = 0; index < cuts.length - 1; index += 1) {
+      const offset = cuts[index]!
+      const end = cuts[index + 1]!
+      const sourceStart = index === 0 ? source.sourceStart : boundary(source, plan.sourceSecondsAt(offset))
+      const sourceEnd = end === plan.durationInFrames
+        ? source.sourceEnd
+        : boundary(source, plan.sourceSecondsAt(end))
+      const durationInFrames = end - offset
+      segments.push({
+        offset,
+        durationInFrames,
+        sourceStart,
+        sourceEnd,
+        speed: ((sourceEnd - sourceStart) / source.sourceFps) / (durationInFrames / fps),
+      })
+    }
+    return segments
+  })
+}
