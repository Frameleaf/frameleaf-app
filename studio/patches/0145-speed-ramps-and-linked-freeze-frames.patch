+import type { AudioItem, TextItem, TimelineItem, VideoItem } from '@/types/timeline'
+import { useItemsStore } from '../../items-store'
+import { useTransitionsStore } from '../../transitions-store'
+import { useKeyframesStore } from '../../keyframes-store'
+import { useTimelineSettingsStore } from '../../timeline-settings-store'
+import { useSelectionStore } from '@/shared/state/selection'
+import { execute } from '../shared'
+import { getSynchronizedLinkedItemsForEdit, hasLockedEditParticipants } from '../linked-edit'
+import { getAttachedCaptionItemIds, getLinkedItems } from '../../../utils/linked-items'
+import {
+  planSpeedRamp,
+  toSourceSegments,
+  type SpeedRampEasing,
+  type SpeedRampPlan,
+  type SpeedRampPoint,
+} from '../../../utils/speed-ramp'
+import { isLinkedSelectionEnabled, requestPostEditWarmForItems } from './shared'
+
+export { MAX_RAMP_SPEED, MIN_RAMP_SPEED, type SpeedRampEasing, type SpeedRampPoint } from '../../../utils/speed-ramp'
+
+export type SpeedRampRefusal =
+  | 'not-found'
+  | 'unsupported-clip'
+  | 'reversed'
+  | 'unsynchronized-links'
+  | 'locked'
+  | 'transition'
+  | 'keyframes'
+  | 'needs-room'
+  | 'invalid-ramp'
+
+export type SpeedRampPreview =
+  | { ok: true; plan: SpeedRampPlan; oldDurationInFrames: number; captionCount: number }
+  | { ok: false; reason: SpeedRampRefusal }
+
+export interface SpeedRampRequest {
+  points: readonly SpeedRampPoint[]
+  easing: SpeedRampEasing
+  /** Mute the linked audio segments instead of retiming dialogue audibly. */
+  muteLinkedAudio?: boolean
+}
+
+type RampableItem = VideoItem | AudioItem
+
+function isRampable(item: TimelineItem): item is RampableItem {
+  return item.type === 'video' || item.type === 'audio'
+}
+
+function hasKeyframes(itemId: string): boolean {
+  const record = useKeyframesStore.getState().keyframesByItemId[itemId]
+  return !!record?.properties.some((property) => property.keyframes.length > 0)
+}
+
+function sourceSecondsOf(item: RampableItem, fps: number): number | null {
+  const sourceFps = item.sourceFps ?? fps
+  if (item.sourceEnd === undefined) return null
+  const frames = item.sourceEnd - (item.sourceStart ?? 0)
+  return frames > 0 ? frames / sourceFps : null
+}
+
+/** Validate a ramp against the current project without changing it. */
+export function previewSpeedRamp(itemId: string, request: SpeedRampRequest): SpeedRampPreview {
+  const items = useItemsStore.getState().items
+  const anchor = items.find((item) => item.id === itemId)
+  if (!anchor) return { ok: false, reason: 'not-found' }
+  if (!isRampable(anchor)) return { ok: false, reason: 'unsupported-clip' }
+
+  const participants = getSynchronizedLinkedItemsForEdit(items, itemId, isLinkedSelectionEnabled())
+  if (participants.some((item) => !isRampable(item))) return { ok: false, reason: 'unsupported-clip' }
+  if (participants.some((item) => item.isReversed === true)) return { ok: false, reason: 'reversed' }
+  const synchronized = participants.length === getLinkedItems(items, itemId).length || !isLinkedSelectionEnabled()
+  if (!synchronized || participants.some((item) => item.from !== anchor.from || item.durationInFrames !== anchor.durationInFrames)) {
+    return { ok: false, reason: 'unsynchronized-links' }
+  }
+
+  const fps = useTimelineSettingsStore.getState().fps
+  const sourceSeconds = sourceSecondsOf(anchor, fps)
+  if (sourceSeconds === null || participants.some((item) => sourceSecondsOf(item as RampableItem, fps) === null)) {
+    return { ok: false, reason: 'unsupported-clip' }
+  }
+
+  const captionIds = participants.flatMap((item) => getAttachedCaptionItemIds(items, item.id))
+  const captions = items.filter((item) => captionIds.includes(item.id))
+  if (hasLockedEditParticipants([...participants, ...captions])) return { ok: false, reason: 'locked' }
+
+  const participantIds = new Set(participants.map((item) => item.id))
+  if (useTransitionsStore.getState().transitions.some(
+    (transition) => participantIds.has(transition.leftClipId) || participantIds.has(transition.rightClipId),
+  )) {
+    return { ok: false, reason: 'transition' }
+  }
+  if (participants.some((item) => hasKeyframes(item.id))) return { ok: false, reason: 'keyframes' }
+
+  let plan: SpeedRampPlan
+  try {
+    plan = planSpeedRamp({ sourceSeconds, fps, points: request.points, easing: request.easing })
+  } catch {
+    return { ok: false, reason: 'invalid-ramp' }
+  }
+
+  // Neighbours keep their positions: a longer result needs free room on every touched track.
+  const oldEnd = anchor.from + anchor.durationInFrames
+  const newEnd = anchor.from + plan.durationInFrames
+  if (newEnd > oldEnd) {
+    const trackIds = new Set(participants.map((item) => item.trackId))
+    const blocked = items.some((item) =>
+      trackIds.has(item.trackId)
+      && !participantIds.has(item.id)
+      && item.from < newEnd
+      && item.from + item.durationInFrames > oldEnd)
+    if (blocked) return { ok: false, reason: 'needs-room' }
+  }
+  // Moved captions must also land in free space on their own tracks.
+  const captionIdSet = new Set(captions.map((caption) => caption.id))
+  const toNewFrame = captionFrameMapper(anchor, plan, fps)
+  for (const caption of captions) {
+    const from = toNewFrame(caption.from)
+    const end = toNewFrame(caption.from + caption.durationInFrames)
+    if (end <= from) continue
+    const overlaps = items.some((item) =>
+      item.trackId === caption.trackId
+      && !captionIdSet.has(item.id)
+      && !participantIds.has(item.id)
+      && item.from < end
+      && item.from + item.durationInFrames > from)
+    if (overlaps) return { ok: false, reason: 'needs-room' }
+  }
+
+  return { ok: true, plan, oldDurationInFrames: anchor.durationInFrames, captionCount: captions.length }
+}
+
+/**
+ * Apply a speed ramp as one undoable edit: the clip and its linked companions
+ * become matching constant-speed segments, and attached source captions move
+ * with the source they describe. Returns the refusal reason, or null.
+ */
+export function applySpeedRamp(itemId: string, request: SpeedRampRequest): SpeedRampRefusal | null {
+  const preview = previewSpeedRamp(itemId, request)
+  if (!preview.ok) return preview.reason
+  const { plan } = preview
+
+  execute(
+    'APPLY_SPEED_RAMP',
+    () => {
+      const store = useItemsStore.getState()
+      const fps = useTimelineSettingsStore.getState().fps
+      const items = store.items
+      const participants = getSynchronizedLinkedItemsForEdit(items, itemId, isLinkedSelectionEnabled())
+        .filter(isRampable)
+      const anchor = participants.find((item) => item.id === itemId)!
+      const linked = participants.length > 1
+
+      const toNewFrame = captionFrameMapper(anchor, plan, fps)
+      for (const captionId of participants.flatMap((item) => getAttachedCaptionItemIds(items, item.id))) {
+        const caption = items.find((item) => item.id === captionId) as TextItem | undefined
+        if (!caption) continue
+        const from = toNewFrame(caption.from)
+        const end = toNewFrame(caption.from + caption.durationInFrames)
+        if (end <= from) {
+          store._removeItems([caption.id])
+        } else {
+          store._updateItem(caption.id, { from, durationInFrames: end - from })
+        }
+      }
+
+      // Shared timeline cuts keep linked video and audio segments in step.
+      const segmentsByItem = toSourceSegments(plan, participants.map((item) => ({
+        sourceStart: item.sourceStart ?? 0,
+        sourceEnd: item.sourceEnd!,
+        sourceFps: item.sourceFps ?? fps,
+      })), fps)
+      const groupIds = segmentsByItem[0]!.map(() => (linked ? crypto.randomUUID() : undefined))
+
+      const added: TimelineItem[] = []
+      const selected: string[] = []
+      participants.forEach((item, participantIndex) => {
+        const segments = segmentsByItem[participantIndex]!
+        const originId = item.originId ?? item.id
+        segments.forEach((segment, index) => {
+          // Fades belong to the outer edges of the ramped range, not to every segment.
+          const first = index === 0
+          const last = index === segments.length - 1
+          const geometry: Partial<RampableItem> = {
+            ...(!first && { fadeIn: undefined, audioFadeIn: undefined }),
+            ...(!last && { fadeOut: undefined, audioFadeOut: undefined }),
+            from: anchor.from + segment.offset,
+            durationInFrames: segment.durationInFrames,
+            sourceStart: segment.sourceStart,
+            sourceEnd: segment.sourceEnd,
+            speed: segment.speed,
+            originId,
+            // A lone participant no longer plays in sync with former companions.
+            linkedGroupId: linked ? groupIds[index] : undefined,
+            ...(request.muteLinkedAudio && item.type === 'audio' ? { muted: true } : {}),
+          }
+          if (index === 0) {
+            store._updateItem(item.id, geometry)
+          } else {
+            added.push({ ...item, ...geometry, id: crypto.randomUUID() } as TimelineItem)
+          }
+        })
+        selected.push(item.id)
+      })
+      if (added.length > 0) store._addItems(added)
+
+      requestPostEditWarmForItems([...participants.map((item) => item.id), ...added.map((item) => item.id)])
+      useSelectionStore.getState().selectItems(selected)
+      useTimelineSettingsStore.getState().markDirty()
+    },
+    { itemId, points: request.points.map((point) => ({ ...point })), easing: request.easing, muteLinkedAudio: request.muteLinkedAudio === true },
+  )
+  return null
+}
+
+/** Captions: old timeline frame -> source seconds (at the clip's current constant speed) -> ramped frame. */
+function captionFrameMapper(anchor: RampableItem, plan: SpeedRampPlan, fps: number): (frame: number) => number {
+  const sourceFps = anchor.sourceFps ?? fps
+  const speed = anchor.speed ?? 1
+  const sourceSeconds = (anchor.sourceEnd! - (anchor.sourceStart ?? 0)) / sourceFps
+  return (frame) => {
+    const oldOffset = Math.min(anchor.durationInFrames, Math.max(0, frame - anchor.from))
+    return anchor.from + Math.round(plan.offsetAt(Math.min((oldOffset / fps) * speed, sourceSeconds)))
+  }
+}
