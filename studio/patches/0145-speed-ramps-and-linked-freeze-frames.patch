+// @vitest-environment node
+
+import { beforeEach, describe, expect, it, vi } from 'vite-plus/test'
+import type { AudioItem, TimelineTrack, VideoItem } from '@/types/timeline'
+
+const media = vi.hoisted(() => ({ colorTransfer: undefined as string | undefined }))
+
+vi.mock('mediabunny', () => ({
+  ALL_FORMATS: [],
+  BlobSource: class {},
+  Input: class {
+    getPrimaryVideoTrack = async () => ({ displayWidth: 4, displayHeight: 2 })
+    dispose() {}
+  },
+  CanvasSink: class {
+    getCanvas = async () => ({ canvas: { convertToBlob: async () => new Blob(['png']) } })
+  },
+}))
+vi.mock('@/features/timeline/deps/media-library-store', () => ({
+  useMediaLibraryStore: {
+    getState: () => ({
+      mediaById: { 'media-1': { id: 'media-1', fps: 30, colorTransfer: media.colorTransfer } },
+      currentProjectId: 'project-1',
+      prependMediaItem: () => {},
+    }),
+  },
+}))
+vi.mock('@/features/timeline/deps/media-library-service', () => ({
+  importMediaLibraryService: async () => ({
+    mediaLibraryService: {
+      getMediaFile: async () => new Blob(['video']),
+      importGeneratedImage: async () => ({ id: 'frame-media' }),
+      deleteMediaFromProject: async () => {},
+    },
+  }),
+}))
+vi.mock('@/infrastructure/browser/blob-url-manager', () => ({
+  blobUrlManager: { acquire: () => 'blob:frame', release: () => {} },
+}))
+
+const { useItemsStore } = await import('../../items-store')
+const { useTransitionsStore } = await import('../../transitions-store')
+const { useTimelineCommandStore } = await import('../../timeline-command-store')
+const { useTimelineSettingsStore } = await import('../../timeline-settings-store')
+const { useEditorStore } = await import('@/shared/state/editor')
+const { insertFreezeFrame } = await import('./freeze-frame-actions')
+
+function track(id: string, order: number, locked = false): TimelineTrack {
+  return {
+    id, name: id, order, height: 80, locked, syncLock: true, visible: true, muted: false,
+    solo: false, volume: 0, items: [], kind: id.startsWith('a') ? 'audio' : 'video',
+  } as TimelineTrack
+}
+
+const base = { mediaId: 'media-1', linkedGroupId: 'group-1', sourceStart: 0, sourceEnd: 90, sourceDuration: 300, sourceFps: 30, speed: 1 }
+const video = { id: 'video-1', type: 'video', trackId: 'v1', from: 0, durationInFrames: 90, label: 'v', src: 'blob:v', ...base } as VideoItem
+const audio = { id: 'audio-1', type: 'audio', trackId: 'a1', from: 0, durationInFrames: 90, label: 'a', src: 'blob:a', ...base } as AudioItem
+const music = { id: 'music', type: 'audio', trackId: 'a2', from: 0, durationInFrames: 300, label: 'm', src: 'blob:m', mediaId: 'm' } as AudioItem
+const later = { ...audio, id: 'later-audio', linkedGroupId: undefined, from: 100, durationInFrames: 30 } as AudioItem
+
+describe('insertFreezeFrame', () => {
+  beforeEach(() => {
+    media.colorTransfer = undefined
+    useTimelineCommandStore.getState().clearHistory()
+    useTimelineSettingsStore.setState({ fps: 30, isDirty: false })
+    useEditorStore.setState({ linkedSelectionEnabled: true })
+    useItemsStore.getState().setTracks([track('v1', 0), track('a1', 1), track('a2', 2)])
+    useItemsStore.getState().setItems([video, audio, music, later])
+    useTransitionsStore.getState().setTransitions([])
+  })
+
+  it('holds the frame for the authored duration with silent linked audio', async () => {
+    expect(await insertFreezeFrame('video-1', 30, 12)).toBe(true)
+
+    const items = useItemsStore.getState().items
+    const still = items.find((item) => item.type === 'image')!
+    expect(still).toMatchObject({ trackId: 'v1', from: 30, durationInFrames: 12 })
+
+    const onTrack = (trackId: string) => items.filter((item) => item.trackId === trackId)
+      .map((item) => [item.from, item.durationInFrames]).sort((a, b) => a[0]! - b[0]!)
+    expect(onTrack('v1')).toEqual([[0, 30], [30, 12], [42, 60]])
+    // Linked audio splits with the video and leaves a silent 12-frame gap.
+    expect(onTrack('a1')).toEqual([[0, 30], [42, 60], [112, 30]])
+    // Independent music on another track continues.
+    expect(useItemsStore.getState().itemById['music']).toMatchObject({ from: 0, durationInFrames: 300 })
+
+    // Right halves stay linked to each other, not to the left halves.
+    const rights = items.filter((item) => item.from === 42)
+    expect(rights).toHaveLength(2)
+    expect(rights[0]!.linkedGroupId).toBe(rights[1]!.linkedGroupId)
+    expect(useItemsStore.getState().itemById['video-1']!.linkedGroupId).not.toBe(rights[0]!.linkedGroupId)
+  })
+
+  it('refuses HDR sources without changing the project', async () => {
+    media.colorTransfer = 'pq'
+    expect(await insertFreezeFrame('video-1', 30, 12)).toBe(false)
+    expect(useItemsStore.getState().items).toHaveLength(4)
+  })
+
+  it('refuses when a clip it would move is locked', async () => {
+    useItemsStore.getState().setTracks([track('v1', 0), track('a1', 1, true), track('a2', 2)])
+    expect(await insertFreezeFrame('video-1', 30, 12)).toBe(false)
+    expect(useItemsStore.getState().items).toHaveLength(4)
+  })
+
+  it('refuses a non-positive duration', async () => {
+    expect(await insertFreezeFrame('video-1', 30, 0)).toBe(false)
+  })
+})
