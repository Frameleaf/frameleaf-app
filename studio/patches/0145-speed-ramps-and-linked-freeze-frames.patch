+import { useTimelineSettingsStore } from '../../timeline-settings-store'
+import { useEditorStore } from '@/shared/state/editor'
+import { timelineToSourceFrames } from '../../../utils/source-calculations'
+import { applySpeedRamp, previewSpeedRamp, type SpeedRampRequest } from './speed-ramp-actions'
+
+function track(id: string, order: number, overrides: Partial<TimelineTrack> = {}): TimelineTrack {
+  return {
+    id, name: id, order, height: 80, locked: false, syncLock: true, visible: true,
+    muted: false, solo: false, volume: 0, items: [], kind: id.startsWith('a') ? 'audio' : 'video',
+    ...overrides,
+  } as TimelineTrack
+}
+
+const video = (overrides: Partial<VideoItem> = {}): VideoItem => ({
+  id: 'video-1', type: 'video', trackId: 'v1', from: 30, durationInFrames: 90, label: 'clip.mp4',
+  src: 'blob:video', mediaId: 'media-1', linkedGroupId: 'group-1', originId: 'origin-1',
+  sourceStart: 30, sourceEnd: 120, sourceDuration: 300, sourceFps: 30, speed: 1, ...overrides,
+} as VideoItem)
+
+const audio = (overrides: Partial<AudioItem> = {}): AudioItem => ({
+  id: 'audio-1', type: 'audio', trackId: 'a1', from: 30, durationInFrames: 90, label: 'clip.wav',
+  src: 'blob:audio', mediaId: 'media-1', linkedGroupId: 'group-1', originId: 'origin-1',
+  sourceStart: 30, sourceEnd: 120, sourceDuration: 300, sourceFps: 30, speed: 1, ...overrides,
+} as AudioItem)
+
+const caption = (overrides: Partial<TextItem> = {}): TextItem => ({
+  id: 'caption-1', type: 'text', trackId: 'c1', from: 60, durationInFrames: 15, label: 'Hi',
+  text: 'Hi', color: '#fff', textRole: 'caption',
+  captionSource: { type: 'transcript', clipId: 'video-1', mediaId: 'media-1' }, ...overrides,
+} as TextItem)
+
+const slowMiddle: SpeedRampRequest = {
+  points: [{ position: 0, speed: 1 }, { position: 0.5, speed: 0.5 }, { position: 1, speed: 1 }],
+  easing: 'ease',
+}
+
+function ramped(type: TimelineItem['type']): Array<VideoItem | AudioItem> {
+  return useItemsStore.getState().items
+    .filter((item): item is VideoItem | AudioItem => item.type === type && item.originId === 'origin-1')
+    .sort((a, b) => a.from - b.from)
+}
+
+describe('speed ramps', () => {
+  beforeEach(() => {
+    useTimelineCommandStore.getState().clearHistory()
+    useTimelineSettingsStore.setState({ fps: 30, isDirty: false })
+    useEditorStore.setState({ linkedSelectionEnabled: true })
+    useItemsStore.getState().setTracks([track('v1', 0), track('a1', 1), track('c1', 2)])
+    useItemsStore.getState().setItems([video(), audio()])
+    useTransitionsStore.getState().setTransitions([])
+    useKeyframesStore.getState().setKeyframes([])
+  })
+
+  it('writes matching constant-speed segments for the clip and its linked audio', () => {
+    const preview = previewSpeedRamp('video-1', slowMiddle)
+    expect(preview.ok).toBe(true)
+    if (!preview.ok) return
+
+    expect(applySpeedRamp('video-1', slowMiddle)).toBeNull()
+
+    const videos = ramped('video')
+    const audios = ramped('audio')
+    expect(videos.length).toBeGreaterThan(2)
+    expect(videos.map((item) => [item.from, item.durationInFrames, item.sourceStart, item.sourceEnd]))
+      .toEqual(audios.map((item) => [item.from, item.durationInFrames, item.sourceStart, item.sourceEnd]))
+    expect(videos[0]!.id).toBe('video-1')
+    expect(videos[0]!.from).toBe(30)
+    expect(videos[0]!.sourceStart).toBe(30)
+    expect(videos.at(-1)!.sourceEnd).toBe(120)
+    const end = videos.at(-1)!.from + videos.at(-1)!.durationInFrames
+    expect(end - 30).toBe(preview.plan.durationInFrames)
+    // Slowing the middle makes the clip longer.
+    expect(preview.plan.durationInFrames).toBeGreaterThan(90)
+
+    // Each video segment is linked to exactly its audio segment.
+    for (const [index, segment] of videos.entries()) {
+      expect(segment.linkedGroupId).toBeDefined()
+      expect(audios[index]!.linkedGroupId).toBe(segment.linkedGroupId)
+    }
+    // Source frames shown never go backwards across segment boundaries.
+    let previous = -1
+    for (const segment of videos) {
+      for (let offset = 0; offset < segment.durationInFrames; offset += 1) {
+        const frame = segment.sourceStart! + timelineToSourceFrames(offset, segment.speed!, 30, 30)
+        expect(frame).toBeGreaterThanOrEqual(previous)
+        previous = frame
+      }
+    }
+  })
+
+  it('applies as one undoable edit', () => {
+    applySpeedRamp('video-1', slowMiddle)
+    useTimelineCommandStore.getState().undo()
+    expect(useItemsStore.getState().items.map((item) => item.id).sort()).toEqual(['audio-1', 'video-1'])
+    expect(useItemsStore.getState().itemById['video-1']).toMatchObject({ from: 30, durationInFrames: 90, speed: 1 })
+  })
+
+  it('mutes linked audio when asked', () => {
+    applySpeedRamp('video-1', { ...slowMiddle, muteLinkedAudio: true })
+    expect(ramped('audio').every((item) => item.muted === true)).toBe(true)
+    expect(ramped('video').every((item) => item.muted !== true)).toBe(true)
+  })
+
+  it('moves attached source captions with the source they describe', () => {
+    useItemsStore.getState().setItems([video(), audio(), caption(), caption({
+      id: 'title-1', textRole: undefined, captionSource: undefined, from: 60, durationInFrames: 15,
+    })])
+    // Speeding everything up 2x halves caption offsets within the clip.
+    const fast: SpeedRampRequest = { points: [{ position: 0, speed: 2 }, { position: 1, speed: 2 }], easing: 'linear' }
+    applySpeedRamp('video-1', fast)
+    const itemById = useItemsStore.getState().itemById
+    expect(itemById['caption-1']).toMatchObject({ from: 45 })
+    expect(Math.abs(itemById['caption-1']!.durationInFrames - 8)).toBeLessThanOrEqual(1)
+    // Timeline-authored text stays where it was authored.
+    expect(itemById['title-1']).toMatchObject({ from: 60, durationInFrames: 15 })
+  })
+
+  it('keeps neighbours in place and refuses when the result needs their room', () => {
+    useItemsStore.getState().setItems([video(), audio(), video({
+      id: 'next', from: 125, linkedGroupId: undefined, originId: 'other', sourceStart: 0, sourceEnd: 30, durationInFrames: 30,
+    })])
+    expect(applySpeedRamp('video-1', slowMiddle)).toBe('needs-room')
+    expect(useItemsStore.getState().items).toHaveLength(3)
+    expect(useTimelineCommandStore.getState().canUndo).toBe(false)
+  })
+
+  it('leaves a gap when the ramp makes the clip shorter', () => {
+    useItemsStore.getState().setItems([video(), audio(), video({
+      id: 'next', from: 120, linkedGroupId: undefined, originId: 'other', sourceStart: 0, sourceEnd: 30, durationInFrames: 30,
+    })])
+    applySpeedRamp('video-1', { points: [{ position: 0, speed: 2 }, { position: 1, speed: 3 }], easing: 'linear' })
+    expect(useItemsStore.getState().itemById['next']).toMatchObject({ from: 120 })
+  })
+
+  it.each([
+    ['locked', () => useItemsStore.getState().setTracks([track('v1', 0), track('a1', 1, { locked: true }), track('c1', 2)])],
+    ['reversed', () => useItemsStore.getState().setItems([video({ isReversed: true }), audio({ isReversed: true })])],
+    ['transition', () => useTransitionsStore.getState().setTransitions([
+      { id: 't', leftClipId: 'other', rightClipId: 'video-1', durationInFrames: 10 } as never,
+    ])],
+    ['unsynchronized-links', () => useItemsStore.getState().setItems([video(), audio({ from: 31 })])],
+  ])('refuses %s without changing the project', (reason, arrange) => {
+    arrange()
+    const before = structuredClone(useItemsStore.getState().items)
+    expect(applySpeedRamp('video-1', slowMiddle)).toBe(reason)
+    expect(useItemsStore.getState().items).toEqual(before)
+  })
+
+  it('refuses an invalid curve', () => {
+    expect(applySpeedRamp('video-1', { points: [{ position: 0, speed: 0 }, { position: 1, speed: 1 }], easing: 'linear' }))
+      .toBe('invalid-ramp')
+  })
+})
+
+describe('speed ramps: edges and captions (review)', () => {
+  beforeEach(() => {
+    useTimelineCommandStore.getState().clearHistory()
+    useTimelineSettingsStore.setState({ fps: 30, isDirty: false })
+    useEditorStore.setState({ linkedSelectionEnabled: true })
+    useItemsStore.getState().setTracks([track('v1', 0), track('a1', 1), track('c1', 2)])
+    useTransitionsStore.getState().setTransitions([])
+    useKeyframesStore.getState().setKeyframes([])
+  })
+
+  it('keeps fades only at the outer edges of the ramped range', () => {
+    useItemsStore.getState().setItems([
+      video({ fadeIn: 0.5, fadeOut: 0.5 }),
+      audio({ audioFadeIn: 0.25, audioFadeOut: 0.25 }),
+    ])
+    applySpeedRamp('video-1', slowMiddle)
+    const videos = ramped('video')
+    const audios = ramped('audio')
+    expect(videos[0]).toMatchObject({ fadeIn: 0.5, fadeOut: undefined })
+    expect(videos.at(-1)).toMatchObject({ fadeIn: undefined, fadeOut: 0.5 })
+    expect(videos.slice(1, -1).every((item) => item.fadeIn === undefined && item.fadeOut === undefined)).toBe(true)
+    expect(audios[0]).toMatchObject({ audioFadeIn: 0.25, audioFadeOut: undefined })
+    expect(audios.at(-1)).toMatchObject({ audioFadeIn: undefined, audioFadeOut: 0.25 })
+  })
+
+  it('refuses when a moved caption would land on another item on its track', () => {
+    useItemsStore.getState().setItems([
+      video(), audio(),
+      caption({ from: 110, durationInFrames: 10 }),
+      caption({ id: 'title-1', textRole: undefined, captionSource: undefined, from: 140, durationInFrames: 20 }),
+    ])
+    expect(applySpeedRamp('video-1', slowMiddle)).toBe('needs-room')
+    expect(useTimelineCommandStore.getState().canUndo).toBe(false)
+  })
+})
