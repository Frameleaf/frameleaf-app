diff --git a/src/features/editor/components/properties-sidebar/clip-panel/sound-channels-control.test.tsx b/src/features/editor/components/properties-sidebar/clip-panel/sound-channels-control.test.tsx
new file mode 100644
index 0000000..49dd05a
--- /dev/null
+++ b/src/features/editor/components/properties-sidebar/clip-panel/sound-channels-control.test.tsx
@@ -0,0 +1,68 @@
+import type { ReactNode } from 'react'
+import { fireEvent, render, screen } from '@testing-library/react'
+import { beforeEach, describe, expect, it, vi } from 'vite-plus/test'
+import type { AudioItem } from '@/types/timeline'
+import { isValidAudioChannelMap } from '@/shared/utils/audio-channel-map'
+import { AUDIO_CHANNEL_CHOICES, getAudioChannelChoice } from './audio-section-utils'
+
+const updateItem = vi.hoisted(() => vi.fn())
+vi.mock('react-i18next', () => ({ useTranslation: () => ({ t: (key: string) => key }) }))
+vi.mock('@/features/editor/deps/timeline-store', () => ({
+  useTimelineStore: (select: (state: unknown) => unknown) => select({ updateItem }),
+}))
+vi.mock('../components', () => ({
+  PropertyRow: ({ children }: { children: ReactNode }) => <div>{children}</div>,
+}))
+
+const { SoundChannelsControl } = await import('./sound-channels-control')
+
+const clip = (id: string, audioChannelMap?: AudioItem['audioChannelMap']) =>
+  ({ id, type: 'audio', audioChannelMap }) as AudioItem
+
+describe('sound clip channels (FL-1561)', () => {
+  beforeEach(() => updateItem.mockClear())
+
+  it('offers only maps the engine accepts, and stereo as no map', () => {
+    for (const choice of AUDIO_CHANNEL_CHOICES) {
+      expect(choice.map === undefined || isValidAudioChannelMap(choice.map), choice.id).toBe(true)
+    }
+    expect(AUDIO_CHANNEL_CHOICES.find((choice) => choice.id === 'stereo')?.map).toBeUndefined()
+  })
+
+  it('names the choice a clip has', () => {
+    expect(getAudioChannelChoice([clip('a')])).toBe('stereo')
+    expect(getAudioChannelChoice([clip('a', { left: [1], right: [1] })])).toBe('monoRight')
+    expect(getAudioChannelChoice([clip('a', { left: [0], right: [1] })])).toBe('dualMono')
+    expect(getAudioChannelChoice([clip('a', { left: [0], right: [1] })], 'front')).toBe('front')
+    expect(getAudioChannelChoice([clip('a', { left: [0], right: [1] })], 'lfe')).toBe('dualMono')
+    expect(getAudioChannelChoice([clip('a', { left: [0, 1], right: [0, 1] })])).toBe('custom')
+    expect(getAudioChannelChoice([clip('a'), clip('b', { left: [0], right: [0] })])).toBe('mixed')
+  })
+
+  it('writes the map to every selected clip and removes it for stereo', () => {
+    const clips = [clip('a'), clip('b')]
+    render(<SoundChannelsControl items={clips} />)
+    const select = screen.getByRole('combobox', { name: 'engineControls.channels.label' })
+    expect((select as HTMLSelectElement).value).toBe('stereo')
+
+    fireEvent.change(select, { target: { value: 'centre' } })
+    expect(updateItem.mock.calls).toEqual([
+      ['a', { audioChannelMap: { left: [2], right: [2] } }],
+      ['b', { audioChannelMap: { left: [2], right: [2] } }],
+    ])
+
+    updateItem.mockClear()
+    fireEvent.change(select, { target: { value: 'stereo' } })
+    expect(updateItem.mock.calls).toEqual([
+      ['a', { audioChannelMap: undefined }],
+      ['b', { audioChannelMap: undefined }],
+    ])
+  })
+
+  it('shows a map no preset has without offering to choose it', () => {
+    render(<SoundChannelsControl items={[clip('a', { left: [0, 1], right: [0, 1] })]} />)
+    const custom = screen.getByRole('option', { name: 'engineControls.channels.custom' })
+    expect((custom as HTMLOptionElement).selected).toBe(true)
+    expect((custom as HTMLOptionElement).disabled).toBe(true)
+  })
+})
diff --git a/src/features/editor/components/properties-sidebar/clip-panel/sound-channels-control.tsx b/src/features/editor/components/properties-sidebar/clip-panel/sound-channels-control.tsx
new file mode 100644
index 0000000..f3aba3f
--- /dev/null
+++ b/src/features/editor/components/properties-sidebar/clip-panel/sound-channels-control.tsx
@@ -0,0 +1,66 @@
+/**
+ * Frameleaf (FL-1561): which source channels a sound clip plays. A view of the clip's
+ * `audioChannelMap` (render spec, sound channels M1 to M5); choosing Stereo removes the map.
+ */
+import { useRef } from 'react'
+import { useTranslation } from 'react-i18next'
+import { useTimelineStore } from '@/features/editor/deps/timeline-store'
+import { PropertyRow } from '../components'
+import {
+  AUDIO_CHANNEL_CHOICES,
+  getAudioChannelChoice,
+  type AudioCapableItem,
+  type AudioChannelChoiceId,
+} from './audio-section-utils'
+
+export function SoundChannelsControl({ items }: { items: AudioCapableItem[] }) {
+  const { t } = useTranslation()
+  const updateItem = useTimelineStore((s) => s.updateItem)
+  const picked = useRef<AudioChannelChoiceId | undefined>(undefined)
+  const value = getAudioChannelChoice(items, picked.current)
+  const label = t('engineControls.channels.label')
+  const option = (id: AudioChannelChoiceId) => (
+    <option key={id} value={id}>
+      {t(`engineControls.channels.choice.${id}`)}
+    </option>
+  )
+
+  return (
+    <>
+      <PropertyRow label={label}>
+        <select
+          aria-label={label}
+          value={value}
+          onChange={(event) => {
+            const choice = AUDIO_CHANNEL_CHOICES.find((entry) => entry.id === event.target.value)
+            if (!choice) return
+            picked.current = choice.id
+            const audioChannelMap = choice.map && {
+              left: [...choice.map.left],
+              right: [...choice.map.right],
+            }
+            for (const item of items) updateItem(item.id, { audioChannelMap })
+          }}
+          className="h-7 w-full min-w-0 flex-1 rounded-md border border-input bg-background px-2 text-xs"
+        >
+          {value === 'mixed' || value === 'custom' ? (
+            <option value={value} disabled>
+              {t(`engineControls.channels.${value}`)}
+            </option>
+          ) : null}
+          {AUDIO_CHANNEL_CHOICES.filter((choice) => choice.group === null).map((choice) =>
+            option(choice.id),
+          )}
+          <optgroup label={t('engineControls.channels.surroundGroup')}>
+            {AUDIO_CHANNEL_CHOICES.filter((choice) => choice.group === 'surround').map((choice) =>
+              option(choice.id),
+            )}
+          </optgroup>
+        </select>
+      </PropertyRow>
+      <p className="px-2 text-[11px] leading-snug text-muted-foreground">
+        {t('engineControls.channels.note')}
+      </p>
+    </>
+  )
+}
