+/**
+ * Frameleaf (FL-1561): the channel choices of a sound clip, as the presets of the sound channel
+ * spec (M5). Stereo is the absence of a map. Dual mono and the 5.1 front pair are the same map.
+ */
+export const AUDIO_CHANNEL_CHOICES = [
+  { id: 'stereo', group: null, map: undefined },
+  { id: 'monoLeft', group: null, map: { left: [0], right: [0] } },
+  { id: 'monoRight', group: null, map: { left: [1], right: [1] } },
+  { id: 'dualMono', group: null, map: { left: [0], right: [1] } },
+  { id: 'front', group: 'surround', map: { left: [0], right: [1] } },
+  { id: 'centre', group: 'surround', map: { left: [2], right: [2] } },
+  { id: 'lfe', group: 'surround', map: { left: [3], right: [3] } },
+  { id: 'surround', group: 'surround', map: { left: [4], right: [5] } },
+] as const satisfies ReadonlyArray<{
+  id: string
+  group: 'surround' | null
+  map: { left: readonly number[]; right: readonly number[] } | undefined
+}>
+
+export type AudioChannelChoiceId = (typeof AUDIO_CHANNEL_CHOICES)[number]['id']
+
+const sameSide = (a: readonly number[], b: readonly number[]) =>
+  a.length === b.length && a.every((index, i) => b[i] === index)
+
+/**
+ * The choice a clip's map is: `preferred` when it names the same map (so the 5.1 front pair stays
+ * shown after it is picked), else the first preset with that map, `custom` for a map no preset has
+ * and `mixed` when the clips differ.
+ */
+export function getAudioChannelChoice(
+  items: readonly Pick<AudioCapableItem, 'audioChannelMap'>[],
+  preferred?: AudioChannelChoiceId,
+): AudioChannelChoiceId | 'custom' | 'mixed' {
+  const matches = (map: AudioCapableItem['audioChannelMap']) =>
+    AUDIO_CHANNEL_CHOICES.filter((choice) =>
+      choice.map === undefined || map === undefined
+        ? choice.map === map
+        : sameSide(choice.map.left, map.left) && sameSide(choice.map.right, map.right),
+    ).map((choice) => choice.id)
+  const [first, ...rest] = items.map((item) => matches(item.audioChannelMap))
+  if (!first) return 'stereo'
+  if (rest.some((ids) => ids[0] !== first[0])) return 'mixed'
+  if (preferred && first.includes(preferred)) return preferred
+  return first[0] ?? 'custom'
+}
