+// @vitest-environment node
+
+import { describe, expect, it } from 'vite-plus/test'
+import type { VideoItem } from '@/types/timeline'
+import { areTimelineItemPropsEqual } from './timeline-item-memo-compare'
+
+describe('timeline clip memo comparator', () => {
+  const clip = { id: 'clip', type: 'video', from: 0, durationInFrames: 90 } as VideoItem
+  const props = (item: VideoItem) => ({ item, isCompactWidth: false, isDetailEligible: true })
+
+  it('redraws a clip when its own markers change (FL-1563)', () => {
+    const markers = [{ id: 'm1', sourceFrame: 30, color: '#fff' }]
+    expect(areTimelineItemPropsEqual(props(clip), props({ ...clip }))).toBe(true)
+    expect(
+      areTimelineItemPropsEqual(props({ ...clip, markers }), props({ ...clip, markers })),
+    ).toBe(true)
+    expect(
+      areTimelineItemPropsEqual(
+        props({ ...clip, markers }),
+        props({ ...clip, markers: [...markers, { id: 'm2', sourceFrame: 60, color: '#fff' }] }),
+      ),
+    ).toBe(false)
+  })
+})
