@@ -0,0 +1,104 @@
+/**
+ * Frameleaf (FL-1563): the markers of one clip. They are kept on the clip in its source frames, so
+ * they stay with the media when the clip is moved or trimmed; a marker the trim leaves out is
+ * still listed, dimmed.
+ */
+import { useTranslation } from 'react-i18next'
+import { MapPin, Plus, Trash2 } from 'lucide-react'
+import { Button } from '@/components/ui/button'
+import { Input } from '@/components/ui/input'
+import { Textarea } from '@/components/ui/textarea'
+import type { ClipMarker, TimelineItem } from '@/types/timeline'
+import { useTimelineStore } from '@/features/editor/deps/timeline-store'
+import { usePlaybackStore } from '@/shared/state/playback'
+import { clipMarkerOffsetFrames, clipSourceFrameAt } from '@/shared/timeline/clip-markers'
+import { formatTimecodeDotFrames } from '@/shared/utils/time-utils'
+import { cn } from '@/shared/ui/cn'
+import { PropertySection } from '../components'
+
+const CLIP_MARKER_COLOR = 'oklch(0.60 0.20 310)'
+
+export function ClipMarkersSection({ item }: { item: TimelineItem }) {
+  const { t } = useTranslation()
+  const updateItem = useTimelineStore((s) => s.updateItem)
+  const fps = useTimelineStore((s) => s.fps)
+  const markers = item.markers ?? []
+  const write = (next: ClipMarker[]) =>
+    updateItem(item.id, { markers: next.length > 0 ? next : undefined })
+  const change = (id: string, updates: Partial<ClipMarker>) =>
+    write(markers.map((marker) => (marker.id === id ? { ...marker, ...updates } : marker)))
+
+  const addAtPlayhead = () => {
+    const playhead = usePlaybackStore.getState().currentFrame
+    // The playhead outside the clip marks the clip's first frame.
+    const sourceFrame =
+      clipSourceFrameAt(item, playhead - item.from, fps) ?? clipSourceFrameAt(item, 0, fps)
+    if (sourceFrame === null) return
+    write([...markers, { id: crypto.randomUUID(), sourceFrame, color: CLIP_MARKER_COLOR }])
+  }
+
+  return (
+    <PropertySection
+      title={t('engineControls.markers.clipMarkers')}
+      icon={MapPin}
+      defaultOpen={markers.length > 0}
+    >
+      <div className="space-y-2 px-2">
+        {[...markers]
+          .sort((a, b) => a.sourceFrame - b.sourceFrame)
+          .map((marker) => {
+            const offset = clipMarkerOffsetFrames(item, marker.sourceFrame, fps)
+            return (
+              <div key={marker.id} className={cn('space-y-1', offset === null && 'opacity-60')}>
+                <div className="flex items-center gap-1.5">
+                  <span
+                    className="h-2.5 w-2.5 shrink-0 rotate-45 border border-black/20"
+                    style={{ backgroundColor: marker.color }}
+                  />
+                  <Input
+                    value={marker.label ?? ''}
+                    onChange={(event) =>
+                      change(marker.id, { label: event.target.value || undefined })
+                    }
+                    placeholder={t('engineControls.markers.name')}
+                    aria-label={t('engineControls.markers.name')}
+                    className="h-7 min-w-0 flex-1 text-xs"
+                  />
+                  <span className="shrink-0 font-mono text-[10px] tabular-nums text-muted-foreground">
+                    {offset === null
+                      ? t('engineControls.markers.trimmedOut')
+                      : t('engineControls.markers.timeIn', {
+                          time: formatTimecodeDotFrames(offset, fps),
+                        })}
+                  </span>
+                  <button
+                    type="button"
+                    onClick={() => write(markers.filter((other) => other.id !== marker.id))}
+                    className="grid h-6 w-6 shrink-0 place-items-center rounded text-muted-foreground hover:text-destructive"
+                    aria-label={t('engineControls.markers.removeClipMarker')}
+                  >
+                    <Trash2 className="h-3 w-3" />
+                  </button>
+                </div>
+                <Textarea
+                  value={marker.note ?? ''}
+                  onChange={(event) => change(marker.id, { note: event.target.value || undefined })}
+                  placeholder={t('engineControls.markers.addNote')}
+                  aria-label={t('engineControls.markers.note')}
+                  rows={1}
+                  className="min-h-7 px-2 py-1 text-xs md:text-xs"
+                />
+              </div>
+            )
+          })}
+        <Button variant="outline" size="sm" className="h-7 w-full text-xs" onClick={addAtPlayhead}>
+          <Plus className="mr-1.5 h-3 w-3" />
+          {t('engineControls.markers.addClipMarker')}
+        </Button>
+        <p className="text-[11px] leading-snug text-muted-foreground">
+          {t('engineControls.markers.clipMarkersNote')}
+        </p>
+      </div>
+    </PropertySection>
+  )
+}
