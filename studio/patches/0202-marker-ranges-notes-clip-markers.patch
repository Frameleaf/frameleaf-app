+import type { ReactNode } from 'react'
+import { fireEvent, render, screen } from '@testing-library/react'
+import { beforeEach, describe, expect, it, vi } from 'vite-plus/test'
+import { useTimelineStore } from '@/features/editor/deps/timeline-store'
+import { useSelectionStore } from '@/shared/state/selection'
+import { MarkerPanel } from './index'
+
+vi.mock('../components', () => ({
+  PropertySection: ({ children }: { children: ReactNode }) => <section>{children}</section>,
+  PropertyRow: ({ label, children }: { label: string; children: ReactNode }) => (
+    <label>
+      <span>{label}</span>
+      {children}
+    </label>
+  ),
+  NumberInput: ({ value, onChange }: { value: number; onChange: (value: number) => void }) => (
+    <input type="number" value={value} onChange={(event) => onChange(Number(event.target.value))} />
+  ),
+  ColorPicker: () => null,
+}))
+vi.mock('./marker-list', () => ({ MarkerList: () => null }))
+
+const marker = () => useTimelineStore.getState().markers.find((entry) => entry.id === 'mk-1')
+
+describe('marker ranges and notes (FL-1563)', () => {
+  beforeEach(() => {
+    useTimelineStore.setState({
+      fps: 30,
+      markers: [{ id: 'mk-1', frame: 90, color: '#3B82F6', label: 'Opening' }],
+    } as Partial<ReturnType<typeof useTimelineStore.getState>>)
+    useSelectionStore.getState().selectMarker('mk-1')
+  })
+
+  it('makes the marker a range with a length and a point again with none', () => {
+    render(<MarkerPanel />)
+    fireEvent.change(screen.getByLabelText('Length'), { target: { value: '180' } })
+    expect(marker()?.durationInFrames).toBe(180)
+    expect(screen.getByText(/00:03\.00/).textContent).toBe('00:03.00 – 00:09.00')
+
+    fireEvent.change(screen.getByLabelText('Length'), { target: { value: '0' } })
+    expect(marker()?.durationInFrames).toBeUndefined()
+  })
+
+  it('keeps a note with the marker and drops an emptied one', () => {
+    render(<MarkerPanel />)
+    fireEvent.change(screen.getByLabelText('Note'), {
+      target: { value: 'Hold on the lake before the title comes in.' },
+    })
+    expect(marker()?.note).toBe('Hold on the lake before the title comes in.')
+    fireEvent.change(screen.getByLabelText('Note'), { target: { value: '' } })
+    expect(marker()?.note).toBeUndefined()
+  })
+})
