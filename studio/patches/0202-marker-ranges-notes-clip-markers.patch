diff --git a/src/shared/timeline/clip-markers.test.ts b/src/shared/timeline/clip-markers.test.ts
new file mode 100644
index 0000000..d3a12b3
--- /dev/null
+++ b/src/shared/timeline/clip-markers.test.ts
@@ -0,0 +1,42 @@
+// @vitest-environment node
+
+import { describe, expect, it } from 'vite-plus/test'
+import { clipMarkerOffsetFrames, clipSourceFrameAt } from './clip-markers'
+
+describe('clip marker positions (FL-1563)', () => {
+  const clip = { durationInFrames: 90, sourceStart: 30, sourceEnd: 120, sourceFps: 30 }
+
+  it('places a marker by its source frame and drops one the trim leaves out', () => {
+    expect(clipMarkerOffsetFrames(clip, 30, 30)).toBe(0)
+    expect(clipMarkerOffsetFrames(clip, 75, 30)).toBe(45)
+    expect(clipMarkerOffsetFrames(clip, 29, 30)).toBeNull()
+    expect(clipMarkerOffsetFrames(clip, 120, 30)).toBeNull()
+  })
+
+  it('follows the source rate, the speed and a reversed clip', () => {
+    // 60 fps media on a 30 fps timeline: 60 source frames are one second, 30 timeline frames.
+    expect(clipMarkerOffsetFrames({ durationInFrames: 90, sourceFps: 60 }, 60, 30)).toBe(30)
+    expect(clipMarkerOffsetFrames({ ...clip, durationInFrames: 45, speed: 2 }, 90, 30)).toBe(30)
+    expect(clipMarkerOffsetFrames({ ...clip, isReversed: true }, 110, 30)).toBe(9)
+    // The window excludes sourceEnd both ways: 119 opens a reversed clip and 30 ends it.
+    expect(clipMarkerOffsetFrames({ ...clip, isReversed: true }, 119, 30)).toBe(0)
+    expect(clipMarkerOffsetFrames({ ...clip, isReversed: true }, 30, 30)).toBe(89)
+    expect(clipMarkerOffsetFrames({ ...clip, isReversed: true }, 120, 30)).toBeNull()
+    expect(
+      clipMarkerOffsetFrames({ durationInFrames: 90, sourceStart: 30, isReversed: true }, 40, 30),
+    ).toBeNull()
+  })
+
+  it('reads the source frame under a timeline frame, the inverse of placing it', () => {
+    expect(clipSourceFrameAt(clip, 45, 30)).toBe(75)
+    expect(clipSourceFrameAt({ ...clip, durationInFrames: 45, speed: 2 }, 30, 30)).toBe(90)
+    expect(clipSourceFrameAt({ ...clip, isReversed: true }, 10, 30)).toBe(109)
+    expect(clipSourceFrameAt(clip, 90, 30)).toBeNull()
+    expect(clipSourceFrameAt(clip, -1, 30)).toBeNull()
+    for (const item of [clip, { ...clip, isReversed: true }]) {
+      for (const offset of [0, 1, 44, 89]) {
+        expect(clipMarkerOffsetFrames(item, clipSourceFrameAt(item, offset, 30)!, 30)).toBe(offset)
+      }
+    }
+  })
+})
diff --git a/src/shared/timeline/clip-markers.ts b/src/shared/timeline/clip-markers.ts
new file mode 100644
index 0000000..6a2425e
--- /dev/null
+++ b/src/shared/timeline/clip-markers.ts
@@ -0,0 +1,46 @@
+/**
+ * Frameleaf (FL-1563): where a clip marker sits. A clip marker is kept in the clip's source frames
+ * at `sourceFps` (graph protocol 2.4), so it stays on the same moment of the media through moves,
+ * trims and slips; these convert between that and frames from the clip's start on the timeline.
+ */
+import type { TimelineItem } from '@/types/timeline'
+import { sourceToTimelineFrames, timelineToSourceFrames } from '@/shared/utils/source-calculations'
+
+type ClipTiming = Pick<
+  TimelineItem,
+  'durationInFrames' | 'sourceStart' | 'sourceEnd' | 'sourceFps' | 'speed' | 'isReversed'
+>
+
+/**
+ * Frames from the clip's start to a source frame, or null when the trim leaves that moment out
+ * (or a reversed clip does not say where its source ends).
+ */
+export function clipMarkerOffsetFrames(
+  item: ClipTiming,
+  sourceFrame: number,
+  fps: number,
+): number | null {
+  const speed = item.speed ?? 1
+  const sourceFps = item.sourceFps ?? fps
+  let distance = sourceFrame - (item.sourceStart ?? 0)
+  if (item.isReversed) {
+    if (item.sourceEnd === undefined) return null
+    // sourceEnd is exclusive in both directions: a reversed clip opens on sourceEnd - 1.
+    distance = item.sourceEnd - 1 - sourceFrame
+  }
+  if (distance < 0) return null
+  const offset = sourceToTimelineFrames(distance, speed, sourceFps, fps)
+  return offset < item.durationInFrames ? offset : null
+}
+
+/** The source frame showing `offsetFrames` after the clip's start, or null outside the clip. */
+export function clipSourceFrameAt(
+  item: ClipTiming,
+  offsetFrames: number,
+  fps: number,
+): number | null {
+  if (offsetFrames < 0 || offsetFrames >= item.durationInFrames) return null
+  const distance = timelineToSourceFrames(offsetFrames, item.speed ?? 1, fps, item.sourceFps ?? fps)
+  if (!item.isReversed) return (item.sourceStart ?? 0) + distance
+  return item.sourceEnd === undefined ? null : Math.max(0, item.sourceEnd - 1 - distance)
+}
