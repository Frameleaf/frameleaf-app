+import type { ReactNode } from 'react'
+import { fireEvent, render, screen } from '@testing-library/react'
+import { beforeEach, describe, expect, it, vi } from 'vite-plus/test'
+import type { VideoItem } from '@/types/timeline'
+
+const updateItem = vi.hoisted(() => vi.fn())
+const playback = vi.hoisted(() => ({ currentFrame: 0 }))
+vi.mock('react-i18next', () => ({
+  useTranslation: () => ({
+    t: (key: string, values?: Record<string, unknown>) =>
+      values ? `${key} ${JSON.stringify(values)}` : key,
+  }),
+}))
+vi.mock('@/features/editor/deps/timeline-store', () => ({
+  useTimelineStore: (select: (state: unknown) => unknown) => select({ updateItem, fps: 30 }),
+}))
+vi.mock('@/shared/state/playback', () => ({ usePlaybackStore: { getState: () => playback } }))
+vi.mock('../components', () => ({
+  PropertySection: ({ children }: { children: ReactNode }) => <section>{children}</section>,
+}))
+
+const { ClipMarkersSection } = await import('./clip-markers-section')
+
+const clip = (extra: Partial<VideoItem> = {}) =>
+  ({
+    id: 'clip',
+    type: 'video',
+    from: 100,
+    durationInFrames: 90,
+    sourceStart: 30,
+    sourceEnd: 120,
+    sourceFps: 30,
+    ...extra,
+  }) as VideoItem
+const marker = { id: 'm1', sourceFrame: 75, color: '#fff', label: 'Jamie waves' }
+
+describe('clip markers (FL-1563)', () => {
+  beforeEach(() => {
+    updateItem.mockClear()
+    playback.currentFrame = 0
+  })
+
+  it('lists a marker with where it sits in the clip, and one the trim leaves out', () => {
+    render(
+      <ClipMarkersSection
+        item={clip({ markers: [marker, { id: 'm2', sourceFrame: 10, color: '#fff' }] })}
+      />,
+    )
+    expect(screen.getByDisplayValue('Jamie waves')).toBeTruthy()
+    expect(screen.getByText('engineControls.markers.timeIn {"time":"00:01.15"}')).toBeTruthy()
+    expect(screen.getByText('engineControls.markers.trimmedOut')).toBeTruthy()
+  })
+
+  it('adds a marker on the source frame under the playhead', () => {
+    playback.currentFrame = 110
+    const uuid = vi
+      .spyOn(crypto, 'randomUUID')
+      .mockReturnValue('00000000-0000-4000-8000-000000000001')
+    render(<ClipMarkersSection item={clip()} />)
+    fireEvent.click(screen.getByRole('button', { name: /addClipMarker/ }))
+    expect(updateItem).toHaveBeenCalledWith('clip', {
+      markers: [
+        expect.objectContaining({ id: '00000000-0000-4000-8000-000000000001', sourceFrame: 40 }),
+      ],
+    })
+    uuid.mockRestore()
+  })
+
+  it('edits the name and note, and removing the last marker removes the field', () => {
+    render(<ClipMarkersSection item={clip({ markers: [marker] })} />)
+    fireEvent.change(screen.getByLabelText('engineControls.markers.note'), {
+      target: { value: 'Good for a cut' },
+    })
+    expect(updateItem).toHaveBeenLastCalledWith('clip', {
+      markers: [{ ...marker, note: 'Good for a cut' }],
+    })
+    fireEvent.change(screen.getByLabelText('engineControls.markers.name'), {
+      target: { value: '' },
+    })
+    expect(updateItem).toHaveBeenLastCalledWith('clip', {
+      markers: [{ ...marker, label: undefined }],
+    })
+    fireEvent.click(screen.getByRole('button', { name: 'engineControls.markers.removeClipMarker' }))
+    expect(updateItem).toHaveBeenLastCalledWith('clip', { markers: undefined })
+  })
+})
diff --git a/src/features/editor/components/properties-sidebar/clip-panel/clip-markers-section.tsx b/src/features/editor/components/properties-sidebar/clip-panel/clip-markers-section.tsx
