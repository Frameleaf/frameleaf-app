+/**
+ * WGSL mirror of `@/shared/graphics/color/managed-color` (FL-97). The CPU module is
+ * the specification; tools/color-output.browser.mjs checks this file against it.
+ */
+export const MANAGED_COLOR_WGSL = /* wgsl */ `
+const FL_PQ_M1: f32 = 0.1593017578125;
+const FL_PQ_M2: f32 = 78.84375;
+const FL_PQ_C1: f32 = 0.8359375;
+const FL_PQ_C2: f32 = 18.8515625;
+const FL_PQ_C3: f32 = 18.6875;
+const FL_PQ_PEAK: f32 = 10000.0;
+const FL_HLG_A: f32 = 0.17883277;
+const FL_HLG_B: f32 = 0.28466892;
+const FL_HLG_C: f32 = 0.55991073;
+const FL_HLG_PEAK: f32 = 1000.0;
+
+fn fl_srgb_decode(v: vec3f) -> vec3f {
+  let a = abs(v);
+  let curve = pow((a + vec3f(0.055)) / 1.055, vec3f(2.4));
+  return sign(v) * select(curve, a / 12.92, a <= vec3f(0.04045));
+}
+
+fn fl_srgb_encode(l: vec3f) -> vec3f {
+  let a = abs(l);
+  let curve = 1.055 * pow(a, vec3f(1.0 / 2.4)) - vec3f(0.055);
+  return sign(l) * select(curve, a * 12.92, a <= vec3f(0.0031308));
+}
+
+fn fl_bt709_to_bt2020(c: vec3f) -> vec3f {
+  return vec3f(
+    dot(vec3f(0.627404, 0.329282, 0.043314), c),
+    dot(vec3f(0.069097, 0.91954, 0.011361), c),
+    dot(vec3f(0.016392, 0.088013, 0.895595), c),
+  );
+}
+
+fn fl_pq_encode(nits: vec3f) -> vec3f {
+  let y = pow(clamp(nits / FL_PQ_PEAK, vec3f(0.0), vec3f(1.0)), vec3f(FL_PQ_M1));
+  return pow((vec3f(FL_PQ_C1) + FL_PQ_C2 * y) / (vec3f(1.0) + FL_PQ_C3 * y), vec3f(FL_PQ_M2));
+}
+
+fn fl_pq_encode1(nits: f32) -> f32 {
+  return fl_pq_encode(vec3f(nits)).x;
+}
+
+fn fl_pq_decode1(signal: f32) -> f32 {
+  let e = pow(clamp(signal, 0.0, 1.0), 1.0 / FL_PQ_M2);
+  return FL_PQ_PEAK * pow(max(e - FL_PQ_C1, 0.0) / (FL_PQ_C2 - FL_PQ_C3 * e), 1.0 / FL_PQ_M1);
+}
+
+fn fl_hlg_oetf(scene: vec3f) -> vec3f {
+  let e = clamp(scene, vec3f(0.0), vec3f(1.0));
+  let upper = FL_HLG_A * log(max(12.0 * e - vec3f(FL_HLG_B), vec3f(1.0e-12))) + vec3f(FL_HLG_C);
+  return select(upper, sqrt(3.0 * e), e <= vec3f(1.0 / 12.0));
+}
+
+fn fl_hlg_inverse_ootf(display: vec3f) -> vec3f {
+  // BT.2100 at the 1000 cd/m² nominal peak: system gamma 1.2.
+  let gamma = 1.2;
+  let yd = max(dot(vec3f(0.2627, 0.678, 0.0593), display), 0.0);
+  if (yd <= 0.0) { return vec3f(0.0); }
+  let ys = pow(yd / FL_HLG_PEAK, 1.0 / gamma);
+  return display / (FL_HLG_PEAK * pow(ys, gamma - 1.0));
+}
+
+// Working (extended sRGB, BT.709, 1.0 = reference white) -> BT.2020 display cd/m².
+fn fl_working_to_nits2020(working: vec3f, referenceWhite: f32) -> vec3f {
+  return max(fl_bt709_to_bt2020(fl_srgb_decode(working)), vec3f(0.0)) * referenceWhite;
+}
+
+fn fl_bt2390_eetf(nits: f32, sourcePeak: f32, targetPeak: f32) -> f32 {
+  if (nits <= 0.0) { return 0.0; }
+  if (targetPeak >= sourcePeak) { return min(nits, targetPeak); }
+  let maxSource = fl_pq_encode1(sourcePeak);
+  let e1 = fl_pq_encode1(nits) / maxSource;
+  let maxLum = fl_pq_encode1(targetPeak) / maxSource;
+  let ks = 1.5 * maxLum - 0.5;
+  var e2 = e1;
+  if (e1 > ks && ks < 1.0) {
+    let t = (e1 - ks) / (1.0 - ks);
+    let t2 = t * t;
+    let t3 = t2 * t;
+    e2 = (2.0 * t3 - 3.0 * t2 + 1.0) * ks + (t3 - 2.0 * t2 + t) * (1.0 - ks) + (-2.0 * t3 + 3.0 * t2) * maxLum;
+  }
+  return min(fl_pq_decode1(min(e2, 1.0) * maxSource), targetPeak);
+}
