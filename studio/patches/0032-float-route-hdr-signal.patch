+import { FULLSCREEN_QUAD_WGSL } from '@/infrastructure/gpu-shared/fullscreen-quad'
+import type { HdrTransfer, ResolvedColorManagement } from '@/shared/graphics/color/managed-color'
+import { MANAGED_COLOR_WGSL } from './managed-color-wgsl'
+
+/**
+ * The explicit output conversion of the managed colour graph (FL-97).
+ *
+ * - `sdr-display`: SDR monitoring or SDR delivery. Clips at reference white
+ *   unless the project names a tone-mapping policy ('bt2390').
+ * - `pq` / `hlg`: HDR delivery. Encodes BT.2020 signal values in [0, 1] for a
+ *   native encoder. Colours outside BT.2020 and light above the transfer's peak
+ *   are clipped here and nowhere earlier. No tone mapping is implied.
+ *
+ * Input is a straight-alpha working texture; output keeps straight alpha.
+ */
+export type ColorOutputTarget = 'sdr-display' | HdrTransfer
+
+const TARGET_INDEX: Record<ColorOutputTarget, number> = { 'sdr-display': 0, pq: 1, hlg: 2 }
+
+const SHADER = /* wgsl */ `
+${FULLSCREEN_QUAD_WGSL}
+${MANAGED_COLOR_WGSL}
+
+struct OutputParams {
+  outputTarget: u32,
+  toneMap: u32,
+  hdrWorking: u32,
+  _pad: u32,
+  referenceWhite: f32,
+  masteringPeak: f32,
+  _pad2: vec2f,
+};
+@group(0) @binding(0) var inputTex: texture_2d<f32>;
+@group(0) @binding(1) var<uniform> params: OutputParams;
+
+@fragment
+fn outputFragment(input: VertexOutput) -> @location(0) vec4f {
+  let c = textureLoad(inputTex, vec2i(input.position.xy), 0);
+  let alpha = clamp(c.a, 0.0, 1.0);
+  if (params.outputTarget == 1u) {
+    return vec4f(fl_pq_encode(fl_working_to_nits2020(c.rgb, params.referenceWhite)), alpha);
+  }
+  if (params.outputTarget == 2u) {
+    let display = min(fl_working_to_nits2020(c.rgb, params.referenceWhite), vec3f(FL_HLG_PEAK));
+    return vec4f(fl_hlg_oetf(fl_hlg_inverse_ootf(display)), alpha);
+  }
+  // SDR display: clip, or tone map an HDR project by its named policy.
+  if (params.hdrWorking == 0u || params.toneMap == 0u) {
+    return vec4f(clamp(c.rgb, vec3f(0.0), vec3f(1.0)), alpha);
+  }
+  let linear = fl_srgb_decode(c.rgb);
+  let y = dot(vec3f(0.2126, 0.7152, 0.0722), linear);
+  if (y <= 0.0) { return vec4f(clamp(c.rgb, vec3f(0.0), vec3f(1.0)), alpha); }
+  let nits = y * params.referenceWhite;
+  let scale = fl_bt2390_eetf(nits, params.masteringPeak, params.referenceWhite) / nits;
+  return vec4f(clamp(fl_srgb_encode(linear * scale), vec3f(0.0), vec3f(1.0)), alpha);
+}
+`
+
+export class ColorOutputPipeline {
+  private readonly pipelines = new Map<GPUTextureFormat, GPURenderPipeline>()
+  private readonly layout: GPUBindGroupLayout
+  private readonly module: GPUShaderModule
+  private readonly uniforms: GPUBuffer
+
+  constructor(private readonly device: GPUDevice) {
+    this.module = device.createShaderModule({ label: 'color-output', code: SHADER })
+    this.layout = device.createBindGroupLayout({
+      label: 'color-output-layout',
+      entries: [
+        {
+          binding: 0,
+          visibility: GPUShaderStage.FRAGMENT,
+          texture: { sampleType: 'unfilterable-float' },
+        },
+        { binding: 1, visibility: GPUShaderStage.FRAGMENT, buffer: { type: 'uniform' } },
+      ],
+    })
+    this.uniforms = device.createBuffer({
+      label: 'color-output-uniforms',
+      size: 32,
+      usage: GPUBufferUsage.UNIFORM | GPUBufferUsage.COPY_DST,
+    })
+  }
+
+  private pipeline(format: GPUTextureFormat): GPURenderPipeline {
+    let pipeline = this.pipelines.get(format)
+    if (!pipeline) {
+      pipeline = this.device.createRenderPipeline({
+        label: `color-output-${format}`,
+        layout: this.device.createPipelineLayout({ bindGroupLayouts: [this.layout] }),
+        vertex: { module: this.module, entryPoint: 'vertexMain' },
+        fragment: { module: this.module, entryPoint: 'outputFragment', targets: [{ format }] },
+        primitive: { topology: 'triangle-list' },
+      })
+      this.pipelines.set(format, pipeline)
+    }
+    return pipeline
+  }
+
+  /**
+   * Converts a working texture into `output` (same size; rgba16float, rgba32float
+   * or an 8-bit format for SDR display). Returns false for mismatched sizes.
+   * The uniforms are shared: when passing an encoder, submit it before the next
+   * conversion.
+   */
+  convert(
+    input: GPUTexture,
+    output: GPUTexture,
+    target: ColorOutputTarget,
+    color: ResolvedColorManagement,
+    commandEncoder?: GPUCommandEncoder,
+  ): boolean {
+    if (input.width !== output.width || input.height !== output.height) return false
+    const data = new ArrayBuffer(32)
+    const u32 = new Uint32Array(data, 0, 4)
+    const f32 = new Float32Array(data, 16, 2)
+    u32[0] = TARGET_INDEX[target]
+    u32[1] = color.sdrMonitoring === 'bt2390' ? 1 : 0
+    u32[2] = color.workingRange === 'hdr' ? 1 : 0
+    f32[0] = color.referenceWhiteNits
+    f32[1] = color.masteringPeakNits
+    this.device.queue.writeBuffer(this.uniforms, 0, data)
+    const bindGroup = this.device.createBindGroup({
+      layout: this.layout,
+      entries: [
+        { binding: 0, resource: input.createView() },
+        { binding: 1, resource: { buffer: this.uniforms } },
+      ],
+    })
+    const encoder = commandEncoder ?? this.device.createCommandEncoder()
+    const pass = encoder.beginRenderPass({
+      colorAttachments: [
+        { view: output.createView(), loadOp: 'clear', clearValue: [0, 0, 0, 0], storeOp: 'store' },
+      ],
+    })
+    pass.setPipeline(this.pipeline(output.format))
+    pass.setBindGroup(0, bindGroup)
+    pass.draw(6)
+    pass.end()
+    if (!commandEncoder) this.device.queue.submit([encoder.finish()])
+    return true
+  }
+
+  destroy(): void {
+    this.uniforms.destroy()
+  }
+}
