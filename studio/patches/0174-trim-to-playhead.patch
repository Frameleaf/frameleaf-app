+          useKeyframesStore.getState()._removeKeyframesForItems(result.removedIds)
+        }
+        applyTransitionRepairs([...affectedIds, ...result.affectedIds], new Set(result.removedIds))
+        requestPostEditWarmForItems([...affectedIds, ...result.affectedIds])
+      } else {
+        applyTransitionRepairs([...affectedIds])
+      }
+    },
+    { ids: [...ids], frame, handle },
+  )
+  return true
