+/** Trim only the explicitly selected crossing clips, preserving each linked group's offsets. */
+export function trimSelectedToPlayhead(
+  ids: readonly string[],
+  frame: number,
+  handle: 'start' | 'end',
+  ripple = false,
+): boolean {
+  if (!Number.isSafeInteger(frame) || ids.length === 0) return false
+  const { items, tracks, itemById } = useItemsStore.getState()
+  const selected = [...new Set(ids)]
+    .map((id) => itemById[id])
+    .filter(
+      (item): item is TimelineItem =>
+        !!item && item.from < frame && frame < item.from + item.durationInFrames,
+    )
+  if (selected.length === 0) return false
+  const groups: Array<{ anchor: TimelineItem; members: TimelineItem[]; delta: number }> = []
+  const planned = new Map<string, number>()
+  const fps = useTimelineSettingsStore.getState().fps
+  const transitions = useTransitionsStore.getState().transitions
+  const keyframes = useKeyframesStore.getState().keyframesByItemId
+  for (const anchor of selected) {
+    const delta =
+      handle === 'start' ? frame - anchor.from : frame - anchor.from - anchor.durationInFrames
+    if (planned.has(anchor.id)) {
+      if (planned.get(anchor.id) !== delta) return false
+      continue
+    }
+    const members = getLinkedItems(items, anchor.id)
+    const memberIds = new Set(members.map((item) => item.id))
+    for (const item of members) {
+      if (planned.has(item.id) && planned.get(item.id) !== delta) return false
+      if (
+        clampTrimAmount(item, handle, delta, fps).clampedAmount !== delta ||
+        clampToAdjacentItems(item, handle, delta, items, getTransitionLinkedIds(item.id)) !== delta
+      )
+        return false
+      if (
+        ripple &&
+        clampRippleTrimDeltaToPreserveEditState(
+          item,
+          handle,
+          delta,
+          items,
+          transitions,
+          keyframes,
+          fps,
+          memberIds,
+          false,
+        ) !== delta
+      )
+        return false
+      planned.set(item.id, delta)
+    }
+    groups.push({ anchor, members, delta })
+  }
+  const editedTracks = new Set(
+    items.filter((item) => planned.has(item.id)).map((item) => item.trackId),
+  )
+  const trackEdits = new Map<string, { end: number; shift: number; neighborIds: Set<string> }>()
+  const intervals: Array<{ start: number; end: number }> = []
+  if (ripple) {
+    for (const { members, delta } of groups) {
+      for (const item of members) {
+        // Simultaneous overlapping trims on one lane have no unambiguous ripple order.
+        if (trackEdits.has(item.trackId)) return false
+        const end = item.from + item.durationInFrames
+        const shift = handle === 'start' ? -delta : delta
+        trackEdits.set(item.trackId, {
+          end,
+          shift,
+          neighborIds: new Set(
+            transitions
+              .filter((transition) => transition.leftClipId === item.id)
+              .map((transition) => transition.rightClipId),
+          ),
+        })
+        intervals.push(
+          handle === 'start'
+            ? { start: item.from, end: item.from + delta }
+            : { start: end + shift, end },
+        )
+      }
+    }
+  }
+  const moved = new Map<string, number>()
+  if (ripple) {
+    for (const item of items) {
+      const edit = trackEdits.get(item.trackId)
+      if (planned.has(item.id)) {
+        if (handle === 'start') moved.set(item.id, -planned.get(item.id)!)
+      } else if (edit && (item.from >= edit.end || edit.neighborIds.has(item.id))) {
+        moved.set(item.id, edit.shift)
+      }
+    }
+    // Captions and linked downstream clips follow their owner even with sync lock disabled.
+    for (const [id, shift] of [...moved]) {
+      for (const linked of getLinkedItems(items, id)) {
+        if (moved.has(linked.id) && moved.get(linked.id) !== shift) return false
+        moved.set(linked.id, shift)
+      }
+    }
+    for (const [id, shift] of [...moved]) {
+      for (const captionId of getAttachedCaptionItemIds(items, id)) moved.set(captionId, shift)
+    }
+  }
+  const trimmedCaptions = new Set(
+    [...planned.keys()].flatMap((id) => getAttachedCaptionItemIds(items, id)),
+  )
+  const preview = new Map(
+    items.map((item) => {
+      const delta = planned.get(item.id)
+      const duration = delta === undefined ? item.durationInFrames : item.durationInFrames + (handle === 'start' ? -delta : delta)
+      const next = delta === undefined ? { ...item } : {
+        ...item, durationInFrames: duration,
+        from: item.from + (handle === 'start' ? delta : 0),
+        ...calculateTrimSourceUpdate(item, handle, delta, duration, fps),
+      }
+      next.from += moved.get(item.id) ?? 0
+      return [item.id, next] as const
+    }),
+  )
+  if ([...preview.values()].some((item) => item.from < 0 && !trimmedCaptions.has(item.id)))
+    return false
+  for (const transition of transitions) {
+    if (
+      ![transition.leftClipId, transition.rightClipId].some(
