+  muted: false,
+  solo: false,
+  items: [],
+  ...overrides,
+})
+const clip = (id: string, trackId = 'v', overrides: Partial<VideoItem> = {}): VideoItem => ({
+  id,
+  trackId,
+  type: 'video',
+  label: id,
+  src: 'blob:test',
+  from: 10,
+  durationInFrames: 60,
+  sourceStart: 20,
+  sourceEnd: 140,
+  sourceDuration: 300,
+  sourceFps: 60,
+  speed: 1,
+  ...overrides,
+})
+function load(items: TimelineItem[], tracks = [track('v'), track('a'), track('other')]) {
+  useTimelineStore.setState({ items, tracks, transitions: [], keyframes: [], markers: [] })
+  useTimelineCommandStore.getState().clearHistory()
+}
+const item = (id: string) => useItemsStore.getState().itemById[id]!
+
+describe('trim selected to playhead', () => {
+  beforeEach(() => {
+    useEditorStore.setState({ linkedSelectionEnabled: false })
+    useTimelineSettingsStore.setState({ fps: 30 })
+    load([clip('v')])
+  })
+  it.each(['start', 'end'] as const)(
+    'trims %s at exact source frames, with one undo and redo',
+    (handle) => {
+      const original = useItemsStore.getState().items
+      expect(trimSelectedToPlayhead(['v'], 30, handle)).toBe(true)
+      expect([
+        item('v').from,
+        item('v').durationInFrames,
+        item('v').sourceStart,
+        item('v').sourceEnd,
+      ]).toEqual(handle === 'start' ? [30, 40, 60, 140] : [10, 20, 20, 60])
+      const after = useItemsStore.getState().items
+      expect(useTimelineCommandStore.getState().undoStack).toHaveLength(1)
+      useTimelineCommandStore.getState().undo()
+      expect(useItemsStore.getState().items).toEqual(original)
+      useTimelineCommandStore.getState().redo()
+      expect(useItemsStore.getState().items).toEqual(after)
+    },
+  )
+  it.each([10, 70, NaN, 30.5])('refuses boundary/invalid frame %s without history', (frame) => {
+    expect(trimSelectedToPlayhead(['v'], frame, 'start')).toBe(false)
+    expect(useTimelineCommandStore.getState().undoStack).toHaveLength(0)
+  })
+  it('does not edit unselected clips or invent a selection', () => {
+    load([clip('v'), clip('a', 'a')])
+    expect(trimSelectedToPlayhead([], 30, 'start')).toBe(false)
+    expect(trimSelectedToPlayhead(['v'], 30, 'start')).toBe(true)
+    expect(item('a').from).toBe(10)
+  })
+  it('trims each linked pair once, including different source offsets with linked selection disabled', () => {
+    load([
+      clip('v', 'v', { linkedGroupId: 'pair' }),
+      clip('a', 'a', { linkedGroupId: 'pair', sourceStart: 40, sourceEnd: 160 }),
+    ])
+    expect(trimSelectedToPlayhead(['v', 'a', 'v'], 30, 'start')).toBe(true)
+    expect([item('v').sourceStart, item('a').sourceStart]).toEqual([60, 80])
+    expect([item('v').durationInFrames, item('a').durationInFrames]).toEqual([40, 40])
+    expect(useTimelineCommandStore.getState().undoStack).toHaveLength(1)
+  })
+  it('refuses a whole multi-selection when any linked participant is locked', () => {
+    load(
+      [
+        clip('v', 'v', { linkedGroupId: 'pair' }),
+        clip('a', 'a', { linkedGroupId: 'pair' }),
+        clip('b', 'other'),
+      ],
+      [track('v'), track('a', { locked: true }), track('other')],
+    )
+    expect(trimSelectedToPlayhead(['b', 'v'], 30, 'start')).toBe(false)
+    expect(item('b').from).toBe(10)
+    expect(useTimelineCommandStore.getState().undoStack).toHaveLength(0)
+  })
+  it.each(['start', 'end'] as const)(
+    'ripples %s on multiple selected lanes once and sync lanes once',
+    (handle) => {
+      load([
+        clip('v'),
+        clip('a', 'a'),
+        clip('tail-v', 'v', { from: 70 }),
+        clip('tail-a', 'a', { from: 70 }),
+        clip('sync', 'other', { from: 90 }),
+      ])
+      const original = useItemsStore.getState().items
+      expect(trimSelectedToPlayhead(['v', 'a'], 30, handle, true)).toBe(true)
+      const shift = handle === 'start' ? -20 : -40
+      expect([item('v').from, item('a').from]).toEqual([10, 10])
+      expect([item('tail-v').from, item('tail-a').from, item('sync').from]).toEqual([
+        70 + shift,
+        70 + shift,
+        90 + shift,
+      ])
+      expect(useTimelineCommandStore.getState().undoStack).toHaveLength(1)
+      useTimelineCommandStore.getState().undo()
+      expect(useItemsStore.getState().items).toEqual(original)
+    },
+  )
+  it('refuses ripple when a downstream linked move would edit a locked lane', () => {
+    load(
+      [
+        clip('v'),
+        clip('tail-v', 'v', { from: 70, linkedGroupId: 'tail' }),
+        clip('tail-a', 'a', { from: 70, linkedGroupId: 'tail' }),
+      ],
+      [track('v'), track('a', { locked: true })],
+    )
+    expect(trimSelectedToPlayhead(['v'], 30, 'start', true)).toBe(false)
+    expect(item('v').from).toBe(10)
+  })
+  it('keeps attached caption bounds and shifts them with a ripple start trim', () => {
+    const caption = {
+      id: 'caption',
+      type: 'text',
+      trackId: 'a',
+      from: 15,
+      durationInFrames: 50,
+      label: 'Caption',
+      text: 'Caption',
+      color: '#fff',
+      textRole: 'caption',
+      captionSource: { type: 'transcript', clipId: 'v', mediaId: 'media' },
+    } as TimelineItem
+    load([clip('v'), caption])
+    expect(trimSelectedToPlayhead(['v'], 30, 'start', true)).toBe(true)
+    expect([item('caption').from, item('caption').durationInFrames]).toEqual([10, 35])
+    useTimelineCommandStore.getState().undo()
+    expect([item('caption').from, item('caption').durationInFrames]).toEqual([15, 50])
+  })
+  it('refuses inherited locks on a sync lane before trimming any selected item', () => {
+    load(
+      [clip('v'), clip('sync', 'a', { from: 90 })],
+      [
+        track('v'),
+        track('group', { isGroup: true, locked: true }),
+        track('a', { parentTrackId: 'group' }),
+      ],
+    )
+    expect(trimSelectedToPlayhead(['v'], 30, 'start', true)).toBe(false)
+    expect(item('v').from).toBe(10)
+    expect(item('sync').from).toBe(90)
+  })
+  it('ripples unrelated items sharing the attached caption lane without moving captions twice', () => {
+    const caption = {
+      id: 'caption',
+      type: 'text',
+      trackId: 'a',
+      from: 15,
+      durationInFrames: 50,
+      label: 'Caption',
+      text: 'Caption',
+      color: '#fff',
+      textRole: 'caption',
+      captionSource: { type: 'transcript', clipId: 'v', mediaId: 'media' },
+    } as TimelineItem
+    load([clip('v'), caption, clip('later', 'a', { from: 90 })])
+    expect(trimSelectedToPlayhead(['v'], 30, 'start', true)).toBe(true)
+    expect(item('caption').from).toBe(10)
+    expect(item('later').from).toBe(70)
+  })
+  it('refuses atomically when a linked member cannot reach the requested boundary', () => {
+    load([
+      clip('v', 'v', { linkedGroupId: 'pair' }),
+      clip('a', 'a', { linkedGroupId: 'pair', durationInFrames: 10 }),
+      clip('b', 'other'),
+    ])
+    expect(trimSelectedToPlayhead(['b', 'v'], 30, 'start')).toBe(false)
+    expect(item('b').from).toBe(10)
+    expect(useTimelineCommandStore.getState().undoStack).toHaveLength(0)
+  })
+  it('removes the shared leading interval only once for selected clips of different lengths', () => {
+    load([
+      clip('v'),
+      clip('a', 'a', { durationInFrames: 100, sourceEnd: 220 }),
+      clip('sync', 'other', { from: 150 }),
+    ])
+    expect(trimSelectedToPlayhead(['v', 'a'], 30, 'start', true)).toBe(true)
+    expect([item('v').durationInFrames, item('a').durationInFrames, item('sync').from]).toEqual([
+      40, 80, 130,
+    ])
+    useTimelineCommandStore.getState().undo()
+    expect(item('sync').from).toBe(150)
+    useTimelineCommandStore.getState().redo()
+    expect(item('sync').from).toBe(130)
+  })
+
+  it('preserves a transition while ripple closes the temporary trim gap', () => {
+    load([clip('v'), clip('tail', 'v', { from: 70, sourceStart: 60, sourceEnd: 180 })])
+    addTransition('v', 'tail', 'crossfade', 6)
+    const transitions = useTransitionsStore.getState().transitions
+    expect(transitions).toHaveLength(1)
+    useTimelineCommandStore.getState().clearHistory()
+    expect(trimSelectedToPlayhead(['v'], 50, 'end', true)).toBe(true)
+    expect(item('tail').from).toBe(50)
+    expect(useTransitionsStore.getState().transitions).toEqual(transitions)
+  })
+  it('refuses an ordinary trim that would detach a transition', () => {
+    load([clip('v'), clip('tail', 'v', { from: 70, sourceStart: 60, sourceEnd: 180 })])
+    addTransition('v', 'tail', 'crossfade', 6)
+    useTimelineCommandStore.getState().clearHistory()
+    expect(trimSelectedToPlayhead(['v'], 50, 'end')).toBe(false)
+    expect(item('v').durationInFrames).toBe(60)
+    expect(useTransitionsStore.getState().transitions).toHaveLength(1)
+  })
+})
