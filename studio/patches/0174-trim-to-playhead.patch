+      if (ripple) {
+        const fresh = useItemsStore.getState()
+        fresh._moveItems(
+          [...moved].flatMap(([id, shift]) => {
+            const item = fresh.itemById[id]
+            return item ? [{ id, from: item.from + shift }] : []
+          }),
+        )
+        const result = propagateRemovedIntervalsToSyncLockedTracks({
+          editedTrackIds: syncExcluded,
+          intervals,
+          excludedItemIds: affectedIds,
