+      })
+      useSelectionStore.setState({ editKeyframePanelOpen: owner === 'keyframePanel' })
+      render(<Harness />)
+      for (const key of commands) act(() => registration(key)[1]({ preventDefault: vi.fn() }))
+      expect(useTimelineStore.getState().items).toEqual([original])
+      expect(useTimelineCommandStore.getState().undoStack).toHaveLength(0)
+    },
+  )
+  it('never binds a timeline edit directly to a typing control', () => {
+    const { getByLabelText } = render(<Harness />)
+    const input = getByLabelText('Editor input')
+    input.focus()
+    fireEvent.keyDown(input, { key: 'q' })
+    expect(useTimelineStore.getState().items).toEqual([original])
+  })
+})
