+      transcriptEditorShortcutScopeActive: false,
+    })
+    useKeyframeSelectionStore.setState({ selectedKeyframes: [] })
+    usePlaybackStore.setState({ currentFrame: 20, previewFrame: 40 })
+  })
+  it.each(commands)('registers configurable %s and disables typing surfaces', (key) => {
+    render(<Harness />)
+    const [, callback, options] = registration(key)
+    expect(options).toMatchObject({ ...HOTKEY_OPTIONS, enableOnContentEditable: false })
+    expect(sanitizeHotkeyOverrides({ [key]: 'alt+shift+9' })).toEqual({ [key]: 'alt+shift+9' })
+    act(() => callback({ preventDefault: vi.fn() }))
+    const item = useTimelineStore.getState().items[0]!
+    expect(item.durationInFrames).toBe(key.includes('BEFORE') ? 40 : 20)
+    expect(useTimelineCommandStore.getState().undoStack).toHaveLength(1)
+  })
+  it.each(['transcript', 'keyframe', 'keyframePanel'])(
+    'yields all trims to the %s editor',
