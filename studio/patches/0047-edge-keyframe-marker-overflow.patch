--- /dev/null
+++ b/src/features/keyframes/components/dopesheet-editor/edge-marker-overflow.test.tsx
@@ -0,0 +1,127 @@
+import { render, screen } from '@testing-library/react'
+import { beforeAll, describe, expect, it, vi } from 'vite-plus/test'
+import { DopesheetEditor } from './index'
+
+// Layout only: which box clips a keyframe marker. Real hit testing on both lane
+// edges is the hosted linked Edit-axis fixture's job.
+describe('DopesheetEditor edge keyframe markers', () => {
+  beforeAll(() => {
+    class ResizeObserverMock {
+      observe() {}
+      unobserve() {}
+      disconnect() {}
+    }
+
+    vi.stubGlobal('ResizeObserver', ResizeObserverMock)
+  })
+
+  const keyframesByProperty = {
+    x: [
+      { id: 'first', frame: 0, value: 0, easing: 'linear' as const },
+      { id: 'last', frame: 100, value: 10, easing: 'linear' as const },
+    ],
+  }
+
+  function markerBoxes(keyframeId: string) {
+    const marker = screen.getByTestId(`row-keyframe-x-${keyframeId}`)
+    const content = marker.parentElement as HTMLElement
+    const clip = content.parentElement as HTMLElement
+    const surface = clip.parentElement as HTMLElement
+    const cell = surface.parentElement as HTMLElement
+    const culler = cell.parentElement as HTMLElement
+    return { marker, content, clip, surface, cell, culler }
+  }
+
+  it('lets classic edge markers overflow the lane by half a marker', () => {
+    render(
+      <DopesheetEditor
+        itemId="item-1"
+        keyframesByProperty={keyframesByProperty}
+        frameViewport={{ startFrame: 0, endFrame: 100 }}
+        clampViewportToContent={false}
+        presentation="classic"
+        width={640}
+        height={240}
+      />,
+    )
+
+    const { marker, content, clip, surface, cell, culler } = markerBoxes('first')
+    // 640px editor - 248px property column - 1px cell border: a 391px axis
+    // that starts at the surface. 12px markers reach 6px past either end.
+    expect(surface).toHaveAttribute('data-motion-viewport-axis-width', '391')
+    expect(clip).toHaveAttribute('data-motion-keyframe-marker-clip')
+    expect(clip).toHaveClass('pointer-events-none', 'overflow-hidden')
+    expect(clip.style.left).toBe('-6px')
+    expect(clip.style.width).toBe('403px')
+    expect(clip.style.minWidth).toBe('calc(100% + 6px)')
+    expect(clip.style.maxWidth).toBe('calc(100% + 13px)')
+    expect(content).toHaveAttribute('data-motion-span-drag-visual')
+    expect(content.style.left).toBe('6px')
+    expect(marker).toHaveClass('pointer-events-auto')
+    expect(marker.style.left).toBe('0px')
+    expect(screen.getByTestId('row-keyframe-x-last').style.left).toBe('391px')
+
+    // Neither the cell nor its culling wrapper clips the marker layer...
+    expect(cell).not.toHaveClass('overflow-hidden')
+    expect(culler).not.toHaveClass('overflow-hidden')
+    // ...while everything else in the cell is still clipped by the lane.
+    const laneClip = surface.querySelector('[data-motion-lane-clip]') as HTMLElement
+    expect(laneClip).toHaveClass('absolute', 'inset-0', 'overflow-hidden')
+    expect(laneClip.querySelector('[data-motion-grid-frames]')).not.toBeNull()
+    expect(laneClip.querySelector('[data-testid="keyframe-connector"]')).not.toBeNull()
+    expect(laneClip.querySelector('[data-testid^="row-keyframe-"]')).toBeNull()
+
+    // The sheet viewport lends the markers its scrollbar strip as padding.
+    expect(screen.getByTestId('dopesheet-scroll-area')).toHaveStyle({
+      right: '0px',
+      paddingRight: '12px',
+    })
+  })
+
+  it('does not hand pointer input back to markers of a disabled editor', () => {
+    render(
+      <DopesheetEditor
+        itemId="item-1"
+        keyframesByProperty={keyframesByProperty}
+        frameViewport={{ startFrame: 0, endFrame: 100 }}
+        clampViewportToContent={false}
+        presentation="classic"
+        disabled
+        width={640}
+        height={240}
+      />,
+    )
+
+    const { marker, clip } = markerBoxes('first')
+    expect(clip).toHaveClass('pointer-events-none')
+    expect(marker).toBeDisabled()
+    expect(marker).not.toHaveClass('pointer-events-auto')
+  })
+
+  it('keeps the lane as the marker clip where the axis has an edge inset', () => {
+    render(
+      <DopesheetEditor
+        itemId="item-1"
+        keyframesByProperty={keyframesByProperty}
+        frameViewport={{ startFrame: 0, endFrame: 100 }}
+        clampViewportToContent={false}
+        width={640}
+        height={240}
+      />,
+    )
+
+    const { marker, content, clip, cell, culler } = markerBoxes('first')
+    expect(clip).toHaveClass('absolute', 'inset-0', 'overflow-hidden')
+    expect(clip).not.toHaveClass('pointer-events-none')
+    expect(marker).not.toHaveClass('pointer-events-auto')
+    expect(clip.getAttribute('style')).toBeNull()
+    expect(content).toHaveClass('absolute', 'inset-0')
+    expect(content.getAttribute('style')).toBeNull()
+    // The inset keeps the frame-0 marker inside the lane.
+    expect(marker.style.left).toBe('9px')
+    expect(cell).toHaveClass('overflow-hidden')
+    expect(culler).toHaveClass('overflow-hidden')
+    expect(screen.getByTestId('dopesheet-scroll-area')).toHaveStyle({ right: '12px' })
+    expect(screen.getByTestId('dopesheet-scroll-area').style.paddingRight).toBe('')
+  })
+})
