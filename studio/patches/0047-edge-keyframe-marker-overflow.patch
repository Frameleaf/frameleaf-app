 export const KEYFRAME_DIAMOND_RENDERED_WIDTH_PX =
   Math.SQRT2 * KEYFRAME_DIAMOND_SIDE_PX
 export const KEYFRAME_EDGE_INSET = Math.ceil((Math.sqrt(2) * KEYFRAME_BUTTON_SIZE) / 2)
+const KEYFRAME_MARKER_HALF_WIDTH_PX = KEYFRAME_BUTTON_SIZE / 2
 
+/** Furthest a marker layer may reach past the right edge of its lane. */
+const KEYFRAME_MARKER_MAX_LANE_OVERFLOW_PX = KEYFRAME_MARKER_HALF_WIDTH_PX + 1
+
+export interface KeyframeMarkerLayerBox {
+  /** Clip of the marker layer, relative to the cell surface. */
+  clip: { left: number; width: number; minWidth: string; maxWidth: string }
+  /** Left of the marker content inside the clip: back at the surface origin. */
+  contentLeft: number
+}
+
+/**
+ * Horizontal box that clips the keyframe markers of a timeline cell whose axis
+ * has no edge inset, or `null` when the lane itself is the clip.
+ *
+ * With an edge inset, markers stay inside the lane and the lane clips them, as
+ * it always did. An axis without one centres the key of its first or last
+ * frame on the lane edge, where a lane clip leaves less than half of the
+ * marker reachable. The marker layer is then clipped half a marker outside the
+ * axis instead, so a marker on either edge is drawn and hit whole. A key
+ * panned off the axis still disappears, and nothing but markers leaves the
+ * lane.
+ *
+ * `axisOriginOffset` is how far the axis origin lies left of the cell
+ * surface. Whatever axis width is reported, the right edge never clips inside
+ * the lane and stays within `KEYFRAME_MARKER_MAX_LANE_OVERFLOW_PX` of it,
+ * inside the scrollbar strip the sheet lends it.
+ */
+export function getKeyframeMarkerLayerBox(
+  axisWidth: number,
+  axisOriginOffset: number | undefined,
+): KeyframeMarkerLayerBox | null {
+  if (axisOriginOffset === undefined) return null
+
+  const overflowLeft = axisOriginOffset + KEYFRAME_MARKER_HALF_WIDTH_PX
+  return {
+    clip: {
+      left: -overflowLeft,
+      // Half a marker either side of the axis...
+      width: axisWidth + KEYFRAME_MARKER_HALF_WIDTH_PX * 2,
+      // ...but at least to the lane's right edge, and at most just past it.
+      // Percentages are of the surface, the lane's own width.
+      minWidth: `calc(100% + ${overflowLeft}px)`,
+      maxWidth: `calc(100% + ${overflowLeft + KEYFRAME_MARKER_MAX_LANE_OVERFLOW_PX}px)`,
+    },
+    contentLeft: overflowLeft,
+  }
+}
+
 function getFrameRange(viewport: Viewport): number {
   return Math.max(1, viewport.endFrame - viewport.startFrame)
 }
