+  it('is SDR for SDR, unprobed or missing media and for items without media', () => {
+    const items = [
+      { type: 'video', mediaId: 'sdr' },
+      { type: 'image', mediaId: 'legacy' },
+      { type: 'video', mediaId: 'gone' },
+      { type: 'text' },
+    ]
+    expect(deriveSourceWorkingRange([track(items)], get)).toBe('sdr')
+  })
+
+  it('is HDR once any placed clip is PQ or HLG', () => {
+    const tracks = [
+      track([{ type: 'video', mediaId: 'sdr' }]),
+      track([{ type: 'video', mediaId: 'hlg' }]),
+    ]
+    expect(deriveSourceWorkingRange(tracks, get)).toBe('hdr')
