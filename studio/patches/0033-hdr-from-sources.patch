+import type { TimelineItem, TimelineTrack } from '@/types/timeline'
+import type { MediaMetadata } from '@/types/storage'
+import { workingRangeOfSources, type WorkingRange } from '@/shared/graphics/color/managed-color'
+
+interface CompositionSource {
+  tracks?: TimelineTrack[]
+  items?: TimelineItem[]
+}
+
+/**
+ * FL-97 owner decision: a project is HDR when it places a PQ or HLG source,
+ * directly or inside a nested composition.
+ */
+export function deriveSourceWorkingRange(
+  tracks: readonly TimelineTrack[],
+  getMedia: (mediaId: string) => Pick<MediaMetadata, 'colorTransfer'> | undefined,
+  compositionById: Record<string, CompositionSource | undefined> = {},
+): WorkingRange {
+  const seen = new Set<string>()
+  function* transfers(items: readonly TimelineItem[]): Generator<string | undefined> {
+    for (const item of items) {
+      if (item.type === 'composition') {
+        if (seen.has(item.compositionId)) continue
+        seen.add(item.compositionId)
+        const sub = compositionById[item.compositionId]
+        if (!sub) continue
+        yield* transfers(sub.items ?? (sub.tracks ?? []).flatMap((track) => track.items ?? []))
+        continue
+      }
+      const mediaId = 'mediaId' in item ? (item as { mediaId?: string }).mediaId : undefined
+      if (mediaId) yield getMedia(mediaId)?.colorTransfer
+    }
+  }
+  return workingRangeOfSources(transfers(tracks.flatMap((track) => track.items ?? [])))
+}
