+  const media: Record<string, { colorTransfer?: 'sdr' | 'pq' | 'hlg' | 'hdr' }> = {
+    sdr: { colorTransfer: 'sdr' },
+    pq: { colorTransfer: 'pq' },
+    hlg: { colorTransfer: 'hlg' },
+    hostHdr: { colorTransfer: 'hdr' },
+    legacy: {},
+  }
+  const get = (id: string) => media[id]
