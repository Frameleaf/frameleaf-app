+  expect(node.port.close).toHaveBeenCalled()
+  const replacementNode = nodes[1]!
+  release()
+  expect(replacementNode.disconnect).toHaveBeenCalled()
+  expect(replacementNode.port.close).toHaveBeenCalled()
+  release()
+  expect(node.disconnect).toHaveBeenCalled()
+  expect(node.port.close).toHaveBeenCalled()
+  expect(node.port.onmessage).toBeNull()
+  expect(mute.mock.lastCall![0]).toBe(0)
+  clock.dispose()
+})
