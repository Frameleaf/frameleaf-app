+import { masterGainAtFrame, validateMasterGainEnvelope, type MasterGainPoint } from './master-audio'
+
+export { cadenceFromFps } from './audio-clock-cadence'
+export interface MasterAudioEpoch {
+  rootId: string
+  contextId: string
+  generation: number
+  contextTime: number
+  frame: number
+  num: number
+  den: number
+  rate: number
+  running: boolean
+  loop: boolean
+  firstFrame: number
+  lastFrame: number
+  gainDb: number
+  muted: boolean
+  points: readonly MasterGainPoint[]
+}
+export function masterFrameAtTime(
+  epoch: Pick<
+    MasterAudioEpoch,
+    | 'contextTime'
+    | 'frame'
+    | 'num'
+    | 'den'
+    | 'rate'
+    | 'running'
+    | 'loop'
+    | 'firstFrame'
+    | 'lastFrame'
+  >,
+  time: number,
+): number {
+  const x =
+    epoch.frame +
+    (epoch.running ? ((time - epoch.contextTime) * epoch.rate * epoch.num) / epoch.den : 0)
+  const length = epoch.lastFrame - epoch.firstFrame + 1
+  return epoch.loop ? epoch.firstFrame + ((((x - epoch.firstFrame) % length) + length) % length) : x
+}
+export function masterFrameAtSample(
+  epoch: MasterAudioEpoch,
+  sample: number,
+  sampleRate: number,
+): number {
+  // Multiply the integer sample delta before dividing: exact loop boundaries must not
+  // fall on the previous side merely because t was rounded before conversion to frames.
+  const x =
+    epoch.frame +
+    (epoch.running
+      ? ((sample - epoch.contextTime * sampleRate) * epoch.rate * epoch.num) /
+        (epoch.den * sampleRate)
+      : 0)
+  const length = epoch.lastFrame - epoch.firstFrame + 1
+  return epoch.loop ? epoch.firstFrame + ((((x - epoch.firstFrame) % length) + length) % length) : x
+}
+export function validateMasterEpoch(value: MasterAudioEpoch): MasterAudioEpoch {
+  if (
+    !value ||
+    typeof value.rootId !== 'string' ||
+    !value.rootId ||
+    typeof value.contextId !== 'string' ||
+    !value.contextId ||
+    !Number.isSafeInteger(value.generation) ||
+    value.generation < 0 ||
+    !Number.isFinite(value.contextTime) ||
+    value.contextTime < 0 ||
+    !Number.isFinite(value.frame) ||
+    !Number.isSafeInteger(value.num) ||
+    value.num <= 0 ||
+    !Number.isSafeInteger(value.den) ||
+    value.den <= 0 ||
+    !Number.isFinite(value.rate) ||
+    value.rate === 0 ||
+    typeof value.running !== 'boolean' ||
+    typeof value.loop !== 'boolean' ||
+    !Number.isSafeInteger(value.firstFrame) ||
+    value.firstFrame < 0 ||
+    !Number.isSafeInteger(value.lastFrame) ||
+    value.lastFrame < value.firstFrame ||
+    !Number.isFinite(value.gainDb) ||
+    value.gainDb < -60 ||
+    value.gainDb > 12 ||
+    typeof value.muted !== 'boolean'
+  )
+    throw new Error('Invalid master audio epoch')
+  return Object.freeze({
+    ...value,
+    points: Object.freeze(
+      validateMasterGainEnvelope(value.points).map((point) => Object.freeze(point)),
+    ),
+  })
+}
+/** Pure processor core; the production worklet uses exactly this per-sample authority. */
+export class MasterGainProcessor {
+  private epoch: MasterAudioEpoch | null = null
+  private generation = -1
+  constructor(
+    private readonly rootId: string,
+    private readonly contextId: string,
+  ) {}
+  replaceMasterEpoch(value: MasterAudioEpoch): boolean {
+    if (
+      !value ||
+      value.rootId !== this.rootId ||
+      value.contextId !== this.contextId ||
+      value.generation <= this.generation
+    )
+      return false
+    if (!Number.isSafeInteger(value.generation) || value.generation < 0) {
+      this.epoch = null
+      return false
+    }
+    try {
+      const epoch = validateMasterEpoch(value)
+      this.epoch = epoch
+      this.generation = epoch.generation
+      return true
+    } catch {
+      this.epoch = null
+      this.generation = value.generation
+      return false
+    }
+  }
+  process(
+    input: Float32Array[],
+    output: Float32Array[],
+    firstSample: number,
+    sampleRate: number,
+  ): void {
+    const epoch = this.epoch
+    for (let i = 0; i < (output[0]?.length ?? 0); i++) {
+      const time = (firstSample + i) / sampleRate
+      const frame = epoch ? masterFrameAtSample(epoch, firstSample + i, sampleRate) : 0
+      const gain =
+        epoch &&
+        epoch.running &&
+        !epoch.muted &&
+        time >= epoch.contextTime &&
+        (epoch.loop || (frame >= epoch.firstFrame && frame < epoch.lastFrame + 1))
+          ? masterGainAtFrame(epoch.points, frame, epoch.gainDb)
+          : 0
+      for (let channel = 0; channel < output.length; channel++)
+        output[channel]![i] = (input[channel]?.[i] ?? 0) * gain
+    }
+  }
+}
