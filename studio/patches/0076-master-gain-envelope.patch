+    destination: {},
+    createGain: () => ({ gain: { value: 1, setValueAtTime: mute }, connect() {}, disconnect() {} }),
+    addEventListener() {},
+    removeEventListener() {},
+  } as unknown as AudioContext
+  const clock = new Clock({ fps: 30, durationInFrames: 100 })
+  const release = bindPreviewMasterBus(clock, context)
+  clock.play()
+  await vi.waitFor(() =>
+    expect(usePlaybackStore.getState().masterPreviewError).toBe(
+      'Master audio preview requires supported Web Audio processing.',
+    ),
+  )
+  expect(mute.mock.calls.every((call) => call[0] === 0)).toBe(true)
+  release()
+  clock.dispose()
+})
