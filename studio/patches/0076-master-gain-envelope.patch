+/** Mirrors the editor's exact integer or broadcast cadence admission. */
+export function cadenceFromFps(fps: number): { num: number; den: number } {
+  if (Number.isSafeInteger(fps) && fps > 0) return { num: fps, den: 1 }
+  for (const num of [24000, 30000, 48000, 60000, 120000]) {
+    if (Math.abs(fps - num / 1001) < 1e-9 || Math.round((num / 1001) * 1000) / 1000 === fps)
+      return { num, den: 1001 }
+  }
+  throw new Error('Unsupported audio clock cadence')
+}
