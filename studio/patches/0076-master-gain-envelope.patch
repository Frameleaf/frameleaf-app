@@ -0,0 +1,141 @@
+import { cadenceFromFps } from './audio-clock-cadence'
+
+/** Project-global linear dB points, evaluated in each root's own frame domain. */
+export interface MasterGainPoint {
+  id: string
+  frame: number
+  gainDb: number
+}
+export interface MasterAudioState {
+  masterBusDb?: number
+  masterBusMuted?: boolean
+  masterGainEnvelope?: readonly MasterGainPoint[]
+  masterOriginFrame?: number
+  fps: number
+}
+
+export function validateMasterGainEnvelope(value: unknown): MasterGainPoint[] {
+  if (!Array.isArray(value) || value.length > 4096) throw new Error('Invalid master gain envelope')
+  const ids = new Set<string>()
+  const frames = new Set<number>()
+  const points = value.map((point: unknown) => {
+    if (!point || typeof point !== 'object' || Array.isArray(point))
+      throw new Error('Invalid master gain point')
+    const p = point as Record<string, unknown>
+    if (
+      Object.keys(p).some((key) => !['id', 'frame', 'gainDb'].includes(key)) ||
+      typeof p.id !== 'string' ||
+      !p.id ||
+      [...p.id].length > 128 ||
+      ids.has(p.id) ||
+      typeof p.frame !== 'number' ||
+      !Number.isSafeInteger(p.frame) ||
+      p.frame < 0 ||
+      frames.has(p.frame) ||
+      typeof p.gainDb !== 'number' ||
+      !Number.isFinite(p.gainDb) ||
+      p.gainDb < -60 ||
+      p.gainDb > 12
+    ) {
+      throw new Error('Invalid master gain point')
+    }
+    ids.add(p.id)
+    frames.add(p.frame)
+    return { id: p.id, frame: p.frame, gainDb: p.gainDb }
+  })
+  return points.sort((a, b) => a.frame - b.frame)
+}
+
+export function masterGainAtFrame(
+  points: readonly MasterGainPoint[] = [],
+  frame: number,
+  fallbackDb = 0,
+): number {
+  if (!points.length) return 10 ** (fallbackDb / 20)
+  if (frame <= points[0]!.frame) return 10 ** (points[0]!.gainDb / 20)
+  const last = points[points.length - 1]!
+  if (frame >= last.frame) return 10 ** (last.gainDb / 20)
+  // Worklet samples cannot scan up to 4096 points each; locate the enclosing segment.
+  let lo = 1,
+    hi = points.length - 1
+  while (lo < hi) {
+    const mid = Math.floor((lo + hi) / 2)
+    if (points[mid]!.frame <= frame) lo = mid + 1
+    else hi = mid
+  }
+  const right = points[lo]!,
+    left = points[lo - 1]!
+  const db =
+    left.gainDb + ((right.gainDb - left.gainDb) * (frame - left.frame)) / (right.frame - left.frame)
+  return 10 ** (db / 20)
+}
+
+export function applyMasterGain(
+  planes: Float32Array[],
+  state: MasterAudioState,
+  sampleRate: number,
+  sampleStart = 0,
+): void {
+  const origin = state.masterOriginFrame ?? 0
+  const { num, den } = cadenceFromFps(state.fps)
+  for (let i = 0; i < (planes[0]?.length ?? 0); i++) {
+    const gain = state.masterBusMuted
+      ? 0
+      : masterGainAtFrame(
+          state.masterGainEnvelope,
+          origin + ((sampleStart + i) * num) / (den * sampleRate),
+          state.masterBusDb,
+        )
+    for (const plane of planes) plane[i] = plane[i]! * gain
+  }
+}
+
+export interface MasterAudioTransport {
+  contextTime: number
+  frame: number
+  fps: number
+  rate: number
+  running: boolean
+  firstFrame: number
+  lastFrame: number
+  loop?: boolean
+}
+
+/** Finite native schedule (not repeated-loop authority; root worklet owns preview gain). */
+export function scheduleMasterEnvelope(
+  param: AudioParam,
+  points: readonly MasterGainPoint[],
