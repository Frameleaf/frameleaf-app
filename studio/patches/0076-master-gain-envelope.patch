+afterEach(() => {
+  vi.unstubAllGlobals()
+  usePlaybackStore
+    .getState()
+    .setMasterAudio({ masterBusDb: 0, masterBusMuted: false, masterGainEnvelope: [] })
+})
+it('gates loading and every replacement on its exact ACK, and retires disconnected root owners', async () => {
+  vi.stubGlobal('requestAnimationFrame', () => 1)
+  vi.stubGlobal('cancelAnimationFrame', () => {})
+  let loaded!: () => void
+  const moduleReady = new Promise<void>((resolve) => {
+    loaded = resolve
+  })
+  const nodes: Node[] = [],
+    gains: ReturnType<typeof gain>[] = []
+  function gain() {
+    return {
+      gain: { value: 1, setValueAtTime: vi.fn() },
+      connect: vi.fn(),
+      disconnect: vi.fn(),
+      channelInterpretation: 'speakers',
+    }
+  }
+  class Node {
+    port = {
+      postMessage: vi.fn(),
+      onmessage: null as null | ((event: { data: unknown }) => void),
+      close: vi.fn(),
+    }
+    onprocessorerror: unknown
+    connect = vi.fn()
+    disconnect = vi.fn()
+    constructor(
+      _context: unknown,
+      _name: unknown,
+      readonly options: unknown,
+    ) {
+      nodes.push(this)
+    }
+  }
+  vi.stubGlobal('AudioWorkletNode', Node)
+  const context = {
+    currentTime: 0,
+    state: 'running',
+    audioWorklet: { addModule: () => moduleReady },
+    destination: {},
+    createGain: () => {
+      const node = gain()
+      gains.push(node)
+      return node
+    },
+    addEventListener() {},
+    removeEventListener() {},
+  } as unknown as AudioContext
+  const clock = new Clock({ fps: 30, durationInFrames: 100, loop: true })
+  const release = bindPreviewMasterBus(clock, context)
+  clock.play()
+  expect(nodes).toHaveLength(0)
+  expect(gains[1]!.gain.value).toBe(0)
+  loaded()
+  await vi.waitFor(() => expect(nodes).toHaveLength(1))
+  const node = nodes[0]!,
+    mute = gains[1]!.gain.setValueAtTime
+  const latest = () => node.port.postMessage.mock.lastCall![0] as MasterAudioEpoch
+  const acknowledge = (epoch: MasterAudioEpoch, accepted = true) =>
+    node.port.onmessage?.({
+      data: {
+        rootId: epoch.rootId,
+        contextId: epoch.contextId,
+        generation: epoch.generation,
+        accepted,
+      },
+    })
+  const before = latest()
+  clock.seekToFrame(20)
+  const next = latest()
+  expect(next.generation).toBeGreaterThan(before.generation)
+  expect(next.frame).toBe(20)
+  acknowledge(before)
+  expect(mute.mock.lastCall![0]).toBe(0)
+  acknowledge({ ...next, rootId: 'foreign' })
+  expect(mute.mock.lastCall![0]).toBe(0)
+  acknowledge(next)
+  expect(mute.mock.lastCall![0]).toBe(1)
+  usePlaybackStore
+    .getState()
+    .setMasterAudio({ masterGainEnvelope: [{ id: 'a', frame: 0, gainDb: -20 }] })
+  expect(mute.mock.lastCall![0]).toBe(0)
+  const curve = latest()
+  expect(curve.points).toEqual([{ id: 'a', frame: 0, gainDb: -20 }])
+  acknowledge(next)
+  expect(mute.mock.lastCall![0]).toBe(0)
+  acknowledge(curve)
+  expect(mute.mock.lastCall![0]).toBe(1)
+  Object.defineProperty(context, 'state', { value: 'suspended', writable: true })
+  clock.getAudioTransportSnapshot()
+  const closed = latest()
+  Object.defineProperty(context, 'state', { value: 'running', writable: true })
+  // Snapshot reading itself can discover a changed time source and synchronously publish
+  // a replacement. An ACK checked before that read must not open the newer epoch.
+  acknowledge(closed)
+  expect(mute.mock.lastCall![0]).toBe(0)
+  const resumed = latest()
+  expect(resumed.generation).toBeGreaterThan(closed.generation)
+  acknowledge(resumed)
+  expect(mute.mock.lastCall![0]).toBe(1)
+  const replacement = { ...context, currentTime: 5 } as AudioContext
+  getPreviewMasterInput(clock, replacement)
+  await vi.waitFor(() => expect(nodes).toHaveLength(2))
