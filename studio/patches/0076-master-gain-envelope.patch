+import { MasterGainProcessor, type MasterAudioEpoch } from '@/shared/utils/master-audio-epoch'
+
+declare const currentFrame: number
+declare const sampleRate: number
+declare abstract class AudioWorkletProcessor {
+  readonly port: MessagePort
+  constructor(options?: unknown)
+}
+declare function registerProcessor(
+  name: string,
+  constructor: new (options: {
+    processorOptions: { rootId: string; contextId: string }
+  }) => AudioWorkletProcessor,
+): void
+
+class RootMasterProcessor extends AudioWorkletProcessor {
+  private readonly processor: MasterGainProcessor
+  constructor(options: { processorOptions: { rootId: string; contextId: string } }) {
+    super()
+    const { rootId, contextId } = options.processorOptions
+    this.processor = new MasterGainProcessor(rootId, contextId)
+    this.port.onmessage = (event: MessageEvent<MasterAudioEpoch>) => {
+      const epoch = event.data
+      const accepted = this.processor.replaceMasterEpoch(epoch)
+      this.port.postMessage({ rootId, contextId, generation: epoch.generation, accepted })
+    }
+  }
+  process(inputs: Float32Array[][], outputs: Float32Array[][]): boolean {
+    this.processor.process(inputs[0] ?? [], outputs[0] ?? [], currentFrame, sampleRate)
+    return true
+  }
+}
+registerProcessor('frameleaf-root-master', RootMasterProcessor)
