+import type { Clock } from '@/runtime/composition-runtime/deps/player'
+import { usePlaybackStore } from '@/shared/state/playback'
+import { type MasterAudioEpoch } from '@/shared/utils/master-audio-epoch'
+import moduleUrl from '../worklets/master-gain-processor.worklet.ts?worker&url'
+
+interface RootBus {
+  context: AudioContext
+  input: GainNode
+  mute: GainNode
+  release: () => void
+  active: boolean
+  owner: object | null
+  publish: () => void
+}
+const roots = new WeakMap<Clock, RootBus>()
+const modules = new WeakMap<AudioContext, Promise<void>>()
+function loadRootMasterProcessor(context: AudioContext): Promise<void> {
+  let loaded = modules.get(context)
+  if (!loaded) {
+    loaded = context.audioWorklet.addModule(moduleUrl)
+    modules.set(context, loaded)
+  }
+  return loaded
+}
+/** Explicit root ownership. Loading and unacknowledged epochs are always silent. */
+export function getPreviewMasterInput(clock: Clock, context: AudioContext): GainNode {
+  const old = roots.get(clock)
+  if (old && old.context === context) return old.input
+  const owner = old?.owner ?? null
+  const active = old?.active ?? false
+  old?.release()
+  const input = context.createGain()
+  input.channelInterpretation = 'discrete'
+  const mute = context.createGain()
+  mute.channelInterpretation = 'discrete'
+  mute.gain.value = 0
+  mute.connect(context.destination)
+  let disposed = false
+  let failed = false
+  let processor: AudioWorkletNode | null = null
+  let loaded = false
+  let generation = 0
+  let pending: MasterAudioEpoch | null = null
+  let pendingClockGeneration = -1
+  const fail = () => {
+    failed = true
+    mute.gain.setValueAtTime(0, context.currentTime)
+    usePlaybackStore.setState({
+      masterPreviewError: 'Master audio preview requires supported Web Audio processing.',
+    })
+  }
+  const publish = () => {
+    if (disposed || failed) return
+    // Gate the old epoch before posting a whole replacement. Only its exact ACK reopens it.
+    mute.gain.setValueAtTime(0, context.currentTime)
+    if (!loaded || !bus.active) return
+    const anchor = clock.getAudioTransportSnapshot()
+    if (anchor.context !== context || !anchor.contextId) return
+    if (!processor) {
+      processor = new AudioWorkletNode(context, 'frameleaf-root-master', {
+        numberOfInputs: 1,
