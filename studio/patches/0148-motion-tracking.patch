+import { useEffect, useRef, useState } from 'react'
+import { useTranslation } from 'react-i18next'
+import { useShallow } from 'zustand/react/shallow'
+import { Crosshair, Trash2 } from 'lucide-react'
+import { toast } from 'sonner'
+import { Button } from '@/components/ui/button'
+import type { TimelineItem } from '@/types/timeline'
+import {
+  analyzeMotionTrack,
+  applyMotionTrack,
+  listMotionTracks,
+  removeMotionTrack,
+  useKeyframesStore,
+  useTimelineStore,
+  type MotionTrackResult,
+} from '@/features/editor/deps/timeline-store'
+import { usePlaybackStore } from '@/shared/state/playback'
+import { PropertyRow, PropertySection } from '../components'
+
+/**
+ * Track motion (FL-596). Place this clip over the subject at the playhead,
+ * choose the video to track, and apply the reviewed path as editable x, y,
+ * width and height keyframes. Tracking never claims a result is privacy-safe:
+ * every frame needs review.
+ */
+export function MotionTrackSection({ item }: { item: TimelineItem }) {
+  const { t } = useTranslation()
+  // Video clip names only, so dragging clips does not re-render this panel.
+  const sources = useTimelineStore(useShallow((s) => s.items
+    .filter((candidate) => candidate.type === 'video' && candidate.id !== item.id)
+    .map((candidate) => `${candidate.id}\u0000${candidate.label}`)))
+  const tracks = useKeyframesStore(useShallow(() => listMotionTracks(item.id)))
+  const [sourceId, setSourceId] = useState('')
+  const [direction, setDirection] = useState<'forward' | 'backward'>('forward')
+  const [progress, setProgress] = useState<string | null>(null)
+  const [result, setResult] = useState<MotionTrackResult | null>(null)
+  const [keepTrackedPart, setKeepTrackedPart] = useState(false)
+  const [replaceExisting, setReplaceExisting] = useState(false)
+  const abortRef = useRef<AbortController | null>(null)
+  useEffect(() => () => abortRef.current?.abort(), [])
+
+  if (item.type === 'audio') return null
+
+  const track = async () => {
+    abortRef.current?.abort()
+    const controller = new AbortController()
+    abortRef.current = controller
+    setResult(null)
+    setKeepTrackedPart(false)
+    setReplaceExisting(false)
+    setProgress(t('editor.motionTrack.decoding', { done: 0, total: '…' }))
+    try {
+      const analysis = await analyzeMotionTrack(sourceId, item.id, usePlaybackStore.getState().currentFrame, direction, {
+        signal: controller.signal,
+        onProgress: (done, total) => setProgress(t('editor.motionTrack.decoding', { done, total })),
+      })
+      // A superseded run (cancelled, or the source or direction changed) never writes its result.
+      if (controller.signal.aborted) return
+      if (analysis.ok) setResult(analysis.result)
+      else toast.warning(t(`editor.motionTrack.refusal.${analysis.reason}`))
+    } catch (error) {
+      if (!controller.signal.aborted && !(error instanceof DOMException && error.name === 'AbortError')) toast.error(t('editor.motionTrack.refusal.decode-failed'))
+    } finally {
+      if (abortRef.current === controller) setProgress(null)
+    }
+  }
+
+  const apply = () => {
+    if (!result) return
+    const outcome = applyMotionTrack(result, { keepTrackedPart, replaceExisting })
+    if (outcome.ok) {
+      toast.success(t('editor.motionTrack.applied', { count: result.values.length }))
+      setResult(null)
+    } else {
+      toast.warning(t(`editor.motionTrack.applyRefusal.${outcome.reason}`))
+    }
+  }
+
+  const lost = result?.lostFrames ?? []
+  return (
+    <PropertySection title={t('editor.motionTrack.title')} icon={Crosshair} defaultOpen={false}>
+      <PropertyRow label={t('editor.motionTrack.source')}>
+        <select
+          className="h-7 w-full rounded-md border border-input bg-transparent px-2 text-xs"
+          aria-label={t('editor.motionTrack.source')}
+          value={sourceId}
+          onChange={(event) => { abortRef.current?.abort(); setSourceId(event.target.value); setResult(null) }}
+        >
+          <option value="">{t('editor.motionTrack.chooseSource')}</option>
+          {sources.map((entry) => {
+            const [id, label] = entry.split('\u0000')
+            return <option key={id} value={id}>{label}</option>
+          })}
+        </select>
+      </PropertyRow>
+      <PropertyRow label={t('editor.motionTrack.direction')}>
+        <div className="flex w-full gap-1" role="radiogroup" aria-label={t('editor.motionTrack.direction')}>
+          {(['forward', 'backward'] as const).map((value) => (
+            <Button key={value} role="radio" aria-checked={direction === value} size="sm"
+              variant={direction === value ? 'secondary' : 'ghost'} className="h-7 flex-1 text-xs"
+              onClick={() => { abortRef.current?.abort(); setDirection(value); setResult(null) }}>
+              {t(`editor.motionTrack.${value}`)}
+            </Button>
+          ))}
+        </div>
+      </PropertyRow>
+
+      <div className="space-y-1 px-1 py-2 text-xs" aria-live="polite">
+        {progress && <p>{progress}</p>}
+        {result && (
+          <>
+            <p>{t('editor.motionTrack.tracked', { count: result.values.length })}</p>
+            {lost.length > 0 && (
+              <>
+                <p className="text-amber-500">{t('editor.motionTrack.lost', { frame: lost[0], count: lost.length })}</p>
+                <label className="flex items-center gap-2">
+                  <input type="checkbox" checked={keepTrackedPart} onChange={(event) => setKeepTrackedPart(event.target.checked)} />
+                  {t('editor.motionTrack.keepTrackedPart')}
+                </label>
+              </>
+            )}
+            <label className="flex items-center gap-2">
+              <input type="checkbox" checked={replaceExisting} onChange={(event) => setReplaceExisting(event.target.checked)} />
+              {t('editor.motionTrack.replaceExisting')}
+            </label>
+          </>
+        )}
+        <p className="text-muted-foreground">{t('editor.motionTrack.note')}</p>
+      </div>
+
+      <div className="flex items-center gap-2 px-1 pb-2">
+        {progress ? (
+          <Button variant="ghost" size="sm" className="h-7 flex-1 text-xs" onClick={() => abortRef.current?.abort()}>
+            {t('editor.motionTrack.cancel')}
+          </Button>
+        ) : (
+          <Button variant="ghost" size="sm" className="h-7 flex-1 text-xs" disabled={!sourceId} onClick={() => void track()}>
+            {t('editor.motionTrack.track')}
+          </Button>
+        )}
+        <Button size="sm" className="h-7 flex-1 text-xs" disabled={!result || !!progress || (lost.length > 0 && !keepTrackedPart)} onClick={apply}>
+          {t('editor.motionTrack.apply')}
+        </Button>
+      </div>
+
+      {tracks.map((applicationId, index) => (
+        <PropertyRow key={applicationId} label={t('editor.motionTrack.appliedTrack', { n: index + 1 })}>
+          <Button variant="ghost" size="sm" className="h-7 text-xs"
+            onClick={() => removeMotionTrack(item.id, applicationId)}
+            aria-label={t('editor.motionTrack.remove', { n: index + 1 })}>
+            <Trash2 className="mr-1 h-3.5 w-3.5" />
+            {t('editor.motionTrack.removeShort')}
+          </Button>
+        </PropertyRow>
+      ))}
+    </PropertySection>
+  )
+}
