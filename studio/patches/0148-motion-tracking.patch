+// @vitest-environment node
+
+import { beforeEach, describe, expect, it } from 'vite-plus/test'
+import type { TextItem, TimelineTrack, VideoItem } from '@/types/timeline'
+import { useItemsStore } from '../../items-store'
+import { useKeyframesStore } from '../../keyframes-store'
+import { useTimelineCommandStore } from '../../timeline-command-store'
+import { useTimelineSettingsStore } from '../../timeline-settings-store'
+import { canvasToSource, followTrack, sourceToCanvas } from '../../../utils/motion-track-mapping'
+import {
+  analyzeMotionTrack,
+  applyMotionTrack,
+  listMotionTracks,
+  motionTrackBinding,
+  removeMotionTrack,
+  type MotionTrackResult,
+} from './motion-track-actions'
+
+const track = (id: string, locked = false) => ({
+  id, name: id, order: 0, height: 80, locked, syncLock: true, visible: true, muted: false,
+  solo: false, volume: 0, items: [], kind: 'video',
+}) as TimelineTrack
+
+const source = (overrides: Partial<VideoItem> = {}): VideoItem => ({
+  id: 'v1', type: 'video', trackId: 't1', from: 0, durationInFrames: 120, label: 'Shot', src: 'blob:v',
+  mediaId: 'm1', sourceStart: 0, sourceEnd: 120, sourceFps: 30, sourceWidth: 1920, sourceHeight: 1080, ...overrides,
+} as VideoItem)
+
+const title = (overrides: Partial<TextItem> = {}): TextItem => ({
+  id: 'title', type: 'text', trackId: 't1', from: 10, durationInFrames: 100, label: 'Name', text: 'Name',
+  color: '#fff', transform: { x: 100, y: -50, width: 200, height: 80 }, ...overrides,
+} as TextItem)
+
+/** A result as analysis would produce it for the current items. */
+function resultFor(
+  values: MotionTrackResult['values'],
+  lostFrames: number[] = [],
+  direction: MotionTrackResult['direction'] = 'forward',
+  frames = [20, 21, 22, 23],
+): MotionTrackResult {
+  const { itemById } = useItemsStore.getState()
+  return {
+    sourceId: 'v1', targetId: 'title',
+    binding: motionTrackBinding(itemById['v1']!, itemById['title']!, 20, direction),
+    direction, frames, samples: [], values, lostFrames,
+  }
+}
+
+const path: MotionTrackResult['values'] = [
+  { frame: 20, x: 100, y: -50, width: 200, height: 80 },
+  { frame: 21, x: 110, y: -45, width: 210, height: 84 },
+  { frame: 22, x: 120, y: -40, width: 220, height: 88 },
+]
+
+const keysOf = (property: string) => useKeyframesStore.getState().keyframesByItemId['title']?.properties
+  .find((entry) => entry.property === property)?.keyframes.map((keyframe) => [keyframe.frame, keyframe.value]) ?? []
+
+describe('motion track mapping', () => {
+  const clip = { sourceWidth: 1920, sourceHeight: 1080, x: 0, y: 0, width: 960, height: 540 }
+
+  it('maps between canvas and source through the clip transform', () => {
+    const box = { cx: 50, cy: -20, width: 100, height: 60 }
+    const inSource = canvasToSource(clip, box)
+    expect(inSource).toEqual({ cx: 1060, cy: 500, width: 200, height: 120 })
+    expect(sourceToCanvas(clip, inSource)).toEqual(box)
+  })
+
+  it('keeps the target offset from the tracked box and scales about it', () => {
+    const seed = canvasToSource(clip, { cx: 0, cy: 0, width: 100, height: 100 })
+    const moved = { ...canvasToSource(clip, { cx: 30, cy: 10, width: 200, height: 200 }), confidence: 1, lost: false }
+    const values = followTrack(clip, [{ ...seed, confidence: 1, lost: false }, moved], [5, 6], { x: 50, y: 0, width: 40, height: 20 })
+    expect(values[0]).toEqual({ frame: 5, x: 50, y: 0, width: 40, height: 20 })
+    // Box doubled about its centre: the 50 px offset doubles too.
+    expect(values[1]).toEqual({ frame: 6, x: 130, y: 10, width: 80, height: 40 })
+  })
+})
+
+describe('motion track actions', () => {
+  beforeEach(() => {
+    useTimelineCommandStore.getState().clearHistory()
+    useTimelineSettingsStore.setState({ fps: 30, isDirty: false })
+    useItemsStore.getState().setTracks([track('t1'), track('t2', true)])
+    useItemsStore.getState().setItems([source(), title()])
+    useKeyframesStore.getState().setKeyframes([])
+  })
+
+  it('refuses sources it cannot map safely before decoding anything', async () => {
+    useItemsStore.getState().setItems([source({ transform: { rotation: 10 } }), title()])
+    await expect(analyzeMotionTrack('v1', 'title', 20, 'forward')).resolves.toEqual({ ok: false, reason: 'source-transform' })
+    useItemsStore.getState().setItems([source({ isReversed: true }), title()])
+    await expect(analyzeMotionTrack('v1', 'title', 20, 'forward')).resolves.toEqual({ ok: false, reason: 'reversed' })
+    useItemsStore.getState().setItems([source(), title()])
+    await expect(analyzeMotionTrack('v1', 'title', 115, 'forward')).resolves.toEqual({ ok: false, reason: 'no-overlap' })
+    await expect(analyzeMotionTrack('v1', 'v1', 20, 'forward')).resolves.toEqual({ ok: false, reason: 'same-clip' })
+  })
+
+  it('applies x, y, width and height keys relative to the target, then removes them as one application', async () => {
+    const outcome = applyMotionTrack(resultFor(path))
+    expect(outcome.ok).toBe(true)
+    // Frames 9 and 13 pin the target's own values just outside the track, so it is unchanged there.
+    expect(keysOf('x')).toEqual([[9, 100], [10, 100], [11, 110], [12, 120], [13, 100]])
+    // The pins carry the height as shown (the title's resolved box), not its stored transform.
+    expect(keysOf('height')).toEqual([[9, 104], [10, 80], [11, 84], [12, 88], [13, 104]])
+    const [applicationId] = listMotionTracks('title')
+    expect(applicationId).toBe(outcome.ok ? outcome.applicationId : '')
+
+    expect(removeMotionTrack('title', applicationId!)).toBe(true)
+    // The pins belong to the track, so removing it restores the untouched target.
+    expect(keysOf('x')).toEqual([])
+    useTimelineCommandStore.getState().undo()
+    expect(keysOf('x')).toHaveLength(5)
+  })
+
+  it('blocks unreviewed lost frames, and keeps the tracked part only when told to', async () => {
+    const result = resultFor(path, [23])
+    expect(applyMotionTrack(result)).toEqual({ ok: false, reason: 'unreviewed-lost' })
+    expect(applyMotionTrack(result, { keepTrackedPart: true }).ok).toBe(true)
+  })
+
+  it('does not overwrite existing keys in the range unless replacement is confirmed, and undo restores them', async () => {
+    useKeyframesStore.getState()._addKeyframes([
+      { itemId: 'title', property: 'x', frame: 11, value: -999 },
+      { itemId: 'title', property: 'x', frame: 50, value: 7 },
+      { itemId: 'title', property: 'opacity', frame: 11, value: 0.5 },
+    ])
+    const result = resultFor(path)
+    expect(applyMotionTrack(result)).toEqual({ ok: false, reason: 'conflict' })
+    expect(applyMotionTrack(result, { replaceExisting: true }).ok).toBe(true)
+    // Before the range x held -999, so it is pinned at 9; after it, the key at 50 keeps its own curve.
+    expect(keysOf('x')).toEqual([[9, -999], [10, 100], [11, 110], [12, 120], [50, 7]])
+    expect(keysOf('opacity')).toEqual([[11, 0.5]])
+    useTimelineCommandStore.getState().undo()
+    expect(keysOf('x')).toEqual([[11, -999], [50, 7]])
+  })
+
+  it('refuses a result whose clips changed since tracking', async () => {
+    const result = resultFor(path)
+    useItemsStore.getState()._updateItem('title', { transform: { x: 0, y: 0, width: 200, height: 80 } })
+    expect(applyMotionTrack(result)).toEqual({ ok: false, reason: 'stale' })
+    expect(keysOf('x')).toEqual([])
+  })
+
+  it('treats a result as stale when the target position or size keys change', () => {
+    const result = resultFor(path)
+    useKeyframesStore.getState()._addKeyframes([{ itemId: 'title', property: 'x', frame: 70, value: 3 }])
+    expect(applyMotionTrack(result)).toEqual({ ok: false, reason: 'stale' })
+  })
+
+  it('applies a one-frame backward result instead of calling it stale', () => {
+    expect(applyMotionTrack(resultFor([path[0]!], [], 'backward', [20]), {})).toMatchObject({ ok: true })
+  })
+
+  it('refuses to remove a track from a locked target', () => {
+    const outcome = applyMotionTrack(resultFor(path))
+    if (!outcome.ok) throw new Error(outcome.reason)
+    useItemsStore.getState().setTracks([track('t1', true)])
+    expect(removeMotionTrack('title', outcome.applicationId)).toBe(false)
+  })
+
+  it('asks before tracking inside an existing animation, which would change it outside the range', () => {
+    useKeyframesStore.getState()._addKeyframes([
+      { itemId: 'title', property: 'x', frame: 0, value: 0, easing: 'ease-in-out' },
+      { itemId: 'title', property: 'x', frame: 50, value: 500, easing: 'ease-in-out' },
+    ])
+    expect(applyMotionTrack(resultFor(path))).toEqual({ ok: false, reason: 'conflict' })
+    expect(applyMotionTrack(resultFor(path), { replaceExisting: true }).ok).toBe(true)
+  })
+})
