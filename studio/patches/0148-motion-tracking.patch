diff --git a/src/shared/utils/motion-tracker.test.ts b/src/shared/utils/motion-tracker.test.ts
new file mode 100644
--- /dev/null
+++ b/src/shared/utils/motion-tracker.test.ts
@@ -0,0 +1,100 @@
+import { describe, expect, it } from 'vite-plus/test'
+import { checkSeed, createRegionTracker, trackRegion, type GrayFrame, type TrackBox } from './motion-tracker'
+
+// Analysis frames are 480x270, a quarter of 1080p; errors are reported at 1080p (x4).
+const W = 480
+const H = 270
+const TO_1080 = 1920 / W
+
+function seeded(seed: number) {
+  let state = seed >>> 0
+  return () => {
+    state = (state * 1664525 + 1013904223) >>> 0
+    return state / 2 ** 32
+  }
+}
+
+// A fixed random texture the target is drawn from, sampled in its own normalised coordinates.
+const TEXTURE_SIZE = 32
+const random = seeded(7)
+const TEXTURE = Float32Array.from({ length: TEXTURE_SIZE * TEXTURE_SIZE }, () => 0.15 + 0.7 * random())
+
+function textureAt(u: number, v: number): number {
+  const x = Math.min(TEXTURE_SIZE - 1, Math.max(0, u * TEXTURE_SIZE - 0.5))
+  const y = Math.min(TEXTURE_SIZE - 1, Math.max(0, v * TEXTURE_SIZE - 0.5))
+  const x0 = Math.floor(x), y0 = Math.floor(y)
+  const x1 = Math.min(TEXTURE_SIZE - 1, x0 + 1), y1 = Math.min(TEXTURE_SIZE - 1, y0 + 1)
+  const fx = x - x0, fy = y - y0
+  const t = (i: number, j: number) => TEXTURE[j * TEXTURE_SIZE + i]!
+  return (t(x0, y0) * (1 - fx) + t(x1, y0) * fx) * (1 - fy) + (t(x0, y1) * (1 - fx) + t(x1, y1) * fx) * fy
+}
+
+function render(box: TrackBox, occluded = false): GrayFrame {
+  const data = new Float32Array(W * H)
+  for (let y = 0; y < H; y += 1) {
+    for (let x = 0; x < W; x += 1) {
+      const u = (x + 0.5 - (box.cx - box.width / 2)) / box.width
+      const v = (y + 0.5 - (box.cy - box.height / 2)) / box.height
+      const background = 0.4 + 0.1 * Math.sin(x / 37) * Math.cos(y / 29)
+      data[y * W + x] = !occluded && u >= 0 && u < 1 && v >= 0 && v < 1 ? textureAt(u, v) : background
+    }
+  }
+  return { width: W, height: H, data }
+}
+
+/** A known path: across and down while growing 30%. */
+function pathAt(index: number, count: number): TrackBox {
+  const t = index / (count - 1)
+  const size = 40 * (1 + 0.3 * t)
+  return { cx: 100 + 260 * t, cy: 90 + 70 * Math.sin(t * Math.PI), width: size, height: size }
+}
+
+describe('trackRegion', () => {
+  it('keeps the centre within 5 px and size within 5% at 1080p on at least 95% of frames', () => {
+    const count = 60
+    const truth = Array.from({ length: count }, (_, i) => pathAt(i, count))
+    const samples = trackRegion(truth.map((box) => render(box)), truth[0]!)
+    expect(samples.every((sample) => !sample.lost)).toBe(true)
+    const good = samples.filter((sample, i) => {
+      const expected = truth[i]!
+      const centre = Math.hypot(sample.cx - expected.cx, sample.cy - expected.cy) * TO_1080
+      return centre <= 5
+        && Math.abs(sample.width / expected.width - 1) <= 0.05
+        && Math.abs(sample.height / expected.height - 1) <= 0.05
+    })
+    expect(good.length / count).toBeGreaterThanOrEqual(0.95)
+  })
+
+  it('marks the track lost at an occlusion instead of bridging it, and a reseed tracks on', () => {
+    const count = 40
+    const truth = Array.from({ length: count }, (_, i) => pathAt(i, count))
+    const frames = truth.map((box, i) => render(box, i >= 20 && i < 26))
+    const first = trackRegion(frames, truth[0]!)
+    const lostFrom = first.findIndex((sample) => sample.lost)
+    expect(lostFrom).toBeGreaterThanOrEqual(19)
+    expect(lostFrom).toBeLessThanOrEqual(21)
+    expect(first.slice(lostFrom).every((sample) => sample.lost)).toBe(true)
+
+    // The editor reseeds after the occlusion: a second, separate segment.
+    const second = trackRegion(frames.slice(26), truth[26]!)
+    expect(second.every((sample) => !sample.lost)).toBe(true)
+  })
+
+  it('refuses seeds outside the frame or without texture', () => {
+    const frame = render(pathAt(0, 2))
+    expect(checkSeed(frame, { cx: 5, cy: 5, width: 40, height: 40 })).toBe('outside-frame')
+    expect(checkSeed(frame, { cx: 400, cy: 200, width: 10, height: 10 })).toBe('low-texture')
+    expect(checkSeed(frame, pathAt(0, 2))).toBeNull()
+  })
+
+  it('tracks incrementally, one frame at a time, and stays lost once lost', () => {
+    const count = 30
+    const truth = Array.from({ length: count }, (_, i) => pathAt(i, count))
+    const frames = truth.map((box, i) => render(box, i >= 10))
+    const tracker = createRegionTracker(frames[0]!, truth[0]!)
+    const samples = [tracker.first, ...frames.slice(1).map((frame) => tracker.next(frame))]
+    expect(samples).toEqual(trackRegion(frames, truth[0]!))
+    expect(tracker.lost).toBe(true)
+    expect(samples.slice(10).every((sample) => sample.lost)).toBe(true)
+  })
+})
