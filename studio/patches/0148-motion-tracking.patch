+import type { TimelineItem, VideoItem } from '@/types/timeline'
+import type { AnimationKeyframeSource } from '@/types/keyframe'
+import { useItemsStore } from '../../items-store'
+import { useKeyframesStore, type KeyframeAddPayload } from '../../keyframes-store'
+import { useTimelineSettingsStore } from '../../timeline-settings-store'
+import { execute } from '../shared'
+import { hasLockedEditParticipants } from '../linked-edit'
+import { importMediaLibraryService } from '@/features/timeline/deps/media-library-service'
+import { getSourceDimensions, resolveItemTransformAtFrame, resolveTransform } from '@/features/timeline/deps/composition-runtime'
+import { useProjectStore } from '@/features/timeline/deps/projects'
+import { timelineToSourceFrames } from '../../../utils/source-calculations'
+import { canvasToSource, followTrack, type PlacedClip, type TrackedValue } from '../../../utils/motion-track-mapping'
+import { checkSeed, createRegionTracker, MOTION_TRACKER_ALGORITHM, type GrayFrame, type RegionTracker, type TrackSample } from '@/shared/utils/motion-tracker'
+
+const MOTION_TRACK_PRESET_ID = 'frameleaf.motion-track'
+/** Tracking runs on frames this wide; boxes are scaled back to source pixels. */
+const ANALYSIS_WIDTH = 480
+const MAX_TRACK_FRAMES = 900
+const TRACKED_PROPERTIES = ['x', 'y', 'width', 'height'] as const
+
+export type MotionTrackRefusal =
+  | 'not-found'
+  | 'unsupported-source'
+  | 'unsupported-target'
+  | 'same-clip'
+  | 'source-transform'
+  | 'reversed'
+  | 'vector-keys'
+  | 'no-overlap'
+  | 'outside-frame'
+  | 'low-texture'
+  | 'decode-failed'
+
+export interface MotionTrackResult {
+  sourceId: string
+  targetId: string
+  binding: string
+  direction: 'forward' | 'backward'
+  /** Timeline frames tracked, in tracking order, starting at the seed frame. */
+  frames: number[]
+  samples: TrackSample[]
+  /** Target transform per tracked frame (lost frames omitted). */
+  values: TrackedValue[]
+  /** Timeline frames that were lost, in order; empty when the whole range tracked. */
+  lostFrames: number[]
+}
+
+export type MotionTrackAnalysis =
+  | { ok: true; result: MotionTrackResult }
+  | { ok: false; reason: MotionTrackRefusal }
+
+function canvasSize(): { width: number; height: number; fps: number } {
+  const metadata = useProjectStore.getState().currentProject?.metadata
+  return { width: metadata?.width ?? 1920, height: metadata?.height ?? 1080, fps: useTimelineSettingsStore.getState().fps }
+}
+
+function hasKeyframes(itemId: string, properties: readonly string[]): boolean {
+  const record = useKeyframesStore.getState().keyframesByItemId[itemId]
+  return !!record?.properties.some((property) => properties.includes(property.property) && property.keyframes.length > 0)
+}
+
+/** The source clip as drawn: no rotation, crop, corner pin, flips or animated transform. */
+function placedClip(item: VideoItem): PlacedClip | MotionTrackRefusal {
+  const dimensions = getSourceDimensions(item)
+  if (!dimensions) return 'unsupported-source'
+  const transform = item.transform
+  if ((transform?.rotation ?? 0) !== 0 || transform?.flipHorizontal || transform?.flipVertical
+    || item.crop || item.cornerPin
+    || hasKeyframes(item.id, ['x', 'y', 'width', 'height', 'rotation', 'position', 'scale', 'anchor'])) {
+    return 'source-transform'
+  }
+  const resolved = resolveTransform(item, canvasSize(), dimensions)
+  return { sourceWidth: dimensions.width, sourceHeight: dimensions.height, x: resolved.x, y: resolved.y, width: resolved.width, height: resolved.height }
+}
+
+/** Binds a track to the clips' source, timing, transforms, seed frame and canvas. */
+export function motionTrackBinding(source: TimelineItem, target: TimelineItem, seedFrame: number, direction: 'forward' | 'backward'): string {
+  const video = source as VideoItem
+  return JSON.stringify([
+    MOTION_TRACKER_ALGORITHM, source.id, source.mediaId, video.sourceStart ?? video.trimStart ?? 0, video.sourceEnd ?? null, video.speed ?? 1,
+    video.sourceFps ?? null,
+    source.from, source.durationInFrames, source.transform ?? null, target.id, target.from, target.transform ?? null,
+    // The source mapping's refusal inputs: a change to any of them changes where tracked points land.
+    video.crop ?? null, video.cornerPin ?? null, video.isReversed === true,
+    (useKeyframesStore.getState().keyframesByItemId[source.id]?.properties ?? [])
+      .map((property) => [property.property, property.keyframes.map((keyframe) => [keyframe.frame, keyframe.value, keyframe.easing])]),
+    // The target's own position and size keys decide its seed box, so edits to them make a result stale.
+    (useKeyframesStore.getState().keyframesByItemId[target.id]?.properties ?? [])
+      .filter((property) => (TRACKED_PROPERTIES as readonly string[]).includes(property.property))
+      .map((property) => [property.property, property.keyframes.map((keyframe) => [keyframe.frame, keyframe.value, keyframe.easing])]),
+    seedFrame, direction, canvasSize(),
+  ])
+}
+
+function sourceSecondsAt(item: VideoItem, frame: number, fps: number): number {
+  const sourceFps = item.sourceFps ?? fps
+  // Older clips carry the trim as trimStart; playback reads it the same way.
+  const sourceStart = item.sourceStart ?? item.trimStart ?? 0
+  const sourceFrame = sourceStart + timelineToSourceFrames(frame - item.from, item.speed ?? 1, fps, sourceFps)
+  // sourceEnd is exclusive: the last shown frame must not map past it into unshown footage.
+  const last = item.sourceEnd !== undefined ? Math.max(sourceStart, item.sourceEnd - 1) : Infinity
+  return Math.min(sourceFrame, last) / sourceFps
+}
+
+function toGray(canvas: OffscreenCanvas | HTMLCanvasElement): GrayFrame {
+  const context = canvas.getContext('2d') as CanvasRenderingContext2D | OffscreenCanvasRenderingContext2D | null
+  if (!context) throw new Error('no 2d context')
+  const { data } = context.getImageData(0, 0, canvas.width, canvas.height)
+  const gray = new Float32Array(canvas.width * canvas.height)
+  for (let i = 0; i < gray.length; i += 1) {
+    gray[i] = (0.2126 * data[i * 4]! + 0.7152 * data[i * 4 + 1]! + 0.0722 * data[i * 4 + 2]!) / 255
+  }
+  return { width: canvas.width, height: canvas.height, data: gray }
+}
+
+/**
+ * Track the region under the target (at the seed frame) through the source
+ * clip, forward to the end of their overlap or backward to its start. The
+ * target's own box is the tracking box: place it over the subject first.
+ * Nothing in the project changes.
+ */
+export async function analyzeMotionTrack(
+  sourceId: string,
+  targetId: string,
+  seedFrame: number,
+  direction: 'forward' | 'backward',
+  options: { signal?: AbortSignal; onProgress?: (done: number, total: number) => void } = {},
+): Promise<MotionTrackAnalysis> {
+  const items = useItemsStore.getState().items
+  const source = items.find((item) => item.id === sourceId)
+  const target = items.find((item) => item.id === targetId)
+  if (!source || !target) return { ok: false, reason: 'not-found' }
+  if (sourceId === targetId) return { ok: false, reason: 'same-clip' }
+  if (source.type !== 'video') return { ok: false, reason: 'unsupported-source' }
+  if (source.isReversed === true) return { ok: false, reason: 'reversed' }
+  if (target.type === 'audio') return { ok: false, reason: 'unsupported-target' }
+  if (hasKeyframes(targetId, ['position', 'scale'])) return { ok: false, reason: 'vector-keys' }
+  const clip = placedClip(source)
+  if (typeof clip === 'string') return { ok: false, reason: clip }
+
+  const start = Math.max(source.from, target.from)
+  const end = Math.min(source.from + source.durationInFrames, target.from + target.durationInFrames) - 1
+  if (seedFrame < start || seedFrame > end) return { ok: false, reason: 'no-overlap' }
+  const last = direction === 'forward' ? Math.min(end, seedFrame + MAX_TRACK_FRAMES - 1) : Math.max(start, seedFrame - MAX_TRACK_FRAMES + 1)
+  const step = direction === 'forward' ? 1 : -1
+  const frames: number[] = []
+  for (let frame = seedFrame; step > 0 ? frame <= last : frame >= last; frame += step) frames.push(frame)
+
+  // The target's box as shown at the seed frame, keyframes included.
+  const targetPlacement = resolveItemTransformAtFrame(target, {
+    canvas: canvasSize(), frame: seedFrame, keyframes: useKeyframesStore.getState().keyframesByItemId[target.id],
+  })
+  const seedBox = canvasToSource(clip, { cx: targetPlacement.x, cy: targetPlacement.y, width: targetPlacement.width, height: targetPlacement.height })
+  const fps = useTimelineSettingsStore.getState().fps
+  const scale = ANALYSIS_WIDTH / clip.sourceWidth
+  const analysisSeed = { cx: seedBox.cx * scale, cy: seedBox.cy * scale, width: seedBox.width * scale, height: seedBox.height * scale }
+  // Bound now, with the seed box, so an edit to the target during decoding makes the result stale.
+  const binding = motionTrackBinding(source, target, seedFrame, direction)
+
+  // Decode, track and drop one frame at a time: only the previous box and the template are kept.
+  const samples: TrackSample[] = []
+  try {
+    const { mediaLibraryService } = await importMediaLibraryService()
+    const blob = source.mediaId ? await mediaLibraryService.getMediaFile(source.mediaId) : null
+    if (!blob) return { ok: false, reason: 'decode-failed' }
+    const { Input, BlobSource, CanvasSink, ALL_FORMATS } = await import('mediabunny')
+    const input = new Input({ source: new BlobSource(blob as File), formats: ALL_FORMATS })
+    try {
+      const track = await input.getPrimaryVideoTrack()
+      if (!track) return { ok: false, reason: 'decode-failed' }
+      const height = Math.max(1, Math.round((ANALYSIS_WIDTH * clip.sourceHeight) / clip.sourceWidth))
+      const sink = new CanvasSink(track, { width: ANALYSIS_WIDTH, height, fit: 'fill' })
+      let tracker: RegionTracker | null = null
+      let lastYield = performance.now()
+      for (const [index, frame] of frames.entries()) {
+        if (options.signal?.aborted) throw new DOMException('Tracking cancelled', 'AbortError')
+        // Once lost, later frames are lost too: stop decoding.
+        if (tracker?.lost) {
+          samples.push({ ...samples.at(-1)!, confidence: 0, lost: true })
+          continue
+        }
+        // Timestamps come from the clip's source-time mapping, so VFR sources decode the frame actually shown.
+        const wrapped = await sink.getCanvas(sourceSecondsAt(source, frame, fps))
+        if (!wrapped) return { ok: false, reason: 'decode-failed' }
+        const gray = toGray(wrapped.canvas as OffscreenCanvas | HTMLCanvasElement)
+        if (!tracker) {
+          const seedRefusal = checkSeed(gray, analysisSeed)
+          if (seedRefusal) return { ok: false, reason: seedRefusal }
+          tracker = createRegionTracker(gray, analysisSeed)
+          samples.push(tracker.first)
+        } else {
+          samples.push(tracker.next(gray))
+        }
+        options.onProgress?.(index + 1, frames.length)
+        // Let the page breathe once a ~12 ms slice is used: a yield per frame would be throttled in background tabs.
+        if (performance.now() - lastYield > 12) {
+          await new Promise((resolve) => setTimeout(resolve, 0))
+          lastYield = performance.now()
+        }
+      }
+    } finally {
+      input.dispose()
+    }
+  } catch (error) {
+    if (error instanceof DOMException && error.name === 'AbortError') throw error
+    return { ok: false, reason: 'decode-failed' }
+  }
+  if (options.signal?.aborted) throw new DOMException('Tracking cancelled', 'AbortError')
+  const sourceSamples = samples.map((sample) => ({
+    ...sample, cx: sample.cx / scale, cy: sample.cy / scale, width: sample.width / scale, height: sample.height / scale,
+  }))
+  return {
+    ok: true,
+    result: {
+      sourceId,
+      targetId,
+      binding,
+      direction,
+      frames,
+      samples: sourceSamples,
+      values: followTrack(clip, sourceSamples, frames, targetPlacement),
+      lostFrames: frames.filter((_, index) => sourceSamples[index]!.lost),
+    },
+  }
+}
+
+export type MotionTrackApplyRefusal = 'stale' | 'unreviewed-lost' | 'conflict' | 'locked' | 'nothing-tracked'
+
+/**
+ * Apply a reviewed track as linear x, y, width and height keyframes on the
+ * target, in one undo step. Lost frames block the apply unless the editor
+ * keeps the tracked part explicitly; existing keys in the tracked range block
+ * it unless replacement is confirmed. Returns the application id to remove it.
+ */
+export function applyMotionTrack(
+  result: MotionTrackResult,
+  decisions: { keepTrackedPart?: boolean; replaceExisting?: boolean } = {},
+): { ok: true; applicationId: string } | { ok: false; reason: MotionTrackApplyRefusal } {
+  const items = useItemsStore.getState().items
+  const source = items.find((item) => item.id === result.sourceId)
+  const target = items.find((item) => item.id === result.targetId)
+  if (!source || !target || motionTrackBinding(source, target, result.frames[0]!, result.direction) !== result.binding) {
+    return { ok: false, reason: 'stale' }
+  }
+  if (result.lostFrames.length > 0 && !decisions.keepTrackedPart) return { ok: false, reason: 'unreviewed-lost' }
+  if (result.values.length === 0) return { ok: false, reason: 'nothing-tracked' }
+  if (hasLockedEditParticipants([target])) return { ok: false, reason: 'locked' }
+
+  const relative = result.values.map((value) => value.frame - target.from)
+  const low = Math.min(...relative)
+  const high = Math.max(...relative)
+  const record = useKeyframesStore.getState().keyframesByItemId[target.id]
+  const conflicting = (record?.properties ?? [])
+    .filter((property) => (TRACKED_PROPERTIES as readonly string[]).includes(property.property))
+    .flatMap((property) => property.keyframes
+      .filter((keyframe) => keyframe.frame >= low && keyframe.frame <= high)
+      .map((keyframe) => ({ property: property.property, id: keyframe.id })))
+  // Keys on both sides of the range mean an existing animation runs through it; tracked keys would
+  // bend that curve outside the range too, so this needs the same confirmation as keys inside it.
+  const spanned = (record?.properties ?? [])
+    .filter((property) => (TRACKED_PROPERTIES as readonly string[]).includes(property.property))
+    .some((property) => property.keyframes.some((keyframe) => keyframe.frame < low)
+      && property.keyframes.some((keyframe) => keyframe.frame > high))
+  if ((conflicting.length > 0 || spanned) && !decisions.replaceExisting) return { ok: false, reason: 'conflict' }
+
+  const applicationId = crypto.randomUUID()
+  const source_: AnimationKeyframeSource = {
+    applicationId, kind: 'built-in-preset', presetId: MOTION_TRACK_PRESET_ID, presetName: 'Motion tracking',
+  }
+  const payloads: KeyframeAddPayload[] = result.values.flatMap((value) => TRACKED_PROPERTIES.map((property) => ({
+    itemId: target.id, property, frame: value.frame - target.from, value: Math.round(value[property] * 100) / 100,
+    easing: 'linear' as const, source: source_,
+  })))
+  // A partial track must not change the target outside it. Where a property holds one value past
+  // the tracked range (no key beyond it on that side), pin that value on the neighbouring frame;
+  // where keys follow, they keep their own interpolation. Pins belong to the application, so
+  // removing the track removes them too.
+  const keysOf = (property: string) => (record?.properties ?? []).find((entry) => entry.property === property)?.keyframes ?? []
+  for (const [frame, side] of [[low - 1, -1], [high + 1, 1]] as const) {
+    if (frame < 0 || frame >= target.durationInFrames) continue
+    const shown = resolveItemTransformAtFrame(target, { canvas: canvasSize(), frame: target.from + frame, keyframes: record })
+    for (const property of TRACKED_PROPERTIES) {
+      const beyond = keysOf(property).some((keyframe) => (side < 0 ? keyframe.frame <= frame : keyframe.frame >= frame))
+      if (beyond) continue
+      payloads.push({ itemId: target.id, property, frame, value: Math.round(shown[property] * 100) / 100, easing: 'linear', source: source_ })
+    }
+  }
+
+  execute('APPLY_MOTION_TRACK', () => {
+    const keyframes = useKeyframesStore.getState()
+    for (const { property, id } of conflicting) keyframes._removeKeyframe(target.id, property, id)
+    keyframes._addKeyframes(payloads)
+    useTimelineSettingsStore.getState().markDirty()
+  }, { targetId: target.id, applicationId, frames: result.values.length })
+  return { ok: true, applicationId }
+}
+
+/** Applied tracks on an item, newest last, by application id. */
+export function listMotionTracks(itemId: string): string[] {
+  const record = useKeyframesStore.getState().keyframesByItemId[itemId]
+  const ids = new Set<string>()
+  for (const property of record?.properties ?? []) {
+    for (const keyframe of property.keyframes) {
+      if (keyframe.source?.presetId === MOTION_TRACK_PRESET_ID) ids.add(keyframe.source.applicationId)
+    }
+  }
+  return [...ids]
+}
+
+/** Remove one applied track's keyframes in one undo step; other keys stay. */
+export function removeMotionTrack(itemId: string, applicationId: string): boolean {
+  const item = useItemsStore.getState().itemById[itemId]
+  if (!item || hasLockedEditParticipants([item]) || !listMotionTracks(itemId).includes(applicationId)) return false
+  execute('REMOVE_MOTION_TRACK', () => {
+    useKeyframesStore.getState()._removeKeyframesByApplication(itemId, applicationId)
+    useTimelineSettingsStore.getState().markDirty()
+  }, { itemId, applicationId })
+  return true
+}
diff --git a/src/features/timeline/utils/motion-track-mapping.ts b/src/features/timeline/utils/motion-track-mapping.ts
new file mode 100644
--- /dev/null
+++ b/src/features/timeline/utils/motion-track-mapping.ts
@@ -0,0 +1,82 @@
+import type { TrackBox, TrackSample } from '@/shared/utils/motion-tracker'
+
+/**
+ * Maps a track between the source clip's pixels and the project canvas
+ * (FL-596). A clip without rotation, crop or flips draws its source scaled
+ * into its transform's box, centred at canvas centre + (x, y).
+ */
+export interface PlacedClip {
+  sourceWidth: number
+  sourceHeight: number
+  /** Resolved transform: offset from canvas centre and drawn size, in canvas pixels. */
+  x: number
+  y: number
+  width: number
+  height: number
+}
+
+export function canvasToSource(clip: PlacedClip, box: TrackBox): TrackBox {
+  const sx = clip.sourceWidth / clip.width
+  const sy = clip.sourceHeight / clip.height
+  return {
+    cx: (box.cx - clip.x + clip.width / 2) * sx,
+    cy: (box.cy - clip.y + clip.height / 2) * sy,
+    width: box.width * sx,
+    height: box.height * sy,
+  }
+}
+
+export function sourceToCanvas(clip: PlacedClip, box: TrackBox): TrackBox {
+  const sx = clip.width / clip.sourceWidth
+  const sy = clip.height / clip.sourceHeight
+  return {
+    cx: box.cx * sx + clip.x - clip.width / 2,
+    cy: box.cy * sy + clip.y - clip.height / 2,
+    width: box.width * sx,
+    height: box.height * sy,
+  }
+}
+
+export interface TargetPlacement {
+  x: number
+  y: number
+  width: number
+  height: number
+}
+
+export interface TrackedValue {
+  /** Timeline frame of the sample. */
+  frame: number
+  x: number
+  y: number
+  width: number
+  height: number
+}
+
+/**
+ * The target's transform at each tracked frame. The target keeps its offset
+ * from the tracked box at the seed frame, moves with the box centre, and
+ * scales with the box size, so its initial placement is preserved.
+ */
+export function followTrack(
+  clip: PlacedClip,
+  samples: readonly TrackSample[],
+  frames: readonly number[],
+  target: TargetPlacement,
+): TrackedValue[] {
+  const seed = sourceToCanvas(clip, samples[0]!)
+  const values: TrackedValue[] = []
+  samples.forEach((sample, index) => {
+    if (sample.lost) return
+    const box = sourceToCanvas(clip, sample)
+    const scale = Math.sqrt((box.width / seed.width) * (box.height / seed.height))
+    values.push({
+      frame: frames[index]!,
+      x: target.x + (box.cx - seed.cx) + (target.x - seed.cx) * (scale - 1),
+      y: target.y + (box.cy - seed.cy) + (target.y - seed.cy) * (scale - 1),
+      width: target.width * scale,
+      height: target.height * scale,
+    })
+  })
+  return values
+}
