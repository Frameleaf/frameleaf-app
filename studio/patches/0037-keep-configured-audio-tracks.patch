Subject: Keep empty audio tracks someone set up across a reload

Freecut MIT adaptation (FL-94). Loading a project tidies away empty
classic audio tracks above the highest one in use. A track the person
had soloed, muted, locked, hidden or taken out of sync lock was removed
the same way, so a reload silently changed the mix (a solo on an empty
track mutes every other audio track) or the edit rules. Only tracks
with default controls are tidied now.

diff --git a/src/features/timeline/stores/timeline-persistence.ts b/src/features/timeline/stores/timeline-persistence.ts
index bc6870f9bf..8624f023b5 100644
--- a/src/features/timeline/stores/timeline-persistence.ts
+++ b/src/features/timeline/stores/timeline-persistence.ts
@@ -274,6 +274,16 @@ function hasCompositionVisualItems(items: TimelineItem[]): boolean {
   return items.some((item) => item.type !== 'audio')
 }
 
+function hasDefaultTrackControls(track: TimelineTrack): boolean {
+  return (
+    !track.solo &&
+    !track.muted &&
+    !track.locked &&
+    track.visible !== false &&
+    track.syncLock !== false
+  )
+}
+
 function cleanupRedundantEmptyClassicAudioTracks(project: Project): {
   project: Project
   cleaned: boolean
@@ -310,7 +320,11 @@ function cleanupRedundantEmptyClassicAudioTracks(project: Project): {
     classicAudioTracks
       .filter(
         ({ track, number }) =>
-          number > highestOccupiedClassicAudioNumber && (itemsByTrackId.get(track.id) ?? 0) === 0,
+          number > highestOccupiedClassicAudioNumber &&
+          (itemsByTrackId.get(track.id) ?? 0) === 0 &&
+          // Frameleaf (FL-94): a track someone set up (solo, mute, lock, hide, sync lock) is
+          // theirs: removing it would change the mix or the edit rules after a reload.
+          hasDefaultTrackControls(track),
       )
       .map(({ track }) => track.id),
   )
