+import { afterEach, describe, expect, it, vi } from 'vite-plus/test'
+import type { CompositionInputProps } from '@/types/export'
+
+vi.mock('mediabunny', () => {
+  class UrlSource { constructor(public readonly url: string) {} }
+  class Input {
+    constructor(private readonly params: { source: UrlSource }) {}
+    async getPrimaryAudioTrack() { return { src: this.params.source.url } }
+    async computeDuration() { return 1 }
+    dispose() {}
+  }
+  class AudioSampleSink {
+    constructor(private readonly track: { src: string }) {}
+    async *samples(startTime = 0, endTime = 1) {
+      const channels = Number(this.track.src.split('-').at(-1))
+      const frames = Math.round((endTime - startTime) * 192_000)
+      yield {
+        numberOfFrames: frames, numberOfChannels: channels, sampleRate: 192_000,
+        copyTo(destination: Float32Array, options: { planeIndex: number; format: string }) {
+          if (options.format !== 'f32-planar' || options.planeIndex >= channels)
+            throw new Error('Invalid high-rate decoded plane')
+          for (let frame = 0; frame < destination.length; frame++) {
+            const time = startTime + frame / 192_000
+            destination[frame] = options.planeIndex === 3 ? 0 :
+              (options.planeIndex + 1) * (0.015625 + 0.005 * Math.sin(2 * Math.PI * 1000 * time))
+          }
+        },
+        close() {},
+      }
+    }
+  }
+  return { ALL_FORMATS: [], Input, UrlSource, AudioSampleSink }
+})
+
+import { clearAudioDecodeCache, processAudio } from './canvas-audio'
+
+describe('FL-103 actual high-rate pitch-up export', () => {
+  afterEach(() => clearAudioDecodeCache())
+  for (const channels of [1, 2, 6, 8]) {
+    for (const clipFrames of [1, 15]) {
+      it(`${channels} decoded planes at 192 kHz speed 1.5/pitch +12 retain a ${clipFrames}-frame clip`, async () => {
+        const composition = {
+          fps: 30, durationInFrames: 30, width: 1920, height: 1080,
+          masterBusDb: 0, masterBusMuted: false, transitions: [], keyframes: [],
+          tracks: [{ id: 'retimed', name: 'retimed', kind: 'audio', order: 0, height: 80,
+            locked: false, visible: true, muted: false, solo: false, volume: 0,
+            items: [{ id: 'retimed', type: 'audio', trackId: 'retimed',
+              src: `blob:fl103-high-rate-${channels}`, label: 'high-rate', from: 3,
+              durationInFrames: clipFrames, sourceStart: 0, sourceEnd: clipFrames * 1.5,
+              sourceDuration: 30, sourceFps: 30, volume: 0, speed: 1.5, audioPitchSemitones: 12 }],
+          }],
+        } as CompositionInputProps
+        const before = structuredClone(composition)
+        const result = await processAudio(composition)
+        expect(result).not.toBeNull()
+        expect(result!.channels).toBe(channels)
+        expect(result!.sampleRate).toBe(48_000)
+        const start = 4_800
+        const end = start + clipFrames * 1_600
+        for (const [channel, plane] of result!.samples.entries()) {
+          expect(plane).toHaveLength(48_000)
+          for (let frame = 0; frame < plane.length; frame++) {
+            if (!Number.isFinite(plane[frame])) throw new Error('Nonfinite high-rate export PCM')
+            if ((frame < start || frame >= end || channel === 3) && plane[frame] !== 0)
+              throw new Error(`High-rate plane ${channel} escaped its clip or silent plane at ${frame}`)
+          }
+          if (channel !== 3) expect(plane.subarray(start, end).some((sample) => Math.abs(sample) > 0.001)).toBe(true)
+        }
+        if (clipFrames === 15) {
+          // Independent pitch measurement distinguishes actual +12-semitone
+          // DSP from the speed-only resampling fallback (1500 Hz).
+          const amplitude = (frequency: number) => {
+            let real = 0
+            let imaginary = 0
+            for (let frame = 0; frame < 4800; frame++) {
+              const angle = 2 * Math.PI * frequency * frame / 48_000
+              const sample = result!.samples[0]![start + 4800 + frame]!
+              real += sample * Math.cos(angle)
+              imaginary += sample * Math.sin(angle)
+            }
+            return 2 * Math.hypot(real, imaginary) / 4800
+          }
+          expect(amplitude(2000)).toBeGreaterThan(0.003)
+          expect(amplitude(1500)).toBeLessThan(0.001)
+        }
+        expect(composition).toEqual(before)
+      })
+    }
+  }
+})
