+  let sourceReads = 0
+  const source = {
+    extract(target: Float32Array, requested: number, position: number) {
+      sourceReads++
+      const count = Math.min(requested, frames - position)
+      for (let frame = 0; frame < count; frame++) {
+        for (let channel = 0; channel < channels; channel++)
+          target[frame * channels + channel] = planes[channel]![position + frame]!
+      }
+      return count
+    },
+  }
+  const filter = new TimeStretchFilter(source, processor, undefined, outputFrames)
+  const output = Array.from({ length: channels }, () => new Float32Array(outputFrames))
+  const chunk = new Float32Array(chunkFrames * channels)
+  let position = 0
+  while (position < outputFrames) {
+    const count = filter.extract(chunk, Math.min(chunkFrames, outputFrames - position))
+    expect(count).toBeGreaterThan(0)
+    for (let frame = 0; frame < count; frame++) {
+      for (let channel = 0; channel < channels; channel++)
+        output[channel]![position + frame] = chunk[frame * channels + channel]!
+    }
+    position += count
+  }
+  const readsBeforeEnd = sourceReads
+  expect(filter.extract(chunk, chunkFrames)).toBe(0)
+  expect(sourceReads).toBe(readsBeforeEnd)
+  expect(filter.position).toBe(outputFrames)
+  for (const plane of output) {
+    expect(plane).toHaveLength(outputFrames)
+    for (const sample of plane) {
+      if (!Number.isFinite(sample)) throw new Error('Nonfinite retimed PCM')
+    }
+  }
+  return output
+}
+
+function sharedFixture(channels: number) {
+  const a = new Float32Array(96_001)
+  const b = new Float32Array(a.length)
+  for (let frame = 0; frame < a.length; frame++) {
+    // Correlated impulses plus nonperiodic asymmetric transients. Two distinct
+    // guides ensure an independent pair stretcher cannot hide clock/seek drift.
+    if (frame % 4_093 < 23) a[frame] = 0.125 * (1 - (frame % 4_093) / 23)
+    if (frame % 6_137 < 71) b[frame] = -0.0625 * (1 - (frame % 6_137) / 71)
+    // A nonzero finite tail inside the last source buffer must be drained.
+    if (frame >= 80_000) {
+      a[frame] += 0.03125
+      b[frame] -= 0.015625
+    }
+  }
+  const choices = [a, b, a.map((sample) => -sample), new Float32Array(a.length),
+    a.map((sample) => sample * 0.5), b.map((sample) => -sample * 0.5),
+    b.map((sample) => sample * 2), a.map((sample) => -sample * 0.25)]
+  return choices.slice(0, channels)
+}
+
+describe('FL-103 shared multichannel SoundTouch timing and finite tail', () => {
+  for (const channels of [6, 8]) {
+    for (const pitch of [0.5, 1, 2]) {
+      it(`${channels} planes preserve signed impulses, asymmetric transients, silence and extraction clock at pitch ${pitch}`, () => {
+        const input = sharedFixture(channels)
+        const before = input.map((plane) => plane.slice())
+        const output = renderPlanes(input, 1.5, pitch, 4096)
+        const differentlyChunked = renderPlanes(input, 1.5, pitch, 127)
+        expect(input).toEqual(before)
+        expect(output).toEqual(differentlyChunked)
+        const relations = [[2, 0, -1], [4, 0, 0.5], [5, 1, -0.5],
+          ...(channels === 8 ? [[6, 1, 2], [7, 0, -0.25]] : [])]
+        for (let frame = 0; frame < output[0]!.length; frame++) {
+          if (output[3]![frame] !== 0) throw new Error(`Silent plane leaked at frame ${frame}`)
+          for (const [plane, reference, ratio] of relations) {
+            if (Math.abs(output[plane!]![frame]! - output[reference!]![frame]! * ratio!) > 1e-7)
+              throw new Error(`Plane ${plane} lost shared transient/phase timing at frame ${frame}`)
+          }
+        }
+        for (const channel of [0, 1, 2, 4, 5, ...(channels === 8 ? [6, 7] : [])]) {
+          const tail = output[channel]!.subarray(output[channel]!.length - 8_000)
+          expect(tail.some((sample) => Math.abs(sample) > 0.001), `plane ${channel} finite tail retained`).toBe(true)
+        }
+        // A source-plane permutation must permute output without changing the
+        // common search objective/clock. It exposes hard-coded L/R guide use.
+        const order = channels === 8 ? [7, 3, 5, 0, 6, 2, 1, 4] : [5, 3, 2, 0, 1, 4]
+        const reordered = renderPlanes(order.map((channel) => input[channel]!), 1.5, pitch, 4096)
+        for (const [plane, original] of order.entries()) {
+          for (let frame = 0; frame < output[0]!.length; frame++) {
+            if (Math.abs(reordered[plane]![frame]! - output[original]![frame]!) > 1e-7)
+              throw new Error(`Plane permutation changed shared timing at frame ${frame}`)
+          }
+        }
+      })
+    }
+  }
+
+  for (const channels of [1, 2]) {
+    it(`${channels}-plane short finite export drains below the legacy input threshold`, () => {
+      const source = Array.from({ length: channels }, (_, channel) => new Float32Array(2401).fill((channel + 1) / 16))
+      const output = renderPlanes(source, 1.25, 1, 113)
+      expect(output).toHaveLength(channels)
+      for (const [channel, plane] of output.entries()) {
+        expect(plane).toHaveLength(1920)
+        expect(plane.some((sample) => Math.abs(sample) > 0.01)).toBe(true)
+        if (channel === 1) {
+          for (let frame = 0; frame < plane.length; frame++)
+            expect(plane[frame]).toBe(output[0]![frame]! * 2)
+        }
+      }
+    })
+  }
+})
+
+describe('FL-103 high-rate pitch-up finite extraction', () => {
+  for (const channels of [1, 2, 6, 8]) {
+    for (const frames of [2401, 96001]) {
+      it(`${channels} planes at 192 kHz speed 1.5/pitch 2 drain ${frames} frames without stalling`, () => {
+        const input = Array.from({ length: channels }, (_, channel) => {
+          const plane = new Float32Array(frames)
+          for (let frame = 0; frame < frames; frame++)
+            plane[frame] = channel === 3 ? 0 : (channel + 1) * 0.015625
+          return plane
+        })
+        const output = renderPlanes(input, 1.5, 2, 4096, 192_000)
+        const smallChunks = renderPlanes(input, 1.5, 2, 127, 192_000)
+        expect(output).toEqual(smallChunks)
+        for (const [channel, plane] of output.entries()) {
+          expect(plane).toHaveLength(Math.floor(frames / 1.5))
+          if (channel === 3) expect(plane.every((sample) => sample === 0)).toBe(true)
+          else expect(plane.some((sample) => Math.abs(sample) > 0.001)).toBe(true)
+          for (let frame = 0; frame < plane.length; frame++) {
+            if (Math.abs(plane[frame]! - output[0]![frame]! * (channel === 3 ? 0 : channel + 1)) > 1e-7)
+              throw new Error(`High-rate plane ${channel} lost shared timing at ${frame}`)
+          }
+        }
+      })
+    }
+  }
+})
