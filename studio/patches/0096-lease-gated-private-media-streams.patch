+  let reached, release
+  const statReached = new Promise((resolve) => {
+    reached = resolve
+  })
+  const statReleased = new Promise((resolve) => {
+    release = resolve
+  })
+  fs.promises.stat = async (...args) => {
+    const info = await originalStat(...args)
+    reached()
