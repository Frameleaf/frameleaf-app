+test('private media waits for acknowledgement while ordinary static stays available', async () => {
+  const { root, dist } = fixture()
+  const authority = privateAuthority()
+  const server = await createHarnessServer({
+    distDir: dist,
+    resolveMedia: () => path.join(dist, 'assets/asset.txt'),
+    privateMediaAuthority: authority,
+  })
+  try {
+    const media = rawRequest(server.base, '/media/verified')
+    media.catch(() => {})
+    await Promise.race([
+      authority.waiting,
+      media.then(() => assert.fail('PRIVATE_BYTES_FORWARDED_WHILE_PENDING')),
+    ])
+    assert.equal((await rawRequest(server.base, '/assets/asset.txt')).body.toString(), '0123456789')
+    authority.activate()
+    assert.equal((await media).body.toString(), '0123456789')
+    assert.ok(authority.waits > 1, 'resolver permission alone must not authorize serving')
+  } finally {
+    authority.terminate()
+    await server.close()
+    fs.rmSync(root, { recursive: true, force: true })
+  }
+})
