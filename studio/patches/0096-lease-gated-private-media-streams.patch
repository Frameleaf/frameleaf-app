+test('private backpressured ranges stop issuing reads and forwarding chunks during renewal', async () => {
+  for (const loss of [false, true]) {
+    const { root, dist } = fixture()
+    const file = path.join(dist, 'assets/asset.txt')
+    const bytes = Buffer.alloc(160000)
+    for (let i = 0; i < bytes.length; i++) bytes[i] = i % 251
+    fs.writeFileSync(file, bytes)
+    const authority = privateAuthority()
+    authority.activate()
+    const req = new EventEmitter()
+    req.method = 'GET'
+    req.headers = { range: 'bytes=7-140000' }
+    const res = new EventEmitter()
+    res.destroyed = false
+    res.setHeader = () => {}
+    res.writeHead = (status) => assert.equal(status, 206)
+    res.destroy = () => {
+      res.destroyed = true
+      res.emit('close')
+    }
+    res.end = () => {}
+    const chunks = []
+    let reached, releaseWrite
+    const blocked = new Promise((resolve) => {
+      reached = resolve
+    })
+    res.write = (chunk, callback) => {
+      authority.assertActive()
+      chunks.push(Buffer.from(chunk))
+      if (chunks.length === 1) {
+        authority.pending()
+        releaseWrite = callback
+        reached()
+        return false
+      }
+      queueMicrotask(callback)
+      return true
+    }
+    let reads = 0
+    const originalOpen = fs.promises.open
+    fs.promises.open = async (...args) => {
+      const handle = await originalOpen(...args),
+        read = handle.read.bind(handle)
+      handle.read = (...values) => {
+        authority.assertActive()
+        reads++
+        return read(...values)
+      }
+      return handle
+    }
+    try {
+      const serving = serveFile(req, res, file, { allowRange: true, authority })
+      serving.catch(() => {})
+      await blocked
+      assert.equal(reads, 1)
+      assert.equal(chunks.length, 1)
+      if (loss) {
+        authority.terminate()
+        await serving
+        releaseWrite()
+        res.emit('drain')
+        assert.equal(res.destroyed, true)
+        assert.equal(reads, 1)
+        assert.equal(chunks.length, 1)
+      } else {
+        authority.activate()
+        releaseWrite()
+        res.emit('drain')
+        await serving
+        assert.deepEqual(Buffer.concat(chunks), bytes.subarray(7, 140001))
+      }
+    } finally {
+      fs.promises.open = originalOpen
+      authority.terminate()
+      fs.rmSync(root, { recursive: true, force: true })
+    }
+  }
+})
