+// Controlled local lease barriers: these do not attest a production claim or renderer.
+function privateAuthority() {
+  let active = false
+  const controller = new AbortController()
+  const waiters = new Set()
+  let entered
+  const waiting = new Promise((resolve) => {
+    entered = resolve
+  })
+  return {
+    signal: controller.signal,
+    waiting,
+    waits: 0,
+    isPending() {
+      return !active && !controller.signal.aborted
+    },
+    assertActive() {
+      if (controller.signal.aborted) throw controller.signal.reason
+      assert.ok(active, 'PRIVATE_AUTHORITY_PENDING')
+    },
+    wait(signal) {
+      this.waits++
+      entered()
+      if (controller.signal.aborted) return Promise.reject(controller.signal.reason)
+      if (signal?.aborted) return Promise.reject(signal.reason)
+      if (active) return Promise.resolve()
+      return new Promise((resolve, reject) => {
+        const waiter = { resolve, reject }
+        const abort = () => {
+          waiters.delete(waiter)
+          reject(signal.reason)
+        }
+        waiter.resolve = () => {
+          signal?.removeEventListener('abort', abort)
+          resolve()
+        }
+        waiter.reject = (error) => {
+          signal?.removeEventListener('abort', abort)
+          reject(error)
+        }
+        waiters.add(waiter)
+        signal?.addEventListener('abort', abort, { once: true })
+      })
+    },
+    pending() {
+      active = false
+    },
+    activate() {
+      active = true
+      for (const waiter of waiters) waiter.resolve()
+      waiters.clear()
+    },
+    terminate() {
+      active = false
+      const error = Error('PRIVATE_LEASE_TERMINAL')
+      controller.abort(error)
+      for (const waiter of waiters) waiter.reject(error)
+      waiters.clear()
+    },
+  }
+}
