new file mode 100644
--- /dev/null
+++ b/src/shared/utils/true-peak-limiter.test.ts
@@ -0,0 +1,64 @@
+import { describe, expect, it } from 'vite-plus/test'
+import { measureLoudness } from './loudness'
+import { limitTruePeak } from './true-peak-limiter'
+
+const RATE = 48000
+
+function burstySignal(seconds: number): Float32Array[] {
+  const left = new Float32Array(seconds * RATE)
+  const right = new Float32Array(seconds * RATE)
+  for (let i = 0; i < left.length; i += 1) {
+    const t = i / RATE
+    const loud = Math.floor(t * 4) % 3 === 0 ? 1.6 : 0.3
+    left[i] = loud * Math.sin(2 * Math.PI * 997 * t) * 0.9
+    right[i] = loud * Math.sin(2 * Math.PI * 12000 * t + Math.PI / 4) * 0.7
+  }
+  return [left, right]
+}
+
+describe('limitTruePeak', () => {
+  it.each([-1, -2, -0.3])('keeps the true peak at or below %s dBTP within 0.2 dB', (ceiling) => {
+    const channels = burstySignal(3)
+    expect(measureLoudness({ sampleRate: RATE, channels }).truePeakDbtp!).toBeGreaterThan(ceiling + 3)
+    limitTruePeak(channels, RATE, ceiling)
+    expect(measureLoudness({ sampleRate: RATE, channels }).truePeakDbtp!).toBeLessThanOrEqual(ceiling + 0.2)
+  })
+
+  it('leaves audio below the ceiling untouched and keeps channels in step', () => {
+    const quiet = [Float32Array.from({ length: RATE }, (_, i) => 0.2 * Math.sin(i / 10))]
+    const before = Float32Array.from(quiet[0]!)
+    limitTruePeak(quiet, RATE, -1)
+    expect(quiet[0]).toEqual(before)
+
+    const channels = burstySignal(1)
+    const ratioBefore = channels[0]![1000]! / channels[1]![1000]!
+    limitTruePeak(channels, RATE, -1)
+    expect(channels[0]![1000]! / channels[1]![1000]!).toBeCloseTo(ratioBefore, 6)
+  })
+
+  it('only reduces quiet passages briefly after a loud one (release)', () => {
+    const channels = burstySignal(3)
+    limitTruePeak(channels, RATE, -1)
+    // 0.5 s into a quiet quarter-second the gain has recovered: level is the original 0.3 × 0.9.
+    const t = 0.25 + 0.2
+    const window = channels[0]!.subarray(Math.round(t * RATE), Math.round((t + 0.02) * RATE))
+    const peak = window.reduce((m, v) => Math.max(m, Math.abs(v)), 0)
+    expect(peak).toBeGreaterThan(0.26)
+  })
+
+  it('gives the same result in bounded chunks as in one pass over the whole mix', () => {
+    const whole = burstySignal(2)
+    const chunked = whole.map((channel) => Float32Array.from(channel))
+    limitTruePeak(whole, RATE, -1, Infinity)
+    limitTruePeak(chunked, RATE, -1, 4096)
+    let worst = 0
+    for (let c = 0; c < whole.length; c += 1) {
+      for (let i = 0; i < whole[c]!.length; i += 1) worst = Math.max(worst, Math.abs(whole[c]![i]! - chunked[c]![i]!))
+    }
+    expect(worst).toBeLessThan(1e-6)
+  })
+
+  it('fails instead of skipping when the ceiling is not a number', () => {
+    expect(() => limitTruePeak(burstySignal(1), RATE, Number.NaN)).toThrow(/true-peak ceiling/)
+  })
+})
