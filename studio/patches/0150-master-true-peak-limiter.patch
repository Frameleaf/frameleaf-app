new file mode 100644
--- /dev/null
+++ b/src/shared/utils/true-peak-limiter.ts
@@ -0,0 +1,86 @@
+import { samplePeaks } from './loudness'
+
+/**
+ * Offline true-peak limiter (FL-623). The whole mix is known, so the gain can
+ * look ahead with no added latency: each sample's required gain (ceiling over
+ * its 4x-oversampled peak) is taken as a running minimum over ±L samples and
+ * then box-averaged over L, which keeps the gain at every peak no higher than
+ * that peak requires while ramping smoothly into it. Release is limited to
+ * recover gradually. Channels share one gain, so the image does not shift.
+ * It runs in chunks with a margin of original samples on each side, so memory
+ * stays bounded for long exports and the result matches one whole-mix pass.
+ * Algorithm id: tp-lookahead-1.5ms-v1.
+ */
+
+const LOOKAHEAD_SECONDS = 0.0015
+const RELEASE_SECONDS = 0.05
+
+export function limitTruePeak(
+  channels: Float32Array[],
+  sampleRate: number,
+  ceilingDbtp: number,
+  chunkSize = 1 << 16,
+): void {
+  // An invalid ceiling would silently skip limiting; fail the export instead.
+  if (!Number.isFinite(ceilingDbtp)) throw new Error(`Invalid true-peak ceiling: ${ceilingDbtp}`)
+  const length = channels[0]?.length ?? 0
+  if (length === 0) return
+  const ceiling = 10 ** (ceilingDbtp / 20)
+  const lookahead = Math.max(8, Math.round(LOOKAHEAD_SECONDS * sampleRate))
+  const half = Math.floor(lookahead / 2)
+  // Each output sample reads required gains up to half + L away, whose peaks read a few taps further.
+  const margin = lookahead + half + 16
+  const chunk = Math.max(chunkSize, margin)
+  const release = 1 - Math.exp(-1 / (RELEASE_SECONDS * sampleRate))
+  // Original samples just before the current chunk; the chunk before has already been limited.
+  let saved: Float32Array[] = channels.map(() => new Float32Array(0))
+  let gain = 1
+
+  for (let start = 0; start < length; start += chunk) {
+    const end = Math.min(length, start + chunk)
+    const extFrom = Math.max(0, start - margin)
+    const extTo = Math.min(length, end + margin)
+    const ext = channels.map((channel, c) => {
+      const copy = new Float32Array(extTo - extFrom)
+      copy.set(saved[c]!.subarray(saved[c]!.length - (start - extFrom)))
+      copy.set(channel.subarray(start, extTo), start - extFrom)
+      return copy
+    })
+    saved = channels.map((channel) => channel.slice(Math.max(start, end - margin), end))
+
+    const peaks = samplePeaks(ext)
+    const required = new Float32Array(peaks.length)
+    let limiting = false
+    for (let i = 0; i < peaks.length; i += 1) {
+      required[i] = peaks[i]! > ceiling ? ceiling / peaks[i]! : 1
+      if (required[i]! < 1) limiting = true
+    }
+    if (!limiting && gain >= 1) continue
+
+    // Running minimum over [i - L, i + L] with a monotonic deque (indices within ext).
+    const windowMin = new Float32Array(required.length)
+    const deque = new Int32Array(required.length)
+    let head = 0
+    let tail = 0
+    let next = 0
+    for (let i = 0; i < required.length; i += 1) {
+      for (; next < required.length && next <= i + lookahead; next += 1) {
+        while (tail > head && required[deque[tail - 1]!]! >= required[next]!) tail -= 1
+        deque[tail++] = next
+      }
+      while (deque[head]! < i - lookahead) head += 1
+      windowMin[i] = required[deque[head]!]!
+    }
+    // Box average over [i - L/2, i + L/2]; never above the peak's own requirement.
+    const prefix = new Float64Array(windowMin.length + 1)
+    for (let i = 0; i < windowMin.length; i += 1) prefix[i + 1] = prefix[i]! + windowMin[i]!
+    for (let i = start; i < end; i += 1) {
+      const from = Math.max(0, i - half) - extFrom
+      const to = Math.min(length, i + half + 1) - extFrom
+      const smoothed = (prefix[to]! - prefix[from]!) / (to - from)
+      // Attack follows the lookahead envelope; release rises at most at the release rate.
+      gain = Math.min(smoothed, gain + (1 - gain) * release)
+      for (const channel of channels) channel[i] = channel[i]! * gain
+    }
+  }
+}
