+import { playwright } from '@vitest/browser-playwright'
+import base from './vite.config'
+
+const report = process.env.STUDIO_HIGHRATE_REPORT
+if (!report) throw new Error('Native high-rate tests require an evidence report path')
+
+export default {
+  ...base,
+  test: {
+    ...base.test,
+    // No jsdom emulation setup or audio API substitute in this native run.
+    environment: undefined,
+    setupFiles: ['./src/test/highrate-browser-setup.ts'],
+    include: ['src/features/export/utils/canvas-audio-highrate-retiming.test.ts'],
+    reporters: ['default', 'json'],
+    outputFile: { json: report },
+    browser: {
+      enabled: true,
+      provider: playwright(),
+      instances: [{ browser: 'chromium' }],
+      headless: true,
+    },
+  },
+}
