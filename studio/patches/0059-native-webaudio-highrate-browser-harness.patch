@@ -0,0 +1,27 @@
+import { beforeAll, expect } from 'vite-plus/test'
+
+// Prerequisite hook, not an extra counted case: all eight original export tests
+// must run in a real browser. Do not assign or polyfill any Web Audio global.
+beforeAll(async () => {
+  expect(typeof OfflineAudioContext).toBe('function')
+  expect(typeof AudioBuffer).toBe('function')
+  expect(Function.prototype.toString.call(OfflineAudioContext)).toContain('[native code]')
+  expect(Function.prototype.toString.call(AudioBuffer)).toContain('[native code]')
+  const context = new OfflineAudioContext(1, 48, 48_000)
+  const input = context.createBuffer(1, 192, 192_000)
+  expect(input).toBeInstanceOf(AudioBuffer)
+  expect(input.sampleRate).toBe(192_000)
+  expect(input.length).toBe(192)
+  input.getChannelData(0)[16] = 0.125
+  const source = context.createBufferSource()
+  source.buffer = input
+  source.connect(context.destination)
+  source.start(0)
+  const rendered = await context.startRendering()
+  expect(rendered).toBeInstanceOf(AudioBuffer)
+  expect(rendered.sampleRate).toBe(48_000)
+  expect(rendered.length).toBe(48)
+  expect(rendered.getChannelData(0).some((value) => value !== 0)).toBe(true)
+  source.disconnect()
+  expect(navigator.userAgent).toContain('Chrome')
+})
