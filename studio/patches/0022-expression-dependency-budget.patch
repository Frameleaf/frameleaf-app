@@ -0,0 +1,80 @@
+// @vitest-environment node
+
+import { describe, expect, it } from 'vite-plus/test'
+import type { ItemKeyframes } from '@/types/keyframe'
+import type { ShapeItem } from '@/types/timeline'
+import { resolveAnimatedTransform, resolveExpressionReferenceValue, resolvePropertyExpressionValue } from './animated-transform-resolver'
+import { evaluatePropertyExpression } from './property-expression'
+
+function fixture(property: 'x' | 'position') {
+  const items = new Map<string, ShapeItem>()
+  const keyframes = new Map<string, ItemKeyframes>()
+  const chain = (prefix: string, length: number) => {
+    for (let index = 0; index < length; index += 1) {
+      const id = `${prefix}-${index}`
+      items.set(id, {
+        id, type: 'shape', shapeType: 'rectangle', trackId: 'track',
+        from: 0, durationInFrames: 60, label: id,
+        transform: { x: 20, y: 30, width: 100, height: 100 },
+        fillColor: '#fff', strokeColor: '#fff', strokeWidth: 1,
+      })
+      keyframes.set(id, { itemId: id, properties: [], expressions: [{
+        type: 'expression', targetProperty: property, enabled: true,
+        source: index === length - 1 ? 'value + time' : `prop("${prefix}-${index + 1}", "${property}")`,
+      }] })
+    }
+  }
+  const context = {
+    globalFrame: 30,
+    canvas: { width: 1920, height: 1080, fps: 30 },
+    getItem: (id: string) => items.get(id),
+    getKeyframes: (id: string) => keyframes.get(id),
+  }
+  const preValue = property === 'x' ? 10 : { x: 10, y: 15 }
+  const preview = (source: string) => evaluatePropertyExpression(source, {
+    preValue, globalFrame: 30, fps: 30,
+    resolveProperty: (id, referencedProperty, budget) => resolveExpressionReferenceValue(id, referencedProperty, context, budget),
+  })
+  return { chain, keyframes, context, preValue, preview }
+}
+
+describe.each(['x', 'position'] as const)('expression dependency budget for %s', (property) => {
+  it.each([64, 65])('counts the actual preview source in a %i-expression chain and reuses cached references', (length) => {
+    const { chain, keyframes, context, preValue, preview } = fixture(property)
+    chain('layer', length)
+    const source = `prop("layer-1", "${property}") + prop("layer-1", "${property}")`
+    keyframes.get('layer-0')!.expressions = [{ type: 'expression', targetProperty: property, enabled: true, source }]
+    const expected = length > 64
+      ? { value: preValue, error: 'Expression dependency limit exceeded' }
+      : { value: property === 'x' ? 42 : { x: 42, y: 62 } }
+
+    for (let repeat = 0; repeat < 2; repeat += 1) {
+      expect(resolvePropertyExpressionValue('layer-0', property, preValue, context)).toEqual(expected)
+      expect(preview(source)).toEqual(expected)
+    }
+  })
+
+  it.each([[31, 32], [40, 40]])('shares one preview budget across independent %i and %i-expression branches', (left, right) => {
+    const { chain, keyframes, context, preValue, preview } = fixture(property)
+    chain('root', 1)
+    chain('left', left)
+    chain('right', right)
+    const source = `prop("left-0", "${property}") + prop("right-0", "${property}")`
+    keyframes.get('root-0')!.expressions = [{ type: 'expression', targetProperty: property, enabled: true, source }]
+    const expected = left + right + 1 > 64
+      ? { value: preValue, error: 'Expression dependency limit exceeded' }
+      : { value: property === 'x' ? 42 : { x: 42, y: 62 } }
+
+    expect(resolvePropertyExpressionValue('root-0', property, preValue, context)).toEqual(expected)
+    expect(preview(source)).toEqual(expected)
+  })
+})
+
+it('gives independent transform properties their own budget after a full x-expression chain', () => {
+  const { chain, keyframes, context } = fixture('x')
+  chain('layer', 64)
+  keyframes.get('layer-0')!.expressions!.push({ type: 'expression', targetProperty: 'y', enabled: true, source: 'value + 1' })
+  const base = { x: 20, y: 30, width: 100, height: 100, anchorX: 0, anchorY: 0, rotation: 0, opacity: 1, cornerRadius: 0 }
+
+  expect(resolveAnimatedTransform(base, keyframes.get('layer-0'), 30, context)).toMatchObject({ x: 21, y: 31 })
+})
