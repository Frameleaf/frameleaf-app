+function requireMatchingAudioPlaneCount(actual: number, expected: number): number {
+  if (!Number.isSafeInteger(actual) || actual < 1)
+    throw new Error('Audio decode produced an invalid channel count')
+  if (expected !== 0 && actual !== expected)
+    throw new Error('Mixed audio channel counts require an explicit layout mapping')
+  return actual
+}
