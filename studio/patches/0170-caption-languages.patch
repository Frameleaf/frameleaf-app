@@ -0,0 +1,389 @@
+/**
+ * Captions in other languages (Frameleaf FL-641).
+ *
+ * The original captions are whatever the sequence already shows: transcript captions riding on a clip,
+ * subtitle segments and caption text items. Each translated language is its own caption track: one
+ * subtitle segment on a track of its own, whose `source` carries `translation`. A translated line keeps
+ * the timing its original line had when it was translated; fixing an original line later does not
+ * change the translations (translate again to update them).
+ *
+ * One language is "in the picture": its captions are shown and burned into the export, and every other
+ * language's captions are hidden. The languages ticked "Subtitle track in the export" travel with the
+ * export as subtitle files (the host reads them from the graph, `caption-languages.ts` in the web app).
+ */
+import type {
+  AudioItem,
+  SubtitleSegmentCue,
+  SubtitleSegmentItem,
+  TextItem,
+  TimelineItem,
+  TimelineTrack,
+  VideoItem,
+} from '@/types/timeline'
+
+/** English and the ten app languages, as BCP 47 primary tags (Norwegian is Bokmål). */
+export const CAPTION_LANGUAGES = ['en', 'fr', 'es', 'de', 'it', 'pt', 'nl', 'pl', 'sv', 'da', 'nb'] as const
+export type CaptionLanguage = (typeof CAPTION_LANGUAGES)[number]
+
+export const isCaptionLanguage = (value: unknown): value is CaptionLanguage =>
+  typeof value === 'string' && (CAPTION_LANGUAGES as readonly string[]).includes(value)
+
+/** What a translated caption track records about itself, on its segment's `source`. */
+export interface CaptionTranslation {
+  language: CaptionLanguage
+  /** The language of the original lines it was translated from. */
+  from: CaptionLanguage
+  /** Include it as a subtitle track (file) in the export. */
+  subtitle: boolean
+  translatedAt: number
+  /** The voice-over made from it, when there is one. */
+  voiceTrackId?: string
+}
+
+/** A caption line on the sequence, in timeline seconds. */
+export interface CaptionLine {
+  id: string
+  startSeconds: number
+  endSeconds: number
+  text: string
+}
+
+/** The voices Studio has for a language: Kokoro speaks English, Supertonic the others it knows. */
+export type CaptionVoiceEngine = 'kokoro' | 'supertonic'
+const SUPERTONIC_LANGUAGES: readonly CaptionLanguage[] = ['fr', 'es', 'de', 'it', 'pt', 'nl', 'pl', 'sv', 'da']
+export function captionVoiceFor(language: CaptionLanguage): CaptionVoiceEngine | null {
+  if (language === 'en') return 'kokoro'
+  return SUPERTONIC_LANGUAGES.includes(language) ? 'supertonic' : null
+}
+
+export type TranslatedCaptionItem = SubtitleSegmentItem & {
+  source: Extract<SubtitleSegmentItem['source'], { type: 'subtitle-import' }> & { translation: CaptionTranslation }
+}
+
+export function translationOf(item: TimelineItem): CaptionTranslation | null {
+  if (item.type !== 'subtitle' || item.source.type !== 'subtitle-import') return null
+  const translation = (item.source as { translation?: CaptionTranslation }).translation
+  return translation && isCaptionLanguage(translation.language) ? translation : null
+}
+
+export const isTranslatedCaptionItem = (item: TimelineItem): item is TranslatedCaptionItem =>
+  translationOf(item) !== null
+
+type TranscriptClip = (VideoItem | AudioItem) & {
+  transcriptCaptions: NonNullable<(VideoItem | AudioItem)['transcriptCaptions']>
+}
+const isTranscriptClip = (item: TimelineItem): item is TranscriptClip =>
+  (item.type === 'video' || item.type === 'audio') &&
+  item.transcriptCaptions?.type === 'transcript' &&
+  item.transcriptCaptions.cues.length > 0
+
+const isOriginalSegment = (item: TimelineItem): item is SubtitleSegmentItem =>
+  item.type === 'subtitle' && !isTranslatedCaptionItem(item)
+const isCaptionText = (item: TimelineItem): item is TextItem => item.type === 'text' && item.textRole === 'caption'
+
+/** Whether an item shows original captions. */
+export const isOriginalCaptionItem = (item: TimelineItem): boolean =>
+  isTranscriptClip(item) || isOriginalSegment(item) || isCaptionText(item)
+
+const round = (seconds: number) => Math.round(seconds * 1000) / 1000
+
+/**
+ * The original caption lines on the sequence, in timeline seconds, sorted. Lines clipped away by a trim
+ * are left out; blank lines are left out.
+ */
+export function collectOriginalCaptionLines(items: readonly TimelineItem[], fps: number): CaptionLine[] {
+  const lines: CaptionLine[] = []
+  const push = (id: string, start: number, end: number, text: string, windowStart: number, windowEnd: number) => {
+    const startSeconds = Math.max(windowStart, start)
+    const endSeconds = Math.min(windowEnd, end)
+    if (endSeconds <= startSeconds || text.trim().length === 0) return
+    lines.push({ id, startSeconds: round(startSeconds), endSeconds: round(endSeconds), text: text.trim() })
+  }
+  for (const item of items) {
+    const itemStart = item.from / fps
+    const itemEnd = (item.from + item.durationInFrames) / fps
+    if (isTranscriptClip(item)) {
+      if (item.isReversed === true) continue
+      const sourceFps = item.sourceFps ?? fps
+      const sourceStart = (item.sourceStart ?? 0) / sourceFps
+      const speed = item.speed ?? 1
+      for (const cue of item.transcriptCaptions.cues) {
+        push(
+          `${item.id}:${cue.id}`,
+          itemStart + (cue.startSeconds - sourceStart) / speed,
+          itemStart + (cue.endSeconds - sourceStart) / speed,
+          cue.text,
+          itemStart,
+          itemEnd,
+        )
+      }
+    } else if (isOriginalSegment(item)) {
+      for (const cue of item.cues) {
+        push(`${item.id}:${cue.id}`, itemStart + cue.startSeconds, itemStart + cue.endSeconds, cue.text, itemStart, itemEnd)
+      }
+    } else if (isCaptionText(item)) {
+      push(item.id, itemStart, itemEnd, item.text, itemStart, itemEnd)
+    }
+  }
+  return lines.sort((a, b) => a.startSeconds - b.startSeconds || a.endSeconds - b.endSeconds)
+}
+
+/** Every translated caption track, in the order the languages were added. */
+export function translatedCaptionItems(items: readonly TimelineItem[]): TranslatedCaptionItem[] {
+  return items
+    .filter(isTranslatedCaptionItem)
+    .sort((a, b) => a.source.translation.translatedAt - b.source.translation.translatedAt)
+}
+
+/** The language in the picture: the translation whose track is shown, else the original. */
+export function burnedInLanguage(
+  tracks: readonly TimelineTrack[],
+  items: readonly TimelineItem[],
+): CaptionLanguage | 'original' {
+  const shown = translatedCaptionItems(items).find(
+    (item) => tracks.find((track) => track.id === item.trackId)?.visible !== false,
+  )
+  return shown ? shown.source.translation.language : 'original'
+}
+
+/** The look of a caption track: typography, colours and placement, never its identity or cues. */
+export type CaptionStyle = Partial<
+  Pick<
+    SubtitleSegmentItem,
+    | 'fontSize'
+    | 'fontFamily'
+    | 'fontWeight'
+    | 'fontStyle'
+    | 'underline'
+    | 'color'
+    | 'backgroundColor'
+    | 'backgroundRadius'
+    | 'textPadding'
+    | 'textAlign'
+    | 'verticalAlign'
+    | 'lineHeight'
+    | 'letterSpacing'
+    | 'textShadow'
+    | 'stroke'
+    | 'transform'
+  >
+>
+
+/** The original caption style to carry over to a translation, so every language looks the same. */
+export function originalCaptionStyle(items: readonly TimelineItem[]): CaptionStyle | null {
+  const styled = items.find((item) => isOriginalSegment(item) || isCaptionText(item)) as
+    | SubtitleSegmentItem
+    | TextItem
+    | undefined
+  const transcript = items.find(isTranscriptClip)?.transcriptCaptions.style
+  const source = styled ?? transcript
+  if (!source) return null
+  const style: CaptionStyle = {
+    fontSize: source.fontSize,
+    fontFamily: source.fontFamily,
+    fontWeight: source.fontWeight,
+    fontStyle: source.fontStyle,
+    underline: source.underline,
+    backgroundColor: source.backgroundColor,
+    backgroundRadius: source.backgroundRadius,
+    textPadding: source.textPadding,
+    textAlign: source.textAlign,
+    verticalAlign: source.verticalAlign,
+    lineHeight: source.lineHeight,
+    letterSpacing: source.letterSpacing,
+    textShadow: source.textShadow ? { ...source.textShadow } : undefined,
+    stroke: source.stroke ? { ...source.stroke } : undefined,
+    transform: source.transform ? { ...source.transform } : undefined,
+  }
+  if ('color' in source && typeof source.color === 'string') style.color = source.color
+  return Object.fromEntries(Object.entries(style).filter(([, value]) => value !== undefined))
+}
+
+const defaultCaptionStyle = (canvasWidth: number, canvasHeight: number) => ({
+  fontSize: Math.max(36, Math.round(canvasHeight * 0.045)),
+  fontFamily: 'Inter',
+  fontWeight: 'semibold' as const,
+  fontStyle: 'normal' as const,
+  underline: false,
+  color: '#ffffff',
+  backgroundColor: 'rgba(0, 0, 0, 0.55)',
+  textAlign: 'center' as const,
+  verticalAlign: 'middle' as const,
+  lineHeight: 1.15,
+  letterSpacing: 0,
+  textShadow: { offsetX: 0, offsetY: 3, blur: 10, color: 'rgba(0, 0, 0, 0.75)' },
+  transform: {
+    x: 0,
+    y: Math.round(canvasHeight * 0.32),
+    width: canvasWidth * 0.82,
+    height: canvasHeight * 0.16,
+    rotation: 0,
+    opacity: 1,
+  },
+})
+
+export interface BuildTranslatedTrackOptions {
+  tracks: readonly TimelineTrack[]
+  lines: readonly CaptionLine[]
+  /** One translation per line, in the same order. */
+  translations: readonly string[]
+  language: CaptionLanguage
+  from: CaptionLanguage
+  fps: number
+  canvasWidth: number
+  canvasHeight: number
+  /** The track's name, already in the person's language ("French captions"). */
+  name: string
+  style?: CaptionStyle | null
+  now?: number
+  /** Keep these settings from the translation this one replaces. */
+  previous?: Pick<CaptionTranslation, 'subtitle'>
+}
+
+/** A new caption track holding one language: a subtitle segment on the original lines' timing. */
+export function buildTranslatedCaptionTrack(
+  options: BuildTranslatedTrackOptions,
+): { track: TimelineTrack; item: TranslatedCaptionItem } | null {
+  const { lines, translations, fps } = options
+  if (lines.length !== translations.length) throw new Error('Every caption line needs its translation')
+  const kept = lines
+    .map((line, index) => ({ line, text: (translations[index] ?? '').trim() }))
+    .filter(({ text }) => text.length > 0)
+  if (kept.length === 0) return null
+  const fromFrame = Math.max(0, Math.floor(kept[0]!.line.startSeconds * fps))
+  const endFrame = Math.max(fromFrame + 1, Math.ceil(Math.max(...kept.map(({ line }) => line.endSeconds)) * fps))
+  const offset = fromFrame / fps
+  const now = options.now ?? Date.now()
+  const cues: SubtitleSegmentCue[] = kept.map(({ line, text }, index) => ({
+    id: `${options.language}-${index + 1}`,
+    startSeconds: round(line.startSeconds - offset),
+    endSeconds: round(line.endSeconds - offset),
+    text,
+  }))
+  const maxOrder = options.tracks.reduce((highest, track) => Math.max(highest, track.order), -1)
+  const track: TimelineTrack = {
+    id: `track-captions-${options.language}-${now}`,
+    name: options.name,
+    kind: 'video',
+    height: 48,
+    locked: false,
+    syncLock: true,
+    // A new language does not take the picture: the person chooses "In the picture".
+    visible: false,
+    muted: false,
+    solo: false,
+    volume: 0,
+    // Above everything, like other caption tracks: lowest order draws on top.
+    order: Math.min(...options.tracks.map((item) => item.order), maxOrder + 1) - 1,
+    items: [],
+  }
+  const translation: CaptionTranslation = {
+    language: options.language,
+    from: options.from,
+    subtitle: options.previous?.subtitle ?? true,
+    translatedAt: now,
+  }
+  const item: TranslatedCaptionItem = {
+    id: crypto.randomUUID(),
+    type: 'subtitle',
+    trackId: track.id,
+    from: fromFrame,
+    durationInFrames: endFrame - fromFrame,
+    label: options.name,
+    sourceLabel: options.name,
+    source: {
+      type: 'subtitle-import',
+      fileName: `${options.language}.srt`,
+      format: 'srt',
+      importedAt: now,
+      translation,
+    },
+    cues,
+    ...defaultCaptionStyle(options.canvasWidth, options.canvasHeight),
+    ...(options.style ?? {}),
+  }
+  return { track, item }
+}
+
+/**
+ * The visibility changes that put `language` in the picture: its track shown and every other
+ * language's captions hidden. Transcript captions on clips are switched with their own `enabled`, so
+ * the clip itself stays visible; other original captions are hidden with their track only when the
+ * track holds nothing but captions.
+ */
+export function burnInChanges(
+  tracks: readonly TimelineTrack[],
+  items: readonly TimelineItem[],
+  language: CaptionLanguage | 'original',
+): { tracks: Array<{ id: string; visible: boolean }>; items: Array<{ id: string; enabled: boolean }> } {
+  const original = language === 'original'
+  const trackChanges = new Map<string, boolean>()
+  const itemChanges: Array<{ id: string; enabled: boolean }> = []
+  for (const item of translatedCaptionItems(items)) {
+    trackChanges.set(item.trackId, item.source.translation.language === language)
+  }
+  for (const track of tracks) {
+    if (trackChanges.has(track.id)) continue
+    const onTrack = items.filter((item) => item.trackId === track.id)
+    if (onTrack.length > 0 && onTrack.every((item) => isOriginalSegment(item) || isCaptionText(item))) {
+      trackChanges.set(track.id, original)
+    }
+  }
+  for (const item of items) {
+    if (isTranscriptClip(item) && item.transcriptCaptions.enabled !== original) {
+      itemChanges.push({ id: item.id, enabled: original })
+    }
+  }
+  return {
+    tracks: [...trackChanges]
+      .filter(([id, visible]) => tracks.find((track) => track.id === id)?.visible !== visible)
+      .map(([id, visible]) => ({ id, visible })),
+    items: itemChanges,
+  }
+}
+
+/** The lines of one translation in timeline seconds, for review beside the original and for a voice-over. */
+export function translatedLines(item: TranslatedCaptionItem, fps: number): CaptionLine[] {
+  const offset = item.from / fps
+  return item.cues.map((cue) => ({
+    id: cue.id,
+    startSeconds: round(offset + cue.startSeconds),
+    endSeconds: round(offset + cue.endSeconds),
+    text: cue.text,
+  }))
+}
+
+/** For review: the original line each translated line came from, matched by time. */
+export function originalLineFor(lines: readonly CaptionLine[], translated: CaptionLine): CaptionLine | null {
+  let best: CaptionLine | null = null
+  let bestOverlap = 0
+  for (const line of lines) {
+    const overlap = Math.min(line.endSeconds, translated.endSeconds) - Math.max(line.startSeconds, translated.startSeconds)
+    if (overlap > bestOverlap) {
+      best = line
+      bestOverlap = overlap
+    }
+  }
+  return best
+}
+
+/**
+ * Where each spoken line of a voice-over goes, in seconds from the voice-over's start: at its caption's
+ * start, or straight after the line before when that one runs long, so no two lines talk over each other.
+ */
+export function placeVoiceLines(
+  lines: readonly CaptionLine[],
+  durations: readonly number[],
+): { startSeconds: number; offsets: number[]; lengthSeconds: number } {
+  if (lines.length === 0) return { startSeconds: 0, offsets: [], lengthSeconds: 0 }
+  const startSeconds = lines[0]!.startSeconds
+  const offsets: number[] = []
+  let cursor = 0
+  lines.forEach((line, index) => {
+    const at = Math.max(line.startSeconds - startSeconds, cursor)
+    offsets.push(round(at))
+    cursor = at + (durations[index] ?? 0) + 0.05
+  })
+  const lengthSeconds = round(Math.max(...offsets.map((offset, index) => offset + (durations[index] ?? 0))))
+  return { startSeconds, offsets, lengthSeconds }
+}
diff --git a/src/i18n/locales/partials/de/caption-languages.json b/src/i18n/locales/partials/de/caption-languages.json
new file mode 100644
--- /dev/null
+++ b/src/i18n/locales/partials/de/caption-languages.json
