+/**
+ * Languages (Frameleaf FL-641): the sequence's captions in other languages, each its own caption track.
+ * Approved mock: `CaptionLanguages` in the prototype's StudioUpgrades2.jsx (2026-10-29).
+ */
+import { useEffect, useMemo, useRef, useState } from 'react'
+import { useTranslation } from 'react-i18next'
+import { Home, Languages } from 'lucide-react'
+import { toast } from 'sonner'
+import { Button } from '@/components/ui/button'
+import { useItemsStore, useTimelineStore } from '@/features/editor/deps/timeline-store'
+import { useProjectStore } from '@/features/editor/deps/projects'
+import { DEFAULT_PROJECT_HEIGHT, DEFAULT_PROJECT_WIDTH } from '@/shared/projects/defaults'
+import { PropertySection } from '../components'
+import {
+  CAPTION_LANGUAGES,
+  buildTranslatedCaptionTrack,
+  burnedInLanguage,
+  captionVoiceFor,
+  collectOriginalCaptionLines,
+  isCaptionLanguage,
+  originalCaptionStyle,
+  originalLineFor,
+  translatedCaptionItems,
+  translatedLines,
+  type CaptionLanguage,
+  type TranslatedCaptionItem,
+} from '../../../utils/caption-languages'
+import {
+  addCaptionVoiceOver,
+  addTranslatedCaptions,
+  removeCaptionLanguage,
+  setCaptionLanguageInPicture,
+  updateCaptionTranslation,
+  updateTranslatedCue,
+} from '../../../utils/caption-language-actions'
+import { getCaptionTranslator, translateCaptionLines } from '../../../services/caption-translation-host'
+
+const clock = (seconds: number) => {
+  const whole = Math.max(0, Math.floor(seconds))
+  return `${Math.floor(whole / 60)}:${String(whole % 60).padStart(2, '0')}`
+}
+
+function useLanguageName() {
+  const { i18n } = useTranslation()
+  const locale = i18n.resolvedLanguage ?? i18n.language ?? 'en'
+  return useMemo(() => {
+    let names: Intl.DisplayNames | null = null
+    try {
+      names = new Intl.DisplayNames([locale], { type: 'language' })
+    } catch {
+      names = null
+    }
+    return (code: CaptionLanguage) => {
+      const name = names?.of(code) ?? code
+      return name.charAt(0).toLocaleUpperCase(locale) + name.slice(1)
+    }
+  }, [locale])
+}
+
+export function CaptionLanguagesPanel() {
+  const { t, i18n } = useTranslation()
+  const languageName = useLanguageName()
+  const items = useItemsStore((state) => state.items)
+  const tracks = useItemsStore((state) => state.tracks)
+  const fps = useTimelineStore((state) => state.fps)
+  const project = useProjectStore((state) => state.currentProject)
+
+  const lines = useMemo(() => collectOriginalCaptionLines(items, fps), [items, fps])
+  const translations = useMemo(() => translatedCaptionItems(items), [items])
+  const inPicture = burnedInLanguage(tracks, items)
+
+  const guessedOriginal = (() => {
+    const recorded = translations[0]?.source.translation.from
+    if (recorded) return recorded
+    const ui = (i18n.resolvedLanguage ?? 'en').split('-')[0]
+    return isCaptionLanguage(ui) ? ui : 'en'
+  })()
+  const [original, setOriginal] = useState<CaptionLanguage>(guessedOriginal)
+  const available = CAPTION_LANGUAGES.filter(
+    (code) => code !== original && !translations.some((item) => item.source.translation.language === code),
+  )
+  const [target, setTarget] = useState<CaptionLanguage | ''>(available[0] ?? '')
+  if (target !== '' && !available.includes(target)) setTarget(available[0] ?? '')
+
+  const [open, setOpen] = useState<string | null>(null)
+  const [job, setJob] = useState<{ kind: 'translate' | 'voice'; language: CaptionLanguage; percent: number } | null>(
+    null,
+  )
+  const abortRef = useRef<AbortController | null>(null)
+  useEffect(() => () => abortRef.current?.abort(), [])
+
+  if (lines.length === 0 && translations.length === 0) return null
+
+  const translate = async (language: CaptionLanguage) => {
+    if (!getCaptionTranslator()) {
+      toast.error(t('captionLanguages.unavailable'))
+      return
+    }
+    abortRef.current?.abort()
+    const controller = new AbortController()
+    abortRef.current = controller
+    setJob({ kind: 'translate', language, percent: 0 })
+    try {
+      const translated = await translateCaptionLines(
+        { source: original, target: language, lines: lines.map((line) => line.text) },
+        (done, total) => setJob({ kind: 'translate', language, percent: Math.round((done / total) * 100) }),
+      )
+      if (controller.signal.aborted) return
+      const state = useItemsStore.getState()
+      const previous = translatedCaptionItems(state.items).find((item) => item.source.translation.language === language)
+      const metadata = project?.metadata
+      const built = buildTranslatedCaptionTrack({
+        tracks: state.tracks,
+        lines,
+        translations: translated,
+        language,
+        from: original,
+        fps,
+        canvasWidth: metadata?.width ?? DEFAULT_PROJECT_WIDTH,
+        canvasHeight: metadata?.height ?? DEFAULT_PROJECT_HEIGHT,
+        name: t('captionLanguages.trackName', { language: languageName(language) }),
+        style: originalCaptionStyle(state.items),
+        previous: previous?.source.translation,
+      })
+      if (!built) {
+        toast.error(t('captionLanguages.failed'))
+        return
+      }
+      addTranslatedCaptions(built.track, built.item)
+      setOpen(language)
+      toast.success(t('captionLanguages.ready', { language: languageName(language) }))
+    } catch {
+      if (!controller.signal.aborted) toast.error(t('captionLanguages.failed'))
+    } finally {
+      if (abortRef.current === controller) {
+        abortRef.current = null
+        setJob(null)
+      }
+    }
+  }
+
+  const makeVoiceOver = async (item: TranslatedCaptionItem) => {
+    const language = item.source.translation.language
+    abortRef.current?.abort()
+    const controller = new AbortController()
+    abortRef.current = controller
+    setJob({ kind: 'voice', language, percent: 0 })
+    try {
+      const { makeCaptionVoiceOver } = await import('../../../services/caption-voice-over')
+      const voice = await makeCaptionVoiceOver({
+        language,
+        lines: translatedLines(item, fps),
+        fps,
+        tracks: useItemsStore.getState().tracks,
+        name: t('captionLanguages.voiceTrackName', { language: languageName(language) }),
+        signal: controller.signal,
+        onProgress: (done, total) => setJob({ kind: 'voice', language, percent: Math.round((done / total) * 100) }),
+      })
+      if (controller.signal.aborted) return
+      addCaptionVoiceOver(item.id, voice.track, voice.audio)
+      toast.success(t('captionLanguages.voiceReady', { language: languageName(language) }))
+    } catch {
+      if (!controller.signal.aborted) toast.error(t('captionLanguages.voiceFailed'))
+    } finally {
+      if (abortRef.current === controller) {
+        abortRef.current = null
+        setJob(null)
+      }
+    }
+  }
+
+  const busy = job !== null
+  const originalName = languageName(original)
+
+  return (
+    <PropertySection title={t('captionLanguages.title')} icon={Languages} defaultOpen={true}>
+      <div className="space-y-3 px-1 text-xs" data-frameleaf="caption-languages">
+        <ul className="space-y-2">
+          <li className="rounded border border-border px-2 py-1.5">
+            <div className="flex items-center justify-between gap-2">
+              <label className="flex min-w-0 flex-col">
+                <span className="sr-only">{t('captionLanguages.originalLanguage')}</span>
+                <select
+                  aria-label={t('captionLanguages.originalLanguage')}
+                  className="bg-transparent font-medium"
+                  value={original}
+                  disabled={busy || translations.length > 0}
+                  onChange={(event) => isCaptionLanguage(event.target.value) && setOriginal(event.target.value)}
+                >
+                  {CAPTION_LANGUAGES.map((code) => (
+                    <option key={code} value={code}>
+                      {languageName(code)}
+                    </option>
+                  ))}
+                </select>
+                <span className="text-muted-foreground">{t('captionLanguages.original', { count: lines.length })}</span>
+              </label>
+              <label className="flex items-center gap-1">
+                <input
+                  type="radio"
+                  name="caption-language-in-picture"
+                  checked={inPicture === 'original'}
+                  onChange={() => setCaptionLanguageInPicture('original')}
+                />
+                {t('captionLanguages.inPicture')}
+              </label>
+            </div>
+          </li>
+          {translations.map((item) => {
+            const translation = item.source.translation
+            const language = translation.language
+            const name = languageName(language)
+            const voiced = !!translation.voiceTrackId && tracks.some((track) => track.id === translation.voiceTrackId)
+            const voice = captionVoiceFor(language)
+            const shown = open === language
+            const translated = shown ? translatedLines(item, fps) : []
+            return (
+              <li key={item.id} className="rounded border border-border px-2 py-1.5" data-language={language}>
+                <div className="flex items-center justify-between gap-2">
+                  <span className="flex min-w-0 flex-col">
+                    <b className="font-medium">{name}</b>
+                    <span className="text-muted-foreground">
+                      {voiced
+                        ? t('captionLanguages.translatedVoice', { count: item.cues.length })
+                        : t('captionLanguages.translated', { count: item.cues.length })}
+                    </span>
+                  </span>
+                  <label className="flex items-center gap-1">
+                    <input
+                      type="radio"
+                      name="caption-language-in-picture"
+                      checked={inPicture === language}
+                      onChange={() => setCaptionLanguageInPicture(language)}
+                    />
+                    {t('captionLanguages.inPicture')}
+                  </label>
+                </div>
+                <div className="mt-1 flex flex-wrap items-center gap-x-3 gap-y-1">
+                  <label className="flex items-center gap-1">
+                    <input
+                      type="checkbox"
+                      checked={translation.subtitle}
+                      onChange={(event) => updateCaptionTranslation(item.id, { subtitle: event.target.checked })}
+                    />
+                    {t('captionLanguages.subtitleTrack')}
+                  </label>
+                  <button
+                    type="button"
+                    className="text-primary underline-offset-2 hover:underline"
+                    aria-expanded={shown}
+                    onClick={() => setOpen(shown ? null : language)}
+                  >
+                    {shown ? t('captionLanguages.hideLines') : t('captionLanguages.reviewLines')}
+                  </button>
+                  {voice && !voiced && (
+                    <button
+                      type="button"
+                      className="text-primary underline-offset-2 hover:underline disabled:opacity-50"
+                      disabled={busy}
+                      onClick={() => void makeVoiceOver(item)}
+                    >
+                      {t('captionLanguages.makeVoiceOver', { language: name })}
+                    </button>
+                  )}
+                  <button
+                    type="button"
+                    className="text-primary underline-offset-2 hover:underline disabled:opacity-50"
+                    disabled={busy || lines.length === 0}
+                    onClick={() => void translate(language)}
+                  >
+                    {t('captionLanguages.translateAgain')}
+                  </button>
+                  <button
+                    type="button"
+                    className="text-primary underline-offset-2 hover:underline"
+                    onClick={() => removeCaptionLanguage(item.id)}
+                  >
+                    {t('captionLanguages.remove')}
+                  </button>
+                </div>
+                {!voice && <p className="mt-1 text-muted-foreground">{t('captionLanguages.noVoice', { language: name })}</p>}
+                {shown && (
+                  <ol className="mt-2 space-y-1.5">
+                    {item.cues.map((cue, index) => {
+                      const line = translated[index]!
+                      const source = originalLineFor(lines, line)
+                      return (
+                        <li key={cue.id} className="grid grid-cols-[auto_1fr] gap-x-2 gap-y-0.5">
+                          <span className="text-muted-foreground tabular-nums">{clock(line.startSeconds)}</span>
+                          <span className="text-muted-foreground">{source?.text ?? ''}</span>
+                          <span />
+                          <input
+                            className="h-7 w-full rounded border border-border bg-transparent px-2"
+                            aria-label={t('captionLanguages.lineLabel', { language: name, time: clock(line.startSeconds) })}
+                            defaultValue={cue.text}
+                            onBlur={(event) => {
+                              if (event.target.value !== cue.text) updateTranslatedCue(item.id, cue.id, event.target.value)
+                            }}
+                          />
+                        </li>
+                      )
+                    })}
+                  </ol>
+                )}
+              </li>
+            )
+          })}
+        </ul>
+
+        {job && (
+          <div role="status" aria-live="polite" className="space-y-1">
+            <span>
+              {t(job.kind === 'translate' ? 'captionLanguages.translating' : 'captionLanguages.makingVoice', {
+                language: languageName(job.language),
+                percent: job.percent,
+              })}
+            </span>
+            <progress className="w-full" max={100} value={job.percent} />
+          </div>
+        )}
+
+        {available.length > 0 && lines.length > 0 && target !== '' && (
+          <div className="flex items-end gap-2">
+            <label className="flex min-w-0 flex-1 flex-col gap-1">
+              <span>{t('captionLanguages.addLanguage')}</span>
+              <select
+                className="h-7 rounded border border-border bg-transparent px-1"
+                value={target}
+                onChange={(event) => isCaptionLanguage(event.target.value) && setTarget(event.target.value)}
+              >
+                {available.map((code) => (
+                  <option key={code} value={code}>
+                    {languageName(code)}
+                  </option>
+                ))}
+              </select>
+            </label>
+            <Button size="sm" disabled={busy} onClick={() => void translate(target)}>
+              <Languages className="h-3.5 w-3.5" />
+              {t('captionLanguages.translate')}
+            </Button>
+          </div>
+        )}
+
+        <p className="text-muted-foreground">{t('captionLanguages.note', { language: originalName })}</p>
+        <p className="flex items-start gap-1 text-muted-foreground">
+          <Home className="mt-0.5 h-3.5 w-3.5 shrink-0" />
+          <span>{t('captionLanguages.whereItRuns')}</span>
+        </p>
+      </div>
+    </PropertySection>
+  )
+}
