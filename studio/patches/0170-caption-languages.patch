+/**
+ * Where caption translation runs (Frameleaf FL-641). The editor never reaches the server itself: the
+ * host adapter registers a translator that asks the Frameleaf host, which translates on the processing
+ * order ("Where work runs"). Without one, Translate says the feature is unavailable.
+ */
+import type { CaptionLanguage } from '../utils/caption-languages'
+
+export interface CaptionTranslationRequest {
+  source: CaptionLanguage
+  target: CaptionLanguage
+  /** The caption lines as text, in order. Timing stays in the editor. */
+  lines: string[]
+}
+
+export interface CaptionTranslationResult {
+  /** One translation per line asked for, in the same order. */
+  lines: string[]
+}
+
+export type CaptionTranslator = (request: CaptionTranslationRequest) => Promise<CaptionTranslationResult>
+
+let translator: CaptionTranslator | null = null
+
+export function setCaptionTranslator(next: CaptionTranslator | null): void {
+  translator = next
+}
+
+export function getCaptionTranslator(): CaptionTranslator | null {
+  return translator
+}
+
+/** The host takes at most this many lines at once; longer projects are sent in parts. */
+export const CAPTION_TRANSLATION_BATCH = 500
+
+/** Translate every line, in parts of at most {@link CAPTION_TRANSLATION_BATCH}, keeping their order. */
+export async function translateCaptionLines(
+  request: CaptionTranslationRequest,
+  onProgress?: (done: number, total: number) => void,
+): Promise<string[]> {
+  const translate = getCaptionTranslator()
+  if (!translate) throw new Error('Caption translation is not available here')
+  const out: string[] = []
+  for (let start = 0; start < request.lines.length; start += CAPTION_TRANSLATION_BATCH) {
+    const part = request.lines.slice(start, start + CAPTION_TRANSLATION_BATCH)
+    const result = await translate({ ...request, lines: part })
+    if (!Array.isArray(result?.lines) || result.lines.length !== part.length) {
+      throw new Error('The translation did not cover every line')
+    }
+    out.push(...result.lines.map((line) => (typeof line === 'string' ? line : '')))
+    onProgress?.(Math.min(request.lines.length, start + part.length), request.lines.length)
+  }
+  return out
+}
