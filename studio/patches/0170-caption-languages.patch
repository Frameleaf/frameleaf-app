new file mode 100644
--- /dev/null
+++ b/src/features/editor/utils/caption-language-actions.ts
@@ -0,0 +1,178 @@
+/**
+ * Timeline edits for captions in other languages (Frameleaf FL-641). Each is one undo step.
+ */
+import {
+  executeTimelineCommand,
+  useItemsStore,
+  useTimelineSettingsStore,
+} from '@/features/editor/deps/timeline-store'
+import type { AudioItem, TimelineItem, TimelineTrack } from '@/types/timeline'
+import {
+  burnInChanges,
+  translatedCaptionItems,
+  translationOf,
+  type CaptionLanguage,
+  type CaptionTranslation,
+  type TranslatedCaptionItem,
+} from './caption-languages'
+
+const markDirty = () => useTimelineSettingsStore.getState().markDirty()
+
+/** Add a language's caption track, or replace the one it had (translate again). */
+export function addTranslatedCaptions(track: TimelineTrack, item: TranslatedCaptionItem): void {
+  executeTimelineCommand(
+    'CAPTION_LANGUAGE_ADD',
+    () => {
+      const store = useItemsStore.getState()
+      const replaced = translatedCaptionItems(store.items).find(
+        (existing) => existing.source.translation.language === item.source.translation.language,
+      )
+      let tracks = [...store.tracks]
+      if (replaced) {
+        const old = tracks.find((candidate) => candidate.id === replaced.trackId)
+        // Translating again keeps the language's place, visibility and voice-over.
+        track = { ...track, id: replaced.trackId, order: old?.order ?? track.order, visible: old?.visible ?? track.visible }
+        item = {
+          ...item,
+          trackId: replaced.trackId,
+          source: {
+            ...item.source,
+            translation: { ...item.source.translation, voiceTrackId: replaced.source.translation.voiceTrackId },
+          },
+        }
+        store._removeItems([replaced.id])
+        tracks = tracks.map((candidate) => (candidate.id === track.id ? { ...candidate, name: track.name } : candidate))
+      } else {
+        tracks.push(track)
+      }
+      store.setTracks(tracks)
+      store._addItems([item])
+      markDirty()
+    },
+    { language: item.source.translation.language },
+  )
+}
+
+/** Put one language in the picture; every other language's captions are hidden. */
+export function setCaptionLanguageInPicture(language: CaptionLanguage | 'original'): void {
+  executeTimelineCommand(
+    'CAPTION_LANGUAGE_IN_PICTURE',
+    () => {
+      const store = useItemsStore.getState()
+      const changes = burnInChanges(store.tracks, store.items, language)
+      if (changes.tracks.length > 0) {
+        const visible = new Map(changes.tracks.map((change) => [change.id, change.visible]))
+        store.setTracks(
+          store.tracks.map((track) => (visible.has(track.id) ? { ...track, visible: visible.get(track.id)! } : track)),
+        )
+      }
+      for (const change of changes.items) {
+        const item = store.items.find((candidate) => candidate.id === change.id)
+        if ((item?.type === 'video' || item?.type === 'audio') && item.transcriptCaptions) {
+          store._updateItem(change.id, {
+            transcriptCaptions: { ...item.transcriptCaptions, enabled: change.enabled },
+          } as Partial<TimelineItem>)
+        }
+      }
+      markDirty()
+    },
+    { language },
+  )
+}
+
+/** Change what a language records about itself (subtitle track in the export, its voice-over). */
+export function updateCaptionTranslation(itemId: string, change: Partial<CaptionTranslation>): void {
+  executeTimelineCommand(
+    'CAPTION_LANGUAGE_UPDATE',
+    () => {
+      const store = useItemsStore.getState()
+      const item = store.items.find((candidate) => candidate.id === itemId)
+      const translation = item && translationOf(item)
+      if (!item || item.type !== 'subtitle' || !translation) return
+      store._updateItem(itemId, {
+        source: { ...item.source, translation: { ...translation, ...change } },
+      } as Partial<TimelineItem>)
+      markDirty()
+    },
+    { itemId },
+  )
+}
+
+/** Correct one translated line. Its timing and the original line stay as they are. */
+export function updateTranslatedCue(itemId: string, cueId: string, text: string): void {
+  executeTimelineCommand(
+    'CAPTION_LANGUAGE_LINE',
+    () => {
+      const store = useItemsStore.getState()
+      const item = store.items.find((candidate) => candidate.id === itemId)
+      if (!item || item.type !== 'subtitle') return
+      store._updateItem(itemId, {
+        cues: item.cues.map((cue) => (cue.id === cueId ? { ...cue, text } : cue)),
+      } as Partial<TimelineItem>)
+      markDirty()
+    },
+    { itemId, cueId },
+  )
+}
+
+/** Remove a language: its caption track and the voice-over made from it. */
+export function removeCaptionLanguage(itemId: string): void {
+  executeTimelineCommand(
+    'CAPTION_LANGUAGE_REMOVE',
+    () => {
+      const store = useItemsStore.getState()
+      const item = store.items.find((candidate) => candidate.id === itemId)
+      const translation = item && translationOf(item)
+      if (!item || !translation) return
+      const wasShown = store.tracks.find((track) => track.id === item.trackId)?.visible !== false
+      const trackIds = new Set([item.trackId, ...(translation.voiceTrackId ? [translation.voiceTrackId] : [])])
+      const removed = store.items.filter((candidate) => trackIds.has(candidate.trackId)).map((candidate) => candidate.id)
+      store._removeItems(removed)
+      store.setTracks(store.tracks.filter((track) => !trackIds.has(track.id)))
+      markDirty()
+      // Removing the language in the picture puts the original back.
+      if (wasShown) {
+        const after = useItemsStore.getState()
+        const changes = burnInChanges(after.tracks, after.items, 'original')
+        const visible = new Map(changes.tracks.map((change) => [change.id, change.visible]))
+        after.setTracks(
+          after.tracks.map((track) => (visible.has(track.id) ? { ...track, visible: visible.get(track.id)! } : track)),
+        )
+        for (const change of changes.items) {
+          const clip = after.items.find((candidate) => candidate.id === change.id)
+          if ((clip?.type === 'video' || clip?.type === 'audio') && clip.transcriptCaptions) {
+            after._updateItem(change.id, {
+              transcriptCaptions: { ...clip.transcriptCaptions, enabled: change.enabled },
+            } as Partial<TimelineItem>)
+          }
+        }
+      }
+    },
+    { itemId },
+  )
+}
+
+/** Place a language's voice-over on its own voice track, ducking everything else under it. */
+export function addCaptionVoiceOver(captionItemId: string, track: TimelineTrack, audio: AudioItem): void {
+  executeTimelineCommand(
+    'CAPTION_LANGUAGE_VOICE',
+    () => {
+      const store = useItemsStore.getState()
+      const item = store.items.find((candidate) => candidate.id === captionItemId)
+      const translation = item && translationOf(item)
+      if (!item || item.type !== 'subtitle' || !translation) return
+      const previous = translation.voiceTrackId
+      if (previous) {
+        store._removeItems(store.items.filter((candidate) => candidate.trackId === previous).map((candidate) => candidate.id))
+      }
+      const tracks = store.tracks.filter((candidate) => candidate.id !== previous)
+      store.setTracks([...tracks, track])
+      store._addItems([audio])
+      store._updateItem(captionItemId, {
+        source: { ...item.source, translation: { ...translation, voiceTrackId: track.id } },
+      } as Partial<TimelineItem>)
+      markDirty()
+    },
+    { captionItemId },
+  )
+}
