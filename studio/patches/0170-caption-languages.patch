@@ -0,0 +1,152 @@
+/**
+ * A translated voice-over (Frameleaf FL-641): each translated caption line spoken with the text to
+ * speech Studio already has for that language (Kokoro for English, Supertonic for the others it
+ * knows), put together into one sound at the captions' timing, and placed on its own voice track with
+ * everything else ducking under it.
+ */
+import { importMediaLibraryService, useMediaLibraryStore } from '@/features/editor/deps/media-library'
+import type { AudioItem, TimelineTrack } from '@/types/timeline'
+import type { SupertonicTtsLanguageSelection } from './supertonic-tts-service'
+import { captionVoiceFor, placeVoiceLines, type CaptionLanguage, type CaptionLine } from '../utils/caption-languages'
+
+const SAMPLE_RATE = 24_000
+/** How far everything else is turned down while the voice-over speaks. */
+export const VOICE_OVER_DUCK_DB = -12
+
+async function speak(language: CaptionLanguage, text: string): Promise<Blob> {
+  const engine = captionVoiceFor(language)
+  if (engine === 'kokoro') {
+    const { kokoroTtsService } = await import('./kokoro-tts-service')
+    return (await kokoroTtsService.generateSpeechFile({ text, voice: 'af_heart', speed: 1, model: 'fp32' })).blob
+  }
+  if (engine === 'supertonic') {
+    const { supertonicTtsService } = await import('./supertonic-tts-service')
+    // captionVoiceFor only names Supertonic for languages it speaks.
+    const result = await supertonicTtsService.generateSpeechFile({
+      text,
+      voice: 'F1',
+      language: language as SupertonicTtsLanguageSelection,
+      speed: 1,
+    })
+    return result.blob
+  }
+  throw new Error(`Studio has no voice for ${language}`)
+}
+
+async function decode(blob: Blob): Promise<Float32Array> {
+  const context = new OfflineAudioContext(1, 1, SAMPLE_RATE)
+  const buffer = await context.decodeAudioData(await blob.arrayBuffer())
+  if (buffer.numberOfChannels === 1) return buffer.getChannelData(0)
+  const mono = new Float32Array(buffer.length)
+  for (let channel = 0; channel < buffer.numberOfChannels; channel++) {
+    const data = buffer.getChannelData(channel)
+    for (let index = 0; index < data.length; index++) mono[index]! += data[index]! / buffer.numberOfChannels
+  }
+  return mono
+}
+
+/** 16-bit mono PCM WAV of samples in -1..1. */
+export function encodeWav(samples: Float32Array, sampleRate = SAMPLE_RATE): Blob {
+  const view = new DataView(new ArrayBuffer(44 + samples.length * 2))
+  const text = (offset: number, value: string) => {
+    for (let index = 0; index < value.length; index++) view.setUint8(offset + index, value.charCodeAt(index))
+  }
+  text(0, 'RIFF')
+  view.setUint32(4, 36 + samples.length * 2, true)
+  text(8, 'WAVE')
+  text(12, 'fmt ')
+  view.setUint32(16, 16, true)
+  view.setUint16(20, 1, true)
+  view.setUint16(22, 1, true)
+  view.setUint32(24, sampleRate, true)
+  view.setUint32(28, sampleRate * 2, true)
+  view.setUint16(32, 2, true)
+  view.setUint16(34, 16, true)
+  text(36, 'data')
+  view.setUint32(40, samples.length * 2, true)
+  for (let index = 0; index < samples.length; index++) {
+    const sample = Math.max(-1, Math.min(1, samples[index]!))
+    view.setInt16(44 + index * 2, Math.round(sample * 32767), true)
+  }
+  return new Blob([view.buffer], { type: 'audio/wav' })
+}
+
+/** Put each spoken line at its place in one buffer. */
+export function mixVoiceLines(clips: readonly Float32Array[], offsets: readonly number[], lengthSeconds: number): Float32Array {
+  const out = new Float32Array(Math.max(1, Math.ceil(lengthSeconds * SAMPLE_RATE)))
+  clips.forEach((clip, index) => {
+    const at = Math.round((offsets[index] ?? 0) * SAMPLE_RATE)
+    out.set(clip.subarray(0, Math.max(0, out.length - at)), at)
+  })
+  return out
+}
+
+export interface CaptionVoiceOver {
+  track: TimelineTrack
+  audio: AudioItem
+}
+
+/** Speak every line and import the result into the project's media; nothing is placed yet. */
+export async function makeCaptionVoiceOver(options: {
+  language: CaptionLanguage
+  lines: readonly CaptionLine[]
+  fps: number
+  tracks: readonly TimelineTrack[]
+  /** The voice track's name, already in the person's language ("French voice-over"). */
+  name: string
+  signal?: AbortSignal
+  onProgress?: (done: number, total: number) => void
+}): Promise<CaptionVoiceOver> {
+  const { language, lines, fps } = options
+  const projectId = useMediaLibraryStore.getState().currentProjectId
+  if (!projectId) throw new Error('No project is open')
+  const spoken: Float32Array[] = []
+  for (const [index, line] of lines.entries()) {
+    options.signal?.throwIfAborted()
+    spoken.push(await decode(await speak(language, line.text)))
+    options.onProgress?.(index + 1, lines.length)
+  }
+  const placed = placeVoiceLines(lines, spoken.map((clip) => clip.length / SAMPLE_RATE))
+  const blob = encodeWav(mixVoiceLines(spoken, placed.offsets, placed.lengthSeconds))
+  const file = new File([blob], `voice-over-${language}-${Date.now()}.wav`, { type: 'audio/wav', lastModified: Date.now() })
+  options.signal?.throwIfAborted()
+  const { mediaLibraryService } = await importMediaLibraryService()
+  const media = await mediaLibraryService.importGeneratedAudio(file, projectId, { tags: ['voice-over', language] })
+  await useMediaLibraryStore.getState().loadMediaItems()
+
+  const maxOrder = options.tracks.reduce((highest, track) => Math.max(highest, track.order), -1)
+  const track: TimelineTrack = {
+    id: `track-voice-${language}-${Date.now()}`,
+    name: options.name,
+    kind: 'audio',
+    height: 48,
+    locked: false,
+    syncLock: true,
+    visible: true,
+    muted: false,
+    solo: false,
+    volume: 0,
+    order: maxOrder + 1,
+    items: [],
+  }
+  const sourceFps = media.fps || fps
+  const audio: AudioItem = {
+    id: crypto.randomUUID(),
+    type: 'audio',
+    trackId: track.id,
+    from: Math.max(0, Math.round(placed.startSeconds * fps)),
+    durationInFrames: Math.max(1, Math.round(media.duration * fps)),
+    label: options.name,
+    mediaId: media.id,
+    originId: crypto.randomUUID(),
+    src: URL.createObjectURL(blob),
+    sourceStart: 0,
+    sourceEnd: Math.round(media.duration * sourceFps),
+    sourceDuration: Math.round(media.duration * sourceFps),
+    sourceFps,
+    trimStart: 0,
+    trimEnd: 0,
+    audioDucking: { duckOthersDb: VOICE_OVER_DUCK_DB, attackSec: 0.08, releaseSec: 0.25 },
+  }
+  return { track, audio }
+}
