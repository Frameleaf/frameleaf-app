+ * (odd, so out-of-range components keep their sign) before they meet linear light.
+ */
+export function packLinearHdrUniforms(id: string, uniforms: Float32Array): Float32Array {
+  if (id !== 'dipToColorDissolve') return uniforms
+  const out = new Float32Array(uniforms)
+  for (const index of [3, 4, 5]) out[index] = srgbDecodeExtended(out[index]!)
+  return out
 }
 
