+export function linearHdrTransitionWgsl(def: GpuTransitionDefinition): string {
+  if (def.id === 'additiveDissolve') return LINEAR_ADDITIVE_WGSL
+  const signature = `@fragment\nfn ${def.entryPoint}(input: VertexOutput) -> @location(0) vec4f`
+  if (!def.shader.includes(signature))
+    throw new Error(`Unsupported transition entry point: ${def.id}`)
+  return /* wgsl */ `
+${effectRangeWgsl(true)}
+${def.shader.replace(signature, `fn ${def.entryPoint}(input: VertexOutput) -> vec4f`)}
+@fragment
+fn linearTransitionFragment(input: VertexOutput) -> @location(0) vec4f {
+  var color: vec4f;
+  if (params.progress <= 0.0) {
+    color = textureSampleLevel(leftTex, texSampler, input.uv, 0.0);
+  } else if (params.progress >= 1.0) {
+    color = textureSampleLevel(rightTex, texSampler, input.uv, 0.0);
+  } else {
