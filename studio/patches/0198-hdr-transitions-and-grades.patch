+/**
+ * FL-1556: grading operators in linear HDR.
+ *
+ * Curves, LUTs, colour wheels and the chroma key are authored against display-encoded
+ * values: curve points and LUT tables cover [0, 1] of an sRGB-encoded signal, wheel zones
+ * and key tolerances are measured on it. In an HDR project they act on the extended sRGB
+ * encoding of the linear working value (IEC 61966-2-1 by odd symmetry, the curve SDR
+ * media are decoded with on ingest), and the result is decoded back to linear light.
+ * So an SDR source in an HDR project is graded exactly as in an SDR project, light above
+ * reference white keeps its encoded offset past a [0, 1] table, and negative (wide-gamut)
+ * components keep their sign. SDR projects and the rgba8 route run the pinned SDR
+ * arithmetic unchanged: both helpers are identities there.
+ *
+ * Requires effectRangeWgsl (FL_EXTENDED_RANGE) earlier in the module.
+ */
+export const LINEAR_GRADE_WGSL = /* wgsl */ `
+fn fl_grade_encode3(c: vec3f) -> vec3f {
+  if (!FL_EXTENDED_RANGE) { return c; }
+  let a = abs(c);
+  let curve = 1.055 * pow(a, vec3f(1.0 / 2.4)) - vec3f(0.055);
+  return sign(c) * select(curve, a * 12.92, a <= vec3f(0.0031308));
+}
+fn fl_grade_decode3(c: vec3f) -> vec3f {
+  if (!FL_EXTENDED_RANGE) { return c; }
+  let a = abs(c);
+  let curve = pow((a + vec3f(0.055)) / 1.055, vec3f(2.4));
+  return sign(c) * select(curve, a / 12.92, a <= vec3f(0.04045));
+}`
