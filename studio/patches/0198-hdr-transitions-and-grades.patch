diff --git a/src/infrastructure/gpu-transitions/linear-hdr.test.ts b/src/infrastructure/gpu-transitions/linear-hdr.test.ts
new file mode 100644
--- /dev/null
+++ b/src/infrastructure/gpu-transitions/linear-hdr.test.ts
@@ -0,0 +1,105 @@
+// @vitest-environment node
+
+import { describe, expect, it } from 'vite-plus/test'
+import { isLinearHdrEffectType } from '@/infrastructure/gpu-effects/registry'
+import { srgbDecodeExtended } from '@/shared/graphics/color/managed-color'
+import { getGpuTransition, getGpuTransitionIds } from './registry'
+import {
+  getLinearHdrTransitionIds,
+  isLinearHdrTransition,
+  LINEAR_TRANSITION_COMMON_WGSL,
+  linearHdrEntryPoint,
+  linearHdrTransitionWgsl,
+  packLinearHdrUniforms,
+} from './linear-additive'
+
+// FL-1556: the operators admitted to linear HDR. Every other operator stays refused.
+const LINEAR_TRANSITIONS = [
+  'additiveDissolve',
+  'dissolve',
+  'fade',
+  'nonAdditiveDissolve',
+  'dipToColorDissolve',
+  'blurDissolve',
+  'wipe',
+  'slide',
+  'iris',
+  'clockWipe',
+  'flip',
+  'pixelate',
+  'radialBlur',
+]
+const REFUSED_GPU_TRANSITIONS = [
+  'smoothCut',
+  'sparkles',
+  'glitch',
+  'chromatic',
+  'liquidDistort',
+  'lensWarpZoom',
+  'lightLeakBurn',
+  'filmGateSlip',
+  // FL-1564's transitions stay refused in HDR until they get their own linear pages.
+  'filmDissolve',
+  'crossZoom',
+  'cubeSpin',
+  'pagePeel',
+]
+
+describe('linear HDR operators', () => {
+  it('admits exactly the mix, selection and geometric transitions', () => {
+    expect(getLinearHdrTransitionIds().sort()).toEqual([...LINEAR_TRANSITIONS].sort())
+    expect(getGpuTransitionIds().filter((id) => !isLinearHdrTransition(id)).sort()).toEqual(
+      [...REFUSED_GPU_TRANSITIONS].sort(),
+    )
+    expect(isLinearHdrTransition('crossfade')).toBe(false)
+  })
+
+  it('compiles each admitted page fragment behind the linear wrapper without SDR clamps', () => {
+    expect(LINEAR_TRANSITION_COMMON_WGSL).toContain('const preserveTransitionRange: bool = true;')
+    expect(LINEAR_TRANSITION_COMMON_WGSL).not.toContain('override preserveTransitionRange')
+    for (const id of LINEAR_TRANSITIONS) {
+      const def = getGpuTransition(id)!
+      const wgsl = linearHdrTransitionWgsl(def)
+      const entry = linearHdrEntryPoint(id)
+      expect(wgsl).toContain(`fn ${entry}(input: VertexOutput) -> @location(0) vec4f`)
+      expect(wgsl).toContain('fl_half_coverage')
+      if (id !== 'additiveDissolve') {
+        expect(wgsl).toContain(`fn ${def.entryPoint}(input: VertexOutput) -> vec4f`)
+        expect(wgsl).not.toContain(`fn ${def.entryPoint}(input: VertexOutput) -> @location(0) vec4f`)
+      }
+    }
+  })
+
+  it('decodes the dip colour, and only it, into linear light', () => {
+    const def = getGpuTransition('dipToColorDissolve')!
+    const packed = def.packUniforms(0.25, 48, 27, 0, { color: [0.5, 1, -0.25] })
+    const linear = packLinearHdrUniforms('dipToColorDissolve', packed)
+    expect(Array.from(linear.slice(0, 3))).toEqual(Array.from(packed.slice(0, 3)))
+    expect(linear[3]).toBeCloseTo(srgbDecodeExtended(0.5), 6)
+    expect(linear[4]).toBe(1)
+    expect(linear[5]).toBeCloseTo(-srgbDecodeExtended(0.25), 6)
+    const dissolve = getGpuTransition('dissolve')!.packUniforms(0.5, 48, 27, 0)
+    expect(packLinearHdrUniforms('dissolve', dissolve)).toBe(dissolve)
+  })
+
+  it('admits the grading effects and keeps stylised effects refused', () => {
+    for (const id of [
+      'gpu-curves',
+      'gpu-lut',
+      'gpu-color-wheels',
+      'gpu-chroma-key',
+      'gpu-sharpen',
+      'gpu-brightness',
+    ])
+      expect(isLinearHdrEffectType(id), id).toBe(true)
+    for (const id of [
+      'gpu-levels',
+      'gpu-hue-shift',
+      'gpu-glow',
+      'gpu-vignette',
+      'gpu-file-lut-v1',
