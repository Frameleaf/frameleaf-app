+import { TRANSITION_CONFIGS, type TransitionDefinition } from '@/types/transition'
+
+type TransitionProperties = Record<string, unknown>
+
+const isFiniteNumber = (value: unknown): value is number =>
+  typeof value === 'number' && Number.isFinite(value)
+
+/**
+ * FL-99: the inputs a transition is drawn with. A stored or imported value that
+ * is not what the transition declares reaches every renderer (preview and
+ * export, GPU and Canvas2D) and the audio crossfade as its declared meaning
+ * instead of an undefined one. The rule is the one effect parameters follow:
+ * - a finite number outside its declared range is clamped to the range;
+ * - a value that is not a finite number falls back to the declared default.
+ *
+ * The duration's range is one frame and up, in whole frames; its default is the
+ * transition type's default duration. A non-finite duration used to give a
+ * window with no start or end, which kept the outgoing clip on screen for the
+ * whole incoming clip.
+ */
+export function resolveTransitionDuration(durationInFrames: unknown): number {
+  if (!isFiniteNumber(durationInFrames)) return TRANSITION_CONFIGS.crossfade.defaultDuration
+  return Math.max(1, Math.floor(durationInFrames))
+}
+
+/** The alignment's range is [0, 1]; its default is centred on the cut. */
+export function resolveTransitionAlignment(alignment: unknown): number {
+  if (!isFiniteNumber(alignment)) return 0.5
+  return Math.max(0, Math.min(1, alignment))
+}
+
+/**
+ * The properties a transition's renderer is given:
+ * - a declared numeric parameter is a finite number inside its declared range,
+ *   or its default;
+ * - a declared colour is three finite numbers, or its default;
+ * - a property the transition does not declare is kept only when it is a finite
+ *   number: the renderers read a few numeric properties that have no control,
+ *   and anything else would reach a shader uniform as NaN.
+ * Valid properties come back as the same object.
+ */
+export function sanitizeTransitionProperties(
+  definition: TransitionDefinition,
+  properties: TransitionProperties | undefined,
+): TransitionProperties | undefined {
+  if (!properties) return properties
+  const declared = new Map(
+    (definition.parameters ?? []).map((parameter) => [parameter.key, parameter]),
+  )
+  let out: TransitionProperties | null = null
+  const change = () => (out ??= { ...properties })
+  for (const [key, value] of Object.entries(properties)) {
+    const parameter = declared.get(key)
+    if (!parameter) {
+      if (!isFiniteNumber(value)) delete change()[key]
+      continue
+    }
+    if (parameter.type === 'number') {
+      if (!isFiniteNumber(value)) {
+        change()[key] = parameter.defaultValue
+        continue
+      }
+      const low = typeof parameter.min === 'number' ? parameter.min : -Infinity
+      const high = typeof parameter.max === 'number' ? parameter.max : Infinity
+      const clamped = Math.min(high, Math.max(low, value))
+      if (clamped !== value) change()[key] = clamped
+    } else if (
+      !Array.isArray(value) ||
+      value.length < 3 ||
+      !value.slice(0, 3).every(isFiniteNumber)
+    ) {
+      change()[key] = parameter.defaultValue
+    }
+  }
+  return out ?? properties
+}
