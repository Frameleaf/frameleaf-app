+// Spatial filters accumulate premultiplied light, then return straight alpha.
+// SDR retains its pinned hardware sampling and encoded straight-RGBA averaging.
+fn fl_blur_sample(tex: texture_2d<f32>, smp: sampler, uv: vec2f) -> vec4f {
+  if (!FL_EXTENDED_RANGE) { return textureSample(tex, smp, uv); }
+  let size = vec2i(textureDimensions(tex));
+  let point = uv * vec2f(size) - vec2f(0.5);
+  let origin = vec2i(floor(point));
+  let fraction = fract(point);
+  var color = vec4f(0.0);
+  for (var y = 0; y < 2; y++) {
+    for (var x = 0; x < 2; x++) {
+      let value = textureLoad(tex, clamp(origin + vec2i(x, y), vec2i(0), size - vec2i(1)), 0);
+      let weight = select(1.0 - fraction.x, fraction.x, x == 1) * select(1.0 - fraction.y, fraction.y, y == 1);
+      color += vec4f(value.rgb * value.a, value.a) * weight;
+    }
+  }
+  return color;
+}
+fn fl_blur_output(color: vec4f) -> vec4f {
+  if (!FL_EXTENDED_RANGE) { return color; }
+  if (color.a <= 0.0) { return vec4f(0.0); }
+  return vec4f(fl_range3(color.rgb / color.a), clamp(color.a, 0.0, 1.0));
+}
 fn fl_domain_offset3(c: vec3f) -> vec3f {
   if (FL_EXTENDED_RANGE) { return c - clamp(c, vec3f(0.0), vec3f(1.0)); }
   return vec3f(0.0);
