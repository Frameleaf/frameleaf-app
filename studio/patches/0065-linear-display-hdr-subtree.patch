+// @vitest-environment node
+import { expect, it } from 'vite-plus/test'
+import {
+  signalToWorking,
+  workingToSignal,
+  resolveColorManagement,
+  workingToSdrDisplay,
+} from './managed-color'
+
+it('keeps decoded HDR light linear before mixing coverage', () => {
+  // Published ST 2084 code for 203 cd/m2; a half-coverage white pixel is 101.5 nits.
+  const white = signalToWorking([0.5806888810416109, 0.5806888810416109, 0.5806888810416109], 'pq')
+  const half = workingToSignal(white.map((v) => v * 0.5) as [number, number, number], 'pq')
+  half.forEach((v) => expect(v).toBeCloseTo(0.5095742647025964, 4))
+  // HLG .5 is 50.6970284911 display nits after the nominal 1000-nit OOTF.
+  signalToWorking([0.5, 0.5, 0.5], 'hlg').forEach((v) =>
+    expect(v).toBeCloseTo(0.24973905660640633, 5),
+  )
+})
+
+it('sRGB-encodes linear HDR only at explicit SDR output', () => {
+  const hdr = { ...resolveColorManagement(undefined, 'hdr'), sdrMonitoring: 'none' as const }
+  expect(workingToSdrDisplay([0.5, 0.25, -0.1], hdr)).toEqual([
+    0.7353569830524495, 0.5370987304831942, 0,
+  ])
+  expect(workingToSdrDisplay([0.5, 0.25, -0.1], resolveColorManagement(undefined))).toEqual([
+    0.5, 0.25, 0,
+  ])
+})
