@@ -0,0 +1,320 @@
+/**
+ * Frameleaf (FL-94): changing the frame rate of a project or sequence that
+ * already has content never retimes it silently. The person picks a policy:
+ *
+ * - `keep-time`: every clip, transition, keyframe, marker and range stays at
+ *   the same moment in seconds. Timeline-frame fields are multiplied by the
+ *   exact rate ratio and rounded to the nearest frame (halves up); a clip's
+ *   end is rounded as well as its start, so clips that touched still touch.
+ *   Source frames are left alone; a media clip that read its source at the
+ *   timeline rate is pinned to the old rate so it still shows the same
+ *   pictures.
+ * - `keep-frames`: frame numbers are kept, so everything plays faster or
+ *   slower at the new rate. This is what the editor always did, now chosen.
+ *
+ * Fields in seconds (fades, caption cues) and Hz (motion modifiers) need no
+ * change. Sub-compositions have their own rate and are not touched when the
+ * main timeline changes.
+ */
+import type { ItemKeyframes } from '@/types/keyframe'
+import type { ProjectMarker, TimelineItem } from '@/types/timeline'
+import type { Transition } from '@/types/transition'
+import { sourceToTimelineFrames } from './source-calculations'
+
+export type RetimePolicy = 'keep-time' | 'keep-frames'
+
+export const RETIME_POLICIES: readonly RetimePolicy[] = ['keep-time', 'keep-frames']
+
+export interface FrameRatio {
+  num: bigint
+  den: bigint
+}
+
+/**
+ * The exact cadence an editor rate stands for: an integer, or one of the
+ * broadcast x/1001 rates. Anything else is refused rather than approximated.
+ */
+// ponytail: mirrors cadenceFromDecimal in web/src/lib/frameleaf/studio/studio-timing.ts, which the
+// engine cannot import; merge them if the engine ever gains the host alias.
+export function exactCadence(fps: number): FrameRatio {
+  if (Number.isSafeInteger(fps) && fps > 0) return { num: BigInt(fps), den: 1n }
+  for (const numerator of [24_000, 30_000, 48_000, 60_000, 120_000]) {
+    const exact = numerator / 1001
+    if (Math.abs(fps - exact) < 1e-9 || Math.round(exact * 1000) / 1000 === fps) {
+      return { num: BigInt(numerator), den: 1001n }
+    }
+  }
+  throw new Error(`The frame rate ${fps} has no exact reading`)
+}
+
+/** Whether two editor rates are the same exact cadence (29.97 and 30000/1001 are). */
+export function sameRate(left: number, right: number): boolean {
+  try {
+    const a = exactCadence(left)
+    const b = exactCadence(right)
+    return a.num * b.den === b.num * a.den
+  } catch {
+    return left === right
+  }
+}
+
+/** Frames at `fromFps` to frames at `toFps`. */
+export function frameRatio(fromFps: number, toFps: number): FrameRatio {
+  const from = exactCadence(fromFps)
+  const to = exactCadence(toFps)
+  return { num: to.num * from.den, den: to.den * from.num }
+}
+
+/** `frame · ratio` to the nearest integer, halves away from zero. */
+export function scaleFrame(frame: number, ratio: FrameRatio): number {
+  const whole = Math.round(frame)
+  const sign = whole < 0 ? -1n : 1n
+  const scaled = (2n * BigInt(Math.abs(whole)) * ratio.num + ratio.den) / (2n * ratio.den)
+  return Number(sign * scaled)
+}
+
+const scaleOptional = (frame: number | undefined, ratio: FrameRatio): number | undefined =>
+  frame === undefined ? undefined : scaleFrame(frame, ratio)
+
+const scaleNullable = (frame: number | null | undefined, ratio: FrameRatio) =>
+  frame === null || frame === undefined ? frame : scaleFrame(frame, ratio)
+
+/**
+ * Keep one keyframe per frame after rounding. The first one in time wins, except at the end of the
+ * lane: there the last keyframe wins, so the value a clip settles on is kept.
+ */
+function scaleKeyframeList<T extends { frame: number }>(keyframes: T[], ratio: FrameRatio): T[] {
+  const out: T[] = []
+  const sorted = [...keyframes].sort((a, b) => a.frame - b.frame)
+  for (const [index, keyframe] of sorted.entries()) {
+    const frame = scaleFrame(keyframe.frame, ratio)
+    const previous = out.at(-1)
+    if (previous?.frame === frame) {
+      if (index === sorted.length - 1) out[out.length - 1] = { ...keyframe, frame }
+      continue
+    }
+    out.push({ ...keyframe, frame })
+  }
+  return out
+}
+
+const SOURCE_FIELDS = ['trimStart', 'trimEnd', 'sourceStart', 'sourceEnd', 'sourceDuration', 'offset'] as const
+
+/** A source-frame field; `offset` exists only on video and audio items. */
+const sourceField = (item: TimelineItem, field: (typeof SOURCE_FIELDS)[number]): number | undefined =>
+  (item as unknown as Record<string, number | undefined>)[field]
+
+function retimeItem(item: TimelineItem, ratio: FrameRatio, fromFps: number, toFps: number): TimelineItem {
+  const from = scaleFrame(item.from, ratio)
+  const end = scaleFrame(item.from + item.durationInFrames, ratio)
+  const next: TimelineItem = { ...item, from, durationInFrames: Math.max(1, end - from) }
+
+  if (item.reverseConformLocalStart !== undefined) {
+    next.reverseConformLocalStart = scaleFrame(item.reverseConformLocalStart, ratio)
+  }
+  const readsSource = SOURCE_FIELDS.some((field) => sourceField(item, field) !== undefined)
+  // A compound clip reads its composition at the composition's own rate, never the timeline's.
+  if (readsSource && item.sourceFps === undefined && item.type !== 'composition' && !item.compositionId) {
+    next.sourceFps = fromFps
+  }
+  // Rounding the end up must not read past the clip's source window.
+  if (item.sourceEnd !== undefined && item.type !== 'composition' && !item.compositionId) {
+    const sourceStart = item.sourceStart ?? item.trimStart ?? 0
+    const most = sourceToTimelineFrames(
+      item.sourceEnd - sourceStart,
+      item.speed ?? 1,
+      next.sourceFps ?? fromFps,
+      toFps,
+    )
+    if (next.durationInFrames > most) next.durationInFrames = Math.max(1, most)
+  }
+  if (item.motionModifiers) {
+    next.motionModifiers = item.motionModifiers.map((modifier) => ({
+      ...modifier,
+      phaseFrames: scaleFrame(modifier.phaseFrames, ratio),
+    }))
+  }
+  if (item.motionLayers) {
+    next.motionLayers = item.motionLayers.map((layer) => ({
+      ...layer,
+      tracks: layer.tracks.map((track) => ({
+        ...track,
+        keyframes: scaleKeyframeList(track.keyframes, ratio),
+      })),
+    }))
+  }
+  if (item.effects) {
+    next.effects = item.effects.map((effect) =>
+      effect.audioPulse
+        ? {
+            ...effect,
+            audioPulse: {
+              ...effect.audioPulse,
+              durationFrames: Math.max(1, scaleFrame(effect.audioPulse.durationFrames, ratio)),
+              beats: effect.audioPulse.beats.map((beat) => ({
+                ...beat,
+                frame: scaleFrame(beat.frame, ratio),
+              })),
+            },
+          }
+        : effect,
+    )
+  }
+  if (item.type === 'text' && item.textMotion) {
+    const motion = { ...item.textMotion }
+    for (const slot of ['in', 'out', 'loop'] as const) {
+      const effect = motion[slot]
+      if (!effect) continue
+      motion[slot] = {
+        ...effect,
+        durationFrames: Math.max(1, scaleFrame(effect.durationFrames, ratio)),
+        staggerFrames: scaleFrame(effect.staggerFrames, ratio),
+        ...(effect.offsetFrames !== undefined && {
+          offsetFrames: scaleFrame(effect.offsetFrames, ratio),
+        }),
+      } as never
+    }
+    ;(next as typeof item).textMotion = motion
+  }
+  return next
+}
+
+function retimeKeyframes(entry: ItemKeyframes, ratio: FrameRatio): ItemKeyframes {
+  return {
+    ...entry,
+    properties: entry.properties.map((property) => ({
+      ...property,
+      keyframes: scaleKeyframeList(property.keyframes, ratio),
+    })),
+    ...(entry.vectorProperties && {
+      vectorProperties: entry.vectorProperties.map((property) => ({
+        ...property,
+        keyframes: scaleKeyframeList(property.keyframes, ratio),
+      })),
+    }),
+    ...(entry.propertyLinks && {
+      propertyLinks: entry.propertyLinks.map((link) => ({
+        ...link,
+        timeOffsetFrames: scaleFrame(link.timeOffsetFrames, ratio),
+      })),
+    }),
+    ...(entry.expressions && {
+      expressions: entry.expressions.map((expression) =>
+        expression.type === 'link'
+          ? { ...expression, timeOffsetFrames: scaleFrame(expression.timeOffsetFrames, ratio) }
+          : expression,
+      ),
+    }),
+  }
+}
+
+/** The timed content of one timeline: the main one, a sequence or a composition. */
+export interface RetimableContent {
+  items: TimelineItem[]
+  transitions?: Transition[]
+  keyframes?: ItemKeyframes[]
+  markers?: ProjectMarker[]
+  inPoint?: number | null
+  outPoint?: number | null
+  currentFrame?: number
+  durationInFrames?: number
+}
+
+/**
+ * Rounding can make two clips that did not overlap land on the same frames: at 60 to 25 fps a
+ * one-frame clip at 14 and the next clip at 15 both start at frame 6. A clip that started at or after
+ * the previous clip's end on its track still does, pushed later by the overflow; clips after it that
+ * it now reaches are pushed in turn. Linked clips on other tracks round alike, so they move alike.
+ */
+function withoutOverlaps(before: TimelineItem[], after: TimelineItem[]): TimelineItem[] {
+  const order = before.map((_, index) => index)
+  order.sort((a, b) => before[a]!.from - before[b]!.from || a - b)
+  const lastOnTrack = new Map<string, { beforeEnd: number; afterEnd: number }>()
+  const out = [...after]
+  for (const index of order) {
+    const original = before[index]!
+    let item = out[index]!
+    const previous = lastOnTrack.get(original.trackId)
+    if (previous && original.from >= previous.beforeEnd && item.from < previous.afterEnd) {
+      item = { ...item, from: previous.afterEnd }
+      out[index] = item
+    }
+    const beforeEnd = original.from + original.durationInFrames
+    const afterEnd = item.from + item.durationInFrames
+    if (!previous || beforeEnd >= previous.beforeEnd) lastOnTrack.set(original.trackId, { beforeEnd, afterEnd })
+  }
+  return out
+}
+
+/** `content` with every timeline-frame field moved from `fromFps` to `toFps`, keeping time. */
+export function retimeContent<T extends RetimableContent>(content: T, fromFps: number, toFps: number): T {
+  const ratio = frameRatio(fromFps, toFps)
+  const next: T = {
+    ...content,
+    items: withoutOverlaps(
+      content.items,
+      content.items.map((item) => retimeItem(item, ratio, fromFps, toFps)),
+    ),
+  }
+  if (content.transitions) {
+    next.transitions = content.transitions.map((transition) => ({
+      ...transition,
+      durationInFrames: Math.max(1, scaleFrame(transition.durationInFrames, ratio)),
+    }))
+  }
+  if (content.keyframes) next.keyframes = content.keyframes.map((entry) => retimeKeyframes(entry, ratio))
+  if (content.markers) {
+    next.markers = content.markers.map((marker) => ({ ...marker, frame: scaleFrame(marker.frame, ratio) }))
+  }
+  if ('inPoint' in content) next.inPoint = scaleNullable(content.inPoint, ratio)
+  if ('outPoint' in content) next.outPoint = scaleNullable(content.outPoint, ratio)
+  if (content.currentFrame !== undefined) next.currentFrame = scaleOptional(content.currentFrame, ratio)
+  if (content.durationInFrames !== undefined) {
+    next.durationInFrames = Math.max(1, scaleFrame(content.durationInFrames, ratio))
+  }
+  return next
+}
+
+/**
+ * Items anywhere that read composition `compositionId` see its frames through
+ * their source fields. When the composition keeps its time at a new rate, those
+ * source frames move with it.
+ */
+export function retimeCompositionReaders(
+  items: TimelineItem[],
+  compositionId: string,
+  fromFps: number,
+  toFps: number,
+): TimelineItem[] {
+  const ratio = frameRatio(fromFps, toFps)
+  return items.map((item) => {
+    if (item.compositionId !== compositionId) return item
+    const next = { ...item } as TimelineItem
+    for (const field of SOURCE_FIELDS) {
+      const value = sourceField(item, field)
+      if (value !== undefined) (next as unknown as Record<string, number>)[field] = scaleFrame(value, ratio)
+    }
+    if (item.sourceFps !== undefined) next.sourceFps = toFps
+    return next
+  })
+}
+
+/** Whether a timeline has anything a rate change would move. */
+export function hasTimedContent(
+  content:
+    | {
+        items?: readonly unknown[]
+        markers?: readonly unknown[]
+        inPoint?: number | null
+        outPoint?: number | null
+      }
+    | undefined,
+): boolean {
+  return Boolean(
+    content &&
+      ((content.items?.length ?? 0) > 0 ||
+        (content.markers?.length ?? 0) > 0 ||
+        (content.inPoint ?? null) !== null ||
+        (content.outPoint ?? null) !== null),
+  )
+}
