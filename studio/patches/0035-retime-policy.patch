+// @vitest-environment node
+
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vite-plus/test'
+import type { Project, ProjectTimeline } from '@/types/project'
+
+const storage = vi.hoisted(() => ({ updateProject: vi.fn() }))
+
+vi.mock('@/infrastructure/storage', async (importOriginal) => ({
+  ...(await importOriginal<typeof import('@/infrastructure/storage')>()),
+  updateProject: storage.updateProject,
+}))
+
+import {
+  makeTimelineTrack,
+  makeTimelineVideoItem,
+  resetTimelineCompositionTestState,
+  setDefaultRootTimelineTracks,
+} from '@/features/editor/deps/timeline-test-helpers-contract'
+import {
+  buildTimelineFromStores,
+  getActiveTabId,
+  useCompositionNavigationStore,
+  useCompositionsStore,
+  useItemsStore,
+  useTimelineCommandStore,
+  useTimelineSettingsStore,
+} from '@/features/editor/deps/timeline-store'
+import { useProjectStore } from '@/features/editor/deps/projects'
+import { commitProjectMetadataChange, RetimePolicyRequiredError } from './project-metadata-history'
+
+/**
+ * FL-94 against the real timeline stores and history: a rate change that keeps clip timing is one
+ * undoable step, and every stored state pairs a rate with the timeline written for it.
+ */
+
+const project = (): Project =>
+  ({
+    id: 'project-1',
+    name: 'Retime',
+    description: '',
+    createdAt: 0,
+    updatedAt: 0,
+    duration: 0,
+    metadata: { width: 1920, height: 1080, fps: 30 },
+  }) as Project
+
+type Write = { fps?: number; timeline?: ProjectTimeline }
+
+/** The project store's update as the editor uses it: one write of metadata and, when given, timeline. */
+const writes: Write[] = []
+const updateProject = async (_id: string, data: Write) => {
+  writes.push(data)
+  const current = useProjectStore.getState().currentProject!
+  const next = {
+    ...current,
+    metadata: { ...current.metadata, ...(data.fps !== undefined && { fps: data.fps }) },
+    ...(data.timeline && { timeline: data.timeline }),
+  } as Project
+  useProjectStore.setState({ currentProject: next })
+  return next
+}
+
+const mainSpans = () => useItemsStore.getState().items.map((item) => [item.from, item.durationInFrames])
+const storedSpans = (timeline: ProjectTimeline | undefined) =>
+  (timeline?.items ?? []).map((item) => [item.from, item.durationInFrames])
+
+const change = (timing?: 'keep-time' | 'keep-frames') =>
+  commitProjectMetadataChange({
+    project: useProjectStore.getState().currentProject!,
+    updates: { fps: 60 },
+    command: { type: 'UPDATE_PROJECT_METADATA' },
+    updateProject,
+    markDirty: () => undefined,
+    ...(timing && { timing }),
+  })
+
+describe('commitProjectMetadataChange (FL-94)', () => {
+  beforeEach(() => {
+    writes.length = 0
+    storage.updateProject.mockReset().mockResolvedValue(undefined)
+    resetTimelineCompositionTestState()
+    setDefaultRootTimelineTracks()
+    useItemsStore.getState().setItems([makeTimelineVideoItem({ id: 'main-clip', from: 30, durationInFrames: 45 })])
+    useTimelineSettingsStore.getState().setFps(30)
+    useTimelineCommandStore.getState().clearHistory()
+    useProjectStore.setState({ currentProject: project(), projects: [] })
+  })
+
+  afterEach(() => resetTimelineCompositionTestState())
+
+  it('refuses a rate change on content without a policy, changing nothing', async () => {
+    await expect(change()).rejects.toBeInstanceOf(RetimePolicyRequiredError)
+    expect(writes).toEqual([])
+    expect(mainSpans()).toEqual([[30, 45]])
+  })
+
+  it('keep-time stores the new rate with the retimed timeline, and undoes and redoes as one step', async () => {
+    await change('keep-time')
+
+    expect(mainSpans()).toEqual([[60, 90]])
+    expect(useTimelineSettingsStore.getState().fps).toBe(60)
+    expect(writes).toHaveLength(1)
+    expect(writes[0]!.fps).toBe(60)
+    expect(storedSpans(writes[0]!.timeline)).toEqual([[60, 90]])
+
+    useTimelineCommandStore.getState().undo()
+    expect(mainSpans()).toEqual([[30, 45]])
+    expect(useTimelineSettingsStore.getState().fps).toBe(30)
+    expect(useProjectStore.getState().currentProject!.metadata.fps).toBe(30)
+    // The old rate goes back to storage with the timeline written for it, in one write.
+    const undone = storage.updateProject.mock.calls.at(-1)![1] as { metadata: { fps: number }; timeline: ProjectTimeline }
+    expect(undone.metadata.fps).toBe(30)
+    expect(storedSpans(undone.timeline)).toEqual([[30, 45]])
+
+    useTimelineCommandStore.getState().redo()
+    expect(mainSpans()).toEqual([[60, 90]])
+    const redone = storage.updateProject.mock.calls.at(-1)![1] as { metadata: { fps: number }; timeline: ProjectTimeline }
+    expect(redone.metadata.fps).toBe(60)
+    expect(storedSpans(redone.timeline)).toEqual([[60, 90]])
+  })
+
+  it('keep-time from a sequence tab switches to Main and retimes Main, not the sequence', async () => {
+    useCompositionsStore.getState().addComposition({
+      id: 'seq-a',
+      name: 'seq-a',
+      tracks: [makeTimelineTrack({ id: 'seq-a-v1', name: 'V1', kind: 'video', order: 0 })],
+      items: [makeTimelineVideoItem({ id: 'a-clip', trackId: 'seq-a-v1', from: 30, durationInFrames: 30 })],
+      transitions: [],
+      keyframes: [],
+      fps: 30,
+      width: 1920,
+      height: 1080,
+      durationInFrames: 60,
+    })
+    useCompositionNavigationStore.getState().switchToSequence('seq-a')
+    expect(useItemsStore.getState().items.map((item) => item.id)).toEqual(['a-clip'])
+
+    await change('keep-time')
+
+    expect(getActiveTabId(useCompositionNavigationStore.getState().breadcrumbs)).toBeNull()
+    expect(useItemsStore.getState().items.map((item) => [item.id, item.from, item.durationInFrames])).toEqual([
+      ['main-clip', 60, 90],
+    ])
+    const sequence = useCompositionsStore.getState().compositions.find((entry) => entry.id === 'seq-a')!
+    expect([sequence.fps, sequence.items[0]!.from, sequence.items[0]!.durationInFrames]).toEqual([30, 30, 30])
+  })
+
+  it('keep-frames changes only the rate', async () => {
+    await change('keep-frames')
+    expect(mainSpans()).toEqual([[30, 45]])
+    expect(writes).toEqual([{ fps: 60 }])
+    expect(storedSpans(buildTimelineFromStores())).toEqual([[30, 45]])
+  })
+})
