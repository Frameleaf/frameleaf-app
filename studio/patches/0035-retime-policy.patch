+    await disk.readGate
+    return structuredClone(disk.project)
+  }),
+  updateProject: vi.fn(async (_id: string, updates: Record<string, unknown>) => {
+    disk.writes.push(updates)
+    disk.project = { ...disk.project, ...structuredClone(updates) }
+    return structuredClone(disk.project)
