+import { describe, expect, it } from 'vite-plus/test'
+import type { ItemKeyframes } from '@/types/keyframe'
+import type { ProjectMarker, TimelineItem } from '@/types/timeline'
+import type { Transition } from '@/types/transition'
+import {
+  exactCadence,
+  frameRatio,
+  hasTimedContent,
+  retimeCompositionReaders,
+  retimeContent,
+  scaleFrame,
+} from './project-retime'
+
+const item = (overrides: Record<string, unknown>): TimelineItem =>
+  ({ id: 'a', type: 'video', trackId: 'v1', label: 'a', from: 0, durationInFrames: 10, ...overrides }) as never
+
+describe('project retime (FL-94)', () => {
+  it('reads editor rates exactly and refuses rates with no exact reading', () => {
+    expect(exactCadence(30)).toEqual({ num: 30n, den: 1n })
+    expect(exactCadence(29.97)).toEqual({ num: 30_000n, den: 1001n })
+    expect(exactCadence(30_000 / 1001)).toEqual({ num: 30_000n, den: 1001n })
+    expect(() => exactCadence(29.5)).toThrow(/no exact reading/)
+    expect(frameRatio(30, 29.97)).toEqual({ num: 30_000n, den: 30_030n })
+  })
+
+  it('rounds to the nearest frame, halves away from zero', () => {
+    const half = frameRatio(60, 30)
+    expect([1, 3, 5, -1, -3].map((frame) => scaleFrame(frame, half))).toEqual([1, 2, 3, -1, -2])
+    // An hour at 30 fps is 107,892 frames at 29.97, with no float drift.
+    expect(scaleFrame(108_000, frameRatio(30, 29.97))).toBe(107_892)
+  })
+
+  it('keeps butted clips butted and never shortens a clip to nothing', () => {
+    const { items } = retimeContent(
+      {
+        items: [
+          item({ id: 'a', from: 0, durationInFrames: 7 }),
+          item({ id: 'b', from: 7, durationInFrames: 7 }),
+          item({ id: 'c', from: 14, durationInFrames: 1, type: 'text' }),
+        ],
+      },
+      60,
+      25,
+    )
+    for (let index = 1; index < items.length; index += 1) {
+      expect(items[index]!.from).toBe(items[index - 1]!.from + items[index - 1]!.durationInFrames)
+    }
+    expect(items.every((entry) => entry.durationInFrames >= 1)).toBe(true)
+  })
+
+  it('pins media that read their source at the timeline rate, and nothing else', () => {
+    const { items } = retimeContent(
+      {
+        items: [
+          item({ id: 'pinned', trimStart: 12 }),
+          item({ id: 'own', trimStart: 12, sourceFps: 23.976 }),
+          item({ id: 'compound', type: 'composition', compositionId: 'c1', sourceStart: 4 }),
+          item({ id: 'title', type: 'text' }),
+        ],
+      },
+      30,
+      60,
+    )
+    expect(items.map((entry) => [entry.sourceFps, entry.trimStart ?? entry.sourceStart])).toEqual([
+      [30, 12],
+      [23.976, 12],
+      [undefined, 4],
+      [undefined, undefined],
+    ])
+  })
+
+  it('moves every timeline-frame field an item carries and leaves seconds alone', () => {
+    const [next] = retimeContent(
+      {
+        items: [
+          item({
+            type: 'text',
+            fadeIn: 0.5,
+            reverseConformLocalStart: 10,
+            motionModifiers: [{ id: 'm', phaseFrames: 6, frequency: 2 }],
+            motionLayers: [{ id: 'l', tracks: [{ keyframes: [{ id: 'k', frame: 8 }] }] }],
+            effects: [{ id: 'e', audioPulse: { durationFrames: 4, beats: [{ frame: 2 }] } }],
+            textMotion: {
+              in: { durationFrames: 12, staggerFrames: 2, offsetFrames: 1 },
+              loop: { durationFrames: 30, staggerFrames: 0 },
+            },
+          }),
+        ],
+      },
+      24,
+      48,
+    ).items as never[] as Array<Record<string, any>>
+    expect(next!.fadeIn).toBe(0.5)
+    expect(next!.reverseConformLocalStart).toBe(20)
+    expect(next!.motionModifiers[0]).toMatchObject({ phaseFrames: 12, frequency: 2 })
+    expect(next!.motionLayers[0].tracks[0].keyframes[0].frame).toBe(16)
+    expect(next!.effects[0].audioPulse).toMatchObject({ durationFrames: 8, beats: [{ frame: 4 }] })
+    expect(next!.textMotion.in).toMatchObject({ durationFrames: 24, staggerFrames: 4, offsetFrames: 2 })
+    expect(next!.textMotion.loop).toMatchObject({ durationFrames: 60, staggerFrames: 0 })
+  })
+
+  it('moves keyframes, links, transitions, markers and ranges; one keyframe per frame survives', () => {
+    const keyframes: ItemKeyframes[] = [
+      {
+        itemId: 'a',
+        properties: [
+          {
+            property: 'opacity',
+            keyframes: [
+              { id: 'k0', frame: 1, value: 0, easing: 'linear' },
+              { id: 'k1', frame: 2, value: 0.5, easing: 'linear' },
+              { id: 'k2', frame: 10, value: 1, easing: 'linear' },
+            ],
+          },
+        ],
+        vectorProperties: [
+          { property: 'position', keyframes: [{ id: 'v', frame: 6, value: { x: 0, y: 0 }, easing: 'linear' }] },
+        ] as never,
+        propertyLinks: [{ timeOffsetFrames: 6 }] as never,
+        expressions: [{ type: 'link', timeOffsetFrames: 3 }, { type: 'expression', source: 'frame' }] as never,
+      },
+    ]
+    const next = retimeContent(
+      {
+        items: [item({})],
+        keyframes,
+        transitions: [{ id: 't', durationInFrames: 1 }] as unknown as Transition[],
+        markers: [{ id: 'm', frame: 9, color: '#fff' }] as unknown as ProjectMarker[],
+        inPoint: 3,
+        outPoint: null,
+        currentFrame: 11,
+        durationInFrames: 1,
+      },
+      60,
+      30,
+    )
+    const [entry] = next.keyframes!
+    expect(entry!.properties[0]!.keyframes.map((key) => [key.id, key.frame])).toEqual([
+      ['k0', 1],
+      ['k2', 5],
+    ])
+    expect(entry!.vectorProperties![0]!.keyframes[0]!.frame).toBe(3)
+    expect(entry!.propertyLinks![0]!.timeOffsetFrames).toBe(3)
+    expect(entry!.expressions).toEqual([
+      { type: 'link', timeOffsetFrames: 2 },
+      { type: 'expression', source: 'frame' },
+    ])
+    expect(next.transitions![0]!.durationInFrames).toBe(1)
+    expect(next.markers![0]!.frame).toBe(5)
+    expect([next.inPoint, next.outPoint, next.currentFrame, next.durationInFrames]).toEqual([2, null, 6, 1])
+  })
+
+  it('moves the source frames of clips that read a retimed composition', () => {
+    const items = retimeCompositionReaders(
+      [
+        item({ id: 'reader', compositionId: 'c1', sourceStart: 30, sourceEnd: 90, sourceFps: 30 }),
+        item({ id: 'bare', type: 'composition', compositionId: 'c1', trimStart: 15 }),
+        item({ id: 'other', compositionId: 'c2', sourceStart: 30 }),
+      ],
+      'c1',
+      30,
+      60,
+    )
+    expect(items.map((entry) => [entry.sourceStart ?? entry.trimStart, entry.sourceEnd, entry.sourceFps])).toEqual([
+      [60, 180, 60],
+      [30, undefined, undefined],
+      [30, undefined, undefined],
+    ])
+  })
+
+  it('knows when a timeline has nothing a rate change would move', () => {
+    expect(hasTimedContent({ items: [], markers: [], inPoint: null, outPoint: null })).toBe(false)
+    expect(hasTimedContent({ items: [], markers: [], inPoint: 0 })).toBe(true)
+    expect(hasTimedContent({ items: [item({})] })).toBe(true)
+    expect(hasTimedContent(undefined)).toBe(false)
+  })
+})
