+      for (const indexes of byTrack.values()) {
+        indexes.sort((a, b) => items[a]!.from - items[b]!.from)
+        for (let k = 1; k < indexes.length; k += 1) {
+          const [p, n] = [indexes[k - 1]!, indexes[k]!]
+          const apartBefore = items[n]!.from >= items[p]!.from + items[p]!.durationInFrames
