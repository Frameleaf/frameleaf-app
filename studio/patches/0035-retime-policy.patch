--- /dev/null
+++ b/src/shared/projects/project-write-queue.ts
@@ -0,0 +1,53 @@
+/**
+ * Frameleaf (FL-94): project writes, one at a time, and the timeline write that is current.
+ *
+ * Storage merges each write into the project it re-reads first, so two writes in flight can each
+ * miss the other. And a timeline save snapshots the stores before an await (thumbnail work), so
+ * when it lands after a newer timeline write — the new rate stored with its retimed timeline, or
+ * an undo of it — it would put the older timeline back and mark the editor clean.
+ *
+ * Every project write runs through `queueProjectWrite`, in the order it was queued. A write that
+ * stores a timeline takes a generation with `beginTimelineWrite` when it captures that timeline; an
+ * older one that is no longer current skips its write.
+ */
+
+let generation = 0
+let tail: Promise<unknown> = Promise.resolve()
+
+/** Starts a timeline write: from now on, any timeline captured earlier is out of date. */
+export function beginTimelineWrite(): number {
+  generation += 1
+  return generation
+}
+
+/** Whether no timeline was captured for writing after this one. */
+export function isCurrentTimelineWrite(writeGeneration: number): boolean {
+  return writeGeneration === generation
+}
+
+/**
+ * Metadata restored by undo or redo whose write failed, per project. The next timeline save stores
+ * it with the timeline, so the stored rate and frames never disagree; a later metadata write that
+ * succeeds replaces it.
+ */
+const unsavedMetadata = new Map<string, object>()
+
+export function holdUnsavedMetadata(projectId: string, metadata: object): void {
+  unsavedMetadata.set(projectId, metadata)
+}
+
+export function unsavedMetadataFor(projectId: string): object | undefined {
+  return unsavedMetadata.get(projectId)
+}
+
+/** Forgets held metadata once it is stored: only `metadata` itself, when given. */
+export function clearUnsavedMetadata(projectId: string, metadata?: object): void {
+  if (metadata === undefined || unsavedMetadata.get(projectId) === metadata) unsavedMetadata.delete(projectId)
+}
+
+/** Runs `write` after every project write queued before it. */
+export function queueProjectWrite<T>(write: () => Promise<T>): Promise<T> {
+  const run = tail.then(write, write)
+  tail = run.catch(() => undefined)
+  return run
+}
