+const project = (): Project =>
+  ({
+    id: 'project-1',
+    name: 'Retime',
+    description: '',
+    createdAt: 0,
+    updatedAt: 0,
+    duration: 0,
+    metadata: { width: 1920, height: 1080, fps: 30 },
+  }) as Project
