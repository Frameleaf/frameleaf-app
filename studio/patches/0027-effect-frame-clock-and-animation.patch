+import { afterEach, describe, expect, it, vi } from 'vite-plus/test'
+import { EFFECT_CLOCK_PARAM, GPU_EFFECT_REGISTRY, getGpuEffectDefaultParams } from './index'
+
+// FL-99: temporal/random effects need stable seeds and frame context.
+describe('temporal effect frame clock', () => {
+  afterEach(() => vi.restoreAllMocks())
+
+  const temporal = [...GPU_EFFECT_REGISTRY.values()].filter((effect) => effect.temporal)
+
+  it('declares every effect whose uniforms follow time', () => {
+    expect(temporal.map((effect) => effect.id).sort()).toEqual([
+      'gpu-block-glitch',
+      'gpu-color-glitch',
+      'gpu-grain',
+      'gpu-hue-shift',
+      'gpu-scanlines',
+      'gpu-trigger-wave',
+      'gpu-vhs',
+    ])
+    // No undeclared effect may read the wall clock: its uniforms stay put.
+    const clock = vi.spyOn(performance, 'now')
+    for (const effect of GPU_EFFECT_REGISTRY.values()) {
+      if (effect.temporal) continue
+      const params = getGpuEffectDefaultParams(effect.id)
+      clock.mockReturnValue(1000)
+      const first = Array.from(effect.packUniforms(params, 64, 36) ?? [])
+      clock.mockReturnValue(987_654)
+      expect(Array.from(effect.packUniforms(params, 64, 36) ?? []), effect.id).toEqual(first)
+    }
+  })
+
+  it('packs the stamped frame time instead of wall time', () => {
+    const clock = vi.spyOn(performance, 'now')
