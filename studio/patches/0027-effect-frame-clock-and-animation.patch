+/**
+ * Frame-context clock for temporal GPU effects (Frameleaf FL-99).
+ *
+ * Grain, scanlines, glitches, VHS, trigger waves and hue flow used to read
+ * `performance.now()`, so an export differed from its preview and from any
+ * re-render of the same frame. Render paths now stamp the item-relative time
+ * of the frame being rendered into the effect params under this reserved key,
+ * and packUniforms reads it through {@link effectClockSeconds}. Only callers
+ * without a timeline frame (e.g. panel thumbnails) fall back to wall time.
+ */
+export const EFFECT_CLOCK_PARAM = '__frameleafEffectTimeSeconds'
+
+export function effectClockSeconds(params: Record<string, number | boolean | string>): number {
+  const time = params[EFFECT_CLOCK_PARAM]
+  return typeof time === 'number' && Number.isFinite(time) ? time : performance.now() / 1000
+}
