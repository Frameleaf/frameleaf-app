+/**
+ * The locale numbers are written in (FL-1822). It is the one asked for, not the editor's resolved
+ * language: a host in Danish runs the editor's English text, yet "0,5" is still written the Danish
+ * way. Until a language is chosen, numbers follow the browser.
+ */
+let numberLocale: string | undefined
+
+function toNumberLocale(lang: string): string | undefined {
+  try {
+    const tag = lang.replace('_', '-')
+    return Intl.NumberFormat.supportedLocalesOf(tag).length > 0 ? tag : undefined
+  } catch {
+    return undefined
+  }
+}
+
+/** A number in the chosen language's format ("0,5" in French), whatever the browser's locale. */
+export function formatNumber(value: number): string {
+  return new Intl.NumberFormat(numberLocale).format(value)
+}
+
 export async function changeAppLanguage(lang: string): Promise<void> {
+  numberLocale = toNumberLocale(lang)
   const resolved = resolveSupportedLanguage(lang)
   await loadLanguageResources(resolved)
   await i18n.changeLanguage(resolved)
