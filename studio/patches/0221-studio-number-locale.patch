diff --git a/src/i18n/number-locale.test.ts b/src/i18n/number-locale.test.ts
new file mode 100644
index 0000000..7d1337e
--- /dev/null
+++ b/src/i18n/number-locale.test.ts
@@ -0,0 +1,30 @@
+// @vitest-environment node
+
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { changeAppLanguage, formatNumber, i18n } from './index'
+
+describe('formatNumber (FL-1822)', () => {
+  afterEach(async () => {
+    vi.unstubAllGlobals()
+    await changeAppLanguage('en')
+  })
+
+  it("writes numbers in the chosen language, not the browser's", async () => {
+    vi.stubGlobal('navigator', { language: 'en-US', languages: ['en-US'] })
+    await changeAppLanguage('fr')
+    expect(formatNumber(0.5)).toBe('0,5')
+  })
+
+  it('keeps the asked-for locale when the editor falls back to English text', async () => {
+    await changeAppLanguage('da')
+    expect(i18n.language).toBe('en')
+    expect(formatNumber(1.5)).toBe('1,5')
+    await changeAppLanguage('nb_NO')
+    expect(formatNumber(0.25)).toBe('0,25')
+  })
+
+  it('falls back to the browser for a tag it cannot use', async () => {
+    await changeAppLanguage('not a locale!')
+    expect(formatNumber(0.5)).toBe(new Intl.NumberFormat().format(0.5))
+  })
+})
