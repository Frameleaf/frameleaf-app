+/**
+ * The locale numbers are written in (FL-1822). A host sets it from its own "dates and numbers"
+ * choice, which may differ from the language the editor's text is in; unset, numbers follow the
+ * device, as they always have.
+ */
+let numberLocale: string | undefined
+
+function toNumberLocale(lang: string): string | undefined {
+  try {
+    const tag = lang.replace('_', '-')
+    return Intl.NumberFormat.supportedLocalesOf(tag).length > 0 ? tag : undefined
+  } catch {
+    return undefined
+  }
+}
+
+/** Write numbers in this locale; `undefined`, or a tag Intl can't use, means the device's. */
+export function setNumberLocale(lang: string | undefined): void {
+  numberLocale = lang ? toNumberLocale(lang) : undefined
+}
+
+/** A number in the chosen number format ("0,5" for French), whatever the browser's locale. */
+export function formatNumber(value: number): string {
+  return new Intl.NumberFormat(numberLocale).format(value)
+}
