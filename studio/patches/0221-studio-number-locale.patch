diff --git a/src/i18n/number-locale.test.ts b/src/i18n/number-locale.test.ts
new file mode 100644
index 0000000..54ee034
--- /dev/null
+++ b/src/i18n/number-locale.test.ts
@@ -0,0 +1,35 @@
+// @vitest-environment node
+
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { changeAppLanguage, formatNumber, i18n, setNumberLocale } from './index'
+
+describe('formatNumber (FL-1822)', () => {
+  afterEach(() => {
+    vi.unstubAllGlobals()
+    setNumberLocale(undefined)
+  })
+
+  it("writes numbers in the host's number format, not the browser's", () => {
+    vi.stubGlobal('navigator', { language: 'en-US', languages: ['en-US'] })
+    setNumberLocale('fr-FR')
+    expect(formatNumber(0.5)).toBe('0,5')
+  })
+
+  it("is independent of the editor's text language", async () => {
+    await changeAppLanguage('da')
+    expect(i18n.language).toBe('en')
+    setNumberLocale('da')
+    expect(formatNumber(1.5)).toBe('1,5')
+    setNumberLocale('en-US')
+    await changeAppLanguage('fr')
+    expect(formatNumber(0.5)).toBe('0.5')
+    await changeAppLanguage('en')
+  })
+
+  it("follows the device when unset or when the tag can't be used", () => {
+    const device = new Intl.NumberFormat().format(0.5)
+    expect(formatNumber(0.5)).toBe(device)
+    setNumberLocale('not a locale!')
+    expect(formatNumber(0.5)).toBe(device)
+  })
+})
