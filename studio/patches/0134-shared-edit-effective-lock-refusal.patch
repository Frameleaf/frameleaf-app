+/** Refuse a whole edit when any participant inherits a locked lane. */
+export function hasLockedEditParticipants(participants: readonly TimelineItem[]): boolean {
+  const lockedTrackIds = new Set(resolveEffectiveTrackStates(useItemsStore.getState().tracks)
+    .filter((track) => track.locked).map((track) => track.id))
+  return participants.some((item) => lockedTrackIds.has(item.trackId))
+}
