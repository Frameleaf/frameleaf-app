+import { describe, expect, it } from 'vite-plus/test'
+import { sanitizeEffectParams } from './effect-params'
+import type { GpuEffectDefinition } from './types'
+
+const definition = {
+  id: 'gpu-test',
+  params: {
+    amount: { type: 'number', label: 'Amount', default: 0.5, min: 0, max: 1 },
+    angle: { type: 'number', label: 'Angle', default: 0 },
+    mode: {
+      type: 'select',
+      label: 'Mode',
+      default: 'a',
+      options: [
+        { value: 'a', label: 'A' },
+        { value: 'b', label: 'B' },
+      ],
+    },
+    invert: { type: 'boolean', label: 'Invert', default: false },
+    tint: { type: 'color', label: 'Tint', default: '#ffffff' },
+  },
+} as unknown as GpuEffectDefinition
+
+describe('sanitizeEffectParams (FL-99 invalid parameters)', () => {
+  it('returns valid parameters as they are, the same object', () => {
+    const params = {
+      amount: 0.25,
+      angle: 720,
+      mode: 'b',
+      invert: true,
+      tint: '#ff0000',
+      __clock: 3,
+    }
+    expect(sanitizeEffectParams(definition, params)).toBe(params)
+  })
+
+  it('clamps finite numbers to the declared range and leaves unbounded ones', () => {
+    expect(sanitizeEffectParams(definition, { amount: 1001, angle: -5000 })).toEqual({
+      amount: 1,
+      angle: -5000,
+    })
+    expect(sanitizeEffectParams(definition, { amount: -0.2 })).toEqual({ amount: 0 })
+  })
+
+  it('falls back to the default for non-finite numbers, unknown options and non-booleans', () => {
+    expect(
+      sanitizeEffectParams(definition, {
+        amount: Number.NaN,
+        angle: Number.POSITIVE_INFINITY,
+        mode: 'z',
+        invert: 'yes',
+      }),
+    ).toEqual({ amount: 0.5, angle: 0, mode: 'a', invert: false })
+    expect(sanitizeEffectParams(definition, { amount: '0.7' as unknown as number })).toEqual({
+      amount: 0.5,
+    })
+  })
+
+  it('passes undeclared and structured parameters through', () => {
+    expect(
+      sanitizeEffectParams(definition, { amount: 2, tint: 'not a colour', __clock: 1.5 }),
+    ).toEqual({
+      amount: 1,
+      tint: 'not a colour',
+      __clock: 1.5,
+    })
+  })
+})
