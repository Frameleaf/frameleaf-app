+import type { GpuEffectDefinition } from './types'
+
+type EffectParams = Record<string, number | boolean | string>
+
+/**
+ * FL-99: the parameters an effect is drawn with. A value outside what the
+ * effect declares (keyframe easings that overshoot, stored or imported values
+ * out of range, a non-finite number, a select value that is no option, a
+ * non-boolean flag) reaches the shader as its declared meaning instead of an
+ * undefined one:
+ * - a finite number outside [min, max] is clamped to the range;
+ * - a non-finite or non-number value for a numeric parameter, an unknown select
+ *   option and a non-boolean flag fall back to the parameter's default.
+ * Parameters the effect does not declare (the effect clock, for one) and the
+ * structured kinds (colour, point, json, text) pass through unchanged.
+ */
+export function sanitizeEffectParams(
+  definition: GpuEffectDefinition,
+  params: EffectParams,
+): EffectParams {
+  let out: EffectParams | null = null
+  const set = (key: string, value: number | boolean | string) => {
+    if (Object.is(params[key], value)) return
+    out ??= { ...params }
+    out[key] = value
+  }
+  for (const [key, param] of Object.entries(definition.params)) {
+    if (!(key in params)) continue
+    const value = params[key]
+    if (param.type === 'number') {
+      if (typeof value !== 'number' || !Number.isFinite(value)) {
+        set(key, param.default)
+        continue
+      }
+      const low = typeof param.min === 'number' ? param.min : -Infinity
+      const high = typeof param.max === 'number' ? param.max : Infinity
+      set(key, Math.min(high, Math.max(low, value)))
+    } else if (param.type === 'select') {
+      if (!param.options?.some((option) => option.value === value)) set(key, param.default)
+    } else if (param.type === 'boolean') {
+      if (typeof value !== 'boolean') set(key, param.default)
+    }
+  }
+  return out ?? params
+}
