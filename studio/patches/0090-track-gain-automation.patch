@@ -0,0 +1,218 @@
+import { masterGainAtFrame, validateMasterGainEnvelope, type MasterGainPoint } from './master-audio'
+import {
+  cadenceFromFps,
+  masterFrameAtSample,
+  validateMasterEpoch,
+  type MasterAudioEpoch,
+} from './master-audio-epoch'
+import type { TimelineItem, TimelineTrack } from '@/types/timeline'
+
+/** Root modulo is evaluated first; each stage then maps that frame into its owner's timeline. */
+export interface TrackGainStage {
+  trackId: string
+  points: readonly MasterGainPoint[]
+  gainDb: number
+  muted: boolean
+  offset: number
+  scale: number
+}
+export function validateTrackStages(stages: readonly TrackGainStage[]): TrackGainStage[] {
+  if (!Array.isArray(stages) || stages.length > 64) throw new Error('Invalid track gain stages')
+  return stages.map((s) => {
+    if (
+      !s ||
+      typeof s.trackId !== 'string' ||
+      !s.trackId ||
+      !Number.isFinite(s.gainDb) ||
+      s.gainDb < -60 ||
+      s.gainDb > 12 ||
+      typeof s.muted !== 'boolean' ||
+      !Number.isFinite(s.offset) ||
+      !Number.isFinite(s.scale) ||
+      s.scale === 0
+    )
+      throw new Error('Invalid track gain stage')
+    return { ...s, points: validateMasterGainEnvelope(s.points) }
+  })
+}
+export function trackGainAtRootFrame(stages: readonly TrackGainStage[], rootFrame: number): number {
+  return stages.reduce(
+    (gain, s) =>
+      gain * (s.muted ? 0 : masterGainAtFrame(s.points, s.offset + rootFrame * s.scale, s.gainDb)),
+    1,
+  )
+}
+export function applyTrackGain(
+  planes: Float32Array[],
+  stages: readonly TrackGainStage[],
+  fps: number,
+  sampleRate: number,
+  originFrame = 0,
+  sampleStart = 0,
+): void {
+  const { num, den } = cadenceFromFps(fps)
+  for (let i = 0; i < (planes[0]?.length ?? 0); i++) {
+    const gain = trackGainAtRootFrame(
+      stages,
+      originFrame + ((sampleStart + i) * num) / (den * sampleRate),
+    )
+    for (const plane of planes) plane[i] = plane[i]! * gain
+  }
+}
+export interface TrackAudioEpoch {
+  epoch: MasterAudioEpoch
+  revision: number
+  stages: readonly TrackGainStage[]
+}
+export class TrackGainProcessor {
+  private current: TrackAudioEpoch | null = null
+  private revision = -1
+  constructor(
+    private readonly rootId: string,
+    private readonly contextId: string,
+  ) {}
+  replace(value: TrackAudioEpoch): boolean {
+    this.current = null
+    if (!value || !Number.isSafeInteger(value.revision) || value.revision <= this.revision)
+      return false
+    this.revision = value.revision
+    try {
+      const epoch = validateMasterEpoch(value.epoch)
+      if (epoch.rootId !== this.rootId || epoch.contextId !== this.contextId) return false
+      this.current = { epoch, revision: value.revision, stages: validateTrackStages(value.stages) }
+      return true
+    } catch {
+      return false
+    }
+  }
+  process(
+    input: Float32Array[],
+    output: Float32Array[],
+    firstSample: number,
+    sampleRate: number,
+  ): void {
+    const current = this.current
+    for (let i = 0; i < (output[0]?.length ?? 0); i++) {
+      const frame = current ? masterFrameAtSample(current.epoch, firstSample + i, sampleRate) : 0
+      const gain =
+        current &&
+        current.epoch.running &&
+        (firstSample + i) / sampleRate >= current.epoch.contextTime &&
+        (current.epoch.loop ||
+          (frame >= current.epoch.firstFrame && frame < current.epoch.lastFrame + 1))
+          ? trackGainAtRootFrame(current.stages, frame)
+          : 0
+      for (let c = 0; c < output.length; c++) output[c]![i] = (input[c]?.[i] ?? 0) * gain
+    }
+  }
+}
+
+/** Returns all contributing static/animated track stages only when a curve owns the gain. */
+export function resolveTrackGainStages(
+  items: readonly TimelineItem[],
+  tracks: readonly TimelineTrack[],
+  compositions: readonly {
+    id: string
+    fps?: number
+    items: TimelineItem[]
+    tracks: TimelineTrack[]
+  }[],
+  itemId: string,
+  ancestorItemIds: readonly string[] = [],
+  fps = 30,
+): TrackGainStage[] {
+  const matches: TrackGainStage[][] = []
+  // Only validate maps that contribute to this exact instance. An unrelated sequence
+  // with an unsupported map must not silence a playable track.
+  const containsGainItem = (
+    ownerItems: readonly TimelineItem[],
+    remainingAncestors: readonly string[],
+    seen: Set<string>,
+  ): boolean =>
+    ownerItems.some((item) => {
+      if (item.id === itemId && remainingAncestors.length === 0) return true
+      if (item.type !== 'composition' && !(item.type === 'audio' && 'compositionId' in item))
+        return false
+      const compositionId = (item as { compositionId: string }).compositionId
+      if (seen.has(compositionId)) return false
+      const child = compositions.find((c) => c.id === compositionId)
+      return (
+        !!child &&
+        containsGainItem(
+          child.items,
+          remainingAncestors.filter((id) => id !== item.id),
+          new Set([...seen, compositionId]),
+        )
+      )
+    })
+  const visit = (
+    ownerItems: readonly TimelineItem[],
+    ownerTracks: readonly TimelineTrack[],
+    ownerFps: number,
+    offset: number,
+    scale: number,
+    stages: TrackGainStage[],
+    path: string[],
+    seen: Set<string>,
+  ) => {
+    for (const item of ownerItems) {
+      const track = ownerTracks.find((t) => t.id === item.trackId)
+      if (!track) continue
+      const next = [
+        ...stages,
+        {
+          trackId: track.id,
+          points: track.gainEnvelope ?? [],
+          gainDb: track.volume ?? 0,
+          muted: track.muted === true,
+          offset,
+          scale,
+        },
+      ]
+      if (
+        item.id === itemId &&
+        ancestorItemIds.filter((id) => id !== itemId).every((id) => path.includes(id))
+      )
+        matches.push(next)
+      if (item.type !== 'composition' && !(item.type === 'audio' && 'compositionId' in item))
+        continue
+      const compositionId = (item as { compositionId: string }).compositionId
+      if (seen.has(compositionId)) continue
+      const child = compositions.find((c) => c.id === compositionId)
+      if (!child) continue
+      if (
+        !containsGainItem(
+          child.items,
+          ancestorItemIds.filter((id) => id !== itemId && id !== item.id && !path.includes(id)),
+          new Set([...seen, compositionId]),
+        )
+      )
+        continue
+      const sourceFps = item.sourceFps ?? child.fps ?? ownerFps
+      cadenceFromFps(sourceFps)
+      cadenceFromFps(ownerFps)
+      const speed = item.speed ?? 1
+      if (!Number.isFinite(speed) || speed <= 0) throw new Error('Unsupported track owner map')
+      const ratio = (speed * sourceFps) / ownerFps
+      const start = item.sourceStart ?? item.trimStart ?? 0
+      const end = item.sourceEnd ?? start + item.durationInFrames * ratio
+      const localScale = item.isReversed ? -ratio : ratio
+      const localOffset = (item.isReversed ? end : start) - item.from * localScale
+      visit(
+        child.items,
+        child.tracks,
+        child.fps ?? sourceFps,
+        localOffset + offset * localScale,
+        scale * localScale,
+        next,
+        [...path, item.id],
+        new Set([...seen, compositionId]),
+      )
+    }
+  }
+  visit(items, tracks, fps, 0, 1, [], [], new Set())
+  const active = matches.filter((s) => s.some((t) => t.points.length > 0))
+  if (!active.length) return []
+  if (active.length !== 1) throw new Error('Ambiguous track automation owner')
+  return validateTrackStages(active[0]!)
+}
