+import { afterEach, expect, it, vi } from 'vite-plus/test'
+import { useItemsStore } from '@/features/timeline/stores/items-store'
+import { useCompositionsStore } from '@/features/timeline/stores/compositions-store'
+import { createPreviewTrackStage } from './preview-track-stage'
+import type { TrackAudioEpoch } from '@/shared/utils/track-audio'
+import type { Clock } from '@/runtime/composition-runtime/deps/player'
+afterEach(() => vi.unstubAllGlobals())
+it('native graph producer ACKs each curve/static/mute/history revision while transport stays unchanged, and disconnects retired owners', async () => {
+  let ready!: () => void
+  const moduleReady = new Promise<void>((r) => (ready = r))
+  const nodes: Node[] = [],
+    gates: {
+      gain: { setValueAtTime: ReturnType<typeof vi.fn> }
+      connect: ReturnType<typeof vi.fn>
+      disconnect: ReturnType<typeof vi.fn>
+    }[] = []
+  class Node {
+    port = {
+      postMessage: vi.fn(),
+      onmessage: null as null | ((e: { data: unknown }) => void),
+      close: vi.fn(),
+    }
+    connect = vi.fn()
+    disconnect = vi.fn()
+    onprocessorerror: unknown
+    constructor() {
+      nodes.push(this)
+    }
+  }
+  vi.stubGlobal('AudioWorkletNode', Node)
+  const context = {
+    currentTime: 0,
+    state: 'running',
+    audioWorklet: { addModule: () => moduleReady },
+    createGain: () => {
+      const g = {
+        gain: { value: 0, setValueAtTime: vi.fn() },
+        connect: vi.fn(),
+        disconnect: vi.fn(),
+      }
+      gates.push(g)
+      return g
+    },
+  } as unknown as AudioContext
+  const transport = {
+    context,
+    rootId: 'r',
+    contextId: 'c',
+    generation: 5,
+    contextTime: 0,
+    frame: 0,
+    num: 30,
+    den: 1,
+    rate: 1,
+    running: true,
+    loop: true,
+    firstFrame: 0,
+    lastFrame: 29,
+  }
+  const clock = Object.assign(new EventTarget(), {
+    getAudioTransportSnapshot: () => transport,
+  }) as unknown as Clock
+  const curve = [{ id: 'p', frame: 0, gainDb: -20 }],
+    track = { id: 'a1', volume: -3, gainEnvelope: curve, muted: false }
+  useItemsStore.setState({
+    items: [{ id: 'clip', trackId: 'a1', type: 'audio' } as never],
+    tracks: [track as never],
+  })
+  useCompositionsStore.setState({ compositions: [] })
+  const input = { connect: vi.fn(), disconnect: vi.fn() } as unknown as AudioNode
+  const dispose = createPreviewTrackStage(clock, context, input, {} as AudioNode, 'clip')
+  expect(nodes).toHaveLength(0)
+  expect(gates[0]!.gain.setValueAtTime.mock.lastCall![0]).toBe(0)
+  ready()
+  await vi.waitFor(() => expect(nodes).toHaveLength(1))
+  const latest = () => nodes[0]!.port.postMessage.mock.lastCall![0] as TrackAudioEpoch
+  const ack = (v = latest(), accepted = true) =>
+    nodes[0]!.port.onmessage!({
+      data: { rootId: 'r', contextId: 'c', revision: v.revision, accepted },
+    })
+  const old = latest()
+  ack()
+  expect(gates[0]!.gain.setValueAtTime.mock.lastCall![0]).toBe(1)
+  for (const updates of [
+    { volume: -9 },
+    { gainEnvelope: [{ id: 'p', frame: 0, gainDb: -10 }] },
+    { muted: true },
+    { ...track },
+  ]) {
+    const previous = latest()
+    useItemsStore.setState({ tracks: [{ ...track, ...updates } as never] })
+    expect(latest().revision).toBeGreaterThan(previous.revision)
+    expect(latest().epoch.generation).toBe(5)
+    expect(gates[0]!.gain.setValueAtTime.mock.lastCall![0]).toBe(0)
+    ack(old)
+    expect(gates[0]!.gain.setValueAtTime.mock.lastCall![0]).toBe(0)
+    ack()
+  }
+  // A terminal processor failure must invalidate an already matching pending ACK.
+  const terminal = latest()
+  ;(nodes[0]!.onprocessorerror as () => void)()
+  expect(gates[0]!.gain.setValueAtTime.mock.lastCall![0]).toBe(0)
+  ack(terminal)
+  expect(gates[0]!.gain.setValueAtTime.mock.lastCall![0]).toBe(0)
+  useItemsStore.setState({ tracks: [{ ...track, volume: -4 } as never] })
+  expect(gates[0]!.gain.setValueAtTime.mock.lastCall![0]).toBe(0)
+  dispose()
+  expect(nodes[0]!.disconnect).toHaveBeenCalled()
+  expect(nodes[0]!.port.close).toHaveBeenCalled()
+  expect(nodes[0]!.port.onmessage).toBeNull()
+})
diff --git a/src/runtime/composition-runtime/utils/preview-track-stage.ts b/src/runtime/composition-runtime/utils/preview-track-stage.ts
new file mode 100644
index 0000000000..ed3cbeec79
--- /dev/null
+++ b/src/runtime/composition-runtime/utils/preview-track-stage.ts
@@ -0,0 +1,184 @@
+import type { Clock } from '@/runtime/composition-runtime/deps/player'
+import { useItemsStore } from '@/features/timeline/stores/items-store'
+import { useCompositionsStore } from '@/features/timeline/stores/compositions-store'
+import { useTimelineSettingsStore } from '@/features/timeline/stores/timeline-settings-store'
+import { resolveTrackGainStages, type TrackAudioEpoch } from '@/shared/utils/track-audio'
+import moduleUrl from '../worklets/track-gain-processor.worklet.ts?worker&url'
+const modules = new WeakMap<AudioContext, Promise<void>>()
+/** Independent publication revision: store/history edits replace gain even without transport changes. */
+export function createPreviewTrackStage(
+  clock: Clock,
+  context: AudioContext,
+  input: AudioNode,
+  destination: AudioNode,
+  itemId: string,
+  ancestors: readonly string[] = [],
+): () => void {
+  const gate = context.createGain()
+  gate.channelInterpretation = 'discrete'
+  gate.gain.value = 0
+  gate.connect(destination)
+  let processor: AudioWorkletNode | null = null,
+    disposed = false,
+    loaded = false,
+    revision = 0,
+    pending: TrackAudioEpoch | null = null,
+    loading = false,
+    failed = false
+  const silent = () => {
+    gate.gain.setValueAtTime(0, context.currentTime)
+  }
+  const publish = () => {
+    if (disposed || failed) return
+    silent()
+    const anchor = clock.getAudioTransportSnapshot()
+    if (anchor.context !== context || !anchor.contextId) return
+    let stages
+    try {
+      const state = useItemsStore.getState()
+      stages = resolveTrackGainStages(
+        state.items,
+        state.tracks,
+        useCompositionsStore.getState().compositions,
+        itemId,
+        ancestors,
+        useTimelineSettingsStore.getState().fps,
+      )
+    } catch {
+      pending = null
+      input.disconnect()
+      return
+    }
+    if (!stages.length) {
+      input.disconnect()
+      processor?.disconnect()
+      input.connect(gate)
+      gate.gain.setValueAtTime(1, context.currentTime)
+      pending = null
+      return
+    }
+    input.disconnect()
+    if (!loaded) {
+      if (!loading) {
+        loading = true
+        let module = modules.get(context)
+        if (!module) {
+          module = context.audioWorklet.addModule(moduleUrl)
+          modules.set(context, module)
+        }
+        void module
+          .then(() => {
+            loaded = true
+            publish()
+          })
+          .catch(() => {
+            failed = true
+            pending = null
+            silent()
+          })
+      }
+      return
+    }
+    if (!processor) {
+      processor = new AudioWorkletNode(context, 'frameleaf-track-gain', {
+        numberOfInputs: 1,
+        numberOfOutputs: 1,
+        channelCountMode: 'max',
+        channelInterpretation: 'discrete',
+        processorOptions: { rootId: anchor.rootId, contextId: anchor.contextId },
+      })
+      processor.onprocessorerror = () => {
+        failed = true
+        pending = null
+        silent()
+      }
+      processor.port.onmessage = (
+        event: MessageEvent<{
+          rootId: string
+          contextId: string
+          revision: number
+          accepted: boolean
+        }>,
+      ) => {
+        const ack = event.data
+        if (
+          disposed ||
+          failed ||
+          !pending ||
+          ack.rootId !== pending.epoch.rootId ||
+          ack.contextId !== pending.epoch.contextId ||
+          ack.revision !== pending.revision
+        )
+          return
+        const now = clock.getAudioTransportSnapshot()
+        if (
+          now.generation !== pending.epoch.generation ||
+          now.rootId !== pending.epoch.rootId ||
+          now.context !== context
+        )
+          return
+        if (!ack.accepted) {
+          failed = true
+          pending = null
+          silent()
+          return
+        }
+        gate.gain.setValueAtTime(
+          pending.epoch.running && context.state === 'running' ? 1 : 0,
+          context.currentTime,
+        )
+      }
+    }
+    input.connect(processor)
+    processor.connect(gate)
+    pending = {
+      revision: ++revision,
+      epoch: {
+        rootId: anchor.rootId,
+        contextId: anchor.contextId,
+        generation: anchor.generation,
+        contextTime: anchor.contextTime,
+        frame: anchor.frame,
+        num: anchor.num,
+        den: anchor.den,
+        rate: anchor.rate,
+        running: anchor.running,
+        loop: anchor.loop,
+        firstFrame: anchor.firstFrame,
+        lastFrame: anchor.lastFrame,
+        gainDb: 0,
+        muted: false,
+        points: [],
+      },
+      stages,
+    }
+    processor.port.postMessage(pending)
+  }
+  const unsubItems = useItemsStore.subscribe((s, p) => {
+    if (s.tracks !== p.tracks || s.items !== p.items) publish()
+  })
+  const unsubComps = useCompositionsStore.subscribe((s, p) => {
+    if (s.compositions !== p.compositions) publish()
+  })
+  const unsubSettings = useTimelineSettingsStore.subscribe((s, p) => {
+    if (s.fps !== p.fps) publish()
+  })
+  clock.addEventListener('transportchange', publish)
+  publish()
+  return () => {
+    disposed = true
+    pending = null
+    silent()
+    clock.removeEventListener('transportchange', publish)
+    unsubItems()
+    unsubComps()
+    unsubSettings()
+    input.disconnect()
+    processor?.disconnect()
+    if (processor) {
+      processor.port.onmessage = null
+      processor.port.close()
+    }
+    gate.disconnect()
+  }
+}
