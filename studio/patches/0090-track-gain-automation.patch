+import { describe, expect, it } from 'vite-plus/test'
+import { masterGainAtFrame } from './master-audio'
+import { masterFrameAtSample, type MasterAudioEpoch } from './master-audio-epoch'
+import {
+  trackGainAtRootFrame,
+  applyTrackGain,
+  TrackGainProcessor,
+  resolveTrackGainStages,
+} from './track-audio'
+const curve = [
+  { id: 'a', frame: 0, gainDb: -20 },
+  { id: 'b', frame: 30, gainDb: 0 },
+]
+const stage = { trackId: 'a1', points: curve, gainDb: -2, muted: false, offset: 0, scale: 1 }
+const epoch: MasterAudioEpoch = {
+  rootId: 'r',
+  contextId: 'c',
+  generation: 1,
+  contextTime: 0,
+  frame: 0,
+  num: 30,
+  den: 1,
+  rate: 1,
+  running: true,
+  loop: true,
+  firstFrame: 0,
+  lastFrame: 29,
+  gainDb: 0,
+  muted: false,
+  points: [],
+}
+describe('track gain sample authority', () => {
+  it('uses linear master evaluator and independent owner maps after root modulo', () => {
+    const f = masterFrameAtSample(epoch, 45 * 1600, 48000)
+    expect(f).toBe(15)
+    expect(
+      trackGainAtRootFrame([stage, { ...stage, trackId: 'nested', offset: 3, scale: 0.5 }], f),
+    ).toBeCloseTo(masterGainAtFrame(curve, 15) * masterGainAtFrame(curve, 10.5), 12)
+  })
+  it('applies selected-range origin uniformly without folding six planes', () => {
+    const planes = Array.from({ length: 6 }, (_, i) => new Float32Array([i + 1, i + 1]))
+    applyTrackGain(planes, [stage], 30, 48000, 15, 0)
+    planes.forEach((p, i) => expect(p[0]).toBeCloseTo((i + 1) * 10 ** (-10 / 20), 6))
+  })
+  it('replaces track revision independently from unchanged transport generation; bad ACK data is silent', () => {
+    const p = new TrackGainProcessor('r', 'c')
+    const out = [new Float32Array(1)]
+    expect(p.replace({ epoch, revision: 1, stages: [stage] })).toBe(true)
+    p.process([new Float32Array([1])], out, 0, 48000)
+    expect(out[0]![0]).toBeCloseTo(0.1, 6)
+    expect(p.replace({ epoch, revision: 2, stages: [{ ...stage, points: [], gainDb: -6 }] })).toBe(
+      true,
+    )
+    p.process([new Float32Array([1])], out, 0, 48000)
+    expect(out[0]![0]).toBeCloseTo(10 ** (-6 / 20), 6)
+    expect(p.replace({ epoch, revision: 1, stages: [stage] })).toBe(false)
+    p.process([new Float32Array([1])], out, 0, 48000)
+    expect(out[0]![0]).toBe(0)
+  })
+  it('preserves cleared static fallback and loops for 100 passes without timers', () => {
+    const p = new TrackGainProcessor('r', 'c')
+    p.replace({ epoch, revision: 1, stages: [stage] })
+    for (let k = 0; k < 100; k++) {
+      const out = [new Float32Array(1)]
+      p.process([new Float32Array([1])], out, (k * 30 + 15) * 1600, 48000)
+      expect(out[0]![0]).toBeCloseTo(10 ** (-10 / 20), 6)
+    }
+    expect(trackGainAtRootFrame([{ ...stage, points: [] }], 15)).toBeCloseTo(10 ** (-2 / 20), 12)
+    expect(trackGainAtRootFrame([{ ...stage, muted: true }], 15)).toBe(0)
+  })
+  it('maps reused nested ownership through trim, speed and cadence without editing tracks', () => {
+    const leaf = { id: 'leaf', trackId: 'child', type: 'audio', from: 0, durationInFrames: 100 }
+    const wrappers = [
+      {
+        id: 'w1',
+        trackId: 'a1',
+        type: 'composition',
+        compositionId: 'sub',
+        from: 30,
+        durationInFrames: 60,
+        sourceStart: 12,
+        sourceFps: 24,
+        speed: 2,
+      },
+      {
+        id: 'w2',
+        trackId: 'a1',
+        type: 'composition',
+        compositionId: 'sub',
+        from: 120,
+        durationInFrames: 60,
+        sourceStart: 12,
+        sourceFps: 24,
+        speed: 2,
+      },
+    ]
+    const tracks = [{ id: 'a1', volume: -3, gainEnvelope: curve }],
+      childTracks = [{ id: 'child', volume: -4, gainEnvelope: curve }]
+    const comps = [{ id: 'sub', fps: 24, items: [leaf], tracks: childTracks }]
+    const a = resolveTrackGainStages(
+      wrappers as never,
+      tracks as never,
+      comps as never,
+      'leaf',
+      ['w1'],
+      30,
+    )
+    const b = resolveTrackGainStages(
+      wrappers as never,
+      tracks as never,
+      comps as never,
+      'leaf',
+      ['w2'],
+      30,
+    )
+    expect(trackGainAtRootFrame(a, 45)).toBeCloseTo(trackGainAtRootFrame(b, 135), 12)
+    expect(a[1]!.offset + a[1]!.scale * 45).toBe(36)
+    expect(tracks[0]!.volume).toBe(-3)
+  })
+  it('leaves unrelated unsupported maps untouched and refuses ambiguous active instances', () => {
+    const leaf = { id: 'leaf', trackId: 'child', type: 'audio', from: 0, durationInFrames: 60 }
+    const bad = {
+      id: 'bad',
+      trackId: 'a',
+      type: 'composition',
+      compositionId: 'other',
+      from: 0,
+      durationInFrames: 60,
+      sourceFps: 27.3,
+    }
+    const valid = {
+      id: 'good',
+      trackId: 'a',
+      type: 'composition',
+      compositionId: 'sub',
+      from: 0,
+      durationInFrames: 60,
+    }
+    const tracks = [{ id: 'a', volume: -3, gainEnvelope: curve }]
+    const comps = [
+      { id: 'other', fps: 27.3, tracks: [{ id: 'child' }], items: [{ ...leaf, id: 'untouched' }] },
+      { id: 'sub', fps: 30, tracks: [{ id: 'child', volume: -4 }], items: [leaf] },
+    ]
+    expect(
+      resolveTrackGainStages([bad, valid] as never, tracks as never, comps as never, 'leaf', [
+        'good',
+      ]),
+    ).toHaveLength(2)
+    expect(
+      resolveTrackGainStages([bad] as never, tracks as never, comps as never, 'missing'),
+    ).toEqual([])
+    expect(() =>
+      resolveTrackGainStages(
+        [valid, { ...valid, id: 'reuse' }] as never,
+        tracks as never,
+        comps as never,
+        'leaf',
+      ),
+    ).toThrow('Ambiguous')
+    expect(() =>
+      resolveTrackGainStages(
+        [{ ...bad, compositionId: 'sub' }] as never,
+        tracks as never,
+        comps as never,
+        'leaf',
+      ),
+    ).toThrow()
+  })
+})
