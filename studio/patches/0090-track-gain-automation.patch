+import { afterEach, expect, it, vi } from 'vite-plus/test'
+import type { TrackAudioEpoch } from '@/shared/utils/track-audio'
+import { masterFrameAtSample } from '@/shared/utils/master-audio-epoch'
+import { masterGainAtFrame } from '@/shared/utils/master-audio'
+afterEach(() => vi.unstubAllGlobals())
+it('actual track worklet maps root loops first on eight planes; replaces map/curve/mute with independent ACK', async () => {
+  let Constructor: new (options: unknown) => {
+    port: { onmessage: (event: { data: TrackAudioEpoch }) => void }
+    process: (inputs: Float32Array[][], outputs: Float32Array[][]) => boolean
+  }
+  const acknowledgements: unknown[] = []
+  vi.stubGlobal(
+    'AudioWorkletProcessor',
+    class {
+      port = { onmessage: null, postMessage: (value: unknown) => acknowledgements.push(value) }
+    },
+  )
+  vi.stubGlobal('registerProcessor', (_name: string, ctor: typeof Constructor) => {
+    Constructor = ctor
+  })
+  vi.stubGlobal('sampleRate', 120)
+  vi.stubGlobal('currentFrame', 0)
+  await import('./track-gain-processor.worklet')
+  const p = new Constructor!({ processorOptions: { rootId: 'root', contextId: 'context' } })
+  const points = [
+    { id: 'a', frame: 0, gainDb: -20 },
+    { id: 'b', frame: 30, gainDb: 0 },
+  ]
+  const value: TrackAudioEpoch = {
+    revision: 1,
+    epoch: {
+      rootId: 'root',
+      contextId: 'context',
+      generation: 7,
+      contextTime: 0,
+      frame: 12.5,
+      num: 30000,
+      den: 1001,
+      rate: -2,
+      running: true,
+      loop: true,
+      firstFrame: 10,
+      lastFrame: 14,
+      gainDb: 0,
+      muted: false,
+      points: [],
+    },
+    stages: [
+      { trackId: 'a1', points, gainDb: -6, muted: false, offset: 0, scale: 1 },
+      { trackId: 'child', points, gainDb: -3, muted: false, offset: 2, scale: 0.8 },
+    ],
+  }
+  const inputs = [Array.from({ length: 8 }, (_, c) => new Float32Array(128).fill((c + 1) / 8))],
+    outputs = [inputs[0]!.map((x) => new Float32Array(x.length))]
+  p.process(inputs, outputs)
+  expect(outputs[0]!.every((x) => x.every((y) => y === 0))).toBe(true)
+  p.port.onmessage({ data: value })
+  expect(acknowledgements.at(-1)).toEqual({
+    rootId: 'root',
+    contextId: 'context',
+    revision: 1,
+    accepted: true,
+  })
+  for (let block = 0; block < 100; block++) {
+    vi.stubGlobal('currentFrame', block * 128)
+    p.process(inputs, outputs)
+    for (let i = 0; i < 128; i += 17) {
+      const f = masterFrameAtSample(value.epoch, block * 128 + i, 120),
+        gain = masterGainAtFrame(points, f) * masterGainAtFrame(points, 2 + 0.8 * f)
+      for (let c = 0; c < 8; c++) expect(outputs[0]![c]![i]).toBeCloseTo(((c + 1) / 8) * gain, 6)
+    }
+  }
+  p.port.onmessage({
+    data: { ...value, revision: 2, stages: [{ ...value.stages[0]!, points: [], gainDb: -6 }] },
+  })
+  vi.stubGlobal('currentFrame', 12800)
+  p.process(inputs, outputs)
+  expect(outputs[0]![0]![0]).toBeCloseTo(10 ** (-6 / 20) / 8, 6)
+  p.port.onmessage({
+    data: { ...value, revision: 3, stages: [{ ...value.stages[0]!, muted: true }] },
+  })
+  p.process(inputs, outputs)
+  expect(outputs[0]!.every((x) => x.every((y) => y === 0))).toBe(true)
+  p.port.onmessage({
+    data: { ...value, revision: 4, epoch: { ...value.epoch, rootId: 'foreign' } },
+  })
+  expect(acknowledgements.at(-1)).toMatchObject({ accepted: false })
+  p.process(inputs, outputs)
+  expect(outputs[0]!.every((x) => x.every((y) => y === 0))).toBe(true)
+})
