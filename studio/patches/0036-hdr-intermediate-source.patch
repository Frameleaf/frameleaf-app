+fn fl_bt2020_to_bt709(c: vec3f) -> vec3f {
+  return vec3f(
+    dot(vec3f(1.660491, -0.587641, -0.07285), c),
+    dot(vec3f(-0.124551, 1.1329, -0.008349), c),
+    dot(vec3f(-0.018151, -0.100579, 1.11873), c),
+  );
+}
+
+fn fl_pq_decode(signal: vec3f) -> vec3f {
+  let e = pow(clamp(signal, vec3f(0.0), vec3f(1.0)), vec3f(1.0 / FL_PQ_M2));
+  return FL_PQ_PEAK * pow(max(e - vec3f(FL_PQ_C1), vec3f(0.0)) / (vec3f(FL_PQ_C2) - FL_PQ_C3 * e), vec3f(1.0 / FL_PQ_M1));
+}
+
+fn fl_hlg_inverse_oetf(signal: vec3f) -> vec3f {
+  let e = clamp(signal, vec3f(0.0), vec3f(1.0));
+  return select((exp((e - vec3f(FL_HLG_C)) / FL_HLG_A) + vec3f(FL_HLG_B)) / 12.0, e * e / 3.0, e <= vec3f(0.5));
+}
+
+fn fl_hlg_ootf(scene: vec3f) -> vec3f {
+  // BT.2100 at the 1000 cd/m² nominal peak: system gamma 1.2.
+  let ys = max(dot(vec3f(0.2627, 0.678, 0.0593), scene), 0.0);
+  if (ys <= 0.0) { return vec3f(0.0); }
+  return scene * FL_HLG_PEAK * pow(ys, 0.2);
+}
+
+// Limited-range BT.2020 NCL Y'CbCr code values -> R'G'B' signal in [0, 1] (ycbcr2020ToSignal).
+fn fl_ycbcr2020_to_signal(y: f32, cb: f32, cr: f32, bitDepth: f32) -> vec3f {
+  let scale = exp2(bitDepth - 8.0);
+  let yn = (y / scale - 16.0) / 219.0;
+  let cbn = (cb / scale - 128.0) / 224.0;
+  let crn = (cr / scale - 128.0) / 224.0;
+  let r = yn + 2.0 * (1.0 - 0.2627) * crn;
+  let b = yn + 2.0 * (1.0 - 0.0593) * cbn;
+  let g = (yn - 0.2627 * r - 0.0593 * b) / 0.678;
+  return clamp(vec3f(r, g, b), vec3f(0.0), vec3f(1.0));
+}
+
+// HDR source ingest (signalToWorking): transfer 0 = PQ, 1 = HLG.
+fn fl_signal_to_working(signal: vec3f, transfer: f32, referenceWhite: f32) -> vec3f {
+  var nits: vec3f;
+  if (transfer < 0.5) {
+    nits = fl_pq_decode(signal);
+  } else {
+    nits = fl_hlg_ootf(fl_hlg_inverse_oetf(signal));
+  }
+  return fl_srgb_encode(fl_bt2020_to_bt709(nits / referenceWhite));
+}
+
