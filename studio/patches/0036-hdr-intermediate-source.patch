+/**
+ * FL-97: real HDR pixels for library clips.
+ *
+ * The host registers, per media id, a URL it already authorized for a 10-bit
+ * BT.2020 PQ/HLG intermediate of the original (Frameleaf's Studio HDR
+ * intermediate; never the original itself). An HDR project decodes that URL with
+ * WebCodecs and uploads the planes straight into working values, instead of
+ * reading the SDR playback stream. Anything that cannot (no URL yet, a decoder
+ * that hides its planes, a failed decode) keeps the SDR stream.
+ */
+import { HdrFrameUploader } from '@/infrastructure/gpu-color/hdr-frame-upload'
+import { createLogger } from '@/shared/logging/logger'
+import { VideoFrameExtractor } from './canvas-video-extractor'
+
+const log = createLogger('HdrVideoSources')
+const hdrSourceUrls = new Map<string, string>()
+
+export function registerHdrSourceUrl(mediaId: string, url: string | null | undefined): void {
+  if (url) hdrSourceUrls.set(mediaId, url)
+  else hdrSourceUrls.delete(mediaId)
+}
+
+export function getHdrSourceUrl(mediaId: string | undefined): string | undefined {
+  return mediaId ? hdrSourceUrls.get(mediaId) : undefined
+}
+
+interface ItemSource {
+  url: string
+  extractor: VideoFrameExtractor
+  ready: Promise<boolean>
+  texture: GPUTexture | null
+  textureTime: number | null
+}
+
+export interface HdrVideoFrameTexture {
+  texture: GPUTexture
+  width: number
+  height: number
+}
+
+export class HdrVideoSources {
+  private readonly items = new Map<string, ItemSource>()
+  private readonly failed = new Set<string>()
+  private uploader: HdrFrameUploader | null = null
+
+  constructor(private readonly getDevice: () => GPUDevice | null | undefined) {}
+
+  /** The item's frame at `sourceTime` in working values, or null to use the SDR route. */
+  async frameTexture(
+    item: { id: string; mediaId?: string },
+    sourceTime: number,
+    referenceWhiteNits: number,
+  ): Promise<HdrVideoFrameTexture | null> {
+    const url = getHdrSourceUrl(item.mediaId)
+    const device = this.getDevice()
+    if (!url || !device || this.failed.has(url)) return null
+    const source = this.sourceFor(item.id, url)
+    if (!(await source.ready)) return this.fail(url, 'init')
+    const frame = await source.extractor.captureHdrFrame(sourceTime)
+    if (!frame) return null
+    if (frame === 'unsupported') return this.fail(url, 'not a 10-bit BT.2020 PQ/HLG frame')
+    if (
+      !source.texture ||
+      source.texture.width !== frame.width ||
+      source.texture.height !== frame.height
+    ) {
+      source.texture?.destroy()
+      source.texture = device.createTexture({
+        size: [frame.width, frame.height],
+        format: 'rgba16float',
+        usage: GPUTextureUsage.TEXTURE_BINDING | GPUTextureUsage.RENDER_ATTACHMENT,
+      })
+      source.textureTime = null
+    }
+    if (source.textureTime !== frame.sourceTime) {
+      this.uploader ??= new HdrFrameUploader(device)
+      if (!this.uploader.upload(frame, source.texture, referenceWhiteNits)) {
+        return this.fail(url, 'upload')
+      }
+      source.textureTime = frame.sourceTime
+    }
+    return { texture: source.texture, width: frame.width, height: frame.height }
+  }
+
+  dispose(): void {
+    for (const source of this.items.values()) {
+      source.extractor.dispose()
+      source.texture?.destroy()
+    }
+    this.items.clear()
+    this.uploader?.destroy()
+    this.uploader = null
+  }
+
+  private sourceFor(itemId: string, url: string): ItemSource {
+    const existing = this.items.get(itemId)
+    if (existing?.url === url) return existing
+    if (existing) {
+      existing.extractor.dispose()
+      existing.texture?.destroy()
+    }
+    const extractor = new VideoFrameExtractor(url, itemId)
+    const source: ItemSource = {
+      url,
+      extractor,
+      ready: extractor.init(),
+      texture: null,
+      textureTime: null,
+    }
+    this.items.set(itemId, source)
+    return source
+  }
+
+  private fail(url: string, reason: string): null {
+    // ponytail: one failure retires the URL for this renderer; the SDR stream takes over.
+    this.failed.add(url)
+    log.warn('HDR intermediate unavailable; using the SDR stream', { reason })
+    return null
+  }
+}
