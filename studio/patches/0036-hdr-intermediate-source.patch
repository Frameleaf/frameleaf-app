+import { FULLSCREEN_QUAD_WGSL } from '@/infrastructure/gpu-shared/fullscreen-quad'
+import {
+  DEFAULT_REFERENCE_WHITE_NITS,
+  type HdrTransfer,
+} from '@/shared/graphics/color/managed-color'
+import { MANAGED_COLOR_WGSL } from './managed-color-wgsl'
+
+/**
+ * A decoded HDR frame as WebCodecs lays it out (`VideoFrame.copyTo`): 10-bit planar
+ * 4:2:0 Y'CbCr, BT.2020 non-constant luminance, limited range, PQ or HLG (FL-97).
+ * This is what Frameleaf's Studio HDR intermediate always decodes to.
+ */
+export interface HdrPlanarFrame {
+  format: 'I420P10'
+  width: number
+  height: number
+  transfer: HdrTransfer
+  data: Uint8Array
+  layout: ReadonlyArray<{ offset: number; stride: number }>
+}
+
+const HDR_FRAME_UPLOAD_WGSL = /* wgsl */ `
+${FULLSCREEN_QUAD_WGSL}
+${MANAGED_COLOR_WGSL}
+
+struct Params {
+  size: vec2f,
+  chromaSize: vec2f,
+  transfer: f32,
+  referenceWhite: f32,
+  pad: vec2f,
+};
+
+@group(0) @binding(0) var yTex: texture_2d<u32>;
+@group(0) @binding(1) var cbTex: texture_2d<u32>;
+@group(0) @binding(2) var crTex: texture_2d<u32>;
+@group(0) @binding(3) var<uniform> p: Params;
+
+fn chromaAt(tex: texture_2d<u32>, pixel: vec2i) -> f32 {
+  let last = vec2i(p.chromaSize) - vec2i(1);
+  return f32(textureLoad(tex, clamp(pixel, vec2i(0), last), 0).x);
+}
+
+// Bilinear chroma with centred siting.
+fn chroma(tex: texture_2d<u32>, at: vec2f) -> f32 {
+  let origin = vec2i(floor(at));
+  let w = fract(at);
+  let top = mix(chromaAt(tex, origin), chromaAt(tex, origin + vec2i(1, 0)), w.x);
+  let bottom = mix(chromaAt(tex, origin + vec2i(0, 1)), chromaAt(tex, origin + vec2i(1, 1)), w.x);
+  return mix(top, bottom, w.y);
+}
+
+@fragment
+fn fragmentMain(input: VertexOutput) -> @location(0) vec4f {
+  let pixel = min(vec2i(floor(input.uv * p.size)), vec2i(p.size) - vec2i(1));
+  let at = (vec2f(pixel) + vec2f(0.5)) * (p.chromaSize / p.size) - vec2f(0.5);
+  let signal = fl_ycbcr2020_to_signal(
+    f32(textureLoad(yTex, pixel, 0).x), chroma(cbTex, at), chroma(crTex, at), 10.0,
+  );
+  return vec4f(fl_signal_to_working(signal, p.transfer, p.referenceWhite), 1.0);
+}
+`
+
+/**
+ * Uploads decoded HDR planes and converts them to working values (extended sRGB,
+ * BT.709, 1.0 = reference white) in an rgba16float texture, exactly as
+ * `signalToWorking(ycbcr2020ToSignal(...))` does on the CPU. The browser's own
+ * VideoFrame import converts to SDR, so HDR pixels never go through it.
+ */
+export class HdrFrameUploader {
+  private readonly pipeline: GPURenderPipeline
+  private readonly uniforms: GPUBuffer
+  private planes: GPUTexture[] = []
+
+  constructor(private readonly device: GPUDevice) {
+    const module = device.createShaderModule({
+      label: 'hdr-frame-upload',
+      code: HDR_FRAME_UPLOAD_WGSL,
+    })
+    this.pipeline = device.createRenderPipeline({
+      label: 'hdr-frame-upload',
+      layout: 'auto',
+      vertex: { module, entryPoint: 'vertexMain' },
+      fragment: { module, entryPoint: 'fragmentMain', targets: [{ format: 'rgba16float' }] },
+      primitive: { topology: 'triangle-list' },
+    })
+    this.uniforms = device.createBuffer({
+      size: 32,
+      usage: GPUBufferUsage.UNIFORM | GPUBufferUsage.COPY_DST,
+    })
+  }
+
+  /** Writes `frame` into `output` (rgba16float, the frame's size). */
+  upload(
+    frame: HdrPlanarFrame,
+    output: GPUTexture,
+    referenceWhiteNits = DEFAULT_REFERENCE_WHITE_NITS,
+  ): boolean {
+    const { width, height } = frame
+    if (
+      frame.format !== 'I420P10' ||
+      frame.layout.length < 3 ||
+      output.width !== width ||
+      output.height !== height
+    ) {
+      return false
+    }
+    const chroma = [Math.ceil(width / 2), Math.ceil(height / 2)] as const
+    const sizes = [[width, height], chroma, chroma] as const
+    const planes = this.ensurePlanes(sizes)
+    planes.forEach((texture, i) => {
+      const plane = frame.layout[i]!
+      this.device.queue.writeTexture(
+        { texture },
+        frame.data,
+        { offset: plane.offset, bytesPerRow: plane.stride, rowsPerImage: texture.height },
+        [texture.width, texture.height],
+      )
+    })
+    this.device.queue.writeBuffer(
+      this.uniforms,
+      0,
+      new Float32Array([
+        width,
+        height,
+        chroma[0],
+        chroma[1],
+        frame.transfer === 'pq' ? 0 : 1,
+        referenceWhiteNits,
+        0,
+        0,
+      ]),
+    )
+    const bindGroup = this.device.createBindGroup({
+      layout: this.pipeline.getBindGroupLayout(0),
+      entries: [
+        ...this.planes.map((plane, binding) => ({ binding, resource: plane.createView() })),
+        { binding: 3, resource: { buffer: this.uniforms } },
+      ],
+    })
+    const encoder = this.device.createCommandEncoder()
+    const pass = encoder.beginRenderPass({
+      colorAttachments: [
+        { view: output.createView(), loadOp: 'clear', storeOp: 'store', clearValue: [0, 0, 0, 0] },
+      ],
+    })
+    pass.setPipeline(this.pipeline)
+    pass.setBindGroup(0, bindGroup)
+    pass.draw(6)
+    pass.end()
+    this.device.queue.submit([encoder.finish()])
+    return true
+  }
+
+  destroy(): void {
+    for (const plane of this.planes) plane.destroy()
+    this.planes = []
+    this.uniforms.destroy()
+  }
+
+  private ensurePlanes(sizes: ReadonlyArray<readonly [number, number]>): GPUTexture[] {
+    if (
+      this.planes.length === sizes.length &&
+      this.planes.every(
+        (plane, i) => plane.width === sizes[i]?.[0] && plane.height === sizes[i]?.[1],
+      )
+    ) {
+      return this.planes
+    }
+    for (const plane of this.planes) plane.destroy()
+    this.planes = sizes.map(([width, height]) =>
+      this.device.createTexture({
+        size: [width, height],
+        format: 'r16uint',
+        usage: GPUTextureUsage.TEXTURE_BINDING | GPUTextureUsage.COPY_DST,
+      }),
+    )
+    return this.planes
+  }
+}
