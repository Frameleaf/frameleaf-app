+            <DropdownMenuTrigger asChild>
+              <Button
+                variant="ghost"
+                className="h-8 gap-2 px-2.5 text-sm"
+                aria-label={t('timeline.header.moreAria')}
+              >
+                <MoreHorizontal className="h-4 w-4" />
+                {t('timeline.header.more')}
+                <ChevronDown className="h-3.5 w-3.5 opacity-70" />
+              </Button>
+            </DropdownMenuTrigger>
+            <DropdownMenuContent align="start" className="min-w-80">
+              <DropdownMenuCheckboxItem
+                checked={linkedSelectionEnabled}
+                onSelect={(event) => {
+                  event.preventDefault()
+                  setLinkedSelectionEnabled(!linkedSelectionEnabled)
+                }}
+                className="min-h-11 gap-4 py-1.5 text-sm"
+              >
+                <span className="flex flex-1 flex-col">
+                  {t('timeline.header.linkedSelection')}
+                  <span className="text-xs text-muted-foreground">
+                    {t('timeline.header.linkedSelectionNote')}
+                  </span>
+                </span>
+                <span className="text-xs text-muted-foreground">
+                  {formatHotkeyBinding(hotkeys.TOGGLE_LINKED_SELECTION)}
+                </span>
+              </DropdownMenuCheckboxItem>
+              <DropdownMenuCheckboxItem
+                checked={audioSkimmingEnabled}
+                onSelect={(event) => {
+                  event.preventDefault()
+                  toggleAudioSkimming()
+                }}
+                className="min-h-11 gap-4 py-1.5 text-sm"
+              >
+                <span className="flex flex-1 flex-col">
+                  {t('timeline.header.soundWhileScrubbing')}
+                  <span className="text-xs text-muted-foreground">
+                    {t('timeline.header.soundWhileScrubbingNote')}
+                  </span>
+                </span>
+              </DropdownMenuCheckboxItem>
+              <DropdownMenuSeparator />
+              <DropdownMenuItem
+                disabled={inPoint === null && outPoint === null}
+                onSelect={clearInOutPoints}
+                className="min-h-9 gap-4 text-sm"
+              >
+                <span className="flex-1">{t('timeline.header.clearInOut')}</span>
+                <span className="text-xs text-muted-foreground">
+                  {formatHotkeyBinding(hotkeys.CLEAR_IN_OUT)}
+                </span>
+              </DropdownMenuItem>
+              <DropdownMenuItem
+                disabled={!selectedMarkerId}
+                onSelect={() => {
+                  if (selectedMarkerId) {
+                    removeMarker(selectedMarkerId)
+                    clearSelection()
+                  }
+                }}
+                className="min-h-9 gap-4 text-sm"
+              >
+                <span className="flex-1">{t('timeline.header.removeMarker')}</span>
+                <span className="text-xs text-muted-foreground">
+                  {formatHotkeyBinding(hotkeys.REMOVE_MARKER)}
+                </span>
+              </DropdownMenuItem>
+              <DropdownMenuItem
+                disabled={!hasMarkers}
+                onSelect={clearAllMarkers}
+                className="min-h-9 gap-4 text-sm"
+              >
+                {t('timeline.header.clearMarkers')}
+              </DropdownMenuItem>
+            </DropdownMenuContent>
+          </DropdownMenu>
         </div>
       </div>
 
