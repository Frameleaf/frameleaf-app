Subject: Serve ONNX Runtime and transformers.js from the engine build

Freecut MIT adaptation. Owner decisions 2026-09-29: no runtime CDN, and
the Whisper worker stays on transformers.js 3.8.1 (4.1.0 places word
timestamps about a word late). The worker imports the lockfile-pinned
3.8.1 install instead of esm.sh, and every ONNX Runtime WebAssembly the
engine loads (onnxruntime-web, transformers.js 4.x, and transformers.js
3.8.1 for kokoro-js and Whisper) is emitted into the build from the
pinned packages and served from the engine's own origin instead of
cdn.jsdelivr.net.

--- /dev/null
+++ b/src/shared/utils/local-ort-assets.ts
@@ -0,0 +1,41 @@
+/**
+ * Frameleaf: the ONNX Runtime WebAssembly the engine runs, served from the engine's own build
+ * instead of a CDN (owner decision, 2026-09-29). Each file is the one the installed package ships,
+ * so the JavaScript glue and the binary always come from the same pinned version.
+ *
+ * - `ORT_WASM_JSEP` is what `onnxruntime-web` (the default bundle) loads: `ort-runtime.ts`.
+ * - `transformersOrtWasmPaths()` is what `@huggingface/transformers` 4.x chooses for itself
+ *   (asyncify, or the plain build in Safari), for every transformers.js consumer.
+ * - `TRANSFORMERS_3_ORT_WASM` is the build transformers.js 3.8.1 loads: kokoro-js's own runtime and
+ *   the Whisper worker, which stays on 3.8.1 because 4.1.0 places word timestamps late (owner
+ *   decision 2026-09-29; `studio/tools/whisper-timing.test.mjs`).
+ */
+import jsepMjs from 'onnxruntime-web/ort-wasm-simd-threaded.jsep.mjs?url'
+import jsepWasm from 'onnxruntime-web/ort-wasm-simd-threaded.jsep.wasm?url'
+import asyncifyMjs from 'onnxruntime-web/ort-wasm-simd-threaded.asyncify.mjs?url'
+import asyncifyWasm from 'onnxruntime-web/ort-wasm-simd-threaded.asyncify.wasm?url'
+import plainMjs from 'onnxruntime-web/ort-wasm-simd-threaded.mjs?url'
+import plainWasm from 'onnxruntime-web/ort-wasm-simd-threaded.wasm?url'
+import kokoroMjs from '../../../node_modules/kokoro-js/node_modules/@huggingface/transformers/dist/ort-wasm-simd-threaded.jsep.mjs?url'
+import kokoroWasm from '../../../node_modules/kokoro-js/node_modules/@huggingface/transformers/dist/ort-wasm-simd-threaded.jsep.wasm?url'
+
+export interface OrtWasmPaths {
+  mjs: string
+  wasm: string
+}
+
+/** Absolute, so a worker or a blob-URL module resolves it against the page, not itself. */
+const absolute = (url: string) => new URL(url, globalThis.location?.href ?? 'http://localhost/').href
+
+const paths = (mjs: string, wasm: string): OrtWasmPaths => ({ mjs: absolute(mjs), wasm: absolute(wasm) })
+
+export const ORT_WASM_JSEP = (): OrtWasmPaths => paths(jsepMjs, jsepWasm)
+
+/** transformers.js 4.x's own choice (`backends/onnx.js`), with the files served locally. */
+export function transformersOrtWasmPaths(): OrtWasmPaths {
+  const userAgent = globalThis.navigator?.userAgent ?? ''
+  const safari = /Safari\//.test(userAgent) && !/Chrome\/|Chromium\/|Edg\//.test(userAgent)
+  return safari ? paths(plainMjs, plainWasm) : paths(asyncifyMjs, asyncifyWasm)
+}
+
+export const TRANSFORMERS_3_ORT_WASM = (): OrtWasmPaths => paths(kokoroMjs, kokoroWasm)
