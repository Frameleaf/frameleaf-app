+import { assessExportPreflight } from './export-preflight'
+
+const sequence: ExportableSequence = {
+  id: null,
+  name: 'Export admission',
+  tracks: [],
+  items: [],
+  transitions: [],
+  keyframes: [],
+  fps: 30,
+  width: 1920,
+  height: 1080,
