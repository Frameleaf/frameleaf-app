+}
+
+afterEach(() => vi.restoreAllMocks())
+
+it('refuses unsupported export combinations before creating jobs, including smart copy and batches', async () => {
+  const newJobId = vi.spyOn(crypto, 'randomUUID')
+  for (const eligible of [false, true]) {
+    assessSmartCopyEligibility.mockReturnValue({ eligible, reason: 'eligible' })
+    for (const [overrides, reason] of [
+      [{ videoContainer: 'mp4' }, 'Embedded subtitles are not supported in MP4'],
+      [{ videoContainer: 'mov' }, 'Embedded subtitles are not supported in MOV'],
+      [{ videoContainer: 'webm' }, 'Codec avc is not supported in WEBM'],
+    ] as const) {
+      const settings = { ...base, ...overrides }
+      await expect(buildRenderJob({ settings, sequence })).rejects.toThrow(reason)
+      await expect(
+        buildSegmentJobs(settings, [{ start: 0, end: 30 }], () => 'Part 1', sequence),
+      ).rejects.toThrow(reason)
+      const preflight = await assessExportPreflight({
+        settings,
+        fps: sequence.fps,
+        composition: { tracks: [], fps: sequence.fps },
+        durationFrames: 60,
+        supportedVideoCodecs: ['avc', 'vp9'],
+        smartCopyAssessment: { eligible, reason: 'eligible' },
+      })
+      expect(preflight.canExport).toBe(false)
+      expect(preflight.checks).toContainEqual(
+        expect.objectContaining({
+          severity: 'error',
+          detailParams: { error: expect.stringContaining(reason) },
+        }),
+      )
+    }
+  }
+  expect(newJobId).not.toHaveBeenCalled()
+  expect(canEncodeVideo).not.toHaveBeenCalled()
+
+  assessSmartCopyEligibility.mockReturnValue({ eligible: false, reason: 'disabled' })
+  const supported: Partial<ExtendedExportSettings>[] = [
+    { videoContainer: 'webm', codec: 'vp9' },
+    { videoContainer: 'mkv' },
+    { subtitleMode: 'burn' },
+    { subtitleMode: 'sidecar' },
+    { subtitleMode: 'off' },
+  ]
+  for (const overrides of supported) {
+    const job = await buildRenderJob({ settings: { ...base, ...overrides }, sequence })
+    expect(job.status).toBe('queued')
+    expect(job.clientSettings.container).toBe(overrides.videoContainer ?? 'mp4')
+    expect(job.clientSettings.subtitleMode).toBe(overrides.subtitleMode ?? 'embedded')
+  }
+  expect(canEncodeVideo).toHaveBeenCalled()
+  expect(newJobId).toHaveBeenCalledTimes(5)
+})
