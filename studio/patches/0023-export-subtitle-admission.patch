+// @vitest-environment node
+
+import { afterEach, expect, it, vi } from 'vite-plus/test'
+import type {
+  ExportRenderWorkerRequest,
+  ExportRenderWorkerResponse,
+} from './export-render-worker.types'
+import type { ClientExportSettings } from '../utils/client-renderer'
+
+const { createCompositionRenderer, createExportOutputTarget } = vi.hoisted(() => ({
+  createCompositionRenderer: vi.fn(),
+  createExportOutputTarget: vi.fn(),
+}))
+vi.mock('../utils/client-render-engine', () => ({ createCompositionRenderer }))
+vi.mock('../utils/export-output-target', () => ({ createExportOutputTarget }))
+vi.mock('@/shared/logging/logger', () => ({ createLogger: () => ({ error: vi.fn() }) }))
+
+afterEach(() => vi.unstubAllGlobals())
+
+it('returns a structured refusal for direct worker requests before creating a renderer or output', async () => {
+  const worker = {
+    addEventListener: vi.fn(),
+    postMessage: vi.fn<(message: ExportRenderWorkerResponse) => void>(),
+    onmessage: null as ((event: MessageEvent<ExportRenderWorkerRequest>) => Promise<void>) | null,
+  }
+  vi.stubGlobal('self', worker)
+  vi.stubGlobal('window', {})
+  await import('./export-render.worker')
+  const base: ClientExportSettings = {
+    mode: 'video',
+    codec: 'avc',
+    container: 'mp4',
+    subtitleMode: 'embedded',
+    quality: 'high',
+    resolution: { width: 1920, height: 1080 },
+    fps: 30,
+  }
+  const cases: Array<[Partial<ClientExportSettings>, string]> = [
+    [{}, 'Embedded subtitles are not supported in MP4'],
+    [{ container: 'mov' }, 'Embedded subtitles are not supported in MOV'],
+    [{ container: 'webm' }, 'Codec avc is not supported in WEBM'],
+    [{ mode: 'audio' }, 'Audio export must use an audio-only container'],
+    [{ subtitleMode: 'burn', fps: 240 }, 'Invalid frame rate (must be 1-120)'],
+  ]
+  for (const [settings, reason] of cases) {
+    worker.postMessage.mockClear()
+    const data: ExportRenderWorkerRequest = {
+      type: 'start',
+      requestId: 'saved-job',
+      settings: { ...base, ...settings },
+      composition: { tracks: [], fps: 30, durationInFrames: 60 },
+    }
+    await worker.onmessage!({ data } as MessageEvent<ExportRenderWorkerRequest>)
+    expect(worker.postMessage).toHaveBeenCalledExactlyOnceWith({
+      type: 'error',
+      requestId: 'saved-job',
+      error: expect.stringContaining(reason),
+    })
+  }
+  const { renderComposition, renderAudioOnly } = await import('../utils/canvas-render-orchestrator')
+  for (const [overrides, reason] of cases.filter(([settings]) => settings.fps === undefined)) {
+    const settings = { ...base, ...overrides }
+    const render = settings.mode === 'audio' ? renderAudioOnly : renderComposition
+    await expect(
+      render({
+        settings,
+        composition: { tracks: [], fps: 30, durationInFrames: 60 },
+        onProgress: vi.fn(),
+      }),
+    ).rejects.toThrow(reason)
+  }
+  expect(createCompositionRenderer).not.toHaveBeenCalled()
+  expect(createExportOutputTarget).not.toHaveBeenCalled()
+})
