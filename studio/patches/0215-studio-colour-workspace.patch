+import { describe, expect, it } from 'vite-plus/test'
+import { getNiceTickStep, MIN_RULER_LABEL_SPACING_PX } from './dopesheet-helpers'
+
+describe('getNiceTickStep (FL-1822)', () => {
+  it('keeps about ten ticks when the ruler is wide', () => {
+    expect(getNiceTickStep(200)).toBe(20)
+    expect(getNiceTickStep(200, 1200)).toBe(20)
+  })
+
+  it('takes a coarser step so ruler numbers stay apart on a narrow ruler', () => {
+    const width = 140
+    const step = getNiceTickStep(200, width)
+    expect(step).toBe(100)
+    expect((width / 200) * step).toBeGreaterThanOrEqual(MIN_RULER_LABEL_SPACING_PX)
+  })
+})
