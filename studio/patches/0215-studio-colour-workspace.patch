+/** Pixels a ruler number needs so neighbours never run together (FL-1822). */
+export const MIN_RULER_LABEL_SPACING_PX = 48
+
+/**
+ * A round frame step for the ruler: about ten ticks, fewer when `widthPx` is too narrow for ten
+ * numbers to sit apart.
+ */
+export function getNiceTickStep(frameRange: number, widthPx?: number): number {
+  const maxTicks =
+    widthPx && widthPx > 0 ? Math.max(2, Math.min(10, Math.floor(widthPx / MIN_RULER_LABEL_SPACING_PX))) : 10
+  const rough = Math.max(1, frameRange / maxTicks)
   const magnitude = Math.pow(10, Math.floor(Math.log10(rough)))
   const normalized = rough / magnitude
   if (normalized <= 1) return magnitude
