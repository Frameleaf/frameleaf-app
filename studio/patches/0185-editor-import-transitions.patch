diff --git a/src/infrastructure/gpu-transitions/transitions/editor-import.ts b/src/infrastructure/gpu-transitions/transitions/editor-import.ts
new file mode 100644
index 0000000..f23ae87
--- /dev/null
+++ b/src/infrastructure/gpu-transitions/transitions/editor-import.ts
@@ -0,0 +1,229 @@
+import type { GpuTransitionDefinition } from '../types'
+
+// FL-1564: transitions other editors use that Studio lacked: Film Dissolve, Cross Zoom,
+// Cube Spin and Page Peel. Inputs are premultiplied; outputs are premultiplied (the
+// pipeline converts back to straight alpha). studio/spec/transitions/<id>.md is the contract.
+
+const BINDINGS = /* wgsl */ `
+@group(0) @binding(0) var texSampler: sampler;
+@group(0) @binding(1) var leftTex: texture_2d<f32>;
+@group(0) @binding(2) var rightTex: texture_2d<f32>;
+`
+
+export const filmDissolve: GpuTransitionDefinition = {
+  id: 'filmDissolve',
+  name: 'Film Dissolve',
+  category: 'dissolve',
+  hasDirection: false,
+  entryPoint: 'filmDissolveFragment',
+  uniformSize: 16,
+  shader: /* wgsl */ `
+struct FilmDissolveParams {
+  progress: f32,
+  width: f32,
+  height: f32,
+  _pad: f32,
+};
+${BINDINGS}
+@group(0) @binding(3) var<uniform> params: FilmDissolveParams;
+
+fn filmDecode(c: vec3f) -> vec3f {
+  let x = max(c, vec3f(0.0));
+  return select(pow((x + 0.055) / 1.055, vec3f(2.4)), x / 12.92, x <= vec3f(0.04045));
+}
+
+fn filmEncode(c: vec3f) -> vec3f {
+  let x = max(c, vec3f(0.0));
+  return select(1.055 * pow(x, vec3f(1.0 / 2.4)) - 0.055, x * 12.92, x <= vec3f(0.0031308));
+}
+
+fn filmLinear(c: vec4f) -> vec3f {
+  return select(vec3f(0.0), filmDecode(c.rgb / max(c.a, 1e-6)) * c.a, c.a > 0.0);
+}
+
+@fragment
+fn filmDissolveFragment(input: VertexOutput) -> @location(0) vec4f {
+  let a = textureSample(leftTex, texSampler, input.uv);
+  let b = textureSample(rightTex, texSampler, input.uv);
+  let t = clamp(params.progress, 0.0, 1.0);
+  let alpha = mix(a.a, b.a, t);
+  let lin = mix(filmLinear(a), filmLinear(b), t);
+  let rgb = select(vec3f(0.0), filmEncode(lin / max(alpha, 1e-6)) * alpha, alpha > 0.0);
+  return vec4f(rgb, alpha);
+}`,
+  packUniforms: (progress, width, height) => new Float32Array([progress, width, height, 0]),
+}
+
+export const crossZoom: GpuTransitionDefinition = {
+  id: 'crossZoom',
+  name: 'Cross Zoom',
+  category: 'motion',
+  hasDirection: false,
+  entryPoint: 'crossZoomFragment',
+  uniformSize: 16,
+  shader: /* wgsl */ `
+struct CrossZoomParams {
+  progress: f32,
+  width: f32,
+  height: f32,
+  strength: f32,
+};
+${BINDINGS}
+@group(0) @binding(3) var<uniform> params: CrossZoomParams;
+
+@fragment
+fn crossZoomFragment(input: VertexOutput) -> @location(0) vec4f {
+  let uv = input.uv;
+  let p = clamp(params.progress, 0.0, 1.0);
+  let s = params.strength;
+  let blur = s * sin(p * PI);
+  let zoomA = 1.0 + 2.0 * s * p;
+  let zoomB = 1.0 + 2.0 * s * (1.0 - p);
+  let centre = vec2f(0.5, 0.5);
+  var a = vec4f(0.0);
+  var b = vec4f(0.0);
+  for (var i = 0u; i < 12u; i++) {
+    let k = 1.0 - blur * (f32(i) / 11.0);
+    a += textureSampleLevel(leftTex, texSampler, centre + (uv - centre) * (k / zoomA), 0.0);
+    b += textureSampleLevel(rightTex, texSampler, centre + (uv - centre) * (k / zoomB), 0.0);
+  }
+  let m = p * p * (3.0 - 2.0 * p);
+  return mix(a / 12.0, b / 12.0, m);
+}`,
+  packUniforms: (progress, width, height, _direction, properties) => {
+    const strength = properties?.strength
+    return new Float32Array([
+      progress,
+      width,
+      height,
+      typeof strength === 'number' && Number.isFinite(strength) ? strength : 0.4,
+    ])
+  },
+}
+
+export const cubeSpin: GpuTransitionDefinition = {
+  id: 'cubeSpin',
+  name: 'Cube Spin',
+  category: 'flip',
+  hasDirection: true,
+  directions: ['from-left', 'from-right', 'from-top', 'from-bottom'],
+  entryPoint: 'cubeSpinFragment',
+  uniformSize: 16,
+  shader: /* wgsl */ `
+struct CubeSpinParams {
+  progress: f32,
+  width: f32,
+  height: f32,
+  direction: f32,
+};
+${BINDINGS}
+@group(0) @binding(3) var<uniform> params: CubeSpinParams;
+
+const CUBE_EYE: f32 = 3.0;
+
+// Distance along the ray to a face with centre c, normal n and right axis r; the face's
+// local coordinates are returned in yz, and x is a large number when the face is missed.
+fn cubeFace(ray: vec3f, c: vec3f, n: vec3f, r: vec3f) -> vec3f {
+  let eye = vec3f(0.0, 0.0, CUBE_EYE);
+  let denom = dot(ray, n);
+  let t = select(1e9, dot(c - eye, n) / denom, denom < 0.0);
+  let hit = eye + ray * t;
+  let ls = dot(hit - c, r);
+  let lo = hit.y - c.y;
+  let inside = t > 0.0 && t < 1e8 && abs(ls) <= 1.0 && abs(lo) <= 1.0;
+  return vec3f(select(1e9, t, inside), ls, lo);
+}
+
+// Local face coordinates back to texture uv for the direction (inverse of the screen mapping).
+fn cubeUv(ls: f32, lo: f32, dir: u32) -> vec2f {
+  var x = ls;
+  var y = lo;
+  if (dir == 1u) { x = -ls; }
+  else if (dir == 2u) { x = lo; y = -ls; }
+  else if (dir == 3u) { x = lo; y = ls; }
+  return vec2f((x + 1.0) * 0.5, (1.0 - y) * 0.5);
+}
+
+@fragment
+fn cubeSpinFragment(input: VertexOutput) -> @location(0) vec4f {
+  let uv = input.uv;
+  let dir = u32(params.direction);
+  let x = uv.x * 2.0 - 1.0;
+  let y = 1.0 - uv.y * 2.0;
+  var s = x;
+  var o = y;
+  if (dir == 1u) { s = -x; }
+  else if (dir == 2u) { s = -y; o = x; }
+  else if (dir == 3u) { s = y; o = x; }
+  let theta = clamp(params.progress, 0.0, 1.0) * PI * 0.5;
+  let cs = cos(theta);
+  let sn = sin(theta);
+  let ray = vec3f(s, o, -CUBE_EYE);
+  let centre = vec3f(0.0, 0.0, -1.0);
+  let nA = vec3f(sn, 0.0, cs);
+  let nB = vec3f(-cs, 0.0, sn);
+  let fa = cubeFace(ray, centre + nA, nA, vec3f(cs, 0.0, -sn));
+  let fb = cubeFace(ray, centre + nB, nB, vec3f(sn, 0.0, cs));
+  let a = textureSampleLevel(leftTex, texSampler, cubeUv(fa.y, fa.z, dir), 0.0);
+  let b = textureSampleLevel(rightTex, texSampler, cubeUv(fb.y, fb.z, dir), 0.0);
+  let black = vec4f(0.0, 0.0, 0.0, 1.0);
+  let hitA = fa.x < 1e8;
+  let hitB = fb.x < 1e8;
+  let useA = hitA && (!hitB || fa.x <= fb.x);
+  return select(select(black, b, hitB), a, useA);
+}`,
+  packUniforms: (progress, width, height, direction) =>
+    new Float32Array([progress, width, height, direction]),
+}
+
+export const pagePeel: GpuTransitionDefinition = {
+  id: 'pagePeel',
+  name: 'Page Peel',
+  category: 'wipe',
+  hasDirection: false,
+  entryPoint: 'pagePeelFragment',
+  uniformSize: 16,
+  shader: /* wgsl */ `
+struct PagePeelParams {
+  progress: f32,
+  width: f32,
+  height: f32,
+  _pad: f32,
+};
+${BINDINGS}
+@group(0) @binding(3) var<uniform> params: PagePeelParams;
+
+@fragment
+fn pagePeelFragment(input: VertexOutput) -> @location(0) vec4f {
+  let uv = input.uv;
+  let p = clamp(params.progress, 0.0, 1.0);
+  let aspect = params.width / max(params.height, 1.0);
+  let corner = vec2f(aspect, 1.0);
+  let len = length(corner);
+  let g = corner / len;
+  let f = p * len;
+  let w = 0.05 * len;
+  let pos = vec2f(uv.x * aspect, uv.y);
+  let s = dot(corner - pos, g);
+  let q = pos + 2.0 * (s - f) * g;
+  let qUv = vec2f(q.x / aspect, q.y);
+  let a = textureSampleLevel(leftTex, texSampler, uv, 0.0);
+  let b = textureSampleLevel(rightTex, texSampler, uv, 0.0);
+  let aq = textureSampleLevel(leftTex, texSampler, qUv, 0.0);
+  // Edges are anti-aliased over one pixel (px, in aspect-correct units) so no pixel centre
+  // sits on a hard boundary that GPUs could round either way.
+  let px = 1.0 / max(params.height, 1.0);
+  let live = select(0.0, 1.0, f > 0.0);
+  let peel = live * clamp((f - s) / px + 0.5, 0.0, 1.0);
+  let shadow = 0.35 * (1.0 - p) * (1.0 - clamp((f - s) / w, 0.0, 1.0));
+  let under = vec4f(b.rgb * (1.0 - shadow), b.a);
+  let base = mix(a, under, peel);
+  let outside = max(max(-q.x, q.x - aspect), max(-q.y, q.y - 1.0));
+  let inFrame = clamp(0.5 - outside / px, 0.0, 1.0);
+  let cover = live * clamp((s - f) / px + 0.5, 0.0, 1.0) * clamp((2.0 * f - s) / px + 0.5, 0.0, 1.0) * inFrame;
+  let shade = 0.85 + 0.15 * clamp((s - f) / w, 0.0, 1.0);
+  let flap = vec4f(mix(aq.rgb, vec3f(aq.a), 0.6) * shade, aq.a) * cover;
+  return flap + base * (1.0 - flap.a);
+}`,
+  packUniforms: (progress, width, height) => new Float32Array([progress, width, height, 0]),
+}
