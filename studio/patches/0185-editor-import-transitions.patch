diff --git a/src/shared/timeline/transitions/renderers/editor-import.ts b/src/shared/timeline/transitions/renderers/editor-import.ts
new file mode 100644
index 0000000..27f1418
--- /dev/null
+++ b/src/shared/timeline/transitions/renderers/editor-import.ts
@@ -0,0 +1,166 @@
+/**
+ * FL-1564: Film Dissolve, Cross Zoom, Cube Spin and Page Peel.
+ *
+ * Each draws with its WebGPU shader (src/infrastructure/gpu-transitions/transitions/editor-import.ts),
+ * which is the contract (studio/spec/transitions). The Canvas 2D fallbacks below are only used
+ * without WebGPU and approximate the shader.
+ */
+
+import type { TransitionRegistry, TransitionRenderer } from '../registry'
+import type { TransitionDefinition, WipeDirection } from '@/types/transition'
+import { clamp01, getNumericProperty } from './gpu'
+
+const ALL_TIMINGS = ['linear', 'ease-in', 'ease-out', 'ease-in-out', 'cubic-bezier'] as const
+const ALL_DIRECTIONS: WipeDirection[] = ['from-left', 'from-right', 'from-top', 'from-bottom']
+
+const filmDissolveRenderer: TransitionRenderer = {
+  gpuTransitionId: 'filmDissolve',
+  renderCanvas(ctx, leftCanvas, rightCanvas, progress, _direction, canvas) {
+    const w = canvas?.width ?? leftCanvas.width
+    const h = canvas?.height ?? leftCanvas.height
+    ctx.drawImage(leftCanvas, 0, 0, w, h)
+    ctx.save()
+    ctx.globalAlpha = clamp01(progress)
+    ctx.drawImage(rightCanvas, 0, 0, w, h)
+    ctx.restore()
+  },
+}
+
+const filmDissolveDef: TransitionDefinition = {
+  id: 'filmDissolve',
+  label: 'Film Dissolve',
+  description: 'Dissolve that mixes the clips in linear light, as film does',
+  category: 'dissolve',
+  icon: 'Film',
+  hasDirection: false,
+  supportedTimings: [...ALL_TIMINGS],
+  defaultDuration: 30,
+  minDuration: 10,
+  maxDuration: 90,
+}
+
+const crossZoomRenderer: TransitionRenderer = {
+  gpuTransitionId: 'crossZoom',
+  renderCanvas(ctx, leftCanvas, rightCanvas, progress, _direction, canvas, properties) {
+    const p = clamp01(progress)
+    const w = canvas?.width ?? leftCanvas.width
+    const h = canvas?.height ?? leftCanvas.height
+    const strength = getNumericProperty(properties, 'strength', 0.4)
+    const drawZoomed = (source: OffscreenCanvas, zoom: number, alpha: number) => {
+      ctx.save()
+      ctx.globalAlpha = alpha
+      ctx.drawImage(source, (w - w * zoom) / 2, (h - h * zoom) / 2, w * zoom, h * zoom)
+      ctx.restore()
+    }
+    const m = p * p * (3 - 2 * p)
+    drawZoomed(leftCanvas, 1 + 2 * strength * p, 1)
+    drawZoomed(rightCanvas, 1 + 2 * strength * (1 - p), m)
+  },
+}
+
+const crossZoomDef: TransitionDefinition = {
+  id: 'crossZoom',
+  label: 'Cross Zoom',
+  description: 'Zooms into the outgoing clip and out of the incoming one with a radial blur',
+  category: 'motion',
+  icon: 'CircleDot',
+  hasDirection: false,
+  supportedTimings: [...ALL_TIMINGS],
+  defaultDuration: 24,
+  minDuration: 8,
+  maxDuration: 72,
+  parameters: [
+    {
+      key: 'strength',
+      label: 'Strength',
+      type: 'number',
+      defaultValue: 0.4,
+      min: 0,
+      max: 1,
+      step: 0.05,
+      description: 'How far the clips zoom and blur',
+    },
+  ],
+}
+
+const cubeSpinRenderer: TransitionRenderer = {
+  gpuTransitionId: 'cubeSpin',
+  renderCanvas(ctx, leftCanvas, rightCanvas, progress, direction, canvas) {
+    const p = clamp01(progress)
+    const w = canvas?.width ?? leftCanvas.width
+    const h = canvas?.height ?? leftCanvas.height
+    const dir = (direction as WipeDirection) || 'from-left'
+    ctx.fillStyle = '#000'
+    ctx.fillRect(0, 0, w, h)
+    // Flat approximation: the incoming face grows from its side while the outgoing one shrinks.
+    if (dir === 'from-left' || dir === 'from-right') {
+      const split = dir === 'from-left' ? w * p : w * (1 - p)
+      const [bx, bw, ax, aw] =
+        dir === 'from-left' ? [0, split, split, w - split] : [split, w - split, 0, split]
+      if (bw > 0) ctx.drawImage(rightCanvas, bx, 0, bw, h)
+      if (aw > 0) ctx.drawImage(leftCanvas, ax, 0, aw, h)
+    } else {
+      const split = dir === 'from-top' ? h * p : h * (1 - p)
+      const [by, bh, ay, ah] =
+        dir === 'from-top' ? [0, split, split, h - split] : [split, h - split, 0, split]
+      if (bh > 0) ctx.drawImage(rightCanvas, 0, by, w, bh)
+      if (ah > 0) ctx.drawImage(leftCanvas, 0, ay, w, ah)
+    }
+  },
+}
+
+const cubeSpinDef: TransitionDefinition = {
+  id: 'cubeSpin',
+  label: 'Cube Spin',
+  description: 'Turns the picture like the side of a cube to reveal the next clip',
+  category: 'flip',
+  icon: 'RotateCw',
+  hasDirection: true,
+  directions: ALL_DIRECTIONS,
+  supportedTimings: [...ALL_TIMINGS],
+  defaultDuration: 30,
+  minDuration: 10,
+  maxDuration: 90,
+}
+
+const pagePeelRenderer: TransitionRenderer = {
+  gpuTransitionId: 'pagePeel',
+  renderCanvas(ctx, leftCanvas, rightCanvas, progress, _direction, canvas) {
+    const p = clamp01(progress)
+    const w = canvas?.width ?? leftCanvas.width
+    const h = canvas?.height ?? leftCanvas.height
+    ctx.drawImage(leftCanvas, 0, 0, w, h)
+    // Flat approximation: the corner triangle (w - x) * w + (h - y) * h < p * (w² + h²) shows
+    // the next clip; the fold's flap is not drawn.
+    const reach = p * (w * w + h * h)
+    ctx.save()
+    ctx.beginPath()
+    ctx.moveTo(w, h)
+    ctx.lineTo(w - reach / w, h)
+    ctx.lineTo(w, h - reach / h)
+    ctx.closePath()
+    ctx.clip()
+    ctx.drawImage(rightCanvas, 0, 0, w, h)
+    ctx.restore()
+  },
+}
+
+const pagePeelDef: TransitionDefinition = {
+  id: 'pagePeel',
+  label: 'Page Peel',
+  description: 'The picture peels from the corner like a page to reveal the next clip',
+  category: 'wipe',
+  icon: 'Layers',
+  hasDirection: false,
+  supportedTimings: [...ALL_TIMINGS],
+  defaultDuration: 30,
+  minDuration: 10,
+  maxDuration: 90,
+}
+
+export function registerEditorImportTransitions(registry: TransitionRegistry): void {
+  registry.register('filmDissolve', filmDissolveDef, filmDissolveRenderer)
+  registry.register('crossZoom', crossZoomDef, crossZoomRenderer)
+  registry.register('cubeSpin', cubeSpinDef, cubeSpinRenderer)
+  registry.register('pagePeel', pagePeelDef, pagePeelRenderer)
+}
