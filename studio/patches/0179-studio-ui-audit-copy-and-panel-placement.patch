+  useTimelineSettingsStore.getState().setFps(30)
+  // The inspector is keyed by selection, so the panel mounts again for the chosen clip.
+  function Keyed() {
+    const ids = useSelectionStore((state) => state.selectedItemIds)
+    return <CaptionQualityPanel key={ids.join(',')} />
+  }
+  const ui = render(<Keyed />)
+  fireEvent.click(ui.getByRole('button', { name: /Caption quality/ }))
+  fireEvent.click(ui.getAllByRole('button').find((button) => button.getAttribute('aria-label'))!)
+  expect(useSelectionStore.getState().selectedItemIds).toEqual([item.id])
+  expect(ui.getByTestId('caption-quality-panel')).toBeInTheDocument()
+  cleanup()
+  // A panel mounted later starts closed again.
+  const later = render(<CaptionQualityPanel />)
+  expect(later.queryByTestId('caption-quality-panel')).not.toBeInTheDocument()
+})
