@@ -0,0 +1,447 @@
+/**
+ * Edit a clip by its transcript (Frameleaf FL-562): the pure model.
+ *
+ * One clip's words (and the silences found in its sound) are laid out in source order. Whether a
+ * word is still in the movie is read from the timeline itself: a word is cut when the middle of
+ * its source span is no longer covered by any piece of the clip. So Studio's normal undo and redo,
+ * a reopened project and edits made elsewhere all keep the transcript right.
+ *
+ * A "piece" is one timeline item made from the clip: splitting a clip keeps its `originId`, so
+ * every piece of a cut clip shares it. The holes between pieces, in source time, are the cuts;
+ * each crossed-out word belongs to exactly one of them, and bringing a word back restores that cut.
+ *
+ * Nothing here reads a store, so it is unit-tested directly.
+ */
+
+import type { TimelineItem } from '@/types/timeline'
+import type { MediaTranscript, MediaTranscriptSpeakers } from '@/types/storage'
+import { joinTranscriptWords } from '@/shared/utils/transcript-text'
+import { getItemSourceSpanSeconds } from './media-item-frames'
+import type { SourceRange } from './source-range-intervals'
+
+/** Source seconds within which two edges count as the same point (one 60 fps frame is 0.0167). */
+const EDGE_TOLERANCE_SECONDS = 0.02
+/** A pause of this length or more starts a new paragraph. */
+const PARAGRAPH_GAP_SECONDS = 0.6
+const PARAGRAPH_SOFT_MAX_WORDS = 28
+const PARAGRAPH_HARD_MAX_WORDS = 40
+const SENTENCE_END = /[.?!]["')\]]?$/
+
+export interface TranscriptPiece {
+  id: string
+  trackId: string
+  /** Timeline frame where the piece starts. */
+  from: number
+  durationInFrames: number
+  speed: number
+  /** Source seconds the piece shows. */
+  start: number
+  end: number
+}
+
+export interface TranscriptDocWord {
+  kind: 'word'
+  key: string
+  segmentIndex: number
+  wordIndex: number
+  text: string
+  start: number
+  end: number
+  filler: boolean
+}
+
+export interface TranscriptDocSilence {
+  kind: 'silence'
+  key: string
+  start: number
+  end: number
+}
+
+export type TranscriptDocEntry = TranscriptDocWord | TranscriptDocSilence
+
+export type PlacedTranscriptEntry = TranscriptDocEntry & {
+  /** Timeline frame where the entry plays now, or null once it is cut. */
+  frame: number | null
+  /** Timeline frame where the entry ends, or null once it is cut. */
+  endFrame: number | null
+  removed: boolean
+}
+
+export interface TranscriptParagraph {
+  key: string
+  speaker: number
+  /** Indices into the placed entry list. */
+  indices: number[]
+}
+
+export type TranscriptBlock =
+  | { kind: 'paragraph'; paragraph: TranscriptParagraph }
+  | { kind: 'silence'; index: number }
+
+/** Plan for bringing one cut back with existing timeline edits (ripple trim, then join). */
+export type TranscriptRestorePlan =
+  | { handle: 'end'; itemId: string; frames: number; joinWithId: string | null }
+  | { handle: 'start'; itemId: string; frames: number; joinWithId: null }
+
+const midpoint = (range: SourceRange) => (range.start + range.end) / 2
+
+/** The timeline items a clip with speech plays through: video pieces, or audio when it has none. */
+export function transcriptPieces(
+  items: readonly TimelineItem[],
+  originId: string,
+  mediaId: string,
+  timelineFps: number,
+): TranscriptPiece[] {
+  const candidates = items.filter(
+    (item) =>
+      (item.type === 'video' || item.type === 'audio') &&
+      item.mediaId === mediaId &&
+      item.isReversed !== true &&
+      (item.originId ?? item.id) === originId,
+  )
+  const hasVideo = candidates.some((item) => item.type === 'video')
+  return candidates
+    .filter((item) => (hasVideo ? item.type === 'video' : item.type === 'audio'))
+    .flatMap((item) => {
+      const span = getItemSourceSpanSeconds(item, timelineFps)
+      if (!span || span.end <= span.start) return []
+      const speed = item.type === 'video' || item.type === 'audio' ? (item.speed ?? 1) : 1
+      return [
+        {
+          id: item.id,
+          trackId: item.trackId,
+          from: item.from,
+          durationInFrames: item.durationInFrames,
+          speed,
+          start: span.start,
+          end: span.end,
+        },
+      ]
+    })
+    .toSorted((left, right) => left.start - right.start)
+}
+
+/** Source span from the first piece to the last, widened by `remembered` (cuts at either end). */
+export function transcriptExtent(
+  pieces: readonly TranscriptPiece[],
+  remembered?: SourceRange | null,
+): SourceRange | null {
+  if (pieces.length === 0) return remembered ?? null
+  const start = Math.min(...pieces.map((piece) => piece.start), remembered?.start ?? Infinity)
+  const end = Math.max(...pieces.map((piece) => piece.end), remembered?.end ?? -Infinity)
+  return { start, end }
+}
+
+/** Where a moment of the source plays on the timeline now, or null when it is cut. */
+export function sourceTimeToFrame(
+  pieces: readonly TranscriptPiece[],
+  seconds: number,
+  timelineFps: number,
+): number | null {
+  for (const piece of pieces) {
+    if (seconds < piece.start - 1e-6 || seconds > piece.end + 1e-6) continue
+    return Math.round(piece.from + ((seconds - piece.start) * timelineFps) / piece.speed)
+  }
+  return null
+}
+
+/** The cuts: parts of the extent that no piece covers, in source order. */
+export function transcriptCuts(
+  pieces: readonly TranscriptPiece[],
+  extent: SourceRange | null,
+): SourceRange[] {
+  if (!extent) return []
+  const cuts: SourceRange[] = []
+  let cursor = extent.start
+  for (const piece of pieces) {
+    if (piece.start - cursor > EDGE_TOLERANCE_SECONDS)
+      cuts.push({ start: cursor, end: piece.start })
+    cursor = Math.max(cursor, piece.end)
+  }
+  if (extent.end - cursor > EDGE_TOLERANCE_SECONDS) cuts.push({ start: cursor, end: extent.end })
+  return cuts
+}
+
+/** The cut a crossed-out entry belongs to. */
+export function cutForEntry(cuts: readonly SourceRange[], entry: SourceRange): SourceRange | null {
+  const middle = midpoint(entry)
+  return cuts.find((cut) => middle >= cut.start - 1e-6 && middle <= cut.end + 1e-6) ?? null
+}
+
+/** Every word of the transcript, in source order, marked when it is a filler. */
+export function transcriptWords(
+  transcript: MediaTranscript,
+  fillerRanges: readonly SourceRange[] = [],
+): TranscriptDocWord[] {
+  const words: TranscriptDocWord[] = []
+  transcript.segments.forEach((segment, segmentIndex) => {
+    segment.words?.forEach((word, wordIndex) => {
+      const text = word.text.trim()
+      if (!text || !(word.end > word.start)) return
+      const middle = (word.start + word.end) / 2
+      words.push({
+        kind: 'word',
+        key: `w:${segmentIndex}:${wordIndex}`,
+        segmentIndex,
+        wordIndex,
+        text,
+        start: word.start,
+        end: word.end,
+        filler: fillerRanges.some((range) => middle >= range.start && middle <= range.end),
+      })
+    })
+  })
+  return words.toSorted((left, right) => left.start - right.start)
+}
+
+/**
+ * Words and silences of the clip's extent, each with its place on the timeline. Silences are the
+ * ranges silence removal found; one inside a word's span is dropped.
+ */
+export function placeTranscriptEntries(
+  words: readonly TranscriptDocWord[],
+  silences: readonly SourceRange[],
+  pieces: readonly TranscriptPiece[],
+  extent: SourceRange | null,
+  timelineFps: number,
+): PlacedTranscriptEntry[] {
+  if (!extent) return []
+  const inside = (range: SourceRange) => range.end > extent.start && range.start < extent.end
+  const entries: TranscriptDocEntry[] = [
+    ...words.filter(inside),
+    ...silences
+      .filter(inside)
+      .filter(
+        (silence) => !words.some((word) => word.start < silence.start && word.end > silence.end),
+      )
+      .map((silence) => ({
+        kind: 'silence' as const,
+        key: `s:${silence.start.toFixed(3)}`,
+        start: silence.start,
+        end: silence.end,
+      })),
+  ]
+  return entries
+    .toSorted((left, right) => left.start - right.start || (left.kind === 'silence' ? 1 : -1))
+    .map((entry) => {
+      const middle = sourceTimeToFrame(pieces, midpoint(entry), timelineFps)
+      const frame =
+        middle === null ? null : (sourceTimeToFrame(pieces, entry.start, timelineFps) ?? middle)
+      const endFrame =
+        middle === null ? null : (sourceTimeToFrame(pieces, entry.end, timelineFps) ?? middle + 1)
+      return { ...entry, frame, endFrame, removed: middle === null }
+    })
+}
+
+/** Speaker number at a moment of the source (speaker 0 until the first change). */
+export function speakerAt(speakers: MediaTranscriptSpeakers | undefined, seconds: number): number {
+  let speaker = 0
+  for (const turn of speakers?.turns ?? []) {
+    if (turn.start <= seconds + 1e-6) speaker = turn.speaker
+    else break
+  }
+  return speaker
+}
+
+/** Split the entries into speaker paragraphs and silence chips, in reading order. */
+export function transcriptBlocks(
+  entries: readonly PlacedTranscriptEntry[],
+  speakers: MediaTranscriptSpeakers | undefined,
+): TranscriptBlock[] {
+  const blocks: TranscriptBlock[] = []
+  let current: TranscriptParagraph | null = null
+  let previousWord: PlacedTranscriptEntry | null = null
+
+  entries.forEach((entry, index) => {
+    if (entry.kind === 'silence') {
+      blocks.push({ kind: 'silence', index })
+      current = null
+      return
+    }
+    const speaker = speakerAt(speakers, entry.start)
+    const count = current?.indices.length ?? 0
+    const breaks =
+      !current ||
+      current.speaker !== speaker ||
+      (!!previousWord && entry.start - previousWord.end >= PARAGRAPH_GAP_SECONDS) ||
+      (count >= PARAGRAPH_SOFT_MAX_WORDS &&
+        !!previousWord &&
+        SENTENCE_END.test(previousWord.kind === 'word' ? previousWord.text : '')) ||
+      count >= PARAGRAPH_HARD_MAX_WORDS
+    if (breaks) {
+      current = { key: entry.key, speaker, indices: [index] }
+      blocks.push({ kind: 'paragraph', paragraph: current })
+    } else {
+      current!.indices.push(index)
+    }
+    previousWord = entry
+  })
+  return blocks
+}
+
+/** Display name of a speaker: the name they were given, or the numbered default. */
+export function speakerName(
+  speakers: MediaTranscriptSpeakers | undefined,
+  speaker: number,
+  numbered: (number: number) => string,
+): string {
+  const name = speakers?.names?.[String(speaker)]?.trim()
+  return name ? name : numbered(speaker + 1)
+}
+
+/** Every speaker number used, plus the next free one. */
+export function speakerNumbers(speakers: MediaTranscriptSpeakers | undefined): {
+  used: number[]
+  next: number
+} {
+  const used = new Set<number>([0])
+  for (const turn of speakers?.turns ?? []) used.add(turn.speaker)
+  for (const key of Object.keys(speakers?.names ?? {})) {
+    const value = Number(key)
+    if (Number.isInteger(value) && value >= 0) used.add(value)
+  }
+  const sorted = [...used].toSorted((left, right) => left - right)
+  return { used: sorted, next: (sorted.at(-1) ?? 0) + 1 }
+}
+
+/** Give a speaker a name (an empty name goes back to "Speaker n"). */
+export function renameSpeaker(
+  speakers: MediaTranscriptSpeakers | undefined,
+  speaker: number,
+  name: string,
+): MediaTranscriptSpeakers {
+  const names = { ...speakers?.names }
+  const trimmed = name.trim()
+  if (trimmed) names[String(speaker)] = trimmed
+  else delete names[String(speaker)]
+  return { names, turns: [...(speakers?.turns ?? [])] }
+}
+
+/**
+ * Say who speaks one paragraph: `[start, nextStart)` in source seconds. The paragraph after it
+ * keeps its own speaker. Turns that change nothing are dropped.
+ */
+export function setParagraphSpeaker(
+  speakers: MediaTranscriptSpeakers | undefined,
+  start: number,
+  nextStart: number | null,
+  speaker: number,
+): MediaTranscriptSpeakers {
+  const after = nextStart === null ? null : speakerAt(speakers, nextStart)
+  const turns = (speakers?.turns ?? []).filter(
+    (turn) =>
+      Math.abs(turn.start - start) > 1e-6 &&
+      !(nextStart !== null && Math.abs(turn.start - nextStart) <= 1e-6),
+  )
+  turns.push({ start, speaker })
+  if (nextStart !== null && after !== null) turns.push({ start: nextStart, speaker: after })
+  const sorted = turns.toSorted((left, right) => left.start - right.start)
+  const normalized: MediaTranscriptSpeakers['turns'] = []
+  let effective = 0
+  for (const turn of sorted) {
+    if (turn.speaker === effective) continue
+    normalized.push(turn)
+    effective = turn.speaker
+  }
+  return { names: { ...speakers?.names }, turns: normalized }
+}
+
+/**
+ * Source ranges to cut for a selection: runs of entries still in the movie, joined across the
+ * pauses between them and split where an entry is already cut.
+ */
+export function selectionRanges(entries: readonly PlacedTranscriptEntry[]): SourceRange[] {
+  const ranges: SourceRange[] = []
+  let run: SourceRange | null = null
+  for (const entry of entries) {
+    if (entry.removed) {
+      run = null
+      continue
+    }
+    if (run) run.end = Math.max(run.end, entry.end)
+    else {
+      run = { start: entry.start, end: entry.end }
+      ranges.push(run)
+    }
+  }
+  return ranges
+}
+
+/** Seconds of the movie a set of source ranges takes up on these pieces. */
+export function timelineSecondsOf(
+  ranges: readonly SourceRange[],
+  pieces: readonly TranscriptPiece[],
+): number {
+  let seconds = 0
+  for (const range of ranges) {
+    for (const piece of pieces) {
+      const overlap = Math.min(range.end, piece.end) - Math.max(range.start, piece.start)
+      if (overlap > 0) seconds += overlap / piece.speed
+    }
+  }
+  return seconds
+}
+
+/** Ranges that are still (mostly) in the movie, for "Remove silences" and "Remove filler words". */
+export function liveRanges<T extends SourceRange>(
+  ranges: readonly T[],
+  pieces: readonly TranscriptPiece[],
+  timelineFps: number,
+): T[] {
+  return ranges.filter((range) => sourceTimeToFrame(pieces, midpoint(range), timelineFps) !== null)
+}
+
+/**
+ * How to bring a cut back: extend the piece before it over the cut with a ripple trim, then join
+ * it to the piece after it; or, for a cut at the very start, extend the piece after it backwards.
+ */
+export function planCutRestore(
+  pieces: readonly TranscriptPiece[],
+  cut: SourceRange,
+  timelineFps: number,
+): TranscriptRestorePlan | null {
+  const before = pieces.find((piece) => Math.abs(piece.end - cut.start) <= EDGE_TOLERANCE_SECONDS)
+  const after = pieces.find((piece) => Math.abs(piece.start - cut.end) <= EDGE_TOLERANCE_SECONDS)
+  if (before) {
+    const frames = Math.round(((cut.end - cut.start) * timelineFps) / before.speed)
+    if (frames <= 0) return null
+    const adjacent =
+      !!after &&
+      after.trackId === before.trackId &&
+      after.speed === before.speed &&
+      after.from === before.from + before.durationInFrames
+    return { handle: 'end', itemId: before.id, frames, joinWithId: adjacent ? after.id : null }
+  }
+  if (after) {
+    const frames = Math.round(((cut.end - cut.start) * timelineFps) / after.speed)
+    if (frames <= 0) return null
+    return { handle: 'start', itemId: after.id, frames, joinWithId: null }
+  }
+  return null
+}
+
+/** The transcript with one word corrected; the segment and full text follow the word. */
+export function correctTranscriptWord(
+  transcript: MediaTranscript,
+  segmentIndex: number,
+  wordIndex: number,
+  text: string,
+): MediaTranscript | null {
+  const next = text.trim()
+  const segment = transcript.segments[segmentIndex]
+  const word = segment?.words?.[wordIndex]
+  if (!segment || !word || !next || next === word.text.trim()) return null
+  const words = segment.words!.map((item, index) =>
+    index === wordIndex ? { ...item, text: next } : item,
+  )
+  const segments = transcript.segments.map((item, index) =>
+    index === segmentIndex
+      ? { ...item, words, text: joinTranscriptWords(words.map((entry) => entry.text.trim())) }
+      : item,
+  )
+  return {
+    ...transcript,
+    segments,
+    text: joinTranscriptWords(segments.map((item) => item.text)),
+  }
+}
