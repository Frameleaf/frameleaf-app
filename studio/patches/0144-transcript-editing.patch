+    expect(entries.find((entry) => entry.kind === 'word' && entry.text === 'this')!.frame).toBe(36)
+    expect(transcriptCuts(cutPieces, extent)).toEqual([{ start: 1, end: 1.3 }])
+    expect(cutForEntry(transcriptCuts(cutPieces, extent), um)).toEqual({ start: 1, end: 1.3 })
