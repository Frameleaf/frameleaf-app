+      // Music with sync lock off stays put, as with any ripple delete.
+      track('music-track', 'audio', 2, false),
+    ])
+    useItemsStore.getState().setItems([video(), audio(), music()])
+    useTransitionsStore.getState().setTransitions([])
+    useKeyframesStore.getState().setKeyframes([])
+    useSelectionStore.getState().clearSelection()
+  })
+
+  it('cuts selected words with split and ripple delete, picture and sound together', () => {
+    const before = document()
+    // Select "um, this" and cut it.
+    const selection = before.entries.slice(1, 3)
+    const ranges = selectionRanges(selection)
+    expect(ranges).toEqual([{ start: 1, end: 1.8 }])
+    removeTranscriptRangesFromItems(
+      before.pieces.map((p) => p.id),
+      { 'media-1': ranges },
+    )
+
+    const expected = [
+      { from: 0, durationInFrames: 30, sourceStart: 0, sourceEnd: 30 },
+      { from: 30, durationInFrames: 246, sourceStart: 54, sourceEnd: 300 },
+    ]
+    expect(spans('video')).toEqual(expected)
+    expect(spans('audio', 'audio-track')).toEqual(expected)
+    // Music on its own track stays where it was.
+    expect(spans('audio', 'music-track')).toEqual([
+      { from: 0, durationInFrames: 300, sourceStart: 0, sourceEnd: 300 },
+    ])
+    expect(useTimelineCommandStore.getState().undoStack).toHaveLength(1)
+
+    const after = document(before.extent)
+    expect(word(after.entries, 'um,').removed).toBe(true)
+    expect(word(after.entries, 'this').removed).toBe(true)
+    expect(word(after.entries, 'is').removed).toBe(false)
+    // "is" (1.9 s in the file) now plays at 1.1 s in the movie.
+    expect(word(after.entries, 'is').frame).toBe(33)
+  })
+
+  it('Studio undo puts the words back', () => {
+    const before = document()
+    removeTranscriptRangesFromItems(
+      before.pieces.map((p) => p.id),
+      { 'media-1': [{ start: 1, end: 1.3 }] },
+    )
+    useTimelineCommandStore.getState().undo()
+    expect(useItemsStore.getState().items).toEqual([video(), audio(), music()])
+    expect(word(document(before.extent).entries, 'um,').removed).toBe(false)
+  })
+
+  it('clicking a crossed-out word brings that cut back on its own, as one undo step', () => {
+    const before = document()
+    const ids = before.pieces.map((p) => p.id)
+    removeTranscriptRangesFromItems(ids, { 'media-1': [{ start: 1, end: 1.3 }] })
+    removeTranscriptRangesFromItems(
+      document(before.extent).pieces.map((p) => p.id),
+      { 'media-1': [{ start: 2.2, end: 2.4 }] },
+    )
+    expect(spans('video')).toHaveLength(3)
+
+    const cut = document(before.extent)
+    const um = word(cut.entries, 'um,')
+    const plan = planCutRestore(cut.pieces, cutForEntry(cut.cuts, um)!, 30)!
+    expect(plan).toMatchObject({ handle: 'end', frames: 9 })
+    const historyBefore = useTimelineCommandStore.getState().undoStack.length
+    expect(restoreTranscriptCut(plan)).toBe(true)
+
+    const restored = document(before.extent)
+    expect(word(restored.entries, 'um,').removed).toBe(false)
+    // The other cut ("the") is still cut.
+    expect(word(restored.entries, 'the').removed).toBe(true)
+    expect(spans('video')).toEqual([
+      { from: 0, durationInFrames: 66, sourceStart: 0, sourceEnd: 66 },
+      { from: 66, durationInFrames: 228, sourceStart: 72, sourceEnd: 300 },
+    ])
+    expect(spans('audio', 'audio-track')).toEqual(spans('video'))
+    expect(useTimelineCommandStore.getState().undoStack).toHaveLength(historyBefore + 1)
+    expect(useTimelineCommandStore.getState().getLastCommandType()).toBe('RESTORE_TRANSCRIPT_CUT')
+
+    // One undo takes the whole restore back.
+    useTimelineCommandStore.getState().undo()
+    expect(word(document(before.extent).entries, 'um,').removed).toBe(true)
+    expect(spans('video')).toHaveLength(3)
+  })
+
+  it('brings back a cut at the start of the clip', () => {
+    const before = document()
+    removeTranscriptRangesFromItems(['video-1'], { 'media-1': [{ start: 0, end: 0.95 }] })
+    const cut = document(before.extent)
+    expect(word(cut.entries, 'Okay,').removed).toBe(true)
+    const plan = planCutRestore(cut.pieces, cutForEntry(cut.cuts, word(cut.entries, 'Okay,'))!, 30)!
+    expect(plan.handle).toBe('start')
+    expect(restoreTranscriptCut(plan)).toBe(true)
+    expect(spans('video')).toEqual([
+      { from: 0, durationInFrames: 300, sourceStart: 0, sourceEnd: 300 },
+    ])
+  })
+
+  it('Remove filler words cuts every filler in one undo step with the shipped defaults', () => {
+    const fillers = detectFillerRangesFromTranscript(transcript, DEFAULT_FILLER_REMOVAL_SETTINGS)
+    expect(fillers.map((range) => range.text)).toEqual(['um,'])
+    const before = document()
+    const live = liveRanges(fillers, before.pieces, 30)
+    removeFillerWordsFromItems(
+      before.pieces.map((p) => p.id),
+      { 'media-1': live },
+    )
+    expect(word(document(before.extent).entries, 'um,').removed).toBe(true)
+    expect(useTimelineCommandStore.getState().getLastCommandType()).toBe('REMOVE_FILLER_WORDS')
+    expect(liveRanges(fillers, document(before.extent).pieces, 30)).toEqual([])
+    useTimelineCommandStore.getState().undo()
+    expect(useItemsStore.getState().items).toEqual([video(), audio(), music()])
+  })
+
+  it('Remove silences cuts the silences still in the clip in one undo step', () => {
+    const silences = [
+      { start: 3.1, end: 4.4 },
+      { start: 6, end: 7 },
+    ]
+    const before = document()
+    removeSilenceFromItems(
+      before.pieces.map((p) => p.id),
+      { 'media-1': liveRanges(silences, before.pieces, 30) },
+    )
+    expect(useTimelineCommandStore.getState().undoStack).toHaveLength(1)
+    const after = document(before.extent)
+    expect(liveRanges(silences, after.pieces, 30)).toEqual([])
+    expect(spans('video').reduce((sum, span) => sum + span.durationInFrames, 0)).toBe(300 - 39 - 30)
+  })
+})
