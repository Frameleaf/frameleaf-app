+vi.mock('../../utils/silence-removal-preview', async (importOriginal) => ({
+  ...(await importOriginal<typeof import('../../utils/silence-removal-preview')>()),
+  analyzeSilenceForItems: analyzeSilence,
+}))
+
+const transcript: MediaTranscript = {
+  id: 'media-1',
+  mediaId: 'media-1',
+  model: 'parakeet-tdt-v3',
+  quantization: 'hybrid',
+  text: 'Okay, um, this is the leak.',
+  segments: [
+    {
+      text: 'Okay, um, this is the leak.',
+      start: 0.5,
+      end: 3,
+      words: [
+        { text: 'Okay,', start: 0.5, end: 0.9 },
+        { text: 'um,', start: 1, end: 1.3 },
+        { text: 'this', start: 1.5, end: 1.8 },
+        { text: 'is', start: 1.9, end: 2.1 },
+        { text: 'the', start: 2.2, end: 2.4 },
+        { text: 'leak.', start: 2.5, end: 3 },
+      ],
+    },
+  ],
+  createdAt: 1,
+  updatedAt: 1,
+}
+
+const video = (): VideoItem => ({
+  id: 'video-1',
+  type: 'video',
+  trackId: 'video-track',
+  from: 0,
+  durationInFrames: 300,
+  label: 'Lake morning.mov',
+  src: 'blob:video',
+  mediaId: 'media-1',
+  originId: 'origin-1',
+  sourceStart: 0,
+  sourceEnd: 300,
+  sourceDuration: 300,
+  sourceFps: 30,
+})
+
+const word = (text: string) =>
+  screen.getByText(text, { selector: 'span[data-entry-index], del[data-entry-index]' })
+const totalFrames = () =>
+  useItemsStore.getState().items.reduce((sum, item) => sum + item.durationInFrames, 0)
+
+describe('TranscriptEditorPanel', () => {
+  beforeEach(() => {
+    useTimelineCommandStore.getState().clearHistory()
+    useTimelineSettingsStore.setState({ fps: 30, isDirty: false })
+    useEditorStore.setState({
+      linkedSelectionEnabled: true,
+      transcriptEditorShortcutScopeActive: false,
+    })
+    useItemsStore.getState().setTracks([])
+    useItemsStore.getState().setItems([video()])
+    useTransitionsStore.getState().setTransitions([])
+    useKeyframesStore.getState().setKeyframes([])
+    useSelectionStore.getState().clearSelection()
+    service.getTranscript.mockResolvedValue(transcript)
+    service.getTranscriptMediaIds.mockResolvedValue(new Set(['media-1']))
+    service.updateTranscript.mockImplementation(async (next: MediaTranscript) => ({
+      ...next,
+      updatedAt: 2,
+    }))
+    analyzeSilence.mockResolvedValue({
+      analyzedMediaIds: ['media-1'],
+      failedMediaIds: [],
+      rangesByMediaId: { 'media-1': [{ start: 3.2, end: 4.4 }] },
+    })
+  })
+  afterEach(() => {
+    cleanup()
+    vi.clearAllMocks()
+  })
+
+  it('opens on the clip with speech and shows its words, fillers and silences', async () => {
+    render(<TranscriptEditorPanel active />)
+    await waitFor(() => expect(word('leak.')).toBeTruthy())
+    expect(screen.getByText('Lake morning.mov')).toBeTruthy()
+    expect(screen.getByText('Speaker 1')).toBeTruthy()
+    expect(word('this').getAttribute('title')).toBe(
+      '0:01.5 in the movie. Double-click to correct the word.',
+    )
+    expect(screen.getByRole('button', { name: /Remove filler words \(1\)/ })).toBeTruthy()
+    await waitFor(() =>
+      expect(screen.getByRole('button', { name: /Remove silences \(1\)/ })).toBeTruthy(),
+    )
+    expect(screen.getByText('Silence · 1.2 s')).toBeTruthy()
+  })
+
+  it('cuts selected words with Delete, keeps them crossed out, and restores one by click', async () => {
+    render(<TranscriptEditorPanel active />)
+    await waitFor(() => expect(word('this')).toBeTruthy())
+
+    fireEvent.pointerDown(word('um,'), { button: 0, detail: 1 })
+    fireEvent.pointerDown(word('this'), { button: 0, detail: 1, shiftKey: true })
+    expect(screen.getByText('Selected: 2 · 0.8 s')).toBeTruthy()
+    fireEvent.keyDown(screen.getByRole('region'), { key: 'Delete' })
+
+    await waitFor(() => expect(word('um,').tagName).toBe('DEL'))
+    expect(word('this').tagName).toBe('DEL')
+    expect(totalFrames()).toBe(300 - 24)
+    expect(useTimelineCommandStore.getState().undoStack).toHaveLength(1)
+
+    // Clicking a crossed-out word brings its cut back.
+    fireEvent.pointerDown(word('um,'), { button: 0, detail: 1 })
+    await waitFor(() => expect(word('um,').tagName).toBe('SPAN'))
+    expect(word('this').tagName).toBe('SPAN')
+    expect(totalFrames()).toBe(300)
+    expect(useItemsStore.getState().items).toHaveLength(1)
+
+    // Studio undo takes the restore back, and undo again the cut.
+    act(() => useTimelineCommandStore.getState().undo())
+    await waitFor(() => expect(word('um,').tagName).toBe('DEL'))
+    act(() => useTimelineCommandStore.getState().undo())
+    await waitFor(() => expect(word('um,').tagName).toBe('SPAN'))
+  })
+
+  it('removes filler words with one click', async () => {
+    render(<TranscriptEditorPanel active />)
+    const button = await screen.findByRole('button', { name: /Remove filler words \(1\)/ })
+    fireEvent.click(button)
+    await waitFor(() => expect(word('um,').tagName).toBe('DEL'))
+    expect(useTimelineCommandStore.getState().getLastCommandType()).toBe('REMOVE_FILLER_WORDS')
+  })
+
+  it('removes silences with one click', async () => {
+    render(<TranscriptEditorPanel active />)
+    const button = await screen.findByRole('button', { name: /Remove silences \(1\)/ })
+    fireEvent.click(button)
+    await waitFor(() => expect(screen.getByText('Silence removed')).toBeTruthy())
+    expect(useTimelineCommandStore.getState().getLastCommandType()).toBe('REMOVE_SILENCE')
+  })
+
+  it('corrects a misheard word through the transcript service', async () => {
+    render(<TranscriptEditorPanel active />)
+    await waitFor(() => expect(word('leak.')).toBeTruthy())
+    fireEvent.doubleClick(word('leak.'))
+    const input = screen.getByLabelText('Correct word')
+    fireEvent.change(input, { target: { value: 'lake.' } })
+    fireEvent.keyDown(input, { key: 'Enter' })
+    await waitFor(() => expect(service.updateTranscript).toHaveBeenCalledTimes(1))
+    const [next, previous] = service.updateTranscript.mock.calls[0]!
+    expect(next.segments[0].text).toBe('Okay, um, this is the lake.')
+    expect(previous).toBe(transcript)
+    await waitFor(() => expect(word('lake.')).toBeTruthy())
+  })
+
+  it('asks for a clip with speech when the timeline has none', () => {
+    useItemsStore.getState().setItems([])
+    render(<TranscriptEditorPanel active />)
+    expect(
+      screen.getByText('Add a clip where people are talking to edit it by its words.'),
+    ).toBeTruthy()
+  })
+})
