+import { useItemsStore } from '../../items-store'
+import { useTimelineCommandStore } from '../../timeline-command-store'
+import { captureSnapshot } from '../../commands/snapshot'
+import type { TranscriptRestorePlan } from '../../../utils/transcript-document'
+import { joinItems } from './join-actions'
+import { rippleTrimItem } from './trim-actions'
+
+/**
+ * Bring back one transcript cut (Frameleaf FL-562) with the timeline's own edits: a ripple trim
+ * that extends the piece next to the cut over it (`clip.trimEnd` / `clip.trimStart` with ripple),
+ * then a join with the piece after it when they meet again (`clip.join`). The two edits are kept
+ * as one undo step, so Undo takes the whole restore back.
+ *
+ * Returns false when the trim could not be made (a locked track, or a clip at its source limit).
+ */
+export function restoreTranscriptCut(plan: TranscriptRestorePlan): boolean {
+  const before = captureSnapshot()
+  const history = useTimelineCommandStore.getState()
+  const priorEntries = new Set(history.undoStack)
+  const item = useItemsStore.getState().itemById[plan.itemId]
+  if (!item) return false
+  const priorDuration = item.durationInFrames
+
+  if (plan.handle === 'end') rippleTrimItem(plan.itemId, 'end', plan.frames)
+  else rippleTrimItem(plan.itemId, 'start', -plan.frames)
+
+  const trimmed = useItemsStore.getState().itemById[plan.itemId]
+  const extended = !!trimmed && trimmed.durationInFrames === priorDuration + plan.frames
+  if (extended && plan.joinWithId) {
+    const next = useItemsStore.getState().itemById[plan.joinWithId]
+    if (next && next.from === trimmed.from + trimmed.durationInFrames) {
+      joinItems([plan.itemId, plan.joinWithId])
+    }
+  }
+
+  // Fold the edits this restore made into one history entry.
+  const added = useTimelineCommandStore
+    .getState()
+    .undoStack.filter((entry) => !priorEntries.has(entry))
+  if (added.length > 0) {
+    useTimelineCommandStore.setState((state) => ({
+      undoStack: state.undoStack.filter((entry) => priorEntries.has(entry)),
+    }))
+    useTimelineCommandStore
+      .getState()
+      .addUndoEntry({ type: 'RESTORE_TRANSCRIPT_CUT', payload: { itemId: plan.itemId } }, before)
+  }
+  return extended
+}
