+import { describe, expect, it } from 'vite-plus/test'
+import type { MediaTranscriptSegment } from '@/types/storage'
+import type { SubtitleSegmentItem, TimelineItem } from '@/types/timeline'
+import {
+  correctPlacedTranscriptCaptions,
+  transcriptCaptionTextChanges,
+} from './media-transcription-service'
+
+/** FL-562: correcting a misheard word also corrects the captions made from that transcript. */
+
+const segments: MediaTranscriptSegment[] = [
+  {
+    text: 'We made it to the leak.',
+    start: 0,
+    end: 1.6,
+    words: [
+      { text: 'We', start: 0, end: 0.2 },
+      { text: 'made', start: 0.25, end: 0.5 },
+      { text: 'it', start: 0.55, end: 0.7 },
+      { text: 'to', start: 0.75, end: 0.9 },
+      { text: 'the', start: 0.95, end: 1.1 },
+      { text: 'leak.', start: 1.15, end: 1.6 },
+    ],
+  },
+  {
+    text: 'Look at the water.',
+    start: 2.5,
+    end: 3.6,
+    words: [
+      { text: 'Look', start: 2.5, end: 2.8 },
+      { text: 'at', start: 2.85, end: 3 },
+      { text: 'the', start: 3.05, end: 3.2 },
+      { text: 'water.', start: 3.25, end: 3.6 },
+    ],
+  },
+]
+
+const transcript = {
+  id: 'media-1',
+  mediaId: 'media-1',
+  model: 'parakeet-tdt-v3' as const,
+  quantization: 'hybrid' as const,
+  text: 'We made it to the leak. Look at the water.',
+  segments,
+  createdAt: 1,
+  updatedAt: 1,
+}
+
+const subtitle = (
+  id: string,
+  mediaId: string,
+  texts: string[],
+  type: 'transcript' | 'embedded-subtitles' = 'transcript',
+) =>
+  ({
+    id,
+    type: 'subtitle',
+    trackId: 'captions',
+    from: 0,
+    durationInFrames: 120,
+    label: 'Transcript',
+    source:
+      type === 'transcript'
+        ? { type, mediaId, clipId: 'clip-1' }
+        : { type, mediaId, clipId: 'clip-1', trackNumber: 1 },
+    cues: texts.map((text, index) => ({
+      id: `cue-${index}`,
+      startSeconds: index * 2,
+      endSeconds: index * 2 + 1,
+      text,
+    })),
+  }) as unknown as SubtitleSegmentItem
+
+describe('caption correction', () => {
+  // The panel corrected "leak." to "lake." (transcript-document correctTranscriptWord).
+  const corrected = {
+    ...transcript,
+    segments: [
+      {
+        ...segments[0]!,
+        text: 'We made it to the lake.',
+        words: segments[0]!.words!.map((word, index) =>
+          index === 5 ? { ...word, text: 'lake.' } : word,
+        ),
+      },
+      segments[1]!,
+    ],
+  }
+
+  it('maps the phrase that changed to its corrected text', () => {
+    const changes = transcriptCaptionTextChanges(transcript.segments, corrected.segments)
+    expect(changes.get('We made it to the leak.')).toBe('We made it to the lake.')
+    expect(changes.has('Look at the water.')).toBe(false)
+  })
+
+  it('rewrites matching cues of this transcript’s placed captions only', () => {
+    const changes = transcriptCaptionTextChanges(transcript.segments, corrected.segments)
+    const items = [
+      subtitle('captions-1', 'media-1', ['We made it to the leak.', 'Look at the water.']),
+      // Edited by hand: left alone.
+      subtitle('captions-2', 'media-1', ['We made it to the leak!!']),
+      // Another clip's transcript, and imported subtitles: left alone.
+      subtitle('captions-3', 'media-2', ['We made it to the leak.']),
+      subtitle('captions-4', 'media-1', ['We made it to the leak.'], 'embedded-subtitles'),
+    ] as TimelineItem[]
+    const updates = correctPlacedTranscriptCaptions(items, 'media-1', changes)
+    expect(updates).toHaveLength(1)
+    expect(updates[0]!.id).toBe('captions-1')
+    expect(updates[0]!.cues.map((cue) => cue.text)).toEqual([
+      'We made it to the lake.',
+      'Look at the water.',
+    ])
+    // Timing is unchanged.
+    expect(updates[0]!.cues[0]).toMatchObject({ id: 'cue-0', startSeconds: 0, endSeconds: 1 })
+  })
+})
