+    const pieces = [piece({ id: 'rest', start: 0.9, end: 10, durationInFrames: 273 })]
+    expect(planCutRestore(pieces, { start: 0, end: 0.9 }, 30)).toEqual({
+      handle: 'start',
+      itemId: 'rest',
+      frames: 27,
+      joinWithId: null,
