+// @vitest-environment node
+
+import { describe, expect, it } from 'vite-plus/test'
+import type { MediaTranscript } from '@/types/storage'
+import type { VideoItem } from '@/types/timeline'
+import {
+  correctTranscriptWord,
+  cutForEntry,
+  liveRanges,
+  placeTranscriptEntries,
+  planCutRestore,
+  renameSpeaker,
+  selectionRanges,
+  setParagraphSpeaker,
+  sourceTimeToFrame,
+  speakerAt,
+  speakerName,
+  speakerNumbers,
+  timelineSecondsOf,
+  transcriptBlocks,
+  transcriptCuts,
+  transcriptExtent,
+  transcriptPieces,
+  transcriptWords,
+  type TranscriptPiece,
+} from './transcript-document'
+
+function video(overrides: Partial<VideoItem> = {}): VideoItem {
+  return {
+    id: 'video-1',
+    type: 'video',
+    trackId: 'video-track',
+    from: 0,
+    durationInFrames: 300,
+    label: 'Lake morning.mov',
+    src: 'blob:video',
+    mediaId: 'media-1',
+    originId: 'origin-1',
+    sourceStart: 0,
+    sourceEnd: 300,
+    sourceDuration: 300,
+    sourceFps: 30,
+    ...overrides,
+  }
+}
+
+/** "Okay, um, this is the lake." then a pause, then "It's like glass." (seconds) */
+function transcript(): MediaTranscript {
+  return {
+    id: 'media-1',
+    mediaId: 'media-1',
+    model: 'parakeet-tdt-v3',
+    quantization: 'hybrid',
+    text: 'Okay, um, this is the lake. It’s like glass.',
+    segments: [
+      {
+        text: 'Okay, um, this is the lake.',
+        start: 0.5,
+        end: 3,
+        words: [
+          { text: 'Okay,', start: 0.5, end: 0.9 },
+          { text: 'um,', start: 1, end: 1.3 },
+          { text: 'this', start: 1.5, end: 1.8 },
+          { text: 'is', start: 1.9, end: 2.1 },
+          { text: 'the', start: 2.2, end: 2.4 },
+          { text: 'lake.', start: 2.5, end: 3 },
+        ],
+      },
+      {
+        text: 'It’s like glass.',
+        start: 4.5,
+        end: 5.6,
+        words: [
+          { text: 'It’s', start: 4.5, end: 4.8 },
+          { text: 'like', start: 4.9, end: 5.1 },
+          { text: 'glass.', start: 5.2, end: 5.6 },
+        ],
+      },
+    ],
+    createdAt: 1,
+    updatedAt: 1,
+  }
+}
+
+const piece = (overrides: Partial<TranscriptPiece>): TranscriptPiece => ({
+  id: 'p',
+  trackId: 'video-track',
+  from: 0,
+  durationInFrames: 300,
+  speed: 1,
+  start: 0,
+  end: 10,
+  ...overrides,
+})
+
+describe('word → time mapping', () => {
+  it('maps source words to movie frames through the clip pieces', () => {
+    const pieces = transcriptPieces(
+      [video({ from: 90, sourceStart: 30, sourceEnd: 300 })],
+      'origin-1',
+      'media-1',
+      30,
+    )
+    expect(pieces).toEqual([
+      {
+        id: 'video-1',
+        trackId: 'video-track',
+        from: 90,
+        durationInFrames: 300,
+        speed: 1,
+        start: 1,
+        end: 10,
+      },
+    ])
+    // Source 1.5 s is 0.5 s into the clip, which starts at frame 90.
+    expect(sourceTimeToFrame(pieces, 1.5, 30)).toBe(105)
+    expect(sourceTimeToFrame(pieces, 0.5, 30)).toBeNull()
+  })
+
+  it('follows speed', () => {
