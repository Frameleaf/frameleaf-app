+/**
+ * Caption text that changes when transcript words are corrected (Frameleaf FL-562), old to new.
+ * Captions placed on the timeline hold the transcript's phrase text, so a cue whose text was a
+ * changed phrase is rewritten; cues someone edited by hand no longer match and stay as they are.
+ */
+export function transcriptCaptionTextChanges(
+  previous: readonly MediaTranscriptSegment[],
+  next: readonly MediaTranscriptSegment[],
+): Map<string, string> {
+  const changes = new Map<string, string>()
+  const add = (from: string | undefined, to: string | undefined) => {
+    if (from && to && from !== to) changes.set(from, to)
+  }
+  previous.forEach((segment, index) => add(segment.text, next[index]?.text))
+  const before = segmentTranscriptForCaptions([...previous])
+  const after = segmentTranscriptForCaptions([...next])
+  if (before.length === after.length) {
+    before.forEach((cue, index) => add(cue.text, after[index]?.text))
+  }
+  return changes
+}
+
+/** Placed transcript captions of one media, with the corrected text, for the items that change. */
+export function correctPlacedTranscriptCaptions(
+  items: readonly TimelineItem[],
+  mediaId: string,
+  changes: ReadonlyMap<string, string>,
+): Array<{ id: string; cues: SubtitleSegmentItem['cues'] }> {
+  if (changes.size === 0) return []
+  return items.flatMap((item) => {
+    if (item.type !== 'subtitle') return []
+    if (item.source.type !== 'transcript' || item.source.mediaId !== mediaId) return []
+    let changed = false
+    const cues = item.cues.map((cue) => {
+      const text = changes.get(cue.text)
+      if (text === undefined) return cue
+      changed = true
+      return { ...cue, text }
+    })
+    return changed ? [{ id: item.id, cues }] : []
+  })
+}
