+import { usePlaybackStore } from '@/shared/state/playback'
+import { isPlaybackJump } from './scope-math'
+import { useGizmoStore } from '../stores/gizmo-store'
+import { usePreviewBridgeStore } from '@/shared/state/preview-bridge'
+import {
+  useTimelineStore,
+  useCompositionsStore,
+  useCompositionNavigationStore,
+} from '@/features/preview/deps/timeline-store'
+import { useMediaLibraryStore } from '@/features/preview/deps/media-library'
+
+let inputEpoch = 0
+let seekEpoch = 0
+let lastPlayingFrame: { frame: number; atMs: number } | null = null
+usePlaybackStore.subscribe((state) => {
+  if (!state.isPlaying) {
+    lastPlayingFrame = null
+    return
+  }
+  if (lastPlayingFrame?.frame === state.currentFrame) return
+  const next = { frame: state.currentFrame, atMs: performance.now() }
+  if (
+    lastPlayingFrame &&
+    isPlaybackJump(
+      lastPlayingFrame,
+      next,
+      useTimelineStore.getState().fps || 30,
+      state.playbackRate,
+    )
+  )
+    seekEpoch += 1
+  lastPlayingFrame = next
+})
+
+export function getScopeInputs() {
+  const source = usePreviewBridgeStore.getState()
+  const timeline = useTimelineStore.getState()
+  const gizmo = useGizmoStore.getState()
+  return {
+    epoch: inputEpoch,
+    seekEpoch,
+    source: [source.captureCanvasSource, source.captureFrameImageData, source.captureFrame],
+    scope: [source.scopeOwner, source.captureScopeSample],
+    color: [
+      source.captureFrameSignal,
+      source.scopeColor,
+      useMediaLibraryStore.getState().mediaById,
+    ],
+    items: timeline.items,
+    preview: [gizmo.preview, gizmo.canvasBackgroundPreview, gizmo.colorGradeBypassed],
+    graph: [
+      timeline.tracks,
+      timeline.keyframes,
+      timeline.transitions,
+      timeline.fps,
+      useCompositionNavigationStore.getState().activeCompositionId,
+    ],
+    compositions: useCompositionsStore.getState().compositionById,
+  }
+}
+
+function sameInputs(
+  current: ReturnType<typeof getScopeInputs>,
+  inputs: ReturnType<typeof getScopeInputs>,
+): boolean {
+  return (
+    current.scope.every((input, index) => input === inputs.scope[index]) &&
+    current.source.every((input, index) => input === inputs.source[index]) &&
+    current.color.every((input, index) => input === inputs.color[index]) &&
+    current.graph.every((input, index) => input === inputs.graph[index]) &&
+    current.preview.every((input, index) => input === inputs.preview[index]) &&
+    current.items === inputs.items &&
+    current.compositions === inputs.compositions
+  )
+}
+
+// Remember intervening edits too: an undo or cancelled live preview can restore the same references.
+let previous = getScopeInputs()
+for (const store of [
+  useTimelineStore,
+  useCompositionsStore,
+  useCompositionNavigationStore,
+  useMediaLibraryStore,
+  useGizmoStore,
+  usePreviewBridgeStore,
+]) {
+  store.subscribe(() => {
+    const current = getScopeInputs()
+    if (!sameInputs(current, previous)) inputEpoch += 1
+    previous = current
+  })
+}
+
+export function isScopeSourceCurrent(inputs: ReturnType<typeof getScopeInputs>): boolean {
+  const current = getScopeInputs()
+  return (
+    current.epoch === inputs.epoch &&
+    current.seekEpoch === inputs.seekEpoch &&
+    sameInputs(current, inputs)
+  )
+}
