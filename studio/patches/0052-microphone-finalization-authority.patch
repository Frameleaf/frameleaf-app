+/** A directory lookup distinguishes an absent namespace from either existing entry kind. */
+async function recordingNamespaceExists(root: FileSystemDirectoryHandle, mediaId: string): Promise<boolean> {
+  let parent: FileSystemDirectoryHandle
+  try {
+    parent = await root.getDirectoryHandle(MEDIA_DIR, { create: false })
+  } catch (error) {
+    if (error instanceof DOMException && error.name === 'NotFoundError') return false
+    throw error
+  }
+  try {
+    await parent.getDirectoryHandle(mediaId, { create: false })
+    return true
+  } catch (error) {
+    // Only the final entry's type mismatch proves a file collision. Parent/read errors still fail.
+    if (error instanceof DOMException && error.name === 'TypeMismatchError') return true
+    if (error instanceof DOMException && error.name === 'NotFoundError') return false
+    throw error
+  }
+}
