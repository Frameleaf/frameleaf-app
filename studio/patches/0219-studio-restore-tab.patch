+import { cleanup, render, screen } from '@testing-library/react'
+import { afterEach, describe, expect, it, vi } from 'vite-plus/test'
+import { WorkspaceSwitcher } from './workspace-switcher'
+
+vi.mock('react-i18next', () => ({ useTranslation: () => ({ t: (key: string) => key }) }))
+
+describe('WorkspaceSwitcher', () => {
+  afterEach(cleanup)
+
+  it('draws the six workspace tabs and no Restore without a host panel (FL-1822)', () => {
+    render(<WorkspaceSwitcher />)
+    expect(screen.getAllByRole('tab').map((tab) => tab.textContent)).toEqual([
+      'toolbar.workspaces.edit',
+      'toolbar.workspaces.color',
+      'toolbar.workspaces.audio',
+      'toolbar.workspaces.motion',
+      'toolbar.workspaces.captions',
+      'toolbar.workspaces.transcript',
+    ])
+    expect(screen.queryByRole('button', { name: 'toolbar.workspaces.restore' })).toBeNull()
+  })
+})
