diff --git a/src/features/editor/restore-service.ts b/src/features/editor/restore-service.ts
new file mode 100644
index 0000000..bd17788
--- /dev/null
+++ b/src/features/editor/restore-service.ts
@@ -0,0 +1,10 @@
+/**
+ * Restore (FL-1822): the approved Studio's Restore tab.
+ *
+ * Restoration runs as a job on the host's server, in the host's own Restore panel. On its own the
+ * engine has no such panel, so the tab is not offered; a host build substitutes this module with
+ * one that asks the host to open its panel.
+ */
+export const restoreAvailable: boolean = false
+
+export function requestRestore(): void {}
