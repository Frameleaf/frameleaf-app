+import { fireEvent, render, screen, waitFor } from '@testing-library/react'
+import { describe, expect, it, vi } from 'vite-plus/test'
+import { EditProjectForm, InlineCreateProjectForm } from './project-form'
+
+describe('project template colour policy', () => {
+  it.each([EditProjectForm, InlineCreateProjectForm])(
+    'discloses fixed colour behaviour beside templates without changing the form payload',
+    async (Form) => {
+      const onSubmit = vi.fn()
+      render(
+        <Form
+          onSubmit={onSubmit}
+          onCancel={() => {}}
+          defaultValues={{ name: 'Example', width: 1280, height: 720, fps: 24 }}
+        />,
+      )
+      const policy = screen.getByRole('note', { name: 'Colour policy' })
+      expect(policy).toHaveTextContent(
+        'Changing canvas size or frame rate preserves existing colour settings.',
+      )
+      expect(policy).toHaveTextContent(
+        'Adding PQ or HLG media to the timeline, including inside nested compositions, makes the project HDR.',
+      )
+      expect(policy).toHaveTextContent(
+        'Importing media alone does not. Export colour is chosen separately.',
+      )
+      fireEvent.click(screen.getByRole('button', { name: /YouTube 1080p/ }))
+      const submit = screen.getByRole('button', { name: /Update Project|Create Project/ })
+      await waitFor(() => expect(submit).toBeEnabled())
+      fireEvent.click(submit)
+      await waitFor(() => expect(onSubmit).toHaveBeenCalled())
+      expect(onSubmit.mock.calls[0]![0]).toEqual({
+        name: 'Example',
+        description: '',
+        width: 1920,
+        height: 1080,
+        fps: 30,
+      })
+      expect(screen.queryByRole('checkbox')).not.toBeInTheDocument()
+    },
+  )
+})
