+// @vitest-environment node
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vite-plus/test'
+const meter = vi.hoisted(() => ({ start: vi.fn(() => vi.fn()) }))
+vi.mock('./meter', () => ({ createMicLevelMeter: meter.start }))
+import { MicRecorder } from './mic-recorder'
+
+class Capture extends EventTarget {
+  static isTypeSupported = () => true
+  static constructed = 0
+  static started = 0
+  static constructorError: Error | null = null
+  static startError: Error | null = null
+  state = 'inactive'
+  mimeType = 'audio/webm'
+  constructor() {
+    super()
+    Capture.constructed++
+    if (Capture.constructorError) throw Capture.constructorError
+  }
+  start() {
+    Capture.started++
+    if (Capture.startError) throw Capture.startError
+    this.state = 'recording'
+    queueMicrotask(() => this.dispatchEvent(new Event('start')))
+  }
+  stop() {
+    this.state = 'inactive'
+    queueMicrotask(() => {
+      this.dispatchEvent(Object.assign(new Event('dataavailable'), { data: new Blob(['take']) }))
+      this.dispatchEvent(new Event('stop'))
+    })
+  }
+}
+let stopTrack: ReturnType<typeof vi.fn>
+let stream: MediaStream
+beforeEach(() => {
+  vi.clearAllMocks()
+  Capture.constructed = Capture.started = 0
+  Capture.constructorError = Capture.startError = null
+  stopTrack = vi.fn()
+  stream = { getTracks: () => [{ stop: stopTrack }] } as unknown as MediaStream
+  vi.stubGlobal('MediaRecorder', Capture)
+  vi.stubGlobal('navigator', { mediaDevices: { getUserMedia: vi.fn(async () => stream) } })
+})
+afterEach(() => { vi.unstubAllGlobals() })
+
+describe('microphone acquisition retirement', () => {
+  it('stops late acquisition before starting a meter or capture on a disposed instance', async () => {
+    let release!: (value: MediaStream) => void
+    navigator.mediaDevices.getUserMedia = vi.fn(() => new Promise<MediaStream>((resolve) => { release = resolve }))
+    const recorder = new MicRecorder()
+    const starting = recorder.start()
+    const refusal = expect(starting).rejects.toMatchObject({ name: 'AbortError' })
+    recorder.dispose()
+    release(stream)
+    await refusal
+    expect(stopTrack).toHaveBeenCalledOnce()
+    expect(meter.start).not.toHaveBeenCalled()
+    expect(Capture.constructed).toBe(0)
+    expect(Capture.started).toBe(0)
+    expect(recorder.getState()).toBe('idle')
+    await expect(recorder.start()).rejects.toMatchObject({ name: 'AbortError' })
+    expect(navigator.mediaDevices.getUserMedia).toHaveBeenCalledOnce()
+  })
+
+  it('retains normal acquisition, final audio and stream cleanup', async () => {
+    const recorder = new MicRecorder()
+    await recorder.start()
+    expect(meter.start).toHaveBeenCalledOnce()
+    expect(Capture.constructed).toBe(1)
+    expect(Capture.started).toBe(1)
+    const result = await recorder.stop()
+    expect(await result.blob.text()).toBe('take')
+    expect(stopTrack).toHaveBeenCalledOnce()
+    expect(recorder.getState()).toBe('idle')
+  })
+
+  it('does not revive a disposed instance when its queued start event arrives', async () => {
+    const recorder = new MicRecorder()
+    const starting = recorder.start()
+    const refusal = expect(starting).rejects.toMatchObject({ name: 'AbortError' })
+    await Promise.resolve()
+    expect(Capture.started).toBe(1)
+    recorder.dispose()
+    await refusal
+    expect(recorder.getState()).toBe('idle')
+    expect(stopTrack).toHaveBeenCalledOnce()
+  })
+
+  it('settles cancellation without waiting for a native start event', async () => {
+    const nativeStart = vi.spyOn(Capture.prototype, 'start').mockImplementation(function (this: Capture) {
+      Capture.started++
+      this.state = 'recording'
+    })
+    try {
+      const recorder = new MicRecorder()
+      const outcome = recorder.start().then(() => 'started', (error: DOMException) => error.name)
+      await Promise.resolve()
+      expect(Capture.started).toBe(1)
+      recorder.dispose()
+      const settled = await Promise.race([
+        outcome,
+        new Promise((resolve) => setTimeout(() => resolve('unsettled'), 20)),
+      ])
+      expect(settled).toBe('AbortError')
+      expect(stopTrack).toHaveBeenCalledOnce()
+      expect(recorder.getState()).toBe('idle')
+    } finally {
+      nativeStart.mockRestore()
+    }
+  })
+
+  it.each(['constructor', 'start'] as const)('releases acquisition after a synchronous recorder %s failure', async (stage) => {
+    const error = new Error(`${stage} failed`)
+    if (stage === 'constructor') Capture.constructorError = error
+    else Capture.startError = error
+    const recorder = new MicRecorder()
+    await expect(recorder.start()).rejects.toBe(error)
+    expect(stopTrack).toHaveBeenCalledOnce()
+    expect(meter.start.mock.results[0]!.value).toHaveBeenCalledOnce()
+    expect(recorder.getState()).toBe('idle')
+  })
+})
