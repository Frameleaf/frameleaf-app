+/**
+ * FL-99 / FL-97: the opacity every render route draws with. Keyframe easings that
+ * overshoot (back, elastic) and invalid stored values reach [0, 1] here, once, for
+ * every route: Canvas2D ignores an out-of-range globalAlpha (a fade to -0.02 would
+ * draw fully opaque), and the GPU route refuses one, so an HDR clip fell back to an
+ * 8-bit canvas. A non-finite opacity draws nothing rather than flash the item.
+ */
+export function renderableOpacity(opacity: number): number {
+  return Number.isFinite(opacity) ? Math.min(1, Math.max(0, opacity)) : 0
+}
