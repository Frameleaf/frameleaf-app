+describe('renderable opacity (FL-99 invalid and overshooting opacity)', () => {
+  const shape = (opacity: number): ShapeItem => ({
+    id: 'shape-opacity',
+    type: 'shape',
+    shapeType: 'rectangle',
+    fillColor: '#fff',
+    trackId: 'shape-track',
+    from: 0,
+    durationInFrames: 30,
+    label: 'Shape',
+    transform: { x: 0, y: 0, width: 100, height: 100, rotation: 0, opacity },
+  })
+  const canvas = { width: 1920, height: 1080, fps: 30 }
+
+  it('keeps [0, 1] and clamps what lies outside it, never drawing an invalid value', () => {
+    expect(renderableOpacity(0.25)).toBe(0.25)
+    expect(renderableOpacity(-0.02)).toBe(0)
+    expect(renderableOpacity(1.5)).toBe(1)
+    expect(renderableOpacity(Number.NaN)).toBe(0)
+    expect(renderableOpacity(Number.POSITIVE_INFINITY)).toBe(0)
+    for (const stored of [-0.5, 1.5, Number.NaN]) {
+      const { opacity } = getAnimatedTransform(shape(stored), undefined, 0, canvas)
+      expect(opacity).toBeGreaterThanOrEqual(0)
+      expect(opacity).toBeLessThanOrEqual(1)
+    }
+  })
+
+  it('clamps a keyframe easing that overshoots below zero at the end of a fade-out', () => {
+    const keyframes = {
+      itemId: 'shape-opacity',
+      properties: [
+        {
+          property: 'opacity' as const,
+          keyframes: [
+            { id: 'a', frame: 0, value: 1, easing: 'linear' as const },
+            { id: 'b', frame: 10, value: -0.2, easing: 'linear' as const },
+          ],
+        },
+      ],
+    }
+    const end = getAnimatedTransform(shape(1), keyframes, 10, canvas)
+    expect(end.opacity).toBe(0)
+    const mid = getAnimatedTransform(shape(1), keyframes, 5, canvas)
+    expect(mid.opacity).toBeCloseTo(0.4, 6)
+  })
