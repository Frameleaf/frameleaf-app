 })
+
+it('range rebasing preserves every Lottie source and effect clock without modifying the immutable timeline', () => {
+  const track: TimelineTrack = {
+    id: 'v1',
+    name: 'V1',
+    height: 80,
+    locked: false,
+    visible: true,
+    muted: false,
+    solo: false,
+    order: 0,
+    items: [],
+  }
+  const source = {
+    id: 'lottie',
+    type: 'lottie' as const,
+    src: 'owned',
+    label: 'Owned',
+    trackId: 'v1',
+    from: 2,
+    durationInFrames: 48,
+    frameRate: 30,
+    totalFrames: 60,
+    sourceWidth: 64,
+    sourceHeight: 32,
+    speed: 0.75,
+    reversed: true,
+    loop: true,
+    loopMode: 'pingpong' as const,
+    segmentStart: 3,
+    segmentEnd: 50,
+  }
+  const keyframes: import('@/types/keyframe').ItemKeyframes[] = [
+    {
+      itemId: source.id,
+      properties: [
+        {
+          property: 'opacity',
+          keyframes: [
+            { id: 'first', frame: 0, value: 0, easing: 'linear' },
+            { id: 'last', frame: 47, value: 1, easing: 'linear' },
+          ],
+        },
+      ],
+    },
+  ]
+  const original = structuredClone({ source, keyframes })
+  const range = convertTimelineToComposition([track], [source], [], 24, 1280, 720, 8, 36, keyframes)
+  const converted = range.tracks[0]!.items[0]!
+  expect(converted.from).toBe(-6)
+  expect(converted.durationInFrames).toBe(48)
+  for (const outputFrame of [0, 1, 12, 27]) {
+    expect(outputFrame - converted.from).toBe(outputFrame + 8 - source.from)
+  }
+  expect(range.keyframes).toEqual(keyframes)
+  expect({ source, keyframes }).toEqual(original)
+})
