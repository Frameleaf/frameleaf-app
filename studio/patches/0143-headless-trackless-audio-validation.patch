+/** Only a real video track can prove that absent embedded audio is valid. */
+export async function hasSourceAudio(src: string): Promise<boolean> {
+  const mb = await import('mediabunny')
+  const input = new mb.Input({ formats: mb.ALL_FORMATS, source: createMediabunnyInputSource(mb, src) })
+  try {
+    if (await input.getPrimaryAudioTrack()) return true
+    if (await input.getPrimaryVideoTrack()) return false
+    throw new Error('Source has no audio or video track')
+  } finally {
+    input.dispose()
+  }
+}
