@@ -0,0 +1,259 @@
+import { act, cleanup, fireEvent, render } from '@testing-library/react'
+import { afterEach, beforeEach, describe, expect, it } from 'vite-plus/test'
+import { reviewCaptionQuality } from '@/features/editor/utils/caption-quality'
+import { CaptionQualityPanel } from '@/features/editor/components/properties-sidebar/caption-quality-panel'
+import {
+  useItemsStore,
+  useTimelineSettingsStore,
+  useCompositionsStore,
+  useCompositionNavigationStore,
+  useTimelineCommandStore,
+} from '@/features/editor/deps/timeline-store'
+import { useSelectionStore } from '@/shared/state/selection'
+import { usePlaybackStore } from '@/shared/state/playback'
+import {
+  makeTimelineTrack,
+  makeTimelineVideoItem,
+  resetTimelineCompositionTestState,
+} from '@/features/timeline/test-helpers'
+import type { SubtitleSegmentItem, TimelineItem } from '@/types/timeline'
+
+function segment(overrides: Partial<SubtitleSegmentItem> = {}): SubtitleSegmentItem {
+  return {
+    id: 'captions',
+    type: 'subtitle',
+    trackId: 'original',
+    label: 'Captions',
+    from: 30,
+    durationInFrames: 300,
+    source: { type: 'subtitle-import' },
+    cues: [{ id: 'cue', startSeconds: 1, endSeconds: 2, text: 'Hello' }],
+    color: '#ffffff',
+    fontFamily: 'Arial',
+    fontSize: 40,
+    ...overrides,
+  } as SubtitleSegmentItem
+}
+const cue = (id: string, startSeconds: number, endSeconds: number, text = 'Hello') => ({
+  id,
+  startSeconds,
+  endSeconds,
+  text,
+})
+const review = (items: TimelineItem[], duration = 600, fps = 30) =>
+  reviewCaptionQuality(items, fps, duration)
+
+beforeEach(resetTimelineCompositionTestState)
+afterEach(cleanup)
+
+describe('caption quality advisory', () => {
+  it('counts Unicode code points without whitespace at the exact 20 cps boundary', () => {
+    expect(review([segment({ cues: [cue('a', 0, 1, '😀 '.repeat(20))] })])).toEqual([])
+    expect(review([segment({ cues: [cue('a', 0, 1, '😀\t'.repeat(21))] })])[0]?.reasons).toEqual([
+      'speed',
+    ])
+    expect(review([segment({ cues: [cue('a', 0, 2, '字'.repeat(40))] })])).toEqual([])
+    expect(review([segment({ cues: [cue('a', 0.1, 0.2, '字字')] })])).toEqual([])
+    expect(review([segment({ cues: [cue('a', 0, 1, 'a\nb')] })])).toEqual([])
+    expect(review([segment({ cues: [cue('a', 0, 1, 'a\r\nb\rc')] })])[0]?.reasons).toEqual([
+      'lines',
+    ])
+  })
+
+  it('finds both ends of nested overlaps, but allows adjacent cues and separate tracks/languages', () => {
+    const cues = [
+      cue('outer', 0, 10),
+      cue('inner', 1, 2),
+      cue('later', 3, 4),
+      cue('adjacent', 10, 11),
+    ]
+    const original = segment({ cues })
+    const translated = segment({
+      id: 'fr',
+      trackId: 'French',
+      cues: [cue('fr', 1, 2)],
+      source: {
+        type: 'subtitle-import',
+        translation: { language: 'fr', from: 'en', subtitle: true, translatedAt: 1 },
+      } as SubtitleSegmentItem['source'],
+    })
+    expect(review([original, translated]).map((warning) => [warning.id, warning.reasons])).toEqual([
+      ['captions:0', ['overlap']],
+      ['captions:1', ['overlap']],
+      ['captions:2', ['overlap']],
+    ])
+    const crossItem = segment({ id: 'another', from: 60, cues: [cue('cross', 0, 1)] })
+    expect(
+      review([original, crossItem]).find((warning) => warning.itemId === 'another')?.reasons,
+    ).toContain('overlap')
+  })
+
+  it('reports invalid durations and sequence bounds safely, with real owner IDs and segment offsets', () => {
+    const item = segment({
+      from: 60,
+      cues: [
+        cue('first', -3, -2),
+        cue('last', 18, 19),
+        cue('zero', 4, 4),
+        cue('backwards', 5, 4),
+        cue('invalid', NaN, Infinity),
+      ],
+    })
+    const warnings = review([item])
+    expect(warnings.map((warning) => warning.itemId)).toEqual(Array(5).fill('captions'))
+    expect(warnings.filter((warning) => warning.reasons.includes('bounds'))).toHaveLength(2)
+    expect(warnings.filter((warning) => warning.reasons.includes('timing'))).toHaveLength(3)
+    expect(warnings.find((warning) => warning.id === 'captions:1')?.startSeconds).toBe(20)
+    expect(review([segment({ durationInFrames: 0 })])[0]?.reasons).toContain('timing')
+    expect(review([segment()], 600, 0)[0]?.reasons).toContain('timing')
+    expect(review([segment()], NaN)[0]?.reasons).toContain('timing')
+  })
+
+  it('maps transcript source rate, trim and speed to the visible cue and preserves authored words/styles', () => {
+    const item = makeTimelineVideoItem({
+      from: 90,
+      durationInFrames: 90,
+      sourceStart: 48,
+      sourceEnd: 192,
+      sourceFps: 24,
+      speed: 2,
+      transcriptCaptions: {
+        type: 'transcript',
+        mediaId: 'media-1',
+        enabled: true,
+        updatedAt: 1,
+        cues: [
+          cue('trimmed', 0, 1),
+          {
+            ...cue('partial', 1, 4, '字'.repeat(21)),
+            words: [{ text: '字', startSeconds: 2, endSeconds: 3 }],
+          },
+          cue('offset', 4, 5, '字'.repeat(21)),
+        ],
+        style: { fontSize: 60 },
+      },
+    })
+    const before = structuredClone(item)
+    const warnings = review([item])
+    expect(warnings.map((warning) => [warning.itemId, warning.startSeconds])).toEqual([
+      ['video-1', 3],
+      ['video-1', 4],
+    ])
+    expect(item).toEqual(before)
+    expect(review([{ ...item, speed: 0 }])[0]?.reasons).toContain('timing')
+    expect(review([{ ...item, sourceEnd: 72 }])).toHaveLength(1)
+    expect(review([{ ...item, isReversed: true }])).toEqual([])
+    const invalid = {
+      ...item,
+      transcriptCaptions: {
+        ...item.transcriptCaptions!,
+        cues: [cue('invalid', Infinity, Infinity)],
+      },
+    }
+    expect(review([invalid])[0]?.reasons).toContain('timing')
+  })
+
+  it('checks translated cues even on hidden tracks and caption text without mutating graph state', () => {
+    const translated = segment({
+      source: {
+        type: 'subtitle-import',
+        translation: { language: 'fr', from: 'en', subtitle: true, translatedAt: 1 },
+      } as SubtitleSegmentItem['source'],
+      cues: [cue('fr', 0, 1, 'a\nb\nc')],
+    })
+    const text = {
+      ...makeTimelineVideoItem(),
+      id: 'text',
+      type: 'text',
+      textRole: 'caption',
+      text: '字'.repeat(41),
+      durationInFrames: 60,
+    } as unknown as TimelineItem
+    expect(
+      review([translated, text])
+        .map((warning) => warning.itemId)
+        .sort(),
+    ).toEqual(['captions', 'text'])
+    expect(review([translated])[0]?.language).toBe('fr')
+  })
+})
+
+it('opens review, selects the actual translated item, seeks through cue offsets, recomputes and leaves graph/history untouched', () => {
+  const item = segment({
+    id: 'translated:item:with:colons',
+    trackId: 'fr',
+    from: 90,
+    source: {
+      type: 'subtitle-import',
+      translation: { language: 'fr', from: 'en', subtitle: true, translatedAt: 1 },
+    } as SubtitleSegmentItem['source'],
+    cues: [cue('cue:with:colons', 2, 3, 'un\ndeux\ntrois')],
+  })
+  useItemsStore.getState().setItems([item])
+  useItemsStore
+    .getState()
+    .setTracks([makeTimelineTrack({ id: 'fr', name: 'French captions', order: 0, visible: false })])
+  useTimelineSettingsStore.getState().setFps(30)
+  const before = useItemsStore.getState()
+  const history = useTimelineCommandStore.getState()
+  const ui = render(<CaptionQualityPanel />)
+  fireEvent.click(ui.getByRole('button', { name: 'Caption quality (1)' }))
+  fireEvent.click(ui.getByRole('button', { name: /French captions · French · 0:05.00/ }))
+  expect(useSelectionStore.getState().selectedItemIds).toEqual([item.id])
+  expect(usePlaybackStore.getState().currentFrame).toBe(150)
+  expect(useItemsStore.getState()).toBe(before)
+  expect(useTimelineCommandStore.getState()).toBe(history)
+  act(() => useItemsStore.getState().setItems([{ ...item, cues: [cue('fixed', 2, 3, 'Fixed')] }]))
+  expect(ui.getByRole('status').textContent).toBe('No caption quality warnings.')
+})
+
+it('uses the active nested sequence bounds and handles invalid cue seek safely', () => {
+  useTimelineSettingsStore.getState().setFps(30)
+  useCompositionsStore.setState({
+    compositionById: { sequence: { id: 'sequence', durationInFrames: 120 } } as never,
+  })
+  useCompositionNavigationStore.setState({ activeCompositionId: 'sequence' })
+  useItemsStore
+    .getState()
+    .setItems([segment({ cues: [cue('beyond', 4, 5), cue('invalid', NaN, NaN)] })])
+  const ui = render(<CaptionQualityPanel />)
+  fireEvent.click(ui.getByRole('button', { name: 'Caption quality (2)' }))
+  const buttons = ui.getAllByRole('button', { name: /Original/ })
+  fireEvent.click(buttons[0]!)
+  expect(usePlaybackStore.getState().currentFrame).toBe(119)
+  fireEvent.click(buttons[1]!)
+  expect(usePlaybackStore.getState().currentFrame).toBe(30)
+})
+
+it('uses the active sequence rate for reading speed, cue offsets and seeking independently of root FPS', () => {
+  useTimelineSettingsStore.getState().setFps(30)
+  useCompositionsStore.setState({
+    compositionById: { sequence: { id: 'sequence', fps: 60, durationInFrames: 600 } } as never,
+  })
+  useCompositionNavigationStore.setState({ activeCompositionId: 'sequence' })
+  const text = {
+    ...segment(),
+    id: 'fast-text',
+    type: 'text',
+    textRole: 'caption',
+    from: 60,
+    durationInFrames: 30,
+    text: '字'.repeat(15),
+  } as unknown as TimelineItem
+  useItemsStore.getState().setItems([
+    text,
+    segment({
+      id: 'nested-caption',
+      from: 120,
+      cues: [cue('nested', 1, 2, 'one\ntwo\nthree')],
+    }),
+  ])
+  const ui = render(<CaptionQualityPanel />)
+  fireEvent.click(ui.getByRole('button', { name: 'Caption quality (2)' }))
+  expect(
+    ui.getByRole('button', { name: /Original · 0:01.00 · Over 20 characters per second/ }),
+  ).toBeInTheDocument()
+  fireEvent.click(ui.getByRole('button', { name: /Original · 0:03.00 · More than two lines/ }))
+  expect(useSelectionStore.getState().selectedItemIds).toEqual(['nested-caption'])
+  expect(usePlaybackStore.getState().currentFrame).toBe(180)
+})
