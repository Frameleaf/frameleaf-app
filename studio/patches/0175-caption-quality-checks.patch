diff --git a/src/features/editor/components/properties-sidebar/caption-quality-panel.tsx b/src/features/editor/components/properties-sidebar/caption-quality-panel.tsx
new file mode 100644
--- /dev/null
+++ b/src/features/editor/components/properties-sidebar/caption-quality-panel.tsx
@@ -0,0 +1,103 @@
+import { useMemo } from 'react'
+import { useTranslation } from 'react-i18next'
+import { ListChecks } from 'lucide-react'
+import {
+  useItemsStore,
+  useTimelineStore,
+  useCompositionNavigationStore,
+  useCompositionsStore,
+} from '@/features/editor/deps/timeline-store'
+import { useSelectionStore } from '@/shared/state/selection'
+import { usePlaybackStore } from '@/shared/state/playback'
+import { PropertySection } from './components'
+import { reviewCaptionQuality } from '../../utils/caption-quality'
+
+export function CaptionQualityPanel() {
+  const { t, i18n } = useTranslation()
+  const items = useItemsStore((state) => state.items)
+  const tracks = useItemsStore((state) => state.tracks)
+  const timelineFps = useTimelineStore((state) => state.fps)
+  const activeId = useCompositionNavigationStore((state) => state.activeCompositionId)
+  const composition = useCompositionsStore((state) =>
+    activeId ? state.compositionById[activeId] : undefined,
+  )
+  const fps = composition?.fps ?? timelineFps
+  const duration =
+    composition?.durationInFrames ??
+    items.reduce(
+      (last, item) =>
+        Number.isFinite(item.from + item.durationInFrames)
+          ? Math.max(last, item.from + item.durationInFrames)
+          : last,
+      0,
+    )
+  const warnings = useMemo(() => reviewCaptionQuality(items, fps, duration), [items, fps, duration])
+  const locale = i18n.resolvedLanguage ?? i18n.language ?? 'en'
+  const names = useMemo(() => {
+    try {
+      return new Intl.DisplayNames([locale], { type: 'language' })
+    } catch {
+      return null
+    }
+  }, [locale])
+  const time = (seconds: number) => {
+    if (!Number.isFinite(seconds)) return t('captionQuality.unknownTime')
+    const absolute = Math.abs(seconds)
+    return `${seconds < 0 ? '−' : ''}${Math.floor(absolute / 60)}:${(absolute % 60).toFixed(2).padStart(5, '0')}`
+  }
+  return (
+    <PropertySection
+      title={t('captionQuality.title', { count: warnings.length })}
+      icon={ListChecks}
+      defaultOpen={false}
+    >
+      <section
+        aria-label={t('captionQuality.label')}
+        className="space-y-2 text-xs"
+        data-testid="caption-quality-panel"
+      >
+        <p className="text-muted-foreground">{t('captionQuality.note')}</p>
+        {warnings.length === 0 && <p role="status">{t('captionQuality.clear')}</p>}
+        <ul className="space-y-2">
+          {warnings.map((warning) => {
+            const track =
+              tracks.find((candidate) => candidate.id === warning.trackId)?.name ?? warning.trackId
+            const language = warning.language
+              ? (names?.of(warning.language) ?? warning.language)
+              : t('captionQuality.original')
+            const reason = warning.reasons.map((key) => t(`captionQuality.${key}`)).join(' · ')
+            const label = `${track} · ${language} · ${time(warning.startSeconds)} · ${reason}`
+            return (
+              <li key={warning.id}>
+                <button
+                  type="button"
+                  className="w-full rounded border border-border p-2 text-left hover:bg-secondary/50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-primary"
+                  aria-label={label}
+                  onClick={() => {
+                    useSelectionStore.getState().selectItems([warning.itemId])
+                    const item = useItemsStore.getState().itemById[warning.itemId]
+                    const seconds = Number.isFinite(warning.startSeconds)
+                      ? warning.startSeconds
+                      : (item?.from ?? 0) / fps
+                    const frame = Number.isFinite(seconds * fps) ? Math.round(seconds * fps) : 0
+                    usePlaybackStore
+                      .getState()
+                      .setCurrentFrame(Math.max(0, Math.min(Math.max(0, duration - 1), frame)))
+                  }}
+                >
+                  <span className="block font-medium">
+                    {track} · {language} · {time(warning.startSeconds)}
+                  </span>
+                  <span className="block">{reason}</span>
+                  <span className="block whitespace-pre-wrap text-muted-foreground">
+                    {warning.text}
+                  </span>
+                </button>
+              </li>
+            )
+          })}
+        </ul>
+      </section>
+    </PropertySection>
+  )
+}
diff --git a/src/features/editor/utils/caption-quality.ts b/src/features/editor/utils/caption-quality.ts
new file mode 100644
--- /dev/null
+++ b/src/features/editor/utils/caption-quality.ts
@@ -0,0 +1,147 @@
+import type { TimelineItem } from '@/types/timeline'
+import { translationOf } from './caption-languages'
+
+export type CaptionQualityReason = 'speed' | 'lines' | 'overlap' | 'bounds' | 'timing'
+export interface CaptionQualityWarning {
+  id: string
+  itemId: string
+  trackId: string
+  language?: string
+  startSeconds: number
+  text: string
+  reasons: CaptionQualityReason[]
+}
+
+/** Review authored cues without changing text, style, word timing or the graph. */
+export function reviewCaptionQuality(
+  items: readonly TimelineItem[],
+  fps: number,
+  durationInFrames: number,
+): CaptionQualityWarning[] {
+  const cues: (CaptionQualityWarning & { endSeconds: number })[] = []
+  const validRate = Number.isFinite(fps) && fps > 0
+  const duration = durationInFrames / fps
+  const push = (item: TimelineItem, id: string, start: number, end: number, text: string) => {
+    const reasons: CaptionQualityReason[] = []
+    const valid =
+      validRate &&
+      Number.isFinite(duration) &&
+      duration >= 0 &&
+      Number.isFinite(item.from) &&
+      Number.isFinite(item.durationInFrames) &&
+      item.durationInFrames > 0 &&
+      Number.isFinite(start) &&
+      Number.isFinite(end) &&
+      end > start
+    if (!valid) reasons.push('timing')
+    else if ([...text.replace(/\s/gu, '')].length > 20 * (end - start) + 1e-9) reasons.push('speed')
+    if (text.split(/\r\n|\r|\n/).length > 2) reasons.push('lines')
+    if (
+      Number.isFinite(start) &&
+      Number.isFinite(end) &&
+      Number.isFinite(duration) &&
+      (start < 0 || end > duration)
+    )
+      reasons.push('bounds')
+    cues.push({
+      id,
+      itemId: item.id,
+      trackId: item.trackId,
+      language: translationOf(item)?.language,
+      startSeconds: start,
+      endSeconds: end,
+      text,
+      reasons,
+    })
+  }
+  for (const item of items) {
+    const start = item.from / fps
+    const end = (item.from + item.durationInFrames) / fps
+    if (item.type === 'subtitle') {
+      item.cues.forEach((cue, index) =>
+        push(
+          item,
+          `${item.id}:${index}`,
+          start + cue.startSeconds,
+          start + cue.endSeconds,
+          cue.text,
+        ),
+      )
+    } else if (item.type === 'text' && item.textRole === 'caption') {
+      push(item, item.id, start, end, item.text)
+    } else if (
+      (item.type === 'video' || item.type === 'audio') &&
+      item.transcriptCaptions &&
+      !item.isReversed
+    ) {
+      const speed = item.speed ?? 1
+      const sourceFps = item.sourceFps ?? fps
+      const sourceStart = (item.sourceStart ?? 0) / sourceFps
+      const sourceEnd = item.sourceEnd == null ? Infinity : item.sourceEnd / sourceFps
+      item.transcriptCaptions.cues.forEach((cue, index) => {
+        const cueStart = start + (cue.startSeconds - sourceStart) / speed
+        const cueEnd = start + (Math.min(cue.endSeconds, sourceEnd) - sourceStart) / speed
+        const validMapping =
+          validRate &&
+          Number.isFinite(sourceFps) &&
+          sourceFps > 0 &&
+          Number.isFinite(speed) &&
+          speed > 0 &&
+          Number.isFinite(sourceStart) &&
+          (item.sourceEnd == null || (Number.isFinite(sourceEnd) && sourceEnd > sourceStart))
+        const validCue =
+          Number.isFinite(cue.startSeconds) &&
+          Number.isFinite(cue.endSeconds) &&
+          cue.endSeconds > cue.startSeconds
+        // Trimmed-away transcript cues are not on the sequence; partial cues use their visible time.
+        if (
+          validMapping &&
+          validCue &&
+          (cue.endSeconds <= sourceStart ||
+            cue.startSeconds >= sourceEnd ||
+            cueEnd <= start ||
+            cueStart >= end)
+        )
+          return
+        const validTiming =
+          validMapping &&
+          validCue &&
+          Number.isFinite(cueStart) &&
+          Number.isFinite(cueEnd) &&
+          cueEnd > cueStart
+        push(
+          item,
+          `${item.id}:${index}`,
+          validTiming ? Math.max(start, cueStart) : NaN,
+          validTiming ? Math.min(end, cueEnd) : NaN,
+          cue.text,
+        )
+      })
+    }
+  }
+  const tracks = new Map<string, typeof cues>()
+  for (const cue of cues) {
+    if (cue.reasons.includes('timing')) continue
+    const track = tracks.get(cue.trackId) ?? []
+    track.push(cue)
+    tracks.set(cue.trackId, track)
+  }
+  for (const track of tracks.values()) {
+    track.sort((a, b) => a.startSeconds - b.startSeconds)
+    let longest: (typeof cues)[number] | undefined
+    for (const cue of track) {
+      if (longest && cue.startSeconds < longest.endSeconds) {
+        if (!longest.reasons.includes('overlap')) longest.reasons.push('overlap')
+        cue.reasons.push('overlap')
+      }
+      if (!longest || cue.endSeconds > longest.endSeconds) longest = cue
+    }
+  }
+  return cues
+    .filter((cue) => cue.reasons.length > 0)
+    .sort(
+      (a, b) =>
+        (Number.isFinite(a.startSeconds) ? a.startSeconds : Infinity) -
+        (Number.isFinite(b.startSeconds) ? b.startSeconds : Infinity),
+    )
+}
diff --git a/src/test/caption-quality.test.tsx b/src/test/caption-quality.test.tsx
