+// @vitest-environment jsdom
+import { cleanup, renderHook } from '@testing-library/react'
+import { afterEach, expect, it, vi } from 'vite-plus/test'
+import type { ItemKeyframes } from '@/types/keyframe'
+import type { VideoItem } from '@/types/timeline'
+import { useAudioPlaybackState } from './hooks/use-audio-playback-state'
+import { useVideoAudioState } from './video-audio-context'
+
+const state = vi.hoisted(() => ({
+  keyframes: undefined as ItemKeyframes | undefined,
+  preview: undefined as { volume: number } | undefined,
+}))
+vi.mock('@/runtime/composition-runtime/deps/player', async (original) => ({
+  ...(await original<object>()),
+  useSequenceContext: () => ({ localFrame: 15 }),
+  useClockPlaybackRate: () => 1,
+}))
+vi.mock('../hooks/use-player-compat', () => ({
+  useVideoConfig: () => ({ fps: 30 }),
+  useIsPlaying: () => true,
+}))
+vi.mock('@/runtime/composition-runtime/deps/stores', () => ({
+  usePlaybackStore: (select: (s: object) => unknown) =>
+    select({ volume: 0.5, muted: false, previewFrame: null }),
+  useGizmoStore: (select: (s: object) => unknown) =>
+    select({ activeGizmo: null, preview: { clip: { properties: state.preview } } }),
+  useCompositionsStore: (select: (s: object) => unknown) => select({ compositions: [] }),
+  useTimelineStore: (select: (s: object) => unknown) =>
+    select({
+      keyframes: state.keyframes ? [state.keyframes] : [],
+      items: [{ id: 'clip', trackId: 'audio' }],
+      tracks: [{ id: 'audio' }],
+    }),
+}))
+vi.mock('../contexts/keyframes-context', () => ({ useItemKeyframesFromContext: () => undefined }))
+vi.mock('./hooks/use-runtime-item-keyframes', () => ({
+  useRuntimeItemKeyframes: () => state.keyframes,
+}))
+afterEach(() => {
+  cleanup()
+  state.keyframes = undefined
+  state.preview = undefined
+})
+
+it.each(['static', 'keyframes', 'gizmo'] as const)(
+  'preserves the track fader with %s clip gain in both preview paths',
+  (mode) => {
+    const trackVolumeDb = -12
+    const clipDb = mode === 'static' ? -3 : mode === 'gizmo' ? -9 : -6
+    if (mode === 'keyframes')
+      state.keyframes = {
+        itemId: 'clip',
+        properties: [
+          {
+            property: 'volume',
+            keyframes: [
+              { id: 'a', frame: 0, value: -12, easing: 'linear' },
+              { id: 'b', frame: 30, value: 0, easing: 'linear' },
+            ],
+          },
+        ],
+      }
+    if (mode === 'gizmo') state.preview = { volume: -9 }
+    const clip = {
+      id: 'clip',
+      type: 'video',
+      durationInFrames: 60,
+      volume: -3,
+      trackVolumeDb,
+    } as VideoItem & { trackVolumeDb: number }
+    const { result } = renderHook(() => ({
+      audio: useAudioPlaybackState({
+        itemId: 'clip',
+        durationInFrames: 60,
+        volume: -3 + trackVolumeDb,
+        trackVolumeDb,
+      }).resolvedVolume,
+      video: useVideoAudioState(clip, false, []).audioVolume,
+    }))
+    const expected = 0.5 * 10 ** ((clipDb + trackVolumeDb) / 20)
+    expect(result.current.video).toBeCloseTo(expected, 8)
+    expect(result.current.audio).toBeCloseTo(expected, 8)
+  },
+)
