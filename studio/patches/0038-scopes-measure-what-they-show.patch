+      captureFrameSignal: vi.fn().mockImplementation(async () => pqFrame(12)),
+    })
+    renderer = {
+      setMatrix: vi.fn(), setRange: vi.fn(), setGraticule: vi.fn(), configureCanvas: vi.fn().mockReturnValue({}),
+      uploadFromCanvas: vi.fn(), uploadFrame: vi.fn(), renderWaveforms: vi.fn(),
