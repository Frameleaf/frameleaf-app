+import { describe, expect, it } from 'vite-plus/test'
+import { pqEncode } from '@/shared/graphics/color/managed-color'
+import {
+  BT2020_COEFFICIENTS,
+  hdrDisplaySignal,
+  scopeBarLevel,
+  vectorscopeTargets,
+  BT709_COEFFICIENTS,
+  VECTORSCOPE_75_TARGETS,
+  histogramBins,
+  isPlaybackJump,
+  paradeDensity,
+  scopeGuides,
+  signalToScopePixels,
+  vectorscopeDensity,
+  vectorscopePoint,
+  waveformDensity,
+  type ScopePixels,
+} from './scope-math'
+
+/** A frame whose column x has the grey (or colour) `pixel(x)`, `height` rows tall. */
+function frame(width: number, height: number, pixel: (x: number) => [number, number, number]): ScopePixels {
+  const data = new Uint8ClampedArray(width * height * 4)
+  for (let y = 0; y < height; y++) {
+    for (let x = 0; x < width; x++) {
+      const [r, g, b] = pixel(x)
+      data.set([r, g, b, 255], (y * width + x) * 4)
+    }
+  }
+  return { data, width, height }
+}
+
+/** Rows (from the top) that hold any count in column `x`. */
+const rowsIn = (counts: Uint32Array, w: number, h: number, x: number) =>
+  Array.from({ length: h }, (_, y) => y).filter((y) => (counts[y * w + x] ?? 0) > 0)
+
+describe('scope reference ramps and bars (FL-98)', () => {
+  it('a 0–255 grey ramp draws the waveform diagonal and flattens the histogram', () => {
+    const ramp = frame(256, 4, (x) => [x, x, x])
+    const w = 256
+    const h = 256
+    const waveform = waveformDensity(ramp, BT709_COEFFICIENTS, w, h)
+    for (const x of [0, 64, 128, 191, 255]) {
+      // Grey luma is the grey itself, at every matrix: column x, row 255 − x.
+      expect(rowsIn(waveform.counts, w, h, x)).toEqual([255 - x])
+    }
+    const histogram = histogramBins(ramp, BT709_COEFFICIENTS)
+    expect([...histogram.counts].every((count) => count === 4)).toBe(true)
+  })
+
+  it('the parade separates channels into their lanes at their own levels', () => {
+    // Left half pure 75% red, right half pure 75% blue.
+    const bars = frame(64, 2, (x) => (x < 32 ? [191, 0, 0] : [0, 0, 191]))
+    const w = 300
+    const h = 101
+    const lane = 100
+    const parade = paradeDensity(bars, w, h)
+    const level = (value: number) => h - 1 - Math.floor((value / 255) * (h - 1))
+    // Red lane: 75% on the left of the lane, 0 on the right.
+    expect(rowsIn(parade.counts, w, h, 0)).toEqual([level(191)])
+    expect(rowsIn(parade.counts, w, h, lane - 1)).toEqual([level(0)])
+    // Blue lane: the reverse.
+    expect(rowsIn(parade.counts, w, h, 2 * lane)).toEqual([level(0)])
+    expect(rowsIn(parade.counts, w, h, 3 * lane - 1)).toEqual([level(191)])
+  })
+
+  it('75% colour bars land on the graticule targets, grey on the centre', () => {
+    const bars = [
+      ['R', 191, 0, 0],
+      ['Mg', 191, 0, 191],
+      ['B', 0, 0, 191],
+      ['Cy', 0, 191, 191],
+      ['G', 0, 191, 0],
+      ['Yl', 191, 191, 0],
+    ] as const
+    const size = 101
+    for (const [label, r, g, b] of bars) {
+      const density = vectorscopeDensity(frame(1, 1, () => [r, g, b]), BT709_COEFFICIENTS, size)
+      const index = density.counts.findIndex((count) => count > 0)
+      const target = VECTORSCOPE_75_TARGETS.find((entry) => entry.label === label)!
+      // Within a pixel of the target box drawn at the same scale (100 units → 101 px).
+      expect(Math.abs((index % size) - (target.x * (size / 100)))).toBeLessThanOrEqual(1.5)
+      expect(Math.abs(Math.floor(index / size) - (target.y * (size / 100)))).toBeLessThanOrEqual(1.5)
+    }
+    const grey = vectorscopePoint(0.5, 0.5, 0.5, BT709_COEFFICIENTS, 100)
+    expect(grey).toEqual({ x: 50, y: 50 })
+    // 100% red sits on the 100% ring's red vector, at its BT.709 angle.
+    const red = vectorscopePoint(1, 0, 0, BT709_COEFFICIENTS, 100)
+    expect((Math.atan2(50 - red.y, red.x - 50) * 180) / Math.PI).toBeCloseTo(102.9, 0)
+  })
+
+  it('an HDR ramp above reference white reads on the PQ graticule in cd/m²', () => {
+    // Linear light 0 → 10,000 cd/m², encoded as the render engine's PQ output (FL-97).
+    const nits = [0, 100, 203, 1000, 4000, 10_000]
+    const rgba = new Float32Array(nits.length * 4)
+    for (const [i, value] of nits.entries()) rgba.set([pqEncode(value), pqEncode(value), pqEncode(value), 1], i * 4)
+    const pixels = signalToScopePixels({ width: nits.length, height: 1, rgba }, nits.length, 1)
+    const h = 1001
+    const waveform = waveformDensity(pixels, BT2020_COEFFICIENTS, nits.length, h)
+    const guides = scopeGuides('pq-bt2020')
+    for (const [x, value] of nits.entries()) {
+      const [row] = rowsIn(waveform.counts, nits.length, h, x)
+      const heightPercent = ((h - 1 - row!) / (h - 1)) * 100
+      const guide = guides[x]!
+      // Each nit level lands on its guide line, to the 8-bit sample step (0.4%).
+      expect(Math.abs(heightPercent - guide.position)).toBeLessThan(0.5)
+      expect(guide.label.startsWith(String(value >= 1000 ? value / 1000 : value))).toBe(true)
+    }
+    // Reference white is near 58% of the PQ scale, not at the top as on an SDR scope.
+    expect(guides.find((guide) => guide.label === '203')!.position).toBeCloseTo(58, 0)
+  })
+
+  it('samples a float frame down by averaging, clamped to the signal range', () => {
+    const rgba = new Float32Array([0, 0, 0, 1, 1, 1, 1, 1, 0.5, 0.5, 0.5, 1, 2, -1, 0.5, 1])
+    const pixels = signalToScopePixels({ width: 4, height: 1, rgba }, 2, 1)
+    expect([...pixels.data]).toEqual([128, 128, 128, 255, 255, 0, 128, 255])
+  })
+
+  it('tells a jump in playback from its advance', () => {
+    const at = (frame: number, atMs: number) => ({ frame, atMs })
+    expect(isPlaybackJump(at(10, 0), at(11, 33), 30)).toBe(false)
+    // Dropped frames are still an advance.
+    expect(isPlaybackJump(at(10, 0), at(15, 100), 30)).toBe(false)
+    expect(isPlaybackJump(at(10, 0), at(9, 33), 30)).toBe(true)
+    expect(isPlaybackJump(at(10, 0), at(300, 33), 30)).toBe(true)
+    // Playing backwards advances downwards.
+    expect(isPlaybackJump(at(10, 0), at(9, 33), 30, -1)).toBe(false)
+  })
+
+  it('marks BT.2111 PQ bars on an HDR vectorscope, and names clipped monitoring', () => {
+    // BT.2111 HDR bars put their colours at reference white, about 58% PQ.
+    expect(scopeBarLevel('pq-bt2020')).toBeCloseTo(pqEncode(203), 6)
+    expect(scopeBarLevel('rec709-display')).toBe(0.75)
+    const red = vectorscopeTargets(BT2020_COEFFICIENTS, pqEncode(203)).find((t) => t.label === 'R')!
+    const point = vectorscopePoint(pqEncode(203), 0, 0, BT2020_COEFFICIENTS, 100)
+    expect(Math.abs(red.x - point.x) + Math.abs(red.y - point.y)).toBeLessThan(0.2)
+    expect(hdrDisplaySignal('bt2390')).toBe('rec709-tonemapped')
+    expect(hdrDisplaySignal('none')).toBe('rec709-clipped')
+  })
+})
