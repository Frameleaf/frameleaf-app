+    useItemsStore.getState().setItems([{
+      id: 'clip', type: 'video', trackId: 'video', from: 0, durationInFrames: 60,
+      label: 'Clip', src: 'blob:clip', mediaId: 'media-hdr',
+    }] as never)
+    useMediaLibraryStore.setState({
+      mediaById: { 'media-hdr': { id: 'media-hdr', colorTransfer } } as never,
+    })
+    usePreviewBridgeStore.setState({
+      scopeColor: () => ({ workingRange: colorTransfer ? 'hdr' : 'sdr', sdrMonitoring }),
+    })
+  }
+
+  /** A 2×1 PQ frame: 100 cd/m² on the left, 1,000 cd/m² on the right. */
+  const pqFrame = (frame: number) => ({
+    frame,
+    width: 2,
+    height: 1,
+    rgba: new Float32Array([
+      pqEncode(100), pqEncode(100), pqEncode(100), 1,
+      pqEncode(1000), pqEncode(1000), pqEncode(1000), 1,
+    ]),
+  })
+
+  async function tick(time: number) {
+    await act(async () => {
+      const pending = [...callbacks.values()]
+      callbacks.clear()
+      for (const callback of pending) callback(time)
+    })
+  }
+
