+/**
+ * What the colour scopes measure, as numbers (FL-98).
+ *
+ * The scope views draw these; the GPU scopes compute the same mapping in WGSL
+ * (`infrastructure/gpu-scopes`). Keeping the CPU math here, free of any canvas,
+ * lets reference ramps and bars check the placement exactly.
+ */
+import { pqEncode } from '@/shared/graphics/color/managed-color'
+
+/** The pixels a scope sample holds: 8-bit RGBA, as `ImageData` carries them. */
+export interface ScopePixels {
+  readonly data: ArrayLike<number>
+  readonly width: number
+  readonly height: number
+}
+
+export interface LumaCoefficients {
+  kr: number
+  kb: number
+}
+
+export const BT709_COEFFICIENTS: LumaCoefficients = { kr: 0.2126, kb: 0.0722 }
+export const BT2020_COEFFICIENTS: LumaCoefficients = { kr: 0.2627, kb: 0.0593 }
+
+/**
+ * The signal a scope measured, which fixes its colour space and graticule:
+ *
+ * - `rec709-display`: an SDR project's preview pixels, sRGB/BT.709 display values, full range.
+ * - `pq-bt2020`: an HDR project's float composite, converted explicitly to BT.2100 PQ in
+ *   BT.2020 (FL-97), so 1.0 is 10,000 cd/m² and reference white (203 cd/m²) sits near 58%.
+ * - `rec709-tonemapped`: an HDR project's SDR preview, tone mapped with BT.2390 for the display.
+ * - `rec709-clipped`: an HDR project's SDR preview when its monitoring clips instead.
+ *
+ * Scopes read an HDR project's display while playing, or when its float composite cannot be
+ * read, and say so.
+ */
+export type ScopeSignal = 'rec709-display' | 'pq-bt2020' | 'rec709-tonemapped' | 'rec709-clipped'
+
+export const SCOPE_SIGNAL_LABELS: Record<ScopeSignal, string> = {
+  'rec709-display': 'sRGB / Rec.709 display, full range',
+  'pq-bt2020': 'BT.2100 PQ · BT.2020 · 1.0 = 10,000 cd/m²',
+  'rec709-tonemapped': 'Tone-mapped SDR preview (BT.2390) · HDR project',
+  'rec709-clipped': 'Clipped SDR preview · HDR project',
+}
+
+/** What an HDR project's display canvas holds, by its SDR monitoring policy. */
+export const hdrDisplaySignal = (sdrMonitoring: 'bt2390' | 'none'): ScopeSignal =>
+  sdrMonitoring === 'none' ? 'rec709-clipped' : 'rec709-tonemapped'
+
+export const scopeCoefficients = (signal: ScopeSignal): LumaCoefficients =>
+  signal === 'pq-bt2020' ? BT2020_COEFFICIENTS : BT709_COEFFICIENTS
+
+export interface ScopeGuide {
+  /** Height in the scope, 0–100 from the bottom. */
+  position: number
+  label: string
+}
+
+/** IRE for display-referred scopes; cd/m² at their PQ code values for HDR. */
+export function scopeGuides(signal: ScopeSignal): ScopeGuide[] {
+  if (signal !== 'pq-bt2020') {
+    return [0, 25, 50, 75, 100].map((level) => ({ position: level, label: String(level) }))
+  }
+  return [
+    [0, '0'],
+    [100, '100'],
+    [203, '203'],
+    [1000, '1k'],
+    [4000, '4k'],
+    [10000, '10k nits'],
+  ].map(([nits, label]) => ({ position: pqEncode(nits as number) * 100, label: label as string }))
+}
+
+/** The vectorscope's 100% ring as a fraction of its size; the GPU scope uses 0.92 × 0.5. */
+export const VECTORSCOPE_SCALE = 0.46
+
+/** Where a colour lands on a vectorscope of `size`: x right for +Cb, y down for −Cr. */
+export function vectorscopePoint(
+  r: number,
+  g: number,
+  b: number,
+  { kr, kb }: LumaCoefficients,
+  size: number,
+): { x: number; y: number } {
+  const y = kr * r + (1 - kr - kb) * g + kb * b
+  const cb = (b - y) / (2 * (1 - kb))
+  const cr = (r - y) / (2 * (1 - kr))
+  const center = size / 2
+  const scale = size * VECTORSCOPE_SCALE
+  return { x: center + cb * 2 * scale, y: center - cr * 2 * scale }
+}
+
+/**
+ * The level of the colour bars the vectorscope targets mark: 75% for SDR, and for PQ the
+ * BT.2111 HDR bars, whose colours sit at reference white (203 cd/m², about 58% PQ).
+ */
+export const scopeBarLevel = (signal: ScopeSignal): number => (signal === 'pq-bt2020' ? pqEncode(203) : 0.75)
+
+const BARS_75 = [
+  ['R', 0.75, 0, 0],
+  ['Mg', 0.75, 0, 0.75],
+  ['B', 0, 0, 0.75],
+  ['Cy', 0, 0.75, 0.75],
+  ['G', 0, 0.75, 0],
+  ['Yl', 0.75, 0.75, 0],
+] as const
+
+/** Colour bars at `level` on a 100-unit vectorscope with these coefficients: the target boxes. */
+export function vectorscopeTargets(coefficients: LumaCoefficients, level = 0.75) {
+  return BARS_75.map(([label, r, g, b]) => {
+    const scale = level / 0.75
+    const { x, y } = vectorscopePoint(r * scale, g * scale, b * scale, coefficients, 100)
+    return { label, x: Math.round(x * 10) / 10, y: Math.round(y * 10) / 10 }
+  })
+}
+
+export const VECTORSCOPE_75_TARGETS = vectorscopeTargets(BT709_COEFFICIENTS)
+
+/** The skin-tone line, 123° from +Cb, on a 100-unit vectorscope (as the GPU graticule draws it). */
+export const VECTORSCOPE_SKIN_LINE = {
+  x: 50 + 100 * VECTORSCOPE_SCALE * Math.cos((123 * Math.PI) / 180),
+  y: 50 - 100 * VECTORSCOPE_SCALE * Math.sin((123 * Math.PI) / 180),
+}
+
+function forEachPixel(
+  pixels: ScopePixels,
+  callback: (x: number, r: number, g: number, b: number) => void,
+): void {
+  const { data, width, height } = pixels
+  for (let y = 0; y < height; y++) {
+    for (let x = 0; x < width; x++) {
+      const i = (y * width + x) * 4
+      callback(x, (data[i] ?? 0) / 255, (data[i + 1] ?? 0) / 255, (data[i + 2] ?? 0) / 255)
+    }
+  }
+}
+
+const clamp01 = (value: number) => Math.max(0, Math.min(1, value))
+
+export interface Density {
+  counts: Uint32Array
+  max: number
+}
+
+function bump(density: Density, index: number): void {
+  const next = (density.counts[index] ?? 0) + 1
+  density.counts[index] = next
+  if (next > density.max) density.max = next
+}
+
+/** Waveform: a luma column per sample column, rows from 0 (bottom) to full scale (top). */
+export function waveformDensity(
+  pixels: ScopePixels,
+  { kr, kb }: LumaCoefficients,
+  w: number,
+  h: number,
+): Density {
+  const density = { counts: new Uint32Array(w * h), max: 0 }
+  const kg = 1 - kr - kb
+  forEachPixel(pixels, (x, r, g, b) => {
+    const luma = clamp01(kr * r + kg * g + kb * b)
+    const px = Math.floor((x / Math.max(1, pixels.width - 1)) * (w - 1))
+    const py = h - 1 - Math.floor(luma * (h - 1))
+    bump(density, py * w + px)
+  })
+  return density
+}
+
+/** RGB parade: three lanes side by side, R then G then B. */
+export function paradeDensity(pixels: ScopePixels, w: number, h: number): Density {
+  const density = { counts: new Uint32Array(w * h), max: 0 }
+  const lane = Math.floor(w / 3)
+  forEachPixel(pixels, (x, r, g, b) => {
+    const lx = Math.floor((x / Math.max(1, pixels.width - 1)) * (lane - 1))
+    for (const [channel, value] of [r, g, b].entries()) {
+      const py = h - 1 - Math.floor(clamp01(value) * (h - 1))
+      bump(density, py * w + channel * lane + lx)
+    }
+  })
+  return density
+}
+
+/** Luma histogram in 256 bins. */
+export function histogramBins(pixels: ScopePixels, { kr, kb }: LumaCoefficients): Density {
+  const density = { counts: new Uint32Array(256), max: 0 }
+  const kg = 1 - kr - kb
+  forEachPixel(pixels, (_x, r, g, b) => {
+    bump(density, Math.round(clamp01(kr * r + kg * g + kb * b) * 255))
+  })
+  return density
+}
+
+/** Vectorscope density on a `size` square. */
+export function vectorscopeDensity(
+  pixels: ScopePixels,
+  coefficients: LumaCoefficients,
+  size: number,
+): Density {
+  const density = { counts: new Uint32Array(size * size), max: 0 }
+  forEachPixel(pixels, (_x, r, g, b) => {
+    const point = vectorscopePoint(r, g, b, coefficients, size)
+    const px = Math.round(point.x)
+    const py = Math.round(point.y)
+    if (px < 0 || px >= size || py < 0 || py >= size) return
+    bump(density, py * size + px)
+  })
+  return density
+}
+
+/**
+ * A float signal frame (straight-alpha RGBA in [0, 1], from the render engine's explicit
+ * output conversion) sampled down to `width` × `height` 8-bit pixels for the scopes. Each
+ * output pixel averages its source box. 8 bits resolve a PQ step of about 0.4%: about two rows
+ * of the 512-row GPU waveform, which its vertical spread smooths over; enough for monitoring.
+ */
+export function signalToScopePixels(
+  signal: { width: number; height: number; rgba: Float32Array },
+  width: number,
+  height: number,
+): ScopePixels & { data: Uint8ClampedArray<ArrayBuffer> } {
+  const w = Math.max(1, Math.min(width, signal.width))
+  const h = Math.max(1, Math.min(height, signal.height))
+  const data = new Uint8ClampedArray(w * h * 4)
+  for (let y = 0; y < h; y++) {
+    const y0 = Math.floor((y * signal.height) / h)
+    const y1 = Math.max(y0 + 1, Math.floor(((y + 1) * signal.height) / h))
+    for (let x = 0; x < w; x++) {
+      const x0 = Math.floor((x * signal.width) / w)
+      const x1 = Math.max(x0 + 1, Math.floor(((x + 1) * signal.width) / w))
+      let r = 0
+      let g = 0
+      let b = 0
+      let n = 0
+      for (let sy = y0; sy < y1; sy++) {
+        for (let sx = x0; sx < x1; sx++) {
+          const i = (sy * signal.width + sx) * 4
+          r += signal.rgba[i] ?? 0
+          g += signal.rgba[i + 1] ?? 0
+          b += signal.rgba[i + 2] ?? 0
+          n += 1
+        }
+      }
+      const o = (y * w + x) * 4
+      data[o] = Math.round(clamp01(r / n) * 255)
+      data[o + 1] = Math.round(clamp01(g / n) * 255)
+      data[o + 2] = Math.round(clamp01(b / n) * 255)
+      data[o + 3] = 255
+    }
+  }
+  return { data, width: w, height: h }
+}
+
+/**
+ * Whether playback jumped rather than advanced between two playhead updates: backwards (a
+ * loop or a seek) or further than playback moves in the time between them, with room for a
+ * few dropped frames. A scope sample captured before a jump shows a frame no longer playing.
+ */
+export function isPlaybackJump(
+  previous: { frame: number; atMs: number },
+  next: { frame: number; atMs: number },
+  fps: number,
+  rate = 1,
+): boolean {
+  const step = (next.frame - previous.frame) * Math.sign(rate || 1)
+  if (step < 0) return true
+  const expected = (Math.max(0, next.atMs - previous.atMs) / 1000) * fps * Math.abs(rate || 1)
+  return step > expected + 4
+}
