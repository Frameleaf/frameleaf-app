--- /dev/null
+++ b/src/features/preview/utils/scope-signal.ts
@@ -0,0 +1,52 @@
+/**
+ * What an HDR project's scopes measure, and how they get it (FL-98).
+ *
+ * The preview decides a project's working range as its renderer does (FL-97): HDR once a PQ or
+ * HLG source is placed, directly or in a nested composition, or when the project's colour
+ * management asks for it. The scopes of an HDR project measure the float composite converted
+ * explicitly to PQ, rendered by a renderer that draws everything the preview shows, titles
+ * included, and that never writes to the preview's own canvas or frame cache.
+ */
+import {
+  resolveColorManagement,
+  type ProjectColorManagement,
+} from '@/shared/graphics/color/managed-color'
+import type { PreviewScopeColor, PreviewSignalFrame } from '@/shared/state/preview-bridge'
+import { deriveSourceWorkingRange } from '@/features/preview/deps/project-color'
+import { useMediaLibraryStore } from '@/features/preview/deps/media-library'
+import { useCompositionsStore } from '@/features/preview/deps/timeline-store'
+
+/** The preview's colour management, from the same inputs its renderer resolves it from. */
+export function resolveScopeColor(input: {
+  colorManagement: ProjectColorManagement | undefined
+  tracks: readonly { items?: readonly unknown[] }[]
+}): PreviewScopeColor {
+  const { mediaById } = useMediaLibraryStore.getState()
+  const range = deriveSourceWorkingRange(
+    input.tracks as never,
+    (mediaId) => mediaById[mediaId],
+    useCompositionsStore.getState().compositionById,
+  )
+  const resolved = resolveColorManagement(input.colorManagement, range)
+  return { workingRange: resolved.workingRange, sdrMonitoring: resolved.sdrMonitoring }
+}
+
+interface SignalRenderer {
+  renderFrameSignal(
+    frame: number,
+    target: 'pq',
+  ): Promise<{ width: number; height: number; rgba: Float32Array }>
+  setDomVideoElementProvider?: (provider: undefined) => void
+}
+
+/** `frame` of an HDR project as a PQ signal frame, decoded rather than read from playing video. */
+export async function captureScopeSignal(
+  renderer: SignalRenderer,
+  frame: number,
+  target: 'pq',
+): Promise<PreviewSignalFrame> {
+  // Paused frames decode their sources; the live <video> elements belong to playback.
+  renderer.setDomVideoElementProvider?.(undefined)
+  const signal = await renderer.renderFrameSignal(frame, target)
+  return { frame, ...signal }
+}
