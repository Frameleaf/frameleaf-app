+describe('scopes name what they measure (FL-98)', () => {
+  let callbacks: Map<number, FrameRequestCallback>
+  let callbackId: number
+  let renderer: Record<string, ReturnType<typeof vi.fn>>
+
+  /** A project the preview resolves as HDR (a PQ clip) or SDR, as its renderer would. */
