+/** Replace a source while keeping a disk backup until metadata commits. */
+export async function replaceMediaSource(
+  mediaId: string,
+  blob: Blob,
+  fileName: string | undefined,
+): Promise<{ restore: () => Promise<void>; discard: () => Promise<void> }> {
+  const root = requireWorkspaceRoot()
+  const existing = await findSourceSegments(root, mediaId)
+  const previous = existing ? await readBlob(root, existing) : null
+  if (existing && !previous) throw new Error(`Cannot back up media source: ${mediaId}`)
+  const path = existing ?? mediaSourceByFileName(mediaId, fileName ?? 'source.bin')
+  const backup = existing ? [...mediaDir(mediaId), 'cache', `relink-${crypto.randomUUID()}.bak`] : null
+  if (backup && previous) await writeBlob(root, backup, previous)
+  const restore = async () => {
+    if (backup) {
+      const saved = await readBlob(root, backup)
+      if (!saved) throw new Error(`Relink backup missing: ${mediaId}`)
+      await writeBlob(root, path, saved)
+      await removeEntry(root, backup)
+    } else {
+      await removeEntry(root, path)
+    }
+  }
+  try {
+    await writeBlob(root, path, blob)
+  } catch (error) {
+    try {
+      await restore()
+    } catch (rollbackError) {
+      throw new AggregateError([error, rollbackError], 'Media source replacement failed to roll back')
+    }
+    throw error
+  }
+  return {
+    restore,
+    discard: async () => {
+      if (backup) await removeEntry(root, backup)
+    },
+  }
+}
