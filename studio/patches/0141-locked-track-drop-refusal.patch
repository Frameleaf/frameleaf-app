index 0000000..901d4d4
--- /dev/null
+++ b/src/features/timeline/utils/locked-track-refusal.test.ts
@@ -0,0 +1,118 @@
+// @vitest-environment node
+
+import { describe, expect, it } from 'vite-plus/test'
+import { makeTimelineTrack, makeTwoVideoTwoAudioTimelineTracks } from '@/features/timeline/test-helpers'
+import {
+  dragTargetsLockedTrack,
+  getEffectivelyLockedTrackIds,
+  isTimelineDropPayload,
+  placementsTouchLockedTrack,
+} from './locked-track-refusal'
+
+const lock = (tracks: ReturnType<typeof makeTwoVideoTwoAudioTimelineTracks>, ...ids: string[]) =>
+  tracks.map((track) => (ids.includes(track.id) ? { ...track, locked: true } : track))
+
+describe('FL-450 locked track refusal', () => {
+  it('treats a lane in a locked Layer Group as locked', () => {
+    const tracks = [
+      makeTimelineTrack({ id: 'group', name: 'Group', order: 0, isGroup: true, locked: true }),
+      makeTimelineTrack({ id: 'child', name: 'V1', kind: 'video', order: 1, parentTrackId: 'group' }),
+      makeTimelineTrack({ id: 'free', name: 'V2', kind: 'video', order: 2 }),
+    ]
+
+    expect([...getEffectivelyLockedTrackIds(tracks)]).toEqual(['child'])
+    expect(placementsTouchLockedTrack(tracks, [{ trackId: 'child' }])).toBe(true)
+    expect(placementsTouchLockedTrack(tracks, [{ trackId: 'free' }])).toBe(false)
+  })
+
+  it('announces only drags that carry something the timeline places', () => {
+    expect(isTimelineDropPayload({ types: ['application/json'] })).toBe(true)
+    expect(isTimelineDropPayload({ types: ['Files'] })).toBe(true)
+    expect(isTimelineDropPayload({ types: ['text/plain'] })).toBe(false)
+    expect(isTimelineDropPayload(null)).toBe(false)
+  })
+
+  it('refuses a clip dragged over a locked lane, but not one kept on its own lane', () => {
+    const tracks = lock(makeTwoVideoTwoAudioTimelineTracks(), 'v2')
+    const draggedItems = [{ id: 'clip', initialTrackId: 'v1' }]
+
+    expect(
+      dragTargetsLockedTrack({
+        tracks,
+        startTrackId: 'v1',
+        dropTarget: { trackId: 'v2' },
+        draggedItems,
+        anchorTrackId: null,
+      }),
+    ).toBe(true)
+    expect(
+      dragTargetsLockedTrack({
+        tracks,
+        startTrackId: 'v1',
+        dropTarget: { trackId: 'v1' },
+        draggedItems,
+        anchorTrackId: 'v1',
+      }),
+    ).toBe(false)
+    // A new lane made by the drag is never locked, whichever row names its section.
+    expect(
+      dragTargetsLockedTrack({
+        tracks,
+        startTrackId: 'v1',
+        dropTarget: { trackId: 'v2', createNew: true },
+        draggedItems,
+        anchorTrackId: 'new-track',
+        trackAssignments: new Map([['clip', 'new-track']]),
+      }),
+    ).toBe(false)
+  })
+
+  it('refuses when a linked companion would land on a locked audio lane', () => {
+    const tracks = lock(makeTwoVideoTwoAudioTimelineTracks(), 'a2')
+
+    expect(
+      dragTargetsLockedTrack({
+        tracks,
+        startTrackId: 'v1',
+        dropTarget: { trackId: 'v2' },
+        draggedItems: [
+          { id: 'video', initialTrackId: 'v1' },
+          { id: 'audio', initialTrackId: 'a1' },
+        ],
+        anchorTrackId: 'v2',
+        trackAssignments: new Map([
+          ['video', 'v2'],
+          ['audio', 'a2'],
+        ]),
+      }),
+    ).toBe(true)
+  })
+
+  it('refuses when another selected clip would follow the anchor onto a locked lane', () => {
+    const tracks = lock(makeTwoVideoTwoAudioTimelineTracks(), 'a1')
+    const draggedItems = [
+      { id: 'anchor', initialTrackId: 'v1' },
+      { id: 'other', initialTrackId: 'v2' },
+    ]
+
+    // Moving the anchor from V1 to V2 carries the V2 clip one lane down, onto locked A1.
+    expect(
+      dragTargetsLockedTrack({
+        tracks,
+        startTrackId: 'v1',
+        dropTarget: { trackId: 'v2' },
+        draggedItems,
+        anchorTrackId: 'v2',
+      }),
+    ).toBe(true)
+    expect(
+      dragTargetsLockedTrack({
+        tracks: makeTwoVideoTwoAudioTimelineTracks(),
+        startTrackId: 'v1',
+        dropTarget: { trackId: 'v2' },
+        draggedItems,
+        anchorTrackId: 'v2',
+      }),
+    ).toBe(false)
+  })
+})
diff --git a/src/features/timeline/utils/locked-track-refusal.ts b/src/features/timeline/utils/locked-track-refusal.ts
new file mode 100644
index 0000000..3667b0b
--- /dev/null
+++ b/src/features/timeline/utils/locked-track-refusal.ts
@@ -0,0 +1,85 @@
+import type { TimelineTrack } from '@/types/timeline'
+import { resolveEffectiveTrackStates } from './group-utils'
+
+/**
+ * Frameleaf (FL-450): a drag or add never lands a clip on a locked lane. A lane is locked when it
+ * or its Layer Group is locked.
+ */
+export function getEffectivelyLockedTrackIds(tracks: TimelineTrack[]): Set<string> {
+  return new Set(
+    resolveEffectiveTrackStates(tracks)
+      .filter((track) => track.locked)
+      .map((track) => track.id),
+  )
+}
+
+/**
+ * Whether a browser drag carries something the timeline would place: library media, a compound
+ * clip or template (`application/json`), or files. Other drags are not announced as refused.
+ */
+export function isTimelineDropPayload(dataTransfer: Pick<DataTransfer, 'types'> | null | undefined): boolean {
+  const types = Array.from(dataTransfer?.types ?? [])
+  return types.includes('Files') || types.includes('application/json')
+}
+
+/** Whether any placement of a planned drop or add would write to a locked lane. */
+export function placementsTouchLockedTrack(
+  tracks: TimelineTrack[],
+  placements: ReadonlyArray<{ trackId: string }>,
+): boolean {
+  const locked = getEffectivelyLockedTrackIds(tracks)
+  return locked.size > 0 && placements.some((placement) => locked.has(placement.trackId))
+}
+
+/** Where one dragged clip would land: the resolved assignment, or the anchor's track offset. */
+function resolveDraggedDestination(params: {
+  tracks: TimelineTrack[]
+  startTrackId: string
+  anchorTrackId: string
+  draggedItem: { id: string; initialTrackId: string }
+  draggedCount: number
+  trackAssignments?: ReadonlyMap<string, string>
+}): string {
+  const { tracks, startTrackId, anchorTrackId, draggedItem, draggedCount, trackAssignments } = params
+  const assigned = trackAssignments?.get(draggedItem.id)
+  if (assigned) return assigned
+  if (draggedCount <= 1) return anchorTrackId
+  // The same index offset the drag commit applies to every other selected clip.
+  const anchorIndex = tracks.findIndex((track) => track.id === startTrackId)
+  const itemIndex = tracks.findIndex((track) => track.id === draggedItem.initialTrackId)
+  const newAnchorIndex = tracks.findIndex((track) => track.id === anchorTrackId)
+  const newIndex = Math.max(0, Math.min(tracks.length - 1, newAnchorIndex + itemIndex - anchorIndex))
+  return tracks[newIndex]?.id || draggedItem.initialTrackId
+}
+
+/**
+ * Whether a clip drag points at a locked lane: the hovered row, or the lane any dragged clip
+ * (including a linked companion) would move to. A clip staying on its own lane never refuses.
+ */
+export function dragTargetsLockedTrack(params: {
+  tracks: TimelineTrack[]
+  startTrackId: string
+  dropTarget: { trackId: string; createNew?: boolean }
+  draggedItems: ReadonlyArray<{ id: string; initialTrackId: string }>
+  anchorTrackId: string | null
+  trackAssignments?: ReadonlyMap<string, string>
+}): boolean {
+  const { tracks, startTrackId, dropTarget, draggedItems, anchorTrackId, trackAssignments } = params
+  const locked = getEffectivelyLockedTrackIds(tracks)
+  if (locked.size === 0) return false
+  if (!dropTarget.createNew && dropTarget.trackId !== startTrackId && locked.has(dropTarget.trackId)) {
+    return true
+  }
+  const anchor = anchorTrackId ?? startTrackId
+  return draggedItems.some((draggedItem) => {
+    const destination = resolveDraggedDestination({
+      tracks,
+      startTrackId,
+      anchorTrackId: anchor,
+      draggedItem,
+      draggedCount: draggedItems.length,
+      trackAssignments,
+    })
+    return destination !== draggedItem.initialTrackId && locked.has(destination)
+  })
+}
