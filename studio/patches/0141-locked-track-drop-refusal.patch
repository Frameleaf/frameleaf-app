@@ -0,0 +1,68 @@
+// @vitest-environment node
+
+import { describe, expect, it } from 'vite-plus/test'
+import { makeTwoVideoTwoAudioTimelineTracks } from '@/features/timeline/test-helpers'
+import { planTrackMediaDropPlacements } from './track-media-drop'
+
+const entry = (hasLinkedAudio: boolean) => ({
+  payload: { id: 'media' },
+  label: 'clip.mp4',
+  mediaType: 'video' as const,
+  durationInFrames: 60,
+  hasLinkedAudio,
+})
+
+describe('FL-450 media drops never land on a locked lane', () => {
+  it('refuses a video whose linked sound would go on a locked audio track', () => {
+    const tracks = makeTwoVideoTwoAudioTimelineTracks().map((track) =>
+      track.id === 'a1' ? { ...track, locked: true } : track,
+    )
+
+    const result = planTrackMediaDropPlacements({
+      entries: [entry(true)],
+      dropFrame: 0,
+      tracks,
+      existingItems: [],
+      dropTargetTrackId: 'v1',
+    })
+
+    expect(result.plannedItems).toEqual([])
+    expect(result.lockedRefusals).toBe(1)
+  })
+
+  it('still places a silent video on an unlocked lane above a locked audio track', () => {
+    const tracks = makeTwoVideoTwoAudioTimelineTracks().map((track) =>
+      track.id === 'a1' ? { ...track, locked: true } : track,
+    )
+
+    const result = planTrackMediaDropPlacements({
+      entries: [entry(false)],
+      dropFrame: 0,
+      tracks,
+      existingItems: [],
+      dropTargetTrackId: 'v1',
+    })
+
+    expect(result.lockedRefusals).toBe(0)
+    expect(result.plannedItems[0]!.placements).toEqual([
+      expect.objectContaining({ trackId: 'v1', mediaType: 'video', from: 0 }),
+    ])
+  })
+
+  it('refuses a drop targeted at a locked lane', () => {
+    const tracks = makeTwoVideoTwoAudioTimelineTracks().map((track) =>
+      track.id === 'v2' ? { ...track, locked: true } : track,
+    )
+
+    const result = planTrackMediaDropPlacements({
+      entries: [entry(false)],
+      dropFrame: 0,
+      tracks,
+      existingItems: [],
+      dropTargetTrackId: 'v2',
+    })
+
+    expect(result.plannedItems).toEqual([])
+    expect(result.lockedRefusals).toBe(1)
+  })
+})
