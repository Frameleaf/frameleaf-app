+import { act, fireEvent, render, screen, waitFor } from '@testing-library/react'
+import { beforeEach, describe, expect, it, vi } from 'vite-plus/test'
+import type { VideoItem } from '@/types/timeline'
+import { useItemsStore, useTimelineStore } from '@/features/editor/deps/timeline-store'
+import { useGizmoStore } from '@/features/editor/deps/preview'
+import { TooltipProvider } from '@/components/ui/tooltip'
+import { VideoSection } from './video-section'
+import { LayoutSection } from './layout-section'
+
+vi.mock('react-i18next', () => ({ useTranslation: () => ({ t: (key: string) => key }) }))
+
+const ITEM: VideoItem = {
+  id: 'keyboard-video',
+  type: 'video',
+  trackId: 'track-1',
+  from: 0,
+  durationInFrames: 90,
+  label: 'Video',
+  src: 'blob:video',
+  mediaId: 'media-1',
+  sourceWidth: 1920,
+  sourceHeight: 1080,
+  crop: { left: 0.1, right: 0.2, top: 0.05, bottom: 0.15, softness: 0 },
+  transform: { x: 15, y: 25, width: 960, height: 540, rotation: 0, opacity: 1 },
+}
+
+function Inspector({ rotation = false }: { rotation?: boolean }) {
+  const items = useItemsStore((state) => state.items)
+  return rotation ? (
+    <LayoutSection
+      items={items}
+      canvas={{ width: 1920, height: 1080, fps: 30 }}
+      onTransformChange={useTimelineStore.getState().updateItemsTransform}
+      aspectLocked={false}
+      onAspectLockToggle={() => {}}
+    />
+  ) : (
+    <VideoSection items={items} />
+  )
+}
+
+async function edit(name: string, value: string, key = 'Enter') {
+  const entry = screen.getByRole('button', { name })
+  expect(entry.tagName).toBe('BUTTON')
+  expect(entry).toBeEnabled()
+  entry.focus()
+  expect(entry).toHaveFocus()
+  // JSDOM exercises native-button semantics and the activation handler, not real Tab/Enter synthesis.
+  fireEvent.click(entry)
+  const input = screen.getByRole('textbox', { name })
+  expect(input).toHaveFocus()
+  fireEvent.change(input, { target: { value } })
+  fireEvent.keyDown(input, { key })
+  await waitFor(() => expect(screen.getByRole('button', { name })).toHaveFocus())
+}
+
+describe('real crop and rotation value entry', () => {
+  beforeEach(() => {
+    useTimelineStore.setState({ keyframes: [], fps: 30 })
+    useItemsStore.getState().setItems([structuredClone(ITEM)])
+    useItemsStore.getState().setTracks([
+      {
+        id: 'track-1',
+        name: 'Track',
+        order: 0,
+        height: 72,
+        items: [],
+        locked: false,
+        visible: true,
+        muted: false,
+        solo: false,
+      },
+    ])
+    useGizmoStore.setState({
+      activeGizmo: null,
+      previewTransform: null,
+      presentationHandoff: null,
+      preview: null,
+    })
+    useTimelineStore.temporal.getState().clear()
+  })
+
+  it('names all crop edges and commits source pixels through one undoable canonical edit', async () => {
+    render(
+      <TooltipProvider>
+        <Inspector />
+      </TooltipProvider>,
+    )
+    for (const edge of ['Left', 'Right', 'Top', 'Bottom'])
+      expect(screen.getByRole('button', { name: `editor.videoSection.crop${edge}` })).toBeEnabled()
+    const before = structuredClone(useItemsStore.getState().items)
+    await edit('editor.videoSection.cropLeft', '384')
+    const after = structuredClone(useItemsStore.getState().items)
+    expect(after[0]!.crop).toEqual({ ...ITEM.crop, left: 0.2 })
+    expect(after[0]!.transform).toEqual(ITEM.transform)
+    expect(useTimelineStore.temporal.getState().pastStates).toHaveLength(1)
+    act(() => useTimelineStore.temporal.getState().undo())
+    expect(useItemsStore.getState().items).toEqual(before)
+    act(() => useTimelineStore.temporal.getState().redo())
+    expect(useItemsStore.getState().items).toEqual(after)
+  })
+
+  it('cancels crop text without canonical mutation or history', async () => {
+    render(
+      <TooltipProvider>
+        <Inspector />
+      </TooltipProvider>,
+    )
+    await edit('editor.videoSection.cropTop', '300', 'Escape')
+    expect(useItemsStore.getState().items).toEqual([ITEM])
+    expect(useTimelineStore.temporal.getState().pastStates).toHaveLength(0)
+  })
+
+  it('commits a bounded rotation through the existing transform callback and undo/redo', async () => {
+    render(
+      <TooltipProvider>
+        <Inspector rotation />
+      </TooltipProvider>,
+    )
+    const before = structuredClone(useItemsStore.getState().items)
+    await edit('editor.layoutSection.rotation', '230')
+    const after = structuredClone(useItemsStore.getState().items)
+    expect(after[0]!.transform).toEqual({ ...ITEM.transform, rotation: 180 })
+    expect(after[0]!.crop).toEqual(ITEM.crop)
+    expect(useTimelineStore.temporal.getState().pastStates).toHaveLength(1)
+    act(() => useTimelineStore.temporal.getState().undo())
+    expect(useItemsStore.getState().items).toEqual(before)
+    act(() => useTimelineStore.temporal.getState().redo())
+    expect(useItemsStore.getState().items).toEqual(after)
+  })
+
+  it.each([
+    ['cropLeft', 'editor.videoSection.cropLeft', '384', 384, false],
+    ['rotation', 'editor.layoutSection.rotation', '35', 35, true],
+  ] as const)(
+    'routes existing %s animation through its keyframe lane',
+    async (property, name, typed, value, rotation) => {
+      useTimelineStore.setState({
+        keyframes: [
+          {
+            itemId: ITEM.id,
+            properties: [
+              {
+                property,
+                keyframes: [{ id: 'existing-key', frame: 0, value: 0, easing: 'linear' }],
+              },
+            ],
+          },
+        ],
+      })
+      useTimelineStore.temporal.getState().clear()
+      render(
+        <TooltipProvider>
+          <Inspector rotation={rotation} />
+        </TooltipProvider>,
+      )
+      const before = structuredClone(useItemsStore.getState().items)
+      await edit(name, typed)
+      expect(useItemsStore.getState().items).toEqual(before)
+      expect(useTimelineStore.getState().keyframes[0]!.properties[0]!.keyframes).toEqual([
+        { id: 'existing-key', frame: 0, value, easing: 'linear' },
+      ])
+      expect(useTimelineStore.temporal.getState().pastStates).toHaveLength(1)
+      act(() => useTimelineStore.temporal.getState().undo())
+      expect(useTimelineStore.getState().keyframes[0]!.properties[0]!.keyframes[0]!.value).toBe(0)
+      act(() => useTimelineStore.temporal.getState().redo())
+      expect(useTimelineStore.getState().keyframes[0]!.properties[0]!.keyframes[0]!.value).toBe(
+        value,
+      )
+    },
+  )
+})
