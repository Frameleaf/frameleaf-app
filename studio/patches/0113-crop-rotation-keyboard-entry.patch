+describe('SliderInput native value entry', () => {
+  it('opens the named native entry and commits once with focus restored', async () => {
+    const onChange = vi.fn()
+    render(
+      <SliderInput label="Crop left" value={5} onChange={onChange} min={0} max={10} step={1} />,
+    )
+    const entry = screen.getByRole('button', { name: 'Crop left' })
+    expect(entry.tagName).toBe('BUTTON')
+    expect(entry).toBeEnabled()
+    entry.focus()
+    expect(entry).toHaveFocus()
+    // Native button activation is supplied by the browser; this exercises its click handler.
+    fireEvent.click(entry)
+    const input = screen.getByRole('textbox', { name: 'Crop left' })
+    expect(input).toHaveFocus()
+    fireEvent.change(input, { target: { value: '15' } })
+    fireEvent.keyDown(input, { key: 'Enter' })
+    await waitFor(() => expect(screen.getByRole('button', { name: 'Crop left' })).toHaveFocus())
+    expect(onChange).toHaveBeenCalledTimes(1)
+    expect(onChange).toHaveBeenCalledWith(10)
+  })
+
+  it('cancels without commit and returns focus to the named entry', async () => {
+    const onChange = vi.fn()
+    render(<SliderInput label="Rotation" value={5} onChange={onChange} min={-180} max={180} />)
+    fireEvent.click(screen.getByRole('button', { name: 'Rotation' }))
+    const input = screen.getByRole('textbox', { name: 'Rotation' })
+    fireEvent.change(input, { target: { value: '30' } })
+    fireEvent.keyDown(input, { key: 'Escape' })
+    await waitFor(() => expect(screen.getByRole('button', { name: 'Rotation' })).toHaveFocus())
+    expect(onChange).not.toHaveBeenCalled()
+    expect(screen.getByText('5')).toBeInTheDocument()
+  })
+
+  it('keeps a disabled native entry closed', () => {
+    render(
+      <SliderInput label="Rotation" value={5} onChange={vi.fn()} min={-180} max={180} disabled />,
+    )
+    const entry = screen.getByRole('button', { name: 'Rotation' })
+    expect(entry).toBeDisabled()
+    fireEvent.click(entry)
+    expect(screen.queryByRole('textbox')).not.toBeInTheDocument()
+  })
+})
