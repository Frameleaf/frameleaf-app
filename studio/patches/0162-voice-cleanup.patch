+// @vitest-environment node
+
+import { beforeEach, describe, expect, it } from 'vite-plus/test'
+import type { AudioItem, TimelineTrack } from '@/types/timeline'
+import { useItemsStore } from '../../items-store'
+import { useTimelineCommandStore } from '../../timeline-command-store'
+import { useTimelineSettingsStore } from '../../timeline-settings-store'
+import { buildTimelineFromStores } from '../../timeline-persistence'
+import { applyVoiceCleanup, restoreOriginalSound, voiceCleanupOriginal, type VoiceCleanupResult } from './voice-cleanup-actions'
+
+const track = (id: string, locked = false) => ({
+  id, name: id, order: 0, height: 80, locked, syncLock: true, visible: true, muted: false,
+  solo: false, volume: 0, items: [], kind: 'audio',
+}) as TimelineTrack
+
+const audio = (overrides: Partial<AudioItem> = {}): AudioItem => ({
+  id: 'a1', type: 'audio', trackId: 't1', from: 90, durationInFrames: 120, label: 'Beach walk',
+  src: 'blob:a', mediaId: 'm1', sourceStart: 300, sourceEnd: 420, sourceDuration: 1800, sourceFps: 30,
+  volume: -2, ...overrides,
+} as AudioItem)
+
+const cleaned: VoiceCleanupResult = {
+  importId: 'cleaned-1', strength: 'standard', noises: ['wind', 'background'], humHz: null,
+  sourceStartSeconds: 1, durationSeconds: 6,
+}
+
+const item = (id = 'a1') => useItemsStore.getState().items.find((candidate) => candidate.id === id) as AudioItem
+
+describe('clean up voice', () => {
+  beforeEach(() => {
+    useTimelineCommandStore.getState().clearHistory()
+    useTimelineSettingsStore.setState({ fps: 30, isDirty: false })
+    useItemsStore.getState().setTracks([track('t1'), track('t2', true)])
+  })
+
+  it('plays the same window of the cleaned sound, keeping the clip and what it played before', () => {
+    useItemsStore.getState().setItems([audio()])
+    expect(applyVoiceCleanup('a1', cleaned)).toBe('applied')
+    expect(item()).toMatchObject({
+      mediaId: 'cleaned-1', from: 90, durationInFrames: 120, volume: -2,
+      sourceStart: 30, sourceEnd: 150, sourceDuration: 180,
+      voiceCleanup: {
+        importId: 'cleaned-1', strength: 'standard', noises: ['wind', 'background'], humHz: null,
+        original: { mediaId: 'm1', sourceStart: 300, sourceEnd: 420, sourceDuration: 1800 },
+      },
+    })
+    expect(item().src).toBeUndefined()
+    expect(useTimelineSettingsStore.getState().isDirty).toBe(true)
+    // Kept with the project: the record is saved with the clip.
+    const saved = buildTimelineFromStores().items.find((candidate) => candidate.id === 'a1') as AudioItem
+    expect(saved.voiceCleanup?.original.mediaId).toBe('m1')
+  })
+
+  it('uses the original sound again, in one undoable step each way', () => {
+    useItemsStore.getState().setItems([audio()])
+    applyVoiceCleanup('a1', cleaned)
+    expect(restoreOriginalSound('a1')).toBe('applied')
+    expect(item()).toMatchObject({ mediaId: 'm1', sourceStart: 300, sourceEnd: 420, sourceDuration: 1800 })
+    expect(item().voiceCleanup).toBeUndefined()
+    useTimelineCommandStore.getState().undo()
+    expect(item().mediaId).toBe('cleaned-1')
+    useTimelineCommandStore.getState().undo()
+    expect(item().mediaId).toBe('m1')
+  })
+
+  it('cleans again from the original, never from the cleaned sound', () => {
+    useItemsStore.getState().setItems([audio()])
+    applyVoiceCleanup('a1', cleaned)
+    applyVoiceCleanup('a1', { ...cleaned, importId: 'cleaned-2', strength: 'strong', sourceStartSeconds: 0.5 })
+    expect(item()).toMatchObject({
+      mediaId: 'cleaned-2', sourceStart: 15, sourceEnd: 135,
+      voiceCleanup: { strength: 'strong', original: { mediaId: 'm1', sourceStart: 300 } },
+    })
+  })
+
+  it('maps a trim made after the clean-up back onto the original', () => {
+    useItemsStore.getState().setItems([audio()])
+    applyVoiceCleanup('a1', cleaned)
+    // Trim 10 frames off the start and 20 off the end of the cleaned clip.
+    useItemsStore.getState()._updateItem('a1', { sourceStart: 40, sourceEnd: 130, from: 100, durationInFrames: 90 })
+    expect(voiceCleanupOriginal(item())).toMatchObject({ mediaId: 'm1', sourceStart: 310, sourceEnd: 400 })
+    expect(restoreOriginalSound('a1')).toBe('applied')
+    expect(item()).toMatchObject({ mediaId: 'm1', sourceStart: 310, sourceEnd: 400, from: 100, durationInFrames: 90 })
+  })
+
+  it('keeps a trim when the clip is cleaned again', () => {
+    useItemsStore.getState().setItems([audio()])
+    applyVoiceCleanup('a1', cleaned)
+    useItemsStore.getState()._updateItem('a1', { sourceStart: 40, sourceEnd: 130, durationInFrames: 90 })
+    applyVoiceCleanup('a1', { ...cleaned, importId: 'cleaned-2' })
+    expect(item()).toMatchObject({
+      mediaId: 'cleaned-2', sourceStart: 30, sourceEnd: 120,
+      voiceCleanup: { cleanedStart: 30, original: { mediaId: 'm1', sourceStart: 310, sourceEnd: 400 } },
+    })
+  })
+
+  it('refuses a locked track and a clip that is gone', () => {
+    useItemsStore.getState().setItems([audio({ trackId: 't2' })])
+    expect(applyVoiceCleanup('a1', cleaned)).toBe('locked')
+    expect(item().mediaId).toBe('m1')
+    expect(applyVoiceCleanup('gone', cleaned)).toBe('missing')
+    expect(restoreOriginalSound('a1')).toBe('missing')
+  })
+})
