@@ -0,0 +1,131 @@
+import type { AudioItem, VoiceCleanupNoise, VoiceCleanupRecord, VoiceCleanupStrength } from '@/types/timeline'
+import { useItemsStore } from '../../items-store'
+import { useTimelineSettingsStore } from '../../timeline-settings-store'
+import { execute } from '../shared'
+import { hasLockedEditParticipants } from '../linked-edit'
+
+/** A finished clean-up: the cleaned sound's media id and where the clip's window starts in it. */
+export interface VoiceCleanupResult {
+  importId: string
+  strength: VoiceCleanupStrength
+  noises: VoiceCleanupNoise[]
+  humHz: 50 | 60 | null
+  /** Seconds of handle before the clip's window in the cleaned sound. */
+  sourceStartSeconds: number
+  durationSeconds: number
+}
+
+export type VoiceCleanupOutcome = 'applied' | 'missing' | 'locked'
+
+const audioItem = (itemId: string): AudioItem | null => {
+  const item = useItemsStore.getState().items.find((candidate) => candidate.id === itemId)
+  return item?.type === 'audio' ? item : null
+}
+
+/**
+ * What the clip plays now, or, for a cleaned clip, the same window of what it played before. A trim
+ * made after the clean-up moves the window in the cleaned sound; it is mapped back onto the original by
+ * the same number of frames (`cleanedStart` is where the original window began in the cleaned sound),
+ * so the original sound plays in sync and a new clean-up keeps the trim.
+ */
+export function voiceCleanupOriginal(item: AudioItem): NonNullable<VoiceCleanupRecord['original']> {
+  const start = item.sourceStart ?? 0
+  const end = item.sourceEnd ?? start + item.durationInFrames
+  const record = item.voiceCleanup
+  if (!record) {
+    return {
+      mediaId: item.mediaId!,
+      sourceStart: start,
+      sourceEnd: end,
+      ...(item.sourceDuration !== undefined && { sourceDuration: item.sourceDuration }),
+      ...(item.trimStart !== undefined && { trimStart: item.trimStart }),
+      ...(item.trimEnd !== undefined && { trimEnd: item.trimEnd }),
+      ...(item.offset !== undefined && { offset: item.offset }),
+    }
+  }
+  const { original } = record
+  const sourceStart = Math.max(0, original.sourceStart + (start - (record.cleanedStart ?? start)))
+  const sourceEnd = sourceStart + (end - start)
+  return {
+    ...original,
+    sourceStart,
+    sourceEnd,
+    ...(original.trimStart !== undefined && { trimStart: sourceStart }),
+    ...(original.offset !== undefined && { offset: sourceStart }),
+    ...(original.trimEnd !== undefined &&
+      original.sourceDuration !== undefined && { trimEnd: Math.max(0, original.sourceDuration - sourceEnd) }),
+  }
+}
+
+/**
+ * Clean up voice (FL-637): play the clip from the cleaned sound, as one undoable edit. The clip keeps
+ * its place, length and speed: only its source changes, to the same window of the cleaned sound. What
+ * it played before is kept under `voiceCleanup.original`, so the original sound can be put back.
+ */
+export function applyVoiceCleanup(itemId: string, result: VoiceCleanupResult): VoiceCleanupOutcome {
+  const item = audioItem(itemId)
+  if (!item || !item.mediaId) return 'missing'
+  if (hasLockedEditParticipants([item])) return 'locked'
+  const original = voiceCleanupOriginal(item)
+  const fps = item.sourceFps ?? useTimelineSettingsStore.getState().fps
+  const sourceStart = Math.max(0, Math.round(result.sourceStartSeconds * fps))
+  const sourceEnd = sourceStart + (original.sourceEnd - original.sourceStart)
+  const sourceDuration = Math.max(sourceEnd, Math.floor(result.durationSeconds * fps))
+  const voiceCleanup: VoiceCleanupRecord = {
+    importId: result.importId,
+    strength: result.strength,
+    noises: [...result.noises],
+    humHz: result.humHz,
+    cleanedStart: sourceStart,
+    original,
+  }
+  execute(
+    'APPLY_VOICE_CLEANUP',
+    () => {
+      useItemsStore.getState()._updateItem(itemId, {
+        mediaId: result.importId,
+        src: undefined,
+        waveformData: undefined,
+        sourceStart,
+        sourceEnd,
+        sourceDuration,
+        // `sourceStart` wins over these older fields; they follow it only where the clip had them.
+        trimStart: original.trimStart === undefined ? undefined : sourceStart,
+        trimEnd: original.trimEnd === undefined ? undefined : sourceDuration - sourceEnd,
+        offset: original.offset === undefined ? undefined : sourceStart,
+        voiceCleanup,
+      } as Partial<AudioItem>)
+      useTimelineSettingsStore.getState().markDirty()
+    },
+    { itemId, importId: result.importId, strength: result.strength },
+  )
+  return 'applied'
+}
+
+/** "Use the original sound": the clip plays what it played before the clean-up, as one undoable edit. */
+export function restoreOriginalSound(itemId: string): VoiceCleanupOutcome {
+  const item = audioItem(itemId)
+  if (!item?.voiceCleanup) return 'missing'
+  const original = voiceCleanupOriginal(item)
+  if (hasLockedEditParticipants([item])) return 'locked'
+  execute(
+    'USE_ORIGINAL_SOUND',
+    () => {
+      useItemsStore.getState()._updateItem(itemId, {
+        mediaId: original.mediaId,
+        src: undefined,
+        waveformData: undefined,
+        sourceStart: original.sourceStart,
+        sourceEnd: original.sourceEnd,
+        sourceDuration: original.sourceDuration,
+        trimStart: original.trimStart,
+        trimEnd: original.trimEnd,
+        offset: original.offset,
+        voiceCleanup: undefined,
+      } as Partial<AudioItem>)
+      useTimelineSettingsStore.getState().markDirty()
+    },
+    { itemId },
+  )
+  return 'applied'
+}
