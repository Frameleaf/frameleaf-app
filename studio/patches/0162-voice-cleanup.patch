+import { act, fireEvent, render, screen, waitFor } from '@testing-library/react'
+import { beforeEach, describe, expect, it, vi } from 'vite-plus/test'
+import type { ReactNode } from 'react'
+import type { AudioItem, TimelineTrack } from '@/types/timeline'
+import { useItemsStore } from '@/features/timeline/stores/items-store'
+import { useTimelineSettingsStore } from '@/features/timeline/stores/timeline-settings-store'
+import type { VoiceCleanupHost } from './voice-cleanup-service'
+import { VoiceCleanupSection } from './voice-cleanup-section'
+
+const host = vi.hoisted(() => ({ current: null as VoiceCleanupHost | null }))
+
+vi.mock('@/features/editor/components/properties-sidebar/clip-panel/voice-cleanup-service', () => ({
+  getVoiceCleanupHost: () => host.current,
+}))
+
+vi.mock('react-i18next', () => ({
+  useTranslation: () => ({
+    t: (key: string, values?: Record<string, unknown>) =>
+      values ? `${key}(${Object.values(values).join(',')})` : key,
+  }),
+}))
+
+vi.mock('sonner', () => ({ toast: { success: vi.fn(), warning: vi.fn(), error: vi.fn() } }))
+
+vi.mock('../components', () => ({
+  PropertySection: ({ title, children }: { title: string; children: ReactNode }) => (
+    <section aria-label={title}>{children}</section>
+  ),
+}))
+
+const k = (key: string) => `editor.audioSection.voiceCleanup.${key}`
+
+const track = { id: 't1', name: 'A1', order: 0, height: 80, locked: false, syncLock: true, visible: true,
+  muted: false, solo: false, volume: 0, items: [], kind: 'audio' } as TimelineTrack
+
+const clip = (id: string, label: string, overrides: Partial<AudioItem> = {}): AudioItem => ({
+  id, type: 'audio', trackId: 't1', from: id === 'a1' ? 0 : 200, durationInFrames: 120, label, src: 'blob:a',
+  mediaId: `media-${id}`, sourceStart: 60, sourceEnd: 180, sourceFps: 30, ...overrides,
+} as AudioItem)
+
+const fakeHost = (overrides: Partial<VoiceCleanupHost> = {}): VoiceCleanupHost => ({
+  analyze: vi.fn().mockResolvedValue({ noises: ['background', 'wind'], humHz: null }),
+  clean: vi.fn().mockImplementation(async (_request, onProgress: (percent: number) => void) => {
+    onProgress(40)
+    return {
+      importId: 'cleaned-1', strength: 'standard', noises: ['wind', 'background'], humHz: null,
+      sourceStartSeconds: 1, durationSeconds: 6,
+    }
+  }),
+  ...overrides,
+})
+
+describe('Clean up voice card (FL-637)', () => {
+  beforeEach(() => {
+    useTimelineSettingsStore.setState({ fps: 30 })
+    useItemsStore.getState().setTracks([track])
+    useItemsStore.getState().setItems([clip('a1', 'Beach walk'), clip('a2', 'Interview')])
+    host.current = fakeHost()
+  })
+
+  it('is not shown without a host that can clean voices', () => {
+    host.current = null
+    const { container } = render(<VoiceCleanupSection items={[clip('a1', 'Beach walk')]} />)
+    expect(container).toBeEmptyDOMElement()
+  })
+
+  it('picks the selected clip and ticks what the quick analysis found', async () => {
+    render(<VoiceCleanupSection items={[clip('a2', 'Interview')]} />)
+    expect(screen.getByRole('combobox')).toHaveValue('a2')
+    expect(screen.getByText(k('checking'))).toBeInTheDocument()
+    await waitFor(() => expect(screen.getByLabelText(k('noise.wind'))).toBeChecked())
+    expect(screen.getByLabelText(k('noise.background'))).toBeChecked()
+    expect(screen.getByLabelText(k('noise.hum'))).not.toBeChecked()
+    expect(screen.getByLabelText(k('noise.echo'))).not.toBeChecked()
+    expect(host.current!.analyze).toHaveBeenCalledWith('a2', expect.any(AbortSignal))
+    // One clip at a time: no "all clips" action.
+    expect(screen.getAllByRole('button', { name: new RegExp(k('action')) })).toHaveLength(1)
+    expect(screen.getByText(k('where'))).toBeInTheDocument()
+  })
+
+  it('cleans the clip with the chosen strength, then offers the original and a clean-up again', async () => {
+    render(<VoiceCleanupSection items={[clip('a1', 'Beach walk')]} />)
+    await waitFor(() => expect(screen.getByLabelText(k('noise.wind'))).toBeChecked())
+    fireEvent.click(screen.getByRole('radio', { name: k('strength.strong') }))
+    expect(screen.getByText(k('strengthNote.strong'))).toBeInTheDocument()
+    fireEvent.click(screen.getByLabelText(k('noise.hum')))
+    await act(async () => {
+      fireEvent.click(screen.getByRole('button', { name: new RegExp(k('action')) }))
+    })
+    expect(host.current!.clean).toHaveBeenCalledWith(
+      { clipId: 'a1', strength: 'strong', noises: ['wind', 'hum', 'background'], humHz: null },
+      expect.any(Function),
+      expect.any(AbortSignal),
+    )
+    const cleaned = useItemsStore.getState().items.find((item) => item.id === 'a1') as AudioItem
+    expect(cleaned.mediaId).toBe('cleaned-1')
+    expect(cleaned.voiceCleanup?.original.mediaId).toBe('media-a1')
+    expect(await screen.findByText(`${k('done')}(${k('strength.standard')})`)).toBeInTheDocument()
+    // The clean-up was Standard and Strong is chosen: the settings changed.
+    expect(screen.getByRole('button', { name: k('again') })).toBeInTheDocument()
+    expect(screen.getByRole('option', { name: `${k('cleanedClip')}(Beach walk)` })).toBeInTheDocument()
+
+    fireEvent.click(screen.getByRole('button', { name: k('useOriginal') }))
+    const restored = useItemsStore.getState().items.find((item) => item.id === 'a1') as AudioItem
+    expect(restored.mediaId).toBe('media-a1')
+    expect(restored.voiceCleanup).toBeUndefined()
+  })
+
+  it('cannot clean with nothing to remove, and says when the sound could not be checked', async () => {
+    host.current = fakeHost({ analyze: vi.fn().mockRejectedValue(new Error('No computer is available now')) })
+    render(<VoiceCleanupSection items={[clip('a1', 'Beach walk')]} />)
+    expect(await screen.findByText(`${k('analysisFailed')}(No computer is available now)`)).toBeInTheDocument()
+    expect(screen.getByRole('button', { name: new RegExp(k('action')) })).toBeDisabled()
+  })
+
+  it('finishes a clean-up after the card unmounts, and applies it to its clip', async () => {
+    let finish: (value: unknown) => void = () => {}
+    host.current = fakeHost({ clean: vi.fn().mockReturnValue(new Promise((resolve) => { finish = resolve })) })
+    const { unmount } = render(<VoiceCleanupSection items={[clip('a1', 'Beach walk')]} />)
+    await waitFor(() => expect(screen.getByLabelText(k('noise.wind'))).toBeChecked())
+    fireEvent.click(screen.getByRole('button', { name: new RegExp(k('action')) }))
+    // A new selection remounts the card while the job runs.
+    unmount()
+    await act(async () => {
+      finish({ importId: 'cleaned-1', strength: 'standard', noises: ['wind', 'background'], humHz: null,
+        sourceStartSeconds: 1, durationSeconds: 6 })
+    })
+    const cleaned = useItemsStore.getState().items.find((item) => item.id === 'a1') as AudioItem
+    expect(cleaned.mediaId).toBe('cleaned-1')
+  })
+
+  it("does not carry a failed check, or its hum frequency, over to another clip", async () => {
+    host.current = fakeHost({
+      analyze: vi.fn()
+        .mockResolvedValueOnce({ noises: ['hum'], humHz: 60 })
+        .mockRejectedValueOnce(new Error('No computer is available now')),
+    })
+    render(<VoiceCleanupSection items={[clip('a1', 'Beach walk')]} />)
+    await waitFor(() => expect(screen.getByLabelText(k('noise.hum'))).toBeChecked())
+    fireEvent.change(screen.getByRole('combobox'), { target: { value: 'a2' } })
+    expect(await screen.findByText(`${k('analysisFailed')}(No computer is available now)`)).toBeInTheDocument()
+    fireEvent.click(screen.getByLabelText(k('noise.hum')))
+    await act(async () => {
+      fireEvent.click(screen.getByRole('button', { name: new RegExp(k('action')) }))
+    })
+    expect(host.current!.clean).toHaveBeenCalledWith(
+      expect.objectContaining({ clipId: 'a2', noises: ['hum'], humHz: null }),
+      expect.any(Function),
+      expect.any(AbortSignal),
+    )
+  })
+
+  it("does not carry a failed check over to a cleaned clip", async () => {
+    useItemsStore.getState().setItems([
+      clip('a1', 'Beach walk'),
+      clip('a2', 'Interview', {
+        mediaId: 'cleaned-2',
+        voiceCleanup: { importId: 'cleaned-2', strength: 'light', noises: ['wind'], humHz: null, cleanedStart: 30,
+          original: { mediaId: 'media-a2', sourceStart: 60, sourceEnd: 180 } },
+      }),
+    ])
+    host.current = fakeHost({ analyze: vi.fn().mockRejectedValue(new Error('No computer is available now')) })
+    render(<VoiceCleanupSection items={[clip('a1', 'Beach walk')]} />)
+    expect(await screen.findByText(`${k('analysisFailed')}(No computer is available now)`)).toBeInTheDocument()
+    fireEvent.change(screen.getByRole('combobox'), { target: { value: 'a2' } })
+    await waitFor(() => expect(screen.queryByText(/analysisFailed/)).not.toBeInTheDocument())
+    expect(screen.getByLabelText(k('noise.wind'))).toBeChecked()
+  })
+})
