+import { useEffect, useMemo, useRef, useState, useSyncExternalStore } from 'react'
+import { useTranslation } from 'react-i18next'
+import { CheckCircle2, Home, Mic, Play, Square, Wand2 } from 'lucide-react'
+import { toast } from 'sonner'
+import { Button } from '@/components/ui/button'
+import { Progress } from '@/components/ui/progress'
+import type { AudioItem, TimelineItem, VoiceCleanupNoise, VoiceCleanupStrength } from '@/types/timeline'
+import {
+  applyVoiceCleanup,
+  restoreOriginalSound,
+  useTimelineStore,
+  voiceCleanupOriginal,
+} from '@/features/editor/deps/timeline-store'
+import { resolveMediaUrl } from '@/features/editor/deps/media-library'
+import { PropertySection } from '../components'
+// By its alias, so a host build can substitute it (studio/adapters/web/vite.config.mjs).
+import {
+  getVoiceCleanupHost,
+  type VoiceCleanupHost,
+  type VoiceCleanupRequest,
+} from '@/features/editor/components/properties-sidebar/clip-panel/voice-cleanup-service'
+
+const NOISES: readonly VoiceCleanupNoise[] = ['wind', 'hum', 'background', 'echo']
+const STRENGTHS: readonly VoiceCleanupStrength[] = ['light', 'standard', 'strong']
+/** The Before / After listen plays at most this much of the clip. */
+const LISTEN_SECONDS = 15
+
+const sameNoises = (a: readonly VoiceCleanupNoise[], b: readonly VoiceCleanupNoise[]) =>
+  a.length === b.length && a.every((noise) => b.includes(noise))
+const ordered = (noises: Iterable<VoiceCleanupNoise>) => {
+  const chosen = new Set(noises)
+  return NOISES.filter((noise) => chosen.has(noise))
+}
+
+/**
+ * Clean-ups in progress, by clip. They belong to the editor, not to the card: a new selection remounts
+ * the card, and a clean-up started from it still finishes, is applied to its clip and says so.
+ */
+const cleanups = new Map<string, number>()
+const watchers = new Set<() => void>()
+const changed = () => {
+  for (const watcher of watchers) watcher()
+}
+const watchCleanups = (watcher: () => void) => {
+  watchers.add(watcher)
+  return () => {
+    watchers.delete(watcher)
+  }
+}
+
+type Translate = (key: string, values?: Record<string, unknown>) => string
+
+/** Clean the clip and apply the result to it by id, however the card has changed meanwhile. */
+export async function runVoiceCleanup(host: VoiceCleanupHost, request: VoiceCleanupRequest, label: string, t: Translate) {
+  if (cleanups.has(request.clipId)) return
+  cleanups.set(request.clipId, 0)
+  changed()
+  try {
+    const result = await host.clean(
+      request,
+      (percent) => {
+        if (!cleanups.has(request.clipId)) return
+        cleanups.set(request.clipId, percent)
+        changed()
+      },
+      new AbortController().signal,
+    )
+    const outcome = applyVoiceCleanup(request.clipId, result)
+    if (outcome === 'applied') toast.success(t('editor.audioSection.voiceCleanup.cleaned', { name: label }))
+    else if (outcome === 'locked') toast.warning(t('editor.audioSection.voiceCleanup.locked'))
+    else toast.warning(t('editor.audioSection.voiceCleanup.clipGone'))
+  } catch (error) {
+    toast.error(t('editor.audioSection.voiceCleanup.failed', { reason: errorText(error) }))
+  } finally {
+    cleanups.delete(request.clipId)
+    changed()
+  }
+}
+
+function Segmented<T extends string>({ label, options, value, onChange, disabled }: {
+  label: string
+  options: ReadonlyArray<{ id: T; label: string }>
+  value: T
+  onChange: (value: T) => void
+  disabled?: boolean
+}) {
+  return (
+    <div role="radiogroup" aria-label={label} className="flex w-full gap-0.5 rounded-md border border-input p-0.5">
+      {options.map((option) => (
+        <button key={option.id} type="button" role="radio" aria-checked={value === option.id} disabled={disabled}
+          className={`h-6 flex-1 rounded px-1 text-xs ${value === option.id ? 'bg-primary text-primary-foreground' : 'text-muted-foreground hover:bg-secondary'}`}
+          onClick={() => onChange(option.id)}>
+          {option.label}
+        </button>
+      ))}
+    </div>
+  )
+}
+
+/**
+ * Clean up voice (FL-637, approved mock 2026-10-29): one clip with sound at a time. "Found in this
+ * clip" comes from a quick analysis and can be changed; Strength is Light, Standard or Strong. The
+ * cleaned sound is a project file the clip plays in preview and export; the original is kept, and
+ * "Use the original sound" puts it back. It runs on the person's own server or a computer at home.
+ */
+export function VoiceCleanupSection({ items }: { items: TimelineItem[] }) {
+  const { t } = useTranslation()
+  const host = getVoiceCleanupHost()
+  const timelineItems = useTimelineStore((s) => s.items)
+  const projectFps = useTimelineStore((s) => s.fps)
+  const clips = useMemo(
+    () =>
+      timelineItems
+        .filter((item): item is AudioItem => item.type === 'audio' && !!item.mediaId && !item.isReversed)
+        .sort((a, b) => a.from - b.from),
+    [timelineItems],
+  )
+  const selected = items.find((item) => item.type === 'audio')?.id
+  const [clipId, setClipId] = useState<string | undefined>(selected)
+  const clip = clips.find((item) => item.id === clipId) ?? clips.find((item) => item.id === selected) ?? clips[0]
+  const done = clip?.voiceCleanup ?? null
+  const [strength, setStrength] = useState<VoiceCleanupStrength>(done?.strength ?? 'standard')
+  const [noises, setNoises] = useState<VoiceCleanupNoise[]>(done?.noises ?? [])
+  const [humHz, setHumHz] = useState<50 | 60 | null>(done?.humHz ?? null)
+  const [checking, setChecking] = useState(false)
+  const [unchecked, setUnchecked] = useState<string | null>(null)
+  const progress = useSyncExternalStore(watchCleanups, () => (clip ? (cleanups.get(clip.id) ?? null) : null))
+  const [listen, setListen] = useState<'before' | 'after'>('after')
+  const [playing, setPlaying] = useState(false)
+  const work = useRef<AbortController | null>(null)
+  const audio = useRef<HTMLAudioElement | null>(null)
+
+  // A new clip starts from what it was cleaned with, or from a fresh look at its sound.
+  useEffect(() => {
+    if (!host || !clip) return
+    work.current?.abort()
+    // A failed look at another clip says nothing about this one.
+    setUnchecked(null)
+    if (clip.voiceCleanup) {
+      setStrength(clip.voiceCleanup.strength)
+      setNoises(clip.voiceCleanup.noises)
+      setHumHz(clip.voiceCleanup.humHz)
+      setChecking(false)
+      return
+    }
+    const controller = new AbortController()
+    work.current = controller
+    setNoises([])
+    // The last clip's mains frequency is not this one's: the worker looks again unless analysis finds it.
+    setHumHz(null)
+    setUnchecked(null)
+    setChecking(true)
+    host
+      .analyze(clip.id, controller.signal)
+      .then((found) => {
+        if (controller.signal.aborted) return
+        setNoises(ordered(found.noises))
+        setHumHz(found.humHz)
+      })
+      .catch((error: unknown) => {
+        // Shown in the card, not as a toast: choosing a clip should not raise an alarm.
+        if (!controller.signal.aborted) setUnchecked(errorText(error))
+      })
+      .finally(() => {
+        if (work.current === controller) setChecking(false)
+      })
+    // Only a change of clip starts a new look; the record is read when it does.
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [host, clip?.id])
+
+  useEffect(() => () => {
+    work.current?.abort()
+    audio.current?.pause()
+  }, [])
+
+  if (!host || !clip) return null
+
+  const busy = progress !== null
+  const settingsChanged = !!done && (done.strength !== strength || !sameNoises(done.noises, noises))
+  const strengthLabel = (id: VoiceCleanupStrength) => t(`editor.audioSection.voiceCleanup.strength.${id}`)
+
+  const clean = () => runVoiceCleanup(host, { clipId: clip.id, strength, noises, humHz }, clip.label, t)
+
+  const keepOriginal = () => {
+    const outcome = restoreOriginalSound(clip.id)
+    if (outcome === 'locked') toast.warning(t('editor.audioSection.voiceCleanup.locked'))
+  }
+
+  const stop = () => {
+    audio.current?.pause()
+    setPlaying(false)
+  }
+
+  // Before plays the original from the clip's start; After plays the cleaned sound from the same place.
+  const play = async () => {
+    stop()
+    const original = voiceCleanupOriginal(clip)
+    const fps = clip.sourceFps ?? projectFps
+    const after = listen === 'after' && !!done
+    const mediaId = after ? done.importId : original.mediaId
+    const start = (after ? clip.sourceStart ?? 0 : original.sourceStart) / fps
+    const seconds = Math.min(LISTEN_SECONDS, (original.sourceEnd - original.sourceStart) / fps)
+    try {
+      const element = audio.current ?? new Audio()
+      audio.current = element
+      element.src = await resolveMediaUrl(mediaId)
+      element.currentTime = start
+      element.ontimeupdate = () => {
+        if (element.currentTime >= start + seconds) stop()
+      }
+      element.onended = () => setPlaying(false)
+      await element.play()
+      setPlaying(true)
+    } catch {
+      setPlaying(false)
+      toast.error(t('editor.audioSection.voiceCleanup.listenFailed'))
+    }
+  }
+
+  return (
+    <PropertySection title={t('editor.audioSection.voiceCleanup.title')} icon={Mic} defaultOpen={true}>
+      <div className="space-y-2 px-1 py-2 text-xs" aria-label={t('editor.audioSection.voiceCleanup.title')}>
+        <label className="flex flex-col gap-1">
+          <span className="text-muted-foreground">{t('editor.audioSection.voiceCleanup.clip')}</span>
+          <select
+            className="h-7 w-full rounded-md border border-input bg-transparent px-2 text-xs"
+            value={clip.id}
+            disabled={busy}
+            onChange={(event) => {
+              stop()
+              setClipId(event.target.value)
+            }}
+          >
+            {clips.map((item) => (
+              <option key={item.id} value={item.id}>
+                {item.voiceCleanup
+                  ? t('editor.audioSection.voiceCleanup.cleanedClip', { name: item.label })
+                  : item.label}
+              </option>
+            ))}
+          </select>
+        </label>
+
+        <div role="group" aria-label={t('editor.audioSection.voiceCleanup.found')} className="space-y-1">
+          <span className="text-muted-foreground">
+            {checking ? t('editor.audioSection.voiceCleanup.checking') : t('editor.audioSection.voiceCleanup.found')}
+          </span>
+          <div className="flex flex-wrap gap-1">
+            {NOISES.map((noise) => {
+              const on = noises.includes(noise)
+              return (
+                <label key={noise}
+                  className={`flex cursor-pointer items-center gap-1 rounded-full border px-2 py-0.5 ${on ? 'border-primary bg-primary/10' : 'border-input'}`}>
+                  <input type="checkbox" className="h-3 w-3" checked={on} disabled={busy}
+                    onChange={(event) =>
+                      setNoises((current) =>
+                        ordered(event.target.checked ? [...current, noise] : current.filter((id) => id !== noise)),
+                      )
+                    } />
+                  {t(`editor.audioSection.voiceCleanup.noise.${noise}`)}
+                </label>
+              )
+            })}
+          </div>
+          {unchecked && (
+            <p className="text-amber-500">{t('editor.audioSection.voiceCleanup.analysisFailed', { reason: unchecked })}</p>
+          )}
+        </div>
+
+        <div className="space-y-1">
+          <span className="text-muted-foreground">{t('editor.audioSection.voiceCleanup.strengthLabel')}</span>
+          <Segmented label={t('editor.audioSection.voiceCleanup.strengthLabel')} value={strength} disabled={busy}
+            onChange={setStrength} options={STRENGTHS.map((id) => ({ id, label: strengthLabel(id) }))} />
+          <p className="text-muted-foreground">{t(`editor.audioSection.voiceCleanup.strengthNote.${strength}`)}</p>
+        </div>
+
+        <div className="flex items-center gap-1">
+          <Segmented label={t('editor.audioSection.voiceCleanup.listen')} value={listen} onChange={(value) => { stop(); setListen(value) }}
+            options={[
+              { id: 'before', label: t('editor.audioSection.voiceCleanup.before') },
+              { id: 'after', label: t('editor.audioSection.voiceCleanup.after') },
+            ]} />
+          <Button variant="ghost" size="icon" className="h-7 w-7 flex-shrink-0"
+            disabled={listen === 'after' && !done}
+            aria-label={playing ? t('editor.audioSection.voiceCleanup.stop') : t('editor.audioSection.voiceCleanup.play')}
+            title={listen === 'after' && !done ? t('editor.audioSection.voiceCleanup.afterNotYet') : undefined}
+            onClick={() => (playing ? stop() : void play())}>
+            {playing ? <Square className="h-3.5 w-3.5" /> : <Play className="h-3.5 w-3.5" />}
+          </Button>
+        </div>
+
+        {busy && (
+          <div role="status" aria-live="polite" className="space-y-1">
+            <span>{t('editor.audioSection.voiceCleanup.progress', { percent: Math.round(progress) })}</span>
+            <Progress className="h-1.5" value={progress} />
+          </div>
+        )}
+
+        <div className="flex flex-wrap items-center gap-2">
+          {done ? (
+            <>
+              <span className="flex items-center gap-1 text-emerald-500">
+                <CheckCircle2 className="h-3.5 w-3.5" />
+                {t('editor.audioSection.voiceCleanup.done', { strength: strengthLabel(done.strength) })}
+              </span>
+              <Button variant="ghost" size="sm" className="h-7 text-xs" disabled={busy} onClick={keepOriginal}>
+                {t('editor.audioSection.voiceCleanup.useOriginal')}
+              </Button>
+              {settingsChanged && (
+                <Button size="sm" className="h-7 text-xs" disabled={busy || noises.length === 0} onClick={() => void clean()}>
+                  {t('editor.audioSection.voiceCleanup.again')}
+                </Button>
+              )}
+            </>
+          ) : (
+            <Button size="sm" className="h-7 text-xs" disabled={busy || checking || noises.length === 0} onClick={() => void clean()}>
+              <Wand2 className="mr-1 h-3.5 w-3.5" />
+              {t('editor.audioSection.voiceCleanup.action')}
+            </Button>
+          )}
+        </div>
+
+        <p className="flex items-start gap-1 text-muted-foreground">
+          <Home className="mt-0.5 h-3.5 w-3.5 flex-shrink-0" />
+          <span>{t('editor.audioSection.voiceCleanup.where')}</span>
+        </p>
+      </div>
+    </PropertySection>
+  )
+}
+
+const errorText = (error: unknown) => (error instanceof Error ? error.message : String(error))
