+import type { VoiceCleanupNoise, VoiceCleanupStrength } from '@/types/timeline'
+import type { VoiceCleanupResult } from '@/features/editor/deps/timeline-store'
+
+/** What the quick analysis of a clip found (FL-637). */
+export interface VoiceAnalysis {
+  noises: VoiceCleanupNoise[]
+  humHz: 50 | 60 | null
+}
+
+export interface VoiceCleanupRequest {
+  clipId: string
+  strength: VoiceCleanupStrength
+  noises: VoiceCleanupNoise[]
+  humHz: 50 | 60 | null
+}
+
+/**
+ * Where "Clean up voice" runs: the host that keeps the project. The speech model runs on the person's
+ * own server or a computer at home; the cleaned sound comes back as a media id the bin already holds.
+ */
+export interface VoiceCleanupHost {
+  analyze(clipId: string, signal: AbortSignal): Promise<VoiceAnalysis>
+  /** Clean the clip; `onProgress` gets 0 to 100. Resolves once the cleaned sound is in the bin. */
+  clean(
+    request: VoiceCleanupRequest,
+    onProgress: (percent: number) => void,
+    signal: AbortSignal,
+  ): Promise<VoiceCleanupResult>
+}
+
+/**
+ * The editor on its own has no host to clean voices, so the card is not shown. A host build
+ * substitutes this module with one that answers (Frameleaf: `studio/adapters/web/src/shims`).
+ */
+export function getVoiceCleanupHost(): VoiceCleanupHost | null {
+  return null
+}
