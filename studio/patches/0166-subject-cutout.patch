@@ -0,0 +1,300 @@
+/**
+ * Frameleaf (FL-639): Cut out the subject in a video clip.
+ *
+ * The server follows the subject through the clip (SAM2.1 video) and keeps the matte with the project as
+ * one grayscale PNG: a small frame for every `1 / fps` seconds of the source from `startSeconds`, side by
+ * side, `columns` to a row. This draws the clip with that matte, in preview and export alike, because
+ * both render every item through `renderItem`:
+ *
+ * - the clip is drawn as usual into a scratch canvas with the target's transform;
+ * - the matte for the moment shown is the two nearest matte frames blended by time, drawn into the
+ *   same media rectangle as the video (so crop, fit, transform and keyframes follow), softened by the
+ *   clip's edge softness;
+ * - the background is the clip blurred (Blur), nothing (Remove: see-through, to layer over another
+ *   clip), a solid colour (Colour) or a still from the bin (Photo), always kept inside the clip's own
+ *   visible area, with the subject on top. Keep draws the clip unchanged.
+ *
+ * Outside the matte's window (the clip was trimmed longer afterwards) the clip draws unchanged. In
+ * export a matte that cannot be read is an error rather than a silent un-cut frame.
+ */
+import type { ImageItem, SubjectCutout, VideoItem } from '@/types/timeline'
+import type { ItemRenderContext, ItemTransform } from './canvas-item-renderer/types'
+import { calculateContainedMediaDrawLayout } from './canvas-item-renderer/media-draw'
+import { getItemRenderTimelineSpan, resolveVideoRenderSourceTimeSeconds, type RenderTimelineSpan } from './render-span'
+
+export const SUBJECT_MATTE_UNAVAILABLE = 'SUBJECT_MATTE_UNAVAILABLE'
+
+/** The edge softness slider at 100% blurs the matte by this share of the frame's short side. */
+const MAX_SOFTNESS_SHARE = 0.012
+/** The Blur background, as a share of the frame's short side. */
+const BACKGROUND_BLUR_SHARE = 0.02
+
+/** A cut-out that changes the picture: every background but Keep. */
+export function hasActiveSubjectCutout(item: { type: string; subjectCutout?: SubjectCutout }): item is VideoItem & {
+  subjectCutout: SubjectCutout
+} {
+  return item.type === 'video' && !!item.subjectCutout?.matte?.importId && item.subjectCutout.background !== 'keep'
+}
+
+/** Remove makes the background see-through, so the clip no longer hides what is beneath it. */
+export function isSeeThroughSubjectCutout(item: { type: string; subjectCutout?: SubjectCutout }): boolean {
+  return hasActiveSubjectCutout(item) && item.subjectCutout.background === 'remove'
+}
+
+/**
+ * The matte frames around `sourceSeconds`: the earlier one, the later one and how far between them,
+ * or null outside the followed window (half a matte frame of grace before it).
+ */
+export function matteSample(
+  matte: SubjectCutout['matte'],
+  sourceSeconds: number,
+): { first: number; second: number; weight: number } | null {
+  if (!(matte.fps > 0) || matte.frames < 1 || !Number.isFinite(sourceSeconds)) return null
+  const position = (sourceSeconds - matte.startSeconds) * matte.fps
+  if (position < -0.5 || position > matte.frames + 1e-6) return null
+  const clamped = Math.min(matte.frames - 1, Math.max(0, position))
+  const first = Math.floor(clamped)
+  const second = Math.min(matte.frames - 1, first + 1)
+  return { first, second, weight: second === first ? 0 : clamped - first }
+}
+
+/** Where matte frame `index` is in the matte file. */
+export function matteCell(matte: SubjectCutout['matte'], index: number) {
+  return {
+    x: (index % matte.columns) * matte.frameWidth,
+    y: Math.floor(index / matte.columns) * matte.frameHeight,
+    width: matte.frameWidth,
+    height: matte.frameHeight,
+  }
+}
+
+/** Blur radii in canvas pixels: the matte's edge softness and the Blur background. */
+export function cutoutBlurPixels(softness: number, canvas: { width: number; height: number }) {
+  const short = Math.max(1, Math.min(canvas.width, canvas.height))
+  return {
+    edge: (Math.min(100, Math.max(0, softness)) / 100) * MAX_SOFTNESS_SHARE * short,
+    background: BACKGROUND_BLUR_SHARE * short,
+  }
+}
+
+/** The project file a cut-out reads, as an image item the renderer's image loader understands. */
+export function cutoutImageItem(item: VideoItem, role: 'matte' | 'photo', mediaId: string): ImageItem {
+  return {
+    id: `${item.id}::cutout-${role}::${mediaId}`,
+    type: 'image',
+    mediaId,
+    src: '',
+    label: role,
+    trackId: item.trackId,
+    from: item.from,
+    durationInFrames: item.durationInFrames,
+  } as ImageItem
+}
+
+/** The matte's grayscale as alpha (white subject), for one matte frame. Small: one matte frame big. */
+const alphaCells = new Map<string, OffscreenCanvas>()
+const ALPHA_CELLS_KEPT = 12
+
+function alphaCell(source: CanvasImageSource, matte: SubjectCutout['matte'], index: number): OffscreenCanvas | null {
+  const key = `${matte.importId}:${index}`
+  const cached = alphaCells.get(key)
+  if (cached) {
+    alphaCells.delete(key)
+    alphaCells.set(key, cached)
+    return cached
+  }
+  const cell = matteCell(matte, index)
+  const canvas = new OffscreenCanvas(cell.width, cell.height)
+  const context = canvas.getContext('2d', { willReadFrequently: true })
+  if (!context) return null
+  context.drawImage(source, cell.x, cell.y, cell.width, cell.height, 0, 0, cell.width, cell.height)
+  const pixels = context.getImageData(0, 0, cell.width, cell.height)
+  lumaToAlpha(pixels.data)
+  context.putImageData(pixels, 0, 0)
+  alphaCells.set(key, canvas)
+  while (alphaCells.size > ALPHA_CELLS_KEPT) alphaCells.delete(alphaCells.keys().next().value!)
+  return canvas
+}
+
+/** White with the gray level as alpha: `[g, g, g, 255]` becomes `[255, 255, 255, g]`. */
+export function lumaToAlpha(data: Uint8ClampedArray): void {
+  for (let offset = 0; offset < data.length; offset += 4) {
+    data[offset + 3] = data[offset]!
+    data[offset] = 255
+    data[offset + 1] = 255
+    data[offset + 2] = 255
+  }
+}
+
+type Scratch = { canvas: OffscreenCanvas; ctx: OffscreenCanvasRenderingContext2D }
+
+function scratch(rctx: ItemRenderContext, like: Scratch['ctx'], held: OffscreenCanvas[]): Scratch {
+  let { canvas, ctx } = rctx.canvasPool.acquire()
+  if (canvas.width === like.canvas.width && canvas.height === like.canvas.height) {
+    held.push(canvas)
+  } else {
+    // A target of another size (a corner-pin or nested composition canvas): a canvas of its own.
+    rctx.canvasPool.release(canvas)
+    canvas = new OffscreenCanvas(like.canvas.width, like.canvas.height)
+    const own = canvas.getContext('2d')
+    if (!own) throw new Error('Canvas 2D is unavailable')
+    ctx = own
+  }
+  ctx.save()
+  ctx.setTransform(1, 0, 0, 1, 0, 0)
+  ctx.clearRect(0, 0, canvas.width, canvas.height)
+  ctx.restore()
+  ctx.setTransform(like.getTransform())
+  ctx.globalAlpha = 1
+  ctx.globalCompositeOperation = 'source-over'
+  ctx.filter = 'none'
+  ctx.imageSmoothingEnabled = true
+  ctx.imageSmoothingQuality = 'high'
+  return { canvas, ctx }
+}
+
+async function loadImage(rctx: ItemRenderContext, item: ImageItem) {
+  await rctx.ensureImageItemReady?.(item)
+  return rctx.imageElements.get(item.id) ?? null
+}
+
+/**
+ * Draw a video clip with its cut-out. `drawClip` draws the clip as usual into the context it is given
+ * and answers whether a real frame was drawn.
+ */
+export async function renderVideoWithSubjectCutout(
+  ctx: OffscreenCanvasRenderingContext2D,
+  item: VideoItem & { subjectCutout: SubjectCutout },
+  transform: ItemTransform,
+  frame: number,
+  rctx: ItemRenderContext,
+  sourceFrameOffset: number,
+  renderSpan: RenderTimelineSpan | undefined,
+  drawClip: (target: OffscreenCanvasRenderingContext2D) => Promise<boolean>,
+): Promise<boolean> {
+  const cutout = item.subjectCutout
+  const { matte } = cutout
+  const sourceSeconds = resolveVideoRenderSourceTimeSeconds(
+    item,
+    renderSpan ?? getItemRenderTimelineSpan(item),
+    frame,
+    rctx.fps,
+    sourceFrameOffset,
+  )
+  const sample = matteSample(matte, sourceSeconds)
+  if (!sample) return drawClip(ctx)
+  const atlas = await loadImage(rctx, cutoutImageItem(item, 'matte', matte.importId))
+  if (!atlas) {
+    if (rctx.renderMode === 'export') throw new Error(SUBJECT_MATTE_UNAVAILABLE)
+    return drawClip(ctx)
+  }
+  const photo =
+    cutout.background === 'photo' && cutout.photo?.mediaId
+      ? await loadImage(rctx, cutoutImageItem(item, 'photo', cutout.photo.mediaId))
+      : null
+  if (cutout.background === 'photo' && !photo && rctx.renderMode === 'export') {
+    throw new Error(SUBJECT_MATTE_UNAVAILABLE)
+  }
+
+  const held: OffscreenCanvas[] = []
+  try {
+    const clip = scratch(rctx, ctx, held)
+    if (!(await drawClip(clip.ctx))) return false
+
+    // The matte, in the video's own media rectangle (crop, fit and transform included).
+    const mask = scratch(rctx, ctx, held)
+    const blur = cutoutBlurPixels(cutout.softness, ctx.canvas)
+    const sourceWidth = item.sourceWidth && item.sourceWidth > 0 ? item.sourceWidth : matte.frameWidth
+    const sourceHeight = item.sourceHeight && item.sourceHeight > 0 ? item.sourceHeight : matte.frameHeight
+    const layout = calculateContainedMediaDrawLayout(sourceWidth, sourceHeight, transform, rctx.canvasSettings, item.crop)
+    mask.ctx.filter = blur.edge >= 0.5 ? `blur(${blur.edge.toFixed(2)}px)` : 'none'
+    const cells: Array<[number, number]> = sample.weight > 0 && sample.second !== sample.first
+      ? [[sample.first, 1 - sample.weight], [sample.second, sample.weight]]
+      : [[sample.first, 1]]
+    for (const [index, weight] of cells) {
+      const cell = alphaCell(atlas.source, matte, index)
+      if (!cell) continue
+      mask.ctx.globalAlpha = weight
+      mask.ctx.globalCompositeOperation = 'lighter'
+      mask.ctx.drawImage(cell, layout.mediaRect.x, layout.mediaRect.y, layout.mediaRect.width, layout.mediaRect.height)
+    }
+
+    // Background, inside the clip's own visible pixels.
+    const out = scratch(rctx, ctx, held)
+    out.ctx.setTransform(1, 0, 0, 1, 0, 0)
+    if (cutout.background === 'blur') {
+      out.ctx.filter = `blur(${blur.background.toFixed(2)}px)`
+      out.ctx.drawImage(clip.canvas, 0, 0)
+      out.ctx.filter = 'none'
+    } else if (cutout.background === 'colour') {
+      out.ctx.fillStyle = /^#[\da-f]{6}$/i.test(cutout.colour ?? '') ? cutout.colour! : '#000000'
+      out.ctx.fillRect(0, 0, out.canvas.width, out.canvas.height)
+    } else if (cutout.background === 'photo' && photo) {
+      // The photo fills the clip's frame, centred and cropped to its shape.
+      out.ctx.setTransform(ctx.getTransform())
+      const box = layout.viewportRect
+      const scale = Math.max(box.width / photo.width, box.height / photo.height)
+      const width = photo.width * scale
+      const height = photo.height * scale
+      out.ctx.drawImage(photo.source, box.x + (box.width - width) / 2, box.y + (box.height - height) / 2, width, height)
+      out.ctx.setTransform(1, 0, 0, 1, 0, 0)
+    }
+    if (cutout.background !== 'remove') {
+      out.ctx.globalCompositeOperation = 'destination-in'
+      out.ctx.drawImage(clip.canvas, 0, 0)
+      out.ctx.globalCompositeOperation = 'source-over'
+    }
+
+    // The subject: the clip where the matte is.
+    clip.ctx.save()
+    clip.ctx.setTransform(1, 0, 0, 1, 0, 0)
+    clip.ctx.globalCompositeOperation = 'destination-in'
+    clip.ctx.drawImage(mask.canvas, 0, 0)
+    clip.ctx.restore()
+    out.ctx.drawImage(clip.canvas, 0, 0)
+
+    ctx.save()
+    ctx.setTransform(1, 0, 0, 1, 0, 0)
+    ctx.drawImage(out.canvas, 0, 0)
+    ctx.restore()
+    return true
+  } finally {
+    for (const canvas of held) rctx.canvasPool.release(canvas)
+  }
+}
+
+/**
+ * A point on the project canvas as a fraction of the clip's own picture (0..1 across and down the
+ * source), undoing the clip's rotation and flips; null when it is outside the picture. Used for
+ * Add to subject / Take away, which paint on the viewer.
+ */
+export function canvasPointToSourceFraction(
+  point: { x: number; y: number },
+  item: Pick<VideoItem, 'sourceWidth' | 'sourceHeight' | 'crop'>,
+  transform: { x: number; y: number; width: number; height: number; rotation?: number; flipHorizontal?: boolean; flipVertical?: boolean },
+  canvas: { width: number; height: number },
+): { x: number; y: number } | null {
+  const centreX = canvas.width / 2 + transform.x
+  const centreY = canvas.height / 2 + transform.y
+  const angle = (-(transform.rotation ?? 0) * Math.PI) / 180
+  let dx = point.x - centreX
+  let dy = point.y - centreY
+  ;[dx, dy] = [dx * Math.cos(angle) - dy * Math.sin(angle), dx * Math.sin(angle) + dy * Math.cos(angle)]
+  if (transform.flipHorizontal) dx = -dx
+  if (transform.flipVertical) dy = -dy
+  const sourceWidth = item.sourceWidth && item.sourceWidth > 0 ? item.sourceWidth : transform.width
+  const sourceHeight = item.sourceHeight && item.sourceHeight > 0 ? item.sourceHeight : transform.height
+  const { mediaRect, viewportRect } = calculateContainedMediaDrawLayout(
+    sourceWidth,
+    sourceHeight,
+    transform,
+    { ...canvas, fps: 30 },
+    item.crop,
+  )
+  const x = centreX + dx
+  const y = centreY + dy
+  if (x < viewportRect.x || y < viewportRect.y || x > viewportRect.x + viewportRect.width || y > viewportRect.y + viewportRect.height) {
+    return null
+  }
+  return { x: (x - mediaRect.x) / mediaRect.width, y: (y - mediaRect.y) / mediaRect.height }
+}
