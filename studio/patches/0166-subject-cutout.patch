+/**
+ * Frameleaf (FL-639): keep a clip's cut-out. One undo step per change; a locked clip is left alone.
+ */
+import type { SubjectCutout, VideoItem } from '@/types/timeline'
+import { useItemsStore } from '../../items-store'
+import { useTimelineSettingsStore } from '../../timeline-settings-store'
+import { execute } from '../shared'
+import { hasLockedEditParticipants } from '../linked-edit'
+
+function videoItem(itemId: string): VideoItem | null {
+  const item = useItemsStore.getState().itemById[itemId]
+  return item?.type === 'video' ? item : null
+}
+
+/** Set (or with null remove) the clip's cut-out. Answers false when the clip is missing or locked. */
+export function setSubjectCutout(itemId: string, cutout: SubjectCutout | null): boolean {
+  const item = videoItem(itemId)
+  if (!item || hasLockedEditParticipants([item])) return false
+  execute(cutout ? 'SET_SUBJECT_CUTOUT' : 'REMOVE_SUBJECT_CUTOUT', () => {
+    useItemsStore.getState()._updateItem(itemId, { subjectCutout: cutout ?? undefined } as Partial<VideoItem>)
+    useTimelineSettingsStore.getState().markDirty()
+  }, { itemId })
+  return true
+}
+
+/** Change how the found subject is shown (background, colour, photo, softness). */
+export function updateSubjectCutout(
+  itemId: string,
+  patch: Partial<Pick<SubjectCutout, 'background' | 'colour' | 'photo' | 'softness'>>,
+): boolean {
+  const current = videoItem(itemId)?.subjectCutout
+  if (!current) return false
+  return setSubjectCutout(itemId, { ...current, ...patch })
+}
+
+/** Where in the clip's source a timeline frame is, in seconds (constant speed; a ramp is many clips). */
+function sourceSecondsAt(item: VideoItem, frame: number, fps: number): number {
+  const sourceFps = item.sourceFps ?? fps
+  const speed = item.speed ?? 1
+  return (item.sourceStart ?? 0) / sourceFps + ((frame - item.from) / fps) * speed
+}
+
+/** Painted strokes as the points a new matte is made with. */
+export function cutoutRequestPoints(
+  item: VideoItem,
+  strokes: ReadonlyArray<{ label: 0 | 1; frame: number; points: ReadonlyArray<{ x: number; y: number }> }>,
+  fps: number,
+): NonNullable<SubjectCutout['points']> {
+  return strokes.flatMap((stroke) => {
+    const sourceSeconds = Math.max(0, sourceSecondsAt(item, stroke.frame, fps))
+    return stroke.points
+      .filter((point) => point.x >= 0 && point.x <= 1 && point.y >= 0 && point.y <= 1)
+      .map((point) => ({ sourceSeconds, x: point.x, y: point.y, label: stroke.label }))
+  })
+}
