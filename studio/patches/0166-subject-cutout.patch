--- /dev/null
+++ b/src/shared/state/subject-cutout-paint.ts
@@ -0,0 +1,48 @@
+/**
+ * Frameleaf (FL-639): Add to subject / Take away. While `itemId` is set, a drag on the viewer paints
+ * points for that clip; the cut-out card turns each finished stroke into a new matte.
+ */
+import { create } from 'zustand'
+
+export type SubjectCutoutStroke = {
+  itemId: string
+  label: 0 | 1
+  /** Fractions of the clip's picture (0..1), in the order painted. */
+  points: Array<{ x: number; y: number }>
+  /** The timeline frame the stroke was painted on. */
+  frame: number
+}
+
+interface SubjectCutoutPaintState {
+  itemId: string | null
+  label: 0 | 1
+  /** Finished strokes the card has not taken yet. */
+  strokes: SubjectCutoutStroke[]
+  start: (itemId: string, label: 0 | 1) => void
+  stop: () => void
+  finish: (stroke: SubjectCutoutStroke) => void
+  take: (itemId: string) => SubjectCutoutStroke[]
+}
+
+export const useSubjectCutoutPaintStore = create<SubjectCutoutPaintState>((set, get) => ({
+  itemId: null,
+  label: 1,
+  strokes: [],
+  start: (itemId, label) => set({ itemId, label }),
+  stop: () => set({ itemId: null }),
+  finish: (stroke) => set((state) => ({ strokes: [...state.strokes, stroke] })),
+  take: (itemId) => {
+    const taken = get().strokes.filter((stroke) => stroke.itemId === itemId)
+    if (taken.length > 0) set((state) => ({ strokes: state.strokes.filter((stroke) => stroke.itemId !== itemId) }))
+    return taken
+  },
+}))
+
+/** At most this many points from one stroke, evenly spaced along it: SAM2 reads points, not pixels. */
+const POINTS_PER_STROKE = 8
+
+export function strokePoints(points: ReadonlyArray<{ x: number; y: number }>): Array<{ x: number; y: number }> {
+  if (points.length <= POINTS_PER_STROKE) return points.map((point) => ({ ...point }))
+  const step = (points.length - 1) / (POINTS_PER_STROKE - 1)
+  return Array.from({ length: POINTS_PER_STROKE }, (_, index) => ({ ...points[Math.round(index * step)]! }))
+}
