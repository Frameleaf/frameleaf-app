+  lumaToAlpha,
+  matteCell,
+  matteSample,
+  renderVideoWithSubjectCutout,
+} from './subject-cutout'
+
+const matte: SubjectCutout['matte'] = {
+  importId: '0195e2a0-0000-4000-8000-000000000040',
+  startSeconds: 3,
+  durationSeconds: 2,
+  fps: 10,
+  frames: 20,
+  columns: 8,
+  frameWidth: 192,
+  frameHeight: 108,
+}
+
+const cutout = (background: SubjectCutout['background']): SubjectCutout => ({
+  subject: { kind: 'person', personId: 'jamie', name: 'Jamie' },
+  background,
+  softness: 40,
+  matte,
+})
+
+const clip = (subjectCutout?: SubjectCutout): VideoItem =>
+  ({
+    id: 'clip',
+    type: 'video',
+    trackId: 'v1',
+    from: 60,
+    durationInFrames: 60,
+    label: 'Lake',
+    src: 'blob:clip',
+    mediaId: 'media',
+    sourceStart: 90,
+    sourceFps: 30,
+    sourceWidth: 1920,
+    sourceHeight: 1080,
+    subjectCutout,
+  }) as VideoItem
+
+describe('subject cut-out (FL-639)', () => {
+  it('is active for every background but Keep, and see-through only for Remove', () => {
+    expect(hasActiveSubjectCutout(clip())).toBe(false)
+    expect(hasActiveSubjectCutout(clip(cutout('keep')))).toBe(false)
+    expect(hasActiveSubjectCutout(clip(cutout('blur')))).toBe(true)
+    expect(isSeeThroughSubjectCutout(clip(cutout('blur')))).toBe(false)
+    expect(isSeeThroughSubjectCutout(clip(cutout('remove')))).toBe(true)
+  })
+
+  it('blends the two matte frames around a moment, inside the followed window only', () => {
+    expect(matteSample(matte, 3)).toEqual({ first: 0, second: 1, weight: 0 })
+    expect(matteSample(matte, 3.25)).toEqual({ first: 2, second: 3, weight: expect.closeTo(0.5, 6) })
+    expect(matteSample(matte, 4.96)).toEqual({ first: 19, second: 19, weight: 0 })
+    expect(matteSample(matte, 2.97)).toEqual({ first: 0, second: 1, weight: 0 })
+    expect(matteSample(matte, 2.9)).toBeNull()
+    expect(matteSample(matte, 5.1)).toBeNull()
+  })
+
+  it('reads matte frames row after row', () => {
+    expect(matteCell(matte, 0)).toEqual({ x: 0, y: 0, width: 192, height: 108 })
+    expect(matteCell(matte, 9)).toEqual({ x: 192, y: 108, width: 192, height: 108 })
+  })
+
+  it('turns gray into alpha on white', () => {
+    const data = new Uint8ClampedArray([200, 200, 200, 255, 0, 0, 0, 255])
+    lumaToAlpha(data)
+    expect([...data]).toEqual([255, 255, 255, 200, 255, 255, 255, 0])
+  })
+
+  it('scales softness and the Blur background with the frame', () => {
+    expect(cutoutBlurPixels(100, { width: 1920, height: 1080 })).toEqual({
+      edge: expect.closeTo(12.96, 6),
+      background: expect.closeTo(21.6, 6),
+    })
+    expect(cutoutBlurPixels(0, { width: 1920, height: 1080 }).edge).toBe(0)
+  })
+
+  it('maps a viewer point to the clip picture, undoing rotation and flips', () => {
+    const canvas = { width: 1920, height: 1080 }
+    const fullFrame = { x: 0, y: 0, width: 1920, height: 1080 }
+    expect(canvasPointToSourceFraction({ x: 480, y: 270 }, clip(), fullFrame, canvas)).toEqual({ x: 0.25, y: 0.25 })
+    expect(
+      canvasPointToSourceFraction({ x: 480, y: 270 }, clip(), { ...fullFrame, flipHorizontal: true }, canvas),
+    ).toEqual({ x: 0.75, y: 0.25 })
+    const turned = canvasPointToSourceFraction({ x: 1440, y: 810 }, clip(), { ...fullFrame, rotation: 180 }, canvas)
+    expect(turned!.x).toBeCloseTo(0.25, 6)
+    expect(turned!.y).toBeCloseTo(0.25, 6)
+    // A clip in the right half: a point in the left half is outside its picture.
+    expect(
+      canvasPointToSourceFraction({ x: 100, y: 540 }, clip(), { x: 480, y: 0, width: 960, height: 540 }, canvas),
+    ).toBeNull()
+  })
+
+  it('names its matte and photo by clip and file, so a new matte is a new image', () => {
+    expect(cutoutImageItem(clip(), 'matte', matte.importId)).toMatchObject({
+      id: `clip::cutout-matte::${matte.importId}`,
+      type: 'image',
+      mediaId: matte.importId,
+    })
+  })
+
+  it('a see-through cut-out never hides the tracks below it', () => {
+    const context: FrameOcclusionContext = {
+      frame: 70,
+      canvasWidth: 1920,
+      canvasHeight: 1080,
+      canvasSettings: { width: 1920, height: 1080, fps: 30 },
+      renderMode: 'export',
+      transitionClipIds: new Set(),
+      adjustmentLayers: [],
+      getCurrentItem: (item) => item,
+      getCurrentKeyframes: () => undefined,
+    }
+    expect(isItemFullyOccluding(clip(cutout('blur')), 0, context)).toBe(true)
+    expect(isItemFullyOccluding(clip(cutout('remove')), 0, context)).toBe(false)
+  })
+
+  describe('drawing', () => {
+    const target = () => ({ canvas: { width: 1920, height: 1080 } }) as OffscreenCanvasRenderingContext2D
+
+    it('draws the clip unchanged outside the followed window', async () => {
+      const drawClip = vi.fn().mockResolvedValue(true)
+      const ensureImageItemReady = vi.fn()
+      const ctx = target()
+      // Frame 200 is 7.6 s into the source, past the 3..5 s window.
+      const drawn = await renderVideoWithSubjectCutout(
+        ctx,
+        clip(cutout('blur')) as VideoItem & { subjectCutout: SubjectCutout },
+        { x: 0, y: 0, width: 1920, height: 1080, rotation: 0, opacity: 1, cornerRadius: 0 },
+        200,
+        createItemRenderContext({ ensureImageItemReady }),
+        0,
+        undefined,
+        drawClip,
+      )
+      expect(drawn).toBe(true)
+      expect(drawClip).toHaveBeenCalledWith(ctx)
+      expect(ensureImageItemReady).not.toHaveBeenCalled()
+    })
+
+    it('refuses to export a frame whose matte cannot be read, and previews it uncut', async () => {
+      const drawClip = vi.fn().mockResolvedValue(true)
+      const item = clip(cutout('remove')) as VideoItem & { subjectCutout: SubjectCutout }
+      const transform = { x: 0, y: 0, width: 1920, height: 1080, rotation: 0, opacity: 1, cornerRadius: 0 }
+      await expect(
+        renderVideoWithSubjectCutout(target(), item, transform, 70, createItemRenderContext({ ensureImageItemReady: vi.fn() }), 0, undefined, drawClip),
+      ).rejects.toThrow(SUBJECT_MATTE_UNAVAILABLE)
+      const preview = target()
+      await renderVideoWithSubjectCutout(
+        preview,
+        item,
+        transform,
+        70,
+        createItemRenderContext({ renderMode: 'preview', ensureImageItemReady: vi.fn() }),
+        0,
+        undefined,
+        drawClip,
+      )
+      expect(drawClip).toHaveBeenCalledWith(preview)
+    })
+  })
+})
