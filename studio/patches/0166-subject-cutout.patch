 }
 
 // Discriminated union types for different item types
+/** Frameleaf (FL-639): what is drawn behind a cut-out subject. */
+export type SubjectCutoutBackground = 'keep' | 'blur' | 'remove' | 'colour' | 'photo'
+
+/**
+ * Frameleaf (FL-639): the subject of a video clip, cut out with a matte the server made (SAM2.1 video
+ * on this server or a home computer). The matte is a project file (`matte.importId`): one grayscale
+ * frame per `1 / fps` seconds of the source from `startSeconds`, side by side, `columns` to a row.
+ */
+export interface SubjectCutout {
+  subject: { kind: 'person' | 'subject'; personId?: string; name?: string }
+  background: SubjectCutoutBackground
+  /** `#rrggbb`, for `colour`. */
+  colour?: string
+  /** A still from the bin, for `photo`. */
+  photo?: { mediaId: string }
+  /** Edge softness, 0 (hard) to 100. */
+  softness: number
+  matte: {
+    importId: string
+    startSeconds: number
+    durationSeconds: number
+    fps: number
+    frames: number
+    columns: number
+    frameWidth: number
+    frameHeight: number
+  }
+  /** Add to subject (1) and Take away (0) points the matte was made with, in source seconds and fractions. */
+  points?: Array<{ sourceSeconds: number; x: number; y: number; label: 0 | 1 }>
+}
+
 export type VideoItem = BaseTimelineItem & {
   type: 'video'
   src: string
+  /** Frameleaf (FL-639): Cut out the subject. */
+  subjectCutout?: SubjectCutout
   audioSrc?: string // Optional source used for audio playback when visuals use a silent proxy
   thumbnailUrl?: string
   offset?: number // Trim offset in source video
