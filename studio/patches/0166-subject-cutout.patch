+/**
+ * Frameleaf (FL-639): Add to subject / Take away, painted on the viewer.
+ *
+ * While the cut-out card is painting, a drag over the clip draws a stroke; when it ends the stroke is
+ * handed to the card (as a few points in fractions of the clip's picture) and the matte is made again,
+ * followed through the shot from this frame. Escape stops painting.
+ */
+import { memo, useCallback, useEffect, useMemo, useState, type PointerEvent } from 'react'
+import { useTranslation } from 'react-i18next'
+import { useItemsStore } from '@/features/preview/deps/timeline-store'
+import { canvasPointToSourceFraction } from '@/features/preview/deps/export-contract'
+import { usePlaybackStore } from '@/shared/state/playback'
+import { strokePoints, useSubjectCutoutPaintStore } from '@/shared/state/subject-cutout-paint'
+import { useVisualTransforms } from '../hooks/use-visual-transform'
+import { screenToCanvas } from '../utils/coordinate-transform'
+import type { CoordinateParams } from '../types/gizmo'
+
+interface SubjectCutoutPaintOverlayProps {
+  containerRect: DOMRect | null
+  playerSize: { width: number; height: number }
+  projectSize: { width: number; height: number }
+  zoom: number
+}
+
+export const SubjectCutoutPaintOverlay = memo(function SubjectCutoutPaintOverlay({
+  containerRect,
+  playerSize,
+  projectSize,
+  zoom,
+}: SubjectCutoutPaintOverlayProps) {
+  const { t } = useTranslation()
+  const itemId = useSubjectCutoutPaintStore((s) => s.itemId)
+  const label = useSubjectCutoutPaintStore((s) => s.label)
+  const item = useItemsStore(useCallback((s) => (itemId ? (s.itemById[itemId] ?? null) : null), [itemId]))
+  const transforms = useVisualTransforms(item ? [item] : [], projectSize)
+  const [stroke, setStroke] = useState<Array<{ screen: { x: number; y: number }; source: { x: number; y: number } }>>([])
+
+  const coordParams = useMemo(
+    (): CoordinateParams | null => (containerRect ? { containerRect, playerSize, projectSize, zoom } : null),
+    [containerRect, playerSize, projectSize, zoom],
+  )
+
+  useEffect(() => {
+    if (!itemId) return
+    const onKey = (event: KeyboardEvent) => {
+      if (event.key === 'Escape') useSubjectCutoutPaintStore.getState().stop()
+    }
+    window.addEventListener('keydown', onKey)
+    return () => window.removeEventListener('keydown', onKey)
+  }, [itemId])
+
+  if (!itemId || !item || item.type !== 'video' || !coordParams) return null
+  const transform = transforms.get(item.id)
+  if (!transform) return null
+
+  const sample = (event: PointerEvent<HTMLDivElement>) => {
+    const canvasPoint = screenToCanvas(event.clientX, event.clientY, coordParams)
+    const source = canvasPointToSourceFraction(
+      canvasPoint,
+      item,
+      { ...transform, flipHorizontal: item.transform?.flipHorizontal, flipVertical: item.transform?.flipVertical },
+      projectSize,
+    )
+    if (!source) return null
+    const bounds = event.currentTarget.getBoundingClientRect()
+    return { screen: { x: event.clientX - bounds.left, y: event.clientY - bounds.top }, source }
+  }
+
+  const colour = label === 1 ? 'rgba(46, 160, 67, 0.9)' : 'rgba(248, 81, 73, 0.9)'
+  return (
+    <div
+      className="pointer-events-auto absolute z-50 cursor-crosshair touch-none"
+      data-testid="subject-cutout-paint-overlay"
+      role="application"
+      aria-label={t(label === 1 ? 'cutout.paintAddHint' : 'cutout.paintTakeHint')}
+      style={{ left: 0, top: 0, width: playerSize.width, height: playerSize.height }}
+      onClick={(event) => event.stopPropagation()}
+      onPointerDown={(event) => {
+        event.stopPropagation()
+        event.currentTarget.setPointerCapture(event.pointerId)
+        const point = sample(event)
+        setStroke(point ? [point] : [])
+      }}
+      onPointerMove={(event) => {
+        if (!event.currentTarget.hasPointerCapture(event.pointerId)) return
+        const point = sample(event)
+        if (point) setStroke((current) => [...current, point])
+      }}
+      onPointerUp={(event) => {
+        event.stopPropagation()
+        if (stroke.length > 0) {
+          useSubjectCutoutPaintStore.getState().finish({
+            itemId,
+            label,
+            points: strokePoints(stroke.map((point) => point.source)),
+            frame: usePlaybackStore.getState().currentFrame,
+          })
+        }
+        setStroke([])
+      }}
+    >
+      <svg className="pointer-events-none absolute inset-0 h-full w-full" aria-hidden="true">
+        <polyline
+          points={stroke.map((point) => `${point.screen.x},${point.screen.y}`).join(' ')}
+          fill="none"
+          stroke={colour}
+          strokeWidth={14}
+          strokeLinecap="round"
+          strokeLinejoin="round"
+        />
+      </svg>
+    </div>
+  )
+})
