+import { useEffect, useMemo, useRef, useState } from 'react'
+import { useTranslation } from 'react-i18next'
+import { Brush, Eraser, UserSquare } from 'lucide-react'
+import { toast } from 'sonner'
+import { Button } from '@/components/ui/button'
+import { Progress } from '@/components/ui/progress'
+import { Slider } from '@/components/ui/slider'
+import type { SubjectCutout, SubjectCutoutBackground, VideoItem } from '@/types/timeline'
+import {
+  cutoutRequestPoints,
+  setSubjectCutout,
+  updateSubjectCutout,
+  useTimelineStore,
+} from '@/features/editor/deps/timeline-store'
+import { useMediaLibraryStore } from '@/features/editor/deps/media-library'
+import {
+  getSubjectCutoutHost,
+  type SubjectCutoutJob,
+  type SubjectCutoutPerson,
+} from '@/shared/state/subject-cutout-host'
+import { useSubjectCutoutPaintStore } from '@/shared/state/subject-cutout-paint'
+import { blobUrlManager } from '@/infrastructure/browser/blob-url-manager'
+import { PropertySection } from '../components'
+
+const CUTOUT_BACKGROUNDS: SubjectCutoutBackground[] = ['keep', 'blur', 'remove', 'colour', 'photo']
+const CUTOUT_COLOURS = ['#ffffff', '#111111', '#1f6feb', '#2da44e', '#f2cc60']
+const DEFAULT_SOFTNESS = 40
+const POLL_MS = 1000
+
+const MAIN_SUBJECT: SubjectCutoutPerson = { kind: 'subject', personId: null, name: null }
+const sleep = (ms: number, signal: AbortSignal) =>
+  new Promise<void>((resolve, reject) => {
+    const timer = setTimeout(resolve, ms)
+    signal.addEventListener('abort', () => {
+      clearTimeout(timer)
+      reject(new DOMException('Aborted', 'AbortError'))
+    }, { once: true })
+  })
+
+const initials = (name: string) =>
+  name.split(/\s+/).filter(Boolean).slice(0, 2).map((part) => part[0]!.toUpperCase()).join('')
+
+/**
+ * Cut out the subject (FL-639), on the Edit inspector for one video clip. The subject is one of the
+ * people recognised in the clip (or the main subject); the server follows it through the shot and the
+ * clip is drawn through the matte with the chosen background.
+ */
+export function SubjectCutoutSection({ item }: { item: VideoItem }) {
+  const { t } = useTranslation()
+  const host = getSubjectCutoutHost()
+  const fps = useTimelineStore((s) => s.fps)
+  const cutout = item.subjectCutout
+  const [subjects, setSubjects] = useState<SubjectCutoutPerson[]>([MAIN_SUBJECT])
+  const [chosen, setChosen] = useState<string | null>(cutout?.subject.personId ?? null)
+  const [progress, setProgress] = useState<number | null>(null)
+  const [refining, setRefining] = useState(false)
+  const abortRef = useRef<AbortController | null>(null)
+  const painting = useSubjectCutoutPaintStore((s) => (s.itemId === item.id ? s.label : null))
+  const pendingStrokes = useSubjectCutoutPaintStore((s) => s.strokes.some((stroke) => stroke.itemId === item.id))
+  const photos = useMediaLibraryStore((s) => s.mediaItems)
+    .filter((media) => media.mimeType.startsWith('image/') && media.mimeType !== 'image/svg+xml')
+    .slice(0, 6)
+
+  useEffect(() => () => {
+    abortRef.current?.abort()
+    if (useSubjectCutoutPaintStore.getState().itemId === item.id) useSubjectCutoutPaintStore.getState().stop()
+  }, [item.id])
+
+  useEffect(() => {
+    if (!host) return
+    const controller = new AbortController()
+    host.subjects(item.id).then(
+      (found) => {
+        if (controller.signal.aborted || found.length === 0) return
+        setSubjects(found)
+        setChosen((current) => current ?? found.find((entry) => entry.kind === 'person')?.personId ?? null)
+      },
+      () => {},
+    )
+    return () => controller.abort()
+  }, [host, item.id])
+
+  const who = useMemo(
+    () => subjects.find((entry) => entry.personId === chosen) ?? subjects[0] ?? MAIN_SUBJECT,
+    [subjects, chosen],
+  )
+  const name = who.kind === 'person' && who.name ? who.name : t('cutout.mainSubject')
+  const found = !!cutout && (cutout.subject.personId ?? null) === (who.personId ?? null)
+
+  const run = async (points: NonNullable<SubjectCutout['points']>, refine: boolean) => {
+    if (!host) return
+    abortRef.current?.abort()
+    const controller = new AbortController()
+    abortRef.current = controller
+    setProgress(0)
+    setRefining(refine)
+    try {
+      let job: SubjectCutoutJob = await host.start({ clipId: item.id, personId: who.personId, points })
+      while (job.status === 'queued' || job.status === 'running') {
+        setProgress(job.progress)
+        await sleep(POLL_MS, controller.signal)
+        job = await host.read(job.id)
+      }
+      if (job.status === 'failed' || !job.matte) {
+        toast.error(t('cutout.failed', { name, reason: job.error ?? '' }))
+        return
+      }
+      if (!(await host.whenMatteReady(job.matte.importId, controller.signal))) {
+        toast.error(t('cutout.failed', { name, reason: t('cutout.notKept') }))
+        return
+      }
+      const kept = setSubjectCutout(item.id, {
+        subject: { kind: who.kind, ...(who.personId && { personId: who.personId }), ...(who.name && { name: who.name }) },
+        background: cutout?.background ?? 'blur',
+        ...(cutout?.colour && { colour: cutout.colour }),
+        ...(cutout?.photo && { photo: cutout.photo }),
+        softness: cutout?.softness ?? DEFAULT_SOFTNESS,
+        matte: job.matte,
+        ...(points.length > 0 && { points }),
+      })
+      if (!kept) toast.warning(t('cutout.locked'))
+      else if (!refine) toast.success(t('cutout.found', { name, clip: item.label }))
+    } catch (error) {
+      if (controller.signal.aborted || (error instanceof DOMException && error.name === 'AbortError')) return
+      toast.error(t('cutout.failed', { name, reason: error instanceof Error ? error.message : '' }))
+    } finally {
+      if (abortRef.current === controller) {
+        setProgress(null)
+        setRefining(false)
+      }
+    }
+  }
+
+  // A finished stroke on the viewer becomes Add to subject / Take away points, followed through the shot.
+  useEffect(() => {
+    if (!pendingStrokes || progress !== null || !cutout) return
+    const strokes = useSubjectCutoutPaintStore.getState().take(item.id)
+    const added = cutoutRequestPoints(item, strokes, fps)
+    if (added.length > 0) void run([...(cutout.points ?? []), ...added].slice(-64), true)
+    // eslint-disable-next-line react-hooks/exhaustive-deps -- run reads the latest clip on purpose
+  }, [pendingStrokes, progress, cutout, item.id, fps])
+
+  if (!host) return null
+  const busy = progress !== null
+  const paint = (label: 0 | 1) => {
+    const store = useSubjectCutoutPaintStore.getState()
+    if (painting === label) store.stop()
+    else {
+      store.start(item.id, label)
+      toast.info(t(label === 1 ? 'cutout.paintAddHint' : 'cutout.paintTakeHint'))
+    }
+  }
+
+  return (
+    <PropertySection title={t('cutout.title')} icon={UserSquare} defaultOpen={false}>
+      <div className="space-y-3 px-1 py-2 text-xs">
+        {(subjects.length > 1 || subjects[0]?.kind === 'person') && (
+          <div role="radiogroup" aria-label={t('cutout.subject')} className="flex flex-wrap gap-2">
+            {subjects.map((entry) => {
+              const on = (entry.personId ?? null) === (who.personId ?? null)
+              const label = entry.kind === 'person' && entry.name ? entry.name : t('cutout.mainSubject')
+              return (
+                <button
+                  key={entry.personId ?? 'subject'}
+                  type="button"
+                  role="radio"
+                  aria-checked={on}
+                  disabled={busy}
+                  className={`flex items-center gap-2 rounded-full border px-2 py-1 ${on ? 'border-primary bg-primary/10' : 'border-border'}`}
+                  onClick={() => setChosen(entry.personId)}
+                >
+                  <span aria-hidden="true" className="flex h-6 w-6 items-center justify-center rounded-full bg-muted text-[10px] font-medium">
+                    {initials(label)}
+                  </span>
+                  <span>{label}</span>
+                </button>
+              )
+            })}
+          </div>
+        )}
+
+        {busy && (
+          <div aria-live="polite" className="space-y-1">
+            <p>{refining ? t('cutout.refining') : who.kind === 'person' ? t('cutout.finding', { name }) : t('cutout.findingSubject')}</p>
+            <Progress value={progress ?? 0} className="h-1.5" aria-label={t('cutout.title')} />
+          </div>
+        )}
+
+        {!found ? (
+          <Button size="sm" className="h-7 w-full text-xs" disabled={busy} onClick={() => void run([], false)}>
+            {who.kind === 'person' ? t('cutout.find', { name }) : t('cutout.findSubject')}
+          </Button>
+        ) : (
+          <>
+            <div role="radiogroup" aria-label={t('cutout.background')} className="grid grid-cols-1 gap-1">
+              {CUTOUT_BACKGROUNDS.map((background) => (
+                <button
+                  key={background}
+                  type="button"
+                  role="radio"
+                  aria-checked={cutout!.background === background}
+                  className={`rounded border px-2 py-1 text-start ${cutout!.background === background ? 'border-primary bg-primary/10' : 'border-border'}`}
+                  onClick={() => updateSubjectCutout(item.id, { background })}
+                >
+                  <b className="block">{t(`cutout.backgrounds.${background}.label`)}</b>
+                  <span className="text-muted-foreground">{t(`cutout.backgrounds.${background}.note`)}</span>
+                </button>
+              ))}
+            </div>
+
+            {cutout!.background === 'colour' && (
+              <div role="radiogroup" aria-label={t('cutout.backgroundColour')} className="flex gap-2">
+                {CUTOUT_COLOURS.map((colour) => (
+                  <button
+                    key={colour}
+                    type="button"
+                    role="radio"
+                    aria-checked={(cutout!.colour ?? CUTOUT_COLOURS[2]) === colour}
+                    aria-label={colour}
+                    className={`h-6 w-6 rounded-full border ${(cutout!.colour ?? CUTOUT_COLOURS[2]) === colour ? 'ring-2 ring-primary' : 'border-border'}`}
+                    style={{ background: colour }}
+                    onClick={() => updateSubjectCutout(item.id, { colour })}
+                  />
+                ))}
+              </div>
+            )}
+
+            {cutout!.background === 'photo' && (
+              photos.length > 0 ? (
+                <div role="radiogroup" aria-label={t('cutout.backgroundPhoto')} className="grid grid-cols-3 gap-1">
+                  {photos.map((media) => (
+                    <button
+                      key={media.id}
+                      type="button"
+                      role="radio"
+                      aria-checked={cutout!.photo?.mediaId === media.id}
+                      aria-label={media.fileName}
+                      className={`aspect-video overflow-hidden rounded border ${cutout!.photo?.mediaId === media.id ? 'ring-2 ring-primary' : 'border-border'}`}
+                      onClick={() => updateSubjectCutout(item.id, { photo: { mediaId: media.id } })}
+                    >
+                      <img src={blobUrlManager.get(media.id) ?? ''} alt="" className="h-full w-full object-cover" />
+                    </button>
+                  ))}
+                </div>
+              ) : (
+                <p className="text-muted-foreground">{t('cutout.noPhotos')}</p>
+              )
+            )}
+
+            <label className="block space-y-1">
+              <span>{t('cutout.softness', { value: cutout!.softness })}</span>
+              <Slider
+                min={0}
+                max={100}
+                step={1}
+                value={[cutout!.softness]}
+                aria-label={t('cutout.softnessLabel')}
+                onValueCommit={([value]) => updateSubjectCutout(item.id, { softness: value ?? DEFAULT_SOFTNESS })}
+              />
+            </label>
+
+            <div className="flex flex-wrap gap-2">
+              <Button variant={painting === 1 ? 'default' : 'ghost'} size="sm" className="h-7 flex-1 text-xs" disabled={busy}
+                aria-pressed={painting === 1} onClick={() => paint(1)}>
+                <Brush className="me-1 h-3 w-3" aria-hidden="true" />{t('cutout.addToSubject')}
+              </Button>
+              <Button variant={painting === 0 ? 'default' : 'ghost'} size="sm" className="h-7 flex-1 text-xs" disabled={busy}
+                aria-pressed={painting === 0} onClick={() => paint(0)}>
+                <Eraser className="me-1 h-3 w-3" aria-hidden="true" />{t('cutout.takeAway')}
+              </Button>
+              <Button variant="ghost" size="sm" className="h-7 flex-1 text-xs" disabled={busy}
+                onClick={() => { useSubjectCutoutPaintStore.getState().stop(); setSubjectCutout(item.id, null) }}>
+                {t('cutout.remove')}
+              </Button>
+            </div>
+          </>
+        )}
+
+        <p className="text-muted-foreground">{t('cutout.whereItRuns')}</p>
+      </div>
+    </PropertySection>
+  )
+}
