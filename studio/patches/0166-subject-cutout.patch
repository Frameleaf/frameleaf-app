+  type SubjectCutoutHost,
+  type SubjectCutoutJob,
+} from '@/shared/state/subject-cutout-host'
+import { useSubjectCutoutPaintStore } from '@/shared/state/subject-cutout-paint'
+import { SubjectCutoutSection } from './subject-cutout-section'
+
+vi.mock('react-i18next', () => ({
+  useTranslation: () => ({
+    t: (key: string, values?: Record<string, unknown>) => (values?.name ? `${key}:${values.name}` : key),
