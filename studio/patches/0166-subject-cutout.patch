+import { describe, expect, it, vi } from 'vite-plus/test'
+import type { SubjectCutout, VideoItem } from '@/types/timeline'
+import { createItemRenderContext } from './canvas-item-renderer-test-helpers'
+import { isItemFullyOccluding, type FrameOcclusionContext } from './frame-occlusion'
+import {
+  SUBJECT_MATTE_UNAVAILABLE,
+  canvasPointToSourceFraction,
+  cutoutBlurPixels,
+  cutoutImageItem,
