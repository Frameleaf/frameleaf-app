+/**
+ * Frameleaf (FL-639): the host side of Cut out the subject.
+ *
+ * Finding a subject needs the server (face recognition and SAM2.1 video on this server or a computer at
+ * home), which the editor reaches only through its host. The adapter registers these calls when the
+ * editor mounts inside Frameleaf; without them (plain Freecut, headless export) the card is not offered.
+ */
+import type { SubjectCutout } from '@/types/timeline'
+
+export type SubjectCutoutPerson = { kind: 'person' | 'subject'; personId: string | null; name: string | null }
+
+export type SubjectCutoutJob = {
+  id: string
+  status: 'queued' | 'running' | 'completed' | 'failed'
+  progress: number
+  error: string | null
+  matte: SubjectCutout['matte'] | null
+}
+
+export interface SubjectCutoutHost {
+  /** Who the cut-out can follow in a clip: the named people recognised in it, or the main subject. */
+  subjects(clipId: string): Promise<SubjectCutoutPerson[]>
+  start(request: {
+    clipId: string
+    personId: string | null
+    points: NonNullable<SubjectCutout['points']>
+  }): Promise<SubjectCutoutJob>
+  read(cutoutId: string): Promise<SubjectCutoutJob>
+  /** Resolves once the matte file can be read by the renderer (the host has handed it over). */
+  whenMatteReady(importId: string, signal: AbortSignal): Promise<boolean>
+}
+
+let host: SubjectCutoutHost | null = null
+
+export function registerSubjectCutoutHost(next: SubjectCutoutHost | null): void {
+  host = next
+}
+
+export function getSubjectCutoutHost(): SubjectCutoutHost | null {
+  return host
+}
diff --git a/src/shared/state/subject-cutout-paint.ts b/src/shared/state/subject-cutout-paint.ts
