+}))
+vi.mock('sonner', () => ({ toast: { success: vi.fn(), error: vi.fn(), warning: vi.fn(), info: vi.fn() } }))
+vi.mock('../components', () => ({
+  PropertySection: ({ children }: { children: ReactNode }) => <>{children}</>,
+}))
+
+const matte: SubjectCutout['matte'] = {
+  importId: '0195e2a0-0000-4000-8000-000000000050',
+  startSeconds: 0,
+  durationSeconds: 3,
+  fps: 10,
+  frames: 30,
+  columns: 30,
+  frameWidth: 192,
+  frameHeight: 108,
+}
+
+const CLIP: VideoItem = {
+  id: 'clip-1',
+  type: 'video',
+  trackId: 'track-1',
+  from: 0,
+  durationInFrames: 90,
+  label: 'Lake',
+  src: 'blob:video',
+  mediaId: 'media-1',
+  sourceWidth: 1920,
+  sourceHeight: 1080,
+}
+
+const host = (jobs: SubjectCutoutJob[]): SubjectCutoutHost & { start: ReturnType<typeof vi.fn> } => {
+  const queue = [...jobs]
+  return {
+    subjects: vi.fn(async () => [
+      { kind: 'person' as const, personId: '0195e2a0-0000-4000-8000-000000000051', name: 'Jamie' },
+      { kind: 'person' as const, personId: '0195e2a0-0000-4000-8000-000000000052', name: 'Sam' },
+    ]),
+    start: vi.fn(async () => queue.shift()!),
+    read: vi.fn(async () => queue.shift()!),
+    whenMatteReady: vi.fn(async () => true),
+  }
+}
+
+const current = () => useItemsStore.getState().itemById['clip-1'] as VideoItem
+
+describe('Cut out the subject card (FL-639)', () => {
+  beforeEach(() => {
+    vi.useFakeTimers({ shouldAdvanceTime: true })
+    useTimelineStore.setState({ items: [CLIP], fps: 30 })
+  })
+  afterEach(() => {
+    registerSubjectCutoutHost(null)
+    vi.useRealTimers()
+  })
+
+  it('is not offered without a host that can find subjects', () => {
+    const { container } = render(<SubjectCutoutSection item={CLIP} />)
+    expect(container).toBeEmptyDOMElement()
+  })
+
+  it('finds Jamie, follows them through the clip and keeps the matte on the clip with a blurred background', async () => {
+    const fake = host([
+      { id: 'job', status: 'running', progress: 40, error: null, matte: null },
+      { id: 'job', status: 'completed', progress: 100, error: null, matte },
+    ])
+    registerSubjectCutoutHost(fake)
+    render(<SubjectCutoutSection item={CLIP} />)
+    const find = await screen.findByRole('button', { name: 'cutout.find:Jamie' })
+    expect(screen.getByRole('radio', { name: /Jamie/ })).toHaveAttribute('aria-checked', 'true')
+    fireEvent.click(find)
+    expect(await screen.findByText('cutout.finding:Jamie')).toBeInTheDocument()
+    await act(async () => {
+      await vi.advanceTimersByTimeAsync(1100)
+    })
+    await waitFor(() => expect(current().subjectCutout).toBeDefined())
+    expect(fake.start).toHaveBeenCalledWith({
+      clipId: 'clip-1',
+      personId: '0195e2a0-0000-4000-8000-000000000051',
+      points: [],
+    })
+    expect(fake.whenMatteReady).toHaveBeenCalledWith(matte.importId, expect.any(AbortSignal))
+    expect(current().subjectCutout).toEqual({
+      subject: { kind: 'person', personId: '0195e2a0-0000-4000-8000-000000000051', name: 'Jamie' },
+      background: 'blur',
+      softness: 40,
+      matte,
+    })
+  })
+
+  it('changes the background, and paints Take away points that make the matte again', async () => {
+    const found: SubjectCutout = {
+      subject: { kind: 'person', personId: '0195e2a0-0000-4000-8000-000000000051', name: 'Jamie' },
+      background: 'blur',
+      softness: 40,
+      matte,
+    }
+    useTimelineStore.setState({ items: [{ ...CLIP, subjectCutout: found }], fps: 30 })
+    const fake = host([{ id: 'again', status: 'completed', progress: 100, error: null, matte: { ...matte, importId: '0195e2a0-0000-4000-8000-000000000053' } }])
+    registerSubjectCutoutHost(fake)
+    const { rerender } = render(<SubjectCutoutSection item={current()} />)
+    await screen.findByRole('radio', { name: /Jamie/ })
+    fireEvent.click(screen.getByRole('radio', { name: /cutout.backgrounds.remove.label/ }))
+    expect(current().subjectCutout?.background).toBe('remove')
+    rerender(<SubjectCutoutSection item={current()} />)
+
+    fireEvent.click(screen.getByRole('button', { name: 'cutout.takeAway' }))
+    expect(useSubjectCutoutPaintStore.getState()).toMatchObject({ itemId: 'clip-1', label: 0 })
+    act(() => {
+      useSubjectCutoutPaintStore.getState().finish({ itemId: 'clip-1', label: 0, frame: 15, points: [{ x: 0.9, y: 0.1 }] })
+    })
+    await waitFor(() => expect(fake.start).toHaveBeenCalled())
+    expect(fake.start).toHaveBeenCalledWith({
+      clipId: 'clip-1',
+      personId: '0195e2a0-0000-4000-8000-000000000051',
+      points: [{ sourceSeconds: 0.5, x: 0.9, y: 0.1, label: 0 }],
+    })
+    await waitFor(() => expect(current().subjectCutout?.matte.importId).toBe('0195e2a0-0000-4000-8000-000000000053'))
+    // The new matte keeps what the person chose.
+    expect(current().subjectCutout).toMatchObject({ background: 'remove', points: [{ sourceSeconds: 0.5, label: 0 }] })
+
+    rerender(<SubjectCutoutSection item={current()} />)
+    fireEvent.click(screen.getByRole('button', { name: 'cutout.remove' }))
+    expect(current().subjectCutout).toBeUndefined()
+  })
+})
