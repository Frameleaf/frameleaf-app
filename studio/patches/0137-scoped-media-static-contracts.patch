diff --git a/src/test/scoped-media-contract.test.ts b/src/test/scoped-media-contract.test.ts
new file mode 100644
--- /dev/null
+++ b/src/test/scoped-media-contract.test.ts
@@ -0,0 +1,157 @@
+import { afterEach, describe, expect, it, vi } from 'vite-plus/test'
+import * as editorMedia from '@/features/editor/deps/media-library'
+import * as exportMedia from '@/features/export/deps/media-library'
+import * as previewMedia from '@/features/preview/deps/media-library'
+import * as scopedMedia from '@/features/media-library/utils/scoped-media-resolution'
+import { createCompositionRenderer } from '@/features/export/utils/client-render-engine'
+import { blobUrlManager } from '@/infrastructure/browser/blob-url-manager'
+import type { LottieItem } from '@/types/timeline'
+
+describe('consumer media contracts preserve scoped authority', () => {
+  it.each([editorMedia, exportMedia, previewMedia])(
+    'shares the installed resolver and hides scope mutation',
+    (contract) => {
+      for (const name of ['peekScopedMedia', 'scopedMediaEpoch', 'subscribeScopedMedia'] as const)
+        expect(contract).toHaveProperty(name, scopedMedia[name])
+      expect(contract).not.toHaveProperty('installScopedMediaResolver')
+      expect(contract).not.toHaveProperty('notifyScopedMedia')
+    },
+  )
+  it('exports resolution only to the renderer that needs it', () => {
+    expect(exportMedia).toHaveProperty('resolveScopedMedia', scopedMedia.resolveScopedMedia)
+    expect(editorMedia).not.toHaveProperty('resolveScopedMedia')
+    expect(previewMedia).not.toHaveProperty('resolveScopedMedia')
+  })
+})
+
+const source = vi.hoisted(() => ({ resolve: vi.fn<() => Promise<string>>() }))
+vi.mock('@/features/media-library/utils/media-resolver', async (importOriginal) => ({
+  ...(await importOriginal<typeof import('@/features/media-library/utils/media-resolver')>()),
+  resolveMediaUrl: source.resolve,
+}))
+
+const item: LottieItem = {
+  id: 'lottie',
+  type: 'lottie',
+  trackId: 'track',
+  from: 0,
+  durationInFrames: 24,
+  label: 'Lottie',
+  mediaId: 'missing',
+  src: '',
+  frameRate: 24,
+  totalFrames: 24,
+}
+const rendererFor = async (src = '') => {
+  const canvas = new OffscreenCanvas(1, 1)
+  const ctx = canvas.getContext('2d')
+  if (!ctx) throw new Error('Missing test canvas context')
+  return createCompositionRenderer(
+    {
+      width: 1,
+      height: 1,
+      fps: 24,
+      durationInFrames: 24,
+      tracks: [
+        {
+          id: 'track',
+          name: 'track',
+          order: 0,
+          height: 64,
+          locked: false,
+          visible: true,
+          muted: false,
+          solo: false,
+          items: [{ ...item, src }],
+        },
+      ],
+    },
+    canvas,
+    ctx,
+    { strictLottie: true },
+  )
+}
+
+afterEach(() => {
+  vi.restoreAllMocks()
+  vi.unstubAllGlobals()
+  source.resolve.mockReset()
+})
+const setup = () => {
+  vi.stubGlobal(
+    'OffscreenCanvas',
+    class {
+      constructor(
+        public width: number,
+        public height: number,
+      ) {}
+      getContext() {
+        return { canvas: this, clearRect: vi.fn() }
+      }
+    },
+  )
+  vi.stubGlobal('fetch', vi.fn())
+}
+
+describe('renderer nullable Lottie source guards', () => {
+  it('skips unavailable unscoped media without fetching or loading Lottie', async () => {
+    setup()
+    source.resolve.mockResolvedValue('')
+    const renderer = await rendererFor()
+    try {
+      await expect(renderer.preload()).resolves.toBeUndefined()
+      expect(source.resolve).toHaveBeenCalledTimes(1)
+      expect(fetch).not.toHaveBeenCalled()
+    } finally {
+      renderer.dispose()
+    }
+  })
+  it('refuses installed handled-empty scope before stale source or blob fallback', async () => {
+    setup()
+    const blob = vi.spyOn(blobUrlManager, 'get').mockReturnValue('blob:stale-cache')
+    const uninstall = scopedMedia.installScopedMediaResolver({
+      peek: () => ({ handled: true, url: '' }),
+      resolve: async () => ({ handled: true, url: '' }),
+    })
+    const renderer = await rendererFor('blob:stale-item')
+    try {
+      await expect(renderer.preload()).rejects.toThrow('LOTTIE_LOAD_OR_EDIT_FAILED')
+      expect(blob).not.toHaveBeenCalled()
+      expect(source.resolve).not.toHaveBeenCalled()
+      expect(fetch).not.toHaveBeenCalled()
+    } finally {
+      renderer.dispose()
+      uninstall()
+    }
+  })
+  it.each(['epoch', 'cancel'] as const)(
+    'checks %s before returning an awaited null source',
+    async (change) => {
+      setup()
+      let finish!: (value: string) => void, started!: () => void
+      const waiting = new Promise<void>((resolve) => {
+        started = resolve
+      })
+      source.resolve.mockImplementation(() => {
+        started()
+        return new Promise<string>((resolve) => {
+          finish = resolve
+        })
+      })
+      const renderer = await rendererFor(),
+        controller = new AbortController()
+      try {
+        const pending = renderer.preload({ signal: controller.signal })
+        const rejected = expect(pending).rejects.toThrow()
+        await waiting
+        if (change === 'epoch') scopedMedia.notifyScopedMedia()
+        else controller.abort()
+        finish('')
+        await rejected
+        expect(fetch).not.toHaveBeenCalled()
+      } finally {
+        renderer.dispose()
+      }
+    },
+  )
+})
