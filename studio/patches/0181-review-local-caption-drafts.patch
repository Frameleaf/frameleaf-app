+          preparing || transcriptStatus === 'queued' || transcriptStatus === 'transcribing'
+        }
+        progressPercent={transcriptProgress ? Math.round(transcriptProgress.progress * 100) : null}
+        progressIndeterminate={
+          transcriptProgress ? isIndeterminateTranscriptionProgress(transcriptProgress) : false
+        }
+        progressLabel={
+          transcriptProgress ? getTranscriptionProgressLabel(transcriptProgress) : 'Transcribing...'
+        }
+        progressDetail={
+          transcriptProgress ? getTranscriptionProgressDetail(transcriptProgress) : null
+        }
+        errorMessage={dialogError}
+        onStartCloud={
+          cloudHost
+            ? (language) => {
+                setDialogOpen(false)
+                cloudHost.start({ clipId: itemId, language })
+              }
+            : undefined
+        }
+        onStart={(values) => {
+          void generate(values)
+        }}
+        onCancel={() => cancelMediaTranscriptionJob(itemMediaId)}
+      />
+      <Dialog
+        open={!!draft}
+        onOpenChange={(open) => {
+          if (!open && !applying) setDraft(null)
+        }}
+      >
+        <DialogContent>
+          <DialogHeader>
+            <DialogTitle>
+              {t('transcript.reviewTitle', { defaultValue: 'Review captions' })}
+            </DialogTitle>
+            <DialogDescription>
+              {draft?.replaceExisting
+                ? t('transcript.reviewReplace', {
+                    defaultValue:
+                      'Applying replaces this clip’s generated captions and refreshes linked captions.',
+                  })
+                : t('transcript.reviewApply', {
+                    defaultValue:
+                      'Check the text before applying. Linked captions that use this transcript will also refresh.',
+                  })}
+            </DialogDescription>
+          </DialogHeader>
+          <ol className="max-h-[45vh] space-y-2 overflow-y-auto text-sm">
+            {draft?.lines.map((line, index) => (
+              <li key={line.id ?? index}>{line.text}</li>
+            ))}
+          </ol>
+          {reviewError && (
+            <p role="alert" className="text-sm text-destructive">
+              {reviewError}
+            </p>
+          )}
+          <DialogFooter>
+            <Button variant="outline" disabled={applying} onClick={() => setDraft(null)}>
+              {t('common.cancel', { defaultValue: 'Cancel' })}
+            </Button>
+            <Button
+              disabled={applying || !!reviewError}
+              onClick={() => {
+                void apply()
+              }}
+            >
+              {t('transcript.applyCaptions', { defaultValue: 'Apply captions' })}
+            </Button>
+          </DialogFooter>
+        </DialogContent>
+      </Dialog>
+    </>
   )
 })
