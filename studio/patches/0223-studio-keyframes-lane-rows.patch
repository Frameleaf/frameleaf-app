+import { fireEvent, render, screen } from '@testing-library/react'
+import { describe, expect, it, vi } from 'vite-plus/test'
+import { DopesheetInterpolationButtons } from './dopesheet-interpolation-buttons'
+
+const options = [
+  { value: 'linear' as const, label: 'Linear' },
+  { value: 'ease-in-out' as const, label: 'Ease in and out' },
+]
+
+describe('Easing menu of the keyframes lane (FL-1822)', () => {
+  it('names the selected easing and picks another from the menu', async () => {
+    const onSelect = vi.fn()
+    render(
+      <DopesheetInterpolationButtons
+        menu
+        options={options}
+        selected="ease-in-out"
+        disabled={false}
+        onSelect={onSelect}
+      />,
+    )
+    const trigger = screen.getByRole('button', { name: 'Easing: Ease in and out' })
+    fireEvent.pointerDown(trigger, { button: 0, ctrlKey: false, pointerType: 'mouse' })
+    fireEvent.click(await screen.findByRole('menuitemcheckbox', { name: 'Linear' }))
+    expect(onSelect).toHaveBeenCalledWith('linear')
+  })
+
+  it('reads Easing and is unavailable with no keyframe selected', () => {
+    render(<DopesheetInterpolationButtons menu options={options} selected={null} disabled />)
+    expect(screen.getByRole('button', { name: 'Easing' })).toBeDisabled()
+  })
+})
