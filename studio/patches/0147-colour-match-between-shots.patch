+++ b/src/features/timeline/utils/colour-match.ts
@@ -0,0 +1,152 @@
+import type { ItemEffect } from '@/types/effects'
+
+/**
+ * Colour matching between shots (FL-599).
+ *
+ * A match is two existing, editable effects appended after the clip's grade:
+ * gpu-exposure (gain 2^EV) then gpu-temperature (temperature/tint offsets).
+ * In an SDR project both act on the working (sRGB-encoded) values linearly,
+ * so the full-strength match that moves the target's mid-tone channel means
+ * onto the reference's is the exact solution of three linear equations:
+ *
+ *   g·tR + 0.1·T + 0.05·τ = rR
+ *   g·tG − 0.1·τ          = rG
+ *   g·tB − 0.1·T + 0.05·τ = rB
+ *
+ * Strength scales EV, temperature and tint from their identity (0), so zero
+ * strength is an exact no-op and the effects are removed.
+ */
+
+export const COLOUR_MATCH_ID_PREFIX = 'colour-match:'
+const COLOUR_MATCH_ALGORITHM = 'mean-gain-wb-v1'
+
+/** Pixels with any channel this close to 0 or 1 are clipped and ignored. */
+const CLIP_MARGIN = 0.02
+const MIN_USABLE_FRACTION = 0.25
+const MIN_LUMA_SPREAD = 0.02
+const MAX_EV = 1.5
+const MAX_SHIFT = 0.6
+
+export interface ColourSampleStats {
+  /** Mean working value per channel over usable pixels. */
+  mean: [number, number, number]
+  /** Fraction of pixels not clipped. */
+  usableFraction: number
+  /** Standard deviation of usable-pixel luma. */
+  lumaSpread: number
+}
+
+export type ColourMatchFlag = 'clipped' | 'flat' | 'extreme'
+
+export interface ColourMatchParams {
+  exposure: number
+  temperature: number
+  tint: number
+}
+
+export interface ColourMatchProposal {
+  /** Full-strength parameters. */
+  params: ColourMatchParams
+  /** Reasons the match should not be applied; empty when it is usable. */
+  flags: ColourMatchFlag[]
+}
+
+/** Statistics of RGBA8 pixels (as from canvas getImageData) in the SDR working space. */
+export function sampleStats(rgba: Uint8ClampedArray): ColourSampleStats {
+  let count = 0
+  let total = 0
+  let sumR = 0, sumG = 0, sumB = 0
+  const lumas: number[] = []
+  for (let i = 0; i + 3 < rgba.length; i += 4) {
+    total += 1
+    const r = rgba[i]! / 255
+    const g = rgba[i + 1]! / 255
+    const b = rgba[i + 2]! / 255
+    if (Math.min(r, g, b) < CLIP_MARGIN || Math.max(r, g, b) > 1 - CLIP_MARGIN) continue
+    count += 1
+    sumR += r; sumG += g; sumB += b
+    lumas.push(0.2126 * r + 0.7152 * g + 0.0722 * b)
+  }
+  const mean: [number, number, number] = count > 0 ? [sumR / count, sumG / count, sumB / count] : [0, 0, 0]
+  const lumaMean = lumas.reduce((a, v) => a + v, 0) / Math.max(1, lumas.length)
+  const lumaSpread = Math.sqrt(lumas.reduce((a, v) => a + (v - lumaMean) ** 2, 0) / Math.max(1, lumas.length))
+  return { mean, usableFraction: total > 0 ? count / total : 0, lumaSpread }
+}
+
+export function proposeColourMatch(reference: ColourSampleStats, target: ColourSampleStats): ColourMatchProposal {
+  const flags: ColourMatchFlag[] = []
+  if (reference.usableFraction < MIN_USABLE_FRACTION || target.usableFraction < MIN_USABLE_FRACTION) flags.push('clipped')
+  if (reference.lumaSpread < MIN_LUMA_SPREAD || target.lumaSpread < MIN_LUMA_SPREAD) flags.push('flat')
+
+  const [rR, rG, rB] = reference.mean
+  const [tR, tG, tB] = target.mean
+  const targetSum = tR + tG + tB
+  if (targetSum <= 0 || rR + rG + rB <= 0) {
+    return { params: { exposure: 0, temperature: 0, tint: 0 }, flags: flags.includes('clipped') ? flags : [...flags, 'clipped'] }
+  }
+  const gain = (rR + rG + rB) / targetSum
+  const tint = 10 * (gain * tG - rG)
+  const temperature = 5 * (rR - rB - gain * (tR - tB))
+  const params = {
+    exposure: Math.log2(gain),
+    temperature,
+    tint,
+  }
+  if (Math.abs(params.exposure) > MAX_EV || Math.abs(temperature) > MAX_SHIFT || Math.abs(tint) > MAX_SHIFT) {
+    flags.push('extreme')
+  }
+  return { params, flags }
+}
+
+/** Evaluate the match on one working value, as the two effects do in SDR (for tests and previews). */
+export function applyColourMatch([r, g, b]: readonly [number, number, number], params: ColourMatchParams): [number, number, number] {
+  const gain = 2 ** params.exposure
+  const clamp = (v: number) => Math.min(1, Math.max(0, v))
+  return [
+    clamp(clamp(r * gain) + params.temperature * 0.1 + params.tint * 0.05),
+    clamp(clamp(g * gain) - params.tint * 0.1),
+    clamp(clamp(b * gain) - params.temperature * 0.1 + params.tint * 0.05),
+  ]
+}
+
+export interface ColourMatchProvenance {
+  referenceItemId: string
+  referenceSeconds: number
+  targetSeconds: number
+}
+
+const round = (value: number, digits = 4) => Math.round(value * 10 ** digits) / 10 ** digits
+
+/**
+ * The effects that carry a match at `strength` (0..1), with ids marking them
+ * as this clip's match so a new match replaces them instead of stacking.
+ */
+export function colourMatchEffects(
+  params: ColourMatchParams,
+  strength: number,
+  provenance: ColourMatchProvenance,
+  ids: { exposure: string; temperature: string },
+): ItemEffect[] {
+  const s = Math.min(1, Math.max(0, strength))
+  if (s === 0) return []
+  const tag = {
+    matchStrength: round(s, 3),
+    matchSource: JSON.stringify({ algorithm: COLOUR_MATCH_ALGORITHM, ...provenance }),
+  }
+  return [
+    {
+      id: ids.exposure,
+      enabled: true,
+      effect: { type: 'gpu-effect', gpuEffectType: 'gpu-exposure', params: { exposure: round(params.exposure * s), offset: 0, gamma: 1, ...tag } },
+    },
+    {
+      id: ids.temperature,
+      enabled: true,
+      effect: { type: 'gpu-effect', gpuEffectType: 'gpu-temperature', params: { temperature: round(params.temperature * s), tint: round(params.tint * s), ...tag } },
+    },
+  ]
+}
+
+export function isColourMatchEffect(effect: ItemEffect): boolean {
+  return effect.id.startsWith(COLOUR_MATCH_ID_PREFIX)
+}
