+++ b/src/features/timeline/stores/actions/edit/colour-match-actions.ts
@@ -0,0 +1,279 @@
+import type { ItemEffect } from '@/types/effects'
+import type { TimelineItem, VideoItem } from '@/types/timeline'
+import { useItemsStore } from '../../items-store'
+import { useTimelineSettingsStore } from '../../timeline-settings-store'
+import { execute } from '../shared'
+import { hasLockedEditParticipants } from '../linked-edit'
+import { useMediaLibraryStore } from '@/features/timeline/deps/media-library-store'
+import { importMediaLibraryService } from '@/features/timeline/deps/media-library-service'
+import { useProjectStore } from '@/features/timeline/deps/projects'
+import { getGpuEffect } from '@/infrastructure/gpu-effects/registry'
+import { workingRangeOfSources } from '@/shared/graphics/color/managed-color'
+import { timelineToSourceFrames } from '../../../utils/source-calculations'
+import {
+  COLOUR_MATCH_ID_PREFIX,
+  colourMatchEffects,
+  isColourMatchEffect,
+  proposeColourMatch,
+  sampleStats,
+  type ColourMatchParams,
+  type ColourMatchProposal,
+  type ColourMatchProvenance,
+  type ColourSampleStats,
+} from '../../../utils/colour-match'
+
+export type ColourMatchRefusal =
+  | 'not-found'
+  | 'unsupported-clip'
+  | 'same-clip'
+  | 'hdr'
+  | 'graded'
+  | 'reversed'
+  | 'locked'
+  | 'decode-failed'
+
+export interface ColourMatchTargetResult {
+  itemId: string
+  label: string
+  binding: string
+  provenance: ColourMatchProvenance
+  proposal: ColourMatchProposal
+}
+
+export type ColourMatchAnalysis =
+  | { ok: true; targets: ColourMatchTargetResult[] }
+  | { ok: false; reason: ColourMatchRefusal; itemId?: string }
+
+/** Analysis frames are downscaled to this width; means need no more. */
+const SAMPLE_WIDTH = 160
+
+function isGradingEffect(effect: ItemEffect): boolean {
+  return effect.enabled && !isColourMatchEffect(effect)
+    && getGpuEffect(effect.effect.gpuEffectType)?.category === 'color'
+}
+
+function projectIsHdr(items: readonly TimelineItem[]): boolean {
+  const project = useProjectStore.getState().currentProject
+  if (project?.metadata.colorManagement?.workingRange === 'hdr') return true
+  const mediaById = useMediaLibraryStore.getState().mediaById
+  return workingRangeOfSources(items.map((item) => (item.mediaId ? mediaById[item.mediaId]?.colorTransfer : undefined))) === 'hdr'
+}
+
+/** The source time shown at a timeline frame, clamped inside the clip. */
+function sourceSecondsAt(item: VideoItem, frame: number, fps: number): number {
+  const offset = Math.min(item.durationInFrames - 1, Math.max(0, frame - item.from))
+  const sourceFps = item.sourceFps ?? fps
+  return ((item.sourceStart ?? 0) + timelineToSourceFrames(offset, item.speed ?? 1, fps, sourceFps)) / sourceFps
+}
+
+/**
+ * Binds a result to the target's source, timing, playback direction and grade
+ * (its match effects excluded), the reference's source, timing, direction and
+ * full grade, and the project's colour management.
+ */
+export function colourMatchBinding(item: TimelineItem, seconds: number, reference?: TimelineItem, referenceSeconds?: number): string {
+  const describe = (clip: TimelineItem, effects: readonly ItemEffect[]) => {
+    const video = clip as VideoItem
+    return [clip.id, clip.mediaId, video.sourceStart ?? 0, video.sourceEnd ?? null, video.speed ?? 1, video.isReversed === true, effects]
+  }
+  return JSON.stringify([
+    describe(item, (item.effects ?? []).filter((effect) => !isColourMatchEffect(effect))), seconds,
+    reference ? [describe(reference, reference.effects ?? []), referenceSeconds] : null,
+    useProjectStore.getState().currentProject?.metadata.colorManagement ?? null,
+  ])
+}
+
+async function sampleFrame(item: VideoItem, seconds: number): Promise<ColourSampleStats> {
+  const { mediaLibraryService } = await importMediaLibraryService()
+  const blob = item.mediaId ? await mediaLibraryService.getMediaFile(item.mediaId) : null
+  if (!blob) throw new Error('media unavailable')
+  const { Input, BlobSource, CanvasSink, ALL_FORMATS } = await import('mediabunny')
+  const input = new Input({ source: new BlobSource(blob as File), formats: ALL_FORMATS })
+  try {
+    const track = await input.getPrimaryVideoTrack()
+    if (!track) throw new Error('no video track')
+    const height = Math.max(1, Math.round((SAMPLE_WIDTH * track.displayHeight) / track.displayWidth))
+    const sink = new CanvasSink(track, { width: SAMPLE_WIDTH, height, fit: 'fill' })
+    const wrapped = await sink.getCanvas(seconds)
+    if (!wrapped) throw new Error('no frame')
+    const canvas = wrapped.canvas as OffscreenCanvas | HTMLCanvasElement
+    const context = canvas.getContext('2d') as CanvasRenderingContext2D | OffscreenCanvasRenderingContext2D | null
+    if (!context) throw new Error('no 2d context')
+    return sampleStats(context.getImageData(0, 0, canvas.width, canvas.height).data)
+  } finally {
+    input.dispose()
+  }
+}
+
+function refusalFor(items: readonly TimelineItem[], ids: readonly string[]): { reason: ColourMatchRefusal; itemId?: string } | null {
+  for (const id of ids) {
+    const item = items.find((candidate) => candidate.id === id)
+    if (!item) return { reason: 'not-found', itemId: id }
+    if (item.type !== 'video') return { reason: 'unsupported-clip', itemId: id }
+    if (item.isReversed === true) return { reason: 'reversed', itemId: id }
+    if ((item.effects ?? []).some(isGradingEffect)) return { reason: 'graded', itemId: id }
+  }
+  if (projectIsHdr(items)) return { reason: 'hdr' }
+  return null
+}
+
+/**
+ * Propose a match for each target from the reference. Frames default to the
+ * playhead when it is inside a clip, else the clip's middle. Nothing in the
+ * project changes; cancelling discards the result.
+ */
+export async function analyzeColourMatch(
+  referenceId: string,
+  targetIds: readonly string[],
+  playheadFrame: number,
+  signal?: AbortSignal,
+): Promise<ColourMatchAnalysis> {
+  const items = useItemsStore.getState().items
+  if (targetIds.includes(referenceId)) return { ok: false, reason: 'same-clip', itemId: referenceId }
+  const refusal = refusalFor(items, [referenceId, ...targetIds])
+  if (refusal) return { ok: false, ...refusal }
+
+  const fps = useTimelineSettingsStore.getState().fps
+  const frameFor = (item: TimelineItem) =>
+    playheadFrame >= item.from && playheadFrame < item.from + item.durationInFrames
+      ? playheadFrame
+      : item.from + Math.floor(item.durationInFrames / 2)
+  const reference = items.find((item) => item.id === referenceId) as VideoItem
+  const referenceSeconds = sourceSecondsAt(reference, frameFor(reference), fps)
+
+  try {
+    const referenceStats = await sampleFrame(reference, referenceSeconds)
+    const targets: ColourMatchTargetResult[] = []
+    for (const id of targetIds) {
+      if (signal?.aborted) throw new DOMException('Colour match cancelled', 'AbortError')
+      const target = items.find((item) => item.id === id) as VideoItem
+      const targetSeconds = sourceSecondsAt(target, frameFor(target), fps)
+      targets.push({
+        itemId: id,
+        label: target.label,
+        binding: colourMatchBinding(target, targetSeconds, reference, referenceSeconds),
+        provenance: { referenceItemId: referenceId, referenceSeconds, targetSeconds },
+        proposal: proposeColourMatch(referenceStats, await sampleFrame(target, targetSeconds)),
+      })
+    }
+    if (signal?.aborted) throw new DOMException('Colour match cancelled', 'AbortError')
+    return { ok: true, targets }
+  } catch (error) {
+    if (error instanceof DOMException && error.name === 'AbortError') throw error
+    return { ok: false, reason: 'decode-failed' }
+  }
+}
+
+function withMatch(effects: readonly ItemEffect[], match: ItemEffect[]): ItemEffect[] {
+  const first = effects.findIndex(isColourMatchEffect)
+  const rest = effects.filter((effect) => !isColourMatchEffect(effect))
+  // Replace in place so the match keeps its position after the grade; otherwise append.
+  const at = first === -1 ? rest.length : effects.slice(0, first).filter((effect) => !isColourMatchEffect(effect)).length
+  return [...rest.slice(0, at), ...match, ...rest.slice(at)]
+}
+
+function matchIds(effects: readonly ItemEffect[]): { exposure: string; temperature: string } {
+  const existing = effects.filter(isColourMatchEffect)
+  const find = (type: string) => existing.find((effect) => effect.effect.gpuEffectType === type)?.id
+  return {
+    exposure: find('gpu-exposure') ?? `${COLOUR_MATCH_ID_PREFIX}exposure:${crypto.randomUUID()}`,
+    temperature: find('gpu-temperature') ?? `${COLOUR_MATCH_ID_PREFIX}temperature:${crypto.randomUUID()}`,
+  }
+}
+
+export interface ColourMatchApproval {
+  result: ColourMatchTargetResult
+  /** 0..1; zero removes the match. */
+  strength: number
+}
+
+export interface ColourMatchApplyOutcome {
+  applied: string[]
+  stale: string[]
+  refused: Array<{ itemId: string; reason: ColourMatchRefusal | 'flagged' }>
+}
+
+/**
+ * Apply approved matches in one undo step. A result whose clip changed since
+ * analysis is stale and skipped; a flagged proposal is never applied.
+ * Applying again replaces the clip's match rather than stacking another.
+ */
+export function applyColourMatches(approvals: readonly ColourMatchApproval[]): ColourMatchApplyOutcome {
+  const outcome: ColourMatchApplyOutcome = { applied: [], stale: [], refused: [] }
+  const items = useItemsStore.getState().items
+  const updates: Array<{ itemId: string; effects: ItemEffect[] }> = []
+  // The project may have become HDR since analysis; SDR proposals do not apply there.
+  if (projectIsHdr(items)) {
+    outcome.refused = approvals.map(({ result }) => ({ itemId: result.itemId, reason: 'hdr' as const }))
+    return outcome
+  }
+  for (const { result, strength } of approvals) {
+    const item = items.find((candidate) => candidate.id === result.itemId)
+    const reference = items.find((candidate) => candidate.id === result.provenance.referenceItemId)
+    if (!item || !reference
+      || colourMatchBinding(item, result.provenance.targetSeconds, reference, result.provenance.referenceSeconds) !== result.binding) {
+      outcome.stale.push(result.itemId)
+      continue
+    }
+    if (result.proposal.flags.length > 0) {
+      outcome.refused.push({ itemId: item.id, reason: 'flagged' })
+      continue
+    }
+    if (hasLockedEditParticipants([item])) {
+      outcome.refused.push({ itemId: item.id, reason: 'locked' })
+      continue
+    }
+    const effects = item.effects ?? []
+    updates.push({
+      itemId: item.id,
+      effects: withMatch(effects, colourMatchEffects(result.proposal.params, strength, result.provenance, matchIds(effects))),
+    })
+  }
+  if (updates.length > 0) {
+    execute('APPLY_COLOUR_MATCH', () => {
+      useItemsStore.getState()._setItemEffects(updates)
+      useTimelineSettingsStore.getState().markDirty()
+    }, { itemIds: updates.map((update) => update.itemId) })
+    outcome.applied = updates.map((update) => update.itemId)
+  }
+  return outcome
+}
+
+/** The clip's current match at full strength, read back from its effects. */
+export function readColourMatch(item: TimelineItem): { params: ColourMatchParams; strength: number; provenance: ColourMatchProvenance } | null {
+  const effects = (item.effects ?? []).filter(isColourMatchEffect)
+  const exposure = effects.find((effect) => effect.effect.gpuEffectType === 'gpu-exposure')?.effect.params
+  const temperature = effects.find((effect) => effect.effect.gpuEffectType === 'gpu-temperature')?.effect.params
+  if (!exposure || !temperature) return null
+  const strength = Number(exposure.matchStrength)
+  if (!(strength > 0)) return null
+  let provenance: ColourMatchProvenance
+  try {
+    provenance = JSON.parse(String(exposure.matchSource)) as ColourMatchProvenance
+  } catch {
+    return null
+  }
+  return {
+    strength,
+    provenance,
+    params: {
+      exposure: Number(exposure.exposure) / strength,
+      temperature: Number(temperature.temperature) / strength,
+      tint: Number(temperature.tint) / strength,
+    },
+  }
+}
+
+/** Change an applied match's strength (0 removes it) in one undo step. */
+export function setColourMatchStrength(itemId: string, strength: number): boolean {
+  const item = useItemsStore.getState().itemById[itemId]
+  const current = item ? readColourMatch(item) : null
+  if (!item || !current || hasLockedEditParticipants([item])) return false
+  const effects = item.effects ?? []
+  const next = withMatch(effects, colourMatchEffects(current.params, strength, current.provenance, matchIds(effects)))
+  execute('SET_COLOUR_MATCH_STRENGTH', () => {
+    useItemsStore.getState()._setItemEffects([{ itemId, effects: next }])
+    useTimelineSettingsStore.getState().markDirty()
+  }, { itemId, strength })
+  return true
+}
