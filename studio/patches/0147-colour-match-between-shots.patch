+import { useEffect, useRef, useState } from 'react'
+import { useShallow } from 'zustand/react/shallow'
+import { useTranslation } from 'react-i18next'
+import { Palette } from 'lucide-react'
+import { toast } from 'sonner'
+import { Button } from '@/components/ui/button'
+import { Input } from '@/components/ui/input'
+import type { VideoItem } from '@/types/timeline'
+import {
+  analyzeColourMatch,
+  applyColourMatches,
+  readColourMatch,
+  setColourMatchStrength,
+  useTimelineStore,
+  type ColourMatchTargetResult,
+} from '@/features/editor/deps/timeline-store'
+import { usePlaybackStore } from '@/shared/state/playback'
+import { PropertyRow, PropertySection } from '../components'
+
+const signed = (value: number, digits: number) => `${value >= 0 ? '+' : ''}${value.toFixed(digits)}`
+
+/**
+ * Match colour to a reference shot (FL-599). Proposals become an editable
+ * exposure + temperature/tint pair after the clip's grade, with a strength
+ * control; applying again replaces the clip's match.
+ */
+export function ColourMatchSection({ items }: { items: VideoItem[] }) {
+  const { t } = useTranslation()
+  const targetIds = items.map((item) => item.id)
+  // Subscribe to video clip names only, so dragging clips does not re-render this panel.
+  const references = useTimelineStore(useShallow((s) => s.items
+    .filter((item) => item.type === 'video' && !targetIds.includes(item.id))
+    .map((item) => `${item.id}\u0000${item.label}`)))
+  const [referenceId, setReferenceId] = useState('')
+  const [strength, setStrength] = useState(100)
+  const [results, setResults] = useState<ColourMatchTargetResult[] | null>(null)
+  const [busy, setBusy] = useState(false)
+  const abortRef = useRef<AbortController | null>(null)
+  useEffect(() => () => abortRef.current?.abort(), [])
+
+  const applied = items.length === 1 ? readColourMatch(items[0]!) : null
+
+  const analyze = async () => {
+    abortRef.current?.abort()
+    const controller = new AbortController()
+    abortRef.current = controller
+    setBusy(true)
+    setResults(null)
+    try {
+      const frame = usePlaybackStore.getState().currentFrame
+      const analysis = await analyzeColourMatch(referenceId, targetIds, frame, controller.signal)
+      if (analysis.ok) setResults(analysis.targets)
+      else toast.warning(t(`editor.colourMatch.refusal.${analysis.reason}`))
+    } catch (error) {
+      if (!(error instanceof DOMException && error.name === 'AbortError')) toast.error(t('editor.colourMatch.refusal.decode-failed'))
+    } finally {
+      if (abortRef.current === controller) setBusy(false)
+    }
+  }
+
+  const apply = () => {
+    if (!results) return
+    const outcome = applyColourMatches(results.map((result) => ({ result, strength: strength / 100 })))
+    if (outcome.applied.length > 0) toast.success(t('editor.colourMatch.applied', { count: outcome.applied.length }))
+    if (outcome.stale.length > 0) toast.warning(t('editor.colourMatch.stale', { count: outcome.stale.length }))
+    if (outcome.refused.length > 0) toast.warning(t('editor.colourMatch.notApplied', { count: outcome.refused.length }))
+    setResults(null)
+  }
+
+  return (
+    <PropertySection title={t('editor.colourMatch.title')} icon={Palette} defaultOpen={false}>
+      <PropertyRow label={t('editor.colourMatch.reference')}>
+        <select
+          className="h-7 w-full rounded-md border border-input bg-transparent px-2 text-xs"
+          aria-label={t('editor.colourMatch.reference')}
+          value={referenceId}
+          onChange={(event) => { setReferenceId(event.target.value); setResults(null) }}
+        >
+          <option value="">{t('editor.colourMatch.chooseReference')}</option>
+          {references.map((entry) => {
+            const [id, label] = entry.split('\u0000')
+            return <option key={id} value={id}>{label}</option>
+          })}
+        </select>
+      </PropertyRow>
+      <PropertyRow label={t('editor.colourMatch.strength')}>
+        <div className="flex items-center gap-1 w-full">
+          <Input type="number" className="h-7 min-w-0 flex-1 px-2 text-xs" min={0} max={100} step={5}
+            aria-label={t('editor.colourMatch.strength')} value={strength}
+            onChange={(event) => setStrength(Math.min(100, Math.max(0, Number(event.target.value))))} />
+          <span className="text-xs text-muted-foreground">%</span>
+        </div>
+      </PropertyRow>
+
+      <div className="space-y-1 px-1 py-2 text-xs" aria-live="polite">
+        {busy && <p>{t('editor.colourMatch.analyzing')}</p>}
+        {results?.map((result) => (
+          <div key={result.itemId} className="rounded border border-border px-2 py-1">
+            <p className="truncate font-medium">{result.label}</p>
+            <p>
+              {t('editor.colourMatch.proposal', {
+                exposure: signed(result.proposal.params.exposure, 2),
+                temperature: signed(result.proposal.params.temperature, 2),
+                tint: signed(result.proposal.params.tint, 2),
+              })}
+            </p>
+            {result.proposal.flags.map((flag) => (
+              <p key={flag} className="text-amber-500">{t(`editor.colourMatch.flag.${flag}`)}</p>
+            ))}
+          </div>
+        ))}
+        {applied && (
+          <p>{t('editor.colourMatch.current', { strength: Math.round(applied.strength * 100) })}</p>
+        )}
+        <p className="text-muted-foreground">{t('editor.colourMatch.note')}</p>
+      </div>
+
+      <div className="flex flex-wrap items-center gap-2 px-1 pb-2">
+        {busy ? (
+          <Button variant="ghost" size="sm" className="h-7 flex-1 text-xs" onClick={() => abortRef.current?.abort()}>
+            {t('editor.colourMatch.cancel')}
+          </Button>
+        ) : (
+          <Button variant="ghost" size="sm" className="h-7 flex-1 text-xs" disabled={!referenceId} onClick={() => void analyze()}>
+            {t('editor.colourMatch.analyze')}
+          </Button>
+        )}
+        <Button size="sm" className="h-7 flex-1 text-xs" disabled={busy || !results?.some((r) => r.proposal.flags.length === 0)} onClick={apply}>
+          {t('editor.colourMatch.apply')}
+        </Button>
+        {applied && (
+          <>
+            <Button variant="ghost" size="sm" className="h-7 flex-1 text-xs"
+              onClick={() => setColourMatchStrength(items[0]!.id, strength / 100)}>
+              {t('editor.colourMatch.setStrength')}
+            </Button>
+            <Button variant="ghost" size="sm" className="h-7 flex-1 text-xs"
+              onClick={() => setColourMatchStrength(items[0]!.id, 0)}>
+              {t('editor.colourMatch.remove')}
+            </Button>
+          </>
+        )}
+      </div>
+    </PropertySection>
+  )
+}
