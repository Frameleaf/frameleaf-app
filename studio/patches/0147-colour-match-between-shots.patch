new file mode 100644
--- /dev/null
+++ b/src/features/timeline/utils/colour-match.test.ts
@@ -0,0 +1,111 @@
+import { describe, expect, it } from 'vite-plus/test'
+import {
+  applyColourMatch,
+  colourMatchEffects,
+  proposeColourMatch,
+  sampleStats,
+  type ColourMatchParams,
+} from './colour-match'
+
+// Measurement conversion: sRGB-encoded working values -> linear -> XYZ (D65) -> CIELAB, then CIEDE2000.
+function toLab([r, g, b]: readonly number[]): [number, number, number] {
+  const lin = (v: number) => (v <= 0.04045 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4)
+  const [R, G, B] = [lin(r!), lin(g!), lin(b!)]
+  const x = (0.4124 * R + 0.3576 * G + 0.1805 * B) / 0.95047
+  const y = 0.2126 * R + 0.7152 * G + 0.0722 * B
+  const z = (0.0193 * R + 0.1192 * G + 0.9505 * B) / 1.08883
+  const f = (t: number) => (t > 216 / 24389 ? Math.cbrt(t) : (24389 / 27 * t + 16) / 116)
+  return [116 * f(y) - 16, 500 * (f(x) - f(y)), 200 * (f(y) - f(z))]
+}
+
+function ciede2000(a: readonly number[], b: readonly number[]): number {
+  const [L1, a1, b1] = toLab(a)
+  const [L2, a2, b2] = toLab(b)
+  const rad = Math.PI / 180
+  const C1 = Math.hypot(a1, b1), C2 = Math.hypot(a2, b2)
+  const Cm = (C1 + C2) / 2
+  const G = 0.5 * (1 - Math.sqrt(Cm ** 7 / (Cm ** 7 + 25 ** 7)))
+  const ap1 = a1 * (1 + G), ap2 = a2 * (1 + G)
+  const Cp1 = Math.hypot(ap1, b1), Cp2 = Math.hypot(ap2, b2)
+  const hp = (bb: number, ap: number) => { const h = Math.atan2(bb, ap) / rad; return h < 0 ? h + 360 : h }
+  const hp1 = hp(b1, ap1), hp2 = hp(b2, ap2)
+  const dL = L2 - L1, dC = Cp2 - Cp1
+  let dh = hp2 - hp1
+  if (Cp1 * Cp2 === 0) dh = 0
+  else if (dh > 180) dh -= 360
+  else if (dh < -180) dh += 360
+  const dH = 2 * Math.sqrt(Cp1 * Cp2) * Math.sin((dh / 2) * rad)
+  const Lm = (L1 + L2) / 2, Cpm = (Cp1 + Cp2) / 2
+  let hm = hp1 + hp2
+  if (Cp1 * Cp2 !== 0) hm = Math.abs(hp1 - hp2) > 180 ? (hp1 + hp2 + (hp1 + hp2 < 360 ? 360 : -360)) / 2 : (hp1 + hp2) / 2
+  const T = 1 - 0.17 * Math.cos((hm - 30) * rad) + 0.24 * Math.cos(2 * hm * rad) + 0.32 * Math.cos((3 * hm + 6) * rad) - 0.2 * Math.cos((4 * hm - 63) * rad)
+  const SL = 1 + (0.015 * (Lm - 50) ** 2) / Math.sqrt(20 + (Lm - 50) ** 2)
+  const SC = 1 + 0.045 * Cpm, SH = 1 + 0.015 * Cpm * T
+  const RT = -2 * Math.sqrt(Cpm ** 7 / (Cpm ** 7 + 25 ** 7)) * Math.sin(60 * Math.exp(-(((hm - 275) / 25) ** 2)) * rad)
+  return Math.sqrt((dL / SL) ** 2 + (dC / SC) ** 2 + (dH / SH) ** 2 + RT * (dC / SC) * (dH / SH))
+}
+
+// A 24-patch chart of mid-range colours (sRGB-encoded working values).
+const CHART: Array<[number, number, number]> = Array.from({ length: 24 }, (_, i) => [
+  0.2 + 0.6 * ((i * 7) % 24) / 23,
+  0.2 + 0.6 * ((i * 11) % 24) / 23,
+  0.2 + 0.6 * ((i * 5) % 24) / 23,
+])
+
+function toRgba(patches: ReadonlyArray<readonly number[]>): Uint8ClampedArray {
+  const data = new Uint8ClampedArray(patches.length * 4 * 16)
+  patches.forEach((patch, p) => {
+    for (let k = 0; k < 16; k += 1) {
+      const i = (p * 16 + k) * 4
+      data[i] = Math.round(patch[0]! * 255); data[i + 1] = Math.round(patch[1]! * 255); data[i + 2] = Math.round(patch[2]! * 255); data[i + 3] = 255
+    }
+  })
+  return data
+}
+
+const meanDe = (a: ReadonlyArray<readonly number[]>, b: ReadonlyArray<readonly number[]>) =>
+  a.reduce((sum, patch, i) => sum + ciede2000(patch, b[i]!), 0) / a.length
+
+describe('colour match', () => {
+  it.each([
+    ['under-exposed and cool', { exposure: -0.5, temperature: -0.3, tint: 0 }],
+    ['over-exposed and warm', { exposure: 0.35, temperature: 0.25, tint: 0.1 }],
+    ['green cast', { exposure: 0, temperature: 0, tint: -0.35 }],
+  ])('cuts mean CIEDE2000 chart error by at least half for a %s shot', (_name, offset: ColourMatchParams) => {
+    const target = CHART.map((patch) => applyColourMatch(patch, offset))
+    const proposal = proposeColourMatch(sampleStats(toRgba(CHART)), sampleStats(toRgba(target)))
+    expect(proposal.flags).toEqual([])
+    const matched = target.map((patch) => applyColourMatch(patch, proposal.params))
+    const before = meanDe(CHART, target)
+    const after = meanDe(CHART, matched)
+    expect(after).toBeLessThanOrEqual(before * 0.5)
+  })
+
+  it('proposes no change for an identical shot', () => {
+    const stats = sampleStats(toRgba(CHART))
+    const { params } = proposeColourMatch(stats, stats)
+    expect(Math.abs(params.exposure)).toBeLessThan(1e-9)
+    expect(Math.abs(params.temperature)).toBeLessThan(1e-9)
+    expect(Math.abs(params.tint)).toBeLessThan(1e-9)
+  })
+
+  it('flags clipped, flat and unrelated samples instead of proposing extreme corrections', () => {
+    const chart = sampleStats(toRgba(CHART))
+    expect(proposeColourMatch(chart, sampleStats(toRgba(CHART.map(() => [1, 1, 1]))) ).flags).toContain('clipped')
+    expect(proposeColourMatch(chart, sampleStats(toRgba(CHART.map(() => [0.5, 0.5, 0.5])))).flags).toContain('flat')
+    const dark = CHART.map((patch) => applyColourMatch(patch, { exposure: -1.9, temperature: 0, tint: 0 }))
+    expect(proposeColourMatch(chart, sampleStats(toRgba(dark))).flags).toContain('extreme')
+  })
+
+  it('scales from identity: zero strength removes the effects, full strength uses the proposal', () => {
+    const params = { exposure: 0.5, temperature: -0.2, tint: 0.1 }
+    const provenance = { referenceItemId: 'ref', referenceSeconds: 1, targetSeconds: 2 }
+    const ids = { exposure: 'colour-match:exposure:a', temperature: 'colour-match:temperature:b' }
+    expect(colourMatchEffects(params, 0, provenance, ids)).toEqual([])
+    const [exposure, temperature] = colourMatchEffects(params, 1, provenance, ids)
+    expect(exposure!.effect.params).toMatchObject({ exposure: 0.5, offset: 0, gamma: 1, matchStrength: 1 })
+    expect(temperature!.effect.params).toMatchObject({ temperature: -0.2, tint: 0.1 })
+    const [half] = colourMatchEffects(params, 0.5, provenance, ids)
+    expect(half!.effect.params.exposure).toBe(0.25)
+  })
+})
