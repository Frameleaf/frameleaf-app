+// @vitest-environment node
+
+import { beforeEach, describe, expect, it } from 'vite-plus/test'
+import type { ItemEffect } from '@/types/effects'
+import type { TimelineTrack, VideoItem } from '@/types/timeline'
+import { useItemsStore } from '../../items-store'
+import { useTimelineCommandStore } from '../../timeline-command-store'
+import { useTimelineSettingsStore } from '../../timeline-settings-store'
+import { useProjectStore } from '@/features/timeline/deps/projects'
+import {
+  analyzeColourMatch,
+  applyColourMatches,
+  colourMatchBinding,
+  readColourMatch,
+  setColourMatchStrength,
+  type ColourMatchTargetResult,
+} from './colour-match-actions'
+
+const track = (id: string, locked = false) => ({
+  id, name: id, order: 0, height: 80, locked, syncLock: true, visible: true, muted: false,
+  solo: false, volume: 0, items: [], kind: 'video',
+}) as TimelineTrack
+
+const video = (overrides: Partial<VideoItem> = {}): VideoItem => ({
+  id: 'v1', type: 'video', trackId: 't1', from: 0, durationInFrames: 60, label: 'Shot', src: 'blob:v',
+  mediaId: 'm1', sourceStart: 0, sourceEnd: 60, sourceFps: 30, ...overrides,
+} as VideoItem)
+
+const blur: ItemEffect = { id: 'blur', enabled: true, effect: { type: 'gpu-effect', gpuEffectType: 'gpu-gaussian-blur', params: { radius: 2 } } }
+const grade: ItemEffect = { id: 'grade', enabled: true, effect: { type: 'gpu-effect', gpuEffectType: 'gpu-exposure', params: { exposure: 0.2 } } }
+
+const referenceClip = (overrides: Partial<VideoItem> = {}) => video({ id: 'ref', trackId: 't1', from: 500, ...overrides })
+
+function result(item: VideoItem, flags: ColourMatchTargetResult['proposal']['flags'] = []): ColourMatchTargetResult {
+  return {
+    itemId: item.id, label: item.label, binding: colourMatchBinding(item, 1, referenceClip(), 0.5),
+    provenance: { referenceItemId: 'ref', referenceSeconds: 0.5, targetSeconds: 1 },
+    proposal: { params: { exposure: 0.4, temperature: 0.2, tint: -0.1 }, flags },
+  }
+}
+
+const effectTypes = (id: string) => (useItemsStore.getState().itemById[id]!.effects ?? []).map((e) => e.effect.gpuEffectType)
+
+describe('colour match actions', () => {
+  beforeEach(() => {
+    useTimelineCommandStore.getState().clearHistory()
+    useTimelineSettingsStore.setState({ fps: 30, isDirty: false })
+    useItemsStore.getState().setTracks([track('t1'), track('t2', true)])
+  })
+
+  it('adds the match after existing effects and replaces it instead of stacking', () => {
+    const item = video({ effects: [blur] })
+    useItemsStore.getState().setItems([item, referenceClip()])
+    expect(applyColourMatches([{ result: result(item), strength: 1 }]).applied).toEqual(['v1'])
+    expect(effectTypes('v1')).toEqual(['gpu-gaussian-blur', 'gpu-exposure', 'gpu-temperature'])
+
+    // A new analysis of the same clip (its binding ignores the match) replaces the match in place.
+    const current = useItemsStore.getState().itemById['v1'] as VideoItem
+    expect(applyColourMatches([{ result: result(current), strength: 0.5 }]).applied).toEqual(['v1'])
+    expect(effectTypes('v1')).toEqual(['gpu-gaussian-blur', 'gpu-exposure', 'gpu-temperature'])
+    expect(readColourMatch(useItemsStore.getState().itemById['v1']!)).toMatchObject({
+      strength: 0.5, params: { exposure: 0.4, temperature: 0.2, tint: -0.1 },
+    })
+  })
+
+  it('changes strength and removes the match exactly at zero, each in one undo step', () => {
+    const item = video({ effects: [blur] })
+    useItemsStore.getState().setItems([item, referenceClip()])
+    applyColourMatches([{ result: result(item), strength: 1 }])
+    expect(setColourMatchStrength('v1', 0.25)).toBe(true)
+    expect(readColourMatch(useItemsStore.getState().itemById['v1']!)?.strength).toBe(0.25)
+    expect(setColourMatchStrength('v1', 0)).toBe(true)
+    expect(useItemsStore.getState().itemById['v1']!.effects).toEqual([blur])
+    useTimelineCommandStore.getState().undo()
+    useTimelineCommandStore.getState().undo()
+    useTimelineCommandStore.getState().undo()
+    expect(useItemsStore.getState().itemById['v1']!.effects).toEqual([blur])
+  })
+
+  it('skips stale, flagged and locked results without changing them', () => {
+    const trimmed = video()
+    const flagged = video({ id: 'v2', from: 60 })
+    const locked = video({ id: 'v3', trackId: 't2' })
+    useItemsStore.getState().setItems([{ ...trimmed, sourceEnd: 40 } as VideoItem, flagged, locked, referenceClip()])
+    const outcome = applyColourMatches([
+      { result: result(trimmed), strength: 1 },
+      { result: result(flagged, ['clipped']), strength: 1 },
+      { result: result(locked), strength: 1 },
+    ])
+    expect(outcome).toEqual({ applied: [], stale: ['v1'], refused: [{ itemId: 'v2', reason: 'flagged' }, { itemId: 'v3', reason: 'locked' }] })
+    expect(useTimelineCommandStore.getState().canUndo).toBe(false)
+  })
+
+  it('refuses graded clips and a reference that is also a target before sampling', async () => {
+    useItemsStore.getState().setItems([video({ id: 'ref' }), video({ effects: [grade] })])
+    await expect(analyzeColourMatch('ref', ['v1'], 0)).resolves.toEqual({ ok: false, reason: 'graded', itemId: 'v1' })
+    await expect(analyzeColourMatch('ref', ['ref'], 0)).resolves.toMatchObject({ ok: false, reason: 'same-clip' })
+  })
+
+  it('treats a result as stale when the reference or either clip direction changes', () => {
+    const item = video()
+    useItemsStore.getState().setItems([item, referenceClip({ effects: [grade] })])
+    expect(applyColourMatches([{ result: result(item), strength: 1 }]).stale).toEqual(['v1'])
+    useItemsStore.getState().setItems([{ ...item, isReversed: true } as VideoItem, referenceClip()])
+    expect(applyColourMatches([{ result: result(item), strength: 1 }]).stale).toEqual(['v1'])
+    useItemsStore.getState().setItems([item])
+    expect(applyColourMatches([{ result: result(item), strength: 1 }]).stale).toEqual(['v1'])
+  })
+
+  it('refuses every result when the project has become HDR since analysis', () => {
+    const item = video()
+    useItemsStore.getState().setItems([item, referenceClip()])
+    useProjectStore.setState({ currentProject: { metadata: { colorManagement: { workingRange: 'hdr' } } } } as never)
+    try {
+      expect(applyColourMatches([{ result: result(item), strength: 1 }]).refused).toEqual([{ itemId: 'v1', reason: 'hdr' }])
+      expect(useTimelineCommandStore.getState().canUndo).toBe(false)
+    } finally {
+      useProjectStore.setState({ currentProject: null } as never)
+    }
+  })
+})
