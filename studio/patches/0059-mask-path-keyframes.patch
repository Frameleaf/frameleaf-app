diff --git a/src/runtime/composition-runtime/utils/frame-scene.mask-path-keyframes.test.ts b/src/runtime/composition-runtime/utils/frame-scene.mask-path-keyframes.test.ts
new file mode 100644
index 0000000000..bc2965f9ea
--- /dev/null
+++ b/src/runtime/composition-runtime/utils/frame-scene.mask-path-keyframes.test.ts
@@ -0,0 +1,34 @@
+import { expect, it } from 'vite-plus/test'
+import type { ShapeItem } from '@/types/timeline'
+import type { ItemKeyframes } from '@/types/keyframe'
+import { resolveActiveShapeMasksAtFrame } from './frame-scene'
+
+it('resolves pen mask vertices and handles at item-relative time before live preview overrides', () => {
+  const mask: ShapeItem = {
+    id: 'mask', type: 'shape', trackId: 'mask-track', label: 'Pen mask',
+    from: 10, durationInFrames: 20, shapeType: 'path', isMask: true, fillColor: '#fff',
+    pathVertices: [{ position: [0.25, 0], inHandle: [0, 0], outHandle: [0, 0] }],
+    transform: { x: 0, y: 0, width: 64, height: 64, rotation: 0, opacity: 1 },
+  }
+  const keyframes: ItemKeyframes = { itemId: mask.id, properties: [
+    { property: 'pathVertex:0:positionX', keyframes: [
+      { id: 'p0', frame: 0, value: 0.25, easing: 'linear' },
+      { id: 'p1', frame: 10, value: 0.75, easing: 'linear' },
+    ] },
+    { property: 'pathVertex:0:outY', keyframes: [
+      { id: 'h0', frame: 0, value: 0, easing: 'linear' },
+      { id: 'h1', frame: 10, value: 0.5, easing: 'linear' },
+    ] },
+  ] }
+  const options = { canvas: { width: 64, height: 64, fps: 30 }, frame: 15,
+    getKeyframes: () => keyframes }
+  const resolved = resolveActiveShapeMasksAtFrame([mask], options)[0]!.shape
+  expect(resolved.pathVertices![0]).toMatchObject({ position: [0.5, 0], outHandle: [0, 0.25] })
+  expect(mask.pathVertices![0]).toMatchObject({ position: [0.25, 0], outHandle: [0, 0] })
+  const liveVertices = [{ position: [0.9, 0.2] as [number, number],
+    inHandle: [0, 0] as [number, number], outHandle: [0, 0] as [number, number] }]
+  expect(resolveActiveShapeMasksAtFrame([mask], { ...options,
+    getPreviewPathVertices: () => liveVertices })[0]!.shape.pathVertices).toBe(liveVertices)
+  expect(resolveActiveShapeMasksAtFrame([mask], { ...options, frame: 9 })).toEqual([])
+  expect(resolveActiveShapeMasksAtFrame([mask], { ...options, frame: 30 })).toEqual([])
+})
