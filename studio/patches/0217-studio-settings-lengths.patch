diff --git a/src/features/timeline/stores/actions/transition-actions.default-length.test.ts b/src/features/timeline/stores/actions/transition-actions.default-length.test.ts
new file mode 100644
index 0000000..560bb49
--- /dev/null
+++ b/src/features/timeline/stores/actions/transition-actions.default-length.test.ts
@@ -0,0 +1,59 @@
+// @vitest-environment node
+
+import { afterEach, beforeEach, describe, expect, it } from 'vite-plus/test'
+import { makeTimelineTrack as makeTrack, makeTimelineVideoItem } from '../../test-helpers'
+import { useItemsStore } from '../items-store'
+import { useTransitionsStore } from '../transitions-store'
+import { useKeyframesStore } from '../keyframes-store'
+import { useTimelineCommandStore } from '../timeline-command-store'
+import { useTimelineSettingsStore } from '../timeline-settings-store'
+import { useSettingsStore } from '../../deps/settings'
+import { TRANSITION_CONFIGS } from '@/types/transition'
+import { addTransition } from './transition-actions'
+
+describe('the default transition length setting (FL-1822)', () => {
+  beforeEach(() => {
+    useTimelineCommandStore.getState().clearHistory()
+    useTimelineSettingsStore.setState({ fps: 30, isDirty: false })
+    useItemsStore
+      .getState()
+      .setTracks([makeTrack({ id: 'video-track', name: 'V1', order: 0, kind: 'video' })])
+    useItemsStore.getState().setItems([
+      makeTimelineVideoItem({
+        id: 'left',
+        trackId: 'video-track',
+        from: 0,
+        durationInFrames: 90,
+        sourceDuration: 300,
+      }),
+      makeTimelineVideoItem({
+        id: 'right',
+        trackId: 'video-track',
+        from: 90,
+        durationInFrames: 90,
+        sourceStart: 60,
+        sourceEnd: 150,
+        sourceDuration: 300,
+      }),
+    ])
+    useTransitionsStore.getState().setTransitions([])
+    useKeyframesStore.getState().setKeyframes([])
+  })
+
+  afterEach(() => {
+    useSettingsStore.getState().setSetting('defaultTransitionSeconds', null)
+  })
+
+  it("uses each transition's own length when no length is chosen", () => {
+    expect(addTransition('left', 'right', 'crossfade')).toBe(true)
+    expect(useTransitionsStore.getState().transitions[0]?.durationInFrames).toBe(
+      TRANSITION_CONFIGS.crossfade.defaultDuration,
+    )
+  })
+
+  it('uses the chosen length in seconds at the project frame rate', () => {
+    useSettingsStore.getState().setSetting('defaultTransitionSeconds', 0.5)
+    expect(addTransition('left', 'right', 'crossfade')).toBe(true)
+    expect(useTransitionsStore.getState().transitions[0]?.durationInFrames).toBe(15)
+  })
+})
