+import { useProjectStore } from '../deps/projects'
+import {
+  useCompositionsStore,
+  useCompositionNavigationStore,
+  useTimelineStore,
+} from '../deps/timeline-stores'
+import { addItemsOnNewTracks } from '../deps/timeline-actions-contract'
+import { useTimelineSettingsStore } from '../deps/timeline-stores-contract'
+import { buildCaptionTrack, buildSubtitleTextItems } from '../utils/caption-items'
+import { inferSubtitleFormat, parseSrt, parseVtt } from '@/shared/utils/subtitles'
+
+/** Import inline, editable captions through the timeline's single undoable mutation. */
+export async function showSubtitleImport(projectId: string, signal?: AbortSignal): Promise<number> {
+  const project = useProjectStore.getState().currentProject
+  const settings = useTimelineSettingsStore.getState()
+  if (!project || project.id !== projectId || settings.isTimelineLoading || signal?.aborted) return 0
+  const compositionId = useCompositionNavigationStore.getState().activeCompositionId
+  const scope = new AbortController()
+  const cancel = () => scope.abort()
+  signal?.addEventListener('abort', cancel, { once: true })
+  const unsubscribe = [
+    useProjectStore.subscribe((state) => {
+      if (state.currentProject?.id !== project.id) cancel()
+    }),
+    useCompositionNavigationStore.subscribe((state) => {
+      if (state.activeCompositionId !== compositionId) cancel()
+    }),
+    useTimelineSettingsStore.subscribe((state) => {
+      if (state.isTimelineLoading || state.fps !== settings.fps) cancel()
+    }),
+  ]
+  try {
+    const input = document.createElement('input')
+    input.type = 'file'
+    input.accept = '.srt,.vtt'
+    const file = await new Promise<File | undefined>((resolve, reject) => {
+      const finish = (selected?: File) => {
+        input.onchange = null
+        input.oncancel = null
+        scope.signal.removeEventListener('abort', abort)
+        input.remove()
+        resolve(selected)
+      }
+      const abort = () => finish()
+      input.onchange = () => finish(input.files?.[0])
+      input.oncancel = abort
+      scope.signal.addEventListener('abort', abort, { once: true })
+      try {
+        input.click()
+      } catch (error) {
+        reject(error)
+        finish()
+      }
+    })
+    if (!file || scope.signal.aborted) return 0
+    const format = inferSubtitleFormat(file.name)
+    if (!format || file.size > 4 * 1024 * 1024) {
+      throw new Error('Choose an SRT or VTT subtitle file no larger than 4 MB.')
+    }
+    const bytes = await file.arrayBuffer()
+    if (scope.signal.aborted) return 0
+    const text = new TextDecoder('utf-8', { fatal: true }).decode(bytes)
+    if (/[\u0000-\u0008\u000b\u000c\u000e-\u001f\u007f]/.test(text)) {
+      throw new Error('Subtitle files must contain UTF-8 text without control characters.')
+    }
+    if (format === 'vtt' && !/^\uFEFF?WEBVTT(?:[ \t].*)?(?:\r?\n|$)/.test(text)) {
+      throw new Error('VTT subtitle files must begin with WEBVTT.')
+    }
+    // The reused parser converts fields arithmetically; reject overflow before any cue is imported.
+    const invalidTimestampFields = text.replace(/\r\n?/g, '\n').split(/\n{2,}/)
+      .map((block) => block.split('\n').find((line) => line.includes('-->')))
+      .some((line) => {
+        if (!line) return false
+        const timestamps = line.split('-->').slice(0, 2)
+          .map((part) => part.trim().split(/\s+/)[0] ?? '')
+        // Leave dialogue and malformed syntax to the parser; inspect supported timestamp pairs only.
+        if (timestamps.length !== 2 || !timestamps.every((timestamp) =>
+          /^(?:\d{1,2}:)?\d{1,2}:\d{2}[,.]\d{1,3}$/.test(timestamp))) return false
+        return timestamps.some((timestamp) => {
+          const fields = (timestamp.split(/[,.]/)[0] ?? '').split(':')
+          return fields.slice(-2).some((field) => Number(field) > 59)
+        })
+      })
+    if (invalidTimestampFields) {
+      throw new Error('Subtitle timestamp minutes and seconds must be between 0 and 59.')
+    }
+    const parsed = format === 'srt' ? parseSrt(text) : parseVtt(text)
+    // Overlapping cues are valid; skipped malformed blocks must never produce a partial import.
+    if (parsed.cues.length === 0 || parsed.warnings.some((warning) => warning.startsWith('Skipped'))) {
+      throw new Error('The subtitle file contains empty or malformed cues.')
+    }
+    if (scope.signal.aborted || signal?.aborted) return 0
+    const timeline = useTimelineStore.getState()
+    const composition = compositionId
+      ? useCompositionsStore.getState().compositionById[compositionId]
+      : null
+    if (compositionId && !composition) return 0
+    const track = buildCaptionTrack(timeline.tracks)
+    const items = buildSubtitleTextItems({
+      trackId: track.id,
+      cues: parsed.cues,
+      timelineFps: timeline.fps,
+      canvasWidth: composition?.width ?? project.metadata.width,
+      canvasHeight: composition?.height ?? project.metadata.height,
+      fileName: file.name,
+      format,
+    })
+    addItemsOnNewTracks(items, [...timeline.tracks, track])
+    return items.length
+  } catch (error) {
+    if (scope.signal.aborted || signal?.aborted) return 0
+    throw error
+  } finally {
+    cancel()
+    unsubscribe.forEach((stop) => stop())
+    signal?.removeEventListener('abort', cancel)
+  }
+}
