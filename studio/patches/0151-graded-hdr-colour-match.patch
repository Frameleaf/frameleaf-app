+/**
+ * Render one frame and return it in the project's working colour space
+ * (FL-626): sRGB-encoded display values for SDR projects, linear BT.709 in
+ * reference-white units for HDR ones (decoded from the float route's PQ
+ * BT.2020 signal). Same renderer as export, at the composition's own size.
+ */
+export async function renderWorkingFrame(
+  composition: CompositionInputProps,
+  frame: number,
+): Promise<{ width: number; height: number; rgb: Float32Array; domain: 'srgb-display-bt709' | 'linear-display-bt709-v1' }> {
+  const width = composition.width || DEFAULT_PROJECT_WIDTH
+  const height = composition.height || DEFAULT_PROJECT_HEIGHT
+  const canvas = new OffscreenCanvas(width, height)
+  const context = canvas.getContext('2d')
+  if (!context) throw new Error('Failed to get 2d context')
+  const renderer = await createCompositionRenderer(composition, canvas, context)
+  try {
+    await renderer.preload()
+    const color = resolveColorManagement(composition.colorManagement)
+    const rgb = new Float32Array(width * height * 3)
+    if (color.workingRange === 'hdr') {
+      const signal = await renderer.renderFrameSignal(frame, 'pq')
+      for (let i = 0, o = 0; i < signal.rgba.length; i += 4, o += 3) {
+        const linear2020: [number, number, number] = [
+          pqDecode(signal.rgba[i]!) / color.referenceWhiteNits,
+          pqDecode(signal.rgba[i + 1]!) / color.referenceWhiteNits,
+          pqDecode(signal.rgba[i + 2]!) / color.referenceWhiteNits,
+        ]
+        const [r, g, b] = multiply(BT2020_TO_BT709, linear2020)
+        rgb[o] = r; rgb[o + 1] = g; rgb[o + 2] = b
+      }
+      return { width: signal.width, height: signal.height, rgb, domain: 'linear-display-bt709-v1' }
+    }
+    await renderer.renderFrame(frame)
+    const { data } = context.getImageData(0, 0, width, height)
+    for (let i = 0, o = 0; i < data.length; i += 4, o += 3) {
+      rgb[o] = data[i]! / 255; rgb[o + 1] = data[i + 1]! / 255; rgb[o + 2] = data[i + 2]! / 255
+    }
+    return { width, height, rgb, domain: 'srgb-display-bt709' }
+  } finally {
+    try {
+      renderer.dispose()
+    } catch (error) {
+      getLog().warn('Failed to dispose working-frame renderer', { error })
+    }
+  }
+}
+
