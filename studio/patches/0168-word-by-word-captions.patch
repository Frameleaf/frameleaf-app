+++ b/src/features/editor/components/properties-sidebar/clip-panel/word-caption-style-card.tsx
@@ -0,0 +1,361 @@
+/**
+ * Caption style card (Frameleaf FL-640): how captions look in the picture.
+ *
+ * A live preview in Vertical 9:16 or Original, the four styles (Lines, Highlight, Word by word,
+ * One big word), a highlight colour, a size and a position. The preview follows the playhead while
+ * it is inside a caption, and otherwise loops the first caption. Choosing anything stores the look
+ * on the captions (`wordLook`) and writes the size and position as the captions' own font size and
+ * height, so the other caption controls and every renderer keep agreeing.
+ *
+ * Word styles need word times; they come from the transcript. Fonts are the captions' own (the
+ * title fonts); nothing here adds fonts or emphasis.
+ */
+
+import { memo, useCallback, useEffect, useMemo, useState } from 'react'
+import { useTranslation } from 'react-i18next'
+import { Captions } from 'lucide-react'
+
+import { cn } from '@/shared/ui/cn'
+import { useTimelineStore } from '@/features/editor/deps/timeline-store'
+import { usePlaybackStore } from '@/shared/state/playback'
+import {
+  DEFAULT_WORD_CAPTION_LOOK,
+  WORD_CAPTION_HIGHLIGHTS,
+  WORD_CAPTION_POSITIONS,
+  WORD_CAPTION_SIZES,
+  WORD_CAPTION_STYLES,
+  isWordCaptionLook,
+  resolveWordCaption,
+  wordLookStylePatch,
+} from '@/shared/typography/word-captions'
+import type {
+  AudioItem,
+  SubtitleSegmentItem,
+  TimelineItem,
+  TimelineTranscriptCaptions,
+  VideoItem,
+} from '@/types/timeline'
+import type { CaptionWord, WordCaptionLook } from '@/types/word-captions'
+
+type PreviewCue = { startSeconds: number; endSeconds: number; text: string; words?: CaptionWord[] }
+
+const SWATCH_NAMES = ['yellow', 'white', 'green', 'blue', 'coral'] as const
+const STYLE_KEYS = { lines: 'lines', highlight: 'highlight', word: 'word', big: 'big' } as const
+/** Preview font size as a fraction of the preview frame's short side, per size. */
+const PREVIEW_FONT = { small: 0.075, medium: 0.095, large: 0.13 } as const
+const PREVIEW_TOP = { bottom: '78%', middle: '50%', top: '22%' } as const
+const LOOP_TAIL_SECONDS = 0.6
+
+interface WordCaptionStyleCardProps {
+  look: WordCaptionLook | undefined
+  cues: readonly PreviewCue[]
+  /** The cue clock at a timeline frame (source seconds for clip captions). */
+  cueSecondsAt: (frame: number) => number
+  fontFamily?: string
+  textColor?: string
+  onChange: (look: WordCaptionLook) => void
+}
+
+/** The card itself; the two wrappers below connect it to clip captions or a caption segment. */
+export const WordCaptionStyleCard = memo(function WordCaptionStyleCard({
+  look: chosen,
+  cues,
+  cueSecondsAt,
+  fontFamily,
+  textColor = '#ffffff',
+  onChange,
+}: WordCaptionStyleCardProps) {
+  const { t } = useTranslation()
+  const look = isWordCaptionLook(chosen) ? chosen : DEFAULT_WORD_CAPTION_LOOK
+  const [vertical, setVertical] = useState(true)
+  const frame = usePlaybackStore((s) => s.currentFrame)
+  const playing = usePlaybackStore((s) => s.isPlaying)
+  const playheadSeconds = cueSecondsAt(frame)
+  const atPlayhead = cues.find(
+    (cue) => cue.startSeconds <= playheadSeconds && playheadSeconds < cue.endSeconds,
+  )
+  const cue = atPlayhead ?? cues[0]
+  const [loop, setLoop] = useState(0)
+  useEffect(() => {
+    if (playing || atPlayhead || !cue) return undefined
+    const length = cue.endSeconds - cue.startSeconds + LOOP_TAIL_SECONDS
+    const timer = setInterval(() => setLoop((value) => (value + 0.1) % length), 100)
+    return () => clearInterval(timer)
+  }, [playing, atPlayhead, cue])
+  const seconds = atPlayhead ? playheadSeconds : cue ? cue.startSeconds + loop : 0
+
+  const set = useCallback(
+    (patch: Partial<WordCaptionLook>) => onChange({ ...look, ...patch }),
+    [look, onChange],
+  )
+
+  if (!cue) return null
+  const hasWordTimes = cues.some((item) => (item.words?.length ?? 0) > 0)
+  const resolved = look.style === 'lines' ? null : resolveWordCaption(cue, seconds, look)
+  const showLine = look.style === 'lines' && seconds < cue.endSeconds
+
+  return (
+    <section
+      aria-label={t('wordCaptions.title')}
+      data-testid="word-caption-style-card"
+      className="space-y-2 rounded border border-border bg-muted/20 p-2"
+    >
+      <h4 className="flex items-center gap-1.5 text-xs font-semibold">
+        <Captions className="h-3.5 w-3.5" aria-hidden="true" />
+        {t('wordCaptions.title')}
+      </h4>
+
+      <div
+        data-testid="word-caption-preview"
+        data-style={look.style}
+        className={cn(
+          'relative mx-auto overflow-hidden rounded bg-black',
+          vertical ? 'aspect-[9/16] w-full max-w-[160px]' : 'aspect-video w-full',
+        )}
+        style={{ containerType: 'inline-size' }}
+      >
+        {(resolved || showLine) && (
+          <p
+            className="absolute inset-x-[8%] m-0 flex -translate-y-1/2 flex-wrap justify-center gap-x-[0.25em] text-center font-extrabold leading-tight"
+            style={{
+              top: PREVIEW_TOP[look.position],
+              fontFamily,
+              color: textColor,
+              fontSize: `${PREVIEW_FONT[look.size] * (resolved?.fontScale ?? 1) * 100}cqi`,
+              textShadow: '0 2px 6px rgb(0 0 0 / 70%)',
+              ...(showLine
+                ? { background: 'rgb(0 0 0 / 55%)', borderRadius: 4, padding: '2px 6px' }
+                : {}),
+            }}
+          >
+            {resolved
+              ? resolved.spans.map((span, index) => (
+                  <span
+                    key={`${index}-${span.text}`}
+                    data-said={span.color ? 'true' : undefined}
+                    style={span.color ? { color: span.color } : undefined}
+                  >
+                    {span.text.trim()}
+                  </span>
+                ))
+              : cue.text}
+          </p>
+        )}
+      </div>
+
+      <div
+        role="radiogroup"
+        aria-label={t('wordCaptions.previewShape')}
+        className="grid grid-cols-2 gap-1"
+      >
+        {(['vertical', 'original'] as const).map((shape) => (
+          <button
+            key={shape}
+            type="button"
+            role="radio"
+            aria-checked={vertical === (shape === 'vertical')}
+            onClick={() => setVertical(shape === 'vertical')}
+            className={cn(
+              'h-7 rounded border text-[11px] transition-colors',
+              vertical === (shape === 'vertical')
+                ? 'border-primary bg-secondary/60 text-foreground'
+                : 'border-border text-muted-foreground hover:bg-secondary/40',
+            )}
+          >
+            {t(`wordCaptions.${shape}`)}
+          </button>
+        ))}
+      </div>
+
+      <div
+        role="radiogroup"
+        aria-label={t('wordCaptions.style')}
+        className="grid grid-cols-2 gap-1.5"
+      >
+        {WORD_CAPTION_STYLES.map((style) => (
+          <button
+            key={style}
+            type="button"
+            role="radio"
+            aria-checked={look.style === style}
+            data-style={style}
+            onClick={() => set({ style })}
+            className={cn(
+              'flex flex-col gap-0.5 rounded border p-2 text-start transition-colors',
+              look.style === style
+                ? 'border-primary bg-secondary/60 text-foreground'
+                : 'border-border text-muted-foreground hover:bg-secondary/40',
+            )}
+          >
+            <b className="text-[11px]">{t(`wordCaptions.${STYLE_KEYS[style]}`)}</b>
+            <span className="text-[10px] leading-snug">
+              {t(`wordCaptions.${STYLE_KEYS[style]}Note`)}
+            </span>
+          </button>
+        ))}
+      </div>
+
+      {look.style !== 'lines' && (
+        <div
+          role="radiogroup"
+          aria-label={t('wordCaptions.highlightColour')}
+          className="flex flex-wrap gap-2"
+        >
+          {WORD_CAPTION_HIGHLIGHTS.map((colour, index) => (
+            <button
+              key={colour}
+              type="button"
+              role="radio"
+              aria-checked={look.highlightColor === colour}
+              aria-label={t(`wordCaptions.colour.${SWATCH_NAMES[index]}`)}
+              onClick={() => set({ highlightColor: colour })}
+              className={cn(
+                'h-7 w-7 rounded-full border border-border',
+                look.highlightColor === colour &&
+                  'outline outline-2 outline-offset-2 outline-primary',
+              )}
+              style={{ background: colour }}
+            />
+          ))}
+        </div>
+      )}
+
+      <div className="grid grid-cols-2 gap-2">
+        <label className="flex flex-col gap-1 text-[11px]">
+          <span className="text-muted-foreground">{t('wordCaptions.size')}</span>
+          <select
+            value={look.size}
+            onChange={(event) =>
+              set({ size: event.currentTarget.value as WordCaptionLook['size'] })
+            }
+            className="h-7 rounded border border-border bg-background px-1 text-xs"
+          >
+            {WORD_CAPTION_SIZES.map((size) => (
+              <option key={size} value={size}>
+                {t(`wordCaptions.${size}`)}
+              </option>
+            ))}
+          </select>
+        </label>
+        <label className="flex flex-col gap-1 text-[11px]">
+          <span className="text-muted-foreground">{t('wordCaptions.position')}</span>
+          <select
+            value={look.position}
+            onChange={(event) =>
+              set({ position: event.currentTarget.value as WordCaptionLook['position'] })
+            }
+            className="h-7 rounded border border-border bg-background px-1 text-xs"
+          >
+            {WORD_CAPTION_POSITIONS.map((position) => (
+              <option key={position} value={position}>
+                {t(`wordCaptions.${position}`)}
+              </option>
+            ))}
+          </select>
+        </label>
+      </div>
+
+      <p className="text-[10px] leading-snug text-muted-foreground">
+        {t(hasWordTimes ? 'wordCaptions.note' : 'wordCaptions.noWordTimes')}
+      </p>
+    </section>
+  )
+})
+
+type CaptionedClip = (AudioItem | VideoItem) & { transcriptCaptions: TimelineTranscriptCaptions }
+
+/** The card for captions a clip shows from its transcript. */
+export const ClipWordCaptionStyleCard = memo(function ClipWordCaptionStyleCard({
+  clips,
+  canvasWidth,
+  canvasHeight,
+}: {
+  clips: readonly CaptionedClip[]
+  canvasWidth: number
+  canvasHeight: number
+}) {
+  const updateItem = useTimelineStore((s) => s.updateItem)
+  const fps = useTimelineStore((s) => s.fps)
+  const first = clips[0]
+  const cueSecondsAt = useCallback(
+    (frame: number) => {
+      if (!first) return 0
+      const sourceFps = first.sourceFps ?? fps
+      return (
+        ((frame - first.from) / fps) * (first.speed ?? 1) + (first.sourceStart ?? 0) / sourceFps
+      )
+    },
+    [first, fps],
+  )
+  const onChange = useCallback(
+    (look: WordCaptionLook) => {
+      for (const clip of clips) {
+        const style = clip.transcriptCaptions.style ?? {}
+        updateItem(clip.id, {
+          transcriptCaptions: {
+            ...clip.transcriptCaptions,
+            wordLook: look,
+            style: {
+              ...style,
+              ...wordLookStylePatch(look, style.transform, canvasWidth, canvasHeight),
+            },
+            updatedAt: Date.now(),
+          },
+        } as Partial<TimelineItem>)
+      }
+    },
+    [canvasHeight, canvasWidth, clips, updateItem],
+  )
+  if (!first) return null
+  return (
+    <WordCaptionStyleCard
+      look={first.transcriptCaptions.wordLook}
+      cues={first.transcriptCaptions.cues}
+      cueSecondsAt={cueSecondsAt}
+      fontFamily={first.transcriptCaptions.style?.fontFamily}
+      onChange={onChange}
+    />
+  )
+})
+
+/** The card for caption segments on a caption track. */
+export const SegmentWordCaptionStyleCard = memo(function SegmentWordCaptionStyleCard({
+  segments,
+  canvasWidth,
+  canvasHeight,
+}: {
+  segments: readonly SubtitleSegmentItem[]
+  canvasWidth: number
+  canvasHeight: number
+}) {
+  const updateItem = useTimelineStore((s) => s.updateItem)
+  const fps = useTimelineStore((s) => s.fps)
+  const first = segments[0]
+  const cueSecondsAt = useCallback(
+    (frame: number) => (first ? (frame - first.from) / fps : 0),
+    [first, fps],
+  )
+  const onChange = useCallback(
+    (look: WordCaptionLook) => {
+      for (const segment of segments) {
+        updateItem(segment.id, {
+          wordLook: look,
+          ...wordLookStylePatch(look, segment.transform, canvasWidth, canvasHeight),
+        } as Partial<TimelineItem>)
+      }
+    },
+    [canvasHeight, canvasWidth, segments, updateItem],
+  )
+  const cues = useMemo(() => first?.cues ?? [], [first])
+  if (!first) return null
+  return (
+    <WordCaptionStyleCard
+      look={first.wordLook}
+      cues={cues}
+      cueSecondsAt={cueSecondsAt}
+      fontFamily={first.fontFamily}
+      textColor={first.color}
+      onChange={onChange}
+    />
+  )
+})
