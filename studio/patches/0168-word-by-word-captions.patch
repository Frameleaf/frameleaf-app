+/**
+ * Word-by-word captions (Frameleaf FL-640) through the real stores, composition, export paint,
+ * preview and the Caption style card.
+ */
+import { cleanup, fireEvent, render } from '@testing-library/react'
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vite-plus/test'
+import { SubtitleSection } from '@/features/editor/components/properties-sidebar/clip-panel/subtitle-section'
+import { useItemsStore } from '@/features/editor/deps/timeline-store'
+import {
+  resetTimelineCompositionTestState,
+  makeTimelineTrack,
+  makeTimelineVideoItem,
+} from '@/features/timeline/test-helpers'
+import { convertTimelineToComposition } from '@/features/export/utils/timeline-to-composition'
+import { renderSubtitleSegmentItem } from '@/features/export/utils/canvas-item-renderer/text'
+import type { ItemRenderContext } from '@/features/export/utils/canvas-item-renderer/types'
+import { TextMeasurementCache } from '@/features/export/utils/canvas-pool'
+import { buildTranscriptSubtitleWebVtt } from '@/features/export/utils/embedded-subtitle-export'
+import {
+  buildTimelineTranscriptCaptionCues,
+  correctPlacedTranscriptCaptions,
+  transcriptWordTextChanges,
+} from '@/features/media-library/services/media-transcription-service'
+import { correctTranscriptWord } from '@/features/timeline/utils/transcript-document'
+import { trimSubtitleCuesAtStart } from '@/features/timeline/stores/items-store-normalize'
+import { SubtitleSegmentContent } from '@/runtime/composition-runtime/components/subtitle-segment-content'
+import { SequenceContext } from '@/runtime/player/composition/sequence-context'
+import { VideoConfigProvider } from '@/runtime/player/VideoConfigProvider'
+import type { MediaTranscript } from '@/types/storage'
+import type { SubtitleSegmentItem, TimelineItem, VideoItem } from '@/types/timeline'
+import type { WordCaptionLook } from '@/types/word-captions'
+
+vi.mock('@tanstack/react-virtual', () => ({
+  useVirtualizer: ({ count }: { count: number }) => ({
+    getVirtualItems: () =>
+      Array.from({ length: count }, (_, index) => ({ index, key: index, start: index * 116 })),
+    getTotalSize: () => count * 116,
+    measureElement: () => {},
+  }),
+}))
+vi.mock('@/runtime/composition-runtime/utils/fonts', () => ({
+  loadFont: (family: string) => family,
+}))
+
+const HIGHLIGHT = '#f2cc60'
+const look = (style: WordCaptionLook['style']): WordCaptionLook => ({
+  style,
+  highlightColor: HIGHLIGHT,
+  size: 'large',
+  position: 'middle',
+})
+
+/** One cue, "We made it", words at 0-0.4, 0.5-0.9, 1.2-1.8 s on the segment clock. */
+function segment(wordLook?: WordCaptionLook): SubtitleSegmentItem {
+  return {
+    id: 'captions',
+    type: 'subtitle',
+    trackId: 'caption-track',
+    from: 0,
+    durationInFrames: 90,
+    label: 'Transcript',
+    mediaId: 'media-1',
+    source: { type: 'transcript', mediaId: 'media-1', clipId: 'video-1' },
+    cues: [
+      {
+        id: 'c0',
+        startSeconds: 0,
+        endSeconds: 2,
+        text: 'We made it',
+        words: [
+          { text: 'We', startSeconds: 0, endSeconds: 0.4, ref: '0:0' },
+          { text: 'made', startSeconds: 0.5, endSeconds: 0.9, ref: '0:1' },
+          { text: 'it', startSeconds: 1.2, endSeconds: 1.8, ref: '0:2' },
+        ],
+      },
+    ],
+    fontFamily: 'Arial',
+    fontSize: 40,
+    fontWeight: 'bold',
+    color: '#ffffff',
+    textAlign: 'center',
+    verticalAlign: 'middle',
+    ...(wordLook ? { wordLook } : {}),
+  }
+}
+
+function paint(item: SubtitleSegmentItem, frame: number) {
+  const painted: { text: string; color: string; font: string }[] = []
+  const ctx = {
+    font: '',
+    fillStyle: '',
+    strokeStyle: '',
+    lineWidth: 0,
+    letterSpacing: '0px',
+    save() {},
+    restore() {},
+    beginPath() {},
+    rect() {},
+    clip() {},
+    fill() {},
+    fillRect() {},
+    roundRect() {},
+    moveTo() {},
+    lineTo() {},
+    arcTo() {},
+    closePath() {},
+    measureText(text: string) {
+      return { width: text.length * 20, actualBoundingBoxAscent: 30, actualBoundingBoxDescent: 8 }
+    },
+    fillText(text: string) {
+      painted.push({ text, color: this.fillStyle, font: this.font })
+    },
+    strokeText() {},
+  }
+  renderSubtitleSegmentItem(
+    ctx as unknown as OffscreenCanvasRenderingContext2D,
+    item,
+    { x: 0, y: 0, width: 1000, height: 300 },
+    frame,
+    {
+      canvasSettings: { width: 1280, height: 720, fps: 30 },
+      renderMode: 'export',
+      textMeasureCache: new TextMeasurementCache(),
+    } as ItemRenderContext,
+  )
+  return painted
+}
+
+const words = (painted: ReturnType<typeof paint>) =>
+  painted
+    .map((entry) => entry.text)
+    .join('')
+    .split(/\s+/)
+    .filter(Boolean)
+const litWords = (painted: ReturnType<typeof paint>) =>
+  painted
+    .filter((entry) => entry.color.toLowerCase() === HIGHLIGHT)
+    .map((entry) => entry.text.trim())
+    .filter(Boolean)
+
+function preview(item: SubtitleSegmentItem, frame: number) {
+  return render(
+    <VideoConfigProvider fps={30} width={1280} height={720} durationInFrames={90}>
+      <SequenceContext.Provider
+        value={{ from: 0, durationInFrames: 90, localFrame: frame, parentFrom: 0 }}
+      >
+        <SubtitleSegmentContent item={item} />
+      </SequenceContext.Provider>
+    </VideoConfigProvider>,
+  )
+}
+
+beforeEach(resetTimelineCompositionTestState)
+afterEach(cleanup)
+
+describe('FL-640 burned-in word styles: export paint and preview', () => {
+  it('Lines paints the whole line in the caption colour (today)', () => {
+    const painted = paint(segment(), 16)
+    expect(words(painted)).toEqual(['We', 'made', 'it'])
+    expect(litWords(painted)).toEqual([])
+    expect(paint(segment(look('lines')), 16)).toEqual(painted)
+  })
+
+  it('Highlight paints the whole line and lights the word being said', () => {
+    const item = segment(look('highlight'))
+    // 0.53 s: "made" is being said.
+    const painted = paint(item, 16)
+    expect(words(painted)).toEqual(['We', 'made', 'it'])
+    expect(litWords(painted)).toEqual(['made'])
+    // 1.0 s: a pause, "made" stays lit; 1.3 s: "it".
+    expect(litWords(paint(item, 30))).toEqual(['made'])
+    expect(litWords(paint(item, 39))).toEqual(['it'])
+    const ui = preview(item, 16)
+    expect(ui.container.textContent?.replace(/\s+/g, ' ').trim()).toBe('We made it')
+    const lit = [...ui.container.querySelectorAll<HTMLElement>('span')].filter(
+      (span) => span.style.color && span.style.color !== 'rgb(255, 255, 255)',
+    )
+    expect(lit.map((span) => span.textContent?.trim())).toEqual(['made'])
+  })
+
+  it('Word by word paints only the words said so far', () => {
+    const item = segment(look('word'))
+    expect(words(paint(item, 3))).toEqual(['We'])
+    expect(words(paint(item, 16))).toEqual(['We', 'made'])
+    expect(words(paint(item, 39))).toEqual(['We', 'made', 'it'])
+    expect(preview(item, 16).container.textContent?.replace(/\s+/g, ' ').trim()).toBe('We made')
+  })
+
+  it('One big word paints the word being said, larger and in capitals', () => {
+    const item = segment(look('big'))
+    const painted = paint(item, 16)
+    expect(words(painted)).toEqual(['MADE'])
+    expect(litWords(painted)).toEqual(['MADE'])
+    expect(painted[0]!.font).toContain('72px')
+    expect(preview(item, 39).container.textContent?.trim()).toBe('IT')
+  })
+
+  it('keeps whole lines in the subtitle file whatever the picture style', () => {
+    const video = makeTimelineVideoItem({ id: 'video-1', durationInFrames: 90, mediaId: 'media-1' })
+    useItemsStore
+      .getState()
+      .setTracks([
+        makeTimelineTrack({ id: 'track-v1', name: 'V1', order: 1, kind: 'video' }),
+        makeTimelineTrack({ id: 'caption-track', name: 'Captions', order: 0, kind: 'video' }),
+      ])
+    useItemsStore.getState().setItems([video, segment(look('big'))])
+    const { tracks, items } = useItemsStore.getState()
+    const vtt = buildTranscriptSubtitleWebVtt(
+      convertTimelineToComposition(tracks, items, [], 30, 1280, 720),
+    )
+    expect(vtt).toContain('We made it')
+  })
+})
+
+describe('FL-640 clip captions made from the transcript', () => {
+  const transcript: MediaTranscript = {
+    id: 'media-1',
+    mediaId: 'media-1',
+    model: 'whisper-small',
+    quantization: 'q8',
+    text: 'We made it',
+    segments: [
+      {
+        text: 'We made it',
+        start: 3,
+        end: 4.8,
+        words: [
+          { text: 'We', start: 3, end: 3.4 },
+          { text: 'made', start: 3.5, end: 3.9 },
+          { text: 'it', start: 3.95, end: 4.8 },
+        ],
+      },
+    ],
+    createdAt: 1,
+    updatedAt: 1,
+  }
+
+  it('keep the transcript word times and a link to each transcript word', () => {
+    const [cue] = buildTimelineTranscriptCaptionCues('media-1', transcript.segments)
+    expect(cue!.words).toEqual([
+      { text: 'We', startSeconds: 3, endSeconds: 3.4, ref: '0:0' },
+      { text: 'made', startSeconds: 3.5, endSeconds: 3.9, ref: '0:1' },
+      { text: 'it', startSeconds: 3.95, endSeconds: 4.8, ref: '0:2' },
+    ])
+  })
+
+  it('render on the clip with its look, trimmed and moved to the timeline', () => {
+    const clip: VideoItem = {
+      ...makeTimelineVideoItem({
+        id: 'video-1',
+        mediaId: 'media-1',
+        from: 30,
+        durationInFrames: 120,
+        sourceStart: 60,
+        sourceEnd: 180,
+        sourceDuration: 300,
+      }),
+      transcriptCaptions: {
+        type: 'transcript',
+        mediaId: 'media-1',
+        enabled: true,
+        updatedAt: 1,
+        cues: buildTimelineTranscriptCaptionCues('media-1', transcript.segments),
+        wordLook: look('highlight'),
+      },
+    }
+    const composition = convertTimelineToComposition(
+      [makeTimelineTrack({ id: clip.trackId, name: 'V1', order: 0, kind: 'video' })],
+      [clip as TimelineItem],
+      [],
+      30,
+      1280,
+      720,
+    )
+    const virtual = composition.tracks
+      .flatMap((track) => track.items ?? [])
+      .find((item) => item.type === 'subtitle') as SubtitleSegmentItem
+    expect(virtual.wordLook).toEqual(look('highlight'))
+    // The clip shows source 2 s onward from timeline frame 30, so "made" (source 3.5 s) is at
+    // timeline 1.5 s past the clip start; the segment starts with the first word (1.0 s).
+    const made = virtual.cues[0]!.words!.find((word) => word.text === 'made')!
+    expect(virtual.from + Math.round((made.startSeconds + 0.01) * 30)).toBe(30 + 45)
+    expect(litWords(paint(virtual, 76))).toEqual(['made'])
+  })
+
+  it('follow a word corrected in the transcript, on placed captions too', () => {
+    const corrected = correctTranscriptWord(transcript, 0, 1, 'did')!
+    const changes = transcriptWordTextChanges(transcript.segments, corrected.segments)
+    expect([...changes]).toEqual([['0:1', 'did']])
+    const placed = segment(look('highlight'))
+    const updates = correctPlacedTranscriptCaptions(
+      [placed],
+      'media-1',
+      new Map([['We made it', 'We did it']]),
+      changes,
+    )
+    expect(updates).toHaveLength(1)
+    expect(updates[0]!.cues[0]!.text).toBe('We did it')
+    expect(updates[0]!.cues[0]!.words!.map((word) => word.text)).toEqual(['We', 'did', 'it'])
+    expect(updates[0]!.cues[0]!.words![1]!.startSeconds).toBe(0.5)
+  })
+
+  it('move their words when a caption segment is trimmed', () => {
+    const trimmed = trimSubtitleCuesAtStart(segment(), 15, 30)!
+    expect(trimmed.cues[0]!.words!.map((word) => [word.text, word.startSeconds])).toEqual([
+      ['made', 0],
+      ['it', expect.closeTo(0.7)],
+    ])
+  })
+})
