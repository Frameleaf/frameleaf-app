+import { describe, expect, it } from 'vite-plus/test'
+
+import {
+  VERTICAL_WORD_CAPTION_LOOK,
+  activeWordIndex,
+  captionCueWords,
+  estimateCaptionWords,
+  isWordStyle,
+  resolveWordCaption,
+  shiftCueWords,
+  wordCaptionPlacement,
+} from './word-captions'
+import type { CaptionWord, WordCaptionLook } from '@/types/word-captions'
+
+const words: CaptionWord[] = [
+  { text: 'We', startSeconds: 1, endSeconds: 1.2, ref: '0:0' },
+  { text: 'made', startSeconds: 1.25, endSeconds: 1.6, ref: '0:1' },
+  { text: 'it!', startSeconds: 1.9, endSeconds: 2.3, ref: '0:2' },
+]
+const cue = { startSeconds: 1, endSeconds: 2.5, text: 'We made it!', words }
+const look = (style: WordCaptionLook['style']): WordCaptionLook => ({
+  style,
+  highlightColor: '#f2cc60',
+  size: 'large',
+  position: 'middle',
+})
+
+describe('FL-640 word timing', () => {
+  it('uses the transcript word times when the cue has them', () => {
+    expect(captionCueWords(cue)).toEqual(words)
+  })
+
+  it('spreads a line without word times over its time by word length', () => {
+    const estimated = estimateCaptionWords('Hi wonderful world', 0, 3)
+    expect(estimated.map((word) => word.text)).toEqual(['Hi', 'wonderful', 'world'])
+    expect(estimated[0]!.startSeconds).toBe(0)
+    expect(estimated.at(-1)!.endSeconds).toBeCloseTo(3)
+    // Longer words take longer.
+    const length = (word: CaptionWord) => word.endSeconds - word.startSeconds
+    expect(length(estimated[1]!)).toBeGreaterThan(length(estimated[0]!))
+    expect(captionCueWords({ startSeconds: 0, endSeconds: 3, text: 'Hi wonderful world' })).toEqual(
+      estimated,
+    )
+  })
+
+  it('ignores empty or zero-length words', () => {
+    const odd = { ...cue, words: [...words, { text: ' ', startSeconds: 2, endSeconds: 2.1 }] }
+    expect(captionCueWords(odd)).toHaveLength(3)
+  })
+
+  it('moves words with a trim or split and drops the ones left outside the cue', () => {
+    const trimmed = shiftCueWords({ ...cue, startSeconds: 0, endSeconds: 1.2 }, 1.1)
+    expect(trimmed.words).toEqual(
+      [
+        { text: 'We', startSeconds: 0, endSeconds: 0.1, ref: '0:0' },
+        { text: 'made', startSeconds: 0.15, endSeconds: 0.5, ref: '0:1' },
+        { text: 'it!', startSeconds: 0.8, endSeconds: 1.2, ref: '0:2' },
+      ].map((word) => ({
+        ...word,
+        startSeconds: expect.closeTo(word.startSeconds),
+        endSeconds: expect.closeTo(word.endSeconds),
+      })),
+    )
+    expect(shiftCueWords({ ...cue, startSeconds: 0, endSeconds: 0.05 }, 5).words).toBeUndefined()
+    const plain = { startSeconds: 0, endSeconds: 1, text: 'x' }
+    expect(shiftCueWords(plain, 1)).toBe(plain)
+  })
+})
+
+describe('FL-640 the active word', () => {
+  it('is -1 before the first word, then the last word that has started', () => {
+    expect(activeWordIndex(words, 0.9)).toBe(-1)
+    expect(activeWordIndex(words, 1)).toBe(0)
+    expect(activeWordIndex(words, 1.3)).toBe(1)
+    // A pause between words keeps the last word lit.
+    expect(activeWordIndex(words, 1.75)).toBe(1)
+    expect(activeWordIndex(words, 1.9)).toBe(2)
+    expect(activeWordIndex(words, 2.45)).toBe(2)
+    expect(activeWordIndex([], 1)).toBe(-1)
+  })
+})
+
+describe('FL-640 what each style draws', () => {
+  it('Highlight shows the line and lights the word being said', () => {
+    const drawn = resolveWordCaption(cue, 1.3, look('highlight'))!
+    expect(drawn.text).toBe('We made it!')
+    expect(drawn.spans).toEqual([
+      { text: 'We ' },
+      { text: 'made ', color: '#f2cc60' },
+      { text: 'it!' },
+    ])
+    expect(drawn.fontScale).toBe(1)
+    // Before the first word the line shows with nothing lit.
+    expect(resolveWordCaption(cue, 0.5, look('highlight'))!.spans.some((span) => span.color)).toBe(
+      false,
+    )
+  })
+
+  it('Word by word shows the words said so far', () => {
+    expect(resolveWordCaption(cue, 0.5, look('word'))).toBeNull()
+    expect(resolveWordCaption(cue, 1.3, look('word'))!.text).toBe('We made')
+    expect(resolveWordCaption(cue, 2, look('word'))!.text).toBe('We made it!')
+  })
+
+  it('One big word shows the word being said, larger and in capitals', () => {
+    expect(resolveWordCaption(cue, 0.5, look('big'))).toBeNull()
+    const drawn = resolveWordCaption(cue, 1.95, look('big'))!
+    expect(drawn.spans).toEqual([{ text: 'IT!', color: '#f2cc60' }])
+    expect(drawn.fontScale).toBeGreaterThan(1)
+  })
+
+  it('treats Lines and unknown looks as whole lines', () => {
+    expect(isWordStyle(look('lines'))).toBe(false)
+    expect(isWordStyle(undefined)).toBe(false)
+    expect(isWordStyle({ ...look('highlight'), size: 'huge' } as unknown as WordCaptionLook)).toBe(
+      false,
+    )
+    expect(isWordStyle(look('highlight'))).toBe(true)
+  })
+})
+
+describe('FL-640 size and position', () => {
+  it('sizes from the short side, so a look reads the same in 16:9 and 9:16', () => {
+    expect(wordCaptionPlacement(look('highlight'), 1920, 1080).fontSize).toBe(
+      wordCaptionPlacement(look('highlight'), 1080, 1920).fontSize,
+    )
+    const small = wordCaptionPlacement({ size: 'small', position: 'bottom' }, 1920, 1080)
+    const large = wordCaptionPlacement({ size: 'large', position: 'top' }, 1920, 1080)
+    expect(large.fontSize).toBeGreaterThan(small.fontSize)
+    expect(small.y).toBeGreaterThan(0)
+    expect(large.y).toBeLessThan(0)
+    expect(wordCaptionPlacement({ size: 'medium', position: 'middle' }, 1920, 1080).y).toBe(0)
+  })
+
+  it('defaults a Vertical 9:16 export to Highlight, Large, Middle', () => {
+    expect(VERTICAL_WORD_CAPTION_LOOK).toMatchObject({
+      style: 'highlight',
+      size: 'large',
+      position: 'middle',
+    })
+  })
+})
