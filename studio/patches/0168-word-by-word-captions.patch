@@ -0,0 +1,36 @@
+/**
+ * Word-by-word captions (Frameleaf FL-640): the stored shapes.
+ *
+ * A caption cue made from a transcript carries the transcript's own word times, so the picture can
+ * light up, reveal or show one word at a time as it is said. A subtitle file or embedded subtitle
+ * track always carries whole lines; only the picture uses the words.
+ */
+
+/** One word of a caption cue. Times use the same clock as the cue that holds it. */
+export interface CaptionWord {
+  text: string
+  startSeconds: number
+  endSeconds: number
+  /**
+   * The transcript word this came from, `segmentIndex:wordIndex` in the media's transcript, so a
+   * word corrected in the transcript is corrected here too.
+   */
+  ref?: string
+}
+
+/** `lines` is today's captions; the others need word times and are burned into the picture. */
+export type WordCaptionStyle = 'lines' | 'highlight' | 'word' | 'big'
+export type WordCaptionSize = 'small' | 'medium' | 'large'
+export type WordCaptionPosition = 'bottom' | 'middle' | 'top'
+
+/**
+ * How captions look in the picture. Present only once the person has chosen a look in the Caption
+ * style card; a Vertical 9:16 export without one uses Highlight, Large, Middle.
+ */
+export interface WordCaptionLook {
+  style: WordCaptionStyle
+  /** Colour of the word being said (Highlight), or of every shown word (Word by word, One big word). */
+  highlightColor: string
+  size: WordCaptionSize
+  position: WordCaptionPosition
+}
