@@ -0,0 +1,231 @@
+/**
+ * Word-by-word captions (Frameleaf FL-640): the pure model shared by the preview, the export
+ * renderer and the Caption style card.
+ *
+ * Word times come from the transcript (FL-562): cues made from a transcript carry its words, and a
+ * word corrected there is corrected in the cue too. A cue without word times (an imported subtitle
+ * file, or captions typed by hand) spreads its line over its time by word length, as the mock does,
+ * so every style still reads; that is an estimate, never stored.
+ *
+ * Nothing here reads a store, so it is unit-tested directly.
+ */
+
+import type { TextSpan } from '@/types/text'
+import type { TransformProperties } from '@/types/transform'
+import type {
+  CaptionWord,
+  WordCaptionLook,
+  WordCaptionPosition,
+  WordCaptionSize,
+  WordCaptionStyle,
+} from '@/types/word-captions'
+
+export const WORD_CAPTION_STYLES: readonly WordCaptionStyle[] = [
+  'lines',
+  'highlight',
+  'word',
+  'big',
+]
+export const WORD_CAPTION_SIZES: readonly WordCaptionSize[] = ['small', 'medium', 'large']
+export const WORD_CAPTION_POSITIONS: readonly WordCaptionPosition[] = ['bottom', 'middle', 'top']
+/** The mock's swatches: warm yellow, white, green, blue, coral. */
+export const WORD_CAPTION_HIGHLIGHTS: readonly string[] = [
+  '#f2cc60',
+  '#ffffff',
+  '#3fb950',
+  '#58a6ff',
+  '#ff7b72',
+]
+
+/** What the card shows before anyone chooses: today's captions. */
+export const DEFAULT_WORD_CAPTION_LOOK: WordCaptionLook = {
+  style: 'lines',
+  highlightColor: WORD_CAPTION_HIGHLIGHTS[0]!,
+  size: 'medium',
+  position: 'bottom',
+}
+
+/**
+ * The look of a Vertical 9:16 export when the person has not chosen one (owner decision
+ * 2026-10-29). The render worker applies the same look (`studio/tools/bundled-worker-word-captions.mjs`).
+ */
+export const VERTICAL_WORD_CAPTION_LOOK: WordCaptionLook = {
+  style: 'highlight',
+  highlightColor: WORD_CAPTION_HIGHLIGHTS[0]!,
+  size: 'large',
+  position: 'middle',
+}
+
+/** Font size as a fraction of the frame's short side, so a look reads the same in 16:9 and 9:16. */
+export const WORD_CAPTION_SIZE_RATIO: Readonly<Record<WordCaptionSize, number>> = {
+  small: 0.04,
+  medium: 0.05,
+  large: 0.07,
+}
+/** Box centre offset from the frame centre, as a fraction of the frame height. */
+export const WORD_CAPTION_POSITION_RATIO: Readonly<Record<WordCaptionPosition, number>> = {
+  bottom: 0.3,
+  middle: 0,
+  top: -0.3,
+}
+/** One big word is drawn this much larger than the chosen size. */
+export const BIG_WORD_SCALE = 1.8
+
+export function isWordCaptionLook(value: unknown): value is WordCaptionLook {
+  if (!value || typeof value !== 'object') return false
+  const look = value as Partial<WordCaptionLook>
+  return (
+    WORD_CAPTION_STYLES.includes(look.style as WordCaptionStyle) &&
+    typeof look.highlightColor === 'string' &&
+    WORD_CAPTION_SIZES.includes(look.size as WordCaptionSize) &&
+    WORD_CAPTION_POSITIONS.includes(look.position as WordCaptionPosition)
+  )
+}
+
+/** True when the look draws words one at a time, rather than whole lines. */
+export function isWordStyle(look: WordCaptionLook | undefined): look is WordCaptionLook {
+  return !!look && look.style !== 'lines' && isWordCaptionLook(look)
+}
+
+/** Font size and vertical offset of a look on a frame of this size. */
+export function wordCaptionPlacement(
+  look: Pick<WordCaptionLook, 'size' | 'position'>,
+  width: number,
+  height: number,
+): { fontSize: number; y: number } {
+  const short = Math.max(1, Math.min(width, height))
+  return {
+    fontSize: Math.max(8, Math.round(short * WORD_CAPTION_SIZE_RATIO[look.size])),
+    y: Math.round(height * WORD_CAPTION_POSITION_RATIO[look.position]),
+  }
+}
+
+/** Words of a line spread over its time by length (no transcript times). */
+export function estimateCaptionWords(
+  text: string,
+  startSeconds: number,
+  endSeconds: number,
+): CaptionWord[] {
+  const words = text.split(/\s+/).filter(Boolean)
+  const weights = words.map((word) => 1 + word.replace(/[^\p{L}\p{N}]/gu, '').length / 6)
+  const total = weights.reduce((sum, value) => sum + value, 0) || 1
+  const span = Math.max(0, endSeconds - startSeconds)
+  let cursor = startSeconds
+  return words.map((word, index) => {
+    const duration = (span * weights[index]!) / total
+    const item = { text: word, startSeconds: cursor, endSeconds: cursor + duration }
+    cursor += duration
+    return item
+  })
+}
+
+/** The transcript's words when the cue has them, else an estimate from its text. */
+export function captionCueWords(
+  cue: { startSeconds: number; endSeconds: number; text: string; words?: readonly CaptionWord[] },
+  plainText: string = cue.text,
+): CaptionWord[] {
+  const words = (cue.words ?? []).filter(
+    (word) => word.text.trim().length > 0 && word.endSeconds > word.startSeconds,
+  )
+  if (words.length > 0) return words.toSorted((a, b) => a.startSeconds - b.startSeconds)
+  return estimateCaptionWords(plainText, cue.startSeconds, cue.endSeconds)
+}
+
+/**
+ * Index of the word being said at `seconds`: the last word that has started, so a short pause
+ * between words keeps the last one lit instead of flickering. -1 before the first word.
+ */
+export function activeWordIndex(words: readonly CaptionWord[], seconds: number): number {
+  let active = -1
+  for (let index = 0; index < words.length; index++) {
+    if (words[index]!.startSeconds <= seconds + 1e-9) active = index
+    else break
+  }
+  return active
+}
+
+export interface ResolvedWordCaption {
+  /** Plain text drawn this frame. */
+  text: string
+  /** One span per word, flowed inline; the word being said carries the highlight colour. */
+  spans: TextSpan[]
+  /** Multiplies the item's font size (One big word). */
+  fontScale: number
+}
+
+/**
+ * What a word style draws for a cue at `seconds` (the cue's own clock), or null when nothing shows
+ * yet (Word by word and One big word before the first word is said).
+ */
+export function resolveWordCaption(
+  cue: { startSeconds: number; endSeconds: number; text: string; words?: readonly CaptionWord[] },
+  seconds: number,
+  look: WordCaptionLook,
+  plainText: string = cue.text,
+): ResolvedWordCaption | null {
+  const words = captionCueWords(cue, plainText)
+  if (words.length === 0) return null
+  const active = activeWordIndex(words, seconds)
+  const span = (word: CaptionWord, index: number, last: number): TextSpan => ({
+    text: index < last ? `${word.text.trim()} ` : word.text.trim(),
+    ...(index === active ? { color: look.highlightColor } : {}),
+  })
+
+  if (look.style === 'big') {
+    const word = active >= 0 ? words[active]! : null
+    if (!word) return null
+    const text = word.text.trim().toLocaleUpperCase()
+    return {
+      text,
+      spans: [{ text, color: look.highlightColor }],
+      fontScale: BIG_WORD_SCALE,
+    }
+  }
+
+  const shown = look.style === 'word' ? words.slice(0, active + 1) : words
+  if (shown.length === 0) return null
+  const spans = shown.map((word, index) => span(word, index, shown.length - 1))
+  return { text: spans.map((item) => item.text).join(''), spans, fontScale: 1 }
+}
+
+/**
+ * A cue whose clock moved `deltaSeconds` earlier (a trim or split re-anchored it), with its words
+ * moved the same way. Words that no longer fall inside the cue are dropped.
+ */
+export function shiftCueWords<
+  T extends { startSeconds: number; endSeconds: number; words?: CaptionWord[] },
+>(cue: T, deltaSeconds: number): T {
+  if (!cue.words?.length) return cue
+  const words = cue.words.flatMap((word) => {
+    const startSeconds = Math.max(cue.startSeconds, word.startSeconds - deltaSeconds)
+    const endSeconds = Math.min(cue.endSeconds, word.endSeconds - deltaSeconds)
+    return endSeconds > startSeconds ? [{ ...word, startSeconds, endSeconds }] : []
+  })
+  const next = { ...cue }
+  if (words.length > 0) next.words = words
+  else delete next.words
+  return next
+}
+
+const BLANK_TRANSFORM: TransformProperties = {
+  x: 0,
+  y: 0,
+  width: 0,
+  height: 0,
+  rotation: 0,
+  opacity: 1,
+}
+
+/** The caption style fields a look sets on a canvas of this size. */
+export function wordLookStylePatch(
+  look: WordCaptionLook,
+  transform: TransformProperties | undefined,
+  canvasWidth: number,
+  canvasHeight: number,
+): { fontSize: number; transform: TransformProperties } {
+  const placement = wordCaptionPlacement(look, canvasWidth, canvasHeight)
+  return {
+    fontSize: placement.fontSize,
+    transform: { ...(transform ?? BLANK_TRANSFORM), y: placement.y },
+  }
+}
