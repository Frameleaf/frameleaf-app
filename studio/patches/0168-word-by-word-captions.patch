+describe('FL-640 Caption style card', () => {
+  it('stores the chosen look and writes its size and position as the caption style', () => {
+    const video = makeTimelineVideoItem({ id: 'video-1', durationInFrames: 90, mediaId: 'media-1' })
+    useItemsStore
+      .getState()
+      .setTracks([
+        makeTimelineTrack({ id: 'track-v1', name: 'V1', order: 1, kind: 'video' }),
+        makeTimelineTrack({ id: 'caption-track', name: 'Captions', order: 0, kind: 'video' }),
+      ])
+    useItemsStore.getState().setItems([video, segment()])
+    function Editor() {
+      const items = useItemsStore((state) => state.items)
+      return (
+        <SubtitleSection
+          items={items.filter((item) => item.id === 'captions')}
+          canvas={{ width: 1920, height: 1080 }}
+        />
+      )
+    }
+    const ui = render(<Editor />)
+    const card = ui.getByTestId('word-caption-style-card')
+    expect(card.getAttribute('aria-label')).toBe('Caption style')
+    const radios = [...card.querySelectorAll<HTMLButtonElement>('[role="radio"][data-style]')]
+    expect(radios.map((radio) => radio.dataset.style)).toEqual([
+      'lines',
+      'highlight',
+      'word',
+      'big',
+    ])
+    expect(radios[0]!.getAttribute('aria-checked')).toBe('true')
+
+    fireEvent.click(radios[1]!)
+    const current = () =>
+      useItemsStore.getState().items.find((item) => item.id === 'captions') as SubtitleSegmentItem
+    expect(current().wordLook).toEqual({
+      style: 'highlight',
+      highlightColor: HIGHLIGHT,
+      size: 'medium',
+      position: 'bottom',
+    })
+    expect(current().fontSize).toBe(54)
+    expect(current().transform?.y).toBe(324)
+
+    const [size, position] = [...card.querySelectorAll<HTMLSelectElement>('select')]
+    fireEvent.change(size!, { target: { value: 'large' } })
+    fireEvent.change(position!, { target: { value: 'middle' } })
+    expect(current().wordLook).toMatchObject({ size: 'large', position: 'middle' })
+    expect(current().fontSize).toBe(76)
+    expect(current().transform?.y).toBe(0)
+
+    const swatches = card.querySelectorAll<HTMLButtonElement>(
+      '[role="radiogroup"][aria-label="Highlight colour"] [role="radio"]',
+    )
+    expect(swatches).toHaveLength(5)
+    fireEvent.click(swatches[2]!)
+    expect(current().wordLook?.highlightColor).toBe('#3fb950')
+    expect(ui.getByTestId('word-caption-preview').dataset.style).toBe('highlight')
+  })
+})
