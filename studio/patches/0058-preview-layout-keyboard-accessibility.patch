@@ -0,0 +1,139 @@
+import { act, fireEvent, render, screen } from '@testing-library/react'
+import { beforeEach, describe, expect, it } from 'vite-plus/test'
+import { useItemsStore, useTimelineStore } from '@/features/editor/deps/timeline-store'
+import { useCornerPinStore } from '@/features/editor/deps/preview'
+import {
+  resolveCornerPinForSize,
+  resolveCornerPinTargetRect,
+} from '@/features/editor/deps/composition-runtime'
+import type { ShapeItem, TimelineItem } from '@/types/timeline'
+import { CornerPinSection } from './corner-pin-section'
+
+const SHAPE: ShapeItem = {
+  id: 'pin-1',
+  type: 'shape',
+  shapeType: 'rectangle',
+  fillColor: '#ffffff',
+  trackId: 'track-1',
+  from: 0,
+  durationInFrames: 90,
+  label: 'Pinned shape',
+  transform: { x: 15, y: 25, width: 400, height: 200, rotation: 35, flipHorizontal: true },
+  cornerPin: {
+    topLeft: [10, 20],
+    topRight: [30, 40],
+    bottomRight: [50, 60],
+    bottomLeft: [70, 80],
+    referenceWidth: 200,
+    referenceHeight: 100,
+  },
+}
+
+function Inspector() {
+  const items = useItemsStore((state) => state.items)
+  return <CornerPinSection items={items} />
+}
+
+function openInspector() {
+  render(<Inspector />)
+  fireEvent.click(screen.getByRole('button', { expanded: false }))
+}
+
+describe('CornerPinSection keyboard geometry', () => {
+  beforeEach(() => {
+    useCornerPinStore.getState().stopEditing()
+    useTimelineStore.setState({ keyframes: [] })
+    useItemsStore.getState().setItems([structuredClone(SHAPE)])
+    useItemsStore.getState().setTracks([
+      {
+        id: 'track-1',
+        name: 'Track',
+        order: 0,
+        height: 72,
+        items: [],
+        locked: false,
+        visible: true,
+        muted: false,
+        solo: false,
+      },
+    ])
+    useTimelineStore.temporal.getState().clear()
+  })
+
+  it.each([false, true])(
+    'keeps all other scaled corners when keyboard editing a cropped media target=%s',
+    (media) => {
+      const item = media
+        ? ({
+            ...SHAPE,
+            type: 'image',
+            mediaId: 'fixture',
+            src: '/fixture.png',
+            sourceWidth: 800,
+            sourceHeight: 200,
+            crop: { right: 0.25 },
+          } as TimelineItem)
+        : structuredClone(SHAPE)
+      useItemsStore.getState().setItems([item])
+      useTimelineStore.temporal.getState().clear()
+      const before = structuredClone(useItemsStore.getState().items)
+      const target = resolveCornerPinTargetRect(
+        400,
+        200,
+        media
+          ? {
+              sourceWidth: 800,
+              sourceHeight: 200,
+              crop: { right: 0.25 },
+            }
+          : undefined,
+      )
+      const displayed = resolveCornerPinForSize(item.cornerPin, target.width, target.height)!
+      openInspector()
+      const x = screen.getAllByRole('textbox')[0]!
+      x.focus()
+      fireEvent.keyDown(x, { key: 'ArrowUp' })
+      const after = structuredClone(useItemsStore.getState().items)
+      expect(after[0]!.cornerPin).toEqual({
+        ...displayed,
+        topLeft: [displayed.topLeft[0] + 1, displayed.topLeft[1]],
+        referenceWidth: target.width,
+        referenceHeight: target.height,
+      })
+      expect(after[0]!.transform).toEqual(item.transform)
+      expect(x).toHaveFocus()
+      expect(screen.getByRole('textbox', { name: 'Top left X' })).toBe(x)
+      expect(useTimelineStore.temporal.getState().pastStates).toHaveLength(1)
+      act(() => useTimelineStore.temporal.getState().undo())
+      expect(useItemsStore.getState().items).toEqual(before)
+      act(() => useTimelineStore.temporal.getState().redo())
+      expect(useItemsStore.getState().items).toEqual(after)
+    },
+  )
+
+  it('names every corner axis and refuses edits and reset after an inherited track lock', () => {
+    openInspector()
+    for (const corner of ['Top left', 'Top right', 'Bottom right', 'Bottom left']) {
+      for (const axis of ['X', 'Y'])
+        expect(screen.getByRole('textbox', { name: `${corner} ${axis}` })).toBeEnabled()
+    }
+    const x = screen.getByRole('textbox', { name: 'Top left X' })
+    const reset = screen.getByTitle(/^(Reset corner pin|editor.cornerPinSection.reset)$/)
+    const before = structuredClone(useItemsStore.getState().items)
+    act(() => {
+      const track = useItemsStore.getState().tracks[0]!
+      useItemsStore.getState().setTracks([
+        { ...track, id: 'group', isGroup: true, locked: true },
+        { ...track, parentTrackId: 'group' },
+      ])
+    })
+    expect(x).toBeDisabled()
+    expect(reset).toBeDisabled()
+    // A captured keyboard callback must still reject the write after locking.
+    fireEvent.keyDown(x, { key: 'ArrowUp' })
+    fireEvent.click(reset)
+    expect(useItemsStore.getState().items).toEqual(before)
+    expect(useTimelineStore.getState().keyframes).toEqual([])
+    expect(useTimelineStore.temporal.getState().pastStates).toHaveLength(0)
+  })
+})
