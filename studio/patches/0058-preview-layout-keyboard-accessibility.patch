+describe('Native pen captured-session retirement', () => {
+  const freshVertex = {
+    position: [0.7, 0.8] as [number, number],
+    inHandle: [0, 0] as [number, number],
+    outHandle: [0, 0] as [number, number],
+    tangentMode: 'corner' as const,
+  }
+  beforeEach(() => {
+    resetStores()
+    useSelectionStore.getState().setActiveTrack('track-1')
+    useTimelineStore.temporal.getState().clear()
+  })
+
+  function plant(x: number, y: number) {
+    fireEvent.change(screen.getByRole('spinbutton', { name: 'New pen point X (project pixels)' }), {
+      target: { value: String(x) },
+    })
+    fireEvent.change(screen.getByRole('spinbutton', { name: 'New pen point Y (project pixels)' }), {
+      target: { value: String(y) },
+    })
+    fireEvent.submit(screen.getByRole('form', { name: 'New pen point placement' }))
+  }
+
+  function begin() {
+    useMaskEditorStore.getState().startShapePenMode()
+    renderMaskEditorOverlay()
+    plant(20, 20)
+    plant(120, 80)
+    plant(120, 20)
+  }
+
+  function replaceDraft(cancelFirst: boolean) {
+    if (cancelFirst) useMaskEditorStore.getState().cancelPenMode()
+    useMaskEditorStore.getState().startShapePenMode()
+    useMaskEditorStore.getState().setPenVertices([freshVertex])
+    useMaskEditorStore.getState().setPenCursorPos(freshVertex.position)
+    useMaskEditorStore.getState().setHover(0)
+    screen.getByRole('spinbutton', { name: 'New pen point Y (project pixels)' }).focus()
+  }
+
+  function expectFreshDraft() {
+    expect(useMaskEditorStore.getState()).toMatchObject({
+      penMode: true,
+      shapePenMode: true,
+      isEditing: true,
+      penVertices: [freshVertex],
+      penCursorPos: freshVertex.position,
+      hoveredVertexIndex: 0,
+    })
+    expect(document.activeElement).toBe(
+      screen.getByRole('spinbutton', { name: 'New pen point Y (project pixels)' }),
+    )
+    expect(useItemsStore.getState().items).toEqual([])
+    expect(useTimelineStore.temporal.getState().pastStates).toHaveLength(0)
+  }
+
+  for (const closed of [false, true]) {
+    for (const cancelFirst of [false, true]) {
+      it.each([false, true])(
+        `retires ${closed ? 'closed' : 'open'} Finish capture on ${cancelFirst ? 'cancel/restart' : 'replacement'} (early subscriber=%s)`,
+        (early) => {
+          let armed = false
+          let replaced = false
+          const listener = () => {
+            if (!armed || replaced) return
+            replaced = true
+            replaceDraft(cancelFirst)
+          }
+          const earlyUnsubscribe = early ? useMaskEditorStore.subscribe(listener) : undefined
+          begin()
+          const unsubscribe = earlyUnsubscribe ?? useMaskEditorStore.subscribe(listener)
+          armed = true
+          fireEvent.click(
+            screen.getByRole('button', {
+              name: closed ? 'Close new pen path' : 'Finish new pen path',
+            }),
+          )
+          unsubscribe()
+          expect(replaced).toBe(true)
+          expectFreshDraft()
+        },
+      )
+    }
+  }
+
+  for (const notification of ['vertex', 'cursor', 'hover']) {
+    it.each([false, true])(
+      `does not publish old ${notification} state into a replacement draft (cancel first=%s)`,
+      (cancelFirst) => {
+        begin()
+        let count = 0
+        let replaced = false
+        const target = notification === 'vertex' ? 1 : notification === 'cursor' ? 2 : 3
+        const unsubscribe = useMaskEditorStore.subscribe(() => {
+          if (replaced || ++count !== target) return
+          replaced = true
+          replaceDraft(cancelFirst)
+        })
+        plant(140, 100)
+        unsubscribe()
+        expect(replaced).toBe(true)
+        expectFreshDraft()
+      },
+    )
+  }
+
+  for (const route of ['Remove last', 'Backspace', 'Delete']) {
+    for (const notification of [1, 2, 3]) {
+      it.each(['lock/unlock', 'cancel/restart'])(
+        `does not restore stale points/hover after ${route} notification ${notification}: %s`,
+        (change) => {
+          begin()
+          let count = 0
+          let changed = false
+          const unsubscribe = useMaskEditorStore.subscribe(() => {
+            if (changed || ++count !== notification) return
+            changed = true
+            if (change === 'cancel/restart') replaceDraft(true)
+            else {
+              const tracks = useItemsStore.getState().tracks
+              useItemsStore
+                .getState()
+                .setTracks(tracks.map((track) => ({ ...track, locked: true })))
+              useItemsStore.getState().setTracks(tracks)
+            }
+          })
+          if (route === 'Remove last')
+            fireEvent.click(screen.getByRole('button', { name: 'Remove last new pen point' }))
+          else fireEvent.keyDown(window, { key: route })
+          unsubscribe()
+          expect(changed).toBe(true)
+          if (change === 'cancel/restart') expectFreshDraft()
+          else {
+            expect(useMaskEditorStore.getState()).toMatchObject({
+              penMode: false,
+              penVertices: [],
+              penCursorPos: null,
+              hoveredVertexIndex: null,
+            })
+            expect(useItemsStore.getState().items).toEqual([])
+            expect(useTimelineStore.temporal.getState().pastStates).toHaveLength(0)
+          }
+        },
+      )
+    }
+  }
+
+  it.each(['Cancel', 'Escape'])(
+    'keeps the fresh draft when %s cleanup replaces the captured session',
+    (route) => {
+      begin()
+      let replaced = false
+      const unsubscribe = useMaskEditorStore.subscribe(() => {
+        if (replaced) return
+        replaced = true
+        replaceDraft(true)
+      })
+      if (route === 'Cancel')
+        fireEvent.click(screen.getByRole('button', { name: 'Cancel new pen path' }))
+      else fireEvent.keyDown(window, { key: 'Escape' })
+      unsubscribe()
+      expectFreshDraft()
+    },
+  )
+})
+
+it('places and finishes a fresh keyboard draft inside an earlier cancellation subscriber', () => {
+  resetStores()
+  useSelectionStore.getState().setActiveTrack('track-1')
+  useTimelineStore.temporal.getState().clear()
+  let armed = false
+  let stage = 0
+  const plant = (x: number, y: number) => {
+    fireEvent.change(screen.getByRole('spinbutton', { name: 'New pen point X (project pixels)' }), {
+      target: { value: String(x) },
+    })
+    fireEvent.change(screen.getByRole('spinbutton', { name: 'New pen point Y (project pixels)' }), {
+      target: { value: String(y) },
+    })
+    fireEvent.submit(screen.getByRole('form', { name: 'New pen point placement' }))
+  }
+  const unsubscribe = useMaskEditorStore.subscribe((state) => {
+    if (!armed || stage === 2) return
+    if (stage === 0) {
+      stage = 1
+      useMaskEditorStore.getState().cancelPenMode()
+    } else if (!state.penMode) {
+      stage = 2
+      useMaskEditorStore.getState().startShapePenMode()
+      fireEvent.submit(screen.getByRole('form', { name: 'New pen point placement' }))
+      useMaskEditorStore.getState().addPenVertex({
+        position: [0.65, 0.75],
+        inHandle: [0, 0],
+        outHandle: [0, 0],
+        tangentMode: 'corner',
+      })
+    }
+  })
+  useMaskEditorStore.getState().startShapePenMode()
+  renderMaskEditorOverlay()
+  plant(20, 20)
+  plant(120, 80)
+  armed = true
+  fireEvent.click(screen.getByRole('button', { name: 'Finish new pen path' }))
+  unsubscribe()
+  expect(stage).toBe(2)
+  expect(useMaskEditorStore.getState().penMode).toBe(true)
+  expect(useMaskEditorStore.getState().penVertices.map((vertex) => vertex.position)).toEqual([
+    [0.6, 2 / 3],
+    [0.65, 0.75],
+  ])
+  expect(useItemsStore.getState().items).toEqual([])
+  expect(useTimelineStore.temporal.getState().pastStates).toHaveLength(0)
+  fireEvent.click(screen.getByRole('button', { name: 'Finish new pen path' }))
+  expect(useItemsStore.getState().items).toHaveLength(1)
+  expect(useTimelineStore.temporal.getState().pastStates).toHaveLength(1)
+})
