+    fireEvent.keyDown(source, { key: 'ArrowRight' })
+    expect(source).toHaveAttribute('aria-valuenow', '35')
+    fireEvent.keyDown(source, { key: 'Home' })
+    expect(source).toHaveAttribute('aria-valuenow', '22')
+    fireEvent.keyDown(source, { key: 'End' })
+    expect(source).toHaveAttribute('aria-valuenow', '46')
+    fireEvent.keyDown(source, { key: 'Enter' })
+    expect(source).toHaveAttribute('aria-valuenow', '34')
+    fireEvent.keyDown(scopes, { key: 'ArrowRight' })
+    expect(scopes).toHaveAttribute('aria-valuenow', '31')
+    fireEvent.keyDown(scopes, { key: 'ArrowLeft', shiftKey: true })
+    expect(scopes).toHaveAttribute('aria-valuenow', '41')
+    fireEvent.keyDown(scopes, { key: 'End' })
+    fireEvent.keyDown(scopes, { key: 'ArrowLeft' })
+    expect(scopes).toHaveAttribute('aria-valuenow', '55')
+    fireEvent.keyDown(scopes, { key: 'Enter' })
+    expect(scopes).toHaveAttribute('aria-valuenow', '32')
+    act(() => useMaskEditorStore.getState().startEditing('mask-1'))
+    expect(source).toHaveAttribute('aria-disabled', 'true')
+    expect(source).toHaveAttribute('tabindex', '-1')
+    fireEvent.keyDown(source, { key: 'ArrowRight' })
+    expect(source).toHaveAttribute('aria-valuenow', '34')
+  })
+  it.each([
+    { panel: 'source', name: 'Source monitor width', expected: '60' },
+    { panel: 'scopes', name: 'Color scopes width', expected: '40' },
+  ])('owns and cleans up the $panel pointer drag', ({ panel, name, expected }) => {
+    useEditorStore.setState(
+      panel === 'source'
+        ? { sourcePreviewMediaId: 'media-1' }
+        : { workspace: 'color', colorScopesOpen: true },
+    )
+    render(<PreviewArea project={{ width: 1920, height: 1080, fps: 30 }} />)
+    const handle = screen.getByRole('separator', { name })
+    vi.spyOn(
+      screen.getByRole('region', { name: 'Preview area' }),
+      'getBoundingClientRect',
+    ).mockReturnValue({ left: 0, right: 1000, width: 1000 } as DOMRect)
+    const pointer = (target: Element | Document, type: string, id: number, clientX: number) => {
+      const event = new MouseEvent(type, { bubbles: true, button: 0, clientX })
+      Object.defineProperties(event, { pointerId: { value: id }, isPrimary: { value: true } })
+      fireEvent(target, event)
+    }
+    pointer(handle, 'pointerdown', 1, 500)
+    pointer(document, 'pointermove', 2, 700)
+    pointer(document, 'pointerup', 2, 700)
+    expect(document.body.style.cursor).toBe('col-resize')
+    pointer(document, 'pointermove', 1, 600)
+    pointer(document, 'pointercancel', 1, 600)
+    expect(handle).toHaveAttribute('aria-valuenow', expected)
+    expect(document.body.style.cursor).toBe('')
+    expect(document.body.style.userSelect).toBe('')
+    pointer(document, 'pointermove', 1, 700)
+    pointer(document, 'pointerup', 1, 700)
+    expect(handle).toHaveAttribute('aria-valuenow', expected)
+  })
+})
