+  ({ mode, target, notification, unlockInside }) => {
+    setupStores(false)
+    const { videos, audios } = makeLinkedSlideItems()
+    const primary = videos[1]!
+    const affected = target === 'primary' ? primary : audios[1]!
+    const trackId = getItem(affected.id).trackId
+    const tracks = useItemsStore.getState().tracks
+    const initialItems = useItemsStore.getState().items
+    const { result } = renderHook(() => useTimelineSlipSlide(primary, TIMELINE_DURATION))
