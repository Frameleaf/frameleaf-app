+      transform: { x: 0, y: 0, width: 100, height: 100, rotation: 0, opacity: 1 },
+    })),
+  )
+  useBentoLayoutDialogStore.getState().open(['Left', 'Right'])
+})
+afterEach(() => {
+  cleanup()
+  useBentoLayoutDialogStore.getState().close()
+})
+
+describe('FL-98 Bento keyboard alternatives', () => {
+  it('yields Space to Bento and native buttons, applies real transforms, and can undo', async () => {
+    render(
+      <>
+        <PlaybackShortcutsController />
+        <button type="button">Outside action</button>
+        <BentoLayoutDialog />
+      </>,
+    )
+    const dialog = screen.getByRole('dialog')
+    expect(fireEvent.keyDown(dialog, { key: ' ', code: 'Space' })).toBe(true)
+    fireEvent.keyUp(dialog, { key: ' ', code: 'Space' })
+    expect(usePlaybackStore.getState().isPlaying).toBe(false)
+    const later = screen.getByRole('button', { name: 'Move Left later' })
+    expect(screen.getByRole('button', { name: 'Move Left earlier' })).toBeDisabled()
+    later.focus()
+    expect(fireEvent.keyDown(later, { key: ' ', code: 'Space' })).toBe(true)
+    expect(fireEvent.keyUp(later, { key: ' ', code: 'Space' })).toBe(true)
+    expect(usePlaybackStore.getState().isPlaying).toBe(false)
+    // JSDOM has no native Space activation; perform its default only after checking it was not cancelled.
+    fireEvent.click(later)
+    await waitFor(() =>
+      expect(screen.getByRole('button', { name: 'Move Left earlier' })).toHaveFocus(),
+    )
+    expect(later).toBeDisabled()
+    expect(usePlaybackStore.getState().isPlaying).toBe(false)
+    const before = structuredClone(useItemsStore.getState().items)
+    fireEvent.click(screen.getByRole('button', { name: /^Apply/ }))
+    const [left, right] = useItemsStore.getState().items
+    expect(left?.transform?.x).toBeGreaterThan(right?.transform?.x ?? Infinity)
+    expect(useTimelineCommandStore.getState().canUndo).toBe(true)
+    useTimelineCommandStore.getState().undo()
+    expect(useItemsStore.getState().items).toEqual(before)
+
+    const outside = screen.getByRole('button', { name: 'Outside action' })
+    outside.focus()
+    expect(fireEvent.keyDown(outside, { key: ' ', code: 'Space' })).toBe(true)
+    fireEvent.keyUp(outside, { key: ' ', code: 'Space' })
+    expect(usePlaybackStore.getState().isPlaying).toBe(false)
+    outside.blur()
+    // Prove the real capture listener remains active away from controls.
+    expect(fireEvent.keyDown(document.body, { key: ' ', code: 'Space' })).toBe(false)
+    fireEvent.keyUp(document.body, { key: ' ', code: 'Space' })
+    expect(usePlaybackStore.getState().isPlaying).toBe(true)
+  })
+
+  it('labels the numeric controls and makes a saved preset removable without hover', () => {
+    useBentoPresetsStore
+      .getState()
+      .addPreset({ name: 'Saved', preset: 'row', cols: 2, rows: 1, gap: 0, padding: 0 })
+    render(<BentoLayoutDialog />)
+    expect(screen.getByRole('spinbutton', { name: 'Gap' })).toBeInTheDocument()
+    expect(screen.getByRole('spinbutton', { name: 'Padding' })).toBeInTheDocument()
+    const remove = screen.getByRole('button', { name: 'Delete Saved preset' })
+    expect(remove).toBeVisible()
+    fireEvent.click(remove)
+    expect(useBentoPresetsStore.getState().customPresets).toHaveLength(0)
+  })
+})
