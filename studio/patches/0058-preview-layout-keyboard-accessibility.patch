+import { act, fireEvent, render, screen } from '@testing-library/react'
+import { beforeEach, describe, expect, it } from 'vite-plus/test'
+import { useItemsStore, useTimelineStore, useKeyframesStore } from '../deps/timeline-store'
+import { useSelectionStore } from '@/shared/state/selection'
+import { usePlaybackStore } from '@/shared/state/playback'
+import { usePreviewBridgeStore } from '@/shared/state/preview-bridge'
+import { useGizmoStore } from '../stores/gizmo-store'
+import type { ShapeItem, TextItem } from '@/types/timeline'
+import { GizmoOverlay } from './gizmo-overlay'
+
+const SIZE = { width: 1000, height: 600 }
+const ITEMS: ShapeItem[] = [-100, 100].map((x, index) => ({
+  id: `shape-${index}`,
+  type: 'shape',
+  shapeType: 'rectangle',
+  fillColor: '#ffffff',
+  trackId: 'track',
+  from: 0,
+  durationInFrames: 90,
+  label: `Shape ${index}`,
+  transform: { x, y: 0, width: 100, height: 60, rotation: 0, opacity: 1 },
+}))
+
+function Preview() {
+  const items = useItemsStore((state) => state.items)
+  return (
+    <GizmoOverlay
+      itemsSnapshot={items}
+      containerRect={new DOMRect(0, 0, SIZE.width, SIZE.height)}
+      playerSize={SIZE}
+      projectSize={SIZE}
+      zoom={1}
+      overlayPadding={0}
+    />
+  )
+}
+
+function submit(name: string, amount: string) {
+  const input = screen.getByRole('spinbutton', { name })
+  input.focus()
+  fireEvent.change(input, { target: { value: amount } })
+  fireEvent.submit(input.closest('form')!)
+  return input
+}
+
+describe('group relative transform keyboard controls', () => {
+  beforeEach(() => {
+    useGizmoStore.getState().clearInteraction()
+    useGizmoStore.getState().clearPreview()
+    useGizmoStore.getState().setSnappingEnabled(false)
+    useTimelineStore.setState({ keyframes: [] })
+    useItemsStore.getState().setTracks([
+      {
+        id: 'track',
+        name: 'Track',
+        order: 0,
+        height: 72,
+        items: [],
+        visible: true,
+        locked: false,
+        muted: false,
+        solo: false,
+      },
+    ])
+    useItemsStore.getState().setItems(structuredClone(ITEMS))
+    usePlaybackStore.getState().setCurrentFrame(0)
+    usePreviewBridgeStore.getState().setDisplayedFrame(0)
+    useSelectionStore.getState().selectItems(ITEMS.map((item) => item.id))
+    useTimelineStore.temporal.getState().clear()
+  })
+
+  it.each(['scale', 'rotate'] as const)(
+    'commits relative %s around the group pivot in one undo step',
+    (operation) => {
+      const before = structuredClone(useItemsStore.getState().items)
+      render(<Preview />)
+      const input = submit(
+        operation === 'scale' ? 'Group scale (%)' : 'Group rotation (degrees)',
+        operation === 'scale' ? '200' : '90',
+      )
+      const after = structuredClone(useItemsStore.getState().items)
+      for (const [index, item] of after.entries()) {
+        if (operation === 'scale') {
+          expect(item.transform).toMatchObject({
+            x: index === 0 ? -200 : 200,
+            y: 0,
+            width: 200,
+            height: 120,
+            rotation: 0,
+          })
+        } else {
+          expect(item.transform?.x).toBeCloseTo(0)
+          expect(item.transform?.y).toBeCloseTo(index === 0 ? -100 : 100)
+          expect(item.transform).toMatchObject({ width: 100, height: 60, rotation: 90 })
+        }
+      }
+      expect(input).toHaveFocus()
+      expect(useGizmoStore.getState().preview).toBeNull()
+      expect(useTimelineStore.temporal.getState().pastStates).toHaveLength(1)
+      act(() => useTimelineStore.temporal.getState().undo())
+      expect(useItemsStore.getState().items).toEqual(before)
+      act(() => useTimelineStore.temporal.getState().redo())
+      expect(useItemsStore.getState().items).toEqual(after)
+    },
+  )
+
+  it('cancels typed amounts with Escape without changing geometry or history', () => {
+    render(<Preview />)
+    const before = structuredClone(useItemsStore.getState().items)
+    const input = screen.getByRole('spinbutton', { name: 'Group scale (%)' })
+    input.focus()
+    fireEvent.change(input, { target: { value: '200' } })
+    fireEvent.keyDown(input, { key: 'Escape' })
+    expect(input).toHaveValue(100)
+    expect(input).toHaveFocus()
+    expect(useItemsStore.getState().items).toEqual(before)
+    expect(useTimelineStore.temporal.getState().pastStates).toHaveLength(0)
+  })
+
+  it('treats 100 percent as no change even for items smaller than the drag minimum', () => {
+    const items = structuredClone(ITEMS)
+    for (const item of items) item.transform!.width = 10
+    useItemsStore.getState().setItems(items)
+    render(<Preview />)
+    submit('Group scale (%)', '100')
+    expect(useItemsStore.getState().items).toEqual(items)
+    expect(useTimelineStore.temporal.getState().pastStates).toHaveLength(0)
+  })
+
+  it('preserves an asymmetric group pivot and individual anchors while rotating', () => {
+    const items = structuredClone(ITEMS)
+    items[0]!.transform!.anchorX = 20
+    items[1]!.transform!.width = 200
+    items[1]!.transform!.anchorX = 30
+    useItemsStore.getState().setItems(items)
+    render(<Preview />)
+    submit('Group rotation (degrees)', '90')
+    const after = useItemsStore.getState().items
+    expect(after[0]?.transform?.x).toBeCloseTo(25)
+    expect(after[1]?.transform?.x).toBeCloseTo(25)
+    expect(after[0]?.transform?.y).toBeCloseTo(-125)
+    expect(after[1]?.transform?.y).toBeCloseTo(75)
+    expect(after[0]?.transform?.anchorX).toBe(20)
+    expect(after[1]?.transform?.anchorX).toBe(30)
+  })
+
+  it('disables inherited locked groups and rejects a captured submission after locking', () => {
+    render(<Preview />)
+    const input = screen.getByRole('spinbutton', { name: 'Group scale (%)' })
+    fireEvent.change(input, { target: { value: '200' } })
+    const before = structuredClone(useItemsStore.getState().items)
+    act(() => {
+      const track = useItemsStore.getState().tracks[0]!
+      useItemsStore.getState().setTracks([
+        { ...track, id: 'group', isGroup: true, locked: true },
+        { ...track, parentTrackId: 'group' },
+      ])
+    })
+    expect(input).toBeDisabled()
+    fireEvent.submit(input.closest('form')!)
+    expect(useItemsStore.getState().items).toEqual(before)
+    expect(useTimelineStore.getState().keyframes).toEqual([])
+    expect(useTimelineStore.temporal.getState().pastStates).toHaveLength(0)
+  })
+
+  it.each(['Resize from top-left corner', 'Rotate selected element', 'Move selected element'])(
+    'cancels %s and ignores later move/release events',
+    (name) => {
+      render(<Preview />)
+      const before = structuredClone(useItemsStore.getState().items)
+      fireEvent.mouseDown(screen.getByRole('button', { name }), { clientX: 350, clientY: 270 })
+      fireEvent.mouseMove(window, { clientX: 200, clientY: 200 })
+      expect(useGizmoStore.getState().preview).not.toBeNull()
+      fireEvent.keyDown(window, { key: 'Escape' })
+      expect(useGizmoStore.getState().preview).toBeNull()
+      fireEvent.mouseMove(window, { clientX: 100, clientY: 100 })
+      fireEvent.mouseUp(window, { clientX: 100, clientY: 100 })
+      expect(useGizmoStore.getState().preview).toBeNull()
+      expect(useItemsStore.getState().items).toEqual(before)
+      expect(useTimelineStore.temporal.getState().pastStates).toHaveLength(0)
+    },
+  )
+
+  it('cleans up an active gesture on unmount', () => {
+    const view = render(<Preview />)
+    fireEvent.mouseDown(screen.getByRole('button', { name: 'Resize from top-left corner' }), {
+      clientX: 350,
+      clientY: 270,
+    })
+    fireEvent.mouseMove(window, { clientX: 200, clientY: 200 })
+    view.unmount()
+    fireEvent.mouseMove(window, { clientX: 100, clientY: 100 })
+    fireEvent.mouseUp(window, { clientX: 100, clientY: 100 })
+    expect(useGizmoStore.getState().preview).toBeNull()
+    expect(useItemsStore.getState().items).toEqual(ITEMS)
+    expect(useTimelineStore.temporal.getState().pastStates).toHaveLength(0)
+  })
+
+  it.each(
+    ['Resize from top-left corner', 'Rotate selected element', 'Move selected element'].flatMap(
+      (handle) => ['lock', 'remove', 'unlock-before-release'].map((change) => ({ handle, change })),
+    ),
+  )('finally cancels $handle when three members become two: $change', ({ handle, change }) => {
+    const items = [
+      ...structuredClone(ITEMS),
+      {
+        ...structuredClone(ITEMS[0]!),
+        id: 'shape-2',
+        transform: { ...ITEMS[0]!.transform, x: 250, y: 80 },
+      },
+    ].map((item, index) => ({ ...item, trackId: `track-${index}` }))
+    const track = useItemsStore.getState().tracks[0]!
+    const tracks = items.map((item, index) => ({ ...track, id: item.trackId, order: index }))
+    useItemsStore.getState().setTracks(tracks)
+    useItemsStore.getState().setItems(items)
+    useSelectionStore.getState().selectItems(items.map((item) => item.id))
+    render(<Preview />)
+    const controls = screen.getByRole('group', { name: 'Group relative transforms' })
+    fireEvent.mouseDown(screen.getByRole('button', { name: handle }), {
+      clientX: 350,
+      clientY: 270,
+    })
+    fireEvent.mouseMove(window, { clientX: 200, clientY: 200 })
+    expect(Object.keys(useGizmoStore.getState().preview!)).toHaveLength(3)
+    act(() => {
+      if (change === 'remove')
+        useItemsStore.getState().setItems(items.filter((item) => item.id !== 'shape-1'))
+      else
+        useItemsStore
+          .getState()
+          .setTracks(tracks.map((entry) => ({ ...entry, locked: entry.id === 'track-1' })))
+    })
+    // Both surviving members retain the same GroupGizmo, rather than unmounting it.
+    expect(screen.getByRole('group', { name: 'Group relative transforms' })).toBe(controls)
+    expect(useGizmoStore.getState().preview).toBeNull()
+    fireEvent.mouseMove(window, { clientX: 150, clientY: 150 })
+    expect(useGizmoStore.getState().preview).toBeNull()
+    if (change === 'unlock-before-release') act(() => useItemsStore.getState().setTracks(tracks))
+    fireEvent.mouseMove(window, { clientX: 100, clientY: 100 })
+    fireEvent.mouseUp(window, { clientX: 100, clientY: 100 })
+    expect(useGizmoStore.getState().preview).toBeNull()
+    expect(useItemsStore.getState().items).toEqual(
+      change === 'remove' ? items.filter((item) => item.id !== 'shape-1') : items,
+    )
+    expect(useTimelineStore.temporal.getState().pastStates).toHaveLength(0)
+    if (change === 'unlock-before-release') {
+      submit('Group scale (%)', '200')
+      expect(useTimelineStore.temporal.getState().pastStates).toHaveLength(1)
+      act(() => useTimelineStore.temporal.getState().undo())
+      expect(useItemsStore.getState().items).toEqual(items)
+    }
+  })
+
+  it.each(['selection', 'lock-unlock', 'link-unlink'] as const)(
+    'invalidates the original gesture membership/policy permanently: %s',
+    (change) => {
+      const items = [
+        ...structuredClone(ITEMS),
+        {
+          ...structuredClone(ITEMS[0]!),
+          id: 'shape-2',
+          transform: { ...ITEMS[0]!.transform, x: 250, y: 80 },
+        },
+      ]
+      useItemsStore.getState().setItems(items)
+      useSelectionStore.getState().selectItems(items.map((item) => item.id))
+      render(<Preview />)
+      const controls = screen.getByRole('group', { name: 'Group relative transforms' })
+      fireEvent.mouseDown(screen.getByRole('button', { name: 'Resize from top-left corner' }), {
+        clientX: 350,
+        clientY: 270,
+      })
+      fireEvent.mouseMove(window, { clientX: 200, clientY: 200 })
+      act(() => {
+        if (change === 'selection') useSelectionStore.getState().selectItems(['shape-0', 'shape-2'])
+        else if (change === 'lock-unlock') {
+          const tracks = useItemsStore.getState().tracks
+          useItemsStore.getState().setTracks(tracks.map((track) => ({ ...track, locked: true })))
+          useItemsStore.getState().setTracks(tracks)
+        } else {
+          useKeyframesStore.getState().setKeyframes([
+            {
+              itemId: 'shape-1',
+              properties: [],
+              propertyLinks: [
+                {
+                  type: 'link',
+                  targetProperty: 'position',
+                  sourceItemId: 'shape-0',
+                  sourceProperty: 'position',
+                  enabled: true,
+                  timeOffsetFrames: 0,
+                },
+              ],
+            },
+          ])
+          useKeyframesStore.getState().setKeyframes([])
+        }
+      })
+      expect(screen.getByRole('group', { name: 'Group relative transforms' })).toBe(controls)
+      expect(useGizmoStore.getState().preview).toBeNull()
+      fireEvent.mouseMove(window, { clientX: 100, clientY: 100 })
+      fireEvent.mouseUp(window, { clientX: 100, clientY: 100 })
+      expect(useItemsStore.getState().items).toEqual(items)
+      expect(useTimelineStore.temporal.getState().pastStates).toHaveLength(0)
+    },
+  )
+
+  it.each(['lock', 'remove', 'link'] as const)(
+    'refuses the entire commit when an item changes at start: %s',
+    (change) => {
+      render(<Preview />)
+      act(() => usePlaybackStore.getState().setPreviewFrame(5))
+      const unsubscribe = usePlaybackStore.subscribe((state) => {
+        if (state.currentFrame !== 5) return
+        if (change === 'lock') {
+          const track = useItemsStore.getState().tracks[0]!
+          useItemsStore.getState().setTracks([{ ...track, locked: true }])
+        } else if (change === 'remove') {
+          useItemsStore.getState().setItems([structuredClone(ITEMS[0]!)])
+        } else {
+          useKeyframesStore.getState().setKeyframes([
+            {
+              itemId: ITEMS[0]!.id,
+              properties: [],
+              propertyLinks: [
+                {
+                  type: 'link',
+                  targetProperty: 'position',
+                  sourceItemId: ITEMS[1]!.id,
+                  sourceProperty: 'position',
+                  enabled: true,
+                  timeOffsetFrames: 0,
+                },
+              ],
+            },
+          ])
+        }
+      })
+      submit('Group scale (%)', '200')
+      unsubscribe()
+      expect(useItemsStore.getState().items).toEqual(change === 'remove' ? [ITEMS[0]] : ITEMS)
+      expect(useTimelineStore.temporal.getState().pastStates).toHaveLength(0)
+    },
+  )
+
+  it('scales text style through the existing batch and restores it with undo', () => {
+    const text: TextItem = {
+      ...ITEMS[1]!,
+      type: 'text',
+      text: 'Title',
+      color: '#ffffff',
+      fontSize: 20,
+      letterSpacing: 2,
+      textPadding: 4,
+      backgroundRadius: 3,
+    }
+    useItemsStore.getState().setItems([structuredClone(ITEMS[0]!), text])
+    const before = structuredClone(useItemsStore.getState().items)
+    render(<Preview />)
+    submit('Group scale (%)', '200')
+    const after = structuredClone(useItemsStore.getState().items)
+    expect(after[1]).toMatchObject({
+      fontSize: 40,
+      letterSpacing: 4,
+      textPadding: 8,
+      backgroundRadius: 6,
+    })
+    expect(useTimelineStore.temporal.getState().pastStates).toHaveLength(1)
+    act(() => useTimelineStore.temporal.getState().undo())
+    expect(useItemsStore.getState().items).toEqual(before)
+    act(() => useTimelineStore.temporal.getState().redo())
+    expect(useItemsStore.getState().items).toEqual(after)
+  })
+
+  it('commits keyed rotation and unkeyed geometry together in one history entry', () => {
+    useKeyframesStore.getState().setKeyframes([
+      {
+        itemId: ITEMS[0]!.id,
+        properties: [
+          {
+            property: 'rotation',
+            keyframes: [{ id: 'rotation', frame: 0, value: 0, easing: 'linear' }],
+          },
+        ],
+      },
+    ])
+    useTimelineStore.temporal.getState().clear()
+    const before = structuredClone(useTimelineStore.getState().keyframes)
+    render(<Preview />)
+    submit('Group rotation (degrees)', '90')
+    const after = structuredClone(useTimelineStore.getState().keyframes)
+    expect(after[0]?.properties[0]?.keyframes[0]?.value).toBe(90)
+    expect(useItemsStore.getState().items[1]?.transform?.rotation).toBe(90)
+    expect(useTimelineStore.temporal.getState().pastStates).toHaveLength(1)
+    act(() => useTimelineStore.temporal.getState().undo())
+    expect(useTimelineStore.getState().keyframes).toEqual(before)
+    expect(useItemsStore.getState().items).toEqual(ITEMS)
+    act(() => useTimelineStore.temporal.getState().redo())
+    expect(useTimelineStore.getState().keyframes).toEqual(after)
