+      result.current.startSlipSlidePreview(mode)
+      result.current.updateSlipSlidePreview(5)
+      result.current.commitSlipSlidePreview()
+    })
+    expect(useTimelineCommandStore.getState().undoStack).toHaveLength(1)
+    expectNoEditPreview()
+  },
