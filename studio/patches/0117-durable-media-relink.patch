+/** Keep navigation structure intact while undoing source changes in held Main/parent timelines. */
+function sourceField(key: string): boolean {
+  return (
+    key === 'mediaId' ||
+    key.startsWith('source') ||
+    key.startsWith('reverseConform') ||
+    [
+      'src',
+      'audioSrc',
+      'thumbnailUrl',
+      'waveformData',
+      'transcriptCaptions',
+      'frameRate',
+      'totalFrames',
+    ].includes(key)
+  )
+}
+
+function navigationMediaSources(): Record<string, Record<string, unknown>> {
+  const nav = useCompositionNavigationStore.getState()
+  const items = [nav.mainHolder, ...nav.stashStack].flatMap((holder) => holder?.items ?? [])
+  return Object.fromEntries(
+    items
+      .filter((item) => item.mediaId)
+      .map((item) => [
+        item.id,
+        Object.fromEntries(Object.entries(item).filter(([key]) => sourceField(key))),
+      ]),
+  )
+}
+
+function restoreNavigationMediaSources(sources: TimelineSnapshot['navigationMediaSources']): void {
+  if (!sources) return
+  const restoreItems = (items: TimelineItem[]) =>
+    items.map((item) => {
+      const source = sources[item.id]
+      if (!source) return item
+      return {
+        ...Object.fromEntries(Object.entries(item).filter(([key]) => !sourceField(key))),
+        ...source,
+      } as unknown as TimelineItem
+    })
+  useCompositionNavigationStore.setState((nav) => ({
+    mainHolder: nav.mainHolder
+      ? { ...nav.mainHolder, items: restoreItems(nav.mainHolder.items) }
+      : null,
+    stashStack: nav.stashStack.map((holder) => ({ ...holder, items: restoreItems(holder.items) })),
+  }))
+}
