+import { useEffect, useRef, useState } from 'react'
+import { useTranslation } from 'react-i18next'
+import { AudioLines } from 'lucide-react'
+import { Button } from '@/components/ui/button'
+import {
+  useItemsStore,
+  useTimelineStore,
+  useCompositionsStore,
+  useCompositionNavigationStore,
+} from '@/features/editor/deps/timeline-store'
+import { usePlaybackStore } from '@/shared/state/playback'
+import { PropertySection } from './components'
+import {
+  applyVoiceMusicMix,
+  auditionVoiceMusicMix,
+  captureVoiceMixState,
+  reviewVoiceMusicMix,
+  voiceMixBinding,
+  VoiceMixError,
+  type VoiceMixPlan,
+  type VoiceMixSettings,
+} from '../../utils/voice-music-mix'
+
+export function VoiceMusicPanel() {
+  const { t } = useTranslation()
+  const tracks = useItemsStore((state) => state.tracks)
+  // Bind the review to the complete current graph, including nested sources and automation.
+  useTimelineStore((state) => state.items)
+  useTimelineStore((state) => state.keyframes)
+  useTimelineStore((state) => state.transitions)
+  useTimelineStore((state) => state.fps)
+  useCompositionsStore((state) => state.compositions)
+  useCompositionNavigationStore((state) => state.activeCompositionId)
+  usePlaybackStore((state) => state.busAudioEq)
+  usePlaybackStore((state) => state.masterLoudness)
+  usePlaybackStore((state) => state.masterGainEnvelope)
+  usePlaybackStore((state) => state.masterBusDb)
+  usePlaybackStore((state) => state.masterBusMuted)
+  const binding = voiceMixBinding(captureVoiceMixState())
+  const [settings, setSettings] = useState<VoiceMixSettings>({
+    dialogueTrackIds: [],
+    musicTrackIds: [],
+    duckDb: -12,
+    targetLufs: -16,
+    attackSec: 0.08,
+    releaseSec: 0.25,
+  })
+  const [plan, setPlan] = useState<VoiceMixPlan | null>(null)
+  const [busy, setBusy] = useState(false)
+  const [feedback, setFeedback] = useState('')
+  const controller = useRef<AbortController | null>(null)
+  const sound = useRef<AudioBufferSourceNode | null>(null)
+  const context = useRef<AudioContext | null>(null)
+  const stop = () => {
+    controller.current?.abort()
+    controller.current = null
+    sound.current?.stop()
+    sound.current = null
+    void context.current?.close().catch(() => {})
+    context.current = null
+  }
+  useEffect(() => () => stop(), [binding])
+  if (plan && plan.binding !== binding) {
+    setBusy(false)
+    setPlan(null)
+    setFeedback(t('voiceMix.stale'))
+  }
+  const update = (change: Partial<VoiceMixSettings>) => {
+    stop()
+    setBusy(false)
+    setPlan(null)
+    setFeedback('')
+    setSettings((previous) => ({ ...previous, ...change }))
+  }
+  const errorText = (error: unknown) =>
+    t(`voiceMix.${error instanceof VoiceMixError ? error.message : 'failed'}`)
+  const review = async () => {
+    stop()
+    const request = new AbortController()
+    controller.current = request
+    setBusy(true)
+    setFeedback('')
+    try {
+      const result = await reviewVoiceMusicMix(captureVoiceMixState(), settings, request.signal)
+      if (!request.signal.aborted) setPlan(result)
+    } catch (error) {
+      if (!request.signal.aborted) setFeedback(errorText(error))
+    } finally {
+      if (!request.signal.aborted) setBusy(false)
+    }
+  }
+  const audition = async () => {
+    if (!plan) return
+    stop()
+    usePlaybackStore.getState().pause()
+    const request = new AbortController()
+    controller.current = request
+    setBusy(true)
+    setFeedback(t('voiceMix.preparing'))
+    try {
+      const audioContext = new AudioContext()
+      context.current = audioContext
+      await audioContext.resume()
+      const audio = await auditionVoiceMusicMix(plan, request.signal)
+      if (request.signal.aborted) return
+      if (!audio) throw new VoiceMixError('noAudio')
+      const buffer = audioContext.createBuffer(
+        audio.channels,
+        audio.samples[0]!.length,
+        audio.sampleRate,
+      )
+      audio.samples.forEach((samples, channel) => buffer.getChannelData(channel).set(samples))
+      const source = audioContext.createBufferSource()
+      source.buffer = buffer
+      const monitor = audioContext.createGain()
+      const playback = usePlaybackStore.getState()
+      monitor.gain.value = playback.muted ? 0 : playback.volume
+      source.connect(monitor)
+      monitor.connect(audioContext.destination)
+      sound.current = source
+      source.onended = () => {
+        if (!request.signal.aborted) {
+          setBusy(false)
+          setFeedback(t('voiceMix.finished'))
+        }
+      }
+      source.start()
+      setFeedback(t('voiceMix.playing'))
+    } catch (error) {
+      if (!request.signal.aborted) {
+        setFeedback(errorText(error))
+        setBusy(false)
+        stop()
+      }
+    }
+  }
+  return (
+    <PropertySection title={t('voiceMix.title')} icon={AudioLines} defaultOpen={false}>
+      <section aria-label={t('voiceMix.title')} className="space-y-3 text-xs">
+        <p className="text-muted-foreground">{t('voiceMix.note')}</p>
+        <p className="text-muted-foreground">{t('voiceMix.range')}</p>
+        {(['dialogueTrackIds', 'musicTrackIds'] as const).map((role) => (
+          <fieldset key={role} className="space-y-1">
+            <legend className="font-medium">{t(`voiceMix.${role}`)}</legend>
+            {tracks
+              .filter((track) => !track.isGroup)
+              .map((track) => (
+                <label key={track.id} className="flex gap-2 items-center">
+                  <input
+                    type="checkbox"
+                    checked={settings[role].includes(track.id)}
+                    onChange={(event) =>
+                      update({
+                        [role]: event.target.checked
+                          ? [...settings[role], track.id]
+                          : settings[role].filter((id) => id !== track.id),
+                      })
+                    }
+                  />
+                  {track.name}
+                </label>
+              ))}
+          </fieldset>
+        ))}
+        {(
+          [
+            { key: 'targetLufs', min: -36, max: -6, step: 1 },
+            { key: 'duckDb', min: -36, max: -1, step: 1 },
+            { key: 'attackSec', min: 0, max: 2, step: 0.01 },
+            { key: 'releaseSec', min: 0, max: 5, step: 0.01 },
+          ] as const
+        ).map(({ key, ...range }) => (
+          <label key={key} className="flex justify-between gap-2 items-center">
+            {t(`voiceMix.${key}`)}
+            <input
+              type="number"
+              {...range}
+              value={Number.isFinite(settings[key]) ? settings[key] : ''}
+              onChange={(event) =>
+                update({ [key]: event.target.value === '' ? NaN : Number(event.target.value) })
+              }
+              className="w-20 rounded border p-1 bg-background"
+            />
+          </label>
+        ))}
+        {plan && (
+          <div className="space-y-2" aria-label={t('voiceMix.review')}>
+            <p>
+              {t('voiceMix.duckChange', {
+                db: settings.duckDb,
+                attack: settings.attackSec,
+                release: settings.releaseSec,
+              })}
+            </p>
+            <ul>
+              {plan.changes.map((change) => (
+                <li key={change.id}>
+                  {t('voiceMix.change', {
+                    label: change.label,
+                    lufs: change.measuredLufs.toFixed(1),
+                    before: change.beforeGain.toFixed(1),
+                    after: change.afterGain.toFixed(1),
+                    gain: change.gainDb.toFixed(1),
+                  })}
+                </li>
+              ))}
+            </ul>
+            <p className="text-muted-foreground">{t('voiceMix.preserved')}</p>
+          </div>
+        )}
+        <div className="flex flex-wrap gap-2">
+          <Button size="sm" disabled={busy} onClick={() => void review()}>
+            {t('voiceMix.review')}
+          </Button>
+          <Button size="sm" disabled={busy || !plan} onClick={() => void audition()}>
+            {t('voiceMix.audition')}
+          </Button>
+          <Button
+            size="sm"
+            disabled={busy || !plan || plan.binding !== binding}
+            onClick={() => {
+              try {
+                if (plan) applyVoiceMusicMix(plan)
+                setPlan(null)
+                setFeedback(t('voiceMix.applied'))
+              } catch (error) {
+                setFeedback(errorText(error))
+              }
+            }}
+          >
+            {t('voiceMix.apply')}
+          </Button>
+          {busy && (
+            <Button
+              size="sm"
+              variant="outline"
+              onClick={() => {
+                stop()
+                setBusy(false)
+                setFeedback(t('voiceMix.cancelled'))
+              }}
+            >
+              {t('voiceMix.cancel')}
+            </Button>
+          )}
+        </div>
+        <p role="status">{feedback}</p>
+      </section>
+    </PropertySection>
+  )
+}
