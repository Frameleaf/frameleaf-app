diff --git a/src/features/editor/utils/voice-music-mix.ts b/src/features/editor/utils/voice-music-mix.ts
new file mode 100644
--- /dev/null
+++ b/src/features/editor/utils/voice-music-mix.ts
@@ -0,0 +1,294 @@
+import type { TimelineItem, AudioItem } from '@/types/timeline'
+import type { LoudnessMeasurement } from '@/shared/utils/loudness'
+import { measureLoudnessInWorker } from '@/shared/utils/loudness'
+import { resolveEffectiveTrackStates } from '@/shared/utils/subtitle-sidecar.mjs'
+import {
+  getLinkedAudioCompanion,
+  getLinkedCompositionAudioCompanion,
+} from '@/shared/utils/linked-media'
+import { clampAudioEqGainDb } from '@/shared/utils/audio-eq'
+import { usePlaybackStore } from '@/shared/state/playback'
+import {
+  useItemsStore,
+  useKeyframesStore,
+  useCompositionsStore,
+  useCompositionNavigationStore,
+  useTimelineSettingsStore,
+  useTimelineStore,
+  executeTimelineCommand,
+  suggestLoudnessMatch,
+  loudnessBinding,
+} from '../deps/timeline-store'
+import { loadVoiceMixRenderer } from '../deps/export-contract'
+
+export interface VoiceMixSettings {
+  dialogueTrackIds: string[]
+  musicTrackIds: string[]
+  duckDb: number
+  targetLufs: number
+  attackSec: number
+  releaseSec: number
+}
+export type VoiceMixState = ReturnType<typeof captureVoiceMixState>
+export interface VoiceMixPlan {
+  binding: string
+  settings: VoiceMixSettings
+  changes: {
+    id: string
+    label: string
+    measuredLufs: number
+    gainDb: number
+    beforeGain: number
+    afterGain: number
+  }[]
+  items: TimelineItem[]
+}
+export class VoiceMixError extends Error {}
+function refuse(key: string): never {
+  throw new VoiceMixError(key)
+}
+
+export function captureVoiceMixState() {
+  const { items, tracks } = useItemsStore.getState()
+  const activeId = useCompositionNavigationStore.getState().activeCompositionId
+  const composition = activeId
+    ? useCompositionsStore.getState().getComposition(activeId)
+    : undefined
+  const playback = usePlaybackStore.getState()
+  return {
+    items,
+    tracks,
+    keyframes: useKeyframesStore.getState().keyframes,
+    transitions: useTimelineStore.getState().transitions,
+    compositions: useCompositionsStore.getState().compositions,
+    fps: composition?.fps ?? useTimelineSettingsStore.getState().fps,
+    activeId,
+    duration:
+      composition?.durationInFrames ??
+      items.reduce((end, item) => Math.max(end, item.from + item.durationInFrames), 0),
+    busAudioEq: composition?.busAudioEq ?? playback.busAudioEq,
+    masterBusDb: playback.masterBusDb,
+    masterBusMuted: playback.masterBusMuted,
+    masterGainEnvelope: playback.masterGainEnvelope,
+    masterLoudness: playback.masterLoudness,
+  }
+}
+export const voiceMixBinding = (state: VoiceMixState) => JSON.stringify(state)
+
+export function voiceMixParticipants(state: VoiceMixState, settings: VoiceMixSettings) {
+  if (!settings.dialogueTrackIds.length || !settings.musicTrackIds.length) refuse('selectTracks')
+  if (settings.dialogueTrackIds.some((id) => settings.musicTrackIds.includes(id)))
+    refuse('separateTracks')
+  if (
+    ![settings.duckDb, settings.targetLufs, settings.attackSec, settings.releaseSec].every(
+      Number.isFinite,
+    ) ||
+    settings.duckDb < -36 ||
+    settings.duckDb >= 0 ||
+    settings.targetLufs < -36 ||
+    settings.targetLufs > -6 ||
+    settings.attackSec < 0 ||
+    settings.attackSec > 2 ||
+    settings.releaseSec < 0 ||
+    settings.releaseSec > 5 ||
+    !Number.isFinite(state.fps) ||
+    state.fps <= 0 ||
+    !Number.isSafeInteger(state.duration) ||
+    state.duration <= 0
+  )
+    refuse('invalidSettings')
+  const effective = resolveEffectiveTrackStates(state.tracks)
+  // shortcut: export ignores solo, allow solo review when preview/export share audible-track resolution.
+  if (effective.some((track) => track.solo)) refuse('solo')
+  const resolve = (ids: string[]) => {
+    for (const id of ids) {
+      const track = effective.find((candidate) => candidate.id === id)
+      if (!track || track.muted || track.visible === false) refuse('inaudible')
+      if (track.locked) refuse('locked')
+    }
+    const selected = new Map<string, TimelineItem>()
+    for (const item of state.items.filter((candidate) => ids.includes(candidate.trackId))) {
+      if (!['audio', 'video', 'composition'].includes(item.type) || item.muted) continue
+      const audible =
+        item.type === 'video'
+          ? (getLinkedAudioCompanion(state.items, item) ?? (item.embeddedAudioMuted ? null : item))
+          : item.type === 'composition'
+            ? (getLinkedCompositionAudioCompanion(state.items, item) ?? item)
+            : item
+      if (!audible || audible.muted) continue
+      const track = effective.find((candidate) => candidate.id === audible.trackId)
+      if (!track || track.muted || track.visible === false) refuse('inaudible')
+      if (
+        track.locked ||
+        (item.linkedGroupId &&
+          state.items.some(
+            (linked) =>
+              linked.linkedGroupId === item.linkedGroupId &&
+              effective.find((t) => t.id === linked.trackId)?.locked,
+          ))
+      )
+        refuse('locked')
+      const visit = (id: string, seen = new Set<string>()) => {
+        if (seen.has(id)) refuse('noAudio')
+        const nested = state.compositions.find((candidate) => candidate.id === id)
+        if (!nested) refuse('noAudio')
+        const nestedTracks = resolveEffectiveTrackStates(nested.tracks)
+        if (nestedTracks.some((track) => track.solo)) refuse('solo')
+        if (nestedTracks.some((track) => track.locked)) refuse('locked')
+        for (const child of nested.items)
+          if (child.compositionId) visit(child.compositionId, new Set([...seen, id]))
+      }
+      if (audible.compositionId) visit(audible.compositionId)
+      selected.set(audible.id, audible)
+    }
+    if (!selected.size) refuse('noAudio')
+    return [...selected.values()]
+  }
+  const dialogue = resolve(settings.dialogueTrackIds)
+  const music = resolve(settings.musicTrackIds)
+  if (dialogue.some((item) => music.some((other) => item.id === other.id))) refuse('separateTracks')
+  return { dialogue, music, musicTrackIds: [...new Set(music.map((item) => item.trackId))] }
+}
+
+async function renderVoiceMix(
+  state: VoiceMixState,
+  items: TimelineItem[],
+  signal?: AbortSignal,
+  analysis = false,
+  window?: { from: number; end: number },
+) {
+  const renderer = await loadVoiceMixRenderer()
+  const composition = renderer.build(
+    structuredClone(state.tracks),
+    structuredClone(items),
+    structuredClone(state.transitions),
+    state.fps,
+    1920,
+    1080,
+    window?.from ?? null,
+    window ? window.end - 1 : null,
+    structuredClone(state.keyframes),
+    undefined,
+    structuredClone(state.busAudioEq),
+    analysis ? 0 : state.masterBusDb,
+    analysis ? false : state.masterBusMuted,
+    analysis ? [] : [...(state.masterGainEnvelope ?? [])],
+    analysis ? undefined : (state.masterLoudness ?? undefined),
+  )
+  // Active sequences may have authored blank tail after the final source.
+  if (!window) composition.durationInFrames = state.duration
+  return renderer.render(composition, signal)
+}
+
+export async function reviewVoiceMusicMix(
+  state: VoiceMixState,
+  settings: VoiceMixSettings,
+  signal?: AbortSignal,
+): Promise<VoiceMixPlan> {
+  const { dialogue, musicTrackIds } = voiceMixParticipants(state, settings)
+  const changes: VoiceMixPlan['changes'] = []
+  const replacements = new Map<string, TimelineItem>()
+  for (const item of dialogue) {
+    if (signal?.aborted) throw new DOMException('Cancelled', 'AbortError')
+    // EQ bypass or animated output trim cannot safely receive a static additive match.
+    if (
+      item.audioEqEnabled === false ||
+      state.keyframes.some(
+        (entry) =>
+          entry.itemId === item.id && JSON.stringify(entry).includes('audioEqOutputGainDb'),
+      )
+    )
+      refuse('outputGain')
+    const audio = await renderVoiceMix(state, [item], signal, true, {
+      from: Math.max(0, item.from),
+      end: Math.min(state.duration, item.from + item.durationInFrames),
+    })
+    if (!audio) refuse('noAudio')
+    const measured = await measureLoudnessInWorker(
+      { sampleRate: audio.sampleRate, channels: audio.samples },
+      signal,
+    )
+    const change = voiceMixLoudnessChange(item, measured, settings.targetLufs)
+    changes.push(change)
+    replacements.set(item.id, {
+      ...item,
+      audioEqOutputGainDb: change.afterGain,
+      audioDucking: {
+        duckOthersDb: settings.duckDb,
+        attackSec: settings.attackSec,
+        releaseSec: settings.releaseSec,
+        targetTrackIds: musicTrackIds,
+      },
+    })
+  }
+  return {
+    binding: voiceMixBinding(state),
+    settings: structuredClone(settings),
+    changes,
+    items: state.items.map((item) => replacements.get(item.id) ?? item),
+  }
+}
+
+export function voiceMixLoudnessChange(
+  item: TimelineItem,
+  measurement: LoudnessMeasurement,
+  targetLufs: number,
+) {
+  if (measurement.integratedLufs == null || !Number.isFinite(measurement.integratedLufs))
+    refuse('silent')
+  const beforeGain = item.audioEqOutputGainDb ?? 0
+  if (
+    !Number.isFinite(beforeGain) ||
+    (measurement.truePeakDbtp != null && !Number.isFinite(measurement.truePeakDbtp))
+  )
+    refuse('invalidSettings')
+  // Reuse the matcher's boost cap; true-peak headroom also limits the reviewed boost.
+  const audible = { ...item, type: 'audio', volume: 0 } as AudioItem
+  const suggestion = suggestLoudnessMatch(
+    audible,
+    { itemId: item.id, label: item.label, binding: loudnessBinding(audible), measurement },
+    targetLufs,
+    -1,
+  )!
+  const gain = Math.min(
+    suggestion.gainDb,
+    measurement.truePeakDbtp == null ? 0 : -1 - measurement.truePeakDbtp,
+  )
+  const afterGain = Math.floor(clampAudioEqGainDb(beforeGain + gain) * 10) / 10
+  return {
+    id: item.id,
+    label: item.label,
+    measuredLufs: measurement.integratedLufs,
+    gainDb: afterGain - beforeGain,
+    beforeGain,
+    afterGain,
+  }
+}
+
+export function applyVoiceMusicMix(plan: VoiceMixPlan): void {
+  const state = captureVoiceMixState()
+  if (voiceMixBinding(state) !== plan.binding) refuse('stale')
+  voiceMixParticipants(state, plan.settings)
+  executeTimelineCommand('APPLY_VOICE_MUSIC_MIX', () => {
+    const store = useItemsStore.getState()
+    for (const change of plan.changes) {
+      const item = plan.items.find((candidate) => candidate.id === change.id)!
+      store._updateItem(item.id, {
+        audioEqOutputGainDb: item.audioEqOutputGainDb,
+        audioDucking: item.audioDucking,
+      })
+    }
+    useTimelineSettingsStore.getState().markDirty()
+  })
+}
+
+/** Render a detached candidate; cancellation never needs to restore a mutated timeline. */
+export async function auditionVoiceMusicMix(plan: VoiceMixPlan, signal: AbortSignal) {
+  const state = captureVoiceMixState()
+  if (voiceMixBinding(state) !== plan.binding) refuse('stale')
+  const from = Math.max(0, Math.min(state.duration - 1, usePlaybackStore.getState().currentFrame))
+  return renderVoiceMix(state, plan.items, signal, false, {
+    from,
+    end: Math.min(state.duration, from + Math.round(state.fps * 15)),
+  })
+}
