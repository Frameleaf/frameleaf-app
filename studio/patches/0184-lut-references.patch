+afterEach(() => {
+  clearLutReferences()
+  blobUrlManager.releaseAll()
+  useCompositionsStore.setState({ compositionById: {} })
+  vi.unstubAllGlobals()
+})
+
+describe('LUT references before a render (FL-1558)', () => {
+  it('names the LUTs of the composition and of every sub-composition it reaches', () => {
+    useCompositionsStore.setState({
+      compositionById: {
+        inner: { id: 'inner', items: [graded('nested', 'b')], tracks: [] },
+        unused: { id: 'unused', items: [graded('elsewhere', 'c')], tracks: [] },
+      } as never,
+    })
+    const wrapper = { id: 'w', type: 'composition', compositionId: 'inner', trackId: 't' } as never
+    expect(compositionLutReferenceIds({ tracks: [track([graded('top', 'a'), wrapper])] })).toEqual([
+      'a',
+      'b',
+    ])
+  })
+
+  it('refuses an export whose LUT cannot be read, and lets a thumbnail render ungraded', async () => {
+    const composition = { tracks: [track([graded('top', 'missing')])] }
+    await expect(loadCompositionLutReferences(composition, { strict: true })).rejects.toThrow(
+      'LUT_REFERENCE_UNAVAILABLE',
+    )
+    await expect(
+      loadCompositionLutReferences(composition, { strict: false }),
+    ).resolves.toBeUndefined()
+  })
+
+  it('reads every referenced file before the first frame', async () => {
+    const text = 'LUT_1D_SIZE 2\n0 0 0\n1 1 1\n'
