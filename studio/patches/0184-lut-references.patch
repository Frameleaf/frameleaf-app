+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+import { blobUrlManager } from '@/infrastructure/browser/blob-url-manager'
+import type { ItemEffect } from '@/types/effects'
+import {
+  LUT_REFERENCE_UNAVAILABLE,
+  clearLutReferences,
+  collectLutReferenceIds,
+  getLutReferencesVersion,
+  getProjectLutKeeper,
+  installProjectLutKeeper,
+  loadLutReference,
+  loadLutReferences,
+  lutReferenceId,
+  materializeLutFile,
+  mergeGpuEffectParams,
+  peekLutReference,
+  resolveLutReferenceEffect,
+  setLutReference,
+} from './lut-references'
+
+const grid = `TITLE "Teal"\nLUT_3D_SIZE 2\n${'0.5 0.25 1\n'.repeat(8)}`
+const table = 'LUT_1D_SIZE 2\n0 0 0\n1 1 1\n'
+const reference = (id: string) => ({
+  intensity: 0.75,
+  lutName: 'Teal',
+  lutSize: '0',
+  lutData: '',
+  lutId: id,
+  lutSource: 'import',
+})
+const gpu = (params: Record<string, string | number>, enabled = true): ItemEffect => ({
+  id: `fx-${String(params.lutId ?? 'inline')}`,
+  enabled,
+  effect: { type: 'gpu-effect', gpuEffectType: 'gpu-lut', params },
+})
+
+beforeEach(() => clearLutReferences())
+afterEach(() => {
+  vi.unstubAllGlobals()
+  blobUrlManager.releaseAll()
+})
+
+describe('LUT references (FL-1558)', () => {
+  it('names a LUT kept with the project only with an import id', () => {
+    expect(lutReferenceId(reference('a'))).toBe('a')
+    expect(lutReferenceId({ lutId: 'a' })).toBeNull()
+    expect(lutReferenceId({ lutId: '', lutSource: 'import' })).toBeNull()
+    expect(lutReferenceId({ lutData: 'AAAA', lutSize: '2' })).toBeNull()
+  })
+
+  it('materialises a 3D file as gpu-file-lut-v1 and a 1D file as gpu-file-lut-1d-v1', () => {
+    expect(materializeLutFile(grid, 'x.cube')).toMatchObject({
+      type: 'gpu-file-lut-v1',
+      name: 'Teal',
+      dimensions: 3,
+      size: 2,
+    })
+    expect(materializeLutFile(table, 'Lift.CUBE')).toMatchObject({
+      type: 'gpu-file-lut-1d-v1',
+      name: 'Lift',
+      dimensions: 1,
+    })
+    expect(() => materializeLutFile('LUT_3D_SIZE 2\n0 0 0\n')).toThrow('INVALID_CUBE_FILE')
+  })
+
+  it('renders a ready reference as its file LUT with the effect’s intensity, sharing the table', () => {
+    const lut = materializeLutFile(grid)
+    setLutReference('a', lut)
+    const first = resolveLutReferenceEffect('gpu-lut', reference('a'))
+    const second = resolveLutReferenceEffect('gpu-lut', { ...reference('a'), intensity: 0.2 })
+    expect(first.type).toBe('gpu-file-lut-v1')
+    expect(first.params).toMatchObject({ fileLutVersion: 1, fileLutSize: 2, intensity: 0.75 })
+    expect(second.params.intensity).toBe(0.2)
+    // The same string: the GPU texture key compares by reference and is built once.
+    expect(second.params.fileLutData).toBe(lut.params.fileLutData)
+    const inline = { lutName: 'x', lutSize: '2', lutData: 'AAAA' }
+    expect(resolveLutReferenceEffect('gpu-lut', inline)).toEqual({
+      type: 'gpu-lut',
+      params: inline,
+    })
+    expect(resolveLutReferenceEffect('gpu-brightness', { amount: 1 }).type).toBe('gpu-brightness')
+  })
+
+  it('leaves a reference ungraded until its file is read, then redraws', async () => {
+    const text = vi.fn(async () => new TextEncoder().encode(table).buffer)
+    vi.stubGlobal(
+      'fetch',
+      vi.fn(async () => ({ ok: true, status: 200, arrayBuffer: text })),
+    )
+    expect(resolveLutReferenceEffect('gpu-lut', reference('b')).type).toBe('gpu-lut')
+    expect(fetch).not.toHaveBeenCalled()
+    blobUrlManager.registerUrl('b', '/api/studio/projects/p/imports/b/file')
+    const before = getLutReferencesVersion()
+    expect(peekLutReference('b')).toBeUndefined()
+    await vi.waitFor(() => expect(getLutReferencesVersion()).toBeGreaterThan(before))
+    expect(fetch).toHaveBeenCalledWith('/api/studio/projects/p/imports/b/file', {
+      credentials: 'same-origin',
+    })
+    expect(resolveLutReferenceEffect('gpu-lut', reference('b')).type).toBe('gpu-file-lut-1d-v1')
+    expect(text).toHaveBeenCalledOnce()
+  })
+
+  it('refuses a render whose LUT is missing, unreadable or not a .cube file', async () => {
+    await expect(loadLutReferences(['missing'])).rejects.toThrow(LUT_REFERENCE_UNAVAILABLE)
+    vi.stubGlobal(
+      'fetch',
+      vi.fn(async () => ({ ok: false, status: 404 })),
+    )
+    blobUrlManager.registerUrl('gone', '/gone')
+    await expect(loadLutReference('gone')).rejects.toThrow(LUT_REFERENCE_UNAVAILABLE)
+    // A failed read is not retried every frame for the same file.
+    peekLutReference('gone')
+    expect(fetch).toHaveBeenCalledOnce()
+    vi.stubGlobal(
+      'fetch',
+      vi.fn(async () => ({
+        ok: true,
+        arrayBuffer: async () => new TextEncoder().encode('notes').buffer,
+      })),
+    )
+    blobUrlManager.registerUrl('notes', '/notes')
+    await expect(loadLutReferences(['notes'])).rejects.toThrow(LUT_REFERENCE_UNAVAILABLE)
+    setLutReference('ready', materializeLutFile(grid))
+    await expect(loadLutReferences(['ready', 'ready'])).resolves.toBeUndefined()
+  })
+
+  it('collects the references enabled LUT effects name', () => {
+    const items = [
+      { effects: [gpu(reference('a')), gpu(reference('b'), false)] },
+      { effects: [gpu(reference('a')), gpu({ lutData: 'AAAA', lutSize: '2', lutName: '' })] },
+      {
+        effects: [
+          {
+            id: 'b',
+            enabled: true,
+            effect: {
+              type: 'gpu-effect',
+              gpuEffectType: 'gpu-brightness',
+              params: { lutId: 'c', lutSource: 'import' },
+            },
+          } as ItemEffect,
+        ],
+      },
+      {},
+    ]
+    expect(collectLutReferenceIds(items)).toEqual(['a'])
+  })
+
+  it('replaces every LUT field when a new LUT is set, and only then', () => {
+    const kept = reference('a')
+    expect(mergeGpuEffectParams('gpu-lut', kept, { intensity: 0.1 })).toEqual({
+      ...kept,
+      intensity: 0.1,
+    })
+    expect(
+      mergeGpuEffectParams('gpu-lut', kept, { lutName: 'Inline', lutSize: '2', lutData: 'AAAA' }),
+    ).toEqual({
+      intensity: 0.75,
+      lutName: 'Inline',
+      lutSize: '2',
+      lutData: 'AAAA',
+    })
+    expect(
+      mergeGpuEffectParams(
+        'gpu-lut',
+        { intensity: 1, lutName: 'x', lutSize: '2', lutData: 'AAAA' },
+        reference('b'),
+      ),
+    ).toEqual(reference('b'))
+    expect(mergeGpuEffectParams('gpu-curves', { lutId: 'x' }, { lutData: 'y' })).toEqual({
+      lutId: 'x',
+      lutData: 'y',
+    })
+  })
+
+  it('has a keeper only while a host installs one', () => {
+    const keeper = { keep: vi.fn(async () => ({ id: 'k' })) }
+    const remove = installProjectLutKeeper(keeper)
+    expect(getProjectLutKeeper()).toBe(keeper)
+    remove()
+    expect(getProjectLutKeeper()).toBeUndefined()
+  })
+})
