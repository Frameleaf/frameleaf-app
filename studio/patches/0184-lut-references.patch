+/**
+ * Frameleaf (FL-1558): `.cube` files kept beside the project, 3D and 1D.
+ *
+ * A LUT kept with the project is not in the graph: the effect names it (`lutId`) and the editor
+ * reads its bytes, checks them with the strict grammar below and materialises the private execution
+ * params the GPU reads. A 3D file becomes `gpu-file-lut-v1` (`file-lut.ts`); a 1D file becomes
+ * `gpu-file-lut-1d-v1` (here). The server checks the same grammar when the file is imported
+ * (`validateStudioCubeLut`), so a file the server keeps is one this accepts.
+ */
+type Params = Record<string, number | boolean | string>
+interface Domain {
+  size: number
+  domainMin: number[]
+  domainMax: number[]
+}
+
+/** The largest 3D grid: 65 points an axis, the largest size grading tools write. */
+export const CUBE_FILE_3D_MAX_SIZE = 65
+/** The longest 1D table: the Adobe Cube specification's own ceiling. */
+export const CUBE_FILE_1D_MAX_SIZE = 65536
+/** 1D entries per texture row: four texels an entry keep a row within the 2048-texel 3D limit. */
+export const FILE_LUT_1D_ROW = 512
+
+export interface CubeFileDescriptor extends Domain {
+  dimensions: 1 | 3
+  title?: string
+}
+
+function checkDomain(value: unknown): number[] {
+  if (
+    !Array.isArray(value) ||
+    value.length !== 3 ||
+    value.some((v) => typeof v !== 'number' || !Number.isFinite(v) || Math.abs(v) > 1e37)
+  )
+    throw new Error('INVALID_FILE_LUT_DOMAIN')
+  return value
+}
+
+function bounds1d(value: Domain): Domain {
+  const { size } = value
+  if (!Number.isInteger(size) || size < 2 || size > CUBE_FILE_1D_MAX_SIZE)
+    throw new Error('FILE_LUT_ALLOCATION_LIMIT')
+  const domainMin = checkDomain(value.domainMin)
+  const domainMax = checkDomain(value.domainMax)
+  for (let i = 0; i < 3; i++) {
+    const span = Math.fround(domainMax[i]!) - Math.fround(domainMin[i]!)
+    if (!(span > 0) || !Number.isFinite(Math.fround(1 / span)))
+      throw new Error('INVALID_FILE_LUT_DOMAIN')
+  }
+  return { size, domainMin, domainMax }
+}
+
+const CUBE_NUMBER = String.raw`[-+]?(?:\d+\.?\d*|\.\d+)(?:[eE][-+]?\d+)?`
+const CUBE_TRIPLE = new RegExp(
+  String.raw`^(${CUBE_NUMBER})[ \t]+(${CUBE_NUMBER})[ \t]+(${CUBE_NUMBER})$`,
+)
+const CUBE_PAIR = new RegExp(String.raw`^(${CUBE_NUMBER})[ \t]+(${CUBE_NUMBER})$`)
+const CUBE_KEYWORD =
+  /^(TITLE|LUT_3D_SIZE|LUT_1D_SIZE|DOMAIN_MIN|DOMAIN_MAX|LUT_3D_INPUT_RANGE|LUT_1D_INPUT_RANGE)(?:[ \t]|$)/
+// eslint-disable-next-line no-control-regex
+const CONTROL = /[\u0000-\u0008\u000B\u000C\u000E-\u001F\u007F]/
+
+function finiteTriple(text: string): number[] | undefined {
+  const values = CUBE_TRIPLE.exec(text)?.slice(1).map(Number)
+  return values?.every((v) => Number.isFinite(v) && Math.abs(v) <= 1e37) ? values : undefined
+}
+
+function invalid(): never {
+  throw new Error('INVALID_CUBE_FILE')
+}
+
+/**
+ * Read a whole `.cube` file (Adobe Cube LUT 1.0 plus the input ranges Resolve writes): a 3D grid of
+ * `LUT_3D_SIZE`³ rows (2 to 65 points) or a 1D table of `LUT_1D_SIZE` rows (2 to 65536), its input
+ * domain and its title. Both sizes in one file, an input range of the other kind, an unknown
+ * keyword, a keyword inside the table, a row of other than three finite numbers or the wrong number
+ * of rows throws `INVALID_CUBE_FILE`: a LUT is never guessed at.
+ */
+export function describeCubeFile(text: string): CubeFileDescriptor {
+  if (CONTROL.test(text)) invalid()
+  let size: number | undefined
+  let dimensions: 1 | 3 | undefined
+  let rows = 0
+  let title: string | undefined
+  let range: number[] | undefined
+  let rangeDimensions: 1 | 3 | undefined
+  const domain: { DOMAIN_MIN?: number[]; DOMAIN_MAX?: number[] } = {}
+  const body = text.codePointAt(0) === 0xfeff ? text.slice(1) : text
+  for (const raw of body.split(/\r\n|\r|\n/)) {
+    const line = raw.trim()
+    if (line === '' || line.startsWith('#')) continue
+    if (line.length > 250) invalid()
+    const keyword = CUBE_KEYWORD.exec(line)?.[1]
+    if (!keyword) {
+      if (!finiteTriple(line) || size === undefined) invalid()
+      if (++rows > (dimensions === 3 ? size ** 3 : size)) invalid()
+      continue
+    }
+    if (rows > 0) invalid()
+    const value = line.slice(keyword.length).trim()
+    if (keyword === 'TITLE') {
+      if (title !== undefined || value === '') invalid()
+      title = /^"(.*)"$/.exec(value)?.[1] ?? value
+    } else if (keyword === 'LUT_3D_SIZE' || keyword === 'LUT_1D_SIZE') {
+      const three = keyword === 'LUT_3D_SIZE'
+      if (size !== undefined || !(three ? /^\d{1,3}$/ : /^\d{1,5}$/).test(value)) invalid()
+      size = Number(value)
+      dimensions = three ? 3 : 1
+      if (size < 2 || size > (three ? CUBE_FILE_3D_MAX_SIZE : CUBE_FILE_1D_MAX_SIZE)) invalid()
+    } else if (keyword === 'DOMAIN_MIN' || keyword === 'DOMAIN_MAX') {
+      const triple = finiteTriple(value)
+      if (domain[keyword] || !triple) invalid()
+      domain[keyword] = triple
+    } else {
+      const pair = CUBE_PAIR.exec(value)?.slice(1).map(Number)
+      if (range || !pair || !pair.every(Number.isFinite) || !(pair[0]! < pair[1]!)) invalid()
+      range = pair
+      rangeDimensions = keyword === 'LUT_1D_INPUT_RANGE' ? 1 : 3
+    }
+  }
+  if (size === undefined || dimensions === undefined) invalid()
+  if (rangeDimensions !== undefined && rangeDimensions !== dimensions) invalid()
+  const [low, high] = range ?? []
+  if (
+    range &&
+    (domain.DOMAIN_MIN?.some((v) => v !== low) || domain.DOMAIN_MAX?.some((v) => v !== high))
+  )
+    invalid()
+  if (rows !== (dimensions === 3 ? size ** 3 : size)) invalid()
+  let checked: Domain
+  try {
+    checked = bounds1d({
+      size: dimensions === 3 ? 2 : size,
+      domainMin: domain.DOMAIN_MIN ?? [low ?? 0, low ?? 0, low ?? 0],
+      domainMax: domain.DOMAIN_MAX ?? [high ?? 1, high ?? 1, high ?? 1],
+    })
+  } catch {
+    invalid()
+  }
+  return { ...checked, size, dimensions, ...(title !== undefined && { title }) }
+}
+
+/** Texture rows a 1D table of `size` entries takes. */
+const rows1d = (size: number) => Math.ceil(size / FILE_LUT_1D_ROW)
+
+/**
+ * A 1D table as execution params for `gpu-file-lut-1d-v1`: raw float32 outputs, four texels an entry
+ * (R, G, B and 1), {@link FILE_LUT_1D_ROW} entries a texture row, the last row padded with zeros.
+ * Caller must first apply {@link describeCubeFile} to the same text.
+ */
+export function materializeCubeFileLut1d(text: string, descriptor: Domain): Params {
+  const { size, domainMin, domainMax } = bounds1d(descriptor)
+  const rows = text
+    .split(/\r\n|\r|\n/)
+    .map((line) => line.trim())
+    .filter((line) => /^[+\-.\d]/.test(line))
+  if (rows.length !== size) throw new Error('INVALID_FILE_LUT_TABLE')
+  const data = new Uint8Array(rows1d(size) * FILE_LUT_1D_ROW * 16)
+  const view = new DataView(data.buffer)
+  for (let i = 0; i < rows.length; i++) {
+    const values = rows[i]!.split(/\s+/).map(Number)
+    if (values.length !== 3 || values.some((v) => !Number.isFinite(v) || Math.abs(v) > 1e37))
+      throw new Error('INVALID_FILE_LUT_TABLE')
+    for (let c = 0; c < 3; c++) view.setFloat32(i * 16 + c * 4, values[c]!, true)
+    view.setFloat32(i * 16 + 12, 1, true)
+  }
+  let binary = ''
+  for (let i = 0; i < data.length; i += 8192)
+    binary += String.fromCharCode(...data.subarray(i, i + 8192))
+  return {
+    fileLut1dVersion: 1,
+    fileLutSize: size,
+    fileLutData: btoa(binary),
+    fileLutDomainMin: JSON.stringify(domainMin),
+    fileLutDomainMax: JSON.stringify(domainMax),
+  }
+}
+
+/** A 1D table's size and domain, checked without decoding the table: cheap enough for every frame. */
+export function readFileLut1dDomain(params: Params): Domain {
+  if (
+    params.fileLut1dVersion !== 1 ||
+    typeof params.fileLutSize !== 'number' ||
+    typeof params.fileLutData !== 'string' ||
+    typeof params.fileLutDomainMin !== 'string' ||
+    typeof params.fileLutDomainMax !== 'string'
+  )
+    throw new Error('INVALID_FILE_LUT_VERSION')
+  const bounds = bounds1d({
+    size: params.fileLutSize,
+    domainMin: JSON.parse(params.fileLutDomainMin),
+    domainMax: JSON.parse(params.fileLutDomainMax),
+  })
+  const length = rows1d(bounds.size) * FILE_LUT_1D_ROW * 16
+  if (params.fileLutData.length !== 4 * Math.ceil(length / 3))
+    throw new Error('FILE_LUT_ALLOCATION_LIMIT')
+  return bounds
+}
+
+/** Validate a 1D table before texture upload: entries finite, their fourth float 1, padding zero. */
+export function readFileLut1d(params: Params): Domain & { data: Uint8Array; rows: number } {
+  const bounds = readFileLut1dDomain(params)
+  const length = rows1d(bounds.size) * FILE_LUT_1D_ROW * 16
+  const binary = atob(params.fileLutData as string)
+  if (binary.length !== length || btoa(binary) !== params.fileLutData)
+    throw new Error('INVALID_FILE_LUT_ENCODING')
+  const data = Uint8Array.from(binary, (c) => c.charCodeAt(0))
+  const view = new DataView(data.buffer)
+  for (let i = 0; i < length; i += 4) {
+    const value = view.getFloat32(i, true)
+    const valid =
+      i >= bounds.size * 16
+        ? value === 0
+        : Number.isFinite(value) && Math.abs(value) <= 1e37 && (i % 16 !== 12 || value === 1)
+    if (!valid) throw new Error('INVALID_FILE_LUT_TABLE')
+  }
+  return { ...bounds, data, rows: rows1d(bounds.size) }
+}
+
+/**
+ * The reference value of a 1D table at `color` (CPU, float64), as `studio/spec/effects/gpu-lut.md`
+ * defines it: per channel, the input mapped through that channel's domain and clamped to [0, 1],
+ * then linear interpolation between the two nearest entries of that channel. The shader computes
+ * the same in float32.
+ */
+export function sampleCubeFileLut1d(
+  entries: ReadonlyArray<readonly [number, number, number]>,
+  domainMin: readonly number[],
+  domainMax: readonly number[],
+  color: readonly [number, number, number],
+): [number, number, number] {
+  const last = entries.length - 1
+  const channel = (c: 0 | 1 | 2) => {
+    const u = Math.min(1, Math.max(0, (color[c] - domainMin[c]!) / (domainMax[c]! - domainMin[c]!)))
+    const position = u * last
+    const lo = Math.floor(position)
+    const hi = Math.min(lo + 1, last)
+    const f = position - lo
+    return entries[lo]![c] + (entries[hi]![c] - entries[lo]![c]) * f
+  }
+  return [channel(0), channel(1), channel(2)]
+}
