+@group(0) @binding(0) var texSampler: sampler;
+@group(0) @binding(1) var inputTex: texture_2d<f32>;
+@group(0) @binding(2) var<uniform> params: FileLut1dParams;
+@group(0) @binding(3) var lutTex: texture_3d<f32>;
+fn unpackFile1dChannel(index: i32, channel: i32) -> f32 {
+  let p = vec3i((index % ${FILE_LUT_1D_ROW}) * 4 + channel, index / ${FILE_LUT_1D_ROW}, 0);
+  let bytes = vec4u(round(textureLoad(lutTex, p, 0) * 255.0));
+  return bitcast<f32>(bytes.x | (bytes.y << 8u) | (bytes.z << 16u) | (bytes.w << 24u));
+}
+fn file1dChannel(value: f32, channel: i32) -> f32 {
+  let u = clamp((value - params.domainMin[channel]) / (params.domainMax[channel] - params.domainMin[channel]), 0.0, 1.0);
+  let position = u * (params.size - 1.0);
+  let lo = i32(floor(position));
+  let hi = min(lo + 1, i32(params.size) - 1);
+  return mix(unpackFile1dChannel(lo, channel), unpackFile1dChannel(hi, channel), position - f32(lo));
+}
+@fragment fn fileLut1dFragment(input: VertexOutput) -> @location(0) vec4f {
+  let color = textureSample(inputTex, texSampler, input.uv);
+  let graded = vec3f(file1dChannel(color.r, 0), file1dChannel(color.g, 1), file1dChannel(color.b, 2));
+  return vec4f(mix(color.rgb, graded, clamp(params.intensity, 0.0, 1.0)), color.a);
+}`,
+  params: { intensity: lut3d.params.intensity! },
+  packUniforms: (p) => {
+    const table = readFileLut1dDomain(p)
+    return new Float32Array([
+      typeof p.intensity === 'number' ? p.intensity : 1,
+      table.size,
+      0,
+      0,
+      ...table.domainMin,
+      0,
+      ...table.domainMax,
+      0,
+    ])
+  },
+  dataTexture: {
+    dimension: '3d',
+    key: (p) => (typeof p.fileLutData === 'string' ? p.fileLutData : ''),
+    build: (p) => {
+      const { rows, data } = readFileLut1d(p)
+      return { width: FILE_LUT_1D_ROW * 4, height: rows, depth: 1, data }
+    },
+  },
+}
