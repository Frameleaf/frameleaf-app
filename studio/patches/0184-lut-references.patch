+  ({
+    id,
+    type: 'video',
+    trackId: 't',
+    from: 0,
+    durationInFrames: 30,
+    effects: [
+      {
+        id: `${id}-lut`,
+        enabled: true,
+        effect: {
+          type: 'gpu-effect',
+          gpuEffectType: 'gpu-lut',
+          params: { lutName: '', lutSize: '0', lutData: '', lutId, lutSource: 'import' },
