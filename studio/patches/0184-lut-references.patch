diff --git a/src/features/export/utils/lut-reference-preload.ts b/src/features/export/utils/lut-reference-preload.ts
new file mode 100644
--- /dev/null
+++ b/src/features/export/utils/lut-reference-preload.ts
@@ -0,0 +1,39 @@
+/**
+ * Frameleaf (FL-1558): before a render, read every LUT kept with the project that the composition
+ * (and each sub-composition it reaches) names, so no frame is rendered ungraded while a file loads.
+ * An export refuses when one cannot be read (`LUT_REFERENCE_UNAVAILABLE`); a thumbnail or analysis
+ * frame renders ungraded rather than fail.
+ */
+import type { CompositionInputProps } from '@/types/export'
+import {
+  collectLutReferenceIds,
+  loadLutReferences,
+} from '@/infrastructure/gpu-effects/lut/lut-references'
+import {
+  collectReachableCompositionIdsFromTracks,
+  useCompositionsStore,
+} from '@/features/export/deps/timeline-composition-graph'
+
+export function compositionLutReferenceIds(
+  composition: Pick<CompositionInputProps, 'tracks'>,
+): string[] {
+  const tracks = composition.tracks ?? []
+  const { compositionById } = useCompositionsStore.getState()
+  const items = tracks.flatMap((track) => track.items ?? [])
+  for (const id of collectReachableCompositionIdsFromTracks(tracks, compositionById))
+    items.push(...(compositionById[id]?.items ?? []))
+  return collectLutReferenceIds(items)
+}
+
+export async function loadCompositionLutReferences(
+  composition: Pick<CompositionInputProps, 'tracks'>,
+  options: { strict: boolean },
+): Promise<void> {
+  const ids = compositionLutReferenceIds(composition)
+  if (ids.length === 0) return
+  try {
+    await loadLutReferences(ids)
+  } catch (error) {
+    if (options.strict) throw error
+  }
+}
