+/**
+ * Frameleaf (FL-1558): LUTs kept beside the project instead of inside the graph.
+ *
+ * An inline `gpu-lut` carries its table as base64 in the graph (about 190 KB a clip at 33³), so a
+ * graded feature-length project outgrew the graph limit. A `gpu-lut` that names a LUT kept with the
+ * project instead carries only the reference:
+ *
+ *   { intensity, lutName, lutSize: '0', lutData: '', lutId: <project import id>, lutSource: 'import' }
+ *
+ * Every clip graded with the same file names the same import, once stored. At render time this
+ * module turns the reference into the private execution effect a render worker also materialises
+ * (`studio/tools/render-worker-lut-inputs.mjs`): `gpu-file-lut-v1` for a 3D file and
+ * `gpu-file-lut-1d-v1` for a 1D file, from the bytes the host serves under that id. Preview shows
+ * the clip ungraded until the file is read (the reference's inline fields are the identity table);
+ * export waits for every referenced file and refuses the render if one cannot be read.
+ */
+import { useSyncExternalStore } from 'react'
+import { blobUrlManager } from '@/infrastructure/browser/blob-url-manager'
+import type { ItemEffect } from '@/types/effects'
+import { describeCubeFile, materializeCubeFileLut1d } from './cube-file'
+import { materializeCubeFileLut } from './file-lut'
+
+type Params = Record<string, number | boolean | string>
+
+export const LUT_REFERENCE_UNAVAILABLE = 'LUT_REFERENCE_UNAVAILABLE'
+
+/** The LUT a reference names, ready to render. */
+export interface ResolvedLut {
+  type: 'gpu-file-lut-v1' | 'gpu-file-lut-1d-v1'
+  params: Params
+  /** The file's TITLE, else its file name without `.cube`. */
+  name: string
+  dimensions: 1 | 3
+  size: number
+}
+
+type Entry =
+  | { state: 'ready'; lut: ResolvedLut }
+  | { state: 'loading'; url: string }
+  | { state: 'failed'; url: string | null; error: Error }
+
+/** Materialised tables kept in memory, by encoded size; the least recently used go first. */
+const CACHE_BYTES = 96 * 1024 * 1024
+const entries = new Map<string, Entry>()
+let version = 0
+const listeners = new Set<() => void>()
+
+function changed(): void {
+  version++
+  for (const listener of listeners) listener()
+}
+
+export const subscribeLutReferences = (listener: () => void): (() => void) => {
+  listeners.add(listener)
+  return () => listeners.delete(listener)
+}
+export const getLutReferencesVersion = (): number => version
+/** Changes whenever a referenced LUT becomes ready or fails: preview redraws with it. */
+export function useLutReferencesVersion(): number {
+  return useSyncExternalStore(subscribeLutReferences, getLutReferencesVersion)
+}
+
+/** The id a `gpu-lut`'s params name a LUT kept with the project by, or null for an inline LUT. */
+export function lutReferenceId(params: Readonly<Record<string, unknown>>): string | null {
+  return params.lutSource === 'import' &&
+    typeof params.lutId === 'string' &&
+    params.lutId.length > 0
+    ? params.lutId
+    : null
+}
+
+/** Check a whole `.cube` file and materialise it. Throws `INVALID_CUBE_FILE` for anything else. */
+export function materializeLutFile(text: string, fileName = ''): ResolvedLut {
+  const descriptor = describeCubeFile(text)
+  const three = descriptor.dimensions === 3
+  return {
+    type: three ? 'gpu-file-lut-v1' : 'gpu-file-lut-1d-v1',
+    params: three
+      ? materializeCubeFileLut(text, descriptor)
+      : materializeCubeFileLut1d(text, descriptor),
+    name: (descriptor.title ?? fileName.replace(/\.cube$/i, '')).slice(0, 256),
+    dimensions: descriptor.dimensions,
+    size: descriptor.size,
+  }
+}
+
+function evict(): void {
+  let bytes = 0
+  for (const entry of [...entries.values()].reverse()) {
+    if (entry.state !== 'ready') continue
+    bytes += String(entry.lut.params.fileLutData).length
+  }
+  for (const [id, entry] of entries) {
+    if (bytes <= CACHE_BYTES) break
+    if (entry.state !== 'ready') continue
+    bytes -= String(entry.lut.params.fileLutData).length
+    entries.delete(id)
+  }
+}
+
+/** Keep a LUT the editor has already read (just imported) under the id its effect names. */
+export function setLutReference(id: string, lut: ResolvedLut): void {
+  entries.delete(id)
+  entries.set(id, { state: 'ready', lut })
+  evict()
+  changed()
+}
+
+/**
+ * Read the file the host serves under `id` (registered with `blobUrlManager`), check and
+ * materialise it. Resolves with the LUT; rejects with `LUT_REFERENCE_UNAVAILABLE` when there is no
+ * file for the id, it cannot be fetched, or it is not a valid `.cube` file.
+ */
+export async function loadLutReference(id: string, fileName = ''): Promise<ResolvedLut> {
+  const known = entries.get(id)
+  if (known?.state === 'ready') return known.lut
+  const url = blobUrlManager.get(id)
+  if (!url) throw new Error(LUT_REFERENCE_UNAVAILABLE)
+  entries.set(id, { state: 'loading', url })
+  try {
+    const response = await fetch(url, { credentials: 'same-origin' })
+    if (!response.ok) throw new Error(`HTTP ${response.status}`)
+    const text = new TextDecoder('utf-8', { fatal: true }).decode(await response.arrayBuffer())
+    const lut = materializeLutFile(text, fileName)
+    if (entries.get(id)?.state === 'loading') setLutReference(id, lut)
+    return lut
+  } catch (cause) {
+    const error = new Error(LUT_REFERENCE_UNAVAILABLE, { cause })
+    if (entries.get(id)?.state === 'loading') {
+      entries.set(id, { state: 'failed', url, error })
+      changed()
+    }
+    throw error
+  }
+}
+
+/**
+ * The LUT a reference names if it is ready. A miss starts reading it, once per served URL, and
+ * returns undefined; `useLutReferencesVersion` changes when it is ready.
+ */
+export function peekLutReference(id: string): ResolvedLut | undefined {
+  const entry = entries.get(id)
+  if (entry?.state === 'ready') {
+    entries.delete(id)
+    entries.set(id, entry)
+    return entry.lut
+  }
+  const url = blobUrlManager.get(id)
+  if (!url || (entry && entry.url === url)) return undefined
+  void loadLutReference(id).catch(() => {})
+  return undefined
+}
+
+/** Wait for every LUT these ids name; reject with `LUT_REFERENCE_UNAVAILABLE` if one cannot be read. */
+export async function loadLutReferences(ids: Iterable<string>): Promise<void> {
+  await Promise.all([...new Set(ids)].map((id) => loadLutReference(id)))
+}
+
+/** The ids of every enabled `gpu-lut` that names a LUT kept with the project, in these items. */
+export function collectLutReferenceIds(
+  items: Iterable<{ effects?: readonly ItemEffect[] }>,
+): string[] {
+  const ids = new Set<string>()
+  for (const item of items) {
+    for (const entry of item.effects ?? []) {
+      if (!entry.enabled || entry.effect.type !== 'gpu-effect') continue
+      if (entry.effect.gpuEffectType !== 'gpu-lut') continue
+      const id = lutReferenceId(entry.effect.params)
+      if (id) ids.add(id)
+    }
+  }
+  return [...ids]
+}
+
+/**
+ * The effect to execute for a `gpu-effect`: a `gpu-lut` that names a ready LUT becomes its file
+ * LUT with the effect's (possibly animated) intensity; everything else, including a reference still
+ * being read, is unchanged. The table string is shared, so the GPU texture is built once.
+ */
+export function resolveLutReferenceEffect(
+  type: string,
+  params: Params,
+): { type: string; params: Params } {
+  if (type !== 'gpu-lut') return { type, params }
+  const id = lutReferenceId(params)
+  const lut = id ? peekLutReference(id) : undefined
+  if (!lut) return { type, params }
+  const intensity = typeof params.intensity === 'number' ? params.intensity : 1
+  return { type: lut.type, params: { ...lut.params, intensity } }
+}
+
+/** The fields a `gpu-lut` holds its LUT in: inline (`lutName`, `lutSize`, `lutData`) or by reference. */
+const LUT_FIELDS = new Set(['lutName', 'lutSize', 'lutData', 'lutId', 'lutSource'])
+
+/**
+ * Merge a parameter update into an effect's params. For `gpu-lut`, an update that sets the LUT
+ * (`lutData` or `lutId`) replaces every LUT field, so an inline LUT never keeps a stale reference
+ * and a reference never keeps a stale table.
+ */
+export function mergeGpuEffectParams(
+  type: string,
+  params: Readonly<Params>,
+  updates: Readonly<Params>,
+): Params {
+  if (type !== 'gpu-lut' || !('lutData' in updates || 'lutId' in updates))
+    return { ...params, ...updates }
+  const kept: Params = {}
+  for (const [key, value] of Object.entries(params)) if (!LUT_FIELDS.has(key)) kept[key] = value
+  return { ...kept, ...updates }
+}
+
+/** The host keeps an imported `.cube` file with the project and says the id the graph names it by. */
+export interface ProjectLutKeeper {
+  keep(file: File): Promise<{ id: string }>
+}
+
+let keeper: ProjectLutKeeper | undefined
+
+/** Installed by a host that keeps files with the project; without one, imports embed the LUT. */
+export function installProjectLutKeeper(next: ProjectLutKeeper): () => void {
+  keeper = next
+  return () => {
+    if (keeper === next) keeper = undefined
+  }
+}
+
+export const getProjectLutKeeper = (): ProjectLutKeeper | undefined => keeper
+
+/** Forget every LUT read so far (a project closed). */
+export function clearLutReferences(): void {
+  entries.clear()
+  changed()
+}
