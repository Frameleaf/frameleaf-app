+import { describe, expect, it } from 'vitest'
+import { fileLut1d } from '../effects/lut'
+import { getGpuEffect, GPU_EFFECT_REGISTRY } from '../registry'
+import {
+  CUBE_FILE_1D_MAX_SIZE,
+  FILE_LUT_1D_ROW,
+  describeCubeFile,
+  materializeCubeFileLut1d,
+  readFileLut1d,
+  sampleCubeFileLut1d,
+} from './cube-file'
+
+const cube3d = (size: number, headers = '') =>
+  `TITLE "Grid"\n${headers}LUT_3D_SIZE ${size}\n${'0.5 0.25 1\n'.repeat(size ** 3)}`
+/** A 1D table: red rises, green falls, blue is a curve, so every channel reads its own column. */
+const entries: [number, number, number][] = [
+  [0, 1, 0],
+  [0.25, 0.5, 0.1],
+  [1, 0, 1],
+]
+const cube1d = (headers = '') =>
+  `# a comment\nLUT_1D_SIZE 3\n${headers}${entries.map((row) => row.join(' ')).join('\n')}\n`
+
+describe('describeCubeFile (FL-1558)', () => {
+  it('reads a 3D grid and a 1D table, their domains and titles', () => {
+    expect(describeCubeFile(cube3d(2))).toEqual({
+      dimensions: 3,
+      size: 2,
+      domainMin: [0, 0, 0],
+      domainMax: [1, 1, 1],
+      title: 'Grid',
+    })
+    expect(describeCubeFile(cube1d('DOMAIN_MIN -1 0 0\nDOMAIN_MAX 1 2 1\n'))).toEqual({
+      dimensions: 1,
+      size: 3,
+      domainMin: [-1, 0, 0],
+      domainMax: [1, 2, 1],
+    })
+    expect(describeCubeFile(cube1d('LUT_1D_INPUT_RANGE -0.5 1.5\n'))).toMatchObject({
+      domainMin: [-0.5, -0.5, -0.5],
+      domainMax: [1.5, 1.5, 1.5],
+    })
+    expect(describeCubeFile(`TITLE Bare words\r\n${cube1d().slice(12)}`).title).toBe('Bare words')
+    const longest = `LUT_1D_SIZE ${CUBE_FILE_1D_MAX_SIZE}\n${'1 1 1\n'.repeat(CUBE_FILE_1D_MAX_SIZE)}`
+    expect(describeCubeFile(longest).size).toBe(CUBE_FILE_1D_MAX_SIZE)
+  })
+
+  it.each([
+    ['no size', 'TITLE "x"\n'],
+    ['both sizes', 'LUT_1D_SIZE 2\nLUT_3D_SIZE 2\n' + '0 0 0\n'.repeat(8)],
+    ['a 1D table one row short', 'LUT_1D_SIZE 3\n0 0 0\n1 1 1\n'],
+    ['a 1D table one row long', 'LUT_1D_SIZE 2\n0 0 0\n1 1 1\n1 1 1\n'],
+    ['a 1D table of one row', 'LUT_1D_SIZE 1\n0 0 0\n'],
+    ['a 1D table past the limit', `LUT_1D_SIZE ${CUBE_FILE_1D_MAX_SIZE + 1}\n`],
+    ['a 3D grid past the limit', 'LUT_3D_SIZE 66\n'],
+    ['a 3D input range on a 1D table', cube1d('LUT_3D_INPUT_RANGE 0 1\n')],
+    ['a 1D input range on a 3D grid', cube3d(2, 'LUT_1D_INPUT_RANGE 0 1\n')],
+    [
+      'an input range that conflicts with the domain',
+      cube1d('LUT_1D_INPUT_RANGE 0 2\nDOMAIN_MAX 1 2 2\n'),
+    ],
+    ['an empty domain', cube1d('DOMAIN_MIN 1 1 1\nDOMAIN_MAX 1 1 1\n')],
+    ['an unknown keyword', 'LUT_1D_SIZE 2\nINCLUDE x\n0 0 0\n1 1 1\n'],
+    ['a keyword inside the table', 'LUT_1D_SIZE 2\n0 0 0\nTITLE "late"\n1 1 1\n'],
+    ['a row of two numbers', 'LUT_1D_SIZE 2\n0 0 0\n1 1\n'],
+    ['a number that is not finite', 'LUT_1D_SIZE 2\n0 0 0\n1e999 1 1\n'],
+    ['a hexadecimal number', 'LUT_1D_SIZE 2\n0 0 0\n0x1 1 1\n'],
+    ['a control character', `${cube1d()}\u0000`],
+  ])('refuses a file with %s', (_name, text) => {
+    expect(() => describeCubeFile(text)).toThrow('INVALID_CUBE_FILE')
+  })
+})
+
+describe('1D file LUT execution params (FL-1558)', () => {
+  it('packs raw float outputs four texels an entry, 512 entries a row, padded with zeros', () => {
+    const descriptor = describeCubeFile(cube1d('DOMAIN_MIN -1 0 0\n'))
+    const params = materializeCubeFileLut1d(cube1d('DOMAIN_MIN -1 0 0\n'), descriptor)
+    expect(params).toMatchObject({ fileLut1dVersion: 1, fileLutSize: 3 })
+    const table = readFileLut1d(params)
+    expect(table.rows).toBe(1)
+    expect(table.domainMin).toEqual([-1, 0, 0])
+    expect(table.data.length).toBe(FILE_LUT_1D_ROW * 16)
+    const view = new DataView(table.data.buffer)
+    expect(view.getFloat32(16 + 0, true)).toBe(0.25)
+    expect(view.getFloat32(16 + 4, true)).toBe(0.5)
+    expect(view.getFloat32(16 + 8, true)).toBeCloseTo(0.1, 7)
+    expect(view.getFloat32(16 + 12, true)).toBe(1)
+    expect(view.getFloat32(3 * 16, true)).toBe(0)
+  })
+
+  it('wraps a long table onto further rows', () => {
+    const size = FILE_LUT_1D_ROW + 1
+    const text = `LUT_1D_SIZE ${size}\n${Array.from({ length: size }, (_, i) => `${i} 0 0`).join('\n')}`
+    const table = readFileLut1d(materializeCubeFileLut1d(text, describeCubeFile(text)))
+    expect(table.rows).toBe(2)
+    // Entry 512 is the first entry of the second row: texel (0, 1) of the shader's lookup.
+    const view = new DataView(table.data.buffer)
+    expect(view.getFloat32(FILE_LUT_1D_ROW * 16, true)).toBe(FILE_LUT_1D_ROW)
+    expect(
+      fileLut1d.dataTexture!.build(materializeCubeFileLut1d(text, describeCubeFile(text))),
+    ).toMatchObject({
+      width: FILE_LUT_1D_ROW * 4,
+      height: 2,
+      depth: 1,
+    })
+  })
+
+  it('refuses tampered params instead of rendering an identity', () => {
+    const params = materializeCubeFileLut1d(cube1d(), describeCubeFile(cube1d()))
+    const patches: Record<string, number | string>[] = [
+      { fileLut1dVersion: 2 },
+      { fileLutSize: 4 },
+      { fileLutData: `${params.fileLutData}\n` },
+      { fileLutDomainMax: '[0,1,1]' },
+    ]
+    for (const patch of patches) expect(() => readFileLut1d({ ...params, ...patch })).toThrow()
+  })
+
+  it('packs the uniforms the shader reads and stays out of the effect catalogue', () => {
+    const params = materializeCubeFileLut1d(
+      cube1d('DOMAIN_MAX 2 1 1\n'),
+      describeCubeFile(cube1d('DOMAIN_MAX 2 1 1\n')),
+    )
+    expect([...fileLut1d.packUniforms({ ...params, intensity: 0.5 }, 1, 1)!]).toEqual([
+      0.5, 3, 0, 0, 0, 0, 0, 0, 2, 1, 1, 0,
+    ])
+    expect(getGpuEffect('gpu-file-lut-1d-v1')).toBe(fileLut1d)
+    expect(GPU_EFFECT_REGISTRY.has('gpu-file-lut-1d-v1')).toBe(false)
+    expect(GPU_EFFECT_REGISTRY.has('gpu-file-lut-v1')).toBe(false)
+  })
+})
+
+describe('1D LUT reference values (studio/spec/effects/gpu-lut.md)', () => {
+  const min = [0, 0, 0]
+  const max = [1, 1, 1]
+  it('looks each channel up in its own column', () => {
+    expect(sampleCubeFileLut1d(entries, min, max, [0, 0, 0])).toEqual([0, 1, 0])
+    expect(sampleCubeFileLut1d(entries, min, max, [0.5, 0.5, 0.5])).toEqual([0.25, 0.5, 0.1])
+    expect(sampleCubeFileLut1d(entries, min, max, [1, 1, 1])).toEqual([1, 0, 1])
+  })
+  it('interpolates linearly between the two nearest entries', () => {
+    const [r, g, b] = sampleCubeFileLut1d(entries, min, max, [0.25, 0.75, 0.625])
+    expect(r).toBeCloseTo(0.125, 12)
+    expect(g).toBeCloseTo(0.25, 12)
+    expect(b).toBeCloseTo(0.1 + 0.9 * 0.25, 12)
+  })
+  it('maps the input through each channel’s domain and clamps it to the table', () => {
+    const [r, g, b] = sampleCubeFileLut1d(entries, [-1, 0, 0], [1, 2, 1], [0, 1, 7])
+    expect(r).toBe(0.25)
+    expect(g).toBe(0.5)
+    expect(b).toBe(1)
+    expect(sampleCubeFileLut1d(entries, min, max, [-3, -3, -3])).toEqual([0, 1, 0])
+  })
+})
