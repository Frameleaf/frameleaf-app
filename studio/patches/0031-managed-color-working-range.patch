+    nits[0] / referenceWhiteNits,
+    nits[1] / referenceWhiteNits,
+    nits[2] / referenceWhiteNits,
+  ]
+  const linear709 = multiply(BT2020_TO_BT709, relative)
+  return [
+    srgbEncodeExtended(linear709[0]),
+    srgbEncodeExtended(linear709[1]),
+    srgbEncodeExtended(linear709[2]),
+  ]
+}
+
+/**
+ * ITU-R BT.2390 EETF on PQ-encoded luminance: maps [0, sourcePeak] into
+ * [0, targetPeak] with a Hermite knee and leaves light below the knee unchanged.
+ */
+export function bt2390Eetf(nits: number, sourcePeakNits: number, targetPeakNits: number): number {
+  if (nits <= 0) return 0
+  if (targetPeakNits >= sourcePeakNits) return Math.min(nits, targetPeakNits)
+  const maxSource = pqEncode(sourcePeakNits)
+  const e1 = pqEncode(nits) / maxSource
+  const maxLum = pqEncode(targetPeakNits) / maxSource
+  const ks = 1.5 * maxLum - 0.5
+  let e2 = e1
+  if (e1 > ks && ks < 1) {
+    const t = (e1 - ks) / (1 - ks)
+    const t2 = t * t
+    const t3 = t2 * t
+    e2 = (2 * t3 - 3 * t2 + 1) * ks + (t3 - 2 * t2 + t) * (1 - ks) + (-2 * t3 + 3 * t2) * maxLum
+  }
+  return Math.min(pqDecode(Math.min(e2, 1) * maxSource), targetPeakNits)
+}
+
+/**
+ * Explicit SDR monitoring/delivery of an HDR working value: 'none' clips at
+ * reference white; 'bt2390' tone maps from the mastering peak to reference white
+ * by scaling colour with the luminance EETF (hue-preserving).
+ */
+export function workingToSdrDisplay(working: Rgb, color: ResolvedColorManagement): Rgb {
+  if (color.workingRange === 'sdr' || color.sdrMonitoring === 'none') {
+    return working.map((v) => Math.min(Math.max(v, 0), 1)) as unknown as Rgb
+  }
+  const linear = working.map(srgbDecodeExtended) as unknown as Rgb
+  const y = 0.2126 * linear[0] + 0.7152 * linear[1] + 0.0722 * linear[2]
+  if (y <= 0) return working.map((v) => Math.min(Math.max(v, 0), 1)) as unknown as Rgb
+  const nits = y * color.referenceWhiteNits
+  const mapped = bt2390Eetf(nits, color.masteringPeakNits, color.referenceWhiteNits)
+  const scale = mapped / nits
+  return linear.map((v) =>
+    Math.min(Math.max(srgbEncodeExtended(v * scale), 0), 1),
+  ) as unknown as Rgb
+}
