+/**
+ * Frameleaf managed colour (FL-97 / VID-201).
+ *
+ * Working space
+ * - SDR projects keep Freecut's reference behaviour: display-referred sRGB-encoded
+ *   BT.709 values in [0, 1], and every node (effect, blend, transition) clamps
+ *   exactly as upstream, whichever GPU route renders it.
+ * - HDR projects use extended-range sRGB encoding with BT.709 primaries, as the
+ *   browser's extended canvas does. 1.0 is reference white, `referenceWhiteNits`
+ *   (203 cd/m² by default, ITU-R BT.2408). Values above 1 are highlights. Negative
+ *   values carry colours outside BT.709, up to BT.2020. The transfer is odd-symmetric,
+ *   so the sign survives decoding. Nothing in the graph clips them.
+ *
+ * Alpha is straight (not premultiplied) in texture transport and bounded to [0, 1].
+ * Colour is converted only at an explicit boundary:
+ * - an SDR canvas, which clips unless tone mapping was chosen;
+ * - an HDR export (PQ or HLG, BT.2020, see {@link workingToSignal});
+ * - HDR sources entering the graph ({@link signalToWorking}).
+ *
+ * SDR sources placed in an HDR project map SDR white to reference white. They are
+ * never expanded implicitly. Tone mapping happens only when a monitoring or export
+ * policy names it ({@link ToneMapPolicy}). It is never inherited from browser or
+ * playback defaults.
+ */
+
+export type WorkingRange = 'sdr' | 'hdr'
+export type HdrTransfer = 'pq' | 'hlg'
+export type ToneMapPolicy = 'none' | 'bt2390'
+
+export interface ProjectColorManagement {
+  workingRange: WorkingRange
+  /** cd/m² represented by working value 1.0 in an HDR project. */
+  referenceWhiteNits?: number
+  /** Assumed mastering peak for monitoring/tone mapping and HLG's nominal display. */
+  masteringPeakNits?: number
+  /** How an HDR project is shown on an SDR display. Explicit; defaults to clipping. */
+  sdrMonitoring?: ToneMapPolicy
+}
+
+export const DEFAULT_REFERENCE_WHITE_NITS = 203
+export const DEFAULT_MASTERING_PEAK_NITS = 1000
+export const PQ_PEAK_NITS = 10000
+export const HLG_NOMINAL_PEAK_NITS = 1000
+
+export interface ResolvedColorManagement {
+  workingRange: WorkingRange
+  referenceWhiteNits: number
+  masteringPeakNits: number
+  sdrMonitoring: ToneMapPolicy
+}
+
+/** Absent settings mean an SDR project: every existing project keeps its pixels. */
+export function resolveColorManagement(
+  settings: ProjectColorManagement | undefined,
+): ResolvedColorManagement {
+  const positive = (value: number | undefined, fallback: number) =>
+    typeof value === 'number' && Number.isFinite(value) && value > 0 ? value : fallback
+  const referenceWhiteNits = positive(settings?.referenceWhiteNits, DEFAULT_REFERENCE_WHITE_NITS)
+  return {
+    workingRange: settings?.workingRange === 'hdr' ? 'hdr' : 'sdr',
+    referenceWhiteNits,
+    masteringPeakNits: Math.max(
+      referenceWhiteNits,
+      positive(settings?.masteringPeakNits, DEFAULT_MASTERING_PEAK_NITS),
+    ),
+    sdrMonitoring: settings?.sdrMonitoring === 'bt2390' ? 'bt2390' : 'none',
+  }
+}
+
+export type Rgb = readonly [number, number, number]
+type Matrix = readonly [Rgb, Rgb, Rgb]
+
+/** Linear BT.709 → BT.2020 (ITU-R BT.2087). */
+export const BT709_TO_BT2020: Matrix = [
+  [0.627404, 0.329282, 0.043314],
+  [0.069097, 0.91954, 0.011361],
+  [0.016392, 0.088013, 0.895595],
+]
+/** Linear BT.2020 → BT.709. */
+export const BT2020_TO_BT709: Matrix = [
+  [1.660491, -0.587641, -0.07285],
+  [-0.124551, 1.1329, -0.008349],
+  [-0.018151, -0.100579, 1.11873],
+]
+
+export function multiply(m: Matrix, [r, g, b]: Rgb): Rgb {
+  return [
+    m[0][0] * r + m[0][1] * g + m[0][2] * b,
+    m[1][0] * r + m[1][1] * g + m[1][2] * b,
+    m[2][0] * r + m[2][1] * g + m[2][2] * b,
+  ]
+}
+
+/** IEC 61966-2-1 sRGB encoding, extended to all reals by odd symmetry. */
+export function srgbEncodeExtended(linear: number): number {
+  const a = Math.abs(linear)
+  const encoded = a <= 0.0031308 ? 12.92 * a : 1.055 * a ** (1 / 2.4) - 0.055
+  return Math.sign(linear) * encoded
+}
+
+export function srgbDecodeExtended(encoded: number): number {
+  const a = Math.abs(encoded)
+  const linear = a <= 0.04045 ? a / 12.92 : ((a + 0.055) / 1.055) ** 2.4
+  return Math.sign(encoded) * linear
+}
+
+// SMPTE ST 2084
+const PQ_M1 = 2610 / 16384
+const PQ_M2 = (2523 / 4096) * 128
+const PQ_C1 = 3424 / 4096
+const PQ_C2 = (2413 / 4096) * 32
+const PQ_C3 = (2392 / 4096) * 32
+
+/** Absolute luminance (cd/m²) → PQ signal in [0, 1]. */
+export function pqEncode(nits: number): number {
+  const y = Math.min(Math.max(nits / PQ_PEAK_NITS, 0), 1) ** PQ_M1
+  return ((PQ_C1 + PQ_C2 * y) / (1 + PQ_C3 * y)) ** PQ_M2
+}
+
+/** PQ signal → absolute luminance (cd/m²). */
+export function pqDecode(signal: number): number {
+  const e = Math.min(Math.max(signal, 0), 1) ** (1 / PQ_M2)
+  return PQ_PEAK_NITS * (Math.max(e - PQ_C1, 0) / (PQ_C2 - PQ_C3 * e)) ** (1 / PQ_M1)
+}
+
+// ITU-R BT.2100 HLG
+const HLG_A = 0.17883277
+const HLG_B = 1 - 4 * HLG_A
+const HLG_C = 0.5 - HLG_A * Math.log(4 * HLG_A)
+
+/** Normalised scene-linear light [0, 1] → HLG signal. */
+export function hlgOetf(scene: number): number {
+  const e = Math.min(Math.max(scene, 0), 1)
+  return e <= 1 / 12 ? Math.sqrt(3 * e) : HLG_A * Math.log(12 * e - HLG_B) + HLG_C
+}
+
+export function hlgInverseOetf(signal: number): number {
+  const e = Math.min(Math.max(signal, 0), 1)
+  return e <= 0.5 ? (e * e) / 3 : (Math.exp((e - HLG_C) / HLG_A) + HLG_B) / 12
+}
+
+/** BT.2100 HLG system gamma for a nominal peak luminance. */
+export function hlgSystemGamma(peakNits: number): number {
+  return 1.2 + 0.42 * Math.log10(peakNits / 1000)
+}
+
+const luminance2020 = ([r, g, b]: Rgb) => 0.2627 * r + 0.678 * g + 0.0593 * b
+
+/** HLG OOTF: normalised scene-linear BT.2020 → display cd/m². */
+export function hlgOotf(scene: Rgb, peakNits = HLG_NOMINAL_PEAK_NITS): Rgb {
+  const gamma = hlgSystemGamma(peakNits)
+  const ys = Math.max(luminance2020(scene), 0)
+  const gain = ys > 0 ? peakNits * ys ** (gamma - 1) : 0
+  return [scene[0] * gain, scene[1] * gain, scene[2] * gain]
+}
+
+/** Inverse HLG OOTF: display cd/m² BT.2020 → normalised scene-linear. */
+export function hlgInverseOotf(display: Rgb, peakNits = HLG_NOMINAL_PEAK_NITS): Rgb {
+  const gamma = hlgSystemGamma(peakNits)
+  const yd = Math.max(luminance2020(display), 0)
+  if (yd <= 0) return [0, 0, 0]
+  const ys = (yd / peakNits) ** (1 / gamma)
+  const scale = 1 / (peakNits * ys ** (gamma - 1))
+  return [display[0] * scale, display[1] * scale, display[2] * scale]
+}
+
+/**
+ * Explicit HDR output conversion: working (extended sRGB, BT.709) → BT.2020 PQ or
+ * HLG signal in [0, 1]. Colours outside BT.2020 and light above the transfer's
+ * peak are clipped here and nowhere earlier. No tone mapping is implied.
+ */
+export function workingToSignal(
+  working: Rgb,
+  transfer: HdrTransfer,
+  referenceWhiteNits = DEFAULT_REFERENCE_WHITE_NITS,
+): Rgb {
+  const linear709: Rgb = [
+    srgbDecodeExtended(working[0]),
+    srgbDecodeExtended(working[1]),
+    srgbDecodeExtended(working[2]),
+  ]
+  const nits = multiply(BT709_TO_BT2020, linear709).map(
+    (v) => Math.max(v, 0) * referenceWhiteNits,
+  ) as unknown as Rgb
+  if (transfer === 'pq') return [pqEncode(nits[0]), pqEncode(nits[1]), pqEncode(nits[2])]
+  const clipped = nits.map((v) => Math.min(v, HLG_NOMINAL_PEAK_NITS)) as unknown as Rgb
+  const scene = hlgInverseOotf(clipped)
+  return [hlgOetf(scene[0]), hlgOetf(scene[1]), hlgOetf(scene[2])]
+}
+
+/** HDR source ingest: BT.2020 PQ/HLG signal → working (extended sRGB, BT.709). */
+export function signalToWorking(
+  signal: Rgb,
+  transfer: HdrTransfer,
+  referenceWhiteNits = DEFAULT_REFERENCE_WHITE_NITS,
+): Rgb {
+  const nits: Rgb =
+    transfer === 'pq'
+      ? [pqDecode(signal[0]), pqDecode(signal[1]), pqDecode(signal[2])]
