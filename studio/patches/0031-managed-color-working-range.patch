+  srgbEncodeExtended,
+  workingToSdrDisplay,
+  workingToSignal,
+} from './managed-color'
+
+describe('managed colour reference transforms (FL-97)', () => {
+  it('defaults every existing project to the SDR reference behaviour', () => {
+    expect(resolveColorManagement(undefined)).toEqual({
+      workingRange: 'sdr',
+      referenceWhiteNits: 203,
+      masteringPeakNits: 1000,
+      sdrMonitoring: 'none',
+    })
+    expect(
+      resolveColorManagement({
+        workingRange: 'hdr',
+        referenceWhiteNits: -1,
+        masteringPeakNits: 100,
+      }),
+    ).toEqual({
+      workingRange: 'hdr',
+      referenceWhiteNits: 203,
+      masteringPeakNits: 203,
+      sdrMonitoring: 'none',
+    })
+  })
+
+  it('matches published PQ values (SMPTE ST 2084)', () => {
+    expect(pqEncode(0)).toBeCloseTo(0, 5)
+    expect(pqEncode(100)).toBeCloseTo(0.5081, 4)
+    expect(pqEncode(203)).toBeCloseTo(0.5807, 4)
+    expect(pqEncode(1000)).toBeCloseTo(0.7518, 4)
+    expect(pqEncode(10000)).toBeCloseTo(1, 6)
+    for (const nits of [0.01, 1, 58, 203, 1000, 4000]) {
+      expect(pqDecode(pqEncode(nits)) / nits).toBeCloseTo(1, 6)
+    }
+  })
+
+  it('matches BT.2100 HLG and BT.2408 reference white (75% → 203 cd/m²)', () => {
+    expect(hlgOetf(1 / 12)).toBeCloseTo(0.5, 6)
+    expect(hlgOetf(1)).toBeCloseTo(1, 6)
+    for (const scene of [0.001, 0.05, 1 / 12, 0.3, 0.9]) {
+      expect(hlgInverseOetf(hlgOetf(scene))).toBeCloseTo(scene, 7)
+    }
+    const white = hlgOotf([hlgInverseOetf(0.75), hlgInverseOetf(0.75), hlgInverseOetf(0.75)])
+    expect(white[0]).toBeCloseTo(203, 0)
+    const back = hlgInverseOotf(white)
+    expect(hlgOetf(back[1])).toBeCloseTo(0.75, 6)
+  })
+
+  it('keeps sign and range through the extended sRGB transfer', () => {
+    for (const v of [-2, -0.5, -0.001, 0, 0.002, 0.5, 1, 4.5]) {
+      expect(srgbDecodeExtended(srgbEncodeExtended(v))).toBeCloseTo(v, 9)
+    }
+    expect(srgbEncodeExtended(1)).toBeCloseTo(1, 9)
+    expect(srgbEncodeExtended(-1)).toBeCloseTo(-1, 9)
+  })
+
+  it('round-trips BT.709 and BT.2020 primaries', () => {
+    const colour = [0.2, 0.7, -0.1] as const
+    const back = multiply(BT2020_TO_BT709, multiply(BT709_TO_BT2020, colour))
+    back.forEach((v, i) => expect(v).toBeCloseTo(colour[i]!, 5))
+    // BT.2020 green is outside BT.709: it needs negative working values.
+    expect(Math.min(...multiply(BT2020_TO_BT709, [0, 1, 0]))).toBeLessThan(0)
+  })
+
+  it('maps reference white to 203 cd/m² in PQ and to 75% in HLG', () => {
+    const pq = workingToSignal([1, 1, 1], 'pq')
+    pq.forEach((v) => expect(v).toBeCloseTo(pqEncode(203), 4))
+    const hlg = workingToSignal([1, 1, 1], 'hlg')
+    hlg.forEach((v) => expect(v).toBeCloseTo(0.75, 3))
+  })
+
+  it('carries highlights and wide gamut from source to output without clipping', () => {
+    // A 1000-nit BT.2020 green PQ source survives ingest and export.
+    const source = [pqEncode(40), pqEncode(1000), pqEncode(10)] as const
+    const working = signalToWorking(source, 'pq')
+    expect(Math.max(...working)).toBeGreaterThan(1)
+    expect(Math.min(...working)).toBeLessThan(0)
+    const out = workingToSignal(working, 'pq')
+    out.forEach((v, i) => expect(v).toBeCloseTo(source[i]!, 4))
+    // HLG in and out, same round trip.
+    const hlgSource = [0.3, 0.9, 0.1] as const
+    const hlgOut = workingToSignal(signalToWorking(hlgSource, 'hlg'), 'hlg')
+    hlgOut.forEach((v, i) => expect(v).toBeCloseTo(hlgSource[i]!, 3))
+  })
+
+  it('maps SDR sources to reference white, not to a brighter guess', () => {
+    const sdrWhite = workingToSignal([1, 1, 1], 'pq', 203)
+    expect(pqDecode(sdrWhite[0])).toBeCloseTo(203, 1)
+    const midGrey = workingToSignal(
+      [srgbEncodeExtended(0.18), srgbEncodeExtended(0.18), srgbEncodeExtended(0.18)],
+      'pq',
+    )
+    expect(pqDecode(midGrey[1])).toBeCloseTo(0.18 * 203, 1)
+  })
+
+  it('tone maps only when the policy says so', () => {
+    const color = resolveColorManagement({ workingRange: 'hdr' })
+    const highlight = [2, 2, 2] as const
+    expect(workingToSdrDisplay(highlight, color)).toEqual([1, 1, 1])
+    const mapped = workingToSdrDisplay([2, 1, 0.5], { ...color, sdrMonitoring: 'bt2390' })
+    mapped.forEach((v) => expect(v).toBeLessThanOrEqual(1))
+    // Hue is kept: channel order survives, unlike per-channel clipping.
+    expect(mapped[0]).toBeGreaterThan(mapped[1]!)
+    expect(mapped[1]).toBeGreaterThan(mapped[2]!)
+    // Below the knee the EETF is the identity.
+    expect(bt2390Eetf(20, 1000, 203)).toBeCloseTo(20, 1)
+    expect(bt2390Eetf(1000, 1000, 203)).toBeCloseTo(203, 0)
+    expect(bt2390Eetf(5000, 1000, 203)).toBeLessThanOrEqual(203)
+    // SDR projects never tone map.
+    expect(workingToSdrDisplay([0.5, 0.25, 1.4], resolveColorManagement(undefined))).toEqual([
+      0.5, 0.25, 1,
+    ])
+  })
+})
