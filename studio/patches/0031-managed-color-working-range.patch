+// @vitest-environment node
+import { describe, expect, it } from 'vite-plus/test'
+import {
+  BT2020_TO_BT709,
+  BT709_TO_BT2020,
+  bt2390Eetf,
+  hlgInverseOetf,
+  hlgInverseOotf,
+  hlgOetf,
+  hlgOotf,
+  multiply,
+  pqDecode,
+  pqEncode,
+  resolveColorManagement,
+  signalToWorking,
