+  // Premultiply before any linear sampling so hidden RGB cannot bleed into edges.
+  private premultiplyInputs(
+    left: GPUTexture,
+    right: GPUTexture,
+    encoder: GPUCommandEncoder,
+  ): GPUTexture[] {
+    if (!this.premultiplyPipeline) {
+      const module = this.device.createShaderModule({
+        label: 'transition-premultiply',
+        code: `${TRANSITION_COMMON_WGSL}
+@group(0) @binding(0) var source: texture_2d<f32>;
+@fragment
+fn premultiplyFragment(input: VertexOutput) -> @location(0) vec4f {
+  let color = textureLoad(source, vec2i(input.position.xy), 0);
+  return vec4f(color.rgb * color.a, color.a);
+}`,
+      })
+      this.premultiplyPipeline = this.device.createRenderPipeline({
+        label: 'transition-premultiply',
+        layout: 'auto',
+        vertex: { module, entryPoint: 'vertexMain' },
+        fragment: { module, entryPoint: 'premultiplyFragment', targets: [{ format: 'rgba16float' }] },
+        primitive: { topology: 'triangle-list' },
+      })
+    }
+    if (this.premultipliedInputs[0]?.width !== left.width || this.premultipliedInputs[0]?.height !== left.height) {
+      for (const texture of this.premultipliedInputs) texture.destroy()
+      this.premultipliedInputs = [left, right].map(() => this.device.createTexture({
+        size: [left.width, left.height],
+        format: 'rgba16float',
+        usage: GPUTextureUsage.RENDER_ATTACHMENT | GPUTextureUsage.TEXTURE_BINDING,
+      }))
+    }
+    for (const [index, texture] of [left, right].entries()) {
+      const pass = encoder.beginRenderPass({
+        colorAttachments: [{ view: this.premultipliedInputs[index]!.createView(), loadOp: 'clear', storeOp: 'store' }],
+      })
+      pass.setPipeline(this.premultiplyPipeline)
+      pass.setBindGroup(0, this.device.createBindGroup({
+        layout: this.premultiplyPipeline.getBindGroupLayout(0),
+        entries: [{ binding: 0, resource: texture.createView() }],
+      }))
+      pass.draw(6)
+      pass.end()
+    }
+    return this.premultipliedInputs
+  }
