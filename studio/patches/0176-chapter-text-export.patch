+import type { ProjectMarker } from '@/types/timeline'
+
+export type ChapterIssue = {
+  reason:
+    | 'invalidSequence'
+    | 'tooFew'
+    | 'firstZero'
+    | 'blankName'
+    | 'outOfBounds'
+    | 'duplicateSecond'
+    | 'shortInterval'
+  index?: number
+}
+
+function timestamp(seconds: number): string {
+  const hours = Math.floor(seconds / 3600)
+  const minutes = Math.floor(seconds / 60) % 60
+  const tail = `${String(minutes).padStart(2, '0')}:${String(seconds % 60).padStart(2, '0')}`
+  return hours ? `${hours}:${tail}` : tail
+}
+
+/** Read-only export: unnamed markers are errors, never generated chapter titles. */
+export function buildChapterText(
+  markers: readonly ProjectMarker[],
+  fps: number,
+  durationInFrames: number,
+) {
+  const issues: ChapterIssue[] = []
+  const durationSeconds = durationInFrames / fps
+  if (
+    !Number.isFinite(fps) ||
+    fps <= 0 ||
+    !Number.isSafeInteger(durationInFrames) ||
+    durationInFrames <= 0 ||
+    !Number.isSafeInteger(Math.floor(durationSeconds))
+  ) {
+    return { text: '', issues: [{ reason: 'invalidSequence' } as ChapterIssue] }
+  }
+  const sorted = [...markers].sort((a, b) => a.frame - b.frame)
+  if (sorted.length < 3) issues.push({ reason: 'tooFew' })
+  if (sorted.length && sorted[0]!.frame !== 0) issues.push({ reason: 'firstZero' })
+  const seen = new Set<number>()
+  const lines = sorted.map((marker, i) => {
+    const index = i + 1
+    const label = (marker.label ?? '').replace(/[\r\n\u0085\u2028\u2029]+/gu, ' ').trim()
+    if (!label) issues.push({ reason: 'blankName', index })
+    if (
+      !Number.isSafeInteger(marker.frame) ||
+      marker.frame < 0 ||
+      marker.frame >= durationInFrames
+    ) {
+      issues.push({ reason: 'outOfBounds', index })
+      return ''
+    }
+    const seconds = Math.floor(marker.frame / fps)
+    if (seen.has(seconds)) issues.push({ reason: 'duplicateSecond', index })
+    seen.add(seconds)
+    const next = sorted[i + 1]
+    const endSeconds = next ? Math.floor(next.frame / fps) : durationSeconds
+    // Validate authored spacing as well as the whole-second text viewers consume.
+    if (
+      ((next?.frame ?? durationInFrames) - marker.frame) / fps < 10 ||
+      endSeconds - seconds < 10
+    ) {
+      issues.push({ reason: 'shortInterval', index })
+    }
+    return `${timestamp(seconds)} ${label}`
+  })
+  return { text: issues.length ? '' : lines.join('\n'), issues }
+}
