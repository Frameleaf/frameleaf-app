+import { useState } from 'react'
+import { useTranslation } from 'react-i18next'
+import { Button } from '@/components/ui/button'
+import {
+  Dialog,
+  DialogContent,
+  DialogDescription,
+  DialogHeader,
+  DialogTitle,
+} from '@/components/ui/dialog'
+import {
+  useCompositionsStore,
+  useCompositionNavigationStore,
+  useTimelineStore,
+} from '@/features/editor/deps/timeline-store'
+import { buildChapterText } from '@/shared/timeline/chapter-text'
+
+export function ChapterExport() {
+  const { t } = useTranslation()
+  const markers = useTimelineStore((s) => s.markers)
+  const fps = useTimelineStore((s) => s.fps)
+  const rootDuration = useTimelineStore((s) =>
+    s.items.reduce((end, item) => Math.max(end, item.from + item.durationInFrames), 0),
+  )
+  const activeId = useCompositionNavigationStore((s) => s.activeCompositionId)
+  const composition = useCompositionsStore((s) =>
+    activeId ? s.compositionById[activeId] : undefined,
+  )
+  const result = buildChapterText(
+    markers,
+    composition?.fps ?? fps,
+    composition?.durationInFrames ?? rootDuration,
+  )
+  const [open, setOpen] = useState(false)
+  const [feedback, setFeedback] = useState('')
+  const [busy, setBusy] = useState(false)
+
+  async function copy() {
+    setBusy(true)
+    try {
+      await navigator.clipboard.writeText(result.text)
+      setFeedback(t('chapterExport.copied'))
+    } catch {
+      setFeedback(t('chapterExport.copyFailed'))
+    } finally {
+      setBusy(false)
+    }
+  }
+
+  function download() {
+    let url: string | undefined
+    const link = document.createElement('a')
+    try {
+      url = URL.createObjectURL(new Blob([result.text], { type: 'text/plain;charset=utf-8' }))
+      link.href = url
+      link.download = 'chapters.txt'
+      document.body.append(link)
+      link.click()
+      setFeedback(t('chapterExport.downloadStarted'))
+    } catch {
+      setFeedback(t('chapterExport.downloadFailed'))
+    } finally {
+      link.remove()
+      // Keep the blob alive until the browser has consumed the download request.
+      if (url) {
+        const objectUrl = url
+        setTimeout(() => URL.revokeObjectURL(objectUrl), 1000)
+      }
+    }
+  }
+
+  return (
+    <>
+      <Button
+        variant="outline"
+        size="sm"
+        className="w-full text-xs"
+        onClick={() => {
+          setFeedback('')
+          setOpen(true)
+        }}
+      >
+        {t('chapterExport.title')}
+      </Button>
+      <Dialog open={open} onOpenChange={setOpen}>
+        <DialogContent>
+          <DialogHeader>
+            <DialogTitle>{t('chapterExport.title')}</DialogTitle>
+            <DialogDescription>{t('chapterExport.description')}</DialogDescription>
+          </DialogHeader>
+          {result.issues.length ? (
+            <ul
+              className="max-h-60 overflow-auto text-sm space-y-2"
+              aria-label={t('chapterExport.validation')}
+            >
+              {result.issues.map((issue, index) => (
+                <li key={index}>{t(`chapterExport.${issue.reason}`, { index: issue.index })}</li>
+              ))}
+            </ul>
+          ) : (
+            <textarea
+              aria-label={t('chapterExport.preview')}
+              readOnly
+              value={result.text}
+              className="h-60 w-full resize-y border rounded p-2 font-mono text-sm"
+            />
+          )}
+          <div className="flex gap-2">
+            <Button disabled={!!result.issues.length || busy} onClick={() => void copy()}>
+              {t('chapterExport.copy')}
+            </Button>
+            <Button disabled={!!result.issues.length} onClick={download}>
+              {t('chapterExport.download')}
+            </Button>
+          </div>
+          <p role="status" className="text-sm">
+            {feedback}
+          </p>
+        </DialogContent>
+      </Dialog>
+    </>
+  )
+}
