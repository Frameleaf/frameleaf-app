+import { fireEvent, render, screen, waitFor, cleanup } from '@testing-library/react'
+import { beforeEach, afterEach, describe, expect, it, vi } from 'vite-plus/test'
+import { ChapterExport } from './chapter-export'
+
+const state = vi.hoisted(() => ({
+  timeline: {
+    fps: 30,
+    items: [{ from: 0, durationInFrames: 900 }],
+    markers: [
+      { id: 'a', frame: 0, label: 'Intro 😀', color: '#fff' },
+      { id: 'b', frame: 300, label: 'Middle', color: '#fff' },
+      { id: 'c', frame: 600, label: 'End', color: '#fff' },
+    ],
+  },
+  navigation: { activeCompositionId: null as string | null },
+  compositions: {
+    compositionById: {} as Record<string, { fps: number; durationInFrames: number }>,
+  },
+}))
+vi.mock('@/features/editor/deps/timeline-store', () => ({
+  useTimelineStore: (selector: (s: typeof state.timeline) => unknown) => selector(state.timeline),
+  useCompositionNavigationStore: (selector: (s: typeof state.navigation) => unknown) =>
+    selector(state.navigation),
+  useCompositionsStore: (selector: (s: typeof state.compositions) => unknown) =>
+    selector(state.compositions),
+}))
+
+const open = () => {
+  const result = render(<ChapterExport />)
+  fireEvent.click(screen.getByRole('button', { name: 'Export YouTube chapters' }))
+  return result
+}
+
+describe('chapter export controls', () => {
+  beforeEach(() => {
+    state.timeline.markers[0]!.label = 'Intro 😀'
+    state.navigation.activeCompositionId = null
+    state.compositions.compositionById = {}
+    vi.stubGlobal('navigator', {
+      ...navigator,
+      clipboard: { writeText: vi.fn().mockResolvedValue(undefined) },
+    })
+  })
+  afterEach(() => {
+    cleanup()
+    vi.restoreAllMocks()
+    vi.unstubAllGlobals()
+  })
+
+  it('previews and copies the active markers without modifying timeline state', async () => {
+    const before = structuredClone(state)
+    open()
+    const text = '00:00 Intro 😀\n00:10 Middle\n00:20 End'
+    expect(screen.getByRole('textbox', { name: 'Chapter text preview' })).toHaveValue(text)
+    fireEvent.click(screen.getByRole('button', { name: 'Copy text' }))
+    await waitFor(() =>
+      expect(screen.getByRole('status')).toHaveTextContent('Chapter text copied.'),
+    )
+    expect(navigator.clipboard.writeText).toHaveBeenCalledWith(text)
+    expect(state).toEqual(before)
+  })
+  it('recomputes validation when marker names change and blocks invalid copy/download', () => {
+    const view = open()
+    state.timeline.markers[0]!.label = ''
+    view.rerender(<ChapterExport />)
+    expect(screen.getByText('Marker 1 needs a chapter name.')).toBeInTheDocument()
+    expect(screen.getByRole('button', { name: 'Copy text' })).toBeDisabled()
+    expect(screen.getByRole('button', { name: 'Download text' })).toBeDisabled()
+    expect(screen.queryByRole('textbox')).not.toBeInTheDocument()
+  })
+  it('uses active sequence duration and FPS instead of the root timeline', () => {
+    state.navigation.activeCompositionId = 'sequence'
+    state.compositions.compositionById.sequence = { fps: 60, durationInFrames: 1800 }
+    open()
+    expect(
+      screen.getByText('Chapter 1 must last at least ten seconds, including the final chapter.'),
+    ).toBeInTheDocument()
+    expect(screen.getByRole('button', { name: 'Copy text' })).toBeDisabled()
+  })
+  it('explains clipboard denial with manual copy/download recovery', async () => {
+    vi.mocked(navigator.clipboard.writeText).mockRejectedValue(new Error('denied'))
+    open()
+    fireEvent.click(screen.getByRole('button', { name: 'Copy text' }))
+    await waitFor(() => expect(screen.getByRole('status')).toHaveTextContent('Could not copy.'))
+    expect(screen.getByRole('textbox')).toBeInTheDocument()
+  })
+  it('downloads a local UTF-8 text blob and releases its URL', () => {
+    vi.useFakeTimers()
+    const create = vi.fn().mockReturnValue('blob:chapters')
+    const revoke = vi.fn()
+    vi.stubGlobal('URL', { createObjectURL: create, revokeObjectURL: revoke })
+    const click = vi.spyOn(HTMLAnchorElement.prototype, 'click').mockImplementation(() => {})
+    open()
+    fireEvent.click(screen.getByRole('button', { name: 'Download text' }))
+    const blob = create.mock.calls[0]![0] as Blob
+    expect(blob.type).toBe('text/plain;charset=utf-8')
+    expect(blob.size).toBe(
+      new TextEncoder().encode('00:00 Intro 😀\n00:10 Middle\n00:20 End').length,
+    )
+    expect(click).toHaveBeenCalledOnce()
+    expect(screen.getByRole('status')).toHaveTextContent('Download requested.')
+    vi.runOnlyPendingTimers()
+    expect(revoke).toHaveBeenCalledWith('blob:chapters')
+    vi.useRealTimers()
+  })
+  it('explains download failures and leaves copy available', () => {
+    vi.stubGlobal('URL', {
+      createObjectURL: vi.fn().mockImplementation(() => {
+        throw new Error('blocked')
+      }),
+    })
+    open()
+    fireEvent.click(screen.getByRole('button', { name: 'Download text' }))
+    expect(screen.getByRole('status')).toHaveTextContent('Could not start the download.')
+    expect(screen.getByRole('button', { name: 'Copy text' })).toBeEnabled()
+  })
+})
