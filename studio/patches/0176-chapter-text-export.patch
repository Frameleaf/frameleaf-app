+// @vitest-environment node
+import { describe, expect, it } from 'vite-plus/test'
+import { buildChapterText } from './chapter-text'
+import type { ProjectMarker } from '@/types/timeline'
+
+const marker = (frame: number, label = 'Chapter'): ProjectMarker => ({
+  id: String(frame),
+  frame,
+  label,
+  color: '#fff',
+})
+const chapters = [marker(0, 'Start'), marker(300, 'Middle'), marker(600, 'End')]
+const reasons = (markers = chapters, fps = 30, duration = 900) =>
+  buildChapterText(markers, fps, duration).issues.map((issue) => issue.reason)
+
+describe('YouTube chapter text', () => {
+  it('sorts a copy, sanitizes line separators, preserves Unicode and does not mutate authored markers', () => {
+    const input = Object.freeze([
+      Object.freeze(marker(600, '東京 😀')),
+      Object.freeze(marker(0, ' Intro\r\nPart\u2028one ')),
+      Object.freeze(marker(300, 'Café')),
+    ])
+    expect(buildChapterText(input, 30, 900)).toEqual({
+      text: '00:00 Intro Part one\n00:10 Café\n00:20 東京 😀',
+      issues: [],
+    })
+    expect(input.map((m) => m.frame)).toEqual([600, 0, 300])
+  })
+  it('maps fractional FPS using current sequence rate and formats hour timestamps', () => {
+    expect(
+      buildChapterText([marker(0), marker(300), marker(108000)], 30000 / 1001, 108600).text,
+    ).toBe('00:00 Chapter\n00:10 Chapter\n1:00:03 Chapter')
+  })
+  it('requires three named markers and actual frame zero, never fills names or moves frames', () => {
+    expect(reasons([])).toContain('tooFew')
+    expect(reasons(chapters.slice(0, 2))).toContain('tooFew')
+    expect(reasons([marker(1), ...chapters.slice(1)])).toContain('firstZero')
+    expect(reasons([marker(0, ' \n '), ...chapters.slice(1)])).toContain('blankName')
+    expect(buildChapterText([marker(0, ''), ...chapters.slice(1)], 30, 900).text).toBe('')
+  })
+  it('rejects duplicate whole-second timestamps and intervals below ten seconds', () => {
+    expect(reasons([marker(0), marker(1), marker(600)])).toContain('duplicateSecond')
+    expect(reasons([marker(0), marker(299), marker(600)])).toContain('shortInterval')
+    expect(reasons(chapters, 30, 899)).toContain('shortInterval')
+    expect(reasons()).toEqual([])
+    // Integer-second output must also retain a ten-second interval.
+    expect(reasons([marker(0), marker(329), marker(628)], 30, 1000)).toContain('shortInterval')
+  })
+  it.each([-1, 900, NaN, Infinity, 0.5])(
+    'rejects out-of-bounds or invalid marker frame %s',
+    (frame) => {
+      expect(reasons([...chapters, marker(frame)])).toContain('outOfBounds')
+    },
+  )
+  it.each([0, -1, NaN, Infinity, Number.MIN_VALUE])('rejects invalid FPS %s', (fps) => {
+    expect(reasons(chapters, fps)).toContain('invalidSequence')
+  })
+  it.each([0, -1, NaN, Infinity, 900.5, Number.MAX_VALUE])(
+    'rejects invalid duration %s',
+    (duration) => {
+      expect(reasons(chapters, 30, duration)).toContain('invalidSequence')
+    },
+  )
+})
