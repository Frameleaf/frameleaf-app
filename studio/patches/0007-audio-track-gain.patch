diff --git a/src/features/export/utils/canvas-audio.test.ts b/src/features/export/utils/canvas-audio.test.ts
--- a/src/features/export/utils/canvas-audio.test.ts
+++ b/src/features/export/utils/canvas-audio.test.ts
@@ -890,6 +890,44 @@
         expect(fetchMock).toHaveBeenCalledWith('blob:mediabunny-fails')
       } finally {
         vi.unstubAllGlobals()
+      }
+    },
+  )
+
+  it.each(['audio', 'video'] as const)(
+    'keeps track and master gain independent of %s clip automation in both mix paths',
+    async (kind) => {
+      const item = kind === 'audio' ? makeAudioItem({ volume: -3 }) : makeVideoItem({ volume: -3 })
+      const composition = dspComposition({})
+      composition.tracks = [
+        { ...makeTrack({ id: item.trackId, order: 0, kind, items: [item] }), volume: -12 },
+      ]
+      composition.masterBusDb = -6
+      composition.keyframes = [
+        {
+          itemId: item.id,
+          properties: [
+            {
+              property: 'volume',
+              keyframes: [
+                { id: 'gain-start', frame: 0, value: -6, easing: 'linear' },
+                { id: 'gain-end', frame: 30, value: 0, easing: 'linear' },
+              ],
+            },
+          ],
+        },
+      ]
+
+      const full = await processAudio(composition)
+      expect(full).not.toBeNull()
+      const windows = []
+      for await (const window of processAudioWindows(composition)) windows.push(window)
+      expect(windows).toHaveLength(1)
+      for (const mixed of [full!, windows[0]!]) {
+        for (const samples of mixed.samples) {
+          expect(samples[0]).toBeCloseTo(0.1 * 10 ** ((-6 - 12 - 6) / 20), 7)
+          expect(samples[48_000]).toBeCloseTo(0.1 * 10 ** ((0 - 12 - 6) / 20), 7)
+        }
       }
     },
   )
