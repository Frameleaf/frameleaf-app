+import { render, screen } from '@testing-library/react'
+import { describe, expect, it } from 'vite-plus/test'
+import type { TimelineTrack } from '@/types/timeline'
+import { MiniTimelineTrackLanes } from './mini-timeline-track-lanes'
+
+const tracks = [{ id: 'v1', name: 'V1' }] as unknown as TimelineTrack[]
+const clip = (id: string, type: 'video' | 'image', from: number) => ({
+  id,
+  trackId: 'v1',
+  from,
+  durationInFrames: 30,
+  label: id,
+  type,
+})
+
+describe('Colour clip strip (FL-1822)', () => {
+  it('draws clips in their kind colour and marks the selected one with the accent outline only', () => {
+    render(
+      <MiniTimelineTrackLanes
+        tracks={tracks}
+        clips={[clip('harbour', 'video', 0), clip('lake', 'image', 30)]}
+        selectedIds={new Set(['harbour'])}
+        maxFrame={60}
+        trackAreaHeight={20}
+        labelWidth={20}
+        onSelectClip={() => {}}
+      />,
+    )
+    const harbour = screen.getByRole('button', { name: 'harbour' })
+    const lake = screen.getByRole('button', { name: 'lake' })
+    expect(harbour.className).toContain('border-primary')
+    expect(harbour.className).toContain('bg-timeline-video')
+    expect(harbour.className).not.toContain('bg-primary')
+    expect(lake.className).toContain('bg-timeline-image/40')
+    expect(lake.className).not.toContain('sky-')
+  })
+})
