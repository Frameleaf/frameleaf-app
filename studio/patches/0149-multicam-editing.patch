+import type { AudioItem, TimelineItem, TimelineTrack, VideoItem } from '@/types/timeline'
+import { useItemsStore } from '../../items-store'
+import { useTimelineSettingsStore } from '../../timeline-settings-store'
+import { execute } from '../shared'
+import { hasLockedEditParticipants } from '../linked-edit'
+import { getOrDecodeAudioSliceForPlayback } from '@/features/timeline/deps/composition-runtime'
+import { resolveMediaUrl } from '@/features/timeline/deps/media-library-resolver'
+import { getLinkedItems } from '../../../utils/linked-items'
+import {
+  MULTICAM_SYNC_ALGORITHM,
+  onsetEnvelope,
+  syncRecordings,
+  type SyncResult,
+} from '@/shared/utils/multicam-sync'
+
+/**
+ * Multicamera editing (FL-595), built from ordinary clips:
+ * - each angle stays a normal video clip (with its linked audio) on its own
+ *   track, moved so that one timeline frame shows the same moment in every
+ *   angle; angle tracks are hidden;
+ * - the master audio is one angle's linked audio, left audible; the other
+ *   angles' audio is muted, so camera sound is never doubled;
+ * - a "program" video track on top holds the cut: video-only copies of the
+ *   angle clips with matching source ranges. Cutting replaces the program
+ *   from the playhead to the next cut with another angle.
+ * Grouping, offsets and the master choice live in the tracks' `multicam`
+ * record so the edit can be revisited; playback and export see plain clips.
+ */
+
+const MAX_ANGLES = 4
+
+export interface MulticamAngleRecord {
+  trackId: string
+  itemId: string
+  mediaId: string | undefined
+  /** Seconds added to a reference source time to reach this angle's source time. */
+  offsetSeconds: number
+}
+
+export interface MulticamGroupRecord {
+  groupId: string
+  role: 'program' | 'angle'
+  algorithm?: typeof MULTICAM_SYNC_ALGORITHM | 'manual'
+  referenceItemId?: string
+  masterAudioItemId?: string
+  angles?: MulticamAngleRecord[]
+}
+
+type TrackWithMulticam = TimelineTrack & { multicam?: MulticamGroupRecord }
+type ItemWithMulticam = TimelineItem & { multicam?: { groupId: string; angle: number } }
+
+export type MulticamRefusal =
+  | 'angle-count'
+  | 'not-found'
+  | 'unsupported-clip'
+  | 'retimed'
+  | 'shared-track'
+  | 'locked'
+  | 'master-needs-audio-clip'
+  | 'decode-failed'
+  | 'no-group'
+  | 'no-program-clip'
+  | 'no-coverage'
+  | 'before-start'
+  | 'already-multicam'
+  | 'generated-media'
+
+export interface MulticamSyncProposal {
+  itemId: string
+  label: string
+  sync: SyncResult
+}
+
+function linkedAudioOf(items: readonly TimelineItem[], item: TimelineItem): AudioItem | undefined {
+  return getLinkedItems(items as TimelineItem[], item.id).find((linked): linked is AudioItem => linked.type === 'audio')
+}
+
+function checkAngles(items: readonly TimelineItem[], ids: readonly string[]): MulticamRefusal | null {
+  if (ids.length < 2 || ids.length > MAX_ANGLES || new Set(ids).size !== ids.length) return 'angle-count'
+  const angles = ids.map((id) => items.find((item) => item.id === id))
+  if (angles.some((item) => !item)) return 'not-found'
+  if (angles.some((item) => item!.type !== 'video')) return 'unsupported-clip'
+  // Generated clips have no media file to sync by, and the angle record names the media.
+  if (angles.some((item) => !item!.mediaId)) return 'generated-media'
+  if (angles.some((item) => (item as VideoItem).speed !== undefined && (item as VideoItem).speed !== 1)) return 'retimed'
+  if (angles.some((item) => (item as VideoItem).isReversed === true)) return 'retimed'
+  return null
+}
+
+async function decodeEnvelope(item: TimelineItem, items: readonly TimelineItem[], signal?: AbortSignal): Promise<Float32Array | null> {
+  const owner = linkedAudioOf(items, item) ?? item
+  if (!owner.mediaId) return null
+  const url = await resolveMediaUrl(owner.mediaId)
+  if (signal?.aborted) throw new DOMException('Sync cancelled', 'AbortError')
+  if (!url) return null
+  const durationSeconds = (owner as VideoItem).sourceDuration !== undefined
+    ? (owner as VideoItem).sourceDuration! / ((owner as VideoItem).sourceFps ?? 30)
+    : 3600
+  const slice = await getOrDecodeAudioSliceForPlayback(owner.mediaId, url, {
+    targetTimeSeconds: 0, minReadySeconds: durationSeconds, preRollSeconds: 0, waitTimeoutMs: 0,
+  })
+  if (signal?.aborted) throw new DOMException('Sync cancelled', 'AbortError')
+  const { buffer } = slice
+  return onsetEnvelope({
+    sampleRate: buffer.sampleRate,
+    channels: Array.from({ length: buffer.numberOfChannels }, (_, c) => buffer.getChannelData(c)),
+  })
+}
+
+/** Align each angle's whole recording to the reference's by sound. Nothing changes in the project. */
+export async function analyzeMulticamSync(
+  itemIds: readonly string[],
+  referenceId: string,
+  signal?: AbortSignal,
+): Promise<{ ok: true; proposals: MulticamSyncProposal[] } | { ok: false; reason: MulticamRefusal }> {
+  const items = useItemsStore.getState().items
+  const refusal = checkAngles(items, itemIds)
+  if (refusal) return { ok: false, reason: refusal }
+  if (!itemIds.includes(referenceId)) return { ok: false, reason: 'not-found' }
+  const fps = useTimelineSettingsStore.getState().fps
+  try {
+    const reference = await decodeEnvelope(items.find((item) => item.id === referenceId)!, items, signal)
+    if (signal?.aborted) throw new DOMException('Sync cancelled', 'AbortError')
+    if (!reference) return { ok: false, reason: 'decode-failed' }
+    const proposals: MulticamSyncProposal[] = []
+    for (const id of itemIds) {
+      if (signal?.aborted) throw new DOMException('Sync cancelled', 'AbortError')
+      if (id === referenceId) continue
+      const item = items.find((candidate) => candidate.id === id)!
+      const envelope = await decodeEnvelope(item, items, signal)
+      if (signal?.aborted) throw new DOMException('Sync cancelled', 'AbortError')
+      proposals.push({
+        itemId: id,
+        label: item.label,
+        sync: envelope
+          ? syncRecordings(reference, envelope, { frameSeconds: 1 / fps })
+          : { offsetSeconds: 0, score: 0, flags: ['no-match'], driftSeconds: null },
+      })
+    }
+    return { ok: true, proposals }
+  } catch (error) {
+    if (error instanceof DOMException && error.name === 'AbortError') throw error
+    return { ok: false, reason: 'decode-failed' }
+  }
+}
+
+const sourceSeconds = (item: VideoItem | AudioItem, fps: number) => (item.sourceStart ?? 0) / (item.sourceFps ?? fps)
+
+/**
+ * Create the multicamera edit in one undo step. `angles` gives each angle's
+ * approved offset (the reference's is 0; manual offsets are allowed for
+ * angles whose analysis failed). The master audio is the linked audio of
+ * `masterItemId`.
+ */
+export function createMulticamEdit(params: {
+  referenceId: string
+  angles: ReadonlyArray<{ itemId: string; offsetSeconds: number; manual?: boolean }>
+  masterItemId: string
+}): { ok: true; groupId: string } | { ok: false; reason: MulticamRefusal } {
+  const { items, tracks } = useItemsStore.getState()
+  const ids = params.angles.map((angle) => angle.itemId)
+  const refusal = checkAngles(items, ids)
+  if (refusal) return { ok: false, reason: refusal }
+  const angleItems = ids.map((id) => items.find((item) => item.id === id) as VideoItem)
+  const reference = angleItems.find((item) => item.id === params.referenceId)
+  const master = angleItems.find((item) => item.id === params.masterItemId)
+  if (!reference || !master) return { ok: false, reason: 'not-found' }
+  const masterAudio = linkedAudioOf(items, master)
+  if (!masterAudio) return { ok: false, reason: 'master-needs-audio-clip' }
+
+  // Each angle and its audio must own their tracks, so hiding or muting a track affects only that angle.
+  const participants = angleItems.flatMap((item) => [item, ...getLinkedItems(items, item.id).filter((l) => l.id !== item.id)])
+  const participantIds = new Set(participants.map((item) => item.id))
+  const angleTrackIds = angleItems.map((item) => item.trackId)
+  if (new Set(angleTrackIds).size !== angleTrackIds.length
+    || items.some((item) => angleTrackIds.includes(item.trackId) && !participantIds.has(item.id))) {
+    return { ok: false, reason: 'shared-track' }
+  }
+  // An angle already in a group would be claimed twice, leaving the first group stale. Program records
+  // name their angle items, which catches an angle moved off its group's track.
+  const claimed = new Set((tracks as TrackWithMulticam[]).flatMap((track) =>
+    track.multicam?.role === 'program' ? (track.multicam.angles ?? []).map((angle) => angle.itemId) : []))
+  if (ids.some((id) => claimed.has(id))
+    || (tracks as TrackWithMulticam[]).some((track) => angleTrackIds.includes(track.id) && track.multicam)) {
+    return { ok: false, reason: 'already-multicam' }
+  }
+  if (hasLockedEditParticipants(participants)) return { ok: false, reason: 'locked' }
+
+  const fps = useTimelineSettingsStore.getState().fps
+  const groupId = crypto.randomUUID()
+  const moves: Array<{ id: string; from: number }> = []
+  const offsets = new Map(params.angles.map((angle) => [angle.itemId, angle.itemId === params.referenceId ? 0 : angle.offsetSeconds]))
+  for (const item of angleItems) {
+    // Same moment: reference source s at frame t ⇔ angle source s + offset at frame t.
+    const from = reference.from + Math.round((sourceSeconds(item, fps) - sourceSeconds(reference, fps) - offsets.get(item.id)!) * fps)
+    const delta = from - item.from
+    if (delta === 0) continue
+    for (const member of [item, ...getLinkedItems(items, item.id).filter((l) => l.id !== item.id)]) {
+      moves.push({ id: member.id, from: member.from + delta })
+    }
+  }
+  // Lining up would put a recording that started earlier before the start of the timeline.
+  if (moves.some((move) => move.from < 0)) return { ok: false, reason: 'before-start' }
+
+  const programTrackId = `multicam-program-${groupId}`
+  const topOrder = Math.min(...tracks.map((track) => track.order))
+  const programTrack: TrackWithMulticam = {
+    id: programTrackId, name: 'Multicam', kind: 'video', order: topOrder - 1, height: 80,
+    locked: false, syncLock: true, visible: true, muted: false, solo: false, volume: 0, items: [],
+    multicam: {
+      groupId, role: 'program',
+      algorithm: params.angles.some((angle) => angle.manual) ? 'manual' : MULTICAM_SYNC_ALGORITHM,
+      referenceItemId: reference.id, masterAudioItemId: masterAudio.id,
+      angles: angleItems.map((item) => ({ trackId: item.trackId, itemId: item.id, mediaId: item.mediaId, offsetSeconds: offsets.get(item.id)! })),
+    },
+  }
+
+  execute('CREATE_MULTICAM_EDIT', () => {
+    const store = useItemsStore.getState()
+    if (moves.length > 0) store._moveItems(moves)
+    const angleTrackSet = new Set(angleTrackIds)
+    store.setTracks([
+      programTrack,
+      ...store.tracks.map((track): TrackWithMulticam => angleTrackSet.has(track.id)
+        ? { ...track, visible: false, multicam: { groupId, role: 'angle' } }
+        : track),
+    ])
+    // Only the master audio stays audible; other cameras' sound is muted, never doubled.
+    for (const item of angleItems) {
+      const audio = linkedAudioOf(store.items, item)
+      if (audio && audio.id !== masterAudio.id) store._updateItem(audio.id, { muted: true })
+    }
+    // The chosen master is the edit's sound, so it is heard even if it was muted before.
+    if (masterAudio.muted) store._updateItem(masterAudio.id, { muted: false })
+    const placedReference = store.itemById[reference.id] as VideoItem
+    store._addItem(programClip(placedReference, programTrackId, groupId, angleItems.indexOf(reference), placedReference.from, placedReference.durationInFrames, fps))
+    useTimelineSettingsStore.getState().markDirty()
+  }, { groupId, angles: ids.length })
+  return { ok: true, groupId }
+}
+
+/** A video-only copy of an angle covering [from, from + duration) on the program track. */
+function programClip(angle: VideoItem, trackId: string, groupId: string, angleIndex: number, from: number, duration: number, fps: number): ItemWithMulticam {
+  const sourceFps = angle.sourceFps ?? fps
+  const sourceStart = (angle.sourceStart ?? 0) + Math.round(((from - angle.from) * sourceFps) / fps)
+  return {
+    ...angle,
+    id: crypto.randomUUID(),
+    trackId,
+    from,
+    durationInFrames: duration,
+    sourceStart,
+    sourceEnd: sourceStart + Math.round((duration * sourceFps) / fps),
+    linkedGroupId: undefined,
+    originId: undefined,
+    embeddedAudioMuted: true,
+    muted: true,
+    multicam: { groupId, angle: angleIndex },
+  } as ItemWithMulticam
+}
+
+export function getMulticamGroup(groupId: string): { track: TrackWithMulticam; record: MulticamGroupRecord } | null {
+  const track = (useItemsStore.getState().tracks as TrackWithMulticam[]).find(
+    (candidate) => candidate.multicam?.groupId === groupId && candidate.multicam.role === 'program',
+  )
+  return track?.multicam ? { track, record: track.multicam } : null
+}
+
+/**
+ * Cut the program to `angleIndex` at `frame`, up to the next cut, in one undo
+ * step. Refuses when the angle has no picture for that whole interval, so a
+ * cut never leaves black or a gap; master audio is untouched.
+ */
+export function cutToAngle(groupId: string, angleIndex: number, frame: number): { ok: true } | { ok: false; reason: MulticamRefusal; missing?: [number, number] } {
+  const group = getMulticamGroup(groupId)
+  if (!group) return { ok: false, reason: 'no-group' }
+  const { items } = useItemsStore.getState()
+  const program = items.find((item) => item.trackId === group.track.id && item.from <= frame && frame < item.from + item.durationInFrames) as ItemWithMulticam | undefined
+  if (!program) return { ok: false, reason: 'no-program-clip' }
+  const angleRecord = group.record.angles?.[angleIndex]
+  const angle = angleRecord && items.find((item) => item.id === angleRecord.itemId) as VideoItem | undefined
+  if (!angle) return { ok: false, reason: 'not-found' }
+  if (program.multicam?.angle === angleIndex) return { ok: true }
+  const end = program.from + program.durationInFrames
+  if (angle.from > frame || angle.from + angle.durationInFrames < end) {
+    const angleEnd = angle.from + angle.durationInFrames
+    const missing: [number, number] = angle.from > frame
+      ? [frame, Math.min(end, angle.from)]
+      : [Math.max(frame, angleEnd), end]
+    return { ok: false, reason: 'no-coverage', missing }
+  }
+  if (hasLockedEditParticipants([program])) return { ok: false, reason: 'locked' }
+
+  const fps = useTimelineSettingsStore.getState().fps
+  execute('MULTICAM_CUT', () => {
+    const store = useItemsStore.getState()
+    if (frame > program.from) {
+      const left = programClip(store.itemById[(program.multicam ? group.record.angles![program.multicam.angle]!.itemId : angle.id)] as VideoItem,
+        group.track.id, groupId, program.multicam?.angle ?? angleIndex, program.from, frame - program.from, fps)
+      store._removeItems([program.id])
+      store._addItems([{ ...left, id: program.id }, programClip(angle, group.track.id, groupId, angleIndex, frame, end - frame, fps)])
+    } else {
+      store._removeItems([program.id])
+      store._addItem({ ...programClip(angle, group.track.id, groupId, angleIndex, program.from, program.durationInFrames, fps), id: program.id })
+    }
+    useTimelineSettingsStore.getState().markDirty()
+  }, { groupId, angleIndex, frame })
+  return { ok: true }
+}
