diff --git a/src/shared/utils/multicam-sync.test.ts b/src/shared/utils/multicam-sync.test.ts
new file mode 100644
--- /dev/null
+++ b/src/shared/utils/multicam-sync.test.ts
@@ -0,0 +1,62 @@
+import { describe, expect, it } from 'vite-plus/test'
+import { onsetEnvelope, syncRecordings } from './multicam-sync'
+
+const RATE = 8000
+
+function seeded(seed: number) {
+  let state = seed >>> 0
+  return () => ((state = (state * 1664525 + 1013904223) >>> 0) / 2 ** 32)
+}
+
+/** An event soundtrack: decaying noise bursts at random times. Same seed = same event. */
+function event(seconds: number, seed: number, drift = 1): Float32Array {
+  const random = seeded(seed)
+  const samples = new Float32Array(Math.round(seconds * RATE))
+  const noise = seeded(seed + 1)
+  for (let burst = 0; burst < seconds * 3; burst += 1) {
+    const at = Math.round(random() * seconds * RATE * drift)
+    const gain = 0.2 + 0.8 * random()
+    for (let i = 0; i < 800 && at + i < samples.length; i += 1) samples[at + i] = samples[at + i]! + gain * (noise() * 2 - 1) * Math.exp(-i / 200)
+  }
+  return samples
+}
+
+/** The same event recorded starting `startSeconds` into it (negative: the camera started earlier). */
+function record(source: Float32Array, startSeconds: number, seconds: number, noiseSeed: number): Float32Array {
+  const out = new Float32Array(Math.round(seconds * RATE))
+  const hiss = seeded(noiseSeed)
+  const start = Math.round(startSeconds * RATE)
+  for (let i = 0; i < out.length; i += 1) {
+    const s = source[start + i]
+    out[i] = (s === undefined ? 0 : s * 0.7) + 0.02 * (hiss() * 2 - 1)
+  }
+  return out
+}
+
+const envelope = (samples: Float32Array) => onsetEnvelope({ sampleRate: RATE, channels: [samples] })
+const FRAME = 1 / 30
+
+describe('syncRecordings', () => {
+  const scene = event(200, 3)
+  const reference = record(scene, 20, 150, 10)
+
+  it.each([[1.234], [-4.5], [17.02]])('places a camera started %s s later within one frame', (later) => {
+    const camera = record(scene, 20 + later, 150, 11)
+    const result = syncRecordings(envelope(reference), envelope(camera))
+    expect(result.flags).toEqual([])
+    // Reference source time s is camera source time s - later.
+    expect(Math.abs(result.offsetSeconds + later)).toBeLessThan(FRAME)
+  })
+
+  it('does not invent a match for silence or an unrelated recording', () => {
+    expect(syncRecordings(envelope(reference), envelope(new Float32Array(150 * RATE))).flags).toContain('no-match')
+    const unrelated = syncRecordings(envelope(reference), envelope(record(event(200, 99), 20, 150, 12)))
+    expect(unrelated.flags.length).toBeGreaterThan(0)
+  })
+
+  it('reports drift that a single offset cannot fix', () => {
+    const drifting = record(event(200, 3, 1.0004), 20, 150, 13)
+    const result = syncRecordings(envelope(reference), envelope(drifting), { frameSeconds: FRAME })
+    expect(result.flags).toContain('drift')
+  })
+})
diff --git a/src/shared/utils/multicam-sync.ts b/src/shared/utils/multicam-sync.ts
new file mode 100644
--- /dev/null
+++ b/src/shared/utils/multicam-sync.ts
@@ -0,0 +1,198 @@
+/**
+ * Multicamera audio sync (FL-595). Each recording is reduced to an onset
+ * envelope (rises in 1 ms RMS energy), and the lag between two envelopes is
+ * the peak of their FFT cross-correlation. A match is reliable only when the
+ * peak clearly beats every other lag; separate windows are compared to detect
+ * drift that one offset cannot fix.
+ */
+
+export const MULTICAM_SYNC_ALGORITHM = 'onset-xcorr-1ms-v1'
+const ENVELOPE_RATE = 1000
+
+export interface AudioInput {
+  sampleRate: number
+  channels: readonly Float32Array[]
+}
+
+/** Onset envelope at ENVELOPE_RATE: positive changes in per-millisecond RMS. */
+export function onsetEnvelope(input: AudioInput): Float32Array {
+  const hop = input.sampleRate / ENVELOPE_RATE
+  const length = Math.floor((input.channels[0]?.length ?? 0) / hop)
+  const energy = new Float32Array(length)
+  for (let i = 0; i < length; i += 1) {
+    const start = Math.floor(i * hop)
+    const end = Math.floor((i + 1) * hop)
+    let sum = 0
+    for (const channel of input.channels) {
+      for (let s = start; s < end; s += 1) sum += channel[s]! * channel[s]!
+    }
+    energy[i] = Math.sqrt(sum / Math.max(1, (end - start) * input.channels.length))
+  }
+  const onsets = new Float32Array(length)
+  for (let i = 1; i < length; i += 1) onsets[i] = Math.max(0, energy[i]! - energy[i - 1]!)
+  // Two 15 ms box passes (a 30 ms triangle) let clock drift smear onsets without losing the peak.
+  return smooth(smooth(onsets, SMOOTH_SAMPLES), SMOOTH_SAMPLES)
+}
+
+const SMOOTH_SAMPLES = 15
+
+function smooth(values: Float32Array, width: number): Float32Array {
+  const out = new Float32Array(values.length)
+  const half = Math.floor(width / 2)
+  let sum = 0
+  for (let i = 0; i < Math.min(values.length, half); i += 1) sum += values[i]!
+  for (let i = 0; i < values.length; i += 1) {
+    if (i + half < values.length) sum += values[i + half]!
+    if (i - half - 1 >= 0) sum -= values[i - half - 1]!
+    out[i] = sum / width
+  }
+  return out
+}
+
+/** In-place radix-2 FFT (inverse when `inverse`). Lengths must be powers of two. */
+function fft(re: Float64Array, im: Float64Array, inverse: boolean): void {
+  const n = re.length
+  for (let i = 1, j = 0; i < n; i += 1) {
+    let bit = n >> 1
+    for (; j & bit; bit >>= 1) j ^= bit
+    j ^= bit
+    if (i < j) {
+      ;[re[i], re[j]] = [re[j]!, re[i]!]
+      ;[im[i], im[j]] = [im[j]!, im[i]!]
+    }
+  }
+  for (let size = 2; size <= n; size <<= 1) {
+    const angle = ((inverse ? 2 : -2) * Math.PI) / size
+    const wr = Math.cos(angle)
+    const wi = Math.sin(angle)
+    for (let start = 0; start < n; start += size) {
+      let cr = 1
+      let ci = 0
+      for (let k = 0; k < size / 2; k += 1) {
+        const a = start + k
+        const b = a + size / 2
+        const tr = re[b]! * cr - im[b]! * ci
+        const ti = re[b]! * ci + im[b]! * cr
+        re[b] = re[a]! - tr
+        im[b] = im[a]! - ti
+        re[a] = re[a]! + tr
+        im[a] = im[a]! + ti
+        const next = cr * wr - ci * wi
+        ci = cr * wi + ci * wr
+        cr = next
+      }
+    }
+  }
+  if (inverse) for (let i = 0; i < n; i += 1) { re[i] = re[i]! / n; im[i] = im[i]! / n }
+}
+
+export interface LagEstimate {
+  /** Envelope samples by which `other` lags `reference`: other[t] ≈ reference[t - lag]. */
+  lag: number
+  /** Normalised correlation at the peak, 0..1. */
+  score: number
+  /** Peak over the best lag outside ±50 ms, ≥ 1; near 1 is ambiguous. */
+  distinctness: number
+}
+
+/** Best lag of `other` against `reference` within ±maxLag envelope samples. */
+function estimateLag(reference: Float32Array, other: Float32Array, maxLag: number): LagEstimate | null {
+  const norm = (values: Float32Array) => Math.sqrt(values.reduce((sum, v) => sum + v * v, 0))
+  const referenceNorm = norm(reference)
+  const otherNorm = norm(other)
+  if (referenceNorm === 0 || otherNorm === 0) return null
+  let size = 1
+  while (size < reference.length + other.length) size <<= 1
+  const aRe = new Float64Array(size), aIm = new Float64Array(size)
+  const bRe = new Float64Array(size), bIm = new Float64Array(size)
+  aRe.set(reference)
+  bRe.set(other)
+  fft(aRe, aIm, false)
+  fft(bRe, bIm, false)
+  // corr[k] = Σ other[t + k] · reference[t]  →  B · conj(A)
+  for (let i = 0; i < size; i += 1) {
+    const re = bRe[i]! * aRe[i]! + bIm[i]! * aIm[i]!
+    const im = bIm[i]! * aRe[i]! - bRe[i]! * aIm[i]!
+    bRe[i] = re
+    bIm[i] = im
+  }
+  fft(bRe, bIm, true)
+  const at = (lag: number) => bRe[(lag + size) % size]!
+  // Only lags where the two overlap exist; beyond them the circular result wraps.
+  const minLag = Math.max(-maxLag, -(reference.length - 1))
+  const topLag = Math.min(maxLag, other.length - 1)
+  let best = -Infinity
+  let bestLag = 0
+  for (let lag = minLag; lag <= topLag; lag += 1) {
+    const value = at(lag)
+    if (value > best) { best = value; bestLag = lag }
+  }
+  let runnerUp = 0
+  const guard = Math.round(0.05 * ENVELOPE_RATE)
+  for (let lag = minLag; lag <= topLag; lag += 1) {
+    if (Math.abs(lag - bestLag) > guard) runnerUp = Math.max(runnerUp, at(lag))
+  }
+  return {
+    lag: bestLag,
+    score: Math.max(0, best / (referenceNorm * otherNorm)),
+    distinctness: runnerUp > 0 ? best / runnerUp : Infinity,
+  }
+}
+
+export type SyncFlag = 'no-match' | 'ambiguous' | 'drift'
+
+export interface SyncResult {
+  /** Seconds to add to a reference source time to get the same moment in this recording. */
+  offsetSeconds: number
+  score: number
+  flags: SyncFlag[]
+  /** Offset difference between the early and late windows, seconds (drift check). */
+  driftSeconds: number | null
+}
+
+const MIN_SCORE = 0.2
+const MIN_DISTINCTNESS = 1.5
+
+/**
+ * Align `other` to `reference`. A positive offset means the moment at
+ * reference source time s is at other source time s + offset.
+ */
+export function syncRecordings(
+  reference: Float32Array,
+  other: Float32Array,
+  options: { maxOffsetSeconds?: number; frameSeconds?: number } = {},
+): SyncResult {
+  const maxLag = Math.round((options.maxOffsetSeconds ?? 120) * ENVELOPE_RATE)
+  const strong = (estimate: LagEstimate | null): boolean =>
+    !!estimate && estimate.score >= MIN_SCORE && estimate.distinctness >= MIN_DISTINCTNESS
+
+  // A window of `other` starting at o peaks at lag - o, so widen the search by o and add it back.
+  const windowLag = (start: number, length: number) => {
+    const estimate = estimateLag(reference, other.subarray(start, start + length), maxLag + start)
+    return estimate && { ...estimate, lag: estimate.lag + start }
+  }
+
+  const whole = estimateLag(reference, other, maxLag)
+  if (!whole) return { offsetSeconds: 0, score: 0, flags: ['no-match'], driftSeconds: null }
+
+  // Drift: align the first and last thirds of the recording separately. Clock drift smears the
+  // whole-file peak, so two strong windows that disagree are drift, not "no match". Each window
+  // needs more than 10 s of sound, so recordings of 30 s or less are not checked for drift; one
+  // frame of drift over 30 s would need a clock error above about 1,100 ppm.
+  const third = Math.floor(other.length / 3)
+  const early = third > 10 * ENVELOPE_RATE ? windowLag(0, third) : null
+  const late = third > 10 * ENVELOPE_RATE ? windowLag(other.length - third, third) : null
+  const driftSeconds = strong(early) && strong(late) ? (late!.lag - early!.lag) / ENVELOPE_RATE : null
+  const drifting = driftSeconds !== null && Math.abs(driftSeconds) > (options.frameSeconds ?? 1 / 30)
+
+  if (strong(whole) || (drifting && strong(early))) {
+    const anchor = strong(whole) ? whole : early!
+    return { offsetSeconds: anchor.lag / ENVELOPE_RATE, score: anchor.score, flags: drifting ? ['drift'] : [], driftSeconds }
+  }
+  return {
+    offsetSeconds: whole.lag / ENVELOPE_RATE,
+    score: whole.score,
+    flags: [whole.score < MIN_SCORE ? 'no-match' : 'ambiguous'],
+    driftSeconds,
+  }
+}
