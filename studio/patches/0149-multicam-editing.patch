+// @vitest-environment node
+
+import { beforeEach, describe, expect, it } from 'vite-plus/test'
+import type { AudioItem, TimelineTrack, VideoItem } from '@/types/timeline'
+import { useItemsStore } from '../../items-store'
+import { useTimelineCommandStore } from '../../timeline-command-store'
+import { useTimelineSettingsStore } from '../../timeline-settings-store'
+import { createMulticamEdit, cutToAngle, getMulticamGroup } from './multicam-actions'
+
+const track = (id: string, order: number, locked = false) => ({
+  id, name: id, order, height: 80, locked, syncLock: true, visible: true, muted: false,
+  solo: false, volume: 0, items: [], kind: id.startsWith('a') ? 'audio' : 'video',
+}) as TimelineTrack
+
+function camera(n: number, from: number, sourceStart: number, duration = 300): [VideoItem, AudioItem] {
+  const shared = { from, durationInFrames: duration, mediaId: `cam${n}`, sourceStart, sourceEnd: sourceStart + duration, sourceFps: 30, linkedGroupId: `g${n}` }
+  return [
+    { id: `v${n}`, type: 'video', trackId: `v${n}`, label: `Camera ${n}`, src: 'blob:v', ...shared } as VideoItem,
+    { id: `a${n}`, type: 'audio', trackId: `a${n}`, label: `Camera ${n}`, src: 'blob:a', ...shared } as AudioItem,
+  ]
+}
+
+const byId = (id: string) => useItemsStore.getState().itemById[id]!
+
+describe('multicam', () => {
+  beforeEach(() => {
+    useTimelineCommandStore.getState().clearHistory()
+    useTimelineSettingsStore.setState({ fps: 30, isDirty: false })
+    useItemsStore.getState().setTracks([
+      track('v1', 0), track('v2', 1), track('v3', 2), track('a1', 3), track('a2', 4), track('a3', 5),
+    ])
+    useItemsStore.getState().setItems([...camera(1, 0, 0), ...camera(2, 0, 0), ...camera(3, 0, 60)])
+  })
+
+  // Camera 2 started 1.5 s after the reference: reference source s is camera-2 source s - 1.5.
+  const angles = [
+    { itemId: 'v1', offsetSeconds: 0 },
+    { itemId: 'v2', offsetSeconds: -1.5 },
+    { itemId: 'v3', offsetSeconds: 0.5, manual: true },
+  ]
+
+  it('lines up the angles, hides them, keeps one master audio and adds a program track, in one undo step', () => {
+    const outcome = createMulticamEdit({ referenceId: 'v1', angles, masterItemId: 'v2' })
+    expect(outcome.ok).toBe(true)
+    if (!outcome.ok) return
+
+    // Same moment at the same frame: camera 2 (1.5 s late) and camera 3 (source 2 s in, 0.5 s offset) both start at frame 45.
+    expect(byId('v2').from).toBe(45)
+    expect(byId('a2').from).toBe(45)
+    expect(byId('v3').from).toBe(45)
+
+    const { record, track: program } = getMulticamGroup(outcome.groupId)!
+    expect(record).toMatchObject({ role: 'program', algorithm: 'manual', referenceItemId: 'v1', masterAudioItemId: 'a2' })
+    expect(record.angles!.map((angle) => angle.offsetSeconds)).toEqual([0, -1.5, 0.5])
+    const tracks = useItemsStore.getState().tracks
+    expect(tracks.filter((t) => ['v1', 'v2', 'v3'].includes(t.id)).every((t) => t.visible === false)).toBe(true)
+    expect(program.order).toBeLessThan(Math.min(...tracks.filter((t) => t.id !== program.id).map((t) => t.order)))
+
+    // Only the master camera's sound stays on; nothing is doubled.
+    expect([byId('a1').muted, byId('a2').muted, byId('a3').muted]).toEqual([true, undefined, true])
+
+    const clips = useItemsStore.getState().items.filter((item) => item.trackId === program.id)
+    expect(clips).toHaveLength(1)
+    expect(clips[0]).toMatchObject({ from: 0, durationInFrames: 300, mediaId: 'cam1', muted: true, embeddedAudioMuted: true, linkedGroupId: undefined })
+
+    useTimelineCommandStore.getState().undo()
+    expect(useItemsStore.getState().items).toHaveLength(6)
+    expect(byId('v2').from).toBe(0)
+    expect(useItemsStore.getState().tracks.every((t) => t.visible)).toBe(true)
+  })
+
+  it('cuts the picture between angles at the playhead with source ranges from the alignment', () => {
+    const outcome = createMulticamEdit({ referenceId: 'v1', angles, masterItemId: 'v1' })
+    if (!outcome.ok) throw new Error(outcome.reason)
+    const { track: program } = getMulticamGroup(outcome.groupId)!
+
+    expect(cutToAngle(outcome.groupId, 1, 100)).toEqual({ ok: true })
+    expect(cutToAngle(outcome.groupId, 2, 200)).toEqual({ ok: true })
+    const clips = useItemsStore.getState().items.filter((item) => item.trackId === program.id).sort((a, b) => a.from - b.from) as VideoItem[]
+    expect(clips.map((clip) => [clip.from, clip.durationInFrames, clip.mediaId])).toEqual([[0, 100, 'cam1'], [100, 100, 'cam2'], [200, 100, 'cam3']])
+    // Camera 2 sits at frame 45, source 0: frame 100 is its source frame 55.
+    expect(clips[1]).toMatchObject({ sourceStart: 55, sourceEnd: 155 })
+    // No gaps or overlaps between cuts.
+    expect(clips.every((clip, i) => i === 0 || clip.from === clips[i - 1]!.from + clips[i - 1]!.durationInFrames)).toBe(true)
+    // Master audio is untouched by cuts.
+    expect(byId('a1')).toMatchObject({ from: 0, durationInFrames: 300 })
+
+    // Switching an existing cut replaces the whole interval.
+    expect(cutToAngle(outcome.groupId, 0, 100)).toEqual({ ok: true })
+    const switched = useItemsStore.getState().items.filter((item) => item.trackId === program.id).sort((a, b) => a.from - b.from)
+    expect(switched.map((clip) => clip.mediaId)).toEqual(['cam1', 'cam1', 'cam3'])
+  })
+
+  it('refuses a cut where the angle has no picture and leaves the program unchanged', () => {
+    const outcome = createMulticamEdit({ referenceId: 'v1', angles, masterItemId: 'v1' })
+    if (!outcome.ok) throw new Error(outcome.reason)
+    const before = structuredClone(useItemsStore.getState().items)
+    // Camera 2 starts at frame 45: frames 10..45 of the program interval have no picture.
+    expect(cutToAngle(outcome.groupId, 1, 10)).toEqual({ ok: false, reason: 'no-coverage', missing: [10, 45] })
+    expect(useItemsStore.getState().items).toEqual(before)
+  })
+
+  it.each([
+    ['angle-count', () => createMulticamEdit({ referenceId: 'v1', angles: [angles[0]!], masterItemId: 'v1' })],
+    ['shared-track', () => {
+      useItemsStore.getState()._addItem({ ...camera(9, 400, 0)[0], id: 'other', linkedGroupId: undefined, trackId: 'v2' } as VideoItem)
+      return createMulticamEdit({ referenceId: 'v1', angles, masterItemId: 'v1' })
+    }],
+    ['locked', () => {
+      useItemsStore.getState().setTracks([track('v1', 0), track('v2', 1, true), track('v3', 2), track('a1', 3), track('a2', 4), track('a3', 5)])
+      return createMulticamEdit({ referenceId: 'v1', angles, masterItemId: 'v1' })
+    }],
+    ['retimed', () => {
+      useItemsStore.getState()._updateItem('v3', { speed: 2 })
+      return createMulticamEdit({ referenceId: 'v1', angles, masterItemId: 'v1' })
+    }],
+    ['generated-media', () => {
+      // A generated clip has no media file.
+      useItemsStore.getState()._updateItem('v3', { mediaId: undefined })
+      return createMulticamEdit({ referenceId: 'v1', angles, masterItemId: 'v1' })
+    }],
+    ['already-multicam', () => {
+      // An angle moved off its group's track is still named by the program record.
+      useItemsStore.getState().setTracks([
+        { ...track('v0', -1), multicam: { groupId: 'g', role: 'program', angles: [{ trackId: 'x', itemId: 'v2', mediaId: 'cam2', offsetSeconds: 0 }] } } as TimelineTrack,
+        track('v1', 0), track('v2', 1), track('v3', 2), track('a1', 3), track('a2', 4), track('a3', 5),
+      ])
+      return createMulticamEdit({ referenceId: 'v1', angles, masterItemId: 'v1' })
+    }],
+    ['already-multicam', () => {
+      useItemsStore.getState().setTracks([
+        track('v1', 0), { ...track('v2', 1), multicam: { groupId: 'g', role: 'angle' } } as TimelineTrack,
+        track('v3', 2), track('a1', 3), track('a2', 4), track('a3', 5),
+      ])
+      return createMulticamEdit({ referenceId: 'v1', angles, masterItemId: 'v1' })
+    }],
+  ])('refuses %s without changing the project', (reason, act) => {
+    const outcome = act()
+    expect(outcome).toEqual({ ok: false, reason })
+    expect(useTimelineCommandStore.getState().canUndo).toBe(false)
