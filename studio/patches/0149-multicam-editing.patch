+
+  it('refuses to line up a recording that would start before the timeline', () => {
+    // Camera 2 started 2 s before the reference, which sits at frame 0.
+    const outcome = createMulticamEdit({ referenceId: 'v1', angles: [angles[0]!, { itemId: 'v2', offsetSeconds: 2 }], masterItemId: 'v1' })
+    expect(outcome).toEqual({ ok: false, reason: 'before-start' })
+  })
+
+  it('reports where an angle ends before the next cut', () => {
+    useItemsStore.getState().setItems([...camera(1, 0, 0), ...camera(2, 0, 0, 150), ...camera(3, 0, 60)])
+    const outcome = createMulticamEdit({ referenceId: 'v1', angles: [angles[0]!, { itemId: 'v2', offsetSeconds: 0 }], masterItemId: 'v1' })
+    if (!outcome.ok) throw new Error(outcome.reason)
+    expect(cutToAngle(outcome.groupId, 1, 100)).toEqual({ ok: false, reason: 'no-coverage', missing: [150, 300] })
+  })
+
+  it('unmutes a master audio clip that was muted, as the edit's one sound', () => {
+    useItemsStore.getState()._updateItem('a2', { muted: true })
+    const outcome = createMulticamEdit({ referenceId: 'v1', angles, masterItemId: 'v2' })
+    expect(outcome.ok).toBe(true)
+    expect([byId('a1').muted, byId('a2').muted, byId('a3').muted]).toEqual([true, false, true])
