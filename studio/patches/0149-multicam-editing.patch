+import { useEffect, useRef, useState } from 'react'
+import { useTranslation } from 'react-i18next'
+import { Clapperboard } from 'lucide-react'
+import { toast } from 'sonner'
+import { Button } from '@/components/ui/button'
+import { Input } from '@/components/ui/input'
+import type { TimelineItem } from '@/types/timeline'
+import {
+  analyzeMulticamSync,
+  createMulticamEdit,
+  cutToAngle,
+  getMulticamGroup,
+  useTimelineStore,
+  type MulticamSyncProposal,
+} from '@/features/editor/deps/timeline-store'
+import { usePlaybackStore } from '@/shared/state/playback'
+import { PropertyRow, PropertySection } from '../components'
+
+/** Create a multicamera edit from 2–4 selected video clips (FL-595). */
+function CreateMulticam({ items }: { items: TimelineItem[] }) {
+  const { t } = useTranslation()
+  const fps = useTimelineStore((s) => s.fps)
+  const [referenceId, setReferenceId] = useState(items[0]!.id)
+  const [masterId, setMasterId] = useState(items[0]!.id)
+  const [proposals, setProposals] = useState<MulticamSyncProposal[] | null>(null)
+  // Manual offsets in frames, per angle; seeded from analysis and editable.
+  const [offsets, setOffsets] = useState<Record<string, number>>({})
+  const [busy, setBusy] = useState(false)
+  const abortRef = useRef<AbortController | null>(null)
+  useEffect(() => () => abortRef.current?.abort(), [])
+
+  const analyze = async () => {
+    abortRef.current?.abort()
+    const controller = new AbortController()
+    abortRef.current = controller
+    setBusy(true)
+    try {
+      const analysis = await analyzeMulticamSync(items.map((item) => item.id), referenceId, controller.signal)
+      // A superseded run (cancelled, or the reference changed) never writes its results.
+      if (controller.signal.aborted) return
+      if (!analysis.ok) {
+        toast.warning(t(`editor.multicam.refusal.${analysis.reason}`))
+        return
+      }
+      setProposals(analysis.proposals)
+      // Only reliable matches prefill an offset; failed ones stay manual (0 until edited).
+      setOffsets(Object.fromEntries(analysis.proposals.map((p) => [p.itemId, p.sync.flags.length === 0 ? Math.round(p.sync.offsetSeconds * fps) : 0])))
+    } catch (error) {
+      if (!controller.signal.aborted && !(error instanceof DOMException && error.name === 'AbortError')) toast.error(t('editor.multicam.refusal.decode-failed'))
+    } finally {
+      if (abortRef.current === controller) setBusy(false)
+    }
+  }
+
+  const create = () => {
+    const outcome = createMulticamEdit({
+      referenceId,
+      masterItemId: masterId,
+      angles: items.map((item) => {
+        const proposal = proposals?.find((p) => p.itemId === item.id)
+        const frames = offsets[item.id] ?? 0
+        return {
+          itemId: item.id,
+          offsetSeconds: frames / fps,
+          // The reference is the zero point; only other angles can be manual.
+          manual: item.id !== referenceId
+            && (!proposal || proposal.sync.flags.length > 0 || frames !== Math.round(proposal.sync.offsetSeconds * fps)),
+        }
+      }),
+    })
+    if (outcome.ok) toast.success(t('editor.multicam.created'))
+    else toast.warning(t(`editor.multicam.refusal.${outcome.reason}`))
+  }
+
+  const select = (label: string, value: string, onChange: (id: string) => void) => (
+    <select className="h-7 w-full rounded-md border border-input bg-transparent px-2 text-xs" aria-label={label}
+      value={value} onChange={(event) => onChange(event.target.value)}>
+      {items.map((item) => <option key={item.id} value={item.id}>{item.label}</option>)}
+    </select>
+  )
+
+  return (
+    <>
+      <PropertyRow label={t('editor.multicam.reference')}>
+        {/* Offsets are relative to the reference: a new reference discards them and the sync results. */}
+        {select(t('editor.multicam.reference'), referenceId, (id) => { abortRef.current?.abort(); setReferenceId(id); setProposals(null); setOffsets({}) })}
+      </PropertyRow>
+      <PropertyRow label={t('editor.multicam.masterAudio')}>{select(t('editor.multicam.masterAudio'), masterId, setMasterId)}</PropertyRow>
+      {items.filter((item) => item.id !== referenceId).map((item) => {
+        const proposal = proposals?.find((p) => p.itemId === item.id)
+        return (
+          <PropertyRow key={item.id} label={item.label}>
+            <div className="flex w-full flex-col gap-1">
+              <div className="flex items-center gap-1">
+                <Input type="number" step={1} className="h-7 min-w-0 flex-1 px-2 text-xs"
+                  aria-label={t('editor.multicam.offset', { label: item.label })}
+                  value={offsets[item.id] ?? 0}
+                  onChange={(event) => setOffsets((current) => ({ ...current, [item.id]: Math.round(Number(event.target.value)) }))} />
+                <span className="text-xs text-muted-foreground">{t('editor.multicam.frames')}</span>
+              </div>
+              {proposal && (proposal.sync.flags.length === 0
+                ? <span className="text-xs">{t('editor.multicam.matched', { score: Math.round(proposal.sync.score * 100) })}</span>
+                : proposal.sync.flags.map((flag) => <span key={flag} className="text-xs text-amber-500">{t(`editor.multicam.flag.${flag}`)}</span>))}
+            </div>
+          </PropertyRow>
+        )
+      })}
+      <div className="flex items-center gap-2 px-1 py-2" aria-live="polite">
+        {busy ? (
+          <Button variant="ghost" size="sm" className="h-7 flex-1 text-xs" onClick={() => abortRef.current?.abort()}>{t('editor.multicam.cancel')}</Button>
+        ) : (
+          <Button variant="ghost" size="sm" className="h-7 flex-1 text-xs" onClick={() => void analyze()}>{t('editor.multicam.syncByAudio')}</Button>
+        )}
+        <Button size="sm" className="h-7 flex-1 text-xs" disabled={busy} onClick={create}>{t('editor.multicam.create')}</Button>
+      </div>
+      <p className="px-1 pb-2 text-xs text-muted-foreground">{t('editor.multicam.createNote')}</p>
+    </>
+  )
+}
+
+/** Cut the program between angles at the playhead; number keys 1–4 while focused. */
+function CutControls({ groupId }: { groupId: string }) {
+  const { t } = useTranslation()
+  const group = getMulticamGroup(groupId)
+  const angles = group?.record.angles ?? []
+  const labels = useTimelineStore((s) => angles.map((angle) => s.items.find((item) => item.id === angle.itemId)?.label ?? '?').join('\u0000')).split('\u0000')
+
+  const cut = (index: number) => {
+    const outcome = cutToAngle(groupId, index, usePlaybackStore.getState().currentFrame)
+    if (!outcome.ok) {
+      toast.warning(outcome.reason === 'no-coverage' && outcome.missing
+        ? t('editor.multicam.refusal.no-coverage-range', { from: outcome.missing[0], to: outcome.missing[1] })
+        : t(`editor.multicam.refusal.${outcome.reason}`))
+    }
+  }
+
+  return (
+    <div
+      className="grid grid-cols-2 gap-2 px-1 py-2"
+      role="group"
+      aria-label={t('editor.multicam.angles')}
+      onKeyDown={(event) => {
+        const index = Number(event.key) - 1
+        if (Number.isInteger(index) && index >= 0 && index < angles.length) {
+          event.preventDefault()
+          cut(index)
+        }
+      }}
+    >
+      {angles.map((angle, index) => (
+        <Button key={angle.itemId} variant="secondary" size="sm" className="h-auto min-h-7 justify-start text-left text-xs"
+          onClick={() => cut(index)} aria-keyshortcuts={String(index + 1)}
+          aria-label={t('editor.multicam.cutTo', { n: index + 1, label: labels[index] })}>
+          <span className="mr-2 rounded bg-muted px-1 font-mono">{index + 1}</span>
+          <span className="truncate">{labels[index]}</span>
+        </Button>
+      ))}
+      <p className="col-span-2 text-xs text-muted-foreground">{t('editor.multicam.cutNote')}</p>
+    </div>
+  )
+}
+
+export function MulticamSection({ items }: { items: TimelineItem[] }) {
+  const { t } = useTranslation()
+  const tracks = useTimelineStore((s) => s.tracks)
+  const programGroupId = items.length === 1
+    ? (tracks.find((track) => track.id === items[0]!.trackId) as { multicam?: { role: string; groupId: string } } | undefined)?.multicam
+    : undefined
+  const videos = items.filter((item) => item.type === 'video')
+  const canCreate = videos.length >= 2 && videos.length <= 4 && videos.length === items.filter((item) => item.type !== 'audio').length
+  if (!canCreate && programGroupId?.role !== 'program') return null
+
+  return (
+    <PropertySection title={t('editor.multicam.title')} icon={Clapperboard} defaultOpen={true}>
+      {programGroupId?.role === 'program'
+        ? <CutControls groupId={programGroupId.groupId} />
+        : <CreateMulticam key={videos.map((item) => item.id).join(',')} items={videos} />}
+    </PropertySection>
+  )
+}
