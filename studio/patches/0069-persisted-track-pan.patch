+export function getAudioMeterStatus(estimate: AudioMeterEstimate | undefined, active: boolean) {
+  const resolved = estimate?.resolvedSourceCount ?? 0
+  const unresolved = estimate?.unresolvedSourceCount ?? 0
+  const panUnavailable = (estimate?.unresolvedPanSourceCount ?? 0) > 0
+  const scanning = active && resolved === 0 && unresolved > 0 && !panUnavailable
+  return {
+    label: !active
+      ? 'Idle'
+      : resolved > 0
+        ? unresolved > 0
+          ? 'Partial envelope estimate'
+          : 'Envelope estimate'
+        : unresolved > 0
+          ? panUnavailable
+            ? 'Unavailable'
+            : 'Scanning'
+          : 'No active sources',
+    reason: active && panUnavailable ? 'Pan needs channel phase data.' : undefined,
+    scanning,
+  }
 }

