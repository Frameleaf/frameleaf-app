+/** False keeps an unknown or unsupported channel layout silent. */
+export function rampPreviewClipPan(
+  graph: PreviewClipAudioGraph,
+  stages: readonly number[],
+  sourceChannels: number | undefined,
+): boolean {
+  if (stages.length === 0 && graph.panNodes.length === 0) return true
+  if (stages.some((pan) => !Number.isFinite(pan) || pan < -1 || pan > 1)) return false
+  if (stages.length > 0 && sourceChannels !== 1 && sourceChannels !== 2) return false
+  if (stages.length > 0 && typeof graph.context.createStereoPanner !== 'function') return false
+  // SoundTouch emits two equal planes for mono. Restore the admitted source
+  // count before panning so its mono gain law matches the export calculation.
+  graph.sourceInputNode.channelCountMode = stages.length > 0 ? 'explicit' : 'max'
+  graph.sourceInputNode.channelCount = stages.length > 0 ? sourceChannels! : 2
+  if (graph.panNodes.length !== stages.length) {
+    for (const node of graph.panNodes) node.disconnect()
+    graph.panNodes = stages.map((pan) => {
+      const node = graph.context.createStereoPanner()
+      node.pan.value = pan
+      return node
+    })
+    reconnectPreviewClipAudioGraph(graph)
+  } else {
+    stages.forEach((pan, index) => rampAudioParam(
+      graph.panNodes[index]!.pan, pan, graph.context.currentTime, PREVIEW_AUDIO_GAIN_RAMP_SECONDS,
+    ))
+  }
+  return true
+}
diff --git a/src/shared/utils/audio-pan.ts b/src/shared/utils/audio-pan.ts
new file mode 100644
--- /dev/null
+++ b/src/shared/utils/audio-pan.ts
@@ -0,0 +1,56 @@
+import type { TimelineItem, TimelineTrack } from '@/types/timeline'
+
+export function getAudioPanStages(pan: number | undefined): number[] {
+  if (pan !== undefined && (!Number.isFinite(pan) || pan < -1 || pan > 1))
+    throw new Error('Invalid audio pan')
+  return pan === undefined || pan === 0 ? [] : [pan]
+}
+
+/** Leaf track first, then the audible composition wrappers from inside out. */
+export function resolveTrackAudioPanStages(
+  items: readonly TimelineItem[],
+  tracks: readonly TimelineTrack[],
+  compositions: readonly { items: TimelineItem[]; tracks: TimelineTrack[] }[],
+  itemId: string,
+  ancestorItemIds: readonly string[] = [],
+): number[] {
+  // ponytail: scan on store changes; index item owners if large timelines make this measurable.
+  const stages: number[] = []
+  for (const id of new Set([itemId, ...ancestorItemIds.toReversed()])) {
+    const owner = items.some((item) => item.id === id)
+      ? { items, tracks }
+      : compositions.find((composition) => composition.items.some((item) => item.id === id))
+    const item = owner?.items.find((candidate) => candidate.id === id)
+    stages.push(
+      ...getAudioPanStages(owner?.tracks.find((track) => track.id === item?.trackId)?.pan),
+    )
+  }
+  return stages
+}
+
+/** Web Audio StereoPanner law; zero preserves the original source planes. */
+export function applyAudioPanStages(
+  samples: Float32Array[],
+  stages: readonly number[] = [],
+): Float32Array[] {
+  for (const pan of stages) {
+    if (!Number.isFinite(pan) || pan < -1 || pan > 1) throw new Error('Invalid audio pan')
+    if (pan === 0) continue
+    if (samples.length !== 1 && samples.length !== 2)
+      throw new Error('Track pan requires a mono or stereo source')
+    const mono = samples.length === 1
+    const angle = ((mono ? (pan + 1) / 2 : pan <= 0 ? pan + 1 : pan) * Math.PI) / 2
+    const leftGain = Math.cos(angle)
+    const rightGain = Math.sin(angle)
+    const left = new Float32Array(samples[0]!.length)
+    const right = new Float32Array(left.length)
+    for (let i = 0; i < left.length; i++) {
+      const l = samples[0]![i]!
+      const r = mono ? l : samples[1]![i]!
+      left[i] = mono ? l * leftGain : pan <= 0 ? l + r * leftGain : l * leftGain
+      right[i] = mono ? r * rightGain : pan <= 0 ? r * rightGain : r + l * rightGain
+    }
+    samples = [left, right]
+  }
+  return samples
+}
