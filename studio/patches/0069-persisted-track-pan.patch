+describe('track pan through both actual PCM mixers', () => {
+  for (const windowed of [false, true]) {
+    it(`${windowed ? 'windowed' : 'full'} mix pans mono/stereo and preserves untouched sibling planes`, async () => {
+      for (const channels of [1, 2]) {
+        for (const pan of [-1, -0.5, 0, 0.5, 1]) {
+          clearAudioDecodeCache()
+          const composition = channelImpulseComposition(`pan-${channels}-${pan}`, channels)
+          composition.durationInFrames = 1
+          for (const track of composition.tracks!) track.items[0]!.durationInFrames = 1
+          composition.tracks![0]!.pan = pan
+          const before = structuredClone(composition)
+          const mixed = windowed ? (await processAudioWindows(composition).next()).value : await processAudio(composition)
+          expect(mixed).not.toBeNull()
+          const outputChannels = pan === 0 ? channels : 2
+          expect(mixed!.channels).toBe(outputChannels)
+          const angle = (channels === 1 ? (pan + 1) / 2 : pan <= 0 ? pan + 1 : pan) * Math.PI / 2
+          const left = mixed!.samples[0]!
+          if (pan === 0) {
+            expect(left[32]).toBe(0.125)
+          } else {
+            expect(left[32]).toBeCloseTo(channels === 1 || pan > 0 ? 0.125 * Math.cos(angle) : 0.125, 7)
+            expect(mixed!.samples[1]![32]).toBeCloseTo(channels === 1 || pan > 0 ? 0.125 * Math.sin(angle) : 0, 7)
+            if (channels === 2) {
+              expect(left[49]).toBeCloseTo(pan <= 0 ? 0.125 * Math.cos(angle) : 0, 7)
+              expect(mixed!.samples[1]![49]).toBeCloseTo(pan <= 0 ? 0.125 * Math.sin(angle) : 0.125, 7)
+            }
+          }
+          expect(left[320]).toBe(-0.125)
+          if (outputChannels === 2) expect(mixed!.samples[1]![channels === 1 ? 320 : 339]).toBe(-0.125)
+          expect(composition).toEqual(before)
+        }
+      }
+    })
+
+    it(`${windowed ? 'windowed' : 'full'} mix refuses active pan on multichannel sources before publishing`, async () => {
+      const composition = channelImpulseComposition(`refused-pan-${windowed}`, 6)
+      composition.tracks![0]!.pan = 1
+      const result = windowed ? processAudioWindows(composition).next() : processAudio(composition)
+      await expect(result).rejects.toThrow('Track pan requires a mono or stereo source')
+    })
+  }
+
+  it('routes active pan through PCM and restores packet passthrough at neutral', () => {
+    const composition = channelImpulseComposition('pan-packet-copy', 2)
+    composition.tracks = [composition.tracks![0]!]
+    composition.tracks[0]!.items[0]!.volume = 0
+    const neutral = getAudioPacketPassthroughPlan(composition)
+    expect(neutral).not.toBeNull()
+    composition.tracks[0]!.pan = 0.5
+    expect(getAudioPacketPassthroughPlan(composition)).toBeNull()
+    composition.tracks[0]!.pan = 0
+    expect(getAudioPacketPassthroughPlan(composition)).toEqual(neutral)
+  })
+
+  it('uses ordered pan stages without mutating PCM and keeps neutral multichannel planes', () => {
+    const mono = [new Float32Array([0.25, -0.25])]
+    const before = mono.map((channel) => [...channel])
+    const result = applyAudioPanStages(mono, [-1, 1])
+    expect([...result[0]!]).toEqual([expect.closeTo(0, 7), expect.closeTo(0, 7)])
+    expect([...result[1]!]).toEqual([0.25, -0.25])
+    expect(mono.map((channel) => [...channel])).toEqual(before)
+    const multichannel = Array.from({ length: 6 }, () => new Float32Array(2))
+    expect(applyAudioPanStages(multichannel, [0])).toBe(multichannel)
+    for (const pan of [NaN, Infinity, -2, 2]) expect(() => applyAudioPanStages(mono, [pan])).toThrow('Invalid audio pan')
+  })
+})
