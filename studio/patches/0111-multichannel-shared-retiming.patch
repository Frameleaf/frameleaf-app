diff --git a/src/infrastructure/audio/time-stretch.test.ts b/src/infrastructure/audio/time-stretch.test.ts
new file mode 100644
--- /dev/null
+++ b/src/infrastructure/audio/time-stretch.test.ts
@@ -0,0 +1,78 @@
+// @vitest-environment node
+import { createHash } from 'node:crypto'
+import { describe, expect, it } from 'vite-plus/test'
+import { TimeStretchFilter, TimeStretchProcessor } from './time-stretch'
+
+const settings = [
+  {
+    tempo: 1.5,
+    pitch: 2 ** (3 / 12),
+    legacy: '4d2b97cfb4dd16505ac1c5e39267c624b58ae67ff4de87064e66ccd23ed8bd2e',
+  },
+  {
+    tempo: 0.75,
+    pitch: 2 ** (-4 / 12),
+    legacy: '528ee176278387c3e1d6c8faf157b1845e7673456b393b289248d2172a3f96be',
+  },
+]
+function impulses(channels: number, tempo: number, pitch: number, active?: number) {
+  const frames = 96000
+  const source = {
+    extract(target: Float32Array, count: number, position: number) {
+      count = Math.max(0, Math.min(count, frames - position))
+      for (let i = 0; i < count; i++)
+        for (let c = 0; c < channels; c++) {
+          target[i * channels + c] =
+            (position + i) % 137 === 0 && (active === undefined || active === c) ? (c + 1) / 32 : 0
+        }
+      return count
+    },
+  }
+  const processor = new TimeStretchProcessor(channels)
+  processor.tempo = tempo
+  processor.pitch = pitch
+  processor.rate = 1
+  const filter = new TimeStretchFilter(source, processor)
+  const output = new Float32Array(32768 * channels)
+  expect(filter.extract(output, 32768)).toBe(32768)
+  return output
+}
+
+describe('one shared retiming clock across authored planes', () => {
+  for (const { tempo, pitch, legacy } of settings) {
+    it(`retains original stereo PCM bytes at tempo ${tempo} and pitch ${pitch}`, () => {
+      // Exact original processor bytes, measured before adapting its stereo strides.
+      const output = impulses(2, tempo, pitch)
+      expect(createHash('sha256').update(new Uint8Array(output.buffer)).digest('hex')).toBe(legacy)
+    })
+    it.each([1, 2, 6, 8])(
+      `preserves %s plane impulses on one clock at tempo ${tempo} and pitch ${pitch}`,
+      (channels) => {
+        const output = impulses(channels, tempo, pitch)
+        expect(output.some((sample) => sample !== 0)).toBe(true)
+        let maxError = 0
+        for (let i = 0; i < 32768; i++)
+          for (let c = 0; c < channels; c++) {
+            maxError = Math.max(
+              maxError,
+              Math.abs(output[i * channels + c]! - output[i * channels]! * (c + 1)),
+            )
+          }
+        expect(maxError).toBeLessThan(5e-8)
+        for (let active = 0; active < channels; active++) {
+          const isolated = impulses(channels, tempo, pitch, active)
+          expect(isolated.some((sample) => sample !== 0)).toBe(true)
+          let leaked = false
+          for (let i = 0; i < 32768; i++)
+            for (let c = 0; c < channels; c++) {
+              if (c !== active && isolated[i * channels + c] !== 0) leaked = true
+            }
+          expect(leaked).toBe(false)
+        }
+      },
+    )
+  }
+  it.each([0, -1, 1.5, NaN])('refuses invalid plane count %s', (count) => {
+    expect(() => new TimeStretchProcessor(count)).toThrow('Invalid time-stretch channel count')
+  })
+})
