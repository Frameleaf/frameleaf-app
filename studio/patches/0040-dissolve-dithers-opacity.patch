+import { describe, expect, it } from 'vite-plus/test'
+import { dissolveCovers, dissolveThreshold, ditherAlphaInPlace } from './dissolve-dither'
+
+describe('dissolve dither (FL-99 owner decision)', () => {
+  it('is deterministic and depends only on the pixel position', () => {
+    expect(dissolveThreshold(12, 34)).toBe(dissolveThreshold(12, 34))
+    const values = new Set(Array.from({ length: 64 }, (_, i) => dissolveThreshold(i, 7)))
+    expect(values.size).toBeGreaterThan(48)
+    for (const v of values) {
+      expect(v).toBeGreaterThanOrEqual(0)
+      expect(v).toBeLessThan(1)
+    }
+  })
+
+  it('covers nothing at 0, everything at 1, and about the opacity in between', () => {
+    const N = 128
+    for (const opacity of [0, 0.25, 0.5, 0.75, 1]) {
+      let covered = 0
+      for (let y = 0; y < N; y++)
+        for (let x = 0; x < N; x++) if (dissolveCovers(x, y, opacity)) covered++
+      const fraction = covered / (N * N)
+      if (opacity === 0 || opacity === 1) expect(fraction).toBe(opacity)
+      else expect(Math.abs(fraction - opacity)).toBeLessThan(0.03)
+    }
+  })
+
+  it('makes every alpha all-or-nothing and leaves colour and exact alphas alone', () => {
+    const W = 16
+    const H = 16
+    const data = new Uint8ClampedArray(W * H * 4)
+    for (let i = 0; i < W * H; i++)
+      data.set([10, 20, 30, i % 3 === 0 ? 128 : i % 3 === 1 ? 0 : 255], i * 4)
+    const before = Uint8ClampedArray.from(data)
+    ditherAlphaInPlace(data, W, H)
+    for (let i = 0; i < W * H; i++) {
+      expect([0, 255]).toContain(data[i * 4 + 3])
+      expect(Array.from(data.slice(i * 4, i * 4 + 3))).toEqual([10, 20, 30])
+      if (before[i * 4 + 3] === 0 || before[i * 4 + 3] === 255)
+        expect(data[i * 4 + 3]).toBe(before[i * 4 + 3])
+    }
+    const again = Uint8ClampedArray.from(before)
+    ditherAlphaInPlace(again, W, H)
+    expect(again).toEqual(data)
+  })
+})
