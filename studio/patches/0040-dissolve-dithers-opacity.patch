+/**
+ * FL-99 owner decision (2026-09-29): Dissolve dithers each pixel's total opacity
+ * (item opacity times content alpha, as Photoshop does) into all-or-nothing coverage
+ * on every route, a deliberate exception to Freecut SDR parity. The GPU routes do it
+ * in the shared compositor WGSL (`compositeBlendSourceOver`); this is the same rule
+ * for the Canvas2D compositing fallback. The DOM player never shows a Dissolve item:
+ * like every non-normal blend mode it routes the preview to the engine surface (see
+ * use-gpu-effects-overlay.ts), so preview and export draw the same pixels. The
+ * threshold depends only on the pixel position, so a frame is reproducible and a held
+ * opacity does not flicker. It is the WGSL hash in 32-bit float, over pixel centres.
+ */
+
+const f = Math.fround
+const fract = (v: number) => f(v - Math.floor(v))
+
+/** Deterministic threshold in [0, 1) for pixel (x, y). */
+export function dissolveThreshold(x: number, y: number): number {
+  const px = f(x + 0.5)
+  const py = f(y + 0.5)
+  const p3 = [fract(f(px * 0.1031)), fract(f(py * 0.1031)), fract(f(px * 0.1031))]
+  const d = f(
+    f(p3[0]! * f(p3[1]! + 33.33)) +
+      f(f(p3[1]! * f(p3[2]! + 33.33)) + f(p3[2]! * f(p3[0]! + 33.33))),
+  )
+  const q = [f(p3[0]! + d), f(p3[1]! + d), f(p3[2]! + d)]
+  return fract(f(f(q[0]! + q[1]!) * q[2]!))
+}
+
+/** Whether pixel (x, y) is covered at `opacity` (0 never, 1 always). */
+export function dissolveCovers(x: number, y: number, opacity: number): boolean {
+  return dissolveThreshold(x, y) < opacity
+}
+
+/**
+ * Dithers straight-alpha RGBA pixels in place: each alpha becomes 0 or 255, covered
+ * with the probability of its opacity. Colour is left as it is.
+ */
+export function ditherAlphaInPlace(data: Uint8ClampedArray, width: number, height: number): void {
+  for (let y = 0; y < height; y++) {
+    for (let x = 0; x < width; x++) {
+      const i = (y * width + x) * 4 + 3
+      const alpha = data[i]!
+      if (alpha === 0 || alpha === 255) continue
+      data[i] = dissolveCovers(x, y, alpha / 255) ? 255 : 0
+    }
+  }
+}
+
+type Canvas2D = OffscreenCanvasRenderingContext2D | CanvasRenderingContext2D
+
+/**
+ * Draws `source` onto `ctx` with Dissolve: its pixels' opacity dithered, then drawn
+ * over the destination. The source is copied, never modified.
+ */
+export function drawDissolved(ctx: Canvas2D, source: OffscreenCanvas | HTMLCanvasElement): void {
+  const { width, height } = source
+  const scratch = new OffscreenCanvas(width, height)
+  const scratchCtx = scratch.getContext('2d', { willReadFrequently: true })
+  if (!scratchCtx) {
+    ctx.drawImage(source, 0, 0)
+    return
+  }
+  scratchCtx.drawImage(source, 0, 0)
+  const image = scratchCtx.getImageData(0, 0, width, height)
+  ditherAlphaInPlace(image.data, width, height)
+  scratchCtx.putImageData(image, 0, 0)
+  const previous = ctx.globalCompositeOperation
+  ctx.globalCompositeOperation = 'source-over'
+  ctx.drawImage(scratch, 0, 0)
+  ctx.globalCompositeOperation = previous
+}
