--- a/src/features/preview/utils/preview-display-canvas.test.ts
+++ b/src/features/preview/utils/preview-display-canvas.test.ts
@@ -1,5 +1,9 @@
 import { describe, expect, it, vi } from 'vite-plus/test'
-import { drawSourceToPreviewDisplayCanvas } from './preview-display-canvas'
+import {
+  drawSourceToPreviewDisplayCanvas,
+  getPreviewDisplayCanvasBackingSize,
+  getPreviewDisplayCanvasStyle,
+} from './preview-display-canvas'
 
 describe('preview display edge-copy cleanup', () => {
   it('restores the caller smoothing state and rethrows an edge-copy failure', () => {
@@ -32,3 +36,50 @@
     expect(state.imageSmoothingQuality).toBe('high')
   })
 })
+
+describe('preview display canvas placement', () => {
+  it('lays the canvas out at its backing size and places it with a transform', () => {
+    // 4 source pixels of padding are 2.35 CSS pixels here: no device-pixel boundary.
+    const playerSize = { width: 752, height: 423 }
+    const renderSize = { width: 1280, height: 720 }
+
+    expect(getPreviewDisplayCanvasBackingSize(playerSize, renderSize)).toEqual({
+      width: 1288,
+      height: 728,
+    })
+    expect(getPreviewDisplayCanvasStyle(playerSize, renderSize)).toEqual({
+      left: '0px',
+      top: '0px',
+      width: '1288px',
+      height: '728px',
+      maxWidth: 'none',
+      maxHeight: 'none',
+      transformOrigin: '0 0',
+      transform: 'translate(-2.35px, -2.35px) scale(0.5875, 0.5875)',
+    })
+  })
+
+  it('maps every backing pixel by the player scale, padding included', () => {
+    for (const { playerSize, renderSize } of [
+      { playerSize: { width: 1280, height: 720 }, renderSize: { width: 1280, height: 720 } },
+      { playerSize: { width: 928, height: 522 }, renderSize: { width: 1920, height: 1080 } },
+      { playerSize: { width: 1432, height: 805.5 }, renderSize: { width: 1920, height: 1080 } },
+    ]) {
+      const backing = getPreviewDisplayCanvasBackingSize(playerSize, renderSize)
+      const style = getPreviewDisplayCanvasStyle(playerSize, renderSize)
+      const [, translateX, translateY, scaleX, scaleY] = style.transform
+        .match(/^translate\((.+)px, (.+)px\) scale\((.+), (.+)\)$/)!
+        .map(Number)
+      const padding = (backing.width - renderSize.width) / 2
+
+      expect(style.width).toBe(`${backing.width}px`)
+      expect(style.height).toBe(`${backing.height}px`)
+      expect(scaleX).toBeCloseTo(playerSize.width / renderSize.width, 12)
+      expect(scaleY).toBeCloseTo(playerSize.height / renderSize.height, 12)
+      // The first content pixel lands on the player's own origin, the last on its far edge.
+      expect(translateX! + padding * scaleX!).toBeCloseTo(0, 9)
+      expect(translateY! + padding * scaleY!).toBeCloseTo(0, 9)
+      expect(translateX! + (padding + renderSize.width) * scaleX!).toBeCloseTo(playerSize.width, 9)
+    }
+  })
+})
