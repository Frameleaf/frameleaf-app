+// @vitest-environment node
+import { afterEach, describe, expect, it, vi } from 'vite-plus/test'
+import { renderCompositionSignalFrame } from './signal-frame'
+
+const boundary = vi.hoisted(() => ({ create: vi.fn() }))
+vi.mock('@/features/export/utils/client-render-engine', () => ({
+  createCompositionRenderer: boundary.create,
+}))
+
+const composition = { width: 16, height: 16, fps: 24, tracks: [] } as never
+const setup = () => {
+  vi.stubGlobal(
+    'OffscreenCanvas',
+    class {
+      getContext() {
+        return {}
+      }
+    },
+  )
+  const signal = { width: 16, height: 16, rgba: new Float32Array([-0.5, 2, 0.333251953125, 0.5]) }
+  const renderer = { renderFrameSignal: vi.fn().mockResolvedValue(signal), dispose: vi.fn() }
+  boundary.create.mockResolvedValue(renderer)
+  return { signal, renderer }
+}
+afterEach(() => {
+  vi.restoreAllMocks()
+  vi.unstubAllGlobals()
+  boundary.create.mockReset()
+})
+
+describe('headless composition signal frame resource boundary', () => {
+  it('returns the genuine float signal unchanged rather than converting through an 8-bit canvas', async () => {
+    const { signal, renderer } = setup()
+    const result = await renderCompositionSignalFrame(composition, 3, 'pq')
+    expect(result).toBe(signal)
+    expect(Array.from(result.rgba)).toEqual([-0.5, 2, 0.333251953125, 0.5])
+    expect(renderer.renderFrameSignal).toHaveBeenCalledWith(3, 'pq')
+    expect(renderer.dispose).toHaveBeenCalledTimes(1)
+  })
+  it('disposes the renderer when the real float route refuses a frame', async () => {
+    const { renderer } = setup()
+    renderer.renderFrameSignal.mockRejectedValue(new Error('float route unavailable'))
+    await expect(renderCompositionSignalFrame(composition, 0, 'hlg')).rejects.toThrow(
+      'float route unavailable',
+    )
+    expect(renderer.dispose).toHaveBeenCalledTimes(1)
+  })
+  it('refuses an already aborted request before acquiring renderer resources', async () => {
+    setup()
+    await expect(
+      renderCompositionSignalFrame(composition, 0, 'pq', AbortSignal.abort()),
+    ).rejects.toThrow()
+    expect(boundary.create).not.toHaveBeenCalled()
+  })
+  it('disposes and rejects when abort happens during GPU readback', async () => {
+    const { renderer, signal } = setup()
+    const controller = new AbortController()
+    renderer.renderFrameSignal.mockImplementation(async () => {
+      controller.abort()
+      return signal
+    })
+    await expect(
+      renderCompositionSignalFrame(composition, 0, 'pq', controller.signal),
+    ).rejects.toThrow()
+    expect(renderer.dispose).toHaveBeenCalledTimes(1)
+  })
+  it('rejects a pending GPU readback promptly on abort and disposes its resources', async () => {
+    const { renderer } = setup()
+    const controller = new AbortController()
+    renderer.renderFrameSignal.mockImplementation(() => new Promise(() => {}))
+    const result = renderCompositionSignalFrame(composition, 0, 'pq', controller.signal)
+    await Promise.resolve()
+    controller.abort()
+    await expect(result).rejects.toThrow()
+    expect(renderer.dispose).toHaveBeenCalledTimes(1)
+  }, 200)
+  it('disposes a renderer acquired after an in-flight factory request was aborted', async () => {
+    const { renderer } = setup()
+    const controller = new AbortController()
+    boundary.create.mockImplementation(async () => {
+      controller.abort()
+      return renderer
+    })
+    await expect(
+      renderCompositionSignalFrame(composition, 0, 'hlg', controller.signal),
+    ).rejects.toThrow()
+    expect(renderer.renderFrameSignal).not.toHaveBeenCalled()
+    expect(renderer.dispose).toHaveBeenCalledTimes(1)
+  })
+})
