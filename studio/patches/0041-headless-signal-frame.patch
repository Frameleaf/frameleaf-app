+import type { CompositionInputProps } from '@/types/export'
+import { createCompositionRenderer } from '@/features/export/utils/client-render-engine'
+
+/** Own one real float renderer; no image Blob or 8-bit canvas capture is returned. */
+export async function renderCompositionSignalFrame(
+  composition: CompositionInputProps & { width: number; height: number },
+  frame: number,
+  target: 'pq' | 'hlg',
+  signal?: AbortSignal,
+) {
+  signal?.throwIfAborted()
+  const canvas = new OffscreenCanvas(composition.width, composition.height)
+  const ctx = canvas.getContext('2d')
+  if (!ctx) throw new Error('Signal frame requires a composition context')
+  const renderer = await createCompositionRenderer(composition, canvas, ctx, { mode: 'export' })
+  let disposed = false
+  const dispose = () => {
+    if (disposed) return
+    disposed = true
+    renderer.dispose()
+  }
+  let rejectAbort!: (reason: unknown) => void
+  const aborted = new Promise<never>((_, reject) => {
+    rejectAbort = reject
+  })
+  const onAbort = () => rejectAbort(signal?.reason)
+  signal?.addEventListener('abort', onAbort, { once: true })
+  try {
+    // Creation can finish after cancellation; the acquired renderer still belongs to this call.
+    signal?.throwIfAborted()
+    const result = await Promise.race([renderer.renderFrameSignal(frame, target), aborted])
+    signal?.throwIfAborted()
+    return result
+  } finally {
+    signal?.removeEventListener('abort', onAbort)
+    dispose()
+  }
+}
