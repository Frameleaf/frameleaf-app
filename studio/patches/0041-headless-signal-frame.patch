+/** A frame of genuine BT.2020 signal; only the existing GPU float route may supply it. */
+interface HeadlessSignalFrameInput extends Pick<
+  HeadlessFrameInput,
+  'project' | 'media' | 'frame' | 'atSeconds' | 'strict'
+> {
+  target: 'pq' | 'hlg'
+  /** Browser-local cancellation; Node drivers also close their page when a lease is lost. */
+  signal?: AbortSignal
+}
+
+async function renderFrameSignal(input: HeadlessSignalFrameInput) {
+  input.signal?.throwIfAborted()
+  if (input.target !== 'pq' && input.target !== 'hlg') throw new Error('Unsupported signal target')
+  const view = extractTimeline(input.project)
+  const gpuAvailable = await detectWebGpuOnce()
+  input.signal?.throwIfAborted()
+  const frame = resolveTargetFrame(view, input)
+  const validationWarnings = [
+    ...projectWarningsToHeadless(view.projectWarnings),
+    ...sourceRangeWarnings(
+      view.items,
+      view.compositions,
+      buildMediaMetadataMap(input.media),
+      view.fps,
+    ),
+    ...transitionWarnings(view.transitions, view.items, { gpuAvailable }),
+    ...transformParentWarnings(view.items),
+  ]
+  reportValidationWarnings(validationWarnings, input.strict, 'signal frame')
+  useCompositionsStore.getState().setCompositions(view.compositions)
+  registerMediaUrls(input.media)
+  seedMediaLibrary(input.media)
+  const composition = { ...buildComposition(view), width: view.width, height: view.height }
+  const warnings = await prepareFonts(composition.tracks)
+  input.signal?.throwIfAborted()
+  await assertGpuForComposition(composition, view.compositions)
+  composition.tracks = await resolveMediaUrls(composition.tracks, { useProxy: false })
+  input.signal?.throwIfAborted()
+  const signal = await renderCompositionSignalFrame(composition, frame, input.target, input.signal)
+  return {
+    ...signal,
+    frame,
+    atSeconds: frame / view.fps,
+    target: input.target,
     warnings: [...validationWarnings, ...warnings],
   }
