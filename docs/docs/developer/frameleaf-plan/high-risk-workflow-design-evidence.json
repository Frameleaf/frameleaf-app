  "flows": [
    {
      "id": "album",
      "title": "Album lifecycle and sharing",
      "requirementIds": [
        "action:albums-organization:create-album",
        "action:albums-organization:share-album-invite-people",
        "action:albums-organization:change-collaborator-editor-viewer-role-remove-collaborator-leave-shared-album",
        "action:albums-organization:create-manage-album-public-links",
        "action:albums-organization:delete-album-while-retaining-assets"
      ],
      "downstreamOwners": ["FL-53", "FL-54", "FL-56", "FL-121", "FL-137"],
      "decision": "Keep roles, public links, leave/remove, and deletion consequences explicit. Album deletion retains assets; collaborators leave rather than delete owner resources; every mutation rechecks the current role and revision.",
      "captures": ["01-album-normal.png", "06-album-empty.png"]
    },
    {
      "id": "people",
      "title": "People correction",
      "requirementIds": [
        "action:info-people:add-a-person-draw-bounding-box-search-existing-person-confirm",
        "action:info-people:create-a-person-while-tagging-a-manual-face",
        "action:info-people:edit-reassign-existing-detected-face",
        "action:info-people:display-edit-faces-with-no-named-person"
      ],
      "downstreamOwners": ["FL-36", "FL-57", "FL-121", "FL-137"],
      "decision": "Keep manual region creation separate from detected-face correction. Clear names, previews, regions, and counts when access changes; numeric region controls remain the keyboard alternative to drawing.",
      "captures": ["02-people-normal.png", "07-people-forbidden.png"]
    },
    {
      "id": "recovery",
      "title": "Bulk recovery",
      "requirementIds": [
        "setting:manual-job:integrity-missing-files",
        "setting:manual-job:integrity-checksum-mismatch",
        "setting:utility-gap:missing-media-recovery",
        "route:/utilities/missing-media"
      ],
      "downstreamOwners": ["FL-69", "FL-72", "FL-81", "FL-123", "FL-137"],
      "decision": "Candidate selection is root-bounded, owner-scoped, and reviewable per finding. Exact checksum, decode, ownership, access, and current finding state are revalidated before publication. Cancellation is a no-op; partial failure keeps the published finding recovered and unresolved findings unchanged; retry resumes only unresolved findings from the recorded checkpoint.",
      "captures": ["03-recovery-normal.png", "09-recovery-retry.png"]
    },
    {
      "id": "studio",
      "title": "Studio conflicts",
      "requirementIds": [
        "action:quick-edit:persistent-render-status-cancel-retry-reload-revision-supersession",
        "freecut:extra.portable-headless",
        "freecut:module.project-bundle",
        "freecut:module.projects",
        "route:/studio"
      ],
      "downstreamOwners": ["FL-88", "FL-91", "FL-113", "FL-137"],
      "decision": "A stale lease or newer revision blocks overwrite. Preserve the local draft, compare it with the current revision, then open latest, keep a copy, or discard before acquiring a fresh lease; takeover remains blocked while another editor's lease is active. Cloud execution remains an explicit later choice.",
      "captures": ["04-studio-normal.png", "08-studio-stale.png"]
    },
    {
      "id": "tablet",
      "title": "Native tablet adaptation",
      "requirementIds": [
        "native:mobile/lib/frameleaf/studio.page.dart#FrameleafStudioPage",
        "native:mobile/lib/frameleaf/studio.page.dart#FrameleafStudioProjectPage"
      ],
      "downstreamOwners": ["FL-125", "FL-126", "FL-127", "FL-128", "FL-137"],
      "decision": "Tablet uses native project, preview, inspector, and timeline controls over shared commands. Narrow layouts keep the current decision and preview visible while moving secondary detail to a modal sheet whose background controls are inert and whose Escape path restores focus; phones retain review and quick edit instead of a compressed full Studio.",
      "captures": ["05-tablet-normal.png", "10-tablet-keyboard.png", "11-tablet-narrow.png"]
    }
  ],
