{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["local>immich-app/.github:renovate-config"],
  "packageRules": [
    {
      "matchFileNames": [
        "machine-learning/**"
      ],
      "groupName": "machine-learning",
      "rangeStrategy": "in-range-only"
    },
    {
      "matchFileNames": [
        "machine-learning/**"
      ],
      "matchPackageNames": [
        "onnxruntime*",
        "rknn-toolkit-lite2"
      ],
      "groupName": null
    },
    {
      "description": "Frameleaf's Postgres image keeps PostgreSQL 14 and its extension versions identical to existing databases; change them only with a migration plan (FL-191).",
      "matchPackageNames": ["ghcr.io/frameleaf/frameleaf-postgres", "docker.io/pgvector/pgvector"],
      "enabled": false
    }
  ]
}
