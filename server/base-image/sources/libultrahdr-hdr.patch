+uhdr_error_info_t getHeifGainmapTransforms(
+    heif_context* ctx, heif_image_handle* base, heif_image_handle* map,
+    int& width, int& height, std::vector<std::unique_ptr<uhdr_effect_desc_t>>& effects) {
+  uhdr_error_info_t invalid = g_no_error;
+  invalid.error_code = UHDR_CODEC_UNSUPPORTED_FEATURE;
+  invalid.has_detail = 1;
+  snprintf(invalid.detail, sizeof invalid.detail, "Incompatible HEIF gain-map geometry");
+  auto read = [&](heif_image_handle* handle, int& target_w, int& target_h,
+                  std::vector<std::unique_ptr<uhdr_effect_desc_t>>& result) {
+    int w = heif_image_handle_get_ispe_width(handle), h = heif_image_handle_get_ispe_height(handle);
+    auto id = heif_image_handle_get_item_id(handle);
+    int count = heif_item_get_transformation_properties(ctx, id, nullptr, 0);
+    if (w <= 0 || h <= 0 || target_w <= 0 || target_h <= 0 || count < 0 || count > 16) return false;
+    std::vector<heif_property_id> properties(count);
+    if (heif_item_get_transformation_properties(ctx, id, properties.data(), count) != count) return false;
+    for (auto property : properties) {
+      auto type = heif_item_get_property_type(ctx, id, property);
+      if (type == heif_item_property_type_transform_rotation) {
+        int angle = heif_item_get_property_transform_rotation_ccw(ctx, id, property);
+        if (angle < 0) return false;
+        if (angle) result.emplace_back(std::make_unique<uhdr_rotate_effect_t>(360 - angle));
+        if (angle == 90 || angle == 270) { std::swap(w, h); std::swap(target_w, target_h); }
+      } else if (type == heif_item_property_type_transform_mirror) {
+        auto direction = heif_item_get_property_transform_mirror(ctx, id, property);
+        if (direction == heif_transform_mirror_direction_invalid) return false;
+        result.emplace_back(std::make_unique<uhdr_mirror_effect_t>(
+            direction == heif_transform_mirror_direction_horizontal ? UHDR_MIRROR_HORIZONTAL : UHDR_MIRROR_VERTICAL));
+      } else if (type == heif_item_property_type_transform_crop) {
+        int borders[4];
+        heif_item_get_property_transform_crop_borders(ctx, id, property, w, h,
+            &borders[0], &borders[1], &borders[2], &borders[3]);
+        int scaled[4];
+        for (int i = 0; i < 4; ++i) {
+          int dimension = i == 0 || i == 2 ? w : h;
+          int target = i == 0 || i == 2 ? target_w : target_h;
+          if (borders[i] < 0) return false;
+          int64_t value = int64_t(borders[i]) * target;
+          if (value % dimension) return false;
+          scaled[i] = value / dimension;
+        }
+        if (scaled[0] + scaled[2] >= target_w || scaled[1] + scaled[3] >= target_h) return false;
+        if (scaled[0] || scaled[1] || scaled[2] || scaled[3]) {
+          result.emplace_back(std::make_unique<uhdr_crop_effect_t>(
+              scaled[0], target_w - scaled[2], scaled[1], target_h - scaled[3]));
+        }
+        w -= borders[0] + borders[2]; h -= borders[1] + borders[3];
+        target_w -= scaled[0] + scaled[2]; target_h -= scaled[1] + scaled[3];
+      } else return false;
+    }
+    return true;
+  };
+  width = heif_image_handle_get_ispe_width(map); height = heif_image_handle_get_ispe_height(map);
+  int map_w = width, map_h = height;
+  std::vector<std::unique_ptr<uhdr_effect_desc_t>> own;
+  if (!read(base, width, height, effects) || !read(map, map_w, map_h, own)) return invalid;
+  if (!own.empty()) {
+    if (own.size() != effects.size()) return invalid;
+    for (size_t i = 0; i < own.size(); ++i)
+      if (own[i]->to_string() != effects[i]->to_string()) return invalid;
+  }
+  return g_no_error;
+}
