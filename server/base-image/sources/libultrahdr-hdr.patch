+bool getHeifBaseIccGamut(heif_image_handle* handle, uhdr_color_gamut_t& gamut) {
+  const size_t size = heif_image_handle_get_raw_color_profile_size(handle);
+  if (heif_image_handle_is_premultiplied_alpha(handle) || heif_image_handle_get_luma_bits_per_pixel(handle) != 8)
+    return false;
+  if (size == 0) {
+    heif_color_profile_nclx* raw = nullptr;
+    if (heif_image_handle_get_nclx_color_profile(handle, &raw).code != heif_error_Ok || !raw) return false;
+    std::unique_ptr<heif_color_profile_nclx, decltype(&heif_nclx_color_profile_free)> nclx(raw, heif_nclx_color_profile_free);
+    gamut = map_primaries_inverse(raw->color_primaries);
+    return gamut != UHDR_CG_UNSPECIFIED && map_transfer_inverse(raw->transfer_characteristics) == UHDR_CT_SRGB;
+  }
+  if (size > 1048576) return false;
+  std::vector<uint8_t> profile(kICCIdentifierSize + size);
+  memcpy(profile.data(), kICCIdentifier, sizeof(kICCIdentifier));
+  profile[12] = profile[13] = 1;
+  if (heif_image_handle_get_raw_color_profile(handle, profile.data() + kICCIdentifierSize).code != heif_error_Ok)
+    return false;
+  const auto cg = IccHelper::readIccColorGamut(profile.data(), profile.size());
+  std::unique_ptr<void, decltype(&cmsCloseProfile)> color(
+      cmsOpenProfileFromMem(profile.data() + kICCIdentifierSize, size), cmsCloseProfile);
+  if (cg == UHDR_CG_UNSPECIFIED || !color || !cmsIsMatrixShaper(color.get())
+      || cmsGetColorSpace(color.get()) != cmsSigRgbData || cmsGetPCS(color.get()) != cmsSigXYZData) return false;
+  auto expected = IccHelper::writeIccProfile(UHDR_CT_SRGB, cg);
+  if (!expected || expected->getLength() <= kICCIdentifierSize) return false;
+  std::unique_ptr<void, decltype(&cmsCloseProfile)> target(
+      cmsOpenProfileFromMem(static_cast<uint8_t*>(expected->getData()) + kICCIdentifierSize,
+                            expected->getLength() - kICCIdentifierSize), cmsCloseProfile);
+  if (!target) return false;
+  // Allow the bounded D50 adaptation difference between authored P3 and the codec matrix.
+  for (auto tag : {cmsSigRedColorantTag, cmsSigGreenColorantTag, cmsSigBlueColorantTag}) {
+    const auto* actual = static_cast<const cmsCIEXYZ*>(cmsReadTag(color.get(), tag));
+    const auto* reference = static_cast<const cmsCIEXYZ*>(cmsReadTag(target.get(), tag));
+    if (!actual || !reference || !std::isfinite(actual->X) || !std::isfinite(actual->Y)
+        || !std::isfinite(actual->Z) || std::abs(actual->X - reference->X) > 0.0005
+        || std::abs(actual->Y - reference->Y) > 0.0005 || std::abs(actual->Z - reference->Z) > 0.0005) return false;
+  }
+  // Gain-map math accepts sRGB SDR transfer. Other ICC curves need color-managed reconstruction.
+  for (auto tag : {cmsSigRedTRCTag, cmsSigGreenTRCTag, cmsSigBlueTRCTag}) {
+    const auto* curve = static_cast<const cmsToneCurve*>(cmsReadTag(color.get(), tag));
+    if (!curve) return false;
+    for (int i = 0; i <= 4096; ++i) {
+      const float x = float(i) / 4096;
+      const float reference = x <= 0.04045f ? x / 12.92f : std::pow((x + 0.055f) / 1.055f, 2.4f);
+      const float value = cmsEvalToneCurveFloat(curve, x);
+      if (!std::isfinite(value) || std::abs(value - reference) > 0.0001f) return false;
+    }
+  }
+  gamut = cg;
+  return true;
+}
