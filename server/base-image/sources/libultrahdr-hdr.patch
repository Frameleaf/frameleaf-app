+heif_error setHeifResourceLimits(heif_context* ctx, uint64_t pixels, uint64_t bytes) {
+  auto* limits = heif_context_get_security_limits(ctx);
+  if (!limits || limits->version < 2 || !pixels || !bytes)
+    return {heif_error_Memory_allocation_error, heif_suberror_Security_limit_exceeded, "Invalid HEIF resource budget"};
+  limits->max_image_size_pixels = pixels;
+  limits->max_color_profile_size = std::min(limits->max_color_profile_size, uint32_t(std::min(bytes, uint64_t(1048576))));
+  limits->max_memory_block_size = std::min(limits->max_memory_block_size, bytes);
+  limits->max_total_memory = std::min(limits->max_total_memory, bytes);
+  return {heif_error_Ok, heif_suberror_Unspecified, ""};
+}
