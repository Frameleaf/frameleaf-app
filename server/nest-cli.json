{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": false,
    "plugins": [
      {
        "name": "@nestjs/swagger",
        "options": {
          "classValidatorShim": true,
          "introspectComments": true
        }
      }
    ],
    "assets": [
      {
        "include": "schema/migrations/ORDER"
      },
      {
        "include": "schema/catalog/*.json"
      },
      {
        "include": "schema/catalog/*.sql"
      }
    ]
  }
}
