#!/usr/bin/env bash

# FL-294: FRAMELEAF_* names first, then their deprecated IMMICH_* aliases
log_level="${FRAMELEAF_LOG_LEVEL:-$IMMICH_LOG_LEVEL}"
workers_include="${FRAMELEAF_WORKERS_INCLUDE:-$IMMICH_WORKERS_INCLUDE}"
workers_exclude="${FRAMELEAF_WORKERS_EXCLUDE:-$IMMICH_WORKERS_EXCLUDE}"

log_container_verbose() {
  if [[ $log_level == verbose ]]; then
    echo "$1" > /proc/1/fd/2
  fi
}

if [[ ( $workers_include != '' && $workers_include != *api* ) || $workers_exclude == *api* ]]; then
  echo "API worker excluded, skipping"
  exit 0
fi

host="${FRAMELEAF_HOST:-${IMMICH_HOST:-localhost}}"
port="${FRAMELEAF_PORT:-${IMMICH_PORT:-2283}}"

# FL-295: on the first start on a library the official server created, the "Getting Ready…" worker
# makes a safety copy of the database before upgrading, and ping answers 503 (the API is not ready;
# clients rely on that). The container is still healthy then, so an orchestrator that restarts unhealthy
# containers does not interrupt the copy, however long it takes. An error there counts as healthy too:
# a restart only tries the copy again. Only that worker answers this status.
getting_ready() {
  local status state
  status=$(curl -fsS -m 2 http://"$host":"$port"/api/server/getting-ready 2>/dev/null) || return 1
  state=$(node -e 'const s = JSON.parse(process.argv[1]).state; if (typeof s !== "string") process.exit(1); process.stdout.write(s)' -- "$status" 2>/dev/null) || return 1
  case "$state" in
    checking | backing-up | skipped | done | ready | failed)
      echo "Frameleaf is getting ready ($state)"
      log_container_verbose "Healthcheck: getting ready ($state)"
      return 0
      ;;
  esac
  return 1
}

result=$(curl -fsS -m 2 http://"$host":"$port"/api/server/ping)
result_exit=$?

if [ $result_exit != 0 ]; then
  getting_ready && exit 0
  echo "Fail: exit code is $result_exit"
  log_container_verbose "Healthcheck failed: exit code $result_exit"
  exit 1
fi

if ! node -e 'process.exit(JSON.parse(process.argv[1]).res === "pong" ? 0 : 1)' -- "$result" >/dev/null 2>&1; then
  getting_ready && exit 0
  echo "Fail: didn't reply with pong"
  log_container_verbose "Healthcheck failed: didn't reply with pong"
  exit 1
fi
