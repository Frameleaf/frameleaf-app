  "cases": [
    {
      "name": "known template renders only system text",
      "locale": "en-XA",
      "template": {
        "version": 1,
        "key": "item-share-one",
        "args": {
          "senderName": "Zoë <img src=x> $& {count}"
        }
      },
      "fallback": {
        "title": "Shared with you",
        "body": "Zoë <img src=x> $& {count} shared an item with you"
      },
      "expected": {
        "title": "[Fixture shared]",
        "body": "[Fixture Zoë <img src=x> $& {count} shared one item]"
      }
    },
    {
      "name": "new known template needs no consumer mapping",
      "locale": "en-XA",
      "template": {
        "version": 1,
        "key": "access-removed-unknown",
        "args": {}
      },
      "fallback": {
        "title": "Access changed",
        "body": "You no longer have access to an album"
      },
      "expected": {
        "title": "[Fixture access]",
        "body": "[Fixture album access ended]"
      }
    },
