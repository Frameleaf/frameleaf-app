{
  "DescriptionsRequest": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "language": {
        "type": "string",
        "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$"
      },
      "length": {
        "type": "string",
        "enum": [
          "short",
          "standard",
          "long"
        ]
      },
      "style": {
        "type": "string",
        "enum": [
          "natural",
          "factual"
        ]
      },
      "maxTags": {
        "type": "integer",
        "minimum": 0,
        "maximum": 30
      },
      "features": {
        "type": "object",
        "properties": {
          "identityNames": {
            "type": "boolean"
          },
          "medicalSignals": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "additionalProperties": false
  },
  "DescriptionItem": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "inputId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{1,64}$"
      },
      "description": {
        "type": "string",
        "maxLength": 1200,
        "pattern": "^[^\\p{Cc}<>]*$"
      },
      "tags": {
        "maxItems": 30,
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 48,
          "pattern": "^[^\\p{Cc}<>]*$"
        }
      },
      "moment": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[^\\p{Cc}<>]*$"
          },
          {
            "type": "null"
          }
        ]
      },
      "confidence": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "warnings": {
        "maxItems": 7,
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "input-unsupported",
            "input-too-large",
            "input-unreadable",
            "output-invalid",
            "metadata-removed",
            "content-removed",
            "truncated"
          ]
        }
      }
    },
    "required": [
      "inputId",
      "description",
      "tags",
      "moment",
      "confidence",
      "warnings"
    ],
    "additionalProperties": false
  },
  "DescriptionsResult": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "schema": {
        "type": "string",
        "const": "frameleaf.descriptions/v1"
      },
      "modelSku": {
        "type": "string",
        "pattern": "^ms_[0-9A-HJKMNP-TV-Z]{8}$"
      },
      "modelRev": {
        "type": "string",
        "pattern": "^mr_[0-9A-HJKMNP-TV-Z]{12}$"
      },
      "language": {
        "type": "string",
        "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$"
      },
      "items": {
        "minItems": 1,
        "maxItems": 1000,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "inputId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,64}$"
            },
            "description": {
              "type": "string",
              "maxLength": 1200,
              "pattern": "^[^\\p{Cc}<>]*$"
            },
            "tags": {
              "maxItems": 30,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 48,
                "pattern": "^[^\\p{Cc}<>]*$"
              }
            },
            "moment": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120,
                  "pattern": "^[^\\p{Cc}<>]*$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "warnings": {
              "maxItems": 7,
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "input-unsupported",
                  "input-too-large",
                  "input-unreadable",
                  "output-invalid",
                  "metadata-removed",
                  "content-removed",
                  "truncated"
                ]
              }
            }
          },
          "required": [
            "inputId",
            "description",
            "tags",
            "moment",
            "confidence",
            "warnings"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "schema",
      "modelSku",
      "modelRev",
      "language",
      "items"
    ],
    "additionalProperties": false
  }
}
