{
  "name": "@frameleaf/manager",
  "version": "0.2.9",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "build": "node node_modules/@typescript/native/bin/tsc -p tsconfig.json && vite build",
    "check": "node node_modules/@typescript/native/bin/tsc -p tsconfig.json --noEmit && svelte-check --tsgo --tsconfig ./ui/tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts",
    "start": "node build/main.js"
  },
  "dependencies": {
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "express": "5.3.0",
    "js-yaml": "5.4.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/express": "5.0.6",
    "@types/js-yaml": "4.0.9",
    "@types/node": "26.6.5",
    "@typescript/native": "npm:typescript@7.0.2",
    "playwright": "1.64.0",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.4"
  }
}
