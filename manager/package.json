{
  "name": "@frameleaf/manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build",
    "check": "tsc -p tsconfig.json --noEmit && svelte-check --tsconfig ./ui/tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts",
    "start": "node build/main.js"
  },
  "dependencies": {
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-express": "12.1.2",
    "express": "5.1.0",
    "js-yaml": "5.4.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@types/express": "5.0.3",
    "@types/js-yaml": "4.0.9",
    "@types/node": "24.13.4",
    "playwright": "1.62.1",
    "svelte": "5.56.10",
    "svelte-check": "4.4.6",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vite": "8.2.2"
  }
}
