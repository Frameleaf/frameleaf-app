# Restoration worker (FL-114). NOT QUALIFIED: see video-restoration/README.md.
#
# Build context: machine-learning/. Targets:
#
#   worker  The HTTP worker, ffmpeg and nvidia-smi access only. Every model reports
#           runtime-missing, so it serves no restoration workload. Useful for wiring checks.
#   full    The worker plus both isolated model runtimes. Needs explicit pins:
#             --build-arg REALBASICVSR_REVISION=<40-char commit>
#             --build-arg REALBASICVSR_PYTHON=<python version the lock was made for>
#             --build-arg SEEDVR2_REVISION=<40-char commit>
#             --build-arg SEEDVR2_PYTHON=<python version the lock was made for>
#             --build-arg SEEDVR2_BUILD_BASE=nvidia/cuda:<version>-devel-...@sha256:<digest>
#           and hashed lock files at video-restoration/runtimes/realbasicvsr.lock and
#           video-restoration/runtimes/seedvr2.lock (pip format, --require-hashes). None of
#           these are committed because none has been qualified yet.
#
# Weights are never baked into the image. Mount them read-only (default /restoration/weights,
# and SeedVR2's ckpts/ inside its checkout) and mount the manifest and qualification files
# at /restoration/config. Each runtime keeps its .git directory so the worker can prove the
# checkout is at the pinned commit and unmodified.

ARG CUDA_RUNTIME_BASE=nvidia/cuda:12.2.2-runtime-ubuntu22.04@sha256:94c1577b2cd9dd6c0312dc04dff9cb2fdce2b268018abc3d7c2dbcacf1155000
ARG SEEDVR2_BUILD_BASE=${CUDA_RUNTIME_BASE}

FROM ${CUDA_RUNTIME_BASE} AS worker-base

ENV DEBIAN_FRONTEND=noninteractive \
    UV_PYTHON_INSTALL_DIR=/opt/python \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates ffmpeg git tini && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.8.15@sha256:a5727064a0de127bdb7c9d3c1383f3a9ac307d9f2d8a391edc7896c54289ced0 /uv /uvx /bin/

# The worker app uses the repository's locked machine-learning dependencies (CPU extra: it
# never loads a model itself), in its own environment separate from both model runtimes.
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=uv.lock,target=uv.lock \
    --mount=type=bind,source=pyproject.toml,target=pyproject.toml \
    uv python install 3.12.11 && \
    uv venv --python 3.12.11 /opt/venv && \
    VIRTUAL_ENV=/opt/venv uv sync --frozen --extra cpu --no-dev --no-editable --no-install-project \
      --compile-bytecode --no-progress --active --link-mode copy

FROM worker-base AS worker

WORKDIR /usr/src
COPY immich_ml immich_ml

ARG BUILD_SOURCE_COMMIT
ARG FRAMELEAF_RESTORATION_IMAGE_REVISION=${BUILD_SOURCE_COMMIT}
ENV PATH="/opt/venv/bin:$PATH" \
    VIRTUAL_ENV=/opt/venv \
    PYTHONPATH=/usr/src \
    DO_NOT_TRACK=1 \
    HF_HUB_OFFLINE=1 \
    HF_HUB_DISABLE_TELEMETRY=1 \
    FRAMELEAF_RESTORATION_IMAGE_REVISION=${FRAMELEAF_RESTORATION_IMAGE_REVISION} \
    FRAMELEAF_RESTORATION_MODELS=/restoration/config/models.json \
    FRAMELEAF_RESTORATION_QUALIFICATION=/restoration/config/qualification.json \
    FRAMELEAF_RESTORATION_WORKDIR=/restoration/work \
    FRAMELEAF_RESTORATION_PORT=3004

RUN mkdir -p /restoration/config /restoration/weights /restoration/work

EXPOSE 3004
ENTRYPOINT ["tini", "--"]
CMD ["python", "-m", "immich_ml.video_restoration"]
HEALTHCHECK CMD python -c "import os, sys, urllib.request; sys.exit(0 if urllib.request.urlopen('http://localhost:' + os.environ.get('FRAMELEAF_RESTORATION_PORT', '3004') + '/ping', timeout=2).status == 200 else 1)"

# ---------------------------------------------------------------------------------------
# Faithful: RealBasicVSR at an exact commit in its own environment.
# ---------------------------------------------------------------------------------------
FROM worker-base AS realbasicvsr-runtime

ARG REALBASICVSR_REVISION
ARG REALBASICVSR_PYTHON
RUN test -n "$REALBASICVSR_REVISION" && test -n "$REALBASICVSR_PYTHON" || \
    { echo "REALBASICVSR_REVISION and REALBASICVSR_PYTHON must pin the qualified runtime" >&2; exit 1; }

RUN git init -q /opt/restoration/realbasicvsr && \
    git -C /opt/restoration/realbasicvsr remote add origin https://github.com/ckkelvinchan/RealBasicVSR.git && \
    git -C /opt/restoration/realbasicvsr fetch -q --depth 1 origin "$REALBASICVSR_REVISION" && \
    git -C /opt/restoration/realbasicvsr checkout -q --detach FETCH_HEAD && \
    test "$(git -C /opt/restoration/realbasicvsr rev-parse HEAD)" = "$REALBASICVSR_REVISION"

RUN --mount=type=bind,source=video-restoration/runtimes,target=/runtimes \
    test -f /runtimes/realbasicvsr.lock || { echo "video-restoration/runtimes/realbasicvsr.lock is required" >&2; exit 1; } && \
    uv python install "$REALBASICVSR_PYTHON" && \
    uv venv --python "$REALBASICVSR_PYTHON" /opt/restoration/realbasicvsr/.venv && \
    VIRTUAL_ENV=/opt/restoration/realbasicvsr/.venv uv pip install --require-hashes --no-deps -r /runtimes/realbasicvsr.lock

# ---------------------------------------------------------------------------------------
# Creative: SeedVR2 at an exact commit. Its CUDA extensions need a devel base to build.
# ---------------------------------------------------------------------------------------
FROM ${SEEDVR2_BUILD_BASE} AS seedvr2-runtime

ENV DEBIAN_FRONTEND=noninteractive \
    UV_PYTHON_INSTALL_DIR=/opt/python

RUN command -v nvcc >/dev/null || \
    { echo "SEEDVR2_BUILD_BASE must be a pinned CUDA devel image (nvcc is required)" >&2; exit 1; }
RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates git build-essential && \
    rm -rf /var/lib/apt/lists/*
COPY --from=ghcr.io/astral-sh/uv:0.8.15@sha256:a5727064a0de127bdb7c9d3c1383f3a9ac307d9f2d8a391edc7896c54289ced0 /uv /uvx /bin/

ARG SEEDVR2_REVISION
ARG SEEDVR2_PYTHON
RUN test -n "$SEEDVR2_REVISION" && test -n "$SEEDVR2_PYTHON" || \
    { echo "SEEDVR2_REVISION and SEEDVR2_PYTHON must pin the qualified runtime" >&2; exit 1; }

RUN git init -q /opt/restoration/seedvr && \
    git -C /opt/restoration/seedvr remote add origin https://github.com/ByteDance-Seed/SeedVR.git && \
    git -C /opt/restoration/seedvr fetch -q --depth 1 origin "$SEEDVR2_REVISION" && \
    git -C /opt/restoration/seedvr checkout -q --detach FETCH_HEAD && \
    test "$(git -C /opt/restoration/seedvr rev-parse HEAD)" = "$SEEDVR2_REVISION"

RUN --mount=type=bind,source=video-restoration/runtimes,target=/runtimes \
    test -f /runtimes/seedvr2.lock || { echo "video-restoration/runtimes/seedvr2.lock is required" >&2; exit 1; } && \
    uv python install "$SEEDVR2_PYTHON" && \
    uv venv --python "$SEEDVR2_PYTHON" /opt/restoration/seedvr/.venv && \
    VIRTUAL_ENV=/opt/restoration/seedvr/.venv uv pip install --require-hashes --no-deps -r /runtimes/seedvr2.lock

# ---------------------------------------------------------------------------------------
# Worker with both runtimes. Still serves nothing until the manifest, weights and a
# qualification record for this image revision are mounted.
# ---------------------------------------------------------------------------------------
FROM worker AS full

COPY --from=realbasicvsr-runtime /opt/python /opt/python
COPY --from=realbasicvsr-runtime /opt/restoration/realbasicvsr /opt/restoration/realbasicvsr
COPY --from=seedvr2-runtime /opt/python /opt/python
COPY --from=seedvr2-runtime /opt/restoration/seedvr /opt/restoration/seedvr
