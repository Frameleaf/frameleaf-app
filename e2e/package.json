{
  "name": "frameleaf-e2e",
  "version": "1.1.15",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:ui-fixtures": "vitest run --config vitest.ui-fixtures.config.ts",
    "test:maintenance": "vitest --run --config vitest.maintenance.config.ts",
    "test:cloud": "vitest --run --config vitest.cloud.config.ts",
    "test:web": "pnpm exec playwright test --project=web",
    "test:web:maintenance": "pnpm exec playwright test --project=maintenance",
    "test:web:icloud": "FL144_ICLOUD_BRIDGE=true pnpm exec playwright test --project=web icloud-sync",
    "test:web:ui": "pnpm exec playwright test --project=ui",
    "start:web": "pnpm exec playwright test --ui --project=web",
    "start:web:maintenance": "pnpm exec playwright test --ui --project=maintenance",
    "start:web:ui": "pnpm exec playwright test --ui --project=ui",
    "format": "prettier --cache --check .",
    "format:fix": "prettier --cache --write --list-different .",
    "lint": "eslint \"src/**/*.ts\" --max-warnings 0",
    "lint:fix": "pnpm run lint --fix",
    "check": "tsc --noEmit",
    "test:web:ui:studio-firefox": "PLAYWRIGHT_STUDIO_FIREFOX=1 pnpm exec playwright test --project=studio-firefox",
    "test:web:ui:studio-firefox-tablet": "PLAYWRIGHT_STUDIO_FIREFOX=1 pnpm exec playwright test --project=studio-firefox-tablet"
  },
  "keywords": [],
  "author": "",
  "license": "GNU Affero General Public License version 3",
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@frameleaf/cli": "workspace:*",
    "@frameleaf/e2e-auth-server": "workspace:*",
    "@frameleaf/sdk": "workspace:*",
    "@playwright/test": "^1.64.0",
    "@socket.io/component-emitter": "^3.1.2",
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/pngjs": "^6.0.5",
    "@types/supertest": "^7.2.1",
    "dotenv": "^18.0.7",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-unicorn": "^78.0.0",
    "exiftool-vendored": "^39.0.1",
    "globals": "^17.13.0",
    "luxon": "^3.7.2",
    "pg": "^8.23.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-organize-imports": "^4.3.0",
    "sharp": "^0.35.5",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.2",
    "utimes": "^5.2.1",
    "vitest": "^5.0.4"
  }
}
