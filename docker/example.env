# You can find documentation for all the supported env variables at https://help.frameleaf.app/install/environment-variables

# The location where your uploaded files are stored
UPLOAD_LOCATION=./library

# The location where your database files are stored. Network shares are not supported for the database
DB_DATA_LOCATION=./postgres19

# Put ML-only settings in .env.ml beside this file; it is optional.
# The machine-learning container does not receive this server environment file.
# For private backup/identity storage and migration, see the backup and restore guide.

# To set a timezone, uncomment the next line and change Etc/UTC to a TZ identifier from this list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones#List
# TZ=Etc/UTC

# Frameleaf image tag. latest is the current stable release; edge follows development builds.
# Exact tags are frameleaf-vX.Y.Z (there is no plain X.Y.Z tag). The deprecated IMMICH_VERSION in an earlier .env still works when this is not set.
FRAMELEAF_VERSION=latest

# Host ports, for when another service already uses them.
# FRAMELEAF_HOST_PORT=2283
# Frameleaf Cloud direct connections. If you change it, set the same port in the app's Remote access settings.
# FRAMELEAF_HOST_HTTPS_PORT=2443

# Upgrading a stack created by Frameleaf 1.1.12 or earlier? Keep its Compose project, containers and volumes:
# COMPOSE_PROJECT_NAME=immich

# Connection secret for postgres. You should change it to a random password
# Please use only the characters `A-Za-z0-9`, without special characters or spaces
DB_PASSWORD=postgres

# The values below this line do not need to be changed
###################################################################################
DB_USERNAME=postgres
DB_DATABASE_NAME=frameleaf
