# TrueNAS 24.10.2.2+ Custom App / Install via YAML. Replace POOL_NAME with the name of
# one of your pools (Storage lists them); it is the only value to edit. Folders for
# photos, the database and backups are chosen and created in Manager.
services:
  manager:
    image: ghcr.io/frameleaf/frameleaf-manager:latest
    restart: unless-stopped
    labels:
      app.frameleaf.manager.role: controller
    security_opt: [no-new-privileges:true]
    cap_drop: [ALL]
    # Root must write NAS folders it does not own (Unraid nobody:users, TrueNAS apps).
    cap_add: [CHOWN, DAC_OVERRIDE, FOWNER]
    ports: ['2282:9443']
    environment:
      # Publish the installed Frameleaf app on the network, not only on this server.
      MANAGER_BIND_ADDRESS: 0.0.0.0
      MANAGER_PLATFORM: truenas
      MANAGER_DATA: /mnt/POOL_NAME/frameleaf/manager
    volumes:
      - type: bind
        source: /var/run/docker.sock
        target: /var/run/docker.sock
      - type: bind
        source: /proc/1/mountinfo
        target: /run/frameleaf-host/mountinfo
        read_only: true
      # Lets Manager offer your pools when you choose folders. rslave picks up datasets and
      # pools that appear later. Frameleaf itself only sees the folders you choose.
      - type: bind
        source: /mnt
        target: /mnt
        bind: {propagation: rslave, create_host_path: false}
