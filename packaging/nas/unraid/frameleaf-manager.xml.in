<Container version="2">
  <Name>frameleaf-manager</Name>
  <Repository>ghcr.io/frameleaf/frameleaf-manager:latest</Repository>
  <Registry>https://ghcr.io</Registry>
  <Network>bridge</Network>
  <Privileged>false</Privileged>
  <Project>https://github.com/Frameleaf/frameleaf-app</Project>
  <Support>https://github.com/Frameleaf/frameleaf-app/issues</Support>
  <Overview>Install and manage a self-hosted Frameleaf photo and video library. Manager coordinates sibling services through the Docker socket. Encrypted recovery covers the database and configuration, not media originals. Before applying, create the storage folders and follow the linked setup guide for the storage mappings. Create the administrator from your home network on first open.</Overview>
  <Category>MediaApp:Photos</Category>
  <Icon>https://raw.githubusercontent.com/Frameleaf/frameleaf-app/main/design/frameleaf/brand-kit/frameleaf-app-icon.svg</Icon>
  <TemplateURL>https://raw.githubusercontent.com/Frameleaf/unraid-apps/main/templates/frameleaf-manager.xml</TemplateURL>
  <ReadMe>https://github.com/Frameleaf/unraid-apps#readme</ReadMe>
  <License>https://github.com/Frameleaf/unraid-apps/blob/main/LICENSE</License>
  <WebUI>https://[IP]:[PORT:9443]</WebUI>
  <ExtraParams>--label app.frameleaf.manager.role=controller --security-opt no-new-privileges --cap-drop ALL --cap-add CHOWN --cap-add DAC_OVERRIDE --cap-add FOWNER</ExtraParams>
  <Config Name="Manager HTTPS port" Target="9443" Default="2282" Mode="tcp" Description="Port you open Manager on. 2282 sits next to Frameleaf (2283) and avoids 9443, which Portainer and other apps often use" Type="Port" Display="always" Required="true" Mask="false">2282</Config>
  <Config Name="Manager HTTPS origin" Target="MANAGER_ORIGIN" Default="" Description="Optional. Leave blank to open Manager by IP address or tower.local. Only for a custom DNS name, enter that exact HTTPS address with port (for example https://nas.example.com:2282) and set Advanced View WebUI to match." Type="Variable" Display="always" Required="false" Mask="false"></Config>
  <Config Name="Manager state" Target="/mnt/user/appdata/frameleaf-manager" Default="/mnt/user/appdata/frameleaf-manager" Mode="rw" Description="Persistent sessions and recovery configuration. When changing the host path, change the container path and MANAGER_DATA too." Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/frameleaf-manager</Config>
  <Config Name="Media" Target="/mnt/user/appdata/frameleaf-media" Default="/mnt/user/appdata/frameleaf-media" Mode="rw" Description="Original media. Keep host and container paths identical and update MANAGER_STORAGE_ROOTS." Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/frameleaf-media</Config>
  <Config Name="Database parent" Target="/mnt/user/appdata/frameleaf-databases" Default="/mnt/user/appdata/frameleaf-databases" Mode="rw" Description="Physical host storage outside Docker data/docker.img. Keep host and container paths identical and update database root variables." Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/frameleaf-databases</Config>
  <Config Name="Database backups" Target="/mnt/user/appdata/frameleaf-backups" Default="/mnt/user/appdata/frameleaf-backups" Mode="rw" Description="Encrypted database-only checkpoints. Keep host and container paths identical and update MANAGER_BACKUP_ROOT." Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/frameleaf-backups</Config>
  <Config Name="State path" Target="MANAGER_DATA" Default="/mnt/user/appdata/frameleaf-manager" Description="Must equal both paths in the Manager state mapping above." Type="Variable" Display="advanced" Required="true" Mask="false">/mnt/user/appdata/frameleaf-manager</Config>
  <Config Name="Media roots" Target="MANAGER_STORAGE_ROOTS" Default="/mnt/user/appdata/frameleaf-media" Description="Approved media folders, separated by colons. Each needs an identical host/container mapping." Type="Variable" Display="advanced" Required="true" Mask="false">/mnt/user/appdata/frameleaf-media</Config>
  <Config Name="Database roots" Target="MANAGER_DATABASE_ROOTS" Default="/mnt/user/appdata/frameleaf-databases" Description="Approved database parent folders, separated by colons. Each needs an identical host/container mapping." Type="Variable" Display="advanced" Required="true" Mask="false">/mnt/user/appdata/frameleaf-databases</Config>
  <Config Name="Database default" Target="MANAGER_APPDATA_ROOT" Default="/mnt/user/appdata/frameleaf-databases" Description="Default database parent. Must be one of the mapped database roots above." Type="Variable" Display="advanced" Required="true" Mask="false">/mnt/user/appdata/frameleaf-databases</Config>
  <Config Name="Backup path" Target="MANAGER_BACKUP_ROOT" Default="/mnt/user/appdata/frameleaf-backups" Description="Must equal both paths in the Database backups mapping above. Does not back up media." Type="Variable" Display="advanced" Required="true" Mask="false">/mnt/user/appdata/frameleaf-backups</Config>
  <Config Name="Frameleaf address" Target="MANAGER_BIND_ADDRESS" Default="0.0.0.0" Description="Where the Frameleaf app it installs is published. 0.0.0.0 makes it reachable from other devices on your network; 127.0.0.1 limits it to this server." Type="Variable" Display="advanced" Required="true" Mask="false">0.0.0.0</Config>
  <Config Name="Platform" Target="MANAGER_PLATFORM" Default="unraid" Description="Unraid host integration; keep this value." Type="Variable" Display="advanced" Required="true" Mask="false">unraid</Config>
  <Config Name="Docker socket" Target="/var/run/docker.sock" Default="/var/run/docker.sock" Mode="rw" Description="Allows Manager to create and control sibling containers on this host." Type="Path" Display="advanced" Required="true" Mask="false">/var/run/docker.sock</Config>
  <Config Name="Host mount information" Target="/run/frameleaf-host/mountinfo" Default="/proc/1/mountinfo" Mode="ro" Description="Read-only host filesystem evidence for database storage checks." Type="Path" Display="advanced" Required="true" Mask="false">/proc/1/mountinfo</Config>
  <Config Name="Unraid Docker configuration" Target="/run/frameleaf-host/docker.cfg" Default="/boot/config/docker.cfg" Mode="ro" Description="Read-only Unraid appdata and Docker storage configuration." Type="Path" Display="advanced" Required="true" Mask="false">/boot/config/docker.cfg</Config>
  <Config Name="Unraid autostart file" Target="/run/frameleaf-host/unraid-autostart" Default="" Mode="rw" Description="Required for imports: select the existing unraid-autostart file beneath the exact DockerRootDir reported by docker info. Do not create a replacement or guess a pool path." Type="Path" Display="always" Required="false" Mask="false"></Config>
  <Config Name="Autostart controller path" Target="MANAGER_UNRAID_AUTOSTART" Default="" Description="Leave blank unless the autostart file above is mounted. For an import, set this to /run/frameleaf-host/unraid-autostart after selecting that existing host file." Type="Variable" Display="always" Required="false" Mask="false"></Config>
</Container>
