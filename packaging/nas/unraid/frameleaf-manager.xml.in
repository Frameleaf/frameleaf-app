<Container version="2">
  <Name>frameleaf-manager</Name>
  <Repository>@MANAGER_REF@</Repository>
  <Registry>https://ghcr.io</Registry>
  <Network>bridge</Network>
  <Privileged>false</Privileged>
  <Project>https://github.com/Frameleaf/frameleaf-app</Project>
  <Support>https://github.com/Frameleaf/frameleaf-app/issues</Support>
  <Overview>Frameleaf Manager installs or imports a library, manages services, updates and encrypted database recovery. Read the private claim key in the selected Manager state folder. Keep host and container storage paths identical. Add each existing source media or database folder as an identical host/container mapping before import. This controller has Docker socket access.</Overview>
  <Category>MediaApp:Photos</Category>
  <Icon>https://raw.githubusercontent.com/Frameleaf/frameleaf-app/fork/main/design/frameleaf/brand-kit/frameleaf-app-icon.svg</Icon>
  <WebUI>https://[IP]:[PORT:9443]</WebUI>
  <ExtraParams>--label app.frameleaf.manager.role=controller --security-opt no-new-privileges --cap-drop ALL</ExtraParams>
  <Config Name="Manager HTTPS port" Target="9443" Default="9443" Mode="tcp" Description="Use this same port in Manager HTTPS origin" Type="Port" Display="always" Required="true" Mask="false">9443</Config>
  <Config Name="Manager HTTPS origin" Target="MANAGER_ORIGIN" Default="" Description="Exact HTTPS origin, for example https://nas.example:9443" Type="Variable" Display="always" Required="true" Mask="false"></Config>
  <Config Name="Manager state" Target="/mnt/user/appdata/frameleaf-manager" Default="/mnt/user/appdata/frameleaf-manager" Mode="rw" Description="Persistent claim key, sessions and recovery configuration. When changing the host path, change the container path and MANAGER_DATA too." Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/frameleaf-manager</Config>
  <Config Name="Media" Target="/mnt/user/appdata/frameleaf-media" Default="/mnt/user/appdata/frameleaf-media" Mode="rw" Description="Original media. Keep host and container paths identical and update MANAGER_STORAGE_ROOTS." Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/frameleaf-media</Config>
  <Config Name="Database parent" Target="/mnt/user/appdata/frameleaf-databases" Default="/mnt/user/appdata/frameleaf-databases" Mode="rw" Description="Physical host storage outside Docker data/docker.img. Keep host and container paths identical and update database root variables." Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/frameleaf-databases</Config>
  <Config Name="Database backups" Target="/mnt/user/appdata/frameleaf-backups" Default="/mnt/user/appdata/frameleaf-backups" Mode="rw" Description="Encrypted database-only checkpoints. Keep host and container paths identical and update MANAGER_BACKUP_ROOT." Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/frameleaf-backups</Config>
  <Config Name="State path" Target="MANAGER_DATA" Default="/mnt/user/appdata/frameleaf-manager" Type="Variable" Display="advanced" Required="true" Mask="false">/mnt/user/appdata/frameleaf-manager</Config>
  <Config Name="Media roots" Target="MANAGER_STORAGE_ROOTS" Default="/mnt/user/appdata/frameleaf-media" Type="Variable" Display="advanced" Required="true" Mask="false">/mnt/user/appdata/frameleaf-media</Config>
  <Config Name="Database roots" Target="MANAGER_DATABASE_ROOTS" Default="/mnt/user/appdata/frameleaf-databases" Type="Variable" Display="advanced" Required="true" Mask="false">/mnt/user/appdata/frameleaf-databases</Config>
  <Config Name="Database default" Target="MANAGER_APPDATA_ROOT" Default="/mnt/user/appdata/frameleaf-databases" Type="Variable" Display="advanced" Required="true" Mask="false">/mnt/user/appdata/frameleaf-databases</Config>
  <Config Name="Backup path" Target="MANAGER_BACKUP_ROOT" Default="/mnt/user/appdata/frameleaf-backups" Type="Variable" Display="advanced" Required="true" Mask="false">/mnt/user/appdata/frameleaf-backups</Config>
  <Config Name="Platform" Target="MANAGER_PLATFORM" Default="unraid" Type="Variable" Display="advanced" Required="true" Mask="false">unraid</Config>
  <Config Name="Docker socket" Target="/var/run/docker.sock" Default="/var/run/docker.sock" Mode="rw" Type="Path" Display="advanced" Required="true" Mask="false">/var/run/docker.sock</Config>
  <Config Name="Host mount information" Target="/run/frameleaf-host/mountinfo" Default="/proc/1/mountinfo" Mode="ro" Type="Path" Display="advanced" Required="true" Mask="false">/proc/1/mountinfo</Config>
  <Config Name="Unraid Docker configuration" Target="/run/frameleaf-host/docker.cfg" Default="/boot/config/docker.cfg" Mode="ro" Type="Path" Display="advanced" Required="true" Mask="false">/boot/config/docker.cfg</Config>
  <Config Name="Unraid autostart file" Target="/run/frameleaf-host/unraid-autostart" Default="" Mode="rw" Description="Required for imports: select the existing unraid-autostart file beneath the exact DockerRootDir reported by docker info. Do not create a replacement or guess a pool path." Type="Path" Display="always" Required="false" Mask="false"></Config>
  <Config Name="Autostart controller path" Target="MANAGER_UNRAID_AUTOSTART" Default="" Description="Leave blank unless the autostart file above is mounted. For an import, set this to /run/frameleaf-host/unraid-autostart after selecting that existing host file." Type="Variable" Display="always" Required="false" Mask="false"></Config>
</Container>
