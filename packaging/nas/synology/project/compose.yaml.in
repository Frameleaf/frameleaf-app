name: frameleaf
services:
  server:
    image: @SERVER_REF@
    environment:
      DB_PASSWORD: ${DB_PASSWORD:?Missing installer configuration}
      DB_HOSTNAME: database
      DB_USERNAME: immich
      DB_DATABASE_NAME: immich
      REDIS_HOSTNAME: redis
      IMMICH_MACHINE_LEARNING_ENABLED: ${ENABLE_ML:?Missing installer configuration}
      IMMICH_MACHINE_LEARNING_URL: http://machine-learning:3003
    volumes:
      - type: bind
        source: ${UPLOAD_LOCATION:?Missing installer configuration}
        target: /data
        bind:
          create_host_path: false
    ports:
      - ${WEB_PORT:?Missing installer configuration}:2283
    depends_on:
      - database
      - redis
    restart: unless-stopped
    # FL-291: must exceed FRAMELEAF_SHUTDOWN_DEADLINE_SECONDS (9 s by default); running jobs finish or go back to waiting first
    stop_grace_period: 10s
    healthcheck:
      test: [CMD, immich-healthcheck]
  machine-learning:
    profiles: [ml]
    image: @ML_REF@
    volumes:
      - model-cache:/cache
    restart: unless-stopped
    healthcheck:
      test: [CMD, python3, healthcheck.py]
  database:
    image: @PG_REF@
    environment:
      POSTGRES_USER: immich
      POSTGRES_DB: immich
      POSTGRES_PASSWORD: ${DB_PASSWORD:?Missing installer configuration}
      POSTGRES_INITDB_ARGS: --data-checksums
    volumes:
      - type: bind
        source: ${DB_DATA_LOCATION:?Missing installer configuration}
        target: /var/lib/postgresql/data
        bind:
          create_host_path: false
    shm_size: 128mb
    restart: unless-stopped
    healthcheck:
      test: [CMD-SHELL, pg_isready -U immich -d immich]
  redis:
    image: @VALKEY_REF@
    restart: unless-stopped
    healthcheck:
      test: [CMD, valkey-cli, ping]
volumes:
  model-cache:
