#!/bin/sh
set -eu
umask 077
# DSM extracts package.tgz here before preinst; the target is populated afterward.
# https://help.synology.com/developer-guide/synology_package/script_env_var.html
: "${SYNOPKG_PKGINST_TEMP_DIR:?Missing DSM installer staging directory}"
project="$SYNOPKG_PKGINST_TEMP_DIR/project"
[ -f "$project/compose.yaml" ] || {
  echo 'Unsupported DSM installer staging layout; refusing unconfigured project creation.' >&2
  exit 1
}
valid_path() {
  case "$1" in /volume[0-9]/*) ;; *) return 1 ;; esac
  case "$1" in /volume[0-9]/|*//*|*/) return 1 ;; esac
  case "$1" in *[!a-zA-Z0-9_./-]*) return 1 ;; esac
  case "$1" in */../*|*/..|*/./*|*/.) return 1 ;; esac
  part=''
  rest=${1#/}
  while :; do
    part="$part/${rest%%/*}"
    [ ! -L "$part" ] || return 1
    case "$rest" in */*) rest=${rest#*/} ;; *) break ;; esac
  done
}
validate_config() {
valid_path "${wizard_media_path:-}" || { echo 'Use a direct absolute media path under /volumeN without spaces, symlinks or traversal.' >&2; exit 1; }
valid_path "${wizard_database_path:-}" || { echo 'Use a direct absolute database path under /volumeN without spaces, symlinks or traversal.' >&2; exit 1; }
case "${wizard_media_path}/" in "${wizard_database_path}/"*)
  echo 'Media and database directories must not overlap.' >&2
  exit 1
esac
case "${wizard_database_path}/" in "${wizard_media_path}/"*)
  echo 'Media and database directories must not overlap.' >&2
  exit 1
esac
[ -d "$wizard_media_path" ] && [ -d "$wizard_database_path" ] || {
  echo 'Media and database directories must already exist.' >&2
  exit 1
}
if [ ! -x "$wizard_database_path" ] || ! ls "$wizard_database_path" >/dev/null 2>&1; then
  echo 'Cannot inspect database directory before install.' >&2
  exit 1
fi
case "${wizard_web_port:-}" in ''|*[!0-9]*) exit 1 ;; esac
[ "$wizard_web_port" -ge 1024 ] && [ "$wizard_web_port" -le 65535 ] || exit 1
case "${wizard_database_password:-}" in ''|*[!a-zA-Z0-9]*) exit 1 ;; esac
[ "${#wizard_database_password}" -ge 16 ] || exit 1
case "${wizard_enable_ml:-true}" in true|false) ;; *) exit 1 ;; esac
}
parse_retained() {
  # Read dotenv as data only. Known installer fields must be present once.
  # Literal quotes/comments/CRLF are accepted; no expansion, source or eval.
  awk '
    function trim(value) { sub(/^[ \t]+/, "", value); sub(/[ \t]+$/, "", value); return value }
    function invalid() { bad = 1; exit 1 }
    BEGIN {
      split("UPLOAD_LOCATION DB_DATA_LOCATION DB_PASSWORD WEB_PORT COMPOSE_PROFILES ENABLE_ML", fields, " ")
      for (i in fields) known[fields[i]] = 1
    }
    {
      sub(/\r$/, "")
      line = trim($0)
      if (line == "" || substr(line, 1, 1) == "#") next
      sub(/^export[ \t]+/, "", line)
      equal = index(line, "=")
      if (!equal) invalid()
      key = trim(substr(line, 1, equal - 1))
      if (key !~ /^[A-Za-z_][A-Za-z0-9_]*$/) invalid()
      if (!(key in known)) next
      if (seen[key]++) invalid()
      value = trim(substr(line, equal + 1))
      quote = substr(value, 1, 1)
      if (quote == "\"" || quote == sprintf("%c", 39)) {
        remainder = substr(value, 2)
        closing = index(remainder, quote)
        if (!closing) invalid()
        tail = trim(substr(remainder, closing + 1))
        if (tail != "" && substr(tail, 1, 1) != "#") invalid()
        value = substr(remainder, 1, closing - 1)
      } else {
        sub(/[ \t]+#.*/, "", value)
        value = trim(value)
      }
      if (value ~ /[\r\n]/) invalid()
      printf "%s=%s\n", key, value
    }
    END {
      if (bad) exit 1
      for (i in fields) if (!seen[fields[i]]) exit 1
    }
  ' "$1"
}
if [ "${SYNOPKG_PKG_STATUS:-INSTALL}" = UPGRADE ]; then
  retained="$SYNOPKG_PKGVAR/frameleaf.env"
  [ -f "$retained" ] && [ ! -L "$retained" ] && [ -s "$retained" ] || exit 1
  parsed=$(parse_retained "$retained") || {
    echo 'Invalid retained installer configuration; refusing upgrade staging.' >&2
    exit 1
  }
  while IFS= read -r assignment; do
    value=${assignment#*=}
    case "${assignment%%=*}" in
      UPLOAD_LOCATION) wizard_media_path=$value ;;
      DB_DATA_LOCATION) wizard_database_path=$value ;;
      DB_PASSWORD) wizard_database_password=$value ;;
      WEB_PORT) wizard_web_port=$value ;;
      COMPOSE_PROFILES) retained_profile=$value ;;
      ENABLE_ML) wizard_enable_ml=$value ;;
    esac
  done <<EOF
$parsed
EOF
  validate_config
  case "$wizard_enable_ml:$retained_profile" in true:ml|false:) ;; *) exit 1 ;; esac
  # Preserve original retained bytes only after all validations succeed.
  cp "$retained" "$project/.env"
else
validate_config
if [ -e "$wizard_database_path/PG_VERSION" ] || [ -L "$wizard_database_path/PG_VERSION" ]; then
  [ -f "$wizard_database_path/PG_VERSION" ] && [ ! -L "$wizard_database_path/PG_VERSION" ] &&
    [ "$(cat "$wizard_database_path/PG_VERSION")" = 14 ] || {
      echo 'Database directory is not a PostgreSQL 14 cluster.' >&2
      exit 1
    }
fi
# Stage only the package's disposable config. Docker Project Acquire runs before postinst.
# https://help.synology.com/developer-guide/resource_acquisition/timing.html
  profile=''
  [ "${wizard_enable_ml:-true}" = true ] && profile=ml
  enabled=false
  [ -n "$profile" ] && enabled=true
  # DSM supplies these values from the install wizard.
  # shellcheck disable=SC2154
  {
    printf 'UPLOAD_LOCATION=%s\n' "$wizard_media_path"
    printf 'DB_DATA_LOCATION=%s\n' "$wizard_database_path"
    printf 'DB_PASSWORD=%s\n' "$wizard_database_password"
    printf 'WEB_PORT=%s\n' "$wizard_web_port"
    printf 'COMPOSE_PROFILES=%s\n' "$profile"
    printf 'ENABLE_ML=%s\n' "$enabled"
  } > "$project/.env.tmp"
  mv "$project/.env.tmp" "$project/.env"
fi
